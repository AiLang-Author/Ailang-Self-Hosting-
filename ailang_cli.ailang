LibraryImport.Compiler.Output.CELFBuilder
LibraryImport.Compiler.Output.COutput
LibraryImport.Compiler.Output.CELFKernelModule

// =============================================================================
// CLI STATE
// =============================================================================
FixedPool.Cli {
    "filename": Initialize=0, CanChange=True
    "output_file": Initialize=0, CanChange=True
    "source": Initialize=0, CanChange=True
    "source_len": Initialize=0, CanChange=True
    "ast": Initialize=0, CanChange=True
    "dump_combined": Initialize=0, CanChange=True
    // -kmod compiler mode: emit ET_REL Linux kernel module payload
    // instead of ET_EXEC. See kernel_module/PLAN.md (Step 5).
    "kmod_mode": Initialize=0, CanChange=True
}

// =============================================================================
// FILE I/O
// =============================================================================
Function.IO_Open {
    Input: filename: Address
    Input: flags: Integer
    Output: Integer
    Body: {
        fd = SystemCall(2, filename, flags, 420)
        ReturnValue(fd)
    }
}

Function.IO_Close {
    Input: fd: Integer
    Output: Integer
    Body: {
        result = SystemCall(3, fd)
        ReturnValue(result)
    }
}

Function.IO_Read {
    Input: fd: Integer
    Input: buffer: Address
    Input: count: Integer
    Output: Integer
    Body: {
        bytes_read = SystemCall(0, fd, buffer, count)
        ReturnValue(bytes_read)
    }
}

Function.IO_GetFileSize {
    Input: fd: Integer
    Output: Integer
    Body: {
        size = SystemCall(8, fd, 0, 2)
        SystemCall(8, fd, 0, 0)
        ReturnValue(size)
    }
}

Function.Cli_LoadFile {
    Input: filename: Address
    Output: Integer
    Body: {
        fd = IO_Open(filename, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("Error: Could not open file: ")
            PrintMessage(filename)
            PrintMessage("\n")
            ReturnValue(0)
        }
        
        size = IO_GetFileSize(fd)
        IfCondition LessEqual(size, 0) ThenBlock: {
            PrintMessage("Error: File empty or invalid size\n")
            IO_Close(fd)
            ReturnValue(0)
        }
        
        buffer = Allocate(Add(size, 1))
        bytes_read = IO_Read(fd, buffer, size)
        IO_Close(fd)
        
        IfCondition LessEqual(bytes_read, 0) ThenBlock: {
            PrintMessage("Error: Failed to read file\n")
            Deallocate(buffer, Add(size, 1))
            ReturnValue(0)
        }
        
        SetByte(buffer, bytes_read, 0)
        Cli.source = buffer
        Cli.source_len = bytes_read
        ReturnValue(1)
    }
}

// =============================================================================
// ARGUMENT PARSING
// =============================================================================
Function.Cli_GetArg {
    Input: target_index: Integer
    Output: Address
    Body: {
        cmdline_path = "/proc/self/cmdline"
        fd = SystemCall(2, cmdline_path, 0, 0)
        
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        
        buffer = Allocate(4096)
        bytes_read = SystemCall(0, fd, buffer, 4096)
        SystemCall(3, fd)
        
        IfCondition LessEqual(bytes_read, 0) ThenBlock: {
            Deallocate(buffer, 4096)
            ReturnValue(0)
        }
        
        current_arg = 0
        offset = 0
        
        // Skip args
        WhileLoop LessThan(current_arg, target_index) {
            WhileLoop LessThan(offset, bytes_read) {
                ch = GetByte(buffer, offset)
                offset = Add(offset, 1)
                IfCondition EqualTo(ch, 0) ThenBlock: { BreakLoop }
            }
            current_arg = Add(current_arg, 1)
        }
        
        IfCondition GreaterEqual(offset, bytes_read) ThenBlock: {
            Deallocate(buffer, 4096)
            ReturnValue(0)
        }
        
        // Read arg
        start_pos = offset
        len = 0
        WhileLoop LessThan(offset, bytes_read) {
            ch = GetByte(buffer, offset)
            IfCondition EqualTo(ch, 0) ThenBlock: { BreakLoop }
            len = Add(len, 1)
            offset = Add(offset, 1)
        }
        
        IfCondition EqualTo(len, 0) ThenBlock: {
            Deallocate(buffer, 4096)
            ReturnValue(0)
        }
        
        arg_str = Allocate(Add(len, 1))
        i = 0
        WhileLoop LessThan(i, len) {
            ch = GetByte(buffer, Add(start_pos, i))
            SetByte(arg_str, i, ch)
            i = Add(i, 1)
        }
        SetByte(arg_str, len, 0)
        
        Deallocate(buffer, 4096)
        ReturnValue(arg_str)
    }
}

// =============================================================================
// COMPILATION PIPELINE
// =============================================================================
Function.Cli_Compile {
    Output: Integer
    Body: {
        PrintMessage("Compiling: ")
        PrintMessage(Cli.filename)
        PrintMessage("\n")
        
        // 1. Import Resolution
        // Auto-import core libraries first
        source_with_core = AutoImport_Resolve(Cli.source)
        
        // Resolve all imports
        resolved = Import_ResolveAll(source_with_core)
        IfCondition EqualTo(resolved, 0) ThenBlock: {
            PrintMessage("Error: Import resolution failed\n")
            ReturnValue(0)
        }
        
        resolved_len = StringLength(resolved)

        // Optional: dump combined post-import source for debugging.
        // Line numbers in subsequent errors refer to this combined file,
        // not the original source. Open combined_source.ailang at the
        // reported line to see what the compiler actually saw.
        IfCondition EqualTo(Cli.dump_combined, 1) ThenBlock: {
            dump_path = "combined_source.ailang"
            // syscall 2 = open; flags 0x241 = O_WRONLY|O_CREAT|O_TRUNC; mode 0644
            dump_fd = SystemCall(2, dump_path, 577, 420)
            IfCondition GreaterEqual(dump_fd, 0) ThenBlock: {
                SystemCall(1, dump_fd, resolved, resolved_len)
                SystemCall(3, dump_fd)
                PrintMessage("[DUMP] Wrote ")
                PrintNumber(resolved_len)
                PrintMessage(" bytes of combined source to ")
                PrintMessage(dump_path)
                PrintMessage("\n")
            } ElseBlock: {
                PrintMessage("[DUMP] WARNING: failed to open combined_source.ailang for writing\n")
            }
        }

        // 2. Lexing
        Lex_Init(resolved, resolved_len)
        Lex_Tokenize()
        
        IfCondition EqualTo(Lex.error, 1) ThenBlock: {
            // FileMap_Format resolves combined-source line → "file:line"
            // so the error points at the originating file, not a giant
            // combined-source line number.
            loc = FileMap_Format(Lex.error_line)
            PrintMessage("Lexer Error at ")
            PrintMessage(loc)
            PrintMessage(", col ")
            PrintNumber(Lex.error_col)
            PrintMessage(" (combined line ")
            PrintNumber(Lex.error_line)
            PrintMessage(")\n")
            Lex_Free()
            ReturnValue(0)
        }

        // 3. Parsing
        Parse_Init(Lex.token_count)
        Cli.ast = Parse_Program()

        IfCondition EqualTo(Parse_HasError(), 1) ThenBlock: {
            loc = FileMap_Format(PParser.p_error_line)
            PrintMessage("Parser Error at ")
            PrintMessage(loc)
            PrintMessage(" (combined line ")
            PrintNumber(PParser.p_error_line)
            PrintMessage("): ")
            IfCondition NotEqual(PParser.p_error_msg, 0) ThenBlock: {
                PrintMessage(PParser.p_error_msg)
            }
            PrintMessage("\n")
            Parse_Cleanup(0)
            Lex_Free()
            ReturnValue(0)
        }
        
        // 4. Semantic Analysis
        Sem_Init()
        sem_result = Sem_Analyze(Cli.ast)
        IfCondition EqualTo(sem_result, 0) ThenBlock: {
            PrintMessage("Semantic Analysis Failed\n")
            Parse_Cleanup(1)
            Lex_Free()
            ReturnValue(0)
        }
        
        // 5. Code Generation
        Emit_Init()
        EmitTag_Init()
        Compile_Init()

        // Tell the codegen we're in kernel-module mode (gates extern calls,
        // see CompileFunc_UserCall). KMod_Init must also be called before
        // codegen runs since extern call sites stage into the KMod pool.
        Compile.kmod_mode = Cli.kmod_mode
        IfCondition EqualTo(Cli.kmod_mode, 1) ThenBlock: {
            ELF_Init()
            KMod_Init()
        }

        // Entry point
        start_label = Emit_CreateLabel()
        Emit_DefineLabel(start_label)
        
        compile_result = Compile_Program(Cli.ast)
        
        IfCondition EqualTo(compile_result, 0) ThenBlock: {
            PrintMessage("Compilation Failed: ")
            IfCondition NotEqual(Compile.error_msg, 0) ThenBlock: {
                PrintMessage(Compile.error_msg)
            }
            PrintMessage("\n")
            Compile_Free()
            Parse_Cleanup(1)
            Lex_Free()
            ReturnValue(0)
        }
        
        // Exit syscall — ET_EXEC only. Kernel modules have no entry point;
        // the C shim's module_init dispatches to ail_main directly via the
        // GLOBAL FUNC symbol, so trailing exit bytes would be unreachable
        // garbage that confuses disassembly and inflates .text.
        IfCondition EqualTo(Cli.kmod_mode, 0) ThenBlock: {
            X86_MovRaxImm64(60)
            X86_XorRdiRdi()
            X86_SysInstr()
        }

        Emit_ResolveFixups()

        // Data-pointer relocs: in ET_EXEC mode, patch with absolute baked-in
        // addresses. In -kmod mode, stage as R_X86_64_64 records against the
        // .data section symbol so insmod patches at module load.
        IfCondition EqualTo(Cli.kmod_mode, 1) ThenBlock: {
            KMod_BridgeDataRelocs()
        } ElseBlock: {
            Emit_ApplyDataRelocations()
        }

        // Post-pass peephole optimization (see EMIT_TAG_DESIGN.md).
        // Runs after fixups so all jump offsets are baked in — NOPing
        // dead bytes won't invalidate any resolved target.
        EmitTag_Optimize()

        // 6. Output
        PrintMessage("Writing to: ")
        PrintMessage(Cli.output_file)
        PrintMessage("\n")

        IfCondition EqualTo(Cli.kmod_mode, 1) ThenBlock: {
            // ET_REL kernel module payload path.
            // Required: source defines Function.ail_main {Output: Integer ...}
            // Optional: source defines Function.ail_exit {Body: ...}
            ail_main_label = Compile_FindFunction("ail_main")
            IfCondition LessThan(ail_main_label, 0) ThenBlock: {
                PrintMessage("Error: -kmod requires Function.ail_main to be defined\n")
                Compile_Free()
                EmitTag_Free()
                Parse_Cleanup(1)
                Lex_Free()
                Sem_Free()
                ReturnValue(0)
            }
            ail_main_off = Emit_GetLabelAddress(ail_main_label)

            // ELF_Init / KMod_Init were called at the top of codegen so
            // extern call sites could stage relocs during compilation.
            // Here we just stage exports + invoke the builder.
            KMod_StageExport("ail_main", ail_main_off)

            ail_exit_label = Compile_FindFunction("ail_exit")
            IfCondition GreaterEqual(ail_exit_label, 0) ThenBlock: {
                ail_exit_off = Emit_GetLabelAddress(ail_exit_label)
                KMod_StageExport("ail_exit", ail_exit_off)
            } ElseBlock: {
                PrintMessage("[KMOD] note: Function.ail_exit not defined (shim cleanup will be a no-op)\n")
            }

            // Stage additional exports: PCIe driver callbacks (if defined)
            _lbl = Compile_FindFunction("ail_mx3_probe")
            IfCondition GreaterEqual(_lbl, 0) ThenBlock: {
                KMod_StageExport("ail_mx3_probe", Emit_GetLabelAddress(_lbl))
            }
            _lbl = Compile_FindFunction("ail_mx3_remove")
            IfCondition GreaterEqual(_lbl, 0) ThenBlock: {
                KMod_StageExport("ail_mx3_remove", Emit_GetLabelAddress(_lbl))
            }
            _lbl = Compile_FindFunction("ail_mx3_open")
            IfCondition GreaterEqual(_lbl, 0) ThenBlock: {
                KMod_StageExport("ail_mx3_open", Emit_GetLabelAddress(_lbl))
            }
            _lbl = Compile_FindFunction("ail_mx3_release")
            IfCondition GreaterEqual(_lbl, 0) ThenBlock: {
                KMod_StageExport("ail_mx3_release", Emit_GetLabelAddress(_lbl))
            }
            _lbl = Compile_FindFunction("ail_mx3_write")
            IfCondition GreaterEqual(_lbl, 0) ThenBlock: {
                KMod_StageExport("ail_mx3_write", Emit_GetLabelAddress(_lbl))
            }
            _lbl = Compile_FindFunction("ail_mx3_read")
            IfCondition GreaterEqual(_lbl, 0) ThenBlock: {
                KMod_StageExport("ail_mx3_read", Emit_GetLabelAddress(_lbl))
            }
            _lbl = Compile_FindFunction("ail_mx3_ioctl")
            IfCondition GreaterEqual(_lbl, 0) ThenBlock: {
                KMod_StageExport("ail_mx3_ioctl", Emit_GetLabelAddress(_lbl))
            }

            // NOTE: extern + reloc staging is a no-op until plan Steps 3 + 4
            // land (ExternalKernelFunction parser + codegen reloc emission).
            // This first cut produces a self-contained payload — only useful
            // if ail_main does pure computation. As soon as the source can
            // call ail_printk etc., codegen will populate KMod_StageReloc.
            write_result = Output_BuildKernelModule(Cli.output_file)
            KMod_Free()
            ELF_Free()
        } ElseBlock: {
            write_result = Output_BuildAndWrite(Cli.output_file)
        }

        // Cleanup
        Compile_Free()
        EmitTag_Free()
        Parse_Cleanup(1)
        Lex_Free()
        Sem_Free()

        IfCondition EqualTo(write_result, 0) ThenBlock: {
            PrintMessage("Error: Failed to write output file\n")
            ReturnValue(0)
        }

        PrintMessage("Success.\n")
        ReturnValue(1)
    }
}

// =============================================================================
// MAIN
// =============================================================================
SubRoutine.Main {
    Arena_Init()
    
    // Init Debug state
    Dbg.level = 0
    Dbg.perf_enabled = 0
    Dbg.initialized = 1

    // Parse flags from args 1..N
    arg_idx = 1
    WhileLoop LessThan(arg_idx, 10) {
        arg = Cli_GetArg(arg_idx)
        IfCondition EqualTo(arg, 0) ThenBlock: {
            BreakLoop
        }
        
        // Check for -P flag
        IfCondition EqualTo(StringEquals(arg, "-P"), 1) ThenBlock: {
            Dbg.perf_enabled = 1
            PrintMessage("[CLI] Performance profiling enabled\n")
        }
        
        // Check for -D or -D1 through -D4
        IfCondition EqualTo(StringEquals(arg, "-D"), 1) ThenBlock: {
            Dbg.level = 1
        }
        IfCondition EqualTo(StringEquals(arg, "-D1"), 1) ThenBlock: {
            Dbg.level = 1
        }
        IfCondition EqualTo(StringEquals(arg, "-D2"), 1) ThenBlock: {
            Dbg.level = 2
        }
        IfCondition EqualTo(StringEquals(arg, "-D3"), 1) ThenBlock: {
            Dbg.level = 3
        }
        IfCondition EqualTo(StringEquals(arg, "-D4"), 1) ThenBlock: {
            Dbg.level = 4
        }

        // Check for -d / --dump-combined
        //   Writes the post-import combined source to combined_source.ailang
        //   in the current directory so errors at high line numbers can be
        //   located (imports inline all library code — line 12345 in the
        //   error message is combined-source, not your 500-line program).
        IfCondition EqualTo(StringEquals(arg, "-d"), 1) ThenBlock: {
            Cli.dump_combined = 1
        }
        IfCondition EqualTo(StringEquals(arg, "--dump-combined"), 1) ThenBlock: {
            Cli.dump_combined = 1
        }

        // -kmod: emit Linux kernel-module payload (ET_REL) instead of ET_EXEC.
        //   Source must define Function.ail_main {Output: Integer ...}; may
        //   also define Function.ail_exit. The C shim in kernel_module/shim/
        //   provides module_init/module_exit; this object is linked against
        //   it via `make` in that directory. See kernel_module/PLAN.md.
        IfCondition EqualTo(StringEquals(arg, "-kmod"), 1) ThenBlock: {
            Cli.kmod_mode = 1
        }

        // First non-flag arg is the source file
        IfCondition EqualTo(Cli.filename, 0) ThenBlock: {
            first_char = StringCharAt(arg, 0)
            IfCondition NotEqual(first_char, 45) ThenBlock: {
                Cli.filename = arg
            }
        } ElseBlock: {
            // Second non-flag arg is output file
            IfCondition EqualTo(Cli.output_file, 0) ThenBlock: {
                first_char = StringCharAt(arg, 0)
                IfCondition NotEqual(first_char, 45) ThenBlock: {
                    Cli.output_file = arg
                }
            }
        }
        
        arg_idx = Add(arg_idx, 1)
    }

    IfCondition EqualTo(Cli.filename, 0) ThenBlock: {
        PrintMessage("AILang Compiler CLI\n")
        PrintMessage("Usage: ./ailang.x [-P] [-D1-4] [-d] [-kmod] <source_file> [output_file]\n")
        PrintMessage("  -kmod   emit Linux kernel-module payload (ET_REL); requires Function.ail_main\n")
        ProcessExit(1)
    }

    IfCondition EqualTo(Cli.output_file, 0) ThenBlock: {
        IfCondition EqualTo(Cli.kmod_mode, 1) ThenBlock: {
            Cli.output_file = "ail_payload.o"
        } ElseBlock: {
            Cli.output_file = "a.out"
        }
    }

    load_success = Cli_LoadFile(Cli.filename)
    IfCondition EqualTo(load_success, 0) ThenBlock: {
        ProcessExit(1)
    }

    result = Cli_Compile()

    IfCondition EqualTo(result, 0) ThenBlock: {
        ProcessExit(1)
    }

    ProcessExit(0)
}

RunTask(Main)