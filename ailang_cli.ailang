// =============================================================================
// CLI STATE
// =============================================================================
FixedPool.Cli {
    "filename": Initialize=0, CanChange=True
    "output_file": Initialize=0, CanChange=True
    "source": Initialize=0, CanChange=True
    "source_len": Initialize=0, CanChange=True
    "ast": Initialize=0, CanChange=True
}

// =============================================================================
// FILE I/O
// =============================================================================
Function.IO_Open {
    Input: filename: Address
    Input: flags: Integer
    Output: Integer
    Body: {
        fd = SystemCall(2, filename, flags, 420)
        ReturnValue(fd)
    }
}

Function.IO_Close {
    Input: fd: Integer
    Output: Integer
    Body: {
        result = SystemCall(3, fd)
        ReturnValue(result)
    }
}

Function.IO_Read {
    Input: fd: Integer
    Input: buffer: Address
    Input: count: Integer
    Output: Integer
    Body: {
        bytes_read = SystemCall(0, fd, buffer, count)
        ReturnValue(bytes_read)
    }
}

Function.IO_GetFileSize {
    Input: fd: Integer
    Output: Integer
    Body: {
        size = SystemCall(8, fd, 0, 2)
        SystemCall(8, fd, 0, 0)
        ReturnValue(size)
    }
}

Function.Cli_LoadFile {
    Input: filename: Address
    Output: Integer
    Body: {
        fd = IO_Open(filename, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("Error: Could not open file: ")
            PrintMessage(filename)
            PrintMessage("\n")
            ReturnValue(0)
        }
        
        size = IO_GetFileSize(fd)
        IfCondition LessEqual(size, 0) ThenBlock: {
            PrintMessage("Error: File empty or invalid size\n")
            IO_Close(fd)
            ReturnValue(0)
        }
        
        buffer = Allocate(Add(size, 1))
        bytes_read = IO_Read(fd, buffer, size)
        IO_Close(fd)
        
        IfCondition LessEqual(bytes_read, 0) ThenBlock: {
            PrintMessage("Error: Failed to read file\n")
            Deallocate(buffer, Add(size, 1))
            ReturnValue(0)
        }
        
        SetByte(buffer, bytes_read, 0)
        Cli.source = buffer
        Cli.source_len = bytes_read
        ReturnValue(1)
    }
}

// =============================================================================
// ARGUMENT PARSING
// =============================================================================
Function.Cli_GetArg {
    Input: target_index: Integer
    Output: Address
    Body: {
        cmdline_path = "/proc/self/cmdline"
        fd = SystemCall(2, cmdline_path, 0, 0)
        
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        
        buffer = Allocate(4096)
        bytes_read = SystemCall(0, fd, buffer, 4096)
        SystemCall(3, fd)
        
        IfCondition LessEqual(bytes_read, 0) ThenBlock: {
            Deallocate(buffer, 4096)
            ReturnValue(0)
        }
        
        current_arg = 0
        offset = 0
        
        // Skip args
        WhileLoop LessThan(current_arg, target_index) {
            WhileLoop LessThan(offset, bytes_read) {
                ch = GetByte(buffer, offset)
                offset = Add(offset, 1)
                IfCondition EqualTo(ch, 0) ThenBlock: { BreakLoop }
            }
            current_arg = Add(current_arg, 1)
        }
        
        IfCondition GreaterEqual(offset, bytes_read) ThenBlock: {
            Deallocate(buffer, 4096)
            ReturnValue(0)
        }
        
        // Read arg
        start_pos = offset
        len = 0
        WhileLoop LessThan(offset, bytes_read) {
            ch = GetByte(buffer, offset)
            IfCondition EqualTo(ch, 0) ThenBlock: { BreakLoop }
            len = Add(len, 1)
            offset = Add(offset, 1)
        }
        
        IfCondition EqualTo(len, 0) ThenBlock: {
            Deallocate(buffer, 4096)
            ReturnValue(0)
        }
        
        arg_str = Allocate(Add(len, 1))
        i = 0
        WhileLoop LessThan(i, len) {
            ch = GetByte(buffer, Add(start_pos, i))
            SetByte(arg_str, i, ch)
            i = Add(i, 1)
        }
        SetByte(arg_str, len, 0)
        
        Deallocate(buffer, 4096)
        ReturnValue(arg_str)
    }
}

// =============================================================================
// COMPILATION PIPELINE
// =============================================================================
Function.Cli_Compile {
    Output: Integer
    Body: {
        PrintMessage("Compiling: ")
        PrintMessage(Cli.filename)
        PrintMessage("\n")
        
        // 1. Import Resolution
        // Auto-import core libraries first
        source_with_core = AutoImport_Resolve(Cli.source)
        
        // Resolve all imports
        resolved = Import_ResolveAll(source_with_core)
        IfCondition EqualTo(resolved, 0) ThenBlock: {
            PrintMessage("Error: Import resolution failed\n")
            ReturnValue(0)
        }
        
        resolved_len = StringLength(resolved)
        
        // 2. Lexing
        Lex_Init(resolved, resolved_len)
        Lex_Tokenize()
        
        IfCondition EqualTo(Lex.error, 1) ThenBlock: {
            PrintMessage("Lexer Error: Line ")
            PrintNumber(Lex.error_line)
            PrintMessage(", Col ")
            PrintNumber(Lex.error_col)
            PrintMessage("\n")
            Lex_Free()
            ReturnValue(0)
        }
        
        // 3. Parsing
        Parse_Init(Lex.token_count)
        Cli.ast = Parse_Program()
        
        IfCondition EqualTo(Parse_HasError(), 1) ThenBlock: {
            PrintMessage("Parser Error: Line ")
            PrintNumber(PParser.p_error_line)
            PrintMessage(": ")
            IfCondition NotEqual(PParser.p_error_msg, 0) ThenBlock: {
                PrintMessage(PParser.p_error_msg)
            }
            PrintMessage("\n")
            Parse_Cleanup(0)
            Lex_Free()
            ReturnValue(0)
        }
        
        // 4. Semantic Analysis
        Sem_Init()
        sem_result = Sem_Analyze(Cli.ast)
        IfCondition EqualTo(sem_result, 0) ThenBlock: {
            PrintMessage("Semantic Analysis Failed\n")
            Parse_Cleanup(1)
            Lex_Free()
            ReturnValue(0)
        }
        
        // 5. Code Generation
        Emit_Init()
        Compile_Init()
        
        // Entry point
        start_label = Emit_CreateLabel()
        Emit_DefineLabel(start_label)
        
        compile_result = Compile_Program(Cli.ast)
        
        IfCondition EqualTo(compile_result, 0) ThenBlock: {
            PrintMessage("Compilation Failed: ")
            IfCondition NotEqual(Compile.error_msg, 0) ThenBlock: {
                PrintMessage(Compile.error_msg)
            }
            PrintMessage("\n")
            Compile_Free()
            Parse_Cleanup(1)
            Lex_Free()
            ReturnValue(0)
        }
        
        // Exit syscall
        X86_MovRaxImm64(60)
        X86_XorRdiRdi()
        X86_SysInstr()
        
        Emit_ResolveFixups()
        Emit_ApplyDataRelocations()
        
        // 6. Output
        PrintMessage("Writing to: ")
        PrintMessage(Cli.output_file)
        PrintMessage("\n")
        
        write_result = Output_BuildAndWrite(Cli.output_file)
        
        // Cleanup
        Compile_Free()
        Parse_Cleanup(1)
        Lex_Free()
        Sem_Free()
        
        IfCondition EqualTo(write_result, 0) ThenBlock: {
            PrintMessage("Error: Failed to write output file\n")
            ReturnValue(0)
        }
        
        PrintMessage("Success.\n")
        ReturnValue(1)
    }
}

// =============================================================================
// MAIN
// =============================================================================
SubRoutine.Main {
    Arena_Init()
    
    // Init Debug state
    Dbg.level = 0
    Dbg.perf_enabled = 0
    Dbg.initialized = 1

    // Parse flags from args 1..N
    arg_idx = 1
    WhileLoop LessThan(arg_idx, 10) {
        arg = Cli_GetArg(arg_idx)
        IfCondition EqualTo(arg, 0) ThenBlock: {
            BreakLoop
        }
        
        // Check for -P flag
        IfCondition EqualTo(StringEquals(arg, "-P"), 1) ThenBlock: {
            Dbg.perf_enabled = 1
            PrintMessage("[CLI] Performance profiling enabled\n")
        }
        
        // Check for -D or -D1 through -D4
        IfCondition EqualTo(StringEquals(arg, "-D"), 1) ThenBlock: {
            Dbg.level = 1
        }
        IfCondition EqualTo(StringEquals(arg, "-D1"), 1) ThenBlock: {
            Dbg.level = 1
        }
        IfCondition EqualTo(StringEquals(arg, "-D2"), 1) ThenBlock: {
            Dbg.level = 2
        }
        IfCondition EqualTo(StringEquals(arg, "-D3"), 1) ThenBlock: {
            Dbg.level = 3
        }
        IfCondition EqualTo(StringEquals(arg, "-D4"), 1) ThenBlock: {
            Dbg.level = 4
        }
        
        // First non-flag arg is the source file
        IfCondition EqualTo(Cli.filename, 0) ThenBlock: {
            first_char = StringCharAt(arg, 0)
            IfCondition NotEqual(first_char, 45) ThenBlock: {
                Cli.filename = arg
            }
        } ElseBlock: {
            // Second non-flag arg is output file
            IfCondition EqualTo(Cli.output_file, 0) ThenBlock: {
                first_char = StringCharAt(arg, 0)
                IfCondition NotEqual(first_char, 45) ThenBlock: {
                    Cli.output_file = arg
                }
            }
        }
        
        arg_idx = Add(arg_idx, 1)
    }

    IfCondition EqualTo(Cli.filename, 0) ThenBlock: {
        PrintMessage("AILang Compiler CLI\n")
        PrintMessage("Usage: ./ailang.x [-P] [-D1-4] <source_file> [output_file]\n")
        ProcessExit(1)
    }

    IfCondition EqualTo(Cli.output_file, 0) ThenBlock: {
        Cli.output_file = "a.out"
    }

    load_success = Cli_LoadFile(Cli.filename)
    IfCondition EqualTo(load_success, 0) ThenBlock: {
        ProcessExit(1)
    }

    result = Cli_Compile()

    IfCondition EqualTo(result, 0) ThenBlock: {
        ProcessExit(1)
    }

    ProcessExit(0)
}

RunTask(Main)