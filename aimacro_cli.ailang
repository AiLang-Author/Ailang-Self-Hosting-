// aimacro_cli.ailang
// CLI transpiler: ./aimacro.x <input.aim> [output.ailang]
// Reads input file, transpiles to AILang, writes to stdout or output file.

LibraryImport.AIMacro.AIMacroCore
LibraryImport.AIMacro.AIMacroParserCore
LibraryImport.AIMacro.AIMacroCodeGen1
LibraryImport.AIMacro.AIMacroCodeGen2
LibraryImport.AIMacro.AIMacroCodeGen3
LibraryImport.AIMacro.AIMacroCodeGen4

// =============================================================================
// SYSCALL WRAPPERS
// =============================================================================
Function.CLI_Open {
    Input: path: Address
    Input: flags: Integer
    Output: Integer
    Body: { ReturnValue(SystemCall(2, path, flags, 420)) }
}

Function.CLI_Close {
    Input: fd: Integer
    Body: { SystemCall(3, fd) }
}

Function.CLI_Read {
    Input: fd: Integer
    Input: buf: Address
    Input: n: Integer
    Output: Integer
    Body: { ReturnValue(SystemCall(0, fd, buf, n)) }
}

Function.CLI_Write {
    Input: fd: Integer
    Input: buf: Address
    Input: n: Integer
    Output: Integer
    Body: { ReturnValue(SystemCall(1, fd, buf, n)) }
}

Function.CLI_GetSize {
    Input: fd: Integer
    Output: Integer
    Body: {
        sz = SystemCall(8, fd, 0, 2)
        SystemCall(8, fd, 0, 0)
        ReturnValue(sz)
    }
}

Function.CLI_Exit {
    Input: code: Integer
    Body: { SystemCall(60, code) }
}

Function.CLI_WriteStr {
    Input: s: Address
    Body: {
        len = StringLength(s)
        IfCondition GreaterThan(len, 0) ThenBlock: {
            SystemCall(1, 2, s, len)
        }
    }
}

// =============================================================================
// CMDLINE PARSING — reads /proc/self/cmdline (NUL-separated args)
// =============================================================================

// Extract one NUL-terminated arg from buf starting at offset.
// Writes next offset to *next_ptr. Returns 0 at end.
Function.CLI_NextArg {
    Input: buf: Address
    Input: total: Integer
    Input: off: Integer
    Input: next_ptr: Address
    Output: Address
    Body: {
        IfCondition GreaterEqual(off, total) ThenBlock: {
            StoreValue(next_ptr, off)
            ReturnValue(0)
        }
        i = off
        WhileLoop LessThan(i, total) {
            ch = GetByte(buf, i)
            IfCondition EqualTo(ch, 0) ThenBlock: { BreakLoop }
            i = Add(i, 1)
        }
        arg_len = Subtract(i, off)
        out = Allocate(Add(arg_len, 1))
        j = 0
        WhileLoop LessThan(j, arg_len) {
            SetByte(out, j, GetByte(buf, Add(off, j)))
            j = Add(j, 1)
        }
        SetByte(out, arg_len, 0)
        StoreValue(next_ptr, Add(i, 1))
        ReturnValue(out)
    }
}

// =============================================================================
// STDOUT REDIRECTION HELPERS
// dup(1) saves stdout; dup2(src,dst) redirects; used to send debug→stderr
// =============================================================================
Function.CLI_SaveStdout {
    Output: Integer
    Body: {
        saved = SystemCall(32, 1)
        ReturnValue(saved)
    }
}

Function.CLI_StdoutToStderr {
    Body: {
        // dup2(2, 1): make fd 1 point at whatever fd 2 (stderr) points at
        SystemCall(33, 2, 1)
    }
}

Function.CLI_RestoreStdout {
    Input: saved: Integer
    Body: {
        SystemCall(33, saved, 1)
        SystemCall(3, saved)
    }
}

// =============================================================================
// COMPILE PIPELINE
// =============================================================================
Function.CLI_CompileFile {
    Input: filename: Address
    Output: Address
    Body: {
        fd = CLI_Open(filename, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            CLI_WriteStr("error: cannot open input: ")
            CLI_WriteStr(filename)
            CLI_WriteStr("\n")
            ReturnValue(0)
        }

        fsize = CLI_GetSize(fd)
        IfCondition LessEqual(fsize, 0) ThenBlock: {
            CLI_Close(fd)
            CLI_WriteStr("error: empty or unreadable file\n")
            ReturnValue(0)
        }

        src = Allocate(Add(fsize, 1))
        nr = CLI_Read(fd, src, fsize)
        CLI_Close(fd)
        SetByte(src, nr, 0)

        // Lex
        Lex_Init(src, nr)
        tok_count = Lex_Tokenize()
        IfCondition LessEqual(tok_count, 0) ThenBlock: {
            Lex_Free()
            Deallocate(src, Add(fsize, 1))
            ReturnValue(0)
        }

        // Parse
        Parse_Init()
        ast = Parse_Program()
        IfCondition EqualTo(Parse.err, 1) ThenBlock: {
            Deallocate(src, Add(fsize, 1))
            Lex_Free()
            ReturnValue(0)
        }

        // Generate
        Gen_Init()
        Gen_Program(ast)
        output = Gen_GetOutput()

        Gen_Free()
        Lex_Free()
        Deallocate(src, Add(fsize, 1))
        ReturnValue(output)
    }
}

// =============================================================================
// MAIN
// =============================================================================
SubRoutine.Main {
    // Silence library init noise: redirect stdout→stderr globally.
    // Generated code is captured as a string and written to stdout explicitly
    // after the redirect is restored, so only clean output reaches stdout.
    initial_saved = CLI_SaveStdout()
    CLI_StdoutToStderr()

    // Read /proc/self/cmdline
    cmdline_path = "/proc/self/cmdline"
    cfd = CLI_Open(cmdline_path, 0)
    IfCondition LessThan(cfd, 0) ThenBlock: {
        CLI_WriteStr("error: cannot read cmdline\n")
        CLI_Exit(1)
    }

    cbuf = Allocate(8192)
    ctotal = CLI_Read(cfd, cbuf, 8192)
    CLI_Close(cfd)

    next_holder = Allocate(8)
    StoreValue(next_holder, 0)

    // Skip argv[0] (program name)
    argv0 = CLI_NextArg(cbuf, ctotal, 0, next_holder)
    IfCondition NotEqual(argv0, 0) ThenBlock: { Deallocate(argv0, 0) }

    // argv[1] = input file (required)
    off1 = Dereference(next_holder)
    input_file = CLI_NextArg(cbuf, ctotal, off1, next_holder)

    IfCondition EqualTo(input_file, 0) ThenBlock: {
        CLI_WriteStr("Usage: aimacro <input.aim> [output.ailang]\n")
        Deallocate(cbuf, 8192)
        Deallocate(next_holder, 8)
        CLI_Exit(1)
    }

    // argv[2] = output file (optional)
    off2 = Dereference(next_holder)
    output_file = CLI_NextArg(cbuf, ctotal, off2, next_holder)

    Deallocate(cbuf, 8192)
    Deallocate(next_holder, 8)

    // Compile (debug output goes to stderr via the redirect above)
    result = CLI_CompileFile(input_file)
    Deallocate(input_file, 0)

    // Restore real stdout before writing output or error messages
    CLI_RestoreStdout(initial_saved)

    IfCondition EqualTo(result, 0) ThenBlock: {
        CLI_WriteStr("error: compilation failed\n")
        IfCondition NotEqual(output_file, 0) ThenBlock: { Deallocate(output_file, 0) }
        CLI_Exit(1)
    }

    result_len = StringLength(result)

    // Write output
    IfCondition EqualTo(output_file, 0) ThenBlock: {
        // stdout
        CLI_Write(1, result, result_len)
    } ElseBlock: {
        ofd = CLI_Open(output_file, 577)
        IfCondition LessThan(ofd, 0) ThenBlock: {
            CLI_WriteStr("error: cannot open output: ")
            CLI_WriteStr(output_file)
            CLI_WriteStr("\n")
            Deallocate(output_file, 0)
            Deallocate(result, 0)
            CLI_Exit(1)
        }
        CLI_Write(ofd, result, result_len)
        CLI_Close(ofd)
        Deallocate(output_file, 0)
    }

    Deallocate(result, 0)
    CLI_Exit(0)
}

RunTask(Main)
