SubRoutine.Main {
    a = 1
    b = 2
    c = 3
    i = 0
    WhileLoop LessThan(i, 500000000) {
        a = Add(a, b)
        b = Add(b, c)
        c = Add(c, a)
        i = Add(i, 1)
    }
    r = BitwiseXor(a, BitwiseXor(b, c))
    PrintMessage("Result: ")
    PrintNumber(r)
    PrintMessage("\n")
}
RunTask(Main)
