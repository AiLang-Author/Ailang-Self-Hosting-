// arena_test.ailang
// Comprehensive test suite for slab allocator
// Run: python3 main.py arena_test.ailang

LibraryImport.Arena

FixedPool.Test {
    "passed": Initialize=0
    "failed": Initialize=0
    "total": Initialize=0
    "name": Initialize=0
    "actual": Initialize=0
    "expected": Initialize=0
}

// =============================================================================
// TEST FRAMEWORK
// =============================================================================
SubRoutine.TestPass {
    Test.passed = Add(Test.passed, 1)
    Test.total = Add(Test.total, 1)
    PrintMessage("  [PASS] ")
    PrintMessage(Test.name)
    PrintMessage("\n")
}

SubRoutine.TestFail {
    Test.failed = Add(Test.failed, 1)
    Test.total = Add(Test.total, 1)
    PrintMessage("  [FAIL] ")
    PrintMessage(Test.name)
    PrintMessage(" - expected ")
    PrintNumber(Test.expected)
    PrintMessage(" got ")
    PrintNumber(Test.actual)
    PrintMessage("\n")
}

SubRoutine.Check {
    IfCondition EqualTo(Test.actual, Test.expected) ThenBlock: {
        RunTask(TestPass)
    } ElseBlock: {
        RunTask(TestFail)
    }
}

// =============================================================================
// TEST 1: Basic Allocation
// =============================================================================
SubRoutine.Test_BasicAlloc {
    PrintMessage("\n=== TEST 1: Basic Allocation ===\n")
    
    // Allocate from each slab
    Test.name = "Arena_Alloc24 returns non-zero"
    ptr24 = Arena_Alloc24()
    Test.actual = NotEqual(ptr24, 0)
    Test.expected = 1
    RunTask(Check)
    
    Test.name = "Arena_Alloc32 returns non-zero"
    ptr32 = Arena_Alloc32()
    Test.actual = NotEqual(ptr32, 0)
    Test.expected = 1
    RunTask(Check)
    
    Test.name = "Arena_Alloc64 returns non-zero"
    ptr64 = Arena_Alloc64()
    Test.actual = NotEqual(ptr64, 0)
    Test.expected = 1
    RunTask(Check)
    
    Test.name = "Arena_Alloc128 returns non-zero"
    ptr128 = Arena_Alloc128()
    Test.actual = NotEqual(ptr128, 0)
    Test.expected = 1
    RunTask(Check)
    
    // Unified allocator
    Test.name = "Arena_Alloc(24) returns non-zero"
    ptr = Arena_Alloc(24)
    Test.actual = NotEqual(ptr, 0)
    Test.expected = 1
    RunTask(Check)
    
    Test.name = "Arena_Alloc(100) returns non-zero"
    ptr = Arena_Alloc(100)
    Test.actual = NotEqual(ptr, 0)
    Test.expected = 1
    RunTask(Check)
}

// =============================================================================
// TEST 2: Data Integrity
// =============================================================================
SubRoutine.Test_DataIntegrity {
    PrintMessage("\n=== TEST 2: Data Integrity ===\n")
    
    // Allocate and write pattern
    ptr = Arena_Alloc24()
    StoreValue(ptr, 12345678)
    StoreValue(Add(ptr, 8), 87654321)
    StoreValue(Add(ptr, 16), 11111111)
    
    // Read back and verify
    Test.name = "Read back value at offset 0"
    Test.actual = Dereference(ptr)
    Test.expected = 12345678
    RunTask(Check)
    
    Test.name = "Read back value at offset 8"
    Test.actual = Dereference(Add(ptr, 8))
    Test.expected = 87654321
    RunTask(Check)
    
    Test.name = "Read back value at offset 16"
    Test.actual = Dereference(Add(ptr, 16))
    Test.expected = 11111111
    RunTask(Check)
    
    // Test 32-byte block
    ptr32 = Arena_Alloc32()
    StoreValue(ptr32, 99999999)
    StoreValue(Add(ptr32, 24), 88888888)
    
    Test.name = "32-byte block offset 0"
    Test.actual = Dereference(ptr32)
    Test.expected = 99999999
    RunTask(Check)
    
    Test.name = "32-byte block offset 24"
    Test.actual = Dereference(Add(ptr32, 24))
    Test.expected = 88888888
    RunTask(Check)
}

// =============================================================================
// TEST 3: Free List Reuse
// =============================================================================
SubRoutine.Test_FreeListReuse {
    PrintMessage("\n=== TEST 3: Free List Reuse ===\n")
    
    // Allocate a block
    ptr1 = Arena_Alloc24()
    StoreValue(ptr1, 111)
    
    // Free it
    Arena_Free24(ptr1)
    
    // Allocate again - should get same address back
    ptr2 = Arena_Alloc24()
    
    Test.name = "Freed block is reused"
    Test.actual = EqualTo(ptr1, ptr2)
    Test.expected = 1
    RunTask(Check)
    
    // Verify memory is reusable (old data may be there but we can write new)
    StoreValue(ptr2, 222)
    Test.name = "Reused block is writable"
    Test.actual = Dereference(ptr2)
    Test.expected = 222
    RunTask(Check)
    
    // Test multiple free/reuse cycles
    Arena_Free24(ptr2)
    ptr3 = Arena_Alloc24()
    Arena_Free24(ptr3)
    ptr4 = Arena_Alloc24()
    
    Test.name = "Multiple free/reuse cycles work"
    Test.actual = EqualTo(ptr3, ptr4)
    Test.expected = 1
    RunTask(Check)
}

// =============================================================================
// TEST 4: Sequential Allocations Are Contiguous
// =============================================================================
SubRoutine.Test_Contiguous {
    PrintMessage("\n=== TEST 4: Contiguous Allocations ===\n")
    
    // Fresh allocations should be sequential (bump allocation)
    // First drain free list by allocating a bunch
    i = 0
    WhileLoop LessThan(i, 100) {
        tmp = Arena_Alloc64()
        i = Add(i, 1)
    }
    
    // Now allocate two more - should be contiguous
    a = Arena_Alloc64()
    b = Arena_Alloc64()
    
    Test.name = "Sequential 64-byte allocs are 64 bytes apart"
    diff = Subtract(b, a)
    Test.actual = EqualTo(diff, 64)
    Test.expected = 1
    RunTask(Check)
    
    // Same for 24-byte
    i = 0
    WhileLoop LessThan(i, 100) {
        tmp = Arena_Alloc24()
        i = Add(i, 1)
    }
    
    c = Arena_Alloc24()
    d = Arena_Alloc24()
    
    Test.name = "Sequential 24-byte allocs are 24 bytes apart"
    diff = Subtract(d, c)
    Test.actual = EqualTo(diff, 24)
    Test.expected = 1
    RunTask(Check)
}

// =============================================================================
// TEST 5: Stress Test - Many Allocations
// =============================================================================
SubRoutine.Test_Stress {
    PrintMessage("\n=== TEST 5: Stress Test ===\n")
    
    PrintMessage("  Allocating 100,000 24-byte blocks...\n")
    
    start_allocs = Slab24.alloc_count
    
    i = 0
    WhileLoop LessThan(i, 100000) {
        ptr = Arena_Alloc24()
        
        // Write something to verify it's valid memory
        StoreValue(ptr, i)
        
        i = Add(i, 1)
    }
    
    end_allocs = Slab24.alloc_count
    
    Test.name = "100,000 allocations completed"
    Test.actual = Subtract(end_allocs, start_allocs)
    Test.expected = 100000
    RunTask(Check)
    
    // Check chunks used - should be reasonable
    // 100,000 * 24 = 2.4MB, so should fit in 1 chunk (4MB)
    Test.name = "Chunks used is reasonable (<=2)"
    Test.actual = LessEqual(Slab24.chunk_count, 2)
    Test.expected = 1
    RunTask(Check)
    
    PrintMessage("  Slab24 chunks: ")
    PrintNumber(Slab24.chunk_count)
    PrintMessage("\n")
}

// =============================================================================
// TEST 6: Stress Test - Alloc/Free Cycles
// =============================================================================
SubRoutine.Test_AllocFreeCycles {
    PrintMessage("\n=== TEST 6: Alloc/Free Cycles ===\n")
    
    PrintMessage("  Running 50,000 alloc/free cycles...\n")
    
    i = 0
    WhileLoop LessThan(i, 50000) {
        ptr = Arena_Alloc24()
        StoreValue(ptr, i)
        val = Dereference(ptr)
        Arena_Free24(ptr)
        i = Add(i, 1)
    }
    
    Test.name = "50,000 alloc/free cycles completed"
    Test.actual = 1
    Test.expected = 1
    RunTask(Check)
    
    // After all those frees, free list should be substantial
    // But we can't directly check free list length easily
    // Instead verify another alloc still works
    ptr = Arena_Alloc24()
    StoreValue(ptr, 999)
    
    Test.name = "Allocation works after many cycles"
    Test.actual = Dereference(ptr)
    Test.expected = 999
    RunTask(Check)
}

// =============================================================================
// TEST 7: Mixed Size Allocations
// =============================================================================
SubRoutine.Test_MixedSizes {
    PrintMessage("\n=== TEST 7: Mixed Size Allocations ===\n")
    
    // Interleave different sizes
    i = 0
    WhileLoop LessThan(i, 1000) {
        p24 = Arena_Alloc24()
        StoreValue(p24, 24)
        
        p32 = Arena_Alloc32()
        StoreValue(p32, 32)
        
        p64 = Arena_Alloc64()
        StoreValue(p64, 64)
        
        p128 = Arena_Alloc128()
        StoreValue(p128, 128)
        
        // Verify all still readable
        IfCondition NotEqual(Dereference(p24), 24) ThenBlock: {
            PrintMessage("  ERROR: p24 corrupted at iteration ")
            PrintNumber(i)
            PrintMessage("\n")
        }
        
        i = Add(i, 1)
    }
    
    Test.name = "1000 mixed-size allocation rounds"
    Test.actual = 1
    Test.expected = 1
    RunTask(Check)
}

// =============================================================================
// TEST 8: Large Allocation (General Arena)
// =============================================================================
SubRoutine.Test_LargeAlloc {
    PrintMessage("\n=== TEST 8: Large Allocations ===\n")
    
    // Allocate 1KB
    ptr1k = Arena_Alloc(1024)
    Test.name = "1KB allocation succeeds"
    Test.actual = NotEqual(ptr1k, 0)
    Test.expected = 1
    RunTask(Check)
    
    // Write pattern across it
    StoreValue(ptr1k, 1111)
    StoreValue(Add(ptr1k, 512), 2222)
    StoreValue(Add(ptr1k, 1016), 3333)
    
    Test.name = "1KB block offset 0"
    Test.actual = Dereference(ptr1k)
    Test.expected = 1111
    RunTask(Check)
    
    Test.name = "1KB block offset 512"
    Test.actual = Dereference(Add(ptr1k, 512))
    Test.expected = 2222
    RunTask(Check)
    
    // Allocate 64KB
    ptr64k = Arena_Alloc(65536)
    Test.name = "64KB allocation succeeds"
    Test.actual = NotEqual(ptr64k, 0)
    Test.expected = 1
    RunTask(Check)
}

// =============================================================================
// TEST 9: Unified Allocator Routing
// =============================================================================
SubRoutine.Test_UnifiedRouting {
    PrintMessage("\n=== TEST 9: Unified Allocator Routing ===\n")
    
    before24 = Slab24.alloc_count
    before32 = Slab32.alloc_count
    before64 = Slab64.alloc_count
    before128 = Slab128.alloc_count
    
    // These should route to specific slabs
    Arena_Alloc(8)    // -> Slab24
    Arena_Alloc(24)   // -> Slab24
    Arena_Alloc(25)   // -> Slab32
    Arena_Alloc(32)   // -> Slab32
    Arena_Alloc(33)   // -> Slab64
    Arena_Alloc(64)   // -> Slab64
    Arena_Alloc(65)   // -> Slab128
    Arena_Alloc(128)  // -> Slab128
    
    Test.name = "Sizes <=24 route to Slab24"
    Test.actual = Subtract(Slab24.alloc_count, before24)
    Test.expected = 2
    RunTask(Check)
    
    Test.name = "Sizes 25-32 route to Slab32"
    Test.actual = Subtract(Slab32.alloc_count, before32)
    Test.expected = 2
    RunTask(Check)
    
    Test.name = "Sizes 33-64 route to Slab64"
    Test.actual = Subtract(Slab64.alloc_count, before64)
    Test.expected = 2
    RunTask(Check)
    
    Test.name = "Sizes 65-128 route to Slab128"
    Test.actual = Subtract(Slab128.alloc_count, before128)
    Test.expected = 2
    RunTask(Check)
}

// =============================================================================
// TEST 10: Chunk Growth
// =============================================================================
SubRoutine.Test_ChunkGrowth {
    PrintMessage("\n=== TEST 10: Chunk Growth ===\n")
    
    // 4MB chunk / 128 bytes = 32,768 allocations before growth
    // Allocate enough to force at least one growth
    
    start_chunks = Slab128.chunk_count
    
    PrintMessage("  Allocating 40,000 128-byte blocks...\n")
    i = 0
    WhileLoop LessThan(i, 40000) {
        ptr = Arena_Alloc128()
        StoreValue(ptr, i)
        i = Add(i, 1)
    }
    
    end_chunks = Slab128.chunk_count
    
    Test.name = "Chunk growth occurred"
    Test.actual = GreaterThan(end_chunks, start_chunks)
    Test.expected = 1
    RunTask(Check)
    
    PrintMessage("  Slab128 grew from ")
    PrintNumber(start_chunks)
    PrintMessage(" to ")
    PrintNumber(end_chunks)
    PrintMessage(" chunks\n")
}

// =============================================================================
// MAIN
// =============================================================================

PrintMessage("╔══════════════════════════════════════════╗\n")
PrintMessage("║     ARENA ALLOCATOR TEST SUITE           ║\n")
PrintMessage("╚══════════════════════════════════════════╝\n")

// Initialize arena
PrintMessage("\nInitializing arena...\n")
Arena_Init()
PrintMessage("Arena initialized.\n")

// Run all tests
RunTask(Test_BasicAlloc)
RunTask(Test_DataIntegrity)
RunTask(Test_FreeListReuse)
RunTask(Test_Contiguous)
RunTask(Test_Stress)
RunTask(Test_AllocFreeCycles)
RunTask(Test_MixedSizes)
RunTask(Test_LargeAlloc)
RunTask(Test_UnifiedRouting)
RunTask(Test_ChunkGrowth)

// Final report
PrintMessage("\n╔══════════════════════════════════════════╗\n")
PrintMessage("║           TEST RESULTS                   ║\n")
PrintMessage("╚══════════════════════════════════════════╝\n")
PrintMessage("Passed: ")
PrintNumber(Test.passed)
PrintMessage("\nFailed: ")
PrintNumber(Test.failed)
PrintMessage("\nTotal:  ")
PrintNumber(Test.total)
PrintMessage("\n")

IfCondition EqualTo(Test.failed, 0) ThenBlock: {
    PrintMessage("\n✓ ALL TESTS PASSED\n")
} ElseBlock: {
    PrintMessage("\n✗ SOME TESTS FAILED\n")
}

// Memory report
Arena_Report()