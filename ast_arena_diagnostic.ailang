// ast_arena_diagnostic.ailang
// Diagnose why Arena_Alloc64 crashes in CASTCore
// Tests the exact allocation pattern used by AST_Create

LibraryImport.Arena
LibraryImport.XArrays

FixedPool.Diag {
    "node": Initialize=0
    "children": Initialize=0
    "step": Initialize=0
}

// =============================================================================
// TEST 1: Raw Arena_Alloc64 without XArrays
// =============================================================================
SubRoutine.Test1_RawAlloc64 {
    PrintMessage("\n=== TEST 1: Raw Arena_Alloc64 ===\n")
    
    PrintMessage("  Calling Arena_Alloc64()...\n")
    Diag.node = Arena_Alloc64()
    PrintMessage("  Got address: ")
    PrintNumber(Diag.node)
    PrintMessage("\n")
    
    IfCondition EqualTo(Diag.node, 0) ThenBlock: {
        PrintMessage("  FAIL: Got null pointer!\n")
        ReturnValue(0)
    }
    
    PrintMessage("  Writing to offset 0...\n")
    StoreValue(Diag.node, 100)
    
    PrintMessage("  Writing to offset 56...\n")
    StoreValue(Add(Diag.node, 56), 999)
    
    PrintMessage("  Reading back offset 0: ")
    PrintNumber(Dereference(Diag.node))
    PrintMessage("\n")
    
    PrintMessage("  Reading back offset 56: ")
    PrintNumber(Dereference(Add(Diag.node, 56)))
    PrintMessage("\n")
    
    PrintMessage("  TEST 1 PASSED\n")
}

// =============================================================================
// TEST 2: Arena_Alloc64 with all 8 AST field writes
// =============================================================================
SubRoutine.Test2_AllFields {
    PrintMessage("\n=== TEST 2: All 8 AST Field Writes ===\n")
    
    Diag.node = Arena_Alloc64()
    PrintMessage("  Allocated at: ")
    PrintNumber(Diag.node)
    PrintMessage("\n")
    
    PrintMessage("  Writing TYPE at offset 0...\n")
    StoreValue(Diag.node, 100)
    
    PrintMessage("  Writing LINE at offset 8...\n")
    StoreValue(Add(Diag.node, 8), 0)
    
    PrintMessage("  Writing COL at offset 16...\n")
    StoreValue(Add(Diag.node, 16), 0)
    
    PrintMessage("  Writing DATA1 at offset 24...\n")
    StoreValue(Add(Diag.node, 24), 0)
    
    PrintMessage("  Writing DATA2 at offset 32...\n")
    StoreValue(Add(Diag.node, 32), 0)
    
    PrintMessage("  Writing DATA3 at offset 40...\n")
    StoreValue(Add(Diag.node, 40), 0)
    
    PrintMessage("  Writing DATA4 at offset 48...\n")
    StoreValue(Add(Diag.node, 48), 0)
    
    PrintMessage("  Writing CHILDREN at offset 56...\n")
    StoreValue(Add(Diag.node, 56), 0)
    
    PrintMessage("  All writes successful!\n")
    PrintMessage("  TEST 2 PASSED\n")
}

// =============================================================================
// TEST 3: XArray.XCreate AFTER Arena_Alloc64
// =============================================================================
SubRoutine.Test3_XArrayAfterAlloc {
    PrintMessage("\n=== TEST 3: XArray.XCreate After Arena_Alloc64 ===\n")
    
    PrintMessage("  Step 1: Arena_Alloc64...\n")
    Diag.node = Arena_Alloc64()
    PrintMessage("    node = ")
    PrintNumber(Diag.node)
    PrintMessage("\n")
    
    PrintMessage("  Step 2: XArray.XCreate(8)...\n")
    Diag.children = XArray.XCreate(8)
    PrintMessage("    children = ")
    PrintNumber(Diag.children)
    PrintMessage("\n")
    
    PrintMessage("  Step 3: Store children ptr at node+56...\n")
    StoreValue(Add(Diag.node, 56), Diag.children)
    
    PrintMessage("  Step 4: Read back children ptr...\n")
    read_back = Dereference(Add(Diag.node, 56))
    PrintMessage("    read = ")
    PrintNumber(read_back)
    PrintMessage("\n")
    
    IfCondition EqualTo(read_back, Diag.children) ThenBlock: {
        PrintMessage("  TEST 3 PASSED\n")
    } ElseBlock: {
        PrintMessage("  TEST 3 FAILED - pointer mismatch!\n")
    }
}

// =============================================================================
// TEST 4: Exact AST_Create pattern
// =============================================================================
SubRoutine.Test4_ExactASTPattern {
    PrintMessage("\n=== TEST 4: Exact AST_Create Pattern ===\n")
    
    node_type = 100
    
    PrintMessage("  Allocating 64-byte node...\n")
    node = Arena_Alloc64()
    
    PrintMessage("  Initializing all fields to 0...\n")
    StoreValue(node, node_type)
    StoreValue(Add(node, 8), 0)
    StoreValue(Add(node, 16), 0)
    StoreValue(Add(node, 24), 0)
    StoreValue(Add(node, 32), 0)
    StoreValue(Add(node, 40), 0)
    StoreValue(Add(node, 48), 0)
    
    PrintMessage("  Creating children XArray...\n")
    children = XArray.XCreate(8)
    
    PrintMessage("  Storing children pointer...\n")
    StoreValue(Add(node, 56), children)
    
    PrintMessage("  Verifying node type: ")
    PrintNumber(Dereference(node))
    PrintMessage("\n")
    
    PrintMessage("  TEST 4 PASSED\n")
}

// =============================================================================
// TEST 5: Compare 64 vs 128 byte allocation
// =============================================================================
SubRoutine.Test5_Compare64vs128 {
    PrintMessage("\n=== TEST 5: Compare 64 vs 128 Byte Slabs ===\n")
    
    PrintMessage("  Arena_Alloc64: ")
    p64 = Arena_Alloc64()
    PrintNumber(p64)
    PrintMessage("\n")
    
    PrintMessage("  Arena_Alloc128: ")
    p128 = Arena_Alloc128()
    PrintNumber(p128)
    PrintMessage("\n")
    
    PrintMessage("  Arena_Alloc(64): ")
    p64b = Arena_Alloc(64)
    PrintNumber(p64b)
    PrintMessage("\n")
    
    PrintMessage("  Arena_Alloc(65): ")
    p65 = Arena_Alloc(65)
    PrintNumber(p65)
    PrintMessage(" (should route to Slab128)\n")
    
    // Write to all of them
    PrintMessage("  Writing 0xDEAD to offset 56 of each...\n")
    StoreValue(Add(p64, 56), 57005)
    StoreValue(Add(p128, 56), 57005)
    StoreValue(Add(p64b, 56), 57005)
    StoreValue(Add(p65, 56), 57005)
    
    PrintMessage("  All writes successful\n")
    PrintMessage("  TEST 5 PASSED\n")
}

// =============================================================================
// TEST 6: Multiple AST nodes (simulating parser)
// =============================================================================
SubRoutine.Test6_MultipleNodes {
    PrintMessage("\n=== TEST 6: Multiple AST Nodes ===\n")
    
    PrintMessage("  Creating 100 AST-like nodes...\n")
    
    i = 0
    WhileLoop LessThan(i, 100) {
        node = Arena_Alloc64()
        
        // Initialize like AST_Create
        StoreValue(node, i)
        StoreValue(Add(node, 8), 0)
        StoreValue(Add(node, 16), 0)
        StoreValue(Add(node, 24), 0)
        StoreValue(Add(node, 32), 0)
        StoreValue(Add(node, 40), 0)
        StoreValue(Add(node, 48), 0)
        
        children = XArray.XCreate(8)
        StoreValue(Add(node, 56), children)
        
        // Verify
        IfCondition NotEqual(Dereference(node), i) ThenBlock: {
            PrintMessage("  FAIL at node ")
            PrintNumber(i)
            PrintMessage("\n")
            ExitLoop
        }
        
        i = Add(i, 1)
    }
    
    PrintMessage("  Created 100 nodes successfully\n")
    PrintMessage("  TEST 6 PASSED\n")
}

// =============================================================================
// TEST 7: Boundary write test (is 64 really 64?)
// =============================================================================
SubRoutine.Test7_BoundaryTest {
    PrintMessage("\n=== TEST 7: Boundary Write Test ===\n")
    
    p = Arena_Alloc64()
    PrintMessage("  Allocated 64-byte block at: ")
    PrintNumber(p)
    PrintMessage("\n")
    
    // Write at every 8-byte offset
    PrintMessage("  Writing at offsets 0,8,16,24,32,40,48,56...\n")
    StoreValue(Add(p, 0), 1000)
    StoreValue(Add(p, 8), 1001)
    StoreValue(Add(p, 16), 1002)
    StoreValue(Add(p, 24), 1003)
    StoreValue(Add(p, 32), 1004)
    StoreValue(Add(p, 40), 1005)
    StoreValue(Add(p, 48), 1006)
    StoreValue(Add(p, 56), 1007)
    
    PrintMessage("  Reading back all values:\n")
    PrintMessage("    offset 0:  ")
    PrintNumber(Dereference(Add(p, 0)))
    PrintMessage("\n")
    PrintMessage("    offset 8:  ")
    PrintNumber(Dereference(Add(p, 8)))
    PrintMessage("\n")
    PrintMessage("    offset 16: ")
    PrintNumber(Dereference(Add(p, 16)))
    PrintMessage("\n")
    PrintMessage("    offset 24: ")
    PrintNumber(Dereference(Add(p, 24)))
    PrintMessage("\n")
    PrintMessage("    offset 32: ")
    PrintNumber(Dereference(Add(p, 32)))
    PrintMessage("\n")
    PrintMessage("    offset 40: ")
    PrintNumber(Dereference(Add(p, 40)))
    PrintMessage("\n")
    PrintMessage("    offset 48: ")
    PrintNumber(Dereference(Add(p, 48)))
    PrintMessage("\n")
    PrintMessage("    offset 56: ")
    PrintNumber(Dereference(Add(p, 56)))
    PrintMessage("\n")
    
    // Now the dangerous part - what happens at offset 64?
    PrintMessage("\n  DANGER ZONE: Attempting write at offset 64...\n")
    PrintMessage("  (This SHOULD be out of bounds for a 64-byte block)\n")
    
    // Allocate another block right after to detect corruption
    p2 = Arena_Alloc64()
    StoreValue(p2, 9999)
    
    PrintMessage("  Next block at: ")
    PrintNumber(p2)
    PrintMessage(" with value 9999\n")
    
    PrintMessage("  Gap between blocks: ")
    PrintNumber(Subtract(p2, p))
    PrintMessage(" bytes\n")
    
    // If gap is exactly 64, writing at p+64 would corrupt p2!
    IfCondition EqualTo(Subtract(p2, p), 64) ThenBlock: {
        PrintMessage("  WARNING: Blocks are contiguous!\n")
        PrintMessage("  Writing at p+64 would corrupt next block.\n")
    }
    
    PrintMessage("  TEST 7 PASSED\n")
}

// =============================================================================
// TEST 8: Use Arena_Alloc(64) instead of Arena_Alloc64
// =============================================================================
SubRoutine.Test8_GenericAlloc {
    PrintMessage("\n=== TEST 8: Arena_Alloc(64) Generic Path ===\n")
    
    node = Arena_Alloc(64)
    PrintMessage("  Arena_Alloc(64) returned: ")
    PrintNumber(node)
    PrintMessage("\n")
    
    // Full AST pattern
    StoreValue(node, 200)
    StoreValue(Add(node, 8), 0)
    StoreValue(Add(node, 16), 0)
    StoreValue(Add(node, 24), 0)
    StoreValue(Add(node, 32), 0)
    StoreValue(Add(node, 40), 0)
    StoreValue(Add(node, 48), 0)
    
    children = XArray.XCreate(8)
    StoreValue(Add(node, 56), children)
    
    PrintMessage("  Full AST pattern with Arena_Alloc(64) worked!\n")
    PrintMessage("  TEST 8 PASSED\n")
}

// =============================================================================
// MAIN
// =============================================================================

PrintMessage("╔═══════════════════════════════════════════╗\n")
PrintMessage("║   AST ARENA ALLOCATION DIAGNOSTIC         ║\n")
PrintMessage("╚═══════════════════════════════════════════╝\n")

PrintMessage("\nInitializing Arena...\n")
Arena_Init()
PrintMessage("Arena ready.\n")

RunTask(Test1_RawAlloc64)
RunTask(Test2_AllFields)
RunTask(Test3_XArrayAfterAlloc)
RunTask(Test4_ExactASTPattern)
RunTask(Test5_Compare64vs128)
RunTask(Test6_MultipleNodes)
RunTask(Test7_BoundaryTest)
RunTask(Test8_GenericAlloc)

PrintMessage("\n╔═══════════════════════════════════════════╗\n")
PrintMessage("║   ALL TESTS COMPLETED                     ║\n")
PrintMessage("╚═══════════════════════════════════════════╝\n")

PrintMessage("\nArena Statistics:\n")
Arena_Report()