// =============================================================================
// AILANG Comprehensive Performance Benchmark Suite
// With DebugPerf instrumentation for RDTSC cycle-accurate profiling
// Compile with: ./ailang.x -P bench_suite.ailang bench_suite.x
// =============================================================================

LibraryImport.Arena

// =============================================================================
// TEST 1: Prime Sieve
// =============================================================================
Function.Bench_Primes {
    Output: Integer
    Body: {
        DebugPerf.Start("primes_total")
        limit = 1000000
        count = 0
        n = 2
        WhileLoop LessThan(n, limit) {
            is_prime = 1
            i = 2
            WhileLoop LessThan(Multiply(i, i), Add(n, 1)) {
                IfCondition EqualTo(Modulo(n, i), 0) ThenBlock: {
                    is_prime = 0
                }
                i = Add(i, 1)
            }
            IfCondition EqualTo(is_prime, 1) ThenBlock: {
                count = Add(count, 1)
            }
            n = Add(n, 1)
        }
        DebugPerf.End("primes_total")
        ReturnValue(count)
    }
}

// =============================================================================
// TEST 2: Integer Arithmetic Stress
// =============================================================================
Function.Bench_Arithmetic {
    Output: Integer
    Body: {
        DebugPerf.Start("arithmetic")
        result = 0
        i = 1
        WhileLoop LessThan(i, 10000000) {
            a = Multiply(i, 31337)
            b = Modulo(a, 99991)
            c = BitwiseXor(b, LeftShift(i, 3))
            d = BitwiseAnd(c, 0xFFFF)
            result = BitwiseXor(result, Add(d, i))
            i = Add(i, 1)
        }
        DebugPerf.End("arithmetic")
        ReturnValue(result)
    }
}

// =============================================================================
// TEST 3: Memory Sequential
// =============================================================================
Function.Bench_MemSequential {
    Output: Integer
    Body: {
        DebugPerf.Start("mem_seq_total")
        size = 10000000
        buf = Allocate(Multiply(size, 8))

        DebugPerf.Start("mem_seq_write")
        i = 0
        WhileLoop LessThan(i, size) {
            off = Multiply(i, 8)
            StoreValue(Add(buf, off), Multiply(i, 7))
            i = Add(i, 1)
        }
        DebugPerf.End("mem_seq_write")

        DebugPerf.Start("mem_seq_read")
        sum = 0
        i = 0
        WhileLoop LessThan(i, size) {
            off = Multiply(i, 8)
            val = Dereference(Add(buf, off))
            sum = Add(sum, val)
            i = Add(i, 1)
        }
        DebugPerf.End("mem_seq_read")

        Deallocate(buf, Multiply(size, 8))
        DebugPerf.End("mem_seq_total")
        ReturnValue(sum)
    }
}

// =============================================================================
// TEST 4: Memory Random
// =============================================================================
Function.Bench_MemRandom {
    Output: Integer
    Body: {
        DebugPerf.Start("mem_random_total")
        size = 1000000
        buf = Allocate(Multiply(size, 8))

        DebugPerf.Start("mem_random_fill")
        i = 0
        WhileLoop LessThan(i, size) {
            off = Multiply(i, 8)
            StoreValue(Add(buf, off), i)
            i = Add(i, 1)
        }
        DebugPerf.End("mem_random_fill")

        DebugPerf.Start("mem_random_read")
        sum = 0
        i = 0
        WhileLoop LessThan(i, size) {
            idx = Modulo(Multiply(i, 1000003), size)
            off = Multiply(idx, 8)
            val = Dereference(Add(buf, off))
            sum = Add(sum, val)
            i = Add(i, 1)
        }
        DebugPerf.End("mem_random_read")

        Deallocate(buf, Multiply(size, 8))
        DebugPerf.End("mem_random_total")
        ReturnValue(sum)
    }
}

// =============================================================================
// TEST 5: Recursive Fibonacci
// =============================================================================
Function.Fib {
    Input: n: Integer
    Output: Integer
    Body: {
        result = 0
        is_base = LessThan(n, 2)
        IfCondition EqualTo(is_base, 1) ThenBlock: {
            result = n
        } ElseBlock: {
            n1 = Subtract(n, 1)
            n2 = Subtract(n, 2)
            a = Fib(n1)
            b = Fib(n2)
            result = Add(a, b)
        }
        ReturnValue(result)
    }
}

Function.Bench_Fibonacci {
    Output: Integer
    Body: {
        result = 0
        i = 0
        WhileLoop LessThan(i, 10) {
            f = Fib(35)
            result = Add(result, f)
            i = Add(i, 1)
        }
        ReturnValue(result)
    }
}
// =============================================================================
// TEST 6: String Operations
// =============================================================================
Function.Bench_Strings {
    Output: Integer
    Body: {
        DebugPerf.Start("strings_total")
        count = 0
        i = 0
        WhileLoop LessThan(i, 100000) {
            s1 = StringConcat("Hello", " World")
            s2 = StringToUpper(s1)
            l = StringLength(s2)
            IfCondition EqualTo(l, 11) ThenBlock: {
                count = Add(count, 1)
            }
            i = Add(i, 1)
        }
        DebugPerf.End("strings_total")
        ReturnValue(count)
    }
}

// =============================================================================
// TEST 7: Bubble Sort
// =============================================================================

Function.Bench_BubbleSort {
    Output: Integer
    Body: {
        size = 10000
        bytes = Multiply(size, 8)
        buf = Allocate(bytes)

        // Fill descending
        i = 0
        WhileLoop LessThan(i, size) {
            off = Multiply(i, 8)
            val = Subtract(size, i)
            StoreValue(Add(buf, off), val)
            i = Add(i, 1)
        }

        // Bubble sort — all expressions flattened
        i = 0
        WhileLoop LessThan(i, size) {
            limit = Subtract(size, 1)
            limit = Subtract(limit, i)
            j = 0
            WhileLoop LessThan(j, limit) {
                off_j = Multiply(j, 8)
                j1 = Add(j, 1)
                off_j1 = Multiply(j1, 8)
                addr_j = Add(buf, off_j)
                addr_j1 = Add(buf, off_j1)
                a = Dereference(addr_j)
                b = Dereference(addr_j1)
                IfCondition GreaterThan(a, b) ThenBlock: {
                    StoreValue(addr_j, b)
                    StoreValue(addr_j1, a)
                }
                j = Add(j, 1)
            }
            i = Add(i, 1)
        }

        // Sum
        sum = 0
        i = 0
        WhileLoop LessThan(i, size) {
            off = Multiply(i, 8)
            addr = Add(buf, off)
            val = Dereference(addr)
            sum = Add(sum, val)
            i = Add(i, 1)
        }

        Deallocate(buf, bytes)
        ReturnValue(sum)
    }
}

// =============================================================================
// TEST 8: Matrix Multiply 64x64
// =============================================================================

Function.Bench_MatrixMultiply {
    Output: Integer
    Body: {
        N = 64
        N2 = Multiply(N, N)
        bytes = Multiply(N2, 8)

        a = Allocate(bytes)
        b = Allocate(bytes)
        c = Allocate(bytes)

        // Fill A and B
        i = 0
        WhileLoop LessThan(i, N2) {
            off = Multiply(i, 8)
            addr_a = Add(a, off)
            addr_b = Add(b, off)
            addr_c = Add(c, off)
            val_a = Add(i, 1)
            val_b = Subtract(N2, i)
            StoreValue(addr_a, val_a)
            StoreValue(addr_b, val_b)
            StoreValue(addr_c, 0)
            i = Add(i, 1)
        }

        // C = A * B
        row = 0
        WhileLoop LessThan(row, N) {
            col = 0
            WhileLoop LessThan(col, N) {
                sum = 0
                k = 0
                WhileLoop LessThan(k, N) {
                    row_k = Add(Multiply(row, N), k)
                    k_col = Add(Multiply(k, N), col)
                    a_off = Multiply(row_k, 8)
                    b_off = Multiply(k_col, 8)
                    addr_a = Add(a, a_off)
                    addr_b = Add(b, b_off)
                    av = Dereference(addr_a)
                    bv = Dereference(addr_b)
                    prod = Multiply(av, bv)
                    sum = Add(sum, prod)
                    k = Add(k, 1)
                }
                row_col = Add(Multiply(row, N), col)
                c_off = Multiply(row_col, 8)
                addr_c = Add(c, c_off)
                StoreValue(addr_c, sum)
                col = Add(col, 1)
            }
            row = Add(row, 1)
        }

        // Checksum
        total = 0
        i = 0
        WhileLoop LessThan(i, N2) {
            off = Multiply(i, 8)
            addr_c = Add(c, off)
            val = Dereference(addr_c)
            total = Add(total, val)
            i = Add(i, 1)
        }

        Deallocate(a, bytes)
        Deallocate(b, bytes)
        Deallocate(c, bytes)
        ReturnValue(total)
    }
}

// =============================================================================
// TEST 9: Allocation Speed
// =============================================================================

Function.Bench_Allocation {
    Body: {
        DebugPerf.Start("alloc_sequential")
        last = 0
        i = 0
        WhileLoop LessThan(i, 10000000) {
            ptr = Allocate(64)
            SetByte(ptr, 0, 1)
            last = ptr
            i = Add(i, 1)
        }
        DebugPerf.End("alloc_sequential")

        DebugPerf.Start("alloc_free_cycle")
        i = 0
        WhileLoop LessThan(i, 10000000) {
            ptr = Allocate(64)
            SetByte(ptr, 0, 1)
            Deallocate(ptr, 64)
            i = Add(i, 1)
        }
        DebugPerf.End("alloc_free_cycle")

        DebugPerf.Start("alloc_mixed")
        i = 0
        WhileLoop LessThan(i, 10000000) {
            mod = Modulo(i, 3)
            IfCondition EqualTo(mod, 0) ThenBlock: {
                ptr = Allocate(64)
                SetByte(ptr, 0, 1)
                Deallocate(ptr, 64)
            }
            IfCondition EqualTo(mod, 1) ThenBlock: {
                ptr = Allocate(128)
                SetByte(ptr, 0, 1)
                Deallocate(ptr, 128)
            }
            IfCondition EqualTo(mod, 2) ThenBlock: {
                ptr = Allocate(256)
                SetByte(ptr, 0, 1)
                Deallocate(ptr, 256)
            }
            i = Add(i, 1)
        }
        DebugPerf.End("alloc_mixed")

        DebugPerf.Start("alloc_batch")
        batch = 100000
        ptrs = Allocate(Multiply(batch, 8))
        outer = 0
        WhileLoop LessThan(outer, 100) {
            i = 0
            WhileLoop LessThan(i, batch) {
                ptr = Allocate(64)
                SetByte(ptr, 0, 1)
                off = Multiply(i, 8)
                addr = Add(ptrs, off)
                StoreValue(addr, ptr)
                i = Add(i, 1)
            }
            i = 0
            WhileLoop LessThan(i, batch) {
                off = Multiply(i, 8)
                addr = Add(ptrs, off)
                ptr = Dereference(addr)
                Deallocate(ptr, 64)
                i = Add(i, 1)
            }
            outer = Add(outer, 1)
        }
        Deallocate(ptrs, Multiply(batch, 8))
        DebugPerf.End("alloc_batch")
    }
}

// =============================================================================
// MAIN
// =============================================================================
SubRoutine.Main {
    PrintMessage("=== AILANG Benchmark Suite ===\n")
    PrintMessage("Compile with -P for cycle counts\n\n")

    PrintMessage("1. Prime Sieve (1M)... ")
    r1 = Bench_Primes()
    PrintMessage("Primes: ")
    PrintNumber(r1)
    PrintMessage("\n")

    PrintMessage("2. Integer Arithmetic (10M)... ")
    r2 = Bench_Arithmetic()
    PrintMessage("Result: ")
    PrintNumber(r2)
    PrintMessage("\n")

    PrintMessage("3. Memory Sequential (10M)... ")
    r3 = Bench_MemSequential()
    PrintMessage("Sum: ")
    PrintNumber(r3)
    PrintMessage("\n")

    PrintMessage("4. Memory Random (1M)... ")
    r4 = Bench_MemRandom()
    PrintMessage("Sum: ")
    PrintNumber(r4)
    PrintMessage("\n")

    PrintMessage("5. Fibonacci Fib(35)x10... ")
DebugPerf.Start("fibonacci_total")
r5 = Bench_Fibonacci()
DebugPerf.End("fibonacci_total")
PrintMessage("Result: ")
PrintNumber(r5)
PrintMessage("\n")

    PrintMessage("6. String Ops (100K)... ")
    r6 = Bench_Strings()
    PrintMessage("Count: ")
    PrintNumber(r6)
    PrintMessage("\n")

    PrintMessage("7. Bubble Sort (10K)... ")
DebugPerf.Start("bubblesort_outer")
r7 = Bench_BubbleSort()
DebugPerf.End("bubblesort_outer")
PrintMessage("Sum: ")
PrintNumber(r7)
PrintMessage("\n")

    PrintMessage("8. Matrix Multiply (64x64)... ")
DebugPerf.Start("matmul_outer")
r8 = Bench_MatrixMultiply()
DebugPerf.End("matmul_outer")
PrintMessage("Checksum: ")
PrintNumber(r8)
PrintMessage("\n")

PrintMessage("9. Allocation Speed (10M each)...\n")
DebugPerf.Start("alloc_outer")
Bench_Allocation()
DebugPerf.End("alloc_outer")
}

RunTask(Main)