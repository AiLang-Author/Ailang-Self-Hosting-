{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ailang.dev/schema/ailang.board.bind/v1",
  "title": "AILang HDL Board Bind",
  "description": "Maps design ports (ailang_top / FixedPool fields) onto a board profile resource.",
  "type": "object",
  "required": ["schema", "board", "bind"],
  "properties": {
    "schema": { "const": "ailang.board.bind/v1" },
    "board": {
      "type": "string",
      "description": "Board profile name or relative path under boards/"
    },
    "bind": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "properties": {
              "resource": { "type": "string" },
              "signal": { "type": "string" },
              "bits": { "type": "string", "description": "e.g. 5:0" },
              "invert": { "type": "boolean" }
            }
          },
          { "type": "null" }
        ]
      }
    },
    "policy": {
      "type": "object",
      "properties": {
        "unbound_out": { "enum": ["error", "warn", "ignore"] },
        "unbound_in": { "enum": ["error", "warn", "ignore"] },
        "emit_wrapper": { "type": "boolean" }
      }
    }
  }
}
