{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ailang.dev/schema/ailang.board/v1",
  "title": "AILang HDL Board Profile",
  "description": "Vendor-neutral board I/O map for AILang HDL. Humans and models author these; the compiler loads them at emit time for pin verification and constraint generation.",
  "type": "object",
  "required": ["schema", "name", "device", "resources"],
  "properties": {
    "schema": {
      "const": "ailang.board/v1"
    },
    "name": {
      "type": "string",
      "description": "Stable board id, e.g. tang_nano_9k"
    },
    "display_name": { "type": "string" },
    "vendor": {
      "type": "string",
      "description": "gowin | lattice | xilinx | intel | other"
    },
    "device": {
      "type": "object",
      "required": ["part"],
      "properties": {
        "part": { "type": "string" },
        "family": { "type": "string" },
        "loader_board": {
          "type": "string",
          "description": "openFPGALoader -b name"
        },
        "synth": {
          "type": "string",
          "description": "yosys synth_* name, e.g. gowin"
        }
      }
    },
    "clocks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["hz", "pin"],
        "properties": {
          "hz": { "type": "number" },
          "pin": { "type": "string" },
          "iostandard": { "type": "string" },
          "pull": { "type": "string" }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "dir": { "enum": ["in", "out", "inout"] },
          "width": { "type": "integer", "minimum": 1 },
          "pins": {
            "type": "array",
            "items": { "type": "string" }
          },
          "pin": { "type": "string" },
          "iostandard": { "type": "string" },
          "pull": { "type": "string" },
          "drive": { "type": "integer" },
          "invert": { "type": "boolean" },
          "signals": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "dir": { "enum": ["in", "out", "inout"] },
                "pin": { "type": "string" },
                "iostandard": { "type": "string" },
                "pull": { "type": "string" },
                "invert": { "type": "boolean" }
              }
            }
          },
          "notes": { "type": "string" }
        }
      }
    },
    "defaults": {
      "type": "object",
      "properties": {
        "clk": { "type": "string" },
        "rst": {
          "type": "object",
          "properties": {
            "tie": { "type": "integer" },
            "resource": { "type": "string" },
            "invert": { "type": "boolean" }
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "properties": {
        "url": { "type": "string" },
        "author": { "type": "string" },
        "license": { "type": "string" }
      }
    }
  }
}
