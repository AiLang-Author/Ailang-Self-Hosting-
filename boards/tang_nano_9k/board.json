{
  "schema": "ailang.board/v1",
  "name": "tang_nano_9k",
  "display_name": "Sipeed Tang Nano 9K",
  "vendor": "gowin",
  "device": {
    "part": "GW1NR-LV9QN88PC6/I5",
    "family": "GW1N-9C",
    "loader_board": "tangnano9k",
    "synth": "gowin"
  },
  "clocks": {
    "clk27": {
      "hz": 27000000,
      "pin": "52",
      "iostandard": "LVCMOS33",
      "pull": "up"
    }
  },
  "resources": {
    "led": {
      "dir": "out",
      "width": 6,
      "pins": ["10", "11", "13", "14", "15", "16"],
      "iostandard": "LVCMOS33",
      "invert": true,
      "notes": "On-board LEDs, active-low (common anode)"
    },
    "btn": {
      "dir": "in",
      "width": 2,
      "pins": ["3", "4"],
      "iostandard": "LVCMOS33",
      "invert": true,
      "notes": "User buttons, active-low"
    },
    "uart0": {
      "signals": {
        "tx": { "dir": "out", "pin": "17", "iostandard": "LVCMOS33" },
        "rx": { "dir": "in", "pin": "18", "iostandard": "LVCMOS33", "pull": "up" }
      },
      "notes": "USB-UART bridge"
    }
  },
  "defaults": {
    "clk": "clk27",
    "rst": { "tie": 0 }
  },
  "meta": {
    "url": "https://wiki.sipeed.com/hardware/en/tang/Tang-Nano-9K/Nano-9K.html",
    "author": "AILang project",
    "license": "CC0-1.0"
  }
}
