Function.AddTwo {
    Input: a: Integer
    Input: b: Integer
    Output: Integer
    Body: {
        ReturnValue(Add(a, b))
    }
}

SubRoutine.Main {
    sum = 0
    i = 0
    WhileLoop LessThan(i, 100000000) {
        sum = Add(sum, AddTwo(i, 1))
        i = Add(i, 1)
    }
    PrintMessage("Sum: ")
    PrintNumber(sum)
    PrintMessage("\n")
}
RunTask(Main)
