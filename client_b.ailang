// client_b.ailang
// Client B — the "app service" side
// Receives requests from Client A via broker, processes them, sends replies.
//
// Build: ./build.sh TestCode/client_b.ailang
// Run:   ./client_b.x  (after msg_broker.x is running, before client_a.x)

LibraryImport.Arena
LibraryImport.Socket
LibraryImport.StringUtils
LibraryImport.JSON
LibraryImport.XArrays
LibraryImport.HashMap

FixedPool.ServiceB {
    "running":     Initialize=1
    "msg_handled": Initialize=0
}

SubRoutine.Main {
    Arena_Init()

    PrintMessage("============================================\n")
    PrintMessage("  Client B — Service Worker\n")
    PrintMessage("============================================\n\n")

    sock_path = "/tmp/ailang_broker.sock"

    // Connect to broker
    sock = Socket.Create(1, 1)
    IfCondition LessThan(sock, 0) ThenBlock: {
        PrintMessage("[B] Socket create failed\n")
        HaltProgram
    }

    cres = Socket.ConnectUnix(sock, sock_path)
    IfCondition LessThan(cres, 0) ThenBlock: {
        PrintMessage("[B] Connect failed — is broker running?\n")
        Socket.Close(sock)
        HaltProgram
    }
    PrintMessage("[B] Connected to broker\n")
    PrintMessage("[B] Waiting for requests...\n\n")

    // Service loop — receive request, process, send reply
    WhileLoop EqualTo(ServiceB.running, 1) {
        msg = Socket.RecvMsg(sock)
        IfCondition EqualTo(msg, 0) ThenBlock: {
            PrintMessage("[B] Connection closed\n")
            ServiceB.running = 0
        } ElseBlock: {
            ServiceB.msg_handled = Add(ServiceB.msg_handled, 1)
            PrintMessage("[B] Recv #")
            PrintNumber(ServiceB.msg_handled)
            PrintMessage(": ")
            PrintMessage(msg)
            PrintMessage("\n")

            // Parse the request
            parsed = ParseJSON(msg)
            IfCondition EqualTo(parsed, 0) ThenBlock: {
                PrintMessage("[B] Parse error, skipping\n")
            } ElseBlock: {
                req = JSON.AsObject(parsed)
                method = JSON.GetString(req, "method")

                IfCondition EqualTo(method, 0) ThenBlock: {
                    PrintMessage("[B] No method field\n")
                } ElseBlock: {
                    // ---- PING ----
                    cmp_ping = StringCompare(method, "ping")
                    IfCondition EqualTo(cmp_ping, 0) ThenBlock: {
                        PrintMessage("[B] Handling: ping\n")
                        reply = JSON.NewObject()
                        JSON.SetString(reply, "method", "pong")
                        JSON.SetString(reply, "from", "client_b")
                        JSON.SetNumber(reply, "seq", JSON.GetNumber(req, "seq"))
                        rjson = JSON.SerializeObject(reply)
                        PrintMessage("[B] Reply: ")
                        PrintMessage(rjson)
                        PrintMessage("\n\n")
                        Socket.SendMsg(sock, rjson)
                    }

                    // ---- CALCULATE ----
                    cmp_calc = StringCompare(method, "calculate")
                    IfCondition EqualTo(cmp_calc, 0) ThenBlock: {
                        PrintMessage("[B] Handling: calculate\n")
                        a = JSON.GetNumber(req, "a")
                        b = JSON.GetNumber(req, "b")
                        op = JSON.GetString(req, "op")

                        result = 0
                        IfCondition NotEqual(op, 0) ThenBlock: {
                            cmp_add = StringCompare(op, "add")
                            IfCondition EqualTo(cmp_add, 0) ThenBlock: {
                                result = Add(a, b)
                            }
                            cmp_sub = StringCompare(op, "subtract")
                            IfCondition EqualTo(cmp_sub, 0) ThenBlock: {
                                result = Subtract(a, b)
                            }
                            cmp_mul = StringCompare(op, "multiply")
                            IfCondition EqualTo(cmp_mul, 0) ThenBlock: {
                                result = Multiply(a, b)
                            }
                        }

                        reply = JSON.NewObject()
                        JSON.SetString(reply, "method", "result")
                        JSON.SetString(reply, "from", "client_b")
                        JSON.SetNumber(reply, "result", result)
                        JSON.SetString(reply, "op", op)
                        rjson = JSON.SerializeObject(reply)
                        PrintMessage("[B] Reply: ")
                        PrintMessage(rjson)
                        PrintMessage("\n\n")
                        Socket.SendMsg(sock, rjson)
                    }

                    // ---- FILE.LIST ----
                    cmp_flist = StringCompare(method, "file.list")
                    IfCondition EqualTo(cmp_flist, 0) ThenBlock: {
                        PrintMessage("[B] Handling: file.list\n")
                        pid = JSON.GetNumber(req, "parent_id")

                        // Build mock file listing
                        files = JSON.NewArray()

                        f1 = JSON.NewObject()
                        JSON.SetString(f1, "name", "home")
                        JSON.SetString(f1, "type", "dir")
                        JSON.PushObject(files, f1)

                        f2 = JSON.NewObject()
                        JSON.SetString(f2, "name", "etc")
                        JSON.SetString(f2, "type", "dir")
                        JSON.PushObject(files, f2)

                        f3 = JSON.NewObject()
                        JSON.SetString(f3, "name", "readme.txt")
                        JSON.SetString(f3, "type", "file")
                        JSON.SetNumber(f3, "size", 1024)
                        JSON.PushObject(files, f3)

                        reply = JSON.NewObject()
                        JSON.SetString(reply, "method", "file.list.result")
                        JSON.SetString(reply, "from", "client_b")
                        JSON.SetNumber(reply, "parent_id", pid)
                        JSON.SetArray(reply, "files", files)
                        rjson = JSON.SerializeObject(reply)
                        PrintMessage("[B] Reply: ")
                        PrintMessage(rjson)
                        PrintMessage("\n\n")
                        Socket.SendMsg(sock, rjson)
                    }

                    // ---- ECHO ----
                    cmp_echo = StringCompare(method, "echo")
                    IfCondition EqualTo(cmp_echo, 0) ThenBlock: {
                        PrintMessage("[B] Handling: echo\n")
                        reply = JSON.NewObject()
                        JSON.SetString(reply, "method", "echo.reply")
                        JSON.SetString(reply, "from", "client_b")

                        // Copy payload if present
                        pay = JSON.GetObject(req, "payload")
                        IfCondition NotEqual(pay, 0) ThenBlock: {
                            JSON.SetObject(reply, "payload", pay)
                        }

                        rjson = JSON.SerializeObject(reply)
                        PrintMessage("[B] Reply: ")
                        PrintMessage(rjson)
                        PrintMessage("\n\n")
                        Socket.SendMsg(sock, rjson)
                    }

                    // ---- SHUTDOWN ----
                    cmp_shut = StringCompare(method, "shutdown")
                    IfCondition EqualTo(cmp_shut, 0) ThenBlock: {
                        PrintMessage("[B] Shutdown received\n")
                        ServiceB.running = 0
                    }
                }
            }
        }
    }

    Socket.Close(sock)

    PrintMessage("\n============================================\n")
    PrintMessage("  Client B handled ")
    PrintNumber(ServiceB.msg_handled)
    PrintMessage(" messages\n")
    PrintMessage("============================================\n")
}

RunTask(Main)