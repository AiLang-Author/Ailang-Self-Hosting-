    "SENDMESSAGE": Initialize=16
    "RECEIVEMESSAGE": Initialize=17
    "EVERYINTERVAL": Initialize=18
    "BREAKLOOP": Initialize=19
    "HALTPROGRAM": Initialize=20
    "DEBUG": Initialize=21
    "DEBUGASSERT": Initialize=22
    "DEBUGTRACE": Initialize=23
    "DEBUGBREAK": Initialize=24
    "DEBUGMEMORY": Initialize=25
    "DEBUGPERF": Initialize=26
    "DEBUGINSPECT": Initialize=27
    "DEBUGCONTROL": Initialize=28
    "CONTINUELOOP": Initialize=29
    "FORK": Initialize=30
    "BRANCH": Initialize=31
    "CASE": Initialize=32
    "DEFAULT": Initialize=33
    "TRUEPATH": Initialize=34
