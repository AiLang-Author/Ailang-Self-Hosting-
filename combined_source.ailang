// =============================================================================
// SLAB 4096 - Allocate/Free 4096-byte blocks
// =============================================================================
Function.Arena_Alloc4096 {
    Output: Address
    Body: {
        Slab4096.alloc_count = Add(Slab4096.alloc_count, 1)
        
        IfCondition NotEqual(Slab4096.free_list, 0) ThenBlock: {
            ptr = Slab4096.free_list
            Slab4096.free_list = Dereference(ptr)
            ReturnValue(ptr)
        }
        
        IfCondition GreaterEqual(Add(Slab4096.next, 4096), Slab4096.end) ThenBlock: {
            Arena_GrowSlab4096()
        }
        
        ptr = Slab4096.next
        Slab4096.next = Add(Slab4096.next, 4096)
        ReturnValue(ptr)
    }
}

Function.Arena_Free4096 {
    Input: ptr: Address
    Body: {
        Slab4096.free_count = Add(Slab4096.free_count, 1)
        StoreValue(ptr, Slab4096.free_list)
        Slab4096.free_list = ptr
    }
}

Function.Arena_GrowSlab4096 {
    Body: {
        old_chunk = Slab4096.chunk
        chunk = Arena_MmapChunk()
        StoreValue(chunk, old_chunk)
        Slab4096.chunk = chunk
        Slab4096.next = Add(chunk, 8)
        Slab4096.end = Add(chunk, ArenaConst.CHUNK_SIZE)
        Slab4096.chunk_count = Add(Slab4096.chunk_count, 1)
    }
}

Function.Arena_FreeSlab4096 {
    Body: {
        current = Slab4096.chunk
        WhileLoop NotEqual(current, 0) {
            prev = Dereference(current)
            SystemCall(11, current, ArenaConst.CHUNK_SIZE, 0, 0, 0, 0)
            current = prev
        }
        Slab4096.chunk = 0
        Slab4096.next = 0
        Slab4096.end = 0
        Slab4096.free_list = 0
        Slab4096.alloc_count = 0
        Slab4096.free_count = 0
        Slab4096.chunk_count = 0
    }
}

// =============================================================================
// GENERAL ALLOCATOR - For variable/large sizes
// =============================================================================
Function.Arena_AllocGeneral {
    Input: size: Integer
    Output: Address
    Body: {
        ArenaGeneral.alloc_count = Add(ArenaGeneral.alloc_count, 1)
        
        // Align to 8 bytes
        aligned = BitwiseAnd(Add(size, 7), -8)
        
        // If too large, fall back to direct mmap
        IfCondition GreaterThan(aligned, 65536) ThenBlock: {
            ArenaGeneral.fallback_count = Add(ArenaGeneral.fallback_count, 1)
            ReturnValue(Arena_MmapDirect(aligned))
        }
        
        // Check if fits in current chunk
        IfCondition GreaterEqual(Add(ArenaGeneral.next, aligned), ArenaGeneral.end) ThenBlock: {
            Arena_GrowGeneral()
        }
        
        ptr = ArenaGeneral.next
        ArenaGeneral.next = Add(ArenaGeneral.next, aligned)
        ReturnValue(ptr)
    }
}

Function.Arena_GrowGeneral {
    Body: {
        old_chunk = ArenaGeneral.chunk
        chunk = Arena_MmapChunk()
        StoreValue(chunk, old_chunk)
        ArenaGeneral.chunk = chunk
        ArenaGeneral.next = Add(chunk, 8)
        ArenaGeneral.end = Add(chunk, ArenaConst.CHUNK_SIZE)
        ArenaGeneral.chunk_count = Add(ArenaGeneral.chunk_count, 1)
    }
}

Function.Arena_FreeGeneral {
    Body: {
        current = ArenaGeneral.chunk
        WhileLoop NotEqual(current, 0) {
            prev = Dereference(current)
            SystemCall(11, current, ArenaConst.CHUNK_SIZE, 0, 0, 0, 0)
            current = prev
        }
        ArenaGeneral.chunk = 0
        ArenaGeneral.next = 0
        ArenaGeneral.end = 0
        ArenaGeneral.alloc_count = 0
        ArenaGeneral.chunk_count = 0
        ArenaGeneral.fallback_count = 0
    }
}


Function.Arena_FreeAll {
    Body: {
        Arena_FreeSlab24()
        Arena_FreeSlab32()
        Arena_FreeSlab64()
        Arena_FreeSlab128()
        Arena_FreeSlab256()
        Arena_FreeSlab512()
        Arena_FreeSlab1024()
        Arena_FreeSlab2048()
        Arena_FreeSlab4096()
        Arena_FreeGeneral()
    }
}

Function.Arena_MmapDirect {
    Input: size: Integer
    Output: Address
    Body: {
        // Round up to page size
        page_size = 4096
        pages = Divide(Add(size, 4095), 4096)
        total = Multiply(pages, page_size)
        
        addr = SystemCall(9, 0, total, 3, 34, -1, 0)
        ReturnValue(addr)
    }
}

// =============================================================================
// UNIFIED ALLOCATOR - Replaces Allocate()
// Routes to appropriate slab based on size
// =============================================================================
Function.Arena_Alloc {
    Input: size: Integer
    Output: Address
    Body: {
        // Route to appropriate slab
        IfCondition LessEqual(size, 24) ThenBlock: {
            ReturnValue(Arena_Alloc24())
        }
        
        IfCondition LessEqual(size, 32) ThenBlock: {
            ReturnValue(Arena_Alloc32())
        }
        
        IfCondition LessEqual(size, 64) ThenBlock: {
            ReturnValue(Arena_Alloc64())
        }
        
        IfCondition LessEqual(size, 128) ThenBlock: {
            ReturnValue(Arena_Alloc128())
        }
        
        IfCondition LessEqual(size, 256) ThenBlock: {
            ReturnValue(Arena_Alloc256())
        }
        
        IfCondition LessEqual(size, 512) ThenBlock: {
            ReturnValue(Arena_Alloc512())
        }
        
        IfCondition LessEqual(size, 1024) ThenBlock: {
            ReturnValue(Arena_Alloc1024())
        }
        
        IfCondition LessEqual(size, 2048) ThenBlock: {
            ReturnValue(Arena_Alloc2048())
        }
        
        IfCondition LessEqual(size, 4096) ThenBlock: {
            ReturnValue(Arena_Alloc4096())
        }
        
        // Larger sizes go to general arena
        ReturnValue(Arena_AllocGeneral(size))
    }
}

// =============================================================================
// UNIFIED FREE - Replaces Deallocate()
// Routes to appropriate slab based on size
// =============================================================================
Function.Arena_Free {
    Input: ptr: Address
    Input: size: Integer
    Body: {
        IfCondition EqualTo(ptr, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        IfCondition LessEqual(size, 24) ThenBlock: {
            Arena_Free24(ptr)
            ReturnValue(1)
        }
        
        IfCondition LessEqual(size, 32) ThenBlock: {
            Arena_Free32(ptr)
            ReturnValue(1)
        }
        
        IfCondition LessEqual(size, 64) ThenBlock: {
            Arena_Free64(ptr)
            ReturnValue(1)
        }
        
        IfCondition LessEqual(size, 128) ThenBlock: {
            Arena_Free128(ptr)
            ReturnValue(1)
        }
        
        IfCondition LessEqual(size, 256) ThenBlock: {
            Arena_Free256(ptr)
            ReturnValue(1)
        }
        
        IfCondition LessEqual(size, 512) ThenBlock: {
            Arena_Free512(ptr)
            ReturnValue(1)
        }
        
        IfCondition LessEqual(size, 1024) ThenBlock: {
            Arena_Free1024(ptr)
            ReturnValue(1)
        }
        
        IfCondition LessEqual(size, 2048) ThenBlock: {
            Arena_Free2048(ptr)
            ReturnValue(1)
        }
        
        IfCondition LessEqual(size, 4096) ThenBlock: {
            Arena_Free4096(ptr)
            ReturnValue(1)
        }
        
        // Large allocations: can't easily free (would need tracking)
        // For now, just leak - arena cleanup handles it
        ReturnValue(0)
    }
}


Function.Arena_ArrayDestroy {
    Input: arr: Address
    Body: {
        IfCondition EqualTo(arr, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        // alloc_size is stored 8 bytes BEFORE the arr pointer
        block = Subtract(arr, 8)
        alloc_size = Dereference(block)
        
        // Sanity check - alloc_size should be reasonable
        IfCondition LessThan(alloc_size, 16) ThenBlock: {
            PrintMessage("[ARENA] WARNING: Invalid alloc_size in ArrayDestroy: ")
            PrintNumber(alloc_size)
            PrintMessage("\n")
            ReturnValue(0)
        }
        
        IfCondition GreaterThan(alloc_size, 1048576) ThenBlock: {
            // > 1MB seems suspicious, might be corrupted
            PrintMessage("[ARENA] WARNING: Suspiciously large alloc_size: ")
            PrintNumber(alloc_size)
            PrintMessage("\n")
            // Still try to free it
        }
        
        // Route to appropriate slab free based on size
        Arena_Free(block, alloc_size)
        
        ReturnValue(1)
    }
}



// =============================================================================
// ARENA-BACKED ARRAY - Fixed version with size tracking
// 
// Memory layout:
//   [0-7]   alloc_size  (hidden - before returned pointer)
//   [8-15]  capacity    (user sees this as offset 0)
//   [16-23] element 0   (user sees this as offset 8)
//   [24-31] element 1
//   ...
//
// This preserves ArrayGet/ArraySet compatibility since returned pointer
// looks like normal array: [capacity, elem0, elem1, ...]
// =============================================================================

Function.Arena_ArrayCreate {
    Input: capacity: Integer
    Output: Address
    Body: {
        // Total size: 8 (hidden size) + 8 (capacity) + capacity * 8 (elements)
        alloc_size = Add(16, Multiply(capacity, 8))
        
        // Allocate from arena
        block = Arena_Alloc(alloc_size)
        
        IfCondition EqualTo(block, 0) ThenBlock: {
            PrintMessage("[ARENA] ArrayCreate failed for capacity ")
            PrintNumber(capacity)
            PrintMessage("\n")
            ReturnValue(0)
        }
        
        // Store alloc_size at offset 0 (hidden)
        StoreValue(block, alloc_size)
        
        // Return pointer to offset 8 - this is what user sees as "the array"
        arr = Add(block, 8)
        
        // Store capacity at arr[0] (which is block[8])
        StoreValue(arr, capacity)
        
        ReturnValue(arr)
    }
}


// =============================================================================
// OPTIONAL: Arena_ArrayResize - Resize with proper cleanup
// Can be used by XArray instead of create + copy + destroy
// =============================================================================
Function.Arena_ArrayResize {
    Input: old_arr: Address
    Input: new_capacity: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(old_arr, 0) ThenBlock: {
            // No old array, just create new
            ReturnValue(Arena_ArrayCreate(new_capacity))
        }
        
        // Get old capacity
        old_capacity = Dereference(old_arr)
        
        // If shrinking or same size, could potentially reuse
        // For now, always create new (simple and safe)
        
        // Create new array
        new_arr = Arena_ArrayCreate(new_capacity)
        IfCondition EqualTo(new_arr, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        // Copy elements (min of old and new capacity)
        copy_count = old_capacity
        IfCondition LessThan(new_capacity, old_capacity) ThenBlock: {
            copy_count = new_capacity
        }
        
        i = 0
        WhileLoop LessThan(i, copy_count) {
            val = ArrayGet(old_arr, i)
            ArraySet(new_arr, i, val)
            i = Add(i, 1)
        }
        
        // Free old array (this now actually works!)
        Arena_ArrayDestroy(old_arr)
        
        ReturnValue(new_arr)
    }
}

// =============================================================================
// ARENA RESET - Reuse chunks without freeing to kernel
// =============================================================================
Function.Arena_Reset {
    Body: {
        // === Slab24: Free extra chunks, keep first ===
        IfCondition GreaterThan(Slab24.chunk_count, 1) ThenBlock: {
            // Walk from first chunk's link to free extras
            first_chunk = Slab24.chunk
            current = Dereference(first_chunk)  // second chunk (linked from first)
            WhileLoop NotEqual(current, 0) {
                next_chunk = Dereference(current)
                SystemCall(11, current, ArenaConst.CHUNK_SIZE, 0, 0, 0, 0)
                current = next_chunk
            }
            StoreValue(first_chunk, 0)  // clear link in first chunk
            Slab24.chunk_count = 1
        }
        Slab24.next = Slab24.chunk
        Slab24.end = Add(Slab24.chunk, ArenaConst.CHUNK_SIZE)
        Slab24.free_list = 0
        Slab24.alloc_count = 0
        Slab24.free_count = 0

        // === Slab32: Free extra chunks, keep first ===
        IfCondition GreaterThan(Slab32.chunk_count, 1) ThenBlock: {
            first_chunk = Slab32.chunk
            current = Dereference(first_chunk)
            WhileLoop NotEqual(current, 0) {
                next_chunk = Dereference(current)
                SystemCall(11, current, ArenaConst.CHUNK_SIZE, 0, 0, 0, 0)
                current = next_chunk
            }
            StoreValue(first_chunk, 0)
            Slab32.chunk_count = 1
        }
        Slab32.next = Slab32.chunk
        Slab32.end = Add(Slab32.chunk, ArenaConst.CHUNK_SIZE)
        Slab32.free_list = 0
        Slab32.alloc_count = 0
        Slab32.free_count = 0

        // === Slab64: Free extra chunks, keep first ===
        IfCondition GreaterThan(Slab64.chunk_count, 1) ThenBlock: {
            first_chunk = Slab64.chunk
            current = Dereference(first_chunk)
            WhileLoop NotEqual(current, 0) {
                next_chunk = Dereference(current)
                SystemCall(11, current, ArenaConst.CHUNK_SIZE, 0, 0, 0, 0)
                current = next_chunk
            }
            StoreValue(first_chunk, 0)
            Slab64.chunk_count = 1
        }
        Slab64.next = Slab64.chunk
        Slab64.end = Add(Slab64.chunk, ArenaConst.CHUNK_SIZE)
        Slab64.free_list = 0
        Slab64.alloc_count = 0
        Slab64.free_count = 0

        // === Slab128: Free extra chunks, keep first ===
        IfCondition GreaterThan(Slab128.chunk_count, 1) ThenBlock: {
            first_chunk = Slab128.chunk
            current = Dereference(first_chunk)
            WhileLoop NotEqual(current, 0) {
                next_chunk = Dereference(current)
                SystemCall(11, current, ArenaConst.CHUNK_SIZE, 0, 0, 0, 0)
                current = next_chunk
            }
            StoreValue(first_chunk, 0)
            Slab128.chunk_count = 1
        }
        Slab128.next = Slab128.chunk
        Slab128.end = Add(Slab128.chunk, ArenaConst.CHUNK_SIZE)
        Slab128.free_list = 0
        Slab128.alloc_count = 0
        Slab128.free_count = 0

        // === Slab256: Free extra chunks, keep first ===
        IfCondition GreaterThan(Slab256.chunk_count, 1) ThenBlock: {
            first_chunk = Slab256.chunk
            current = Dereference(first_chunk)
            WhileLoop NotEqual(current, 0) {
                next_chunk = Dereference(current)
                SystemCall(11, current, ArenaConst.CHUNK_SIZE, 0, 0, 0, 0)
                current = next_chunk
            }
            StoreValue(first_chunk, 0)
            Slab256.chunk_count = 1
        }
        Slab256.next = Slab256.chunk
        Slab256.end = Add(Slab256.chunk, ArenaConst.CHUNK_SIZE)
        Slab256.free_list = 0
        Slab256.alloc_count = 0
        Slab256.free_count = 0

        // === Slab512: Free extra chunks, keep first ===
        IfCondition GreaterThan(Slab512.chunk_count, 1) ThenBlock: {
            first_chunk = Slab512.chunk
            current = Dereference(first_chunk)
            WhileLoop NotEqual(current, 0) {
                next_chunk = Dereference(current)
                SystemCall(11, current, ArenaConst.CHUNK_SIZE, 0, 0, 0, 0)
                current = next_chunk
            }
            StoreValue(first_chunk, 0)
            Slab512.chunk_count = 1
        }
        Slab512.next = Slab512.chunk
        Slab512.end = Add(Slab512.chunk, ArenaConst.CHUNK_SIZE)
        Slab512.free_list = 0
        Slab512.alloc_count = 0
        Slab512.free_count = 0

        // === Slab1024: Free extra chunks, keep first ===
        IfCondition GreaterThan(Slab1024.chunk_count, 1) ThenBlock: {
            first_chunk = Slab1024.chunk
            current = Dereference(first_chunk)
            WhileLoop NotEqual(current, 0) {
                next_chunk = Dereference(current)
                SystemCall(11, current, ArenaConst.CHUNK_SIZE, 0, 0, 0, 0)
                current = next_chunk
            }
            StoreValue(first_chunk, 0)
            Slab1024.chunk_count = 1
        }
        Slab1024.next = Slab1024.chunk
        Slab1024.end = Add(Slab1024.chunk, ArenaConst.CHUNK_SIZE)
        Slab1024.free_list = 0
        Slab1024.alloc_count = 0
        Slab1024.free_count = 0

        // === Slab2048: Free extra chunks, keep first ===
        IfCondition GreaterThan(Slab2048.chunk_count, 1) ThenBlock: {
            first_chunk = Slab2048.chunk
            current = Dereference(first_chunk)
            WhileLoop NotEqual(current, 0) {
                next_chunk = Dereference(current)
                SystemCall(11, current, ArenaConst.CHUNK_SIZE, 0, 0, 0, 0)
                current = next_chunk
            }
            StoreValue(first_chunk, 0)
            Slab2048.chunk_count = 1
        }
        Slab2048.next = Slab2048.chunk
        Slab2048.end = Add(Slab2048.chunk, ArenaConst.CHUNK_SIZE)
        Slab2048.free_list = 0
        Slab2048.alloc_count = 0
        Slab2048.free_count = 0

        // === Slab4096: Free extra chunks, keep first ===
        IfCondition GreaterThan(Slab4096.chunk_count, 1) ThenBlock: {
            first_chunk = Slab4096.chunk
            current = Dereference(first_chunk)
            WhileLoop NotEqual(current, 0) {
                next_chunk = Dereference(current)
                SystemCall(11, current, ArenaConst.CHUNK_SIZE, 0, 0, 0, 0)
                current = next_chunk
            }
            StoreValue(first_chunk, 0)
            Slab4096.chunk_count = 1
        }
        Slab4096.next = Slab4096.chunk
        Slab4096.end = Add(Slab4096.chunk, ArenaConst.CHUNK_SIZE)
        Slab4096.free_list = 0
        Slab4096.alloc_count = 0
        Slab4096.free_count = 0

        // === ArenaGeneral: Free extra chunks, keep first ===
        IfCondition GreaterThan(ArenaGeneral.chunk_count, 1) ThenBlock: {
            first_chunk = ArenaGeneral.chunk
            current = Dereference(first_chunk)
            WhileLoop NotEqual(current, 0) {
                next_chunk = Dereference(current)
                SystemCall(11, current, ArenaConst.CHUNK_SIZE, 0, 0, 0, 0)
                current = next_chunk
            }
            StoreValue(first_chunk, 0)
            ArenaGeneral.chunk_count = 1
        }
        ArenaGeneral.next = ArenaGeneral.chunk
        ArenaGeneral.end = Add(ArenaGeneral.chunk, ArenaConst.CHUNK_SIZE)
        ArenaGeneral.alloc_count = 0
    }
}

// =============================================================================
// DIAGNOSTICS
// =============================================================================
Function.Arena_Report {
    Body: {
        PrintMessage("\n========== ARENA MEMORY REPORT ==========\n")
        
        PrintMessage("Slab 24-byte:\n")
        PrintMessage("  Chunks: ")
        PrintNumber(Slab24.chunk_count)
        PrintMessage(" (")
        PrintNumber(Multiply(Slab24.chunk_count, 4))
        PrintMessage(" MB)\n")
        PrintMessage("  Allocs: ")
        PrintNumber(Slab24.alloc_count)
        PrintMessage("\n  Frees: ")
        PrintNumber(Slab24.free_count)
        PrintMessage("\n  In use: ")
        PrintNumber(Subtract(Slab24.alloc_count, Slab24.free_count))
        PrintMessage("\n")
        
        PrintMessage("Slab 32-byte:\n")
        PrintMessage("  Chunks: ")
        PrintNumber(Slab32.chunk_count)
        PrintMessage("\n  Allocs: ")
        PrintNumber(Slab32.alloc_count)
        PrintMessage("\n  Frees: ")
        PrintNumber(Slab32.free_count)
        PrintMessage("\n")
        
        PrintMessage("Slab 64-byte:\n")
        PrintMessage("  Chunks: ")
        PrintNumber(Slab64.chunk_count)
        PrintMessage("\n  Allocs: ")
        PrintNumber(Slab64.alloc_count)
        PrintMessage("\n  Frees: ")
        PrintNumber(Slab64.free_count)
        PrintMessage("\n")
        
        PrintMessage("Slab 128-byte:\n")
        PrintMessage("  Chunks: ")
        PrintNumber(Slab128.chunk_count)
        PrintMessage("\n  Allocs: ")
        PrintNumber(Slab128.alloc_count)
        PrintMessage("\n  Frees: ")
        PrintNumber(Slab128.free_count)
        PrintMessage("\n")
        
        PrintMessage("Slab 256-byte:\n")
        PrintMessage("  Chunks: ")
        PrintNumber(Slab256.chunk_count)
        PrintMessage("\n  Allocs: ")
        PrintNumber(Slab256.alloc_count)
        PrintMessage("\n  Frees: ")
        PrintNumber(Slab256.free_count)
        PrintMessage("\n")
        
        PrintMessage("Slab 512-byte:\n")
        PrintMessage("  Chunks: ")
        PrintNumber(Slab512.chunk_count)
        PrintMessage("\n  Allocs: ")
        PrintNumber(Slab512.alloc_count)
        PrintMessage("\n  Frees: ")
        PrintNumber(Slab512.free_count)
        PrintMessage("\n")
        
        PrintMessage("Slab 1024-byte:\n")
        PrintMessage("  Chunks: ")
        PrintNumber(Slab1024.chunk_count)
        PrintMessage("\n  Allocs: ")
        PrintNumber(Slab1024.alloc_count)
        PrintMessage("\n  Frees: ")
        PrintNumber(Slab1024.free_count)
        PrintMessage("\n")
        
        PrintMessage("Slab 2048-byte:\n")
        PrintMessage("  Chunks: ")
        PrintNumber(Slab2048.chunk_count)
        PrintMessage("\n  Allocs: ")
        PrintNumber(Slab2048.alloc_count)
        PrintMessage("\n  Frees: ")
        PrintNumber(Slab2048.free_count)
        PrintMessage("\n")
        
        PrintMessage("Slab 4096-byte:\n")
        PrintMessage("  Chunks: ")
        PrintNumber(Slab4096.chunk_count)
        PrintMessage("\n  Allocs: ")
        PrintNumber(Slab4096.alloc_count)
        PrintMessage("\n  Frees: ")
        PrintNumber(Slab4096.free_count)
        PrintMessage("\n")
        
        PrintMessage("General arena:\n")
        PrintMessage("  Chunks: ")
        PrintNumber(ArenaGeneral.chunk_count)
        PrintMessage("\n  Allocs: ")
        PrintNumber(ArenaGeneral.alloc_count)
        PrintMessage("\n  Fallbacks: ")
        PrintNumber(ArenaGeneral.fallback_count)
        PrintMessage("\n")
        
        total_chunks = Add(Slab24.chunk_count, Slab32.chunk_count)
        total_chunks = Add(total_chunks, Slab64.chunk_count)
        total_chunks = Add(total_chunks, Slab128.chunk_count)
        total_chunks = Add(total_chunks, Slab256.chunk_count)
        total_chunks = Add(total_chunks, Slab512.chunk_count)
        total_chunks = Add(total_chunks, Slab1024.chunk_count)
        total_chunks = Add(total_chunks, Slab2048.chunk_count)
        total_chunks = Add(total_chunks, Slab4096.chunk_count)
        total_chunks = Add(total_chunks, ArenaGeneral.chunk_count)
        
        PrintMessage("Total: ")
        PrintNumber(total_chunks)
        PrintMessage(" chunks = ")
        PrintNumber(Multiply(total_chunks, 4))
        PrintMessage(" MB\n")
        PrintMessage("=========================================\n")
    }
}

// === Inlined from TF.Math ===
// Library.TF.Math.ailang
// Scalar math primitives for the transformer stack.
// No dependencies. No imports. Pure arithmetic.
// Mirrors NN11/FXMATH — the bottom of the stack.
// Copyright © 2025 Sean Collins, 2 Paws Machine and Engineering. All rights reserved. SCSL.

// =============================================================================
// HYPERPARAMETERS
// Match ATTN/11: D=16 SEQ=8 V=10
// Change these to generalize.
// =============================================================================
FixedPool.TFConfig {
    "DModel":   Initialize=16    // embedding dimension
    "SeqLen":   Initialize=8     // sequence length
    "VocabSize":Initialize=10    // vocabulary size (digits 0-9)
    "LR_Attn":  Initialize=80    // learning rate for Wq/Wk/Wv
    "LR_Embed": Initialize=10    // learning rate for embeddings
    "LR_Out":   Initialize=25    // learning rate for Wout
    "LR_Scale": Initialize=1000  // divisor to recover true LR
    "MaxSteps": Initialize=1000
    "LogEvery": Initialize=100
}

// =============================================================================
// MATRIX LAYOUT HELPERS
// All matrices are flat row-major buffers, 8 bytes per element.
// Element [row][col] in a matrix of width W:
//   addr = base + (row * W + col) * 8
// =============================================================================
FixedPool.TFElem {
    "Size": Initialize=8    // bytes per element
}

// Compute byte offset for element [row][col] in matrix of width W
Function.TF_Offset {
    Input:  row: Integer
    Input:  col: Integer
    Input:  width: Integer
    Output: Integer
    Body: {
        idx = Add(Multiply(row, width), col)
        ReturnValue(Multiply(idx, TFElem.Size))
    }
}

// Allocate a zero-filled matrix of rows x cols
Function.TF_MatAlloc {
    Input:  rows: Integer
    Input:  cols: Integer
    Output: Integer
    Body: {
        rc    = Multiply(rows, cols)
        total = Multiply(rc, TFElem.Size)
        buf   = Allocate(total)
        DebugAssert(NotEqual(buf, 0), "TF_MatAlloc: Allocate returned null")
        i = 0
        WhileLoop LessThan(i, total) {
            SetByte(buf, i, 0)
            i = Add(i, 1)
        }
        ReturnValue(buf)
    }
}

// Free a matrix
Function.TF_MatFree {
    Input: buf:  Integer
    Input: rows: Integer
    Input: cols: Integer
    Body: {
        rc    = Multiply(rows, cols)
        total = Multiply(rc, TFElem.Size)
        Deallocate(buf, total)
        ReturnValue(0)
    }
}

// Get element [row][col] from matrix of width W
Function.TF_MatGet {
    Input:  mat:   Integer
    Input:  row:   Integer
    Input:  col:   Integer
    Input:  width: Integer
    Output: Integer
    Body: {
        off = TF_Offset(row, col, width)
        ReturnValue(Dereference(Add(mat, off)))
    }
}

// Set element [row][col] in matrix of width W
Function.TF_MatSet {
    Input: mat:   Integer
    Input: row:   Integer
    Input: col:   Integer
    Input: width: Integer
    Input: val:   Integer
    Body: {
        off = TF_Offset(row, col, width)
        StoreValue(Add(mat, off), val)
        ReturnValue(0)
    }
}

// =============================================================================
// SCALAR HELPERS
// =============================================================================

// Clamp val to [lo, hi]
Function.TF_Clamp {
    Input:  val: Integer
    Input:  lo:  Integer
    Input:  hi:  Integer
    Output: Integer
    Body: {
        result = val
        IfCondition LessThan(val, lo) ThenBlock: { result = lo }
        IfCondition GreaterThan(val, hi) ThenBlock: { result = hi }
        ReturnValue(result)
    }
}

// Absolute value
Function.TF_Abs {
    Input:  val: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(val, 0) ThenBlock: {
            ReturnValue(Subtract(0, val))
        }
        ReturnValue(val)
    }
}

// Integer square root (Newton's method) — used for attention scaling
Function.TF_ISqrt {
    Input:  n: Integer
    Output: Integer
    Body: {
        IfCondition LessEqual(n, 0) ThenBlock: { ReturnValue(0) }
        x = n
        y = Add(Divide(n, 2), 1)
        WhileLoop LessThan(y, x) {
            x = y
            y = Divide(Add(Divide(n, y), y), 2)
        }
        ReturnValue(x)
    }
}

// Simple LCG random for data generation
// Uses FixedPool. prefix for writes to work in Functions
FixedPool.TFRand {
    "seed": Initialize=12345
}

Function.TF_RandNext {
    Output: Integer
    Body: {
        current_state = FixedPool.TFRand.seed
        multiplied = Multiply(current_state, 1664525)
        added = Add(multiplied, 1013904223)
        masked = BitwiseAnd(added, 2147483647)
        FixedPool.TFRand.seed = masked
        ReturnValue(masked)
    }
}

// Random integer in [0, n)
Function.TF_RandMod {
    Input:  n: Integer
    Output: Integer
    Body: {
        ReturnValue(Modulo(TF_RandNext(), n))
    }
}

// === Inlined from TF.Vec ===
// Library.TF.Vec.ailang
// Vector operations for the transformer stack.
// Mirrors NN11/VECOP — dot product, scale, add, copy.
// All vectors are flat buffers, 8 bytes per element.
// Copyright © 2025 Sean Collins, 2 Paws Machine and Engineering. All rights reserved. SCSL.


// =============================================================================
// VECTOR ALLOCATION
// =============================================================================

Function.TF_VecAlloc {
    Input:  len: Integer
    Output: Integer
    Body: {
        ReturnValue(TF_MatAlloc(1, len))
    }
}

Function.TF_VecFree {
    Input: buf: Integer
    Input: len: Integer
    Body: {
        TF_MatFree(buf, 1, len)
        ReturnValue(0)
    }
}

Function.TF_VecGet {
    Input:  vec: Integer
    Input:  idx: Integer
    Output: Integer
    Body: {
        off = Multiply(idx, TFElem.Size)
        adr = Add(vec, off)
        ReturnValue(Dereference(adr))
    }
}

Function.TF_VecSet {
    Input: vec: Integer
    Input: idx: Integer
    Input: val: Integer
    Body: {
        off = Multiply(idx, TFElem.Size)
        adr = Add(vec, off)
        StoreValue(adr, val)
        ReturnValue(0)
    }
}

// =============================================================================
// CORE VECTOR OPS
// =============================================================================

// Dot product: sum(a[i] * b[i]) for i in [0, len)
Function.TF_VecDot {
    Input:  avec: Integer
    Input:  bvec: Integer
    Input:  len:  Integer
    Output: Integer
    Body: {
        sum = 0
        i   = 0
        WhileLoop LessThan(i, len) {
            av  = TF_VecGet(avec, i)
            bv  = TF_VecGet(bvec, i)
            prod = Multiply(av, bv)
            sum = Add(sum, prod)
            i   = Add(i, 1)
        }
        ReturnValue(sum)
    }
}

// Element-wise add: dst[i] = a[i] + b[i]
Function.TF_VecAdd {
    Input: dst: Integer
    Input: av:  Integer
    Input: bv:  Integer
    Input: len: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, len) {
            va  = TF_VecGet(av, i)
            vb  = TF_VecGet(bv, i)
            res = Add(va, vb)
            TF_VecSet(dst, i, res)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Element-wise subtract: dst[i] = a[i] - b[i]
Function.TF_VecSub {
    Input: dst: Integer
    Input: av:  Integer
    Input: bv:  Integer
    Input: len: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, len) {
            va  = TF_VecGet(av, i)
            vb  = TF_VecGet(bv, i)
            res = Subtract(va, vb)
            TF_VecSet(dst, i, res)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Scale: dst[i] = vec[i] * scalar / divisor
Function.TF_VecScale {
    Input: dst:     Integer
    Input: vec:     Integer
    Input: scalar:  Integer
    Input: divisor: Integer
    Input: len:     Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, len) {
            v   = TF_VecGet(vec, i)
            num = Multiply(v, scalar)
            res = Divide(num, divisor)
            TF_VecSet(dst, i, res)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Copy: dst[i] = src[i]
Function.TF_VecCopy {
    Input: dst: Integer
    Input: src: Integer
    Input: len: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, len) {
            val = TF_VecGet(src, i)
            TF_VecSet(dst, i, val)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Zero: dst[i] = 0
Function.TF_VecZero {
    Input: vec: Integer
    Input: len: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, len) {
            TF_VecSet(vec, i, 0)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Accumulate: dst[i] += src[i]
Function.TF_VecAccum {
    Input: dst: Integer
    Input: src: Integer
    Input: len: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, len) {
            old = TF_VecGet(dst, i)
            nuw = TF_VecGet(src, i)
            res = Add(old, nuw)
            TF_VecSet(dst, i, res)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// ArgMax: return index of largest element
Function.TF_VecArgMax {
    Input:  vec: Integer
    Input:  len: Integer
    Output: Integer
    Body: {
        best_idx = 0
        best_val = TF_VecGet(vec, 0)
        i = 1
        WhileLoop LessThan(i, len) {
            v = TF_VecGet(vec, i)
            IfCondition GreaterThan(v, best_val) ThenBlock: {
                best_val = v
                best_idx = i
            }
            i = Add(i, 1)
        }
        ReturnValue(best_idx)
    }
}

// Sum of all elements
Function.TF_VecSum {
    Input:  vec: Integer
    Input:  len: Integer
    Output: Integer
    Body: {
        sum = 0
        i   = 0
        WhileLoop LessThan(i, len) {
            val = TF_VecGet(vec, i)
            sum = Add(sum, val)
            i   = Add(i, 1)
        }
        ReturnValue(sum)
    }
}

// Max of all elements
Function.TF_VecMax {
    Input:  vec: Integer
    Input:  len: Integer
    Output: Integer
    Body: {
        best = TF_VecGet(vec, 0)
        i    = 1
        WhileLoop LessThan(i, len) {
            v = TF_VecGet(vec, i)
            IfCondition GreaterThan(v, best) ThenBlock: {
                best = v
            }
            i = Add(i, 1)
        }
        ReturnValue(best)
    }
}

// === Inlined from TF.Mat ===
// Library.TF.Mat.ailang
// Matrix operations for the transformer stack.
// Mirrors NN11/MATOP — mat-vec multiply, transpose, init.
// Row-major layout, 8 bytes per element.
// Copyright © 2025 Sean Collins, 2 Paws Machine and Engineering. All rights reserved. SCSL.


// =============================================================================
// MATRIX-VECTOR MULTIPLY
// dst = mat * vec
// mat is [rows x cols], vec is [cols], dst is [rows]
// =============================================================================
Function.TF_MatVecMul {
    Input: dst:  Integer
    Input: mat:  Integer
    Input: vec:  Integer
    Input: rows: Integer
    Input: cols: Integer
    Body: {
        row = 0
        WhileLoop LessThan(row, rows) {
            sum = 0
            col = 0
            WhileLoop LessThan(col, cols) {
                mv   = TF_MatGet(mat, row, col, cols)
                vv   = TF_VecGet(vec, col)
                prod = Multiply(mv, vv)
                sum  = Add(sum, prod)
                col  = Add(col, 1)
            }
            TF_VecSet(dst, row, sum)
            row = Add(row, 1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// TRANSPOSED MATRIX-VECTOR MULTIPLY
// dst = mat^T * vec
// mat is [rows x cols], vec is [rows], dst is [cols]
// =============================================================================
Function.TF_MatTVecMul {
    Input: dst:  Integer
    Input: mat:  Integer
    Input: vec:  Integer
    Input: rows: Integer
    Input: cols: Integer
    Body: {
        col = 0
        WhileLoop LessThan(col, cols) {
            sum = 0
            row = 0
            WhileLoop LessThan(row, rows) {
                mv   = TF_MatGet(mat, row, col, cols)
                vv   = TF_VecGet(vec, row)
                prod = Multiply(mv, vv)
                sum  = Add(sum, prod)
                row  = Add(row, 1)
            }
            TF_VecSet(dst, col, sum)
            col = Add(col, 1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// OUTER PRODUCT ACCUMULATE
// grad[row][col] += a[row] * b[col]
// =============================================================================
Function.TF_OuterAccum {
    Input: grad: Integer
    Input: avec: Integer
    Input: bvec: Integer
    Input: rows: Integer
    Input: cols: Integer
    Body: {
        row = 0
        WhileLoop LessThan(row, rows) {
            av  = TF_VecGet(avec, row)
            col = 0
            WhileLoop LessThan(col, cols) {
                bv   = TF_VecGet(bvec, col)
                old  = TF_MatGet(grad, row, col, cols)
                prod = Multiply(av, bv)
                nuw  = Add(old, prod)
                TF_MatSet(grad, row, col, cols, nuw)
                col  = Add(col, 1)
            }
            row = Add(row, 1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// MATRIX ZERO
// =============================================================================
Function.TF_MatZero {
    Input: mat:  Integer
    Input: rows: Integer
    Input: cols: Integer
    Body: {
        rc    = Multiply(rows, cols)
        total = Multiply(rc, TFElem.Size)
        i = 0
        WhileLoop LessThan(i, total) {
            SetByte(mat, i, 0)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// MATRIX RAND INIT - uses inline RNG to avoid Function/FixedPool issues
// Takes extra params: mat_ptr, rows, cols, range via FixedPool carrier
// =============================================================================
FixedPool.TFRandInitCarrier {
    "mat":   Initialize=0
    "rows":  Initialize=0
    "cols":  Initialize=0
    "range": Initialize=0
}

SubRoutine.TF_MatRandInitSub {
    ri_mat   = TFRandInitCarrier.mat
    ri_rows  = TFRandInitCarrier.rows
    ri_cols  = TFRandInitCarrier.cols
    ri_range = TFRandInitCarrier.range

    ri_total  = Multiply(ri_rows, ri_cols)
    ri_drange = Multiply(ri_range, 2)

    ri_i = 0
    WhileLoop LessThan(ri_i, ri_total) {
        // Inline RNG - read with TFRand.seed, write with FixedPool.TFRand.seed
        ri_s = TFRand.seed
        ri_s = Add(Multiply(ri_s, 1664525), 1013904223)
        ri_s = BitwiseAnd(ri_s, 2147483647)
        FixedPool.TFRand.seed = ri_s

        ri_rmod = Modulo(ri_s, ri_drange)
        ri_rval = Subtract(ri_rmod, ri_range)
        ri_off  = Multiply(ri_i, TFElem.Size)
        ri_adr  = Add(ri_mat, ri_off)
        StoreValue(ri_adr, ri_rval)
        ri_i = Add(ri_i, 1)
    }
}

Function.TF_MatRandInit {
    Input: mat:   Integer
    Input: rows:  Integer
    Input: cols:  Integer
    Input: range: Integer
    Body: {
        TFRandInitCarrier.mat   = mat
        TFRandInitCarrier.rows  = rows
        TFRandInitCarrier.cols  = cols
        TFRandInitCarrier.range = range
        TF_MatRandInitSub()
        ReturnValue(0)
    }
}

// =============================================================================
// MATRIX COPY
// =============================================================================
Function.TF_MatCopy {
    Input: dst:  Integer
    Input: src:  Integer
    Input: rows: Integer
    Input: cols: Integer
    Body: {
        rc    = Multiply(rows, cols)
        total = Multiply(rc, TFElem.Size)
        i = 0
        WhileLoop LessThan(i, total) {
            byt = GetByte(src, i)
            SetByte(dst, i, byt)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// SGD UPDATE
// w[i][j] -= lr_num * grad[i][j] / lr_den
// =============================================================================
Function.TF_MatSGD {
    Input: weights: Integer
    Input: grads:   Integer
    Input: rows:    Integer
    Input: cols:    Integer
    Input: lr_num:  Integer
    Input: lr_den:  Integer
    Body: {
        total = Multiply(rows, cols)
        i     = 0
        WhileLoop LessThan(i, total) {
            off   = Multiply(i, TFElem.Size)
            wptr  = Add(weights, off)
            gptr  = Add(grads,   off)
            w     = Dereference(wptr)
            g     = Dereference(gptr)
            num   = Multiply(g, lr_num)
            delta = Divide(num, lr_den)
            nuw   = Subtract(w, delta)
            StoreValue(wptr, nuw)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// === Inlined from TF.Act ===
// Library.TF.Act.ailang
// Activation functions for the transformer stack.
// Softmax via exp lookup table (256 entries, matches ATTN/11 EXPTBL)
// Cross-entropy loss via log lookup table (257 entries, matches ATTN/11 LOGTBL)
// No floating point. No transcendental functions at runtime.
// Copyright © 2025 Sean Collins, 2 Paws Machine and Engineering. All rights reserved. SCSL.


// =============================================================================
// EXP TABLE
// 256 entries. EXPTBL[i] = exp(-i/32) * 256  (Q8 fixed point)
// Index i covers roughly 8 units of input before reaching zero.
// Generated offline: for i in range(256): int(exp(-i/32.0) * 256)
