// Library.StringUtils.ailang
// String utility functions implemented in pure AILANG

// Get length of null-terminated string
Function.StrLen {
    Input: str: Address
    Output: Integer
    Body: {
        len = 0
        ptr = str
        byte = Dereference(ptr, "byte")
        
        WhileLoop GreaterThan(byte, 0) {
            len = Add(len, 1)
            ptr = Add(ptr, 1)
            byte = Dereference(ptr, "byte")
        }
        
        ReturnValue(len)
    }
}

// Convert string to integer
Function.StrToNum {
    Input: str: Address
    Output: Integer
    Body: {
        result = 0
        ptr = str
        byte = Dereference(ptr, "byte")
        
        // Process each digit
        WhileLoop GreaterThan(byte, 0) {
            // Check if it's a digit (48='0' to 57='9')
            is_digit = GreaterThan(byte, 47)
            is_digit2 = LessEqual(byte, 57)
            
            // Only process if valid digit
            IfCondition And(is_digit, is_digit2) ThenBlock: {
                digit = Subtract(byte, 48)
                result = Multiply(result, 10)
                result = Add(result, digit)
            }
            
            ptr = Add(ptr, 1)
            byte = Dereference(ptr, "byte")
        }
        
        ReturnValue(result)
    }
}

// Find character in string, returns position or -1
Function.StrFindChar {
    Input: str: Address
    Input: target_char: Integer
    Output: Integer
    Body: {
        position = 0
        ptr = str
        byte = Dereference(ptr, "byte")
        
        WhileLoop GreaterThan(byte, 0) {
            IfCondition EqualTo(byte, target_char) ThenBlock: {
                ReturnValue(position)
            }
            position = Add(position, 1)
            ptr = Add(ptr, 1)
            byte = Dereference(ptr, "byte")
        }
        
        ReturnValue(-1)
    }
}

// Compare two strings, returns 0 if equal
Function.StrCompare {
    Input: str1: Address
    Input: str2: Address
    Output: Integer
    Body: {
        ptr1 = str1
        ptr2 = str2
        
        byte1 = Dereference(ptr1, "byte")
        byte2 = Dereference(ptr2, "byte")
        
        WhileLoop And(GreaterThan(byte1, 0), GreaterThan(byte2, 0)) {
            IfCondition NotEqual(byte1, byte2) ThenBlock: {
                ReturnValue(1)
            }
            
            ptr1 = Add(ptr1, 1)
            ptr2 = Add(ptr2, 1)
            byte1 = Dereference(ptr1, "byte")
            byte2 = Dereference(ptr2, "byte")
        }
        
        // Check if both ended at same time
        IfCondition NotEqual(byte1, byte2) ThenBlock: {
            ReturnValue(1)
        }
        
        ReturnValue(0)
    }
}

// Check if string starts with prefix
Function.StrStartsWith {
    Input: str: Address
    Input: prefix: Address
    Output: Integer
    Body: {
        ptr1 = str
        ptr2 = prefix
        
        byte1 = Dereference(ptr1, "byte")
        byte2 = Dereference(ptr2, "byte")
        
        WhileLoop GreaterThan(byte2, 0) {
            IfCondition NotEqual(byte1, byte2) ThenBlock: {
                ReturnValue(0)
            }
            
            ptr1 = Add(ptr1, 1)
            ptr2 = Add(ptr2, 1)
            byte1 = Dereference(ptr1, "byte")
            byte2 = Dereference(ptr2, "byte")
        }
        
        ReturnValue(1)
    }
}

// Get substring from start position for given length
Function.StrSubstring {
    Input: str: Address
    Input: start: Integer
    Input: length: Integer
    // Returns: Address (caller must Deallocate with StringLength + 1)
    Output: Address
    Body: {
        result = Allocate(Add(length, 1))
        
        src_ptr = Add(str, start)
        dst_ptr = result
        
        i = 0
        WhileLoop LessThan(i, length) {
            byte = Dereference(src_ptr, "byte")
            
            IfCondition EqualTo(byte, 0) ThenBlock: {
                // Reached end of source string
                StoreValue(dst_ptr, 0)
                ReturnValue(result)
            }
            
            StoreValue(dst_ptr, byte)
            src_ptr = Add(src_ptr, 1)
            dst_ptr = Add(dst_ptr, 1)
            i = Add(i, 1)
        }
        
        // Null terminate
        StoreValue(dst_ptr, 0)
        ReturnValue(result)
    }
}

// Split string by delimiter (returns XArray of strings)
Function.StrSplit {
    Input: str: Address
    Input: delimiter: Address
    // Returns: XArray of string parts
    // CRITICAL: Caller must:
    //   1. Free each string: Deallocate(str, Add(StringLength(str), 1))
    //   2. Destroy array: XArray.XDestroy(result)
    Output: Address
    Body: {
        result = XArray.XCreate()
        
        delim_char = Dereference(delimiter, "byte")
        ptr = str
        start = str
        
        byte = Dereference(ptr, "byte")
        
        WhileLoop GreaterThan(byte, 0) {
            IfCondition EqualTo(byte, delim_char) ThenBlock: {
                // Found delimiter - extract substring
                len = Subtract(ptr, start)
                
                IfCondition GreaterThan(len, 0) ThenBlock: {
                    part = Allocate(Add(len, 1))
                    
                    // Copy substring
                    i = 0
                    src = start
                    WhileLoop LessThan(i, len) {
                        b = Dereference(src, "byte")
                        StoreValue(Add(part, i), b)
                        src = Add(src, 1)
                        i = Add(i, 1)
                    }
                    StoreValue(Add(part, len), 0)
                    
                    XArray.XPush(result, part)
                }
                
                // Move past delimiter
                ptr = Add(ptr, 1)
                start = ptr
                byte = Dereference(ptr, "byte")
            } ElseBlock: {
                ptr = Add(ptr, 1)
                byte = Dereference(ptr, "byte")
            }
        }
        
        // Add last part if any
        len = Subtract(ptr, start)
        IfCondition GreaterThan(len, 0) ThenBlock: {
            part = Allocate(Add(len, 1))
            
            i = 0
            src = start
            WhileLoop LessThan(i, len) {
                b = Dereference(src, "byte")
                StoreValue(Add(part, i), b)
                src = Add(src, 1)
                i = Add(i, 1)
            }
            StoreValue(Add(part, len), 0)
            
            XArray.XPush(result, part)
        }
        
        ReturnValue(result)
    }
}

// Convert integer to string
Function.NumToStr {
    Input: num: Integer
    // Returns: Address (caller must Deallocate with StringLength + 1)
    Output: Address
    Body: {
        // Handle zero
        IfCondition EqualTo(num, 0) ThenBlock: {
            result = Allocate(2)
            StoreValue(result, 48)
            StoreValue(Add(result, 1), 0)
            ReturnValue(result)
        }
        
        // Handle negative
        negative = 0
        value = num
        IfCondition LessThan(num, 0) ThenBlock: {
            negative = 1
            value = Subtract(0, num)
        }
        
        // Count digits
        temp = value
        digit_count = 0
        WhileLoop GreaterThan(temp, 0) {
            temp = Divide(temp, 10)
            digit_count = Add(digit_count, 1)
        }
        
        // Allocate string
        total_len = digit_count
        IfCondition EqualTo(negative, 1) ThenBlock: {
            total_len = Add(total_len, 1)
        }
        
        result = Allocate(Add(total_len, 1))
        
        // Fill digits from right to left
        pos = total_len
        temp = value
        
        WhileLoop GreaterThan(temp, 0) {
            digit = Modulo(temp, 10)
            ascii_digit = Add(digit, 48)
            
            pos = Subtract(pos, 1)
            StoreValue(Add(result, pos), ascii_digit)
            
            temp = Divide(temp, 10)
        }
        
        // Add minus sign if negative
        IfCondition EqualTo(negative, 1) ThenBlock: {
            StoreValue(result, 45)
        }
        
        // Null terminate
        StoreValue(Add(result, total_len), 0)
        
        ReturnValue(result)
    }
}

// === Inlined from Analyzer2 ===
// Library.Analyzer2.ailang
// Extended Static Analysis - Control Flow & Type Tracking
// Complements Library.Analyzer.ailang
//
// Features:
//   - Unreachable code detection
//   - Infinite loop detection  
//   - Missing else warnings for functions with Output
//   - Constant expression detection (optimization hints)
//   - Null pointer dereference warnings
//   - Argument count validation
//   - Return value ignored warnings


// =============================================================================
// ANALYZER2 STATE
// =============================================================================
FixedPool.Analyzer2 {
    // Control flow state
    "unreachable_warnings": Initialize=0, CanChange=True
    "infinite_loop_warnings": Initialize=0, CanChange=True
    "missing_else_warnings": Initialize=0, CanChange=True
    
    // Type tracking (per function)
    "var_types": Initialize=0, CanChange=True       // XArray of var names
    "var_type_vals": Initialize=0, CanChange=True   // XArray of type constants
    
    // Function signatures (global)
    "func_names": Initialize=0, CanChange=True
    "func_param_counts": Initialize=0, CanChange=True
    "func_has_output": Initialize=0, CanChange=True
    "func_def_lines": Initialize=0, CanChange=True
    
    // Null tracking
    "possibly_null_vars": Initialize=0, CanChange=True
    "checked_null_vars": Initialize=0, CanChange=True
    
    // Constant propagation hints
    "const_vars": Initialize=0, CanChange=True
    "const_values": Initialize=0, CanChange=True
    
    // Results
    "warnings": Initialize=0, CanChange=True
    "hints": Initialize=0, CanChange=True
    "warning_count": Initialize=0, CanChange=True
    "hint_count": Initialize=0, CanChange=True
    
    // Current context
    "current_func": Initialize=0, CanChange=True
    "current_func_has_output": Initialize=0, CanChange=True
    "after_terminator": Initialize=0, CanChange=True
    "in_loop": Initialize=0, CanChange=True
    "last_valid_line": Initialize=0, CanChange=True
    "loop_has_break": Initialize=0, CanChange=True
    "loop_has_condition_var": Initialize=0, CanChange=True
    
    // Config
    "check_unreachable": Initialize=1, CanChange=True
    "check_infinite_loops": Initialize=1, CanChange=True
    "check_missing_else": Initialize=1, CanChange=True
    "check_null_deref": Initialize=1, CanChange=True
    "check_arg_counts": Initialize=1, CanChange=True
    "check_ignored_return": Initialize=1, CanChange=True
    "emit_const_hints": Initialize=1, CanChange=True
    "verbose": Initialize=0, CanChange=True
}

// =============================================================================
// TYPE CONSTANTS
// =============================================================================
FixedPool.VarType {
    "UNKNOWN": Initialize=0
    "INTEGER": Initialize=1
    "ADDRESS": Initialize=2
    "STRING": Initialize=3
    "BOOLEAN": Initialize=4
    "NULLABLE": Initialize=5
}

// =============================================================================
// INITIALIZATION
// =============================================================================
Function.Analyzer2.Init {
    Body: {
        Analyzer2.warnings = XArray.XCreate(128)
        Analyzer2.hints = XArray.XCreate(64)
        Analyzer2.warning_count = 0
        Analyzer2.hint_count = 0
        
        // Type tracking
        Analyzer2.var_types = XArray.XCreate(64)
        Analyzer2.var_type_vals = XArray.XCreate(64)
        
        // Function signatures
        Analyzer2.func_names = XArray.XCreate(256)
        Analyzer2.func_param_counts = XArray.XCreate(256)
        Analyzer2.func_has_output = XArray.XCreate(256)
        Analyzer2.func_def_lines = XArray.XCreate(256)
        
        // Null tracking
        Analyzer2.possibly_null_vars = XArray.XCreate(32)
        Analyzer2.checked_null_vars = XArray.XCreate(32)
        
        // Constant tracking
        Analyzer2.const_vars = XArray.XCreate(32)
        Analyzer2.const_values = XArray.XCreate(32)
        
        // Reset state
        Analyzer2.current_func = 0
        Analyzer2.current_func_has_output = 0
        Analyzer2.after_terminator = 0
        Analyzer2.in_loop = 0
        Analyzer2.loop_has_break = 0
        Analyzer2.last_valid_line = 0
        
        Analyzer2.unreachable_warnings = 0
        Analyzer2.infinite_loop_warnings = 0
        Analyzer2.missing_else_warnings = 0
    }
}

// =============================================================================
// DIAGNOSTICS
// =============================================================================
Function.Analyzer2.AddWarning {
    Input: msg: Address
    Body: {
        // Deduplicate: Check if message already exists
        count = XArray.XSize(Analyzer2.warnings)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = XArray.XGet(Analyzer2.warnings, i)
            IfCondition EqualTo(StringCompare(existing, msg), 0) ThenBlock: { ReturnValue(0) }
            i = Add(i, 1)
        }
        
        XArray.XPush(Analyzer2.warnings, msg)
        Analyzer2.warning_count = Add(Analyzer2.warning_count, 1)
    }
}

Function.Analyzer2.AddHint {
    Input: msg: Address
    Body: {
        // Deduplicate
        count = XArray.XSize(Analyzer2.hints)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = XArray.XGet(Analyzer2.hints, i)
            IfCondition EqualTo(StringCompare(existing, msg), 0) ThenBlock: { ReturnValue(0) }
            i = Add(i, 1)
        }
        
        XArray.XPush(Analyzer2.hints, msg)
        Analyzer2.hint_count = Add(Analyzer2.hint_count, 1)
    }
}

// =============================================================================
// STRING HELPERS
// =============================================================================
Function.Analyzer2.StrEqual {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(a, 0) ThenBlock: {
            IfCondition EqualTo(b, 0) ThenBlock: { ReturnValue(1) }
            ReturnValue(0)
        }
        IfCondition EqualTo(b, 0) ThenBlock: { ReturnValue(0) }
        cmp = StringCompare(a, b)
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// =============================================================================
// TYPE TRACKING
// =============================================================================
Function.Analyzer2.SetVarType {
    Input: name: Address
    Input: vtype: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        
        // Check if already tracked
        count = XArray.XSize(Analyzer2.var_types)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = XArray.XGet(Analyzer2.var_types, i)
            IfCondition EqualTo(Analyzer2.StrEqual(existing, name), 1) ThenBlock: {
                // Update existing
                XArray.XSet(Analyzer2.var_type_vals, i, vtype)
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        
        // Add new
        XArray.XPush(Analyzer2.var_types, name)
        XArray.XPush(Analyzer2.var_type_vals, vtype)
    }
}

Function.Analyzer2.GetVarType {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(VarType.UNKNOWN) }
        
        count = XArray.XSize(Analyzer2.var_types)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = XArray.XGet(Analyzer2.var_types, i)
            IfCondition EqualTo(Analyzer2.StrEqual(existing, name), 1) ThenBlock: {
                ReturnValue(XArray.XGet(Analyzer2.var_type_vals, i))
            }
            i = Add(i, 1)
        }
        ReturnValue(VarType.UNKNOWN)
    }
}

Function.Analyzer2.ClearVarTypes {
    Body: {
        XArray.XClear(Analyzer2.var_types)
        XArray.XClear(Analyzer2.var_type_vals)
    }
}

// =============================================================================
// NULL TRACKING
// =============================================================================
Function.Analyzer2.MarkPossiblyNull {
    Input: name: Address
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        
        // Check if already tracked
        count = XArray.XSize(Analyzer2.possibly_null_vars)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = XArray.XGet(Analyzer2.possibly_null_vars, i)
            IfCondition EqualTo(Analyzer2.StrEqual(existing, name), 1) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        XArray.XPush(Analyzer2.possibly_null_vars, name)
    }
}

Function.Analyzer2.MarkNullChecked {
    Input: name: Address
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        
        count = XArray.XSize(Analyzer2.checked_null_vars)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = XArray.XGet(Analyzer2.checked_null_vars, i)
            IfCondition EqualTo(Analyzer2.StrEqual(existing, name), 1) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        XArray.XPush(Analyzer2.checked_null_vars, name)
    }
}

Function.Analyzer2.IsNullChecked {
    Input: name: Address
    Output: Integer
    Body: {
        count = XArray.XSize(Analyzer2.checked_null_vars)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = XArray.XGet(Analyzer2.checked_null_vars, i)
            IfCondition EqualTo(Analyzer2.StrEqual(existing, name), 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Analyzer2.IsPossiblyNull {
    Input: name: Address
    Output: Integer
    Body: {
        count = XArray.XSize(Analyzer2.possibly_null_vars)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = XArray.XGet(Analyzer2.possibly_null_vars, i)
            IfCondition EqualTo(Analyzer2.StrEqual(existing, name), 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Analyzer2.ClearNullTracking {
    Body: {
        XArray.XClear(Analyzer2.possibly_null_vars)
        XArray.XClear(Analyzer2.checked_null_vars)
    }
}

// =============================================================================
// FUNCTION SIGNATURE TRACKING
// =============================================================================
Function.Analyzer2.RegisterFunction {
    Input: name: Address
    Input: param_count: Integer
    Input: has_output: Integer
    Input: line: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        
        // Check if already registered
        count = XArray.XSize(Analyzer2.func_names)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = XArray.XGet(Analyzer2.func_names, i)
            IfCondition EqualTo(Analyzer2.StrEqual(existing, name), 1) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        
        XArray.XPush(Analyzer2.func_names, name)
        XArray.XPush(Analyzer2.func_param_counts, param_count)
        XArray.XPush(Analyzer2.func_has_output, has_output)
        XArray.XPush(Analyzer2.func_def_lines, line)
    }
}

Function.Analyzer2.GetFuncParamCount {
    Input: name: Address
    Output: Integer
    Body: {
        count = XArray.XSize(Analyzer2.func_names)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = XArray.XGet(Analyzer2.func_names, i)
            IfCondition EqualTo(Analyzer2.StrEqual(existing, name), 1) ThenBlock: {
                ReturnValue(XArray.XGet(Analyzer2.func_param_counts, i))
            }
            i = Add(i, 1)
        }
        ReturnValue(-1)  // Unknown
    }
}

Function.Analyzer2.FuncHasOutput {
    Input: name: Address
    Output: Integer
    Body: {
        count = XArray.XSize(Analyzer2.func_names)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = XArray.XGet(Analyzer2.func_names, i)
            IfCondition EqualTo(Analyzer2.StrEqual(existing, name), 1) ThenBlock: {
                ReturnValue(XArray.XGet(Analyzer2.func_has_output, i))
            }
            i = Add(i, 1)
        }
        ReturnValue(-1)  // Unknown
    }
}

// =============================================================================
// CONSTANT EXPRESSION DETECTION
// =============================================================================
Function.Analyzer2.IsConstantExpr {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        
        node_type = AST_GetType(node)
        
        // Literals are constant
        IfCondition EqualTo(node_type, AST.NUMBER) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(node_type, AST.STRING) ThenBlock: { ReturnValue(1) }
        
        // Check if it's a pure math call with constant args
        IfCondition EqualTo(node_type, AST.CALL) ThenBlock: {
            func_name = AST_GetData1(node)
            is_pure = Analyzer2.IsPureMathFunc(func_name)
            IfCondition EqualTo(is_pure, 0) ThenBlock: { ReturnValue(0) }
            
            // Check all args are constant
            child_count = AST_GetChildCount(node)
            i = 0
            WhileLoop LessThan(i, child_count) {
                child = AST_GetChild(node, i)
                IfCondition EqualTo(Analyzer2.IsConstantExpr(child), 0) ThenBlock: {
                    ReturnValue(0)
                }
                i = Add(i, 1)
            }
            ReturnValue(1)
        }
        
        ReturnValue(0)
    }
}

Function.Analyzer2.IsPureMathFunc {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        
        IfCondition EqualTo(StringCompare(name, "Add"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Subtract"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Multiply"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Divide"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Modulo"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseAnd"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseOr"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseXor"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "ShiftLeft"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "ShiftRight"), 0) ThenBlock: { ReturnValue(1) }
        
        ReturnValue(0)
    }
}

// =============================================================================
// PASS 1: COLLECT FUNCTION SIGNATURES
// =============================================================================
Function.Analyzer2.CollectSignatures {
    Input: node: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        
        node_type = AST_GetType(node)
        node_line = AST_GetLine(node)
        
        IfCondition EqualTo(node_type, AST.FUNCTION) ThenBlock: {
            name = AST_GetData1(node)
            param_count = 0
            has_output = 0
            
            child_count = AST_GetChildCount(node)
            i = 0
            WhileLoop LessThan(i, child_count) {
                child = AST_GetChild(node, i)
                IfCondition NotEqual(child, 0) ThenBlock: {
                    child_type = AST_GetType(child)
                    IfCondition EqualTo(child_type, AST.PARAMETER) ThenBlock: {
                        param_count = Add(param_count, 1)
                    }
                    IfCondition EqualTo(child_type, AST.OUTPUT_DECL) ThenBlock: {
                        has_output = 1
                    }
                }
                i = Add(i, 1)
            }
            
            Analyzer2.RegisterFunction(name, param_count, has_output, node_line)
        }
        
        IfCondition EqualTo(node_type, AST.SUBROUTINE) ThenBlock: {
            name = AST_GetData1(node)
            param_count = 0
            
            child_count = AST_GetChildCount(node)
            i = 0
            WhileLoop LessThan(i, child_count) {
                child = AST_GetChild(node, i)
                IfCondition NotEqual(child, 0) ThenBlock: {
                    child_type = AST_GetType(child)
                    IfCondition EqualTo(child_type, AST.PARAMETER) ThenBlock: {
                        param_count = Add(param_count, 1)
                    }
                }
                i = Add(i, 1)
            }
            
            Analyzer2.RegisterFunction(name, param_count, 0, node_line)
        }
        
        // Recurse into children
        child_count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, child_count) {
            child = AST_GetChild(node, i)
            Analyzer2.CollectSignatures(child)
            i = Add(i, 1)
        }
    }
}

// =============================================================================
// MAIN WALK
// =============================================================================
Function.Analyzer2.WalkNode {
    Input: node: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        
        node_type = AST_GetType(node)
        node_line = AST_GetLine(node)
        
        // Fix for "Line 0" issues: propagate last known valid line
        IfCondition GreaterThan(node_line, 0) ThenBlock: {
            Analyzer2.last_valid_line = node_line
        } ElseBlock: {
            node_line = Analyzer2.last_valid_line
        }
        
        // PrintMessage("[W:") PrintNumber(node_type) PrintMessage("]")
        // IfCondition EqualTo(Analyzer2.after_terminator, 1) ThenBlock: {
        //     PrintMessage("[Term]")
        // }
        
        
        // === CHECK: Unreachable code ===
        is_declaration = 0
        IfCondition EqualTo(node_type, AST.FUNCTION) ThenBlock: { is_declaration = 1 }
        IfCondition EqualTo(node_type, AST.SUBROUTINE) ThenBlock: { is_declaration = 1 }
        IfCondition EqualTo(node_type, AST.POOL_FIXED) ThenBlock: { is_declaration = 1 }
        IfCondition EqualTo(node_type, AST.POOL_DYNAMIC) ThenBlock: { is_declaration = 1 }
        IfCondition EqualTo(node_type, AST.POOL_TEMPORAL) ThenBlock: { is_declaration = 1 }
        IfCondition EqualTo(node_type, AST.POOL_NEURAL) ThenBlock: { is_declaration = 1 }
        IfCondition EqualTo(node_type, AST.POOL_KERNEL) ThenBlock: { is_declaration = 1 }
        IfCondition EqualTo(node_type, AST.POOL_ACTOR) ThenBlock: { is_declaration = 1 }
        IfCondition EqualTo(node_type, AST.POOL_SECURITY) ThenBlock: { is_declaration = 1 }
        IfCondition EqualTo(node_type, AST.POOL_CONSTRAINED) ThenBlock: { is_declaration = 1 }
        IfCondition EqualTo(node_type, AST.POOL_FILE) ThenBlock: { is_declaration = 1 }
        IfCondition EqualTo(node_type, AST.POOL_LINKAGE) ThenBlock: { is_declaration = 1 }
        IfCondition EqualTo(node_type, AST.PROGRAM) ThenBlock: { is_declaration = 1 }
        IfCondition EqualTo(node_type, AST.LIBRARY_IMPORT) ThenBlock: { is_declaration = 1 }
        IfCondition EqualTo(node_type, AST.ACRONYM_DEFS) ThenBlock: { is_declaration = 1 }
        IfCondition EqualTo(node_type, AST.MODULE) ThenBlock: { is_declaration = 1 }
        IfCondition EqualTo(node_type, AST.EXPORT) ThenBlock: { is_declaration = 1 }
        IfCondition EqualTo(node_type, AST.LOOP_MAIN) ThenBlock: { is_declaration = 1 }
        IfCondition EqualTo(node_type, AST.LOOP_ACTOR) ThenBlock: { is_declaration = 1 }
        IfCondition EqualTo(node_type, AST.LOOP_START) ThenBlock: { is_declaration = 1 }
        IfCondition EqualTo(node_type, AST.MACRO_DEFINE) ThenBlock: { is_declaration = 1 }
        
        IfCondition EqualTo(Analyzer2.check_unreachable, 1) ThenBlock: {
            IfCondition EqualTo(Analyzer2.after_terminator, 1) ThenBlock: {
                IfCondition EqualTo(is_declaration, 0) ThenBlock: {
                    location = FileMap_Format(node_line)
                    msg = location
                    msg = StringConcat(msg, ": Unreachable code after return/break/halt")
                    IfCondition NotEqual(Analyzer2.current_func, 0) ThenBlock: {
                        msg = StringConcat(msg, " in '")
                        msg = StringConcat(msg, Analyzer2.current_func)
                        msg = StringConcat(msg, "'")
                    }
                    Analyzer2.AddWarning(msg)
                    Analyzer2.unreachable_warnings = Add(Analyzer2.unreachable_warnings, 1)
                    // Only warn once per block
                    Analyzer2.after_terminator = 0
                }
            }
        }
        
        // === FUNCTION ENTRY ===
        IfCondition EqualTo(node_type, AST.FUNCTION) ThenBlock: {
            // PrintMessage("[FuncEntry]")
            Analyzer2.current_func = AST_GetData1(node)
            // PrintMessage("[FuncData:") PrintNumber(Analyzer2.current_func) PrintMessage("]")
            Analyzer2.ClearVarTypes()
            // PrintMessage("[ClearVars]")
            Analyzer2.ClearNullTracking()
            // PrintMessage("[ClearNull]")
            Analyzer2.after_terminator = 0
            
            // Check if has Output
            Analyzer2.current_func_has_output = 0
            child_count = AST_GetChildCount(node)
            // PrintMessage("[ChildCount:") PrintNumber(child_count) PrintMessage("]")
            
            i = 0
            WhileLoop LessThan(i, child_count) {
                child = AST_GetChild(node, i)
                IfCondition NotEqual(child, 0) ThenBlock: {
                    child_type = AST_GetType(child)
                    // PrintMessage("[CT:") PrintNumber(child_type) PrintMessage("]")
                    
                    IfCondition EqualTo(child_type, AST.OUTPUT_DECL) ThenBlock: {
                        Analyzer2.current_func_has_output = 1
                    }
                    // Track parameter types
                    IfCondition EqualTo(child_type, AST.PARAMETER) ThenBlock: {
                        // PrintMessage("[Param]")
                        param_name = AST_GetData1(child)
                        // PrintMessage("[Name:") PrintNumber(param_name) PrintMessage("]")
                        param_type_node = AST_GetChild(child, 0)
                        // PrintMessage("[TypeNode:") PrintNumber(param_type_node) PrintMessage("]")
                        
                        // Check for valid node pointer (positive) to avoid error codes like -999999
                        IfCondition GreaterThan(param_type_node, 0) ThenBlock: {
                            ptype = Analyzer2.NodeToVarType(param_type_node)
                            // PrintMessage("[PType:") PrintNumber(ptype) PrintMessage("]")
                            Analyzer2.SetVarType(param_name, ptype)
                            // PrintMessage("[Set]")
                        }
                    }
                }
                i = Add(i, 1)
            }
            
            // PrintMessage("[WalkFuncBody]")
            Analyzer2.WalkChildren(node)
            Analyzer2.current_func = 0
            ReturnValue(0)
        }
        
        // === SUBROUTINE ===
        IfCondition EqualTo(node_type, AST.SUBROUTINE) ThenBlock: {
            Analyzer2.current_func = AST_GetData1(node)
            Analyzer2.current_func_has_output = 0
            Analyzer2.ClearVarTypes()
            Analyzer2.ClearNullTracking()
            Analyzer2.after_terminator = 0
            Analyzer2.WalkChildren(node)
            Analyzer2.current_func = 0
            ReturnValue(0)
        }
        
        // === RETURN - marks code after as unreachable ===
        IfCondition EqualTo(node_type, AST.RETURN) ThenBlock: {
            Analyzer2.WalkChildren(node)        // walk the return expression FIRST
            Analyzer2.after_terminator = 1      // THEN mark as terminated
            ReturnValue(0)
        }
        
        // === HALT - marks code after as unreachable ===
        IfCondition EqualTo(node_type, AST.OP_HALT) ThenBlock: {
            Analyzer2.after_terminator = 1
            ReturnValue(0)
        }
        
        // === BREAK - marks code after as unreachable (in loop) ===
        IfCondition EqualTo(node_type, AST.EXIT_LOOP) ThenBlock: {
            Analyzer2.after_terminator = 1
            Analyzer2.loop_has_break = 1
            ReturnValue(0)
        }
        
        // === WHILE LOOP ===
        IfCondition EqualTo(node_type, AST.WHILE) ThenBlock: {
            // PrintMessage("[While]")
            old_in_loop = Analyzer2.in_loop
            old_has_break = Analyzer2.loop_has_break
            Analyzer2.in_loop = 1
            Analyzer2.loop_has_break = 0
            
            // Check condition
            child_count = AST_GetChildCount(node)
            IfCondition GreaterThan(child_count, 0) ThenBlock: {
                cond = AST_GetChild(node, 0)
                Analyzer2.CheckLoopCondition(cond, node_line)
            }
            
            Analyzer2.WalkChildren(node)
            
            // Check for infinite loop (True condition, no break)
            IfCondition EqualTo(Analyzer2.check_infinite_loops, 1) ThenBlock: {
                IfCondition GreaterThan(child_count, 0) ThenBlock: {
                    cond = AST_GetChild(node, 0)
                    IfCondition EqualTo(Analyzer2.IsAlwaysTrue(cond), 1) ThenBlock: {
                        IfCondition EqualTo(Analyzer2.loop_has_break, 0) ThenBlock: {
                            location = FileMap_Format(node_line)
                            msg = location
                            msg = StringConcat(msg, ": Potential infinite loop (condition always true, no BreakLoop)")
                            IfCondition NotEqual(Analyzer2.current_func, 0) ThenBlock: {
                                msg = StringConcat(msg, " in '")
                                msg = StringConcat(msg, Analyzer2.current_func)
                                msg = StringConcat(msg, "'")
                            }
                            Analyzer2.AddWarning(msg)
                            Analyzer2.infinite_loop_warnings = Add(Analyzer2.infinite_loop_warnings, 1)
                        }
                    }
                }
            }
            
            Analyzer2.in_loop = old_in_loop
            Analyzer2.loop_has_break = old_has_break
            Analyzer2.after_terminator = 0  // After loop, code is reachable
            ReturnValue(0)
        }
        
        // === IF CONDITION ===
        IfCondition EqualTo(node_type, AST.IF) ThenBlock: {
            // PrintMessage("[If]")
            child_count = AST_GetChildCount(node)
            
            // Check for null checks in condition
            IfCondition GreaterThan(child_count, 0) ThenBlock: {
                cond = AST_GetChild(node, 0)
                Analyzer2.ExtractNullChecks(cond)
            }
            
            // Check for missing else when function has Output
            IfCondition EqualTo(Analyzer2.check_missing_else, 1) ThenBlock: {
                IfCondition EqualTo(Analyzer2.current_func_has_output, 1) ThenBlock: {
                    has_else = 0
                    IfCondition GreaterThan(child_count, 2) ThenBlock: {
                        else_block = AST_GetChild(node, 2)
                        IfCondition NotEqual(else_block, 0) ThenBlock: {
                            has_else = 1
                        }
                    }
                    IfCondition EqualTo(has_else, 0) ThenBlock: {
                        // Check if then block contains return
                        IfCondition GreaterThan(child_count, 1) ThenBlock: {
                            then_block = AST_GetChild(node, 1)
                            has_return = Analyzer2.BlockHasReturn(then_block)
                            IfCondition EqualTo(has_return, 1) ThenBlock: {
                                location = FileMap_Format(node_line)
                                msg = location
                                msg = StringConcat(msg, ": IfCondition with ReturnValue but no ElseBlock in '")
                                IfCondition NotEqual(Analyzer2.current_func, 0) ThenBlock: {
                                    msg = StringConcat(msg, Analyzer2.current_func)
                                }
                                msg = StringConcat(msg, "' - may not return on all paths")
                                Analyzer2.AddWarning(msg)
                                Analyzer2.missing_else_warnings = Add(Analyzer2.missing_else_warnings, 1)
                            }
                        }
                    }
                }
            }
            
            Analyzer2.WalkChildren(node)
            Analyzer2.after_terminator = 0  // After if, code is reachable
            ReturnValue(0)
        }
        
        // === ASSIGNMENT ===
        IfCondition EqualTo(node_type, AST.ASSIGNMENT) ThenBlock: {
            target = AST_GetData1(node)
            // PrintMessage(" [Assign T:") PrintNumber(target) PrintMessage("]")
            child_count = AST_GetChildCount(node)
            
            IfCondition GreaterThan(child_count, 0) ThenBlock: {
                value = AST_GetChild(node, 0)
                // PrintMessage(" [Val:") PrintNumber(value) PrintMessage("]")
                
                // Track type from RHS
                // PrintMessage(" [Infer]")
                rhs_type = Analyzer2.InferType(value)
                // PrintMessage(" [Type:") PrintNumber(rhs_type) PrintMessage("]")
                
                // PrintMessage(" [SetVar]")
                Analyzer2.SetVarType(target, rhs_type)
                
                // Check if assigning from nullable source
                // Skip fixed-size Allocate calls — they never fail in practice
                IfCondition EqualTo(AST_GetType(value), AST.CALL) ThenBlock: {
                    func_name = AST_GetData1(value)
                    IfCondition EqualTo(Analyzer2.IsNullableFunc(func_name), 1) ThenBlock: {
                        should_mark = 1
                        IfCondition NotEqual(func_name, 0) ThenBlock: {
                            IfCondition EqualTo(StringCompare(func_name, "Allocate"), 0) ThenBlock: {
                                alloc_child_count = AST_GetChildCount(value)
                                IfCondition GreaterThan(alloc_child_count, 0) ThenBlock: {
                                    alloc_arg = AST_GetChild(value, 0)
                                    IfCondition NotEqual(alloc_arg, 0) ThenBlock: {
                                        IfCondition EqualTo(AST_GetType(alloc_arg), AST.NUMBER) ThenBlock: {
                                            should_mark = 0
                                        }
                                    }
                                }
                            }
                        }
                        IfCondition EqualTo(should_mark, 1) ThenBlock: {
                            Analyzer2.MarkPossiblyNull(target)
                        }
                    }
                }
                
                // Check for constant expression hint
                IfCondition EqualTo(Analyzer2.emit_const_hints, 1) ThenBlock: {
                    IfCondition EqualTo(Analyzer2.IsConstantExpr(value), 1) ThenBlock: {
                        IfCondition NotEqual(AST_GetType(value), AST.NUMBER) ThenBlock: {
                            IfCondition NotEqual(AST_GetType(value), AST.STRING) ThenBlock: {
                                location = FileMap_Format(node_line)
                                msg = location
                                msg = StringConcat(msg, ": Expression could be evaluated at compile time")
                                Analyzer2.AddHint(msg)
                            }
                        }
                    }
                }
                
                Analyzer2.WalkNode(value)
            }
            ReturnValue(0)
        }
        
        // === FUNCTION CALL ===
        IfCondition EqualTo(node_type, AST.CALL) ThenBlock: {
            // PrintMessage("[Call]")
            func_name = AST_GetData1(node)
            child_count = AST_GetChildCount(node)
            
            // Check argument count
            IfCondition EqualTo(Analyzer2.check_arg_counts, 1) ThenBlock: {
                expected = Analyzer2.GetFuncParamCount(func_name)
                IfCondition NotEqual(expected, -1) ThenBlock: {
                    IfCondition NotEqual(child_count, expected) ThenBlock: {
                        location = FileMap_Format(node_line)
                        msg = location
                        msg = StringConcat(msg, ": '")
                        IfCondition NotEqual(func_name, 0) ThenBlock: {
                            msg = StringConcat(msg, func_name)
                        }
                        msg = StringConcat(msg, "' expects ")
                        msg = StringConcat(msg, NumberToString(expected))
                        msg = StringConcat(msg, " args, got ")
                        msg = StringConcat(msg, NumberToString(child_count))
                        Analyzer2.AddWarning(msg)
                    }
                }
            }
            
            // Check for null dereference
            IfCondition EqualTo(Analyzer2.check_null_deref, 1) ThenBlock: {
                IfCondition EqualTo(Analyzer2.IsDereferenceFunc(func_name), 1) ThenBlock: {
                    IfCondition GreaterThan(child_count, 0) ThenBlock: {
                        arg = AST_GetChild(node, 0)
                        IfCondition EqualTo(AST_GetType(arg), AST.IDENTIFIER) ThenBlock: {
                            arg_name = AST_GetData1(arg)
                            IfCondition EqualTo(Analyzer2.IsPossiblyNull(arg_name), 1) ThenBlock: {
                                IfCondition EqualTo(Analyzer2.IsNullChecked(arg_name), 0) ThenBlock: {
                                    location = FileMap_Format(node_line)
                                    msg = location
                                    msg = StringConcat(msg, ": Potential null dereference of '")
                                    IfCondition NotEqual(arg_name, 0) ThenBlock: {
                                        msg = StringConcat(msg, arg_name)
                                    }
                                    msg = StringConcat(msg, "' without null check")
                                    IfCondition NotEqual(Analyzer2.current_func, 0) ThenBlock: {
                                        msg = StringConcat(msg, " in '")
                                        msg = StringConcat(msg, Analyzer2.current_func)
                                        msg = StringConcat(msg, "'")
                                    }
                                    Analyzer2.AddWarning(msg)
                                }
                            }
                        }
                    }
                }
            }
            
            Analyzer2.WalkChildren(node)
            ReturnValue(0)
        }
        
        // === DEFAULT: recurse ===
        // PrintMessage("[Def]")
        Analyzer2.WalkChildren(node)
    }
}

Function.Analyzer2.WalkChildren {
    Input: node: Address
    Body: {
        // PrintMessage("[WC]")
        child_count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, child_count) {
            child = AST_GetChild(node, i)
            // PrintMessage("[C:") PrintNumber(i) PrintMessage("]")
            Analyzer2.WalkNode(child)
            i = Add(i, 1)
        }
        // PrintMessage("[/WC]")
    }
}

// =============================================================================
// HELPER FUNCTIONS
// =============================================================================
Function.Analyzer2.IsAlwaysTrue {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        
        node_type = AST_GetType(node)
        
        // Check for True identifier
        IfCondition EqualTo(node_type, AST.IDENTIFIER) ThenBlock: {
            name = AST_GetData1(node)
            IfCondition NotEqual(name, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(name, "True"), 0) ThenBlock: {
                    ReturnValue(1)
                }
            }
        }
        
        // Check for number 1
        IfCondition EqualTo(node_type, AST.NUMBER) ThenBlock: {
            val = AST_GetData1(node)
            IfCondition NotEqual(val, 0) ThenBlock: {
                num = StringToNumber(val)
                IfCondition EqualTo(num, 1) ThenBlock: {
                    ReturnValue(1)
                }
            }
        }
        
        ReturnValue(0)
    }
}

Function.Analyzer2.BlockHasReturn {
    Input: block: Address
    Output: Integer
    Body: {
        // PrintMessage("[BHR]")
        IfCondition EqualTo(block, 0) ThenBlock: { ReturnValue(0) }
        
        block_type = AST_GetType(block)
        IfCondition EqualTo(block_type, AST.RETURN) ThenBlock: { ReturnValue(1) }
        
        child_count = AST_GetChildCount(block)
        i = 0
        WhileLoop LessThan(i, child_count) {
            child = AST_GetChild(block, i)
            IfCondition EqualTo(Analyzer2.BlockHasReturn(child), 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Analyzer2.CheckLoopCondition {
    Input: cond: Address
    Input: line: Integer
    Body: {
        // Placeholder for more complex loop analysis
        // Could track which variables affect the condition
        
        // Silence unused variable warnings
        IfCondition EqualTo(cond, 0) ThenBlock: { }
        IfCondition EqualTo(line, 0) ThenBlock: { }
    }
}

Function.Analyzer2.ExtractNullChecks {
    Input: cond: Address
    Body: {
        // PrintMessage("[ENC]")
        IfCondition EqualTo(cond, 0) ThenBlock: { ReturnValue(0) }
        
        cond_type = AST_GetType(cond)
        
        // Look for EqualTo(var, 0) or NotEqual(var, 0)
        IfCondition EqualTo(cond_type, AST.CALL) ThenBlock: {
            func_name = AST_GetData1(cond)
            IfCondition NotEqual(func_name, 0) ThenBlock: {
                is_eq = StringCompare(func_name, "EqualTo")
                is_neq = StringCompare(func_name, "NotEqual")
                
                IfCondition Or(EqualTo(is_eq, 0), EqualTo(is_neq, 0)) ThenBlock: {
                    child_count = AST_GetChildCount(cond)
                    IfCondition EqualTo(child_count, 2) ThenBlock: {
                        arg0 = AST_GetChild(cond, 0)
                        arg1 = AST_GetChild(cond, 1)
                        
                        // Check if comparing identifier to 0
                        IfCondition EqualTo(AST_GetType(arg0), AST.IDENTIFIER) ThenBlock: {
                            IfCondition EqualTo(AST_GetType(arg1), AST.NUMBER) ThenBlock: {
                                val = AST_GetData1(arg1)
                                IfCondition NotEqual(val, 0) ThenBlock: {
                                    num = StringToNumber(val)
                                    IfCondition EqualTo(num, 0) ThenBlock: {
                                        var_name = AST_GetData1(arg0)
                                        Analyzer2.MarkNullChecked(var_name)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

Function.Analyzer2.IsNullableFunc {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        
        // Functions that can return 0/null
        IfCondition EqualTo(StringCompare(name, "Allocate"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "ArrayCreate"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "XArray.XCreate"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "XArray.XGet"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Sem_Lookup"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "AST_GetChild"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "AST_GetData1"), 0) ThenBlock: { ReturnValue(1) }
        
        ReturnValue(0)
    }
}

Function.Analyzer2.IsDereferenceFunc {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        
        IfCondition EqualTo(StringCompare(name, "Dereference"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "GetByte"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "SetByte"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "ArrayGet"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "ArraySet"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "StringLength"), 0) ThenBlock: { ReturnValue(1) }
        
        ReturnValue(0)
    }
}

Function.Analyzer2.InferType {
    Input: node: Address
    Output: Integer
    Body: {
        // PrintMessage(" [IT:") PrintNumber(node) PrintMessage("]")
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(VarType.UNKNOWN) }
        
        node_type = AST_GetType(node)
        
        IfCondition EqualTo(node_type, AST.NUMBER) ThenBlock: { ReturnValue(VarType.INTEGER) }
        IfCondition EqualTo(node_type, AST.STRING) ThenBlock: { ReturnValue(VarType.ADDRESS) }
        
        IfCondition EqualTo(node_type, AST.IDENTIFIER) ThenBlock: {
            name = AST_GetData1(node)
            IfCondition NotEqual(name, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(name, "True"), 0) ThenBlock: { ReturnValue(VarType.BOOLEAN) }
                IfCondition EqualTo(StringCompare(name, "False"), 0) ThenBlock: { ReturnValue(VarType.BOOLEAN) }
            }
            ReturnValue(Analyzer2.GetVarType(name))
        }
        
        IfCondition EqualTo(node_type, AST.CALL) ThenBlock: {
            func_name = AST_GetData1(node)
            ReturnValue(Analyzer2.FuncReturnType(func_name))
        }
        
        ReturnValue(VarType.UNKNOWN)
    }
}

Function.Analyzer2.FuncReturnType {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(VarType.UNKNOWN) }
        
        // Math ops return Integer
        IfCondition EqualTo(StringCompare(name, "Add"), 0) ThenBlock: { ReturnValue(VarType.INTEGER) }
        IfCondition EqualTo(StringCompare(name, "Subtract"), 0) ThenBlock: { ReturnValue(VarType.INTEGER) }
        IfCondition EqualTo(StringCompare(name, "Multiply"), 0) ThenBlock: { ReturnValue(VarType.INTEGER) }
        IfCondition EqualTo(StringCompare(name, "Divide"), 0) ThenBlock: { ReturnValue(VarType.INTEGER) }
        IfCondition EqualTo(StringCompare(name, "Modulo"), 0) ThenBlock: { ReturnValue(VarType.INTEGER) }
        
        // Comparisons return Boolean
        IfCondition EqualTo(StringCompare(name, "EqualTo"), 0) ThenBlock: { ReturnValue(VarType.BOOLEAN) }
        IfCondition EqualTo(StringCompare(name, "NotEqual"), 0) ThenBlock: { ReturnValue(VarType.BOOLEAN) }
        IfCondition EqualTo(StringCompare(name, "LessThan"), 0) ThenBlock: { ReturnValue(VarType.BOOLEAN) }
        IfCondition EqualTo(StringCompare(name, "GreaterThan"), 0) ThenBlock: { ReturnValue(VarType.BOOLEAN) }
        IfCondition EqualTo(StringCompare(name, "LessEqual"), 0) ThenBlock: { ReturnValue(VarType.BOOLEAN) }
        IfCondition EqualTo(StringCompare(name, "GreaterEqual"), 0) ThenBlock: { ReturnValue(VarType.BOOLEAN) }
        
        // Memory ops return Address
        IfCondition EqualTo(StringCompare(name, "Allocate"), 0) ThenBlock: { ReturnValue(VarType.ADDRESS) }
        IfCondition EqualTo(StringCompare(name, "StringConcat"), 0) ThenBlock: { ReturnValue(VarType.ADDRESS) }
        
        // String ops return Integer
        IfCondition EqualTo(StringCompare(name, "StringLength"), 0) ThenBlock: { ReturnValue(VarType.INTEGER) }
        IfCondition EqualTo(StringCompare(name, "StringCompare"), 0) ThenBlock: { ReturnValue(VarType.INTEGER) }
        
        ReturnValue(VarType.UNKNOWN)
    }
}

Function.Analyzer2.NodeToVarType {
    Input: type_node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(type_node, 0) ThenBlock: { ReturnValue(VarType.UNKNOWN) }
        
        type_kind = AST_GetType(type_node)
        
        IfCondition EqualTo(type_kind, AST.TYPE_INTEGER) ThenBlock: { ReturnValue(VarType.INTEGER) }
        IfCondition EqualTo(type_kind, AST.TYPE_ADDRESS) ThenBlock: { ReturnValue(VarType.ADDRESS) }
        IfCondition EqualTo(type_kind, AST.TYPE_TEXT) ThenBlock: { ReturnValue(VarType.STRING) }
        IfCondition EqualTo(type_kind, AST.TYPE_BOOLEAN) ThenBlock: { ReturnValue(VarType.BOOLEAN) }
        
        ReturnValue(VarType.UNKNOWN)
    }
}


// =============================================================================
// CLEANUP
// =============================================================================
Function.Analyzer2.Cleanup {
    Body: {
        IfCondition NotEqual(Analyzer2.warnings, 0) ThenBlock: {
            XArray.XDestroy(Analyzer2.warnings)
            Analyzer2.warnings = 0
        }
        IfCondition NotEqual(Analyzer2.hints, 0) ThenBlock: {
            XArray.XDestroy(Analyzer2.hints)
            Analyzer2.hints = 0
        }
        IfCondition NotEqual(Analyzer2.var_types, 0) ThenBlock: {
            XArray.XDestroy(Analyzer2.var_types)
            Analyzer2.var_types = 0
        }
        IfCondition NotEqual(Analyzer2.var_type_vals, 0) ThenBlock: {
            XArray.XDestroy(Analyzer2.var_type_vals)
            Analyzer2.var_type_vals = 0
        }
        IfCondition NotEqual(Analyzer2.func_names, 0) ThenBlock: {
            XArray.XDestroy(Analyzer2.func_names)
            Analyzer2.func_names = 0
        }
        IfCondition NotEqual(Analyzer2.func_param_counts, 0) ThenBlock: {
            XArray.XDestroy(Analyzer2.func_param_counts)
            Analyzer2.func_param_counts = 0
        }
        IfCondition NotEqual(Analyzer2.func_has_output, 0) ThenBlock: {
            XArray.XDestroy(Analyzer2.func_has_output)
            Analyzer2.func_has_output = 0
        }
        IfCondition NotEqual(Analyzer2.func_def_lines, 0) ThenBlock: {
            XArray.XDestroy(Analyzer2.func_def_lines)
            Analyzer2.func_def_lines = 0
        }
        IfCondition NotEqual(Analyzer2.possibly_null_vars, 0) ThenBlock: {
            XArray.XDestroy(Analyzer2.possibly_null_vars)
            Analyzer2.possibly_null_vars = 0
        }
        IfCondition NotEqual(Analyzer2.checked_null_vars, 0) ThenBlock: {
            XArray.XDestroy(Analyzer2.checked_null_vars)
            Analyzer2.checked_null_vars = 0
        }
        IfCondition NotEqual(Analyzer2.const_vars, 0) ThenBlock: {
            XArray.XDestroy(Analyzer2.const_vars)
            Analyzer2.const_vars = 0
        }
        IfCondition NotEqual(Analyzer2.const_values, 0) ThenBlock: {
            XArray.XDestroy(Analyzer2.const_values)
            Analyzer2.const_values = 0
        }
        
        Analyzer2.warning_count = 0
        Analyzer2.hint_count = 0
    }
}

// =============================================================================
// MAIN ENTRY POINT
// =============================================================================
Function.Analyzer2.Run {
    Input: ast: Address
    Output: Integer
    Body: {
        // PrintMessage("[DEBUG] Analyzer2.Init\n")
        Analyzer2.Init()
        
        // Pass 1: Collect function signatures
        // PrintMessage("[DEBUG] Analyzer2.CollectSignatures\n")
        Analyzer2.CollectSignatures(ast)
        
        // Pass 2: Walk and analyze
        // PrintMessage("[DEBUG] Analyzer2.WalkNode\n")
        Analyzer2.WalkNode(ast)
        
        ReturnValue(1)
    }
}

// === Inlined from Analyzer3 ===
// Library.Analyzer3.ailang
// Advanced Static Analysis - Data Flow, Shadowing, FixedPool Validation
// Complements Analyzer + Analyzer2
//
// Features:
//   - Read-before-write detection (uninitialized variable use)
//   - Variable shadowing detection (nested scope name collision)
//   - Loop variable modification warnings
//   - FixedPool member validation
//   - Recursive call cycle detection
//   - Dead assignment detection (assigned but overwritten before use)
//   - Double deallocation detection
//   - StringConcat leak detection (common pattern)


// =============================================================================
// ANALYZER3 STATE
// =============================================================================
FixedPool.Analyzer3 {
    // Scope tracking for shadowing
    "scope_stack": Initialize=0, CanChange=True      // XArray of scope markers
    "scope_vars": Initialize=0, CanChange=True       // XArray of [name, scope_level]
    "scope_depth": Initialize=0, CanChange=True
    
    // Read-before-write tracking
    "written_vars": Initialize=0, CanChange=True     // Vars that have been assigned
    "read_vars": Initialize=0, CanChange=True        // Vars that have been read
    "write_before_read": Initialize=0, CanChange=True // Vars written then read
    
    // Loop variable tracking
    "loop_vars": Initialize=0, CanChange=True        // Loop counter vars
    "loop_depth": Initialize=0, CanChange=True
    
    // FixedPool tracking
    "known_pools": Initialize=0, CanChange=True      // Pool names
    "pool_members": Initialize=0, CanChange=True     // Pool.member strings
    
    // Call graph for recursion
    "call_graph_from": Initialize=0, CanChange=True  // Caller function names
    "call_graph_to": Initialize=0, CanChange=True    // Callee function names
    "current_func": Initialize=0, CanChange=True
    
    // Dead assignment tracking
    "last_assign_var": Initialize=0, CanChange=True
    "last_assign_line": Initialize=0, CanChange=True
    "var_was_read": Initialize=0, CanChange=True     // Track if var read since assign
    
    // Double dealloc tracking
    "deallocated_vars": Initialize=0, CanChange=True
    "dealloc_warned_vars": Initialize=0, CanChange=True
    
    "loop_alloc_vars": Initialize=0, CanChange=True      // Vars that received allocations in current loop body
    "loop_alloc_lines": Initialize=0, CanChange=True     // Line numbers of those allocations
    "loop_alloc_funcs": Initialize=0, CanChange=True     // Which allocating function was called
    "loop_dealloc_vars": Initialize=0, CanChange=True    // Vars deallocated in current loop body
    "in_loop_body": Initialize=0, CanChange=True         // Nesting depth inside loops (>0 = in loop)
    "alloc_in_loop_warnings": Initialize=0, CanChange=True
    
    // Results
    "warnings": Initialize=0, CanChange=True
    "errors": Initialize=0, CanChange=True
    "warning_count": Initialize=0, CanChange=True
    "error_count": Initialize=0, CanChange=True
    
    // Stats
    "shadow_warnings": Initialize=0, CanChange=True
    "uninit_warnings": Initialize=0, CanChange=True
    "loop_mod_warnings": Initialize=0, CanChange=True
    "dead_assign_warnings": Initialize=0, CanChange=True
    "double_dealloc_warnings": Initialize=0, CanChange=True
    "concat_leak_warnings": Initialize=0, CanChange=True
    "recursive_cycles": Initialize=0, CanChange=True
    
    // Config
    "check_shadow": Initialize=0, CanChange=True
    "check_uninit": Initialize=1, CanChange=True
    "check_loop_mod": Initialize=1, CanChange=True
    "check_dead_assign": Initialize=1, CanChange=True
    "check_double_dealloc": Initialize=1, CanChange=True
    "check_concat_leaks": Initialize=1, CanChange=True
    "check_recursion": Initialize=1, CanChange=True
    "check_pools": Initialize=1, CanChange=True
    "verbose": Initialize=0, CanChange=True
}

// =============================================================================
// INITIALIZATION
// =============================================================================
Function.Analyzer3.Init {
    Body: {
        Analyzer3.warnings = XArray.XCreate(128)
        Analyzer3.errors = XArray.XCreate(32)
        Analyzer3.warning_count = 0
        Analyzer3.error_count = 0
        
        // Scope tracking
        Analyzer3.scope_stack = XArray.XCreate(32)
        Analyzer3.scope_vars = XArray.XCreate(128)
        Analyzer3.scope_depth = 0
        
        // Data flow
        Analyzer3.written_vars = XArray.XCreate(64)
        Analyzer3.read_vars = XArray.XCreate(64)
        Analyzer3.write_before_read = XArray.XCreate(64)
        
        // Loop vars
        Analyzer3.loop_vars = XArray.XCreate(16)
        Analyzer3.loop_depth = 0
        
        Analyzer3.loop_alloc_vars = XArray.XCreate(32)
        Analyzer3.loop_alloc_lines = XArray.XCreate(32)
        Analyzer3.loop_alloc_funcs = XArray.XCreate(32)
        Analyzer3.loop_dealloc_vars = XArray.XCreate(32)
        Analyzer3.dealloc_warned_vars = XArray.XCreate(32)
        Analyzer3.in_loop_body = 0
        Analyzer3.alloc_in_loop_warnings = 0


        // Pools
        Analyzer3.known_pools = XArray.XCreate(64)
        Analyzer3.pool_members = XArray.XCreate(256)
        
        // Call graph
        Analyzer3.call_graph_from = XArray.XCreate(256)
        Analyzer3.call_graph_to = XArray.XCreate(256)
        Analyzer3.current_func = 0
        
        // Dead assign
        Analyzer3.last_assign_var = XArray.XCreate(32)
        Analyzer3.last_assign_line = XArray.XCreate(32)
        Analyzer3.var_was_read = XArray.XCreate(32)
        
        // Double dealloc
        Analyzer3.deallocated_vars = XArray.XCreate(32)
        
        // Concat tracking (for long-running contexts)
        Analyzer3.concat_results = XArray.XCreate(32)
        Analyzer3.concat_in_loop = XArray.XCreate(32)
        Analyzer3.concat_lines = XArray.XCreate(32)
        Analyzer3.in_main_loop = 0
        Analyzer3.in_while_loop = 0
        Analyzer3.loop_concat_count = 0
        
        // Stats
        Analyzer3.shadow_warnings = 0
        Analyzer3.uninit_warnings = 0
        Analyzer3.loop_mod_warnings = 0
        Analyzer3.dead_assign_warnings = 0
        Analyzer3.double_dealloc_warnings = 0
        Analyzer3.concat_leak_warnings = 0
        Analyzer3.recursive_cycles = 0
        Analyzer3.last_valid_line = 0
    }
}

// =============================================================================
// DIAGNOSTICS
// =============================================================================
Function.Analyzer3.AddWarning {
    Input: msg: Address
    Body: {
        // Deduplicate
        count = XArray.XSize(Analyzer3.warnings)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = XArray.XGet(Analyzer3.warnings, i)
            IfCondition EqualTo(StringCompare(existing, msg), 0) ThenBlock: { ReturnValue(0) }
            i = Add(i, 1)
        }
        
        XArray.XPush(Analyzer3.warnings, msg)
        Analyzer3.warning_count = Add(Analyzer3.warning_count, 1)
    }
}

Function.Analyzer3.AddError {
    Input: msg: Address
    Body: {
        // Deduplicate
        count = XArray.XSize(Analyzer3.errors)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = XArray.XGet(Analyzer3.errors, i)
            IfCondition EqualTo(StringCompare(existing, msg), 0) ThenBlock: { ReturnValue(0) }
            i = Add(i, 1)
        }
        
        XArray.XPush(Analyzer3.errors, msg)
        Analyzer3.error_count = Add(Analyzer3.error_count, 1)
    }
}

// =============================================================================
// STRING HELPERS
// =============================================================================
Function.Analyzer3.StrEqual {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(a, 0) ThenBlock: {
            IfCondition EqualTo(b, 0) ThenBlock: { ReturnValue(1) }
            ReturnValue(0)
        }
        IfCondition EqualTo(b, 0) ThenBlock: { ReturnValue(0) }
        cmp = StringCompare(a, b)
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Analyzer3.ContainsDot {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        len = StringLength(name)
        i = 0
        WhileLoop LessThan(i, len) {
            ch = GetByte(name, i)
            IfCondition EqualTo(ch, 46) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Analyzer3.ExtractPoolName {
    Input: dotted_name: Address
    Output: Address
    Body: {
        IfCondition EqualTo(dotted_name, 0) ThenBlock: { ReturnValue(0) }
        len = StringLength(dotted_name)
        i = 0
        WhileLoop LessThan(i, len) {
            ch = GetByte(dotted_name, i)
            IfCondition EqualTo(ch, 46) ThenBlock: {
                // Return substring before dot
                result = Allocate(Add(i, 1))
                j = 0
                WhileLoop LessThan(j, i) {
                    SetByte(result, j, GetByte(dotted_name, j))
                    j = Add(j, 1)
                }
                SetByte(result, i, 0)
                ReturnValue(result)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// SCOPE MANAGEMENT
// =============================================================================
Function.Analyzer3.PushScope {
    Body: {
        // Record current var count as scope marker
        current_count = XArray.XSize(Analyzer3.scope_vars)
        XArray.XPush(Analyzer3.scope_stack, current_count)
        Analyzer3.scope_depth = Add(Analyzer3.scope_depth, 1)
    }
}

Function.Analyzer3.PopScope {
    Body: {
        IfCondition GreaterThan(Analyzer3.scope_depth, 0) ThenBlock: {
            Analyzer3.scope_depth = Subtract(Analyzer3.scope_depth, 1)
            
            // Get scope start marker
            marker = XArray.XGet(Analyzer3.scope_stack, Analyzer3.scope_depth)
            
            // Remove vars added in this scope
            current_count = XArray.XSize(Analyzer3.scope_vars)
            WhileLoop GreaterThan(current_count, marker) {
                XArray.XPop(Analyzer3.scope_vars)
                current_count = Subtract(current_count, 1)
            }
            
            XArray.XPop(Analyzer3.scope_stack)
        }
    }
}

Function.Analyzer3.TrackScopeVar {
    Input: name: Address
    Input: line: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        
        // Silence unused warning
        IfCondition EqualTo(line, 0) ThenBlock: { }
        
        // Check if variable is already tracked in ANY scope (current or outer)
        // If it exists, we treat this as an update/assignment, not a new declaration/shadowing
        count = XArray.XSize(Analyzer3.scope_vars)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = XArray.XGet(Analyzer3.scope_vars, i)
            IfCondition EqualTo(Analyzer3.StrEqual(existing, name), 1) ThenBlock: {
                ReturnValue(0) // Found, so it's an update
            }
            i = Add(i, 1)
        }
        
        // Not found in any scope, so it's a new declaration in the current scope
        XArray.XPush(Analyzer3.scope_vars, name)
    }
}

// =============================================================================
// DATA FLOW TRACKING
// =============================================================================
Function.Analyzer3.MarkWritten {
    Input: name: Address
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        
        // Check if already in list
        count = XArray.XSize(Analyzer3.written_vars)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = XArray.XGet(Analyzer3.written_vars, i)
            IfCondition EqualTo(Analyzer3.StrEqual(existing, name), 1) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        XArray.XPush(Analyzer3.written_vars, name)
    }
}

Function.Analyzer3.MarkRead {
    Input: name: Address
    Input: line: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        
        // Check if written
        was_written = 0
        count = XArray.XSize(Analyzer3.written_vars)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = XArray.XGet(Analyzer3.written_vars, i)
            IfCondition EqualTo(Analyzer3.StrEqual(existing, name), 1) ThenBlock: {
                was_written = 1
            }
            i = Add(i, 1)
        }
        
        // Check for uninitialized read
        IfCondition EqualTo(Analyzer3.check_uninit, 1) ThenBlock: {
            IfCondition EqualTo(was_written, 0) ThenBlock: {
                // Skip pool members (they're global)
                is_pool = Analyzer3.ContainsDot(name)
                IfCondition EqualTo(is_pool, 0) ThenBlock: {
                    // Skip common globals/builtins
                    is_builtin = Analyzer3.IsBuiltinOrGlobal(name)
                    IfCondition EqualTo(is_builtin, 0) ThenBlock: {
                        location = FileMap_Format(line)
                        msg = location
                        msg = StringConcat(msg, ": Variable '")
                        msg = StringConcat(msg, name)
                        msg = StringConcat(msg, "' may be used before initialization")
                        Analyzer3.AddWarning(msg)
                        Analyzer3.uninit_warnings = Add(Analyzer3.uninit_warnings, 1)
                    }
                }
            }
        }
        
        // Mark as read
        count = XArray.XSize(Analyzer3.read_vars)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = XArray.XGet(Analyzer3.read_vars, i)
            IfCondition EqualTo(Analyzer3.StrEqual(existing, name), 1) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        XArray.XPush(Analyzer3.read_vars, name)
    }
}

Function.Analyzer3.IsBuiltinOrGlobal {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        
        // Common globals
        IfCondition EqualTo(StringCompare(name, "True"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "False"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Null"), 0) ThenBlock: { ReturnValue(1) }
        
        ReturnValue(0)
    }
}

Function.Analyzer3.ClearDataFlow {
    Body: {
        XArray.XClear(Analyzer3.written_vars)
        XArray.XClear(Analyzer3.read_vars)
        XArray.XClear(Analyzer3.deallocated_vars)
        XArray.XClear(Analyzer3.dealloc_warned_vars)
        XArray.XClear(Analyzer3.last_assign_var)
        XArray.XClear(Analyzer3.last_assign_line)
        XArray.XClear(Analyzer3.var_was_read)
    }
}

// =============================================================================
// LOOP VARIABLE TRACKING
// =============================================================================
Function.Analyzer3.EnterLoop {
    Input: counter_var: Address
    Body: {
        Analyzer3.loop_depth = Add(Analyzer3.loop_depth, 1)
        IfCondition NotEqual(counter_var, 0) ThenBlock: {
            XArray.XPush(Analyzer3.loop_vars, counter_var)
        }
    }
}

Function.Analyzer3.ExitLoop {
    Body: {
        IfCondition GreaterThan(Analyzer3.loop_depth, 0) ThenBlock: {
            Analyzer3.loop_depth = Subtract(Analyzer3.loop_depth, 1)
            // Pop loop var if any
            count = XArray.XSize(Analyzer3.loop_vars)
            IfCondition GreaterThan(count, Analyzer3.loop_depth) ThenBlock: {
                XArray.XPop(Analyzer3.loop_vars)
            }
        }
    }
}

Function.Analyzer3.IsLoopVar {
    Input: name: Address
    Output: Integer
    Body: {
        count = XArray.XSize(Analyzer3.loop_vars)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = XArray.XGet(Analyzer3.loop_vars, i)
            IfCondition EqualTo(Analyzer3.StrEqual(existing, name), 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// CALL GRAPH TRACKING
// =============================================================================
Function.Analyzer3.RecordCall {
    Input: caller: Address
    Input: callee: Address
    Body: {
        IfCondition EqualTo(caller, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(callee, 0) ThenBlock: { ReturnValue(0) }
        
        XArray.XPush(Analyzer3.call_graph_from, caller)
        XArray.XPush(Analyzer3.call_graph_to, callee)
    }
}

FFunction.Analyzer3.DetectRecursiveCycles {
    Body: {
        IfCondition EqualTo(Analyzer3.check_recursion, 0) ThenBlock: { ReturnValue(0) }
        
        count = XArray.XSize(Analyzer3.call_graph_from)
        i = 0
        WhileLoop LessThan(i, count) {
            caller = XArray.XGet(Analyzer3.call_graph_from, i)
            callee = XArray.XGet(Analyzer3.call_graph_to, i)
            
            IfCondition EqualTo(Analyzer3.StrEqual(caller, callee), 1) ThenBlock: {
                Analyzer3.recursive_cycles = Add(Analyzer3.recursive_cycles, 1)
            }
            i = Add(i, 1)
        }
    }
}

// =============================================================================
// POOL TRACKING
// =============================================================================
Function.Analyzer3.RegisterPool {
    Input: pool_name: Address
    Body: {
        IfCondition EqualTo(pool_name, 0) ThenBlock: { ReturnValue(0) }
        XArray.XPush(Analyzer3.known_pools, pool_name)
    }
}

Function.Analyzer3.RegisterPoolMember {
    Input: full_name: Address
    Body: {
        IfCondition EqualTo(full_name, 0) ThenBlock: { ReturnValue(0) }
        XArray.XPush(Analyzer3.pool_members, full_name)
    }
}

Function.Analyzer3.IsKnownPoolMember {
    Input: name: Address
    Output: Integer
    Body: {
        count = XArray.XSize(Analyzer3.pool_members)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = XArray.XGet(Analyzer3.pool_members, i)
            IfCondition EqualTo(Analyzer3.StrEqual(existing, name), 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// DOUBLE DEALLOC TRACKING
// =============================================================================
Function.Analyzer3.RecordDealloc {
    Input: var_name: Address
    Input: line: Integer
    Body: {
        IfCondition EqualTo(var_name, 0) ThenBlock: { ReturnValue(0) }
        
        // Check if already deallocated
        IfCondition EqualTo(Analyzer3.check_double_dealloc, 1) ThenBlock: {
            count = XArray.XSize(Analyzer3.deallocated_vars)
            i = 0
            WhileLoop LessThan(i, count) {
                existing = XArray.XGet(Analyzer3.deallocated_vars, i)
                IfCondition EqualTo(Analyzer3.StrEqual(existing, var_name), 1) ThenBlock: {
                    location = FileMap_Format(line)
                    msg = location
                    msg = StringConcat(msg, ": Potential double deallocation of '")
                    msg = StringConcat(msg, var_name)
                    msg = StringConcat(msg, "'")
                    IfCondition NotEqual(Analyzer3.current_func, 0) ThenBlock: {
                        msg = StringConcat(msg, " in '")
                        msg = StringConcat(msg, Analyzer3.current_func)
                        msg = StringConcat(msg, "'")
                    }
                    Analyzer3.AddWarning(msg)
                    Analyzer3.double_dealloc_warnings = Add(Analyzer3.double_dealloc_warnings, 1)
                    ReturnValue(0)
                }
                i = Add(i, 1)
            }
        }
        
        XArray.XPush(Analyzer3.deallocated_vars, var_name)
    }
}

Function.Analyzer3.RemoveDealloc {
    Input: var_name: Address
    Body: {
        IfCondition EqualTo(var_name, 0) ThenBlock: { ReturnValue(0) }
        
        count = XArray.XSize(Analyzer3.deallocated_vars)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = XArray.XGet(Analyzer3.deallocated_vars, i)
            IfCondition EqualTo(Analyzer3.StrEqual(existing, var_name), 1) ThenBlock: {
                // Found it. Swap with last and pop to remove.
                last_idx = Subtract(count, 1)
                XArray.XSwap(Analyzer3.deallocated_vars, i, last_idx)
                XArray.XPop(Analyzer3.deallocated_vars)
                // Stop (assuming unique entries)
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
    }
}



// =============================================================================
// PASS 1: COLLECT POOLS
// =============================================================================
Function.Analyzer3.CollectPools {
    Input: node: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        
        node_type = AST_GetType(node)
        
        // FixedPool declaration
        IfCondition EqualTo(node_type, AST.POOL_FIXED) ThenBlock: {
            pool_name = AST_GetData1(node)
            Analyzer3.RegisterPool(pool_name)
            
            // Collect members
            child_count = AST_GetChildCount(node)
            i = 0
            WhileLoop LessThan(i, child_count) {
                child = AST_GetChild(node, i)
                IfCondition NotEqual(child, 0) ThenBlock: {
                    child_type = AST_GetType(child)
                    IfCondition EqualTo(child_type, AST.POOL_MEMBER) ThenBlock: {
                        member_name = AST_GetData1(child)
                        IfCondition NotEqual(member_name, 0) ThenBlock: {
                            // Build full name Pool.member
                            full = StringConcat(pool_name, ".")
                            full = StringConcat(full, member_name)
                            Analyzer3.RegisterPoolMember(full)
                        }
                    }
                }
                i = Add(i, 1)
            }
        }
        
        // DynamicPool
        IfCondition EqualTo(node_type, AST.POOL_DYNAMIC) ThenBlock: {
            pool_name = AST_GetData1(node)
            Analyzer3.RegisterPool(pool_name)
        }
        
        // Recurse
        child_count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, child_count) {
            child = AST_GetChild(node, i)
            Analyzer3.CollectPools(child)
            i = Add(i, 1)
        }
    }
}

// =============================================================================
// MAIN WALK
// =============================================================================
Function.Analyzer3.WalkNode {
    Input: node: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        
        node_type = AST_GetType(node)
        node_line = AST_GetLine(node)
        
        // Fix for "Line 0" issues: propagate last known valid line
        IfCondition GreaterThan(node_line, 0) ThenBlock: {
            Analyzer3.last_valid_line = node_line
        } ElseBlock: {
            node_line = Analyzer3.last_valid_line
        }
        
        // === FUNCTION ENTRY ===
        IfCondition EqualTo(node_type, AST.FUNCTION) ThenBlock: {
            Analyzer3.current_func = AST_GetData1(node)
            Analyzer3.ClearDataFlow()
            Analyzer3.PushScope()
            
            // Mark parameters as written
            child_count = AST_GetChildCount(node)
            i = 0
            WhileLoop LessThan(i, child_count) {
                child = AST_GetChild(node, i)
                IfCondition NotEqual(child, 0) ThenBlock: {
                    child_type = AST_GetType(child)
                    IfCondition EqualTo(child_type, AST.PARAMETER) ThenBlock: {
                        param_name = AST_GetData1(child)
                        Analyzer3.MarkWritten(param_name)
                        Analyzer3.TrackScopeVar(param_name, node_line)
                    }
                }
                i = Add(i, 1)
            }
            
            Analyzer3.WalkChildren(node)
            
            
            Analyzer3.PopScope()
            Analyzer3.current_func = 0
            ReturnValue(0)
        }
        
        // === SUBROUTINE ===
        IfCondition EqualTo(node_type, AST.SUBROUTINE) ThenBlock: {
            Analyzer3.current_func = AST_GetData1(node)
            Analyzer3.ClearDataFlow()
            Analyzer3.PushScope()
            
            Analyzer3.WalkChildren(node)
          
            
            Analyzer3.PopScope()
            Analyzer3.current_func = 0
            ReturnValue(0)
        }
        
        // === BLOCK/BODY - new scope ===
        IfCondition EqualTo(node_type, AST.BLOCK) ThenBlock: {
            Analyzer3.PushScope()
            Analyzer3.WalkChildren(node)
            Analyzer3.PopScope()
            ReturnValue(0)
        }
        
        IfCondition EqualTo(node_type, AST.BODY) ThenBlock: {
            Analyzer3.PushScope()
            Analyzer3.WalkChildren(node)
            Analyzer3.PopScope()
            ReturnValue(0)
        }
        
        // === IF CONDITION (Branching Analysis) ===
        IfCondition EqualTo(node_type, AST.IF) ThenBlock: {
            child_count = AST_GetChildCount(node)
            
            // 1. Analyze Condition
            IfCondition GreaterThan(child_count, 0) ThenBlock: {
                cond = AST_GetChild(node, 0)
                Analyzer3.WalkNode(cond)
            }
            
            // Snapshot state before branches
            start_dealloc_count = XArray.XSize(Analyzer3.deallocated_vars)
            
            // 2. Analyze Then Block
            IfCondition GreaterThan(child_count, 1) ThenBlock: {
                then_block = AST_GetChild(node, 1)
                Analyzer3.WalkNode(then_block)
            }
            
            // Snapshot Then state and isolate for Else
            end_then_count = XArray.XSize(Analyzer3.deallocated_vars)
            temp_storage = XArray.XCreate(16)
            
            // Pop Then-deallocs to temp storage so Else doesn't see them
            count_to_move = Subtract(end_then_count, start_dealloc_count)
            i = 0
            WhileLoop LessThan(i, count_to_move) {
                item = XArray.XPop(Analyzer3.deallocated_vars)
                XArray.XPush(temp_storage, item)
                i = Add(i, 1)
            }
            
            // 3. Analyze Else Block (if exists)
            IfCondition GreaterThan(child_count, 2) ThenBlock: {
                else_block = AST_GetChild(node, 2)
                Analyzer3.WalkNode(else_block)
            }
            
            // 4. Merge States (Union)
            // Restore Then-deallocs so subsequent code sees deallocs from both paths
            count_temp = XArray.XSize(temp_storage)
            i = 0
            WhileLoop LessThan(i, count_temp) {
                item = XArray.XPop(temp_storage)
                XArray.XPush(Analyzer3.deallocated_vars, item)
                i = Add(i, 1)
            }
            XArray.XDestroy(temp_storage)
            
            ReturnValue(0)
        }
        
        // === WHILE LOOP ===
        IfCondition EqualTo(node_type, AST.WHILE) ThenBlock: {
            Analyzer3.in_loop_body = Add(Analyzer3.in_loop_body, 1)
            
            // Save outer loop's alloc tracking (for nested loops)
            saved_alloc_count = XArray.XSize(Analyzer3.loop_alloc_vars)
            saved_dealloc_count = XArray.XSize(Analyzer3.loop_dealloc_vars)
            
            // Clear for this loop body
            XArray.XClear(Analyzer3.loop_alloc_vars)
            XArray.XClear(Analyzer3.loop_alloc_lines)
            XArray.XClear(Analyzer3.loop_alloc_funcs)
            XArray.XClear(Analyzer3.loop_dealloc_vars)
            
            loop_var = 0
            Analyzer3.EnterLoop(loop_var)
            Analyzer3.WalkChildren(node)
            
            // Check alloc balance before exiting loop context
            Analyzer3.CheckLoopAllocBalance()
            
            Analyzer3.ExitLoop()
            Analyzer3.in_loop_body = Subtract(Analyzer3.in_loop_body, 1)
            
            // Restore outer tracking (clear inner, outer state was consumed)
            XArray.XClear(Analyzer3.loop_alloc_vars)
            XArray.XClear(Analyzer3.loop_alloc_lines)
            XArray.XClear(Analyzer3.loop_alloc_funcs)
            XArray.XClear(Analyzer3.loop_dealloc_vars)
            
            ReturnValue(0)
        }
        
        // === LOOP MAIN (long-running server pattern) ===
        IfCondition EqualTo(node_type, AST.LOOP_MAIN) ThenBlock: {
            Analyzer3.in_main_loop = 1
            Analyzer3.WalkChildren(node)
            Analyzer3.in_main_loop = 0
            ReturnValue(0)
        }
        
        // === FOR LOOP ===
        IfCondition EqualTo(node_type, AST.FOR_EVERY) ThenBlock: {
            loop_var = AST_GetData1(node)
            Analyzer3.EnterLoop(loop_var)
            Analyzer3.MarkWritten(loop_var)  // Loop var is implicitly assigned
            Analyzer3.WalkChildren(node)
            Analyzer3.ExitLoop()
            ReturnValue(0)
        }
        
        // === ASSIGNMENT ===
        IfCondition EqualTo(node_type, AST.ASSIGNMENT) ThenBlock: {
            target = AST_GetData1(node)
            
            // NEW: Variable is being reassigned, so it is no longer "deallocated"
            Analyzer3.RemoveDealloc(target)
            
            // Check for loop variable modification
            IfCondition EqualTo(Analyzer3.check_loop_mod, 1) ThenBlock: {
                IfCondition GreaterThan(Analyzer3.loop_depth, 0) ThenBlock: {
                    IfCondition EqualTo(Analyzer3.IsLoopVar(target), 1) ThenBlock: {
                        // Check if it's the expected increment pattern
                        // For now, just warn
                        child_count = AST_GetChildCount(node)
                        IfCondition GreaterThan(child_count, 0) ThenBlock: {
                            rhs = AST_GetChild(node, 0)
                            is_increment = Analyzer3.IsIncrementPattern(target, rhs)
                            IfCondition EqualTo(is_increment, 0) ThenBlock: {
                                location = FileMap_Format(node_line)
                                msg = location
                                msg = StringConcat(msg, ": Loop variable '")
                                msg = StringConcat(msg, target)
                                msg = StringConcat(msg, "' modified in unexpected way")
                                Analyzer3.AddWarning(msg)
                                Analyzer3.loop_mod_warnings = Add(Analyzer3.loop_mod_warnings, 1)
                            }
                        }
                    }
                }
            }
            

           // Check for allocation in loop
            child_count = AST_GetChildCount(node)
            IfCondition GreaterThan(child_count, 0) ThenBlock: {
                rhs = AST_GetChild(node, 0)
                IfCondition NotEqual(rhs, 0) ThenBlock: {
                    IfCondition EqualTo(AST_GetType(rhs), AST.CALL) ThenBlock: {
                        func_name = AST_GetData1(rhs)
                        IfCondition NotEqual(func_name, 0) ThenBlock: {
                            // Track allocations inside loop bodies
                            IfCondition GreaterThan(Analyzer3.in_loop_body, 0) ThenBlock: {
                                IfCondition EqualTo(Analyzer3.IsAllocatingFunc(func_name), 1) ThenBlock: {
                                    XArray.XPush(Analyzer3.loop_alloc_vars, target)
                                    XArray.XPush(Analyzer3.loop_alloc_lines, node_line)
                                    XArray.XPush(Analyzer3.loop_alloc_funcs, func_name)
                                }
                            }
                        }
                    }
                }
                
                // Walk RHS first (read before write)
                Analyzer3.WalkNode(rhs)
            }


            // Mark written and add to scope
            Analyzer3.MarkWritten(target)
            Analyzer3.TrackScopeVar(target, node_line)
            ReturnValue(0)
        }
        
        // === IDENTIFIER (read) ===
        IfCondition EqualTo(node_type, AST.IDENTIFIER) ThenBlock: {
            name = AST_GetData1(node)
            Analyzer3.MarkRead(name, node_line)
            ReturnValue(0)
        }
        
        // === FUNCTION CALL ===
        IfCondition EqualTo(node_type, AST.CALL) ThenBlock: {
            func_name = AST_GetData1(node)
            
            // Record in call graph
            Analyzer3.RecordCall(Analyzer3.current_func, func_name)
            
            IfCondition EqualTo(StringCompare(func_name, "Deallocate"), 0) ThenBlock: {
                IfCondition GreaterThan(child_count, 0) ThenBlock: {
                    dealloc_arg = AST_GetChild(node, 0)
                    IfCondition NotEqual(dealloc_arg, 0) ThenBlock: {
                        IfCondition EqualTo(AST_GetType(dealloc_arg), AST.IDENTIFIER) ThenBlock: {
                            dealloc_name = AST_GetData1(dealloc_arg)
                            Analyzer3.RecordDealloc(dealloc_name, node_line)
                            
                            // Track deallocation inside loop bodies
                            IfCondition GreaterThan(Analyzer3.in_loop_body, 0) ThenBlock: {
                                XArray.XPush(Analyzer3.loop_dealloc_vars, dealloc_name)
                            }
                        }
                    }
                }
            }
            
            Analyzer3.WalkChildren(node)
            ReturnValue(0)
        }
        
        // === DEFAULT: recurse ===
        Analyzer3.WalkChildren(node)
    }
}

Function.Analyzer3.WalkChildren {
    Input: node: Address
    Body: {
        child_count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, child_count) {
            child = AST_GetChild(node, i)
            Analyzer3.WalkNode(child)
            i = Add(i, 1)
        }
    }
}

// =============================================================================
// HELPERS
// =============================================================================
Function.Analyzer3.ExtractLoopVar {
    Input: cond: Address
    Output: Address
    Body: {
        // Look for LessThan(var, ...) or similar patterns
        IfCondition EqualTo(cond, 0) ThenBlock: { ReturnValue(0) }
        
        cond_type = AST_GetType(cond)
        IfCondition EqualTo(cond_type, AST.CALL) ThenBlock: {
            func_name = AST_GetData1(cond)
            IfCondition EqualTo(func_name, 0) ThenBlock: { ReturnValue(0) }
            
            // Check for comparison functions
            is_cmp = 0
            IfCondition EqualTo(StringCompare(func_name, "LessThan"), 0) ThenBlock: { is_cmp = 1 }
            IfCondition EqualTo(StringCompare(func_name, "LessEqual"), 0) ThenBlock: { is_cmp = 1 }
            IfCondition EqualTo(StringCompare(func_name, "GreaterThan"), 0) ThenBlock: { is_cmp = 1 }
            IfCondition EqualTo(StringCompare(func_name, "GreaterEqual"), 0) ThenBlock: { is_cmp = 1 }
            IfCondition EqualTo(StringCompare(func_name, "NotEqual"), 0) ThenBlock: { is_cmp = 1 }
            
            IfCondition EqualTo(is_cmp, 1) ThenBlock: {
                child_count = AST_GetChildCount(cond)
                IfCondition GreaterThan(child_count, 0) ThenBlock: {
                    first_arg = AST_GetChild(cond, 0)
                    IfCondition NotEqual(first_arg, 0) ThenBlock: {
                        IfCondition EqualTo(AST_GetType(first_arg), AST.IDENTIFIER) ThenBlock: {
                            ReturnValue(AST_GetData1(first_arg))
                        }
                    }
                }
            }
        }
        
        ReturnValue(0)
    }
}

Function.Analyzer3.IsIncrementPattern {
    Input: var_name: Address
    Input: rhs: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(rhs, 0) ThenBlock: { ReturnValue(0) }
        
        rhs_type = AST_GetType(rhs)
        IfCondition NotEqual(rhs_type, AST.CALL) ThenBlock: { ReturnValue(0) }
        
        func_name = AST_GetData1(rhs)
        IfCondition EqualTo(func_name, 0) ThenBlock: { ReturnValue(0) }
        
        // Counter increment/decrement: var = Add(var, N) or Subtract(var, N)
        is_add = StringCompare(func_name, "Add")
        is_sub = StringCompare(func_name, "Subtract")
        IfCondition Or(EqualTo(is_add, 0), EqualTo(is_sub, 0)) ThenBlock: {
            ReturnValue(Analyzer3.FirstArgMatches(var_name, rhs))
        }
        
        // Numeric convergence: Divide, Multiply, Modulo
        IfCondition EqualTo(StringCompare(func_name, "Divide"), 0) ThenBlock: {
            ReturnValue(Analyzer3.FirstArgMatches(var_name, rhs))
        }
        IfCondition EqualTo(StringCompare(func_name, "Multiply"), 0) ThenBlock: {
            ReturnValue(Analyzer3.FirstArgMatches(var_name, rhs))
        }
        IfCondition EqualTo(StringCompare(func_name, "Modulo"), 0) ThenBlock: {
            ReturnValue(Analyzer3.FirstArgMatches(var_name, rhs))
        }
        
        // Linked list traversal: var = Dereference(...)
        IfCondition EqualTo(StringCompare(func_name, "Dereference"), 0) ThenBlock: {
            ReturnValue(1)
        }
        
        // Byte scanning: var = GetByte(...)
        IfCondition EqualTo(StringCompare(func_name, "GetByte"), 0) ThenBlock: {
            ReturnValue(1)
        }
        
        // Bit scanning: RightShift(var, N), LeftShift(var, N)
        IfCondition EqualTo(StringCompare(func_name, "RightShift"), 0) ThenBlock: {
            ReturnValue(Analyzer3.FirstArgMatches(var_name, rhs))
        }
        IfCondition EqualTo(StringCompare(func_name, "LeftShift"), 0) ThenBlock: {
            ReturnValue(Analyzer3.FirstArgMatches(var_name, rhs))
        }
        
        ReturnValue(0)
    }
}


Function.Analyzer3.FirstArgMatches {
    Input: var_name: Address
    Input: call_node: Address
    Output: Integer
    Body: {
        child_count = AST_GetChildCount(call_node)
        IfCondition GreaterThan(child_count, 0) ThenBlock: {
            first_arg = AST_GetChild(call_node, 0)
            IfCondition NotEqual(first_arg, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(first_arg), AST.IDENTIFIER) ThenBlock: {
                    arg_name = AST_GetData1(first_arg)
                    IfCondition EqualTo(Analyzer3.StrEqual(arg_name, var_name), 1) ThenBlock: {
                        ReturnValue(1)
                    }
                }
            }
        }
        ReturnValue(0)
    }
}


Function.Analyzer3.IsArenaManaged {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        
        IfCondition EqualTo(StringCompare(name, "StringConcat"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "NumberToString"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "StringCopy"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "StringSubstring"), 0) ThenBlock: { ReturnValue(1) }
        
        ReturnValue(0)
    }
}

Function.Analyzer3.IsAllocatingFunc {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        
        IfCondition EqualTo(StringCompare(name, "Allocate"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "StringConcat"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "NumberToString"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "XArray.XCreate"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "ArrayCreate"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "StringCopy"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "StringSubstring"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "ReadFile"), 0) ThenBlock: { ReturnValue(1) }
        
        ReturnValue(0)
    }
}


Function.Analyzer3.CheckLoopAllocBalance {
    Body: {
        count = XArray.XSize(Analyzer3.loop_alloc_vars)
        i = 0
        WhileLoop LessThan(i, count) {
            var_name = XArray.XGet(Analyzer3.loop_alloc_vars, i)
            
            was_freed = 0
            dcount = XArray.XSize(Analyzer3.loop_dealloc_vars)
            di = 0
            WhileLoop LessThan(di, dcount) {
                dvar = XArray.XGet(Analyzer3.loop_dealloc_vars, di)
                IfCondition EqualTo(Analyzer3.StrEqual(dvar, var_name), 1) ThenBlock: {
                    was_freed = 1
                }
                di = Add(di, 1)
            }
            
            IfCondition EqualTo(was_freed, 0) ThenBlock: {
                line = XArray.XGet(Analyzer3.loop_alloc_lines, i)
                alloc_func = XArray.XGet(Analyzer3.loop_alloc_funcs, i)
                
                location = FileMap_Format(line)
                msg = location
                
                is_arena = Analyzer3.IsArenaManaged(alloc_func)
                IfCondition EqualTo(is_arena, 1) ThenBlock: {
                    msg = StringConcat(msg, ": Arena alloc in loop ('")
                } ElseBlock: {
                    msg = StringConcat(msg, ": Allocation in loop ('")
                }
                
                IfCondition NotEqual(var_name, 0) ThenBlock: {
                    msg = StringConcat(msg, var_name)
                }
                msg = StringConcat(msg, "' via ")
                IfCondition NotEqual(alloc_func, 0) ThenBlock: {
                    msg = StringConcat(msg, alloc_func)
                }
                
                IfCondition EqualTo(is_arena, 1) ThenBlock: {
                    msg = StringConcat(msg, ") grows arena each iteration — safe for batch, concern for long-running")
                } ElseBlock: {
                    msg = StringConcat(msg, ") not freed before next iteration — memory leak")
                }
                
                IfCondition NotEqual(Analyzer3.current_func, 0) ThenBlock: {
                    msg = StringConcat(msg, " in '")
                    msg = StringConcat(msg, Analyzer3.current_func)
                    msg = StringConcat(msg, "'")
                }
                Analyzer3.AddWarning(msg)
                Analyzer3.alloc_in_loop_warnings = Add(Analyzer3.alloc_in_loop_warnings, 1)
            }
            
            i = Add(i, 1)
        }
    }
}


// =============================================================================
// CLEANUP
// =============================================================================
Function.Analyzer3.Cleanup {
    Body: {
        IfCondition NotEqual(Analyzer3.warnings, 0) ThenBlock: {
            XArray.XDestroy(Analyzer3.warnings)
            Analyzer3.warnings = 0
        }
        IfCondition NotEqual(Analyzer3.errors, 0) ThenBlock: {
            XArray.XDestroy(Analyzer3.errors)
            Analyzer3.errors = 0
        }
        IfCondition NotEqual(Analyzer3.scope_stack, 0) ThenBlock: {
            XArray.XDestroy(Analyzer3.scope_stack)
            Analyzer3.scope_stack = 0
        }
        IfCondition NotEqual(Analyzer3.scope_vars, 0) ThenBlock: {
            XArray.XDestroy(Analyzer3.scope_vars)
            Analyzer3.scope_vars = 0
        }
        IfCondition NotEqual(Analyzer3.written_vars, 0) ThenBlock: {
            XArray.XDestroy(Analyzer3.written_vars)
            Analyzer3.written_vars = 0
        }
        IfCondition NotEqual(Analyzer3.read_vars, 0) ThenBlock: {
            XArray.XDestroy(Analyzer3.read_vars)
            Analyzer3.read_vars = 0
        }
        IfCondition NotEqual(Analyzer3.write_before_read, 0) ThenBlock: {
            XArray.XDestroy(Analyzer3.write_before_read)
            Analyzer3.write_before_read = 0
        }
        IfCondition NotEqual(Analyzer3.loop_vars, 0) ThenBlock: {
            XArray.XDestroy(Analyzer3.loop_vars)
            Analyzer3.loop_vars = 0
        }
        IfCondition NotEqual(Analyzer3.known_pools, 0) ThenBlock: {
            XArray.XDestroy(Analyzer3.known_pools)
            Analyzer3.known_pools = 0
        }
        IfCondition NotEqual(Analyzer3.pool_members, 0) ThenBlock: {
            XArray.XDestroy(Analyzer3.pool_members)
            Analyzer3.pool_members = 0
        }
        IfCondition NotEqual(Analyzer3.call_graph_from, 0) ThenBlock: {
            XArray.XDestroy(Analyzer3.call_graph_from)
            Analyzer3.call_graph_from = 0
        }
        IfCondition NotEqual(Analyzer3.call_graph_to, 0) ThenBlock: {
            XArray.XDestroy(Analyzer3.call_graph_to)
            Analyzer3.call_graph_to = 0
        }
        IfCondition NotEqual(Analyzer3.deallocated_vars, 0) ThenBlock: {
            XArray.XDestroy(Analyzer3.deallocated_vars)
            Analyzer3.deallocated_vars = 0
        }
        IfCondition NotEqual(Analyzer3.last_assign_var, 0) ThenBlock: {
            XArray.XDestroy(Analyzer3.last_assign_var)
            Analyzer3.last_assign_var = 0
        }
        IfCondition NotEqual(Analyzer3.last_assign_line, 0) ThenBlock: {
            XArray.XDestroy(Analyzer3.last_assign_line)
            Analyzer3.last_assign_line = 0
        }
        IfCondition NotEqual(Analyzer3.var_was_read, 0) ThenBlock: {
            XArray.XDestroy(Analyzer3.var_was_read)
            Analyzer3.var_was_read = 0
        }
        
         IfCondition NotEqual(Analyzer3.loop_alloc_vars, 0) ThenBlock: {
            XArray.XDestroy(Analyzer3.loop_alloc_vars)
            Analyzer3.loop_alloc_vars = 0
        }
        IfCondition NotEqual(Analyzer3.loop_alloc_lines, 0) ThenBlock: {
            XArray.XDestroy(Analyzer3.loop_alloc_lines)
            Analyzer3.loop_alloc_lines = 0
        }
        IfCondition NotEqual(Analyzer3.loop_alloc_funcs, 0) ThenBlock: {
            XArray.XDestroy(Analyzer3.loop_alloc_funcs)
            Analyzer3.loop_alloc_funcs = 0
        }
        IfCondition NotEqual(Analyzer3.loop_dealloc_vars, 0) ThenBlock: {
            XArray.XDestroy(Analyzer3.loop_dealloc_vars)
            Analyzer3.loop_dealloc_vars = 0
        }
        IfCondition NotEqual(Analyzer3.dealloc_warned_vars, 0) ThenBlock: {
            XArray.XDestroy(Analyzer3.dealloc_warned_vars)
            Analyzer3.dealloc_warned_vars = 0
        }

        Analyzer3.warning_count = 0
        Analyzer3.error_count = 0
    }
}

// =============================================================================
// MAIN ENTRY POINT
// =============================================================================
Function.Analyzer3.Run {
    Input: ast: Address
    Output: Integer
    Body: {
        Analyzer3.Init()
        
        // Pass 1: Collect pool definitions
        Analyzer3.CollectPools(ast)
        
        // Pass 2: Walk and analyze
        Analyzer3.WalkNode(ast)
        
        // Post-analysis: Check for recursive cycles
        Analyzer3.DetectRecursiveCycles()
        
        ReturnValue(1)
    }
}

// === Main module ===
// ailang_analyzer.ailang
// Standalone Code Analysis CLI for AILang
// Compiles to: analyzer.x
//
// Usage: ./analyzer.x <filename>
//
// Runs all 3 analysis passes and prints unified report.
// Exit code: 0 = clean, 1 = warnings only, 2 = errors found
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL).

// =============================================================================
// IMPORTS - Frontend only, no compiler backend
// =============================================================================

// Frontend - Lexer

// Frontend - Parser

// Frontend - AST

// Import resolution

// Analysis passes

// =============================================================================
// CLI STATE
// =============================================================================
FixedPool.ACli {
    "filename": Initialize=0, CanChange=True
    "filter": Initialize=0, CanChange=True
    "source": Initialize=0, CanChange=True
    "source_len": Initialize=0, CanChange=True
    "resolved": Initialize=0, CanChange=True
    "ast": Initialize=0, CanChange=True
}

// =============================================================================
// FILE LOADING
// =============================================================================
Function.ACli.LoadFile {
    Input: filename: Address
    Output: Address
    Body: {
        fd = SystemCall(2, filename, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        size = SystemCall(8, fd, 0, 2)
        SystemCall(8, fd, 0, 0)
        
        IfCondition LessEqual(size, 0) ThenBlock: {
            SystemCall(3, fd)
            ReturnValue(0)
        }
        
        buffer = Allocate(Add(size, 1))
        IfCondition EqualTo(buffer, 0) ThenBlock: {
            SystemCall(3, fd)
            ReturnValue(0)
        }
        
        bytes_read = SystemCall(0, fd, buffer, size)
        SystemCall(3, fd)
        
        IfCondition LessThan(bytes_read, 0) ThenBlock: {
            Deallocate(buffer, Add(size, 1))
            ReturnValue(0)
        }
        
        SetByte(buffer, bytes_read, 0)
        ReturnValue(buffer)
    }
}

// =============================================================================
// ARG PARSING - reads /proc/self/cmdline by index (1-based)
// =============================================================================
Function.ACli.GetArg {
    Input: target_index: Integer
    Output: Address
    Body: {
        cmdline_path = "/proc/self/cmdline"
        fd = SystemCall(2, cmdline_path, 0, 0)
        
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        buffer = Allocate(4096)
        bytes_read = SystemCall(0, fd, buffer, 4096)
        SystemCall(3, fd)
        
        IfCondition LessEqual(bytes_read, 0) ThenBlock: {
            Deallocate(buffer, 4096)
            ReturnValue(0)
        }
        
        // Scan for the Nth argument
        current_arg = 0
        offset = 0
        
        // Loop to skip args until we reach target_index
        WhileLoop LessThan(current_arg, target_index) {
            // Scan to next null terminator
            WhileLoop LessThan(offset, bytes_read) {
                ch = GetByte(buffer, offset)
                offset = Add(offset, 1)
                IfCondition EqualTo(ch, 0) ThenBlock: {
                    BreakLoop
                }
            }
            current_arg = Add(current_arg, 1)
        }
        
        // Check if we went past the end
        IfCondition GreaterEqual(offset, bytes_read) ThenBlock: {
            Deallocate(buffer, 4096)
            ReturnValue(0)
        }
        
        // Now offset points to the start of the desired argument
        // Calculate length
        start_pos = offset
        len = 0
        WhileLoop LessThan(offset, bytes_read) {
            ch = GetByte(buffer, offset)
            IfCondition EqualTo(ch, 0) ThenBlock: {
                BreakLoop
            }
            len = Add(len, 1)
            offset = Add(offset, 1)
        }
        
        IfCondition EqualTo(len, 0) ThenBlock: {
            Deallocate(buffer, 4096)
            ReturnValue(0)
        }
        
        // Allocate and copy
        arg_str = Allocate(Add(len, 1))
        i = 0
        WhileLoop LessThan(i, len) {
            ch = GetByte(buffer, Add(start_pos, i))
            SetByte(arg_str, i, ch)
            i = Add(i, 1)
        }
        SetByte(arg_str, len, 0)
        
        Deallocate(buffer, 4096)
        ReturnValue(arg_str)
    }
}

// =============================================================================
// UNIFIED REPORT - reads from all 3 passes
// =============================================================================
Function.ACli.Report {
    Body: {
        PrintMessage("\n")
        PrintMessage("========================================\n")
        PrintMessage("        Code Analysis Report\n")
        PrintMessage("========================================\n")
        PrintMessage("  File: ")
        PrintMessage(ACli.filename)
        PrintMessage("\n")
        PrintMessage("========================================\n\n")
        
        // --- Pass 1: Memory & Structure ---
        PrintMessage("--- Memory & Structure ---\n")
        PrintMessage("Functions analyzed: ")
        PrintNumber(Analyzer.functions_analyzed)
        PrintMessage("\n")
        PrintMessage("SubRoutines analyzed: ")
        PrintNumber(Analyzer.subroutines_analyzed)
        PrintMessage("\n")
        PrintMessage("Functions defined: ")
        PrintNumber(XArray.XSize(Analyzer.defined_funcs))
        PrintMessage("\n")
        PrintMessage("Functions called: ")
        PrintNumber(XArray.XSize(Analyzer.called_funcs))
        PrintMessage("\n")
        PrintMessage("Allocate() calls: ")
        PrintNumber(Analyzer.total_allocs)
        PrintMessage("\n")
        PrintMessage("Deallocate() calls: ")
        PrintNumber(Analyzer.total_deallocs)
        PrintMessage("\n")
        PrintMessage("Max nesting depth: ")
        PrintNumber(Analyzer.max_block_depth)
        IfCondition NotEqual(Analyzer.max_depth_func, 0) ThenBlock: {
            PrintMessage(" (in '")
            PrintMessage(Analyzer.max_depth_func)
            PrintMessage("')")
        }
        PrintMessage("\n")
        
        // --- Pass 2: Control Flow ---
        PrintMessage("\n--- Control Flow ---\n")
        PrintMessage("Unreachable code: ")
        PrintNumber(Analyzer2.unreachable_warnings)
        PrintMessage("\n")
        PrintMessage("Infinite loops: ")
        PrintNumber(Analyzer2.infinite_loop_warnings)
        PrintMessage("\n")
        PrintMessage("Missing else: ")
        PrintNumber(Analyzer2.missing_else_warnings)
        PrintMessage("\n")
        PrintMessage("Functions registered: ")
        PrintNumber(XArray.XSize(Analyzer2.func_names))
        PrintMessage("\n")
        
        // --- Pass 3: Data Flow ---
        PrintMessage("\n--- Data Flow ---\n")
        PrintMessage("Uninitialized vars: ")
        PrintNumber(Analyzer3.uninit_warnings)
        PrintMessage("\n")
        PrintMessage("Dead assignments: ")
        PrintNumber(Analyzer3.dead_assign_warnings)
        PrintMessage("\n")
        PrintMessage("Double dealloc: ")
        PrintNumber(Analyzer3.double_dealloc_warnings)
        PrintMessage("\n")
        PrintMessage("StringConcat in loops: ")
        PrintNumber(Analyzer3.concat_leak_warnings)
        PrintMessage("\n")
        PrintMessage("Variable shadowing: ")
        PrintNumber(Analyzer3.shadow_warnings)
        PrintMessage("\n")
        PrintMessage("Loop var modification: ")
        PrintNumber(Analyzer3.loop_mod_warnings)
        PrintMessage("\n")
        PrintMessage("Recursive cycles: ")
        PrintNumber(Analyzer3.recursive_cycles)
        PrintMessage("\n")
        PrintMessage("Known pools: ")
        PrintNumber(XArray.XSize(Analyzer3.known_pools))
        PrintMessage("\n")
        
        // --- Function Definitions (Go to Definition) ---
        PrintMessage("\n--- Function Definitions ---\n")
        count = XArray.XSize(Analyzer2.func_names)
        i = 0
        WhileLoop LessThan(i, count) {
            name = XArray.XGet(Analyzer2.func_names, i)
            line = XArray.XGet(Analyzer2.func_def_lines, i)
            loc = FileMap_Format(line)
            
            PrintMessage(loc)
            PrintMessage(": ")
            PrintMessage(name)
            PrintMessage("\n")
            i = Add(i, 1)
        }
        
        // --- Call Graph (Find References) ---
        PrintMessage("\n--- Call Graph (References) ---\n")
        
        IfCondition NotEqual(ACli.filter, 0) ThenBlock: {
            PrintMessage("Filter: Showing references to '")
            PrintMessage(ACli.filter)
            PrintMessage("'\n")
        }
        
        count = XArray.XSize(Analyzer3.call_graph_from)
        i = 0
        WhileLoop LessThan(i, count) {
            caller = XArray.XGet(Analyzer3.call_graph_from, i)
            callee = XArray.XGet(Analyzer3.call_graph_to, i)
            
            show = 1
            IfCondition NotEqual(ACli.filter, 0) ThenBlock: {
                // Filter by callee (references TO the function)
                is_match = Analyzer3.StrEqual(callee, ACli.filter)
                IfCondition EqualTo(is_match, 0) ThenBlock: {
                    show = 0
                }
            }
            
            IfCondition EqualTo(show, 1) ThenBlock: {
                PrintMessage("  ")
                PrintMessage(caller)
                PrintMessage(" calls ")
                PrintMessage(callee)
                PrintMessage("\n")
            }
            i = Add(i, 1)
        }
        
        // === ERRORS ===
        total_errors = Add(Analyzer.error_count, Analyzer3.error_count)
        IfCondition GreaterThan(total_errors, 0) ThenBlock: {
            PrintMessage("\n========================================\n")
            PrintMessage("ERRORS (")
            PrintNumber(total_errors)
            PrintMessage("):\n")
            PrintMessage("========================================\n")
            
            i = 0
            WhileLoop LessThan(i, Analyzer.error_count) {
                msg = XArray.XGet(Analyzer.errors, i)
                PrintMessage("  [MEM] ")
                PrintMessage(msg)
                PrintMessage("\n")
                i = Add(i, 1)
            }
            
            i = 0
            WhileLoop LessThan(i, Analyzer3.error_count) {
                msg = XArray.XGet(Analyzer3.errors, i)
                PrintMessage("  [DFA] ")
                PrintMessage(msg)
                PrintMessage("\n")
                i = Add(i, 1)
            }
        }
        
        // === WARNINGS ===
        total_warnings = Add(Analyzer.warning_count, Analyzer2.warning_count)
        total_warnings = Add(total_warnings, Analyzer3.warning_count)
        
        IfCondition GreaterThan(total_warnings, 0) ThenBlock: {
            PrintMessage("\n========================================\n")
            PrintMessage("WARNINGS (")
            PrintNumber(total_warnings)
            PrintMessage("):\n")
            PrintMessage("========================================\n")
            
            i = 0
            WhileLoop LessThan(i, Analyzer.warning_count) {
                msg = XArray.XGet(Analyzer.warnings, i)
                PrintMessage("  [MEM] ")
                PrintMessage(msg)
                PrintMessage("\n")
                i = Add(i, 1)
            }
            
            i = 0
            WhileLoop LessThan(i, Analyzer2.warning_count) {
                msg = XArray.XGet(Analyzer2.warnings, i)
                PrintMessage("  [CFG] ")
                PrintMessage(msg)
                PrintMessage("\n")
                i = Add(i, 1)
            }
            
            i = 0
            WhileLoop LessThan(i, Analyzer3.warning_count) {
                msg = XArray.XGet(Analyzer3.warnings, i)
                PrintMessage("  [DFA] ")
                PrintMessage(msg)
                PrintMessage("\n")
                i = Add(i, 1)
            }
        }
        
        // === HINTS ===
        IfCondition GreaterThan(Analyzer2.hint_count, 0) ThenBlock: {
            PrintMessage("\n========================================\n")
            PrintMessage("HINTS (")
            PrintNumber(Analyzer2.hint_count)
            PrintMessage("):\n")
            PrintMessage("========================================\n")
            
            i = 0
            WhileLoop LessThan(i, Analyzer2.hint_count) {
                msg = XArray.XGet(Analyzer2.hints, i)
                PrintMessage("  [OPT] ")
                PrintMessage(msg)
                PrintMessage("\n")
                i = Add(i, 1)
            }
        }
        
        // === SUMMARY ===
        total_warnings = Add(Analyzer.warning_count, Analyzer2.warning_count)
        total_warnings = Add(total_warnings, Analyzer3.warning_count)
        total_errors = Add(Analyzer.error_count, Analyzer3.error_count)
        
        PrintMessage("\n========================================\n")
        PrintMessage("  Summary: ")
        PrintNumber(total_errors)
        PrintMessage(" error(s), ")
        PrintNumber(total_warnings)
        PrintMessage(" warning(s), ")
        PrintNumber(Analyzer2.hint_count)
        PrintMessage(" hint(s)\n")
        PrintMessage("========================================\n")
    }
}

// =============================================================================
// MAIN
// =============================================================================
SubRoutine.Main {
    Arena_Init()
    ACli.filename = ACli.GetArg(1)
    ACli.filter = ACli.GetArg(2)
    
    IfCondition EqualTo(ACli.filename, 0) ThenBlock: {
        PrintMessage("AILang Code Analyzer\n")
        PrintMessage("Usage: ./analyzer.x <filename.ailang> [function_filter]\n")
        ProcessExit(1)
    }
    
    PrintMessage("AILang Analyzer - ")
    PrintMessage(ACli.filename)
    PrintMessage("\n")
    
    // Step 1: Load
    ACli.source = ACli.LoadFile(ACli.filename)
    IfCondition EqualTo(ACli.source, 0) ThenBlock: {
        PrintMessage("ERROR: Cannot read file: ")
        PrintMessage(ACli.filename)
        PrintMessage("\n")
        ProcessExit(1)
    }
    ACli.source_len = StringLength(ACli.source)
    
    // Step 2: Resolve imports
    ACli.resolved = Import_ResolveAll(ACli.source)
    IfCondition EqualTo(ACli.resolved, 0) ThenBlock: {
        ACli.resolved = ACli.source
        // Fallback: Initialize FileMap for single file if import resolution didn't run
        FileMap_Init()
        // Map line 1 to the filename
        FileMap_AddEntry(1, ACli.filename)
    }
    
    // Step 3: Lex
    resolved_len = StringLength(ACli.resolved)
    Lex_Init(ACli.resolved, resolved_len)
    Lex_Tokenize()
    
    IfCondition EqualTo(Lex.error, 1) ThenBlock: {
        PrintMessage("ERROR: Lexer failed at line ")
        PrintNumber(Lex.error_line)
        PrintMessage("\n")
        ProcessExit(1)
    }
    
    // Step 4: Parse
    Parse_Init(Lex.token_count)
    ACli.ast = Parse_Program()
    
    IfCondition EqualTo(Parse_HasError(), 1) ThenBlock: {
        PrintMessage("ERROR: Parse failed at line ")
        PrintNumber(PParser.p_error_line)
        PrintMessage(": ")
        IfCondition NotEqual(PParser.p_error_msg, 0) ThenBlock: {
            PrintMessage(PParser.p_error_msg)
        }
        PrintMessage("\n")
        ProcessExit(1)
    }
    
    // Step 5: Run all analysis passes
  Analyzer.Init()
  Analyzer.WalkNode(ACli.ast)

    // PrintMessage("[INFO] Running Analyzer.PostAnalysis...\n")
    Analyzer.PostAnalysis()
    // PrintMessage("[INFO] Analyzer.PostAnalysis finished.\n")
    
    // PrintMessage("[INFO] Running Analyzer2...\n")
    Analyzer2.Run(ACli.ast)
    // PrintMessage("[INFO] Analyzer2 finished.\n")
    
    // PrintMessage("[INFO] Running Analyzer3...\n")
    Analyzer3.Run(ACli.ast)
    // PrintMessage("[INFO] Analyzer3 finished.\n")
    
    // Step 6: Report
    ACli.Report()
    
    // Exit code based on results
    total_errors = Add(Analyzer.error_count, Analyzer3.error_count)
    IfCondition GreaterThan(total_errors, 0) ThenBlock: {
        ProcessExit(2)
    }
    
    total_warnings = Add(Analyzer.warning_count, Analyzer2.warning_count)
    total_warnings = Add(total_warnings, Analyzer3.warning_count)
    IfCondition GreaterThan(total_warnings, 0) ThenBlock: {
        ProcessExit(1)
    }
    
    HaltProgram()
}

RunTask(Main)
