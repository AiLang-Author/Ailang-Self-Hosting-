    }
}

// =============================================================================
// ARITHMETIC INSTRUCTIONS
// =============================================================================

// SUB RAX, RBX
// SUB RAX, imm32
// IMUL RAX, RBX (signed multiply, result in RAX)
// CQO - sign extend RAX into RDX:RAX for division
// IDIV RBX - signed divide RDX:RAX by RBX, quotient in RAX
// NEG RAX
// =============================================================================
// COMPARE INSTRUCTIONS
// =============================================================================

// CMP RAX, RBX
// CMP RAX, imm32
