// =============================================================================
// NODE CREATION
// =============================================================================

// =============================================================================
// MODIFIED AST_Create - Register in master list
// Replace existing AST_Create in Library.CASTCore.ailang
// =============================================================================

Function.AST_Create {
    Input: node_type: Integer
    Output: Address
    Body: {
        node = XArray.XCreate(8)
        
        // Must PUSH to set size, then we can XSet
        XArray.XPush(node, node_type)              // TYPE - index 0
        XArray.XPush(node, ASTState.auto_line)     // LINE - index 1  (was 0)
        XArray.XPush(node, ASTState.auto_col)      // COL - index 2   (was 0)
        XArray.XPush(node, 0)                       // DATA1 - index 3
        XArray.XPush(node, 0)                       // DATA2 - index 4
        XArray.XPush(node, 0)                       // DATA3 - index 5
        XArray.XPush(node, 0)                       // DATA4 - index 6
        
        // Children is another XArray
        children = XArray.XCreate(ASTState.max_children)
        XArray.XPush(node, children)               // CHILDREN - index 7
        
        ASTState.node_count = Add(ASTState.node_count, 1)
        
        // Register in master list
        IfCondition NotEqual(ASTState.all_nodes, 0) ThenBlock: {
            XArray.XPush(ASTState.all_nodes, node)
        }
        
        ReturnValue(node)
    }
}


Function.AST_CreateAt {
    Input: node_type: Integer
    Input: line: Integer
    Input: col: Integer
    Output: Address
    Body: {
        node = AST_Create(node_type)
        XArray.XSet(node, ASTField.LINE, line)
        XArray.XSet(node, ASTField.COL, col)
        ReturnValue(node)
    }
}

// =============================================================================
// AST INIT - Call once at start of parsing
// Add to Library.CASTCore.ailang
// =============================================================================
Function.AST_Init {
    Body: {
        // Free old list if exists
        IfCondition NotEqual(ASTState.all_nodes, 0) ThenBlock: {
            XArray.XDestroy(ASTState.all_nodes)
        }
        
        // Create fresh master list (capacity for ~10000 nodes)
        ASTState.all_nodes = XArray.XCreate(4096)
        ASTState.node_count = 0
        ASTState.error = 0
        ASTState.error_msg = 0
        
        PrintMessage("[AST] Initialized, node tracking enabled\n")
    }
}


