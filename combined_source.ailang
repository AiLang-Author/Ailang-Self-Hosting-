    StoreValue(Add(ltbl, Multiply(223, TFElem.Size)), TFLogTbl.l223)
    StoreValue(Add(ltbl, Multiply(224, TFElem.Size)), TFLogTbl.l224)
    StoreValue(Add(ltbl, Multiply(225, TFElem.Size)), TFLogTbl.l225)
    StoreValue(Add(ltbl, Multiply(226, TFElem.Size)), TFLogTbl.l226)
    StoreValue(Add(ltbl, Multiply(227, TFElem.Size)), TFLogTbl.l227)
    StoreValue(Add(ltbl, Multiply(228, TFElem.Size)), TFLogTbl.l228)
    StoreValue(Add(ltbl, Multiply(229, TFElem.Size)), TFLogTbl.l229)
    StoreValue(Add(ltbl, Multiply(230, TFElem.Size)), TFLogTbl.l230)
    StoreValue(Add(ltbl, Multiply(231, TFElem.Size)), TFLogTbl.l231)
    StoreValue(Add(ltbl, Multiply(232, TFElem.Size)), TFLogTbl.l232)
    StoreValue(Add(ltbl, Multiply(233, TFElem.Size)), TFLogTbl.l233)
    StoreValue(Add(ltbl, Multiply(234, TFElem.Size)), TFLogTbl.l234)
