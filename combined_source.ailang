}

// === Inlined from TF.Layer ===
// Library.TF.Layer.ailang
// Pure functions only. No SubRoutines. No FixedPool state.
// Max 6 inputs per function. Extra args via NS000001_TFProjCarrier / NS000001_TFOutProjCarrier.
// Copyright © 2025 Sean Collins, 2 Paws Machine and Engineering. All rights reserved. SCSL.


// =============================================================================
// WEIGHT INIT - SubRoutine version for use from SubRoutines
// =============================================================================
FixedPool.TFAllocCarrier {
    "rows":   Initialize=0
    "cols":   Initialize=0
    "range":  Initialize=0
    "result": Initialize=0
}

SubRoutine.TFLayer_AllocMatSub {
    am_rows  = TFAllocCarrier.rows
    am_cols  = TFAllocCarrier.cols
    am_range = TFAllocCarrier.range

    am_rc    = Multiply(am_rows, am_cols)
    am_total = Multiply(am_rc, 8)
    am_mat   = Allocate(am_total)

    // Zero fill
    am_i = 0
    WhileLoop LessThan(am_i, am_total) {
        SetByte(am_mat, am_i, 0)
        am_i = Add(am_i, 1)
    }

    // Rand init using direct FixedPool syntax
    am_drange = Multiply(am_range, 2)

    am_i = 0
    WhileLoop LessThan(am_i, am_rc) {
        am_s = TFRand.seed
        am_s = Add(Multiply(am_s, 1664525), 1013904223)
        am_s = BitwiseAnd(am_s, 2147483647)
        FixedPool.TFRand.seed = am_s

        am_rmod = Modulo(am_s, am_drange)
        am_rval = Subtract(am_rmod, am_range)
        am_off  = Multiply(am_i, 8)
        am_adr  = Add(am_mat, am_off)
        StoreValue(am_adr, am_rval)
        am_i = Add(am_i, 1)
    }

    TFAllocCarrier.result = am_mat
}

Function.TFLayer_AllocMat {
    Input:  rows:  Integer
    Input:  cols:  Integer
    Input:  range: Integer
    Output: Integer
    Body: {
        mat = TF_MatAlloc(rows, cols)
        DebugAssert(NotEqual(mat, 0), "TFLayer_AllocMat: alloc failed")
        TF_MatRandInit(mat, rows, cols, range)
        ReturnValue(mat)
    }
}

// =============================================================================
// EMBEDDING LOOKUP
// emb[pos] = Embed[token] + PosEmb[pos]
// =============================================================================
Function.TFLayer_Embed {
    Input:  emb:    Integer
    Input:  tokens: Integer
    Input:  Embed:  Integer
    Input:  PosEmb: Integer
    Input:  seqln:  Integer
    Input:  dmod:   Integer
    Output: Integer
    Body: {
        pos = 0
        WhileLoop LessThan(pos, seqln) {
            tok_off = Multiply(pos, TFElem.Size)
            tok_adr = Add(tokens, tok_off)
            tok     = Dereference(tok_adr)
            col = 0
            WhileLoop LessThan(col, dmod) {
                tv  = TF_MatGet(Embed,  tok, col, dmod)
                pv  = TF_MatGet(PosEmb, pos, col, dmod)
                res = Add(tv, pv)
                TF_MatSet(emb, pos, col, dmod, res)
                col = Add(col, 1)
            }
            pos = Add(pos, 1)
        }
        ReturnValue(1)
    }
}

// =============================================================================
// QKV PROJECTION
// Reads NS000001_TFProjCarrier: .Wk .Wv .seqln .dmod
// =============================================================================
Function.TFLayer_ProjQKV {
    Input:  qvec: Integer
    Input:  kvec: Integer
    Input:  vvec: Integer
    Input:  emb:  Integer
    Input:  Wq:   Integer
    Output: Integer
    Body: {
        Wk    = NS000001_TFProjCarrier.Wk
        Wv    = NS000001_TFProjCarrier.Wv
        seqln = NS000001_TFProjCarrier.seqln
        dmod  = NS000001_TFProjCarrier.dmod

        tmp_emb = TF_VecAlloc(dmod)
        qrow    = TF_VecAlloc(dmod)
        krow    = TF_VecAlloc(dmod)
        vrow    = TF_VecAlloc(dmod)

        DebugAssert(NotEqual(tmp_emb, 0), "TFLayer_ProjQKV: alloc failed")

        pos = 0
        WhileLoop LessThan(pos, seqln) {
            col = 0
            WhileLoop LessThan(col, dmod) {
                val = TF_MatGet(emb, pos, col, dmod)
                TF_VecSet(tmp_emb, col, val)
                col = Add(col, 1)
            }
            TF_MatVecMul(qrow, Wq, tmp_emb, dmod, dmod)
            TF_MatVecMul(krow, Wk, tmp_emb, dmod, dmod)
            TF_MatVecMul(vrow, Wv, tmp_emb, dmod, dmod)
            col = 0
            WhileLoop LessThan(col, dmod) {
                TF_MatSet(qvec, pos, col, dmod, TF_VecGet(qrow, col))
                TF_MatSet(kvec, pos, col, dmod, TF_VecGet(krow, col))
                TF_MatSet(vvec, pos, col, dmod, TF_VecGet(vrow, col))
                col = Add(col, 1)
            }
            pos = Add(pos, 1)
        }

        TF_VecFree(tmp_emb, dmod)
        TF_VecFree(qrow,    dmod)
        TF_VecFree(krow,    dmod)
        TF_VecFree(vrow,    dmod)
        ReturnValue(1)
    }
}

// =============================================================================
// ATTENTION SCORES
// scores[i][j] = dot(q[i], k[j]) / scale
// =============================================================================
Function.TFLayer_AttnScores {
    Input:  scores: Integer
    Input:  qvec:   Integer
    Input:  kvec:   Integer
    Input:  seqln:  Integer
    Input:  dmod:   Integer
    Input:  scale:  Integer
    Output: Integer
    Body: {
        qrow = TF_VecAlloc(dmod)
        krow = TF_VecAlloc(dmod)
        DebugAssert(NotEqual(qrow, 0), "TFLayer_AttnScores: alloc failed")

        row = 0
        WhileLoop LessThan(row, seqln) {
            col = 0
            WhileLoop LessThan(col, dmod) {
                TF_VecSet(qrow, col, TF_MatGet(qvec, row, col, dmod))
                col = Add(col, 1)
            }
            col = 0
            WhileLoop LessThan(col, seqln) {
                ki = 0
                WhileLoop LessThan(ki, dmod) {
                    TF_VecSet(krow, ki, TF_MatGet(kvec, col, ki, dmod))
                    ki = Add(ki, 1)
                }
                raw = TF_VecDot(qrow, krow, dmod)
                sc_div = Multiply(scale, 32)
                sc     = Divide(raw, sc_div)
                TF_MatSet(scores, row, col, seqln, sc)
                col = Add(col, 1)
            }
            row = Add(row, 1)
        }

        TF_VecFree(qrow, dmod)
        TF_VecFree(krow, dmod)
        ReturnValue(1)
    }
}

// =============================================================================
// ATTENTION SOFTMAX
// attn[row] = softmax(scores[row])
// =============================================================================
Function.TFLayer_AttnSoftmax {
    Input:  attn:   Integer
    Input:  scores: Integer
    Input:  seqln:  Integer
    Output: Integer
    Body: {
        score_row = TF_VecAlloc(seqln)
        attn_row  = TF_VecAlloc(seqln)
        DebugAssert(NotEqual(score_row, 0), "TFLayer_AttnSoftmax: alloc failed")

        row = 0
        WhileLoop LessThan(row, seqln) {
            col = 0
            WhileLoop LessThan(col, seqln) {
                val = TF_MatGet(scores, row, col, seqln)
                TF_VecSet(score_row, col, val)
                col = Add(col, 1)
            }
            TFAct_Softmax(attn_row, score_row, seqln)
            col = 0
            WhileLoop LessThan(col, seqln) {
                TF_MatSet(attn, row, col, seqln, TF_VecGet(attn_row, col))
                col = Add(col, 1)
            }
            row = Add(row, 1)
        }

        TF_VecFree(score_row, seqln)
        TF_VecFree(attn_row,  seqln)
        ReturnValue(1)
    }
}

// =============================================================================
// CONTEXT VECTORS
// ctx[i] = sum_j(attn[i][j] * v[j])
// =============================================================================
Function.TFLayer_Context {
    Input:  ctx:   Integer
    Input:  attn:  Integer
    Input:  vvec:  Integer
    Input:  seqln: Integer
    Input:  dmod:  Integer
    Output: Integer
    Body: {
        ctx_row = TF_VecAlloc(dmod)
        DebugAssert(NotEqual(ctx_row, 0), "TFLayer_Context: alloc failed")

        row = 0
        WhileLoop LessThan(row, seqln) {
            TF_VecZero(ctx_row, dmod)
            col = 0
            WhileLoop LessThan(col, seqln) {
                aw = TF_MatGet(attn, row, col, seqln)
                di = 0
                WhileLoop LessThan(di, dmod) {
                    vval   = TF_MatGet(vvec, col, di, dmod)
                    old    = TF_VecGet(ctx_row, di)
                    prod   = Multiply(aw, vval)
                    scaled = Divide(prod, 256)
                    nuw    = Add(old, scaled)
                    TF_VecSet(ctx_row, di, nuw)
                    di = Add(di, 1)
                }
                col = Add(col, 1)
            }
            di = 0
            WhileLoop LessThan(di, dmod) {
                TF_MatSet(ctx, row, di, dmod, TF_VecGet(ctx_row, di))
                di = Add(di, 1)
            }
            row = Add(row, 1)
        }

        TF_VecFree(ctx_row, dmod)
        ReturnValue(1)
    }
}

// =============================================================================
// RESIDUAL
// resid[t] = ctx[t] + emb[t]
// =============================================================================
Function.TFLayer_Residual {
    Input:  resid: Integer
    Input:  ctx:   Integer
    Input:  emb:   Integer
    Input:  seqln: Integer
    Input:  dmod:  Integer
    Output: Integer
    Body: {
        pos = 0
        WhileLoop LessThan(pos, seqln) {
            col = 0
            WhileLoop LessThan(col, dmod) {
                cv  = TF_MatGet(ctx, pos, col, dmod)
                ev  = TF_MatGet(emb, pos, col, dmod)
                res = Add(cv, ev)
                TF_MatSet(resid, pos, col, dmod, res)
                col = Add(col, 1)
            }
            pos = Add(pos, 1)
        }
        ReturnValue(1)
    }
}

// =============================================================================
// OUTPUT PROJECTION + SOFTMAX
// Reads NS000001_TFOutProjCarrier: .seqln .dmod .vocab
// =============================================================================
Function.TFLayer_OutputProj {
    Input:  logits: Integer
    Input:  probs:  Integer
    Input:  resid:  Integer
    Input:  Wout:   Integer
    Output: Integer
    Body: {
        seqln = NS000001_TFOutProjCarrier.seqln
        dmod  = NS000001_TFOutProjCarrier.dmod
        vocab = NS000001_TFOutProjCarrier.vocab

        tmp_row   = TF_VecAlloc(dmod)
        logit_row = TF_VecAlloc(vocab)
        prob_row  = TF_VecAlloc(vocab)
        DebugAssert(NotEqual(tmp_row, 0), "TFLayer_OutputProj: alloc failed")

        pos = 0
        WhileLoop LessThan(pos, seqln) {
            col = 0
            WhileLoop LessThan(col, dmod) {
                val = TF_MatGet(resid, pos, col, dmod)
                TF_VecSet(tmp_row, col, val)
                col = Add(col, 1)
            }
            TF_MatVecMul(logit_row, Wout, tmp_row, vocab, dmod)
            col = 0
            WhileLoop LessThan(col, vocab) {
                val = TF_VecGet(logit_row, col)
                TF_MatSet(logits, pos, col, vocab, val)
                col = Add(col, 1)
            }
            TFAct_Softmax(prob_row, logit_row, vocab)
            col = 0
            WhileLoop LessThan(col, vocab) {
                val = TF_VecGet(prob_row, col)
                TF_MatSet(probs, pos, col, vocab, val)
                col = Add(col, 1)
            }
            pos = Add(pos, 1)
        }

        TF_VecFree(tmp_row,   dmod)
        TF_VecFree(logit_row, vocab)
        TF_VecFree(prob_row,  vocab)
        ReturnValue(1)
    }
}

// === Inlined from TF.Train ===
// Library.TF.Train.ailang
// Pure functions only. No SubRoutines.
// Extra params beyond 6-input limit are passed via carrier FixedPools
// defined in ATTN.ailang: NS000001_TFBackOut, NS000001_TFBackCtx, NS000001_TFBackQK, NS000001_TFBackWA, NS000001_TFBackWB
// Caller sets carrier fields before calling. Functions read them directly.
// Copyright © 2025 Sean Collins, 2 Paws Machine and Engineering. All rights reserved. SCSL.


// =============================================================================
// SOFTMAX GRADIENT + dWout + dResid
// Reads from NS000001_TFBackOut: .Wout .targets .seqln .dmod .vocab
// =============================================================================
Function.TFTrain_BackOutProj {
    Input:  dWout:   Integer
    Input:  dResid:  Integer
    Input:  dLogits: Integer
    Input:  probs:   Integer
    Input:  resid:   Integer
    Output: Integer
    Body: {
        Wout    = NS000001_TFBackOut.Wout
        targets = NS000001_TFBackOut.targets
        seqln   = NS000001_TFBackOut.seqln
        dmod    = NS000001_TFBackOut.dmod
        vocab   = NS000001_TFBackOut.vocab

        dlogit_row = TF_VecAlloc(vocab)
        dresid_row = TF_VecAlloc(dmod)
        prob_row   = TF_VecAlloc(vocab)
        resid_row  = TF_VecAlloc(dmod)

        DebugAssert(NotEqual(dlogit_row, 0), "TFTrain_BackOutProj: alloc failed")

        pos = 0
        WhileLoop LessThan(pos, seqln) {
            tgt = TF_VecGet(targets, pos)
            col = 0
            WhileLoop LessThan(col, vocab) {
                TF_VecSet(prob_row, col, TF_MatGet(probs, pos, col, vocab))
                col = Add(col, 1)
            }
            TFAct_SoftmaxGrad(dlogit_row, prob_row, tgt, vocab)
            col = 0
            WhileLoop LessThan(col, vocab) {
                TF_MatSet(dLogits, pos, col, vocab, TF_VecGet(dlogit_row, col))
                col = Add(col, 1)
            }
            col = 0
            WhileLoop LessThan(col, dmod) {
                TF_VecSet(resid_row, col, TF_MatGet(resid, pos, col, dmod))
                col = Add(col, 1)
            }
            TF_FOuterAccum(dWout, dlogit_row, resid_row, vocab, dmod)
            TF_MatTVecMul(dresid_row, Wout, dlogit_row, vocab, dmod)
            col = 0
            WhileLoop LessThan(col, dmod) {
                TF_MatSet(dResid, pos, col, dmod, TF_VecGet(dresid_row, col))
                col = Add(col, 1)
            }
            pos = Add(pos, 1)
        }

        TF_VecFree(dlogit_row, vocab)
        TF_VecFree(dresid_row, dmod)
        TF_VecFree(prob_row,   vocab)
        TF_VecFree(resid_row,  dmod)
        ReturnValue(1)
    }
}

// =============================================================================
// RESIDUAL SPLIT + dV + dScores
// Reads from NS000001_TFBackCtx: .attn .vvec .seqln .dmod .scale
// =============================================================================
Function.TFTrain_BackAttnCtx {
    Input:  dCtx:    Integer
    Input:  dEmb:    Integer
    Input:  dV:      Integer
    Input:  dScores: Integer
    Input:  dResid:  Integer
    Output: Integer
    Body: {
        attn  = NS000001_TFBackCtx.attn
        vvec  = NS000001_TFBackCtx.vvec
        seqln = NS000001_TFBackCtx.seqln
        dmod  = NS000001_TFBackCtx.dmod
        scale = NS000001_TFBackCtx.scale

        dctx_row = TF_VecAlloc(dmod)
        vrow     = TF_VecAlloc(dmod)
        dv_accum = TF_VecAlloc(dmod)
        DebugAssert(NotEqual(dctx_row, 0), "TFTrain_BackAttnCtx: alloc failed")

        // Residual split
        pos = 0
        WhileLoop LessThan(pos, seqln) {
            col = 0
            WhileLoop LessThan(col, dmod) {
                dv = TF_MatGet(dResid, pos, col, dmod)
                TF_MatSet(dCtx, pos, col, dmod, dv)
                TF_MatSet(dEmb, pos, col, dmod, dv)
                col = Add(col, 1)
            }
            pos = Add(pos, 1)
        }

        // dV
        vpos = 0
        WhileLoop LessThan(vpos, seqln) {
            TF_VecZero(dv_accum, dmod)
            ipos = 0
            WhileLoop LessThan(ipos, seqln) {
                aw = TF_MatGet(attn, ipos, vpos, seqln)
                col = 0
                WhileLoop LessThan(col, dmod) {
                    dc     = TF_MatGet(dCtx, ipos, col, dmod)
                    old    = TF_VecGet(dv_accum, col)
                    prod   = Multiply(aw, dc)
                    scaled = Divide(prod, 256)
                    nuw    = Add(old, scaled)
                    TF_VecSet(dv_accum, col, nuw)
                    col = Add(col, 1)
                }
                ipos = Add(ipos, 1)
            }
            col = 0
            WhileLoop LessThan(col, dmod) {
                TF_MatSet(dV, vpos, col, dmod, TF_VecGet(dv_accum, col))
                col = Add(col, 1)
            }
            vpos = Add(vpos, 1)
        }

        // dScores
        ipos = 0
        WhileLoop LessThan(ipos, seqln) {
            col = 0
            WhileLoop LessThan(col, dmod) {
                TF_VecSet(dctx_row, col, TF_MatGet(dCtx, ipos, col, dmod))
                col = Add(col, 1)
            }
            jpos = 0
            WhileLoop LessThan(jpos, seqln) {
                col = 0
                WhileLoop LessThan(col, dmod) {
                    TF_VecSet(vrow, col, TF_MatGet(vvec, jpos, col, dmod))
                    col = Add(col, 1)
                }
                raw_ds = TF_FDot(dctx_row, vrow, dmod)
                sc_div = Multiply(scale, 32)
                raw_ds = Divide(raw_ds, sc_div)
                aw     = TF_MatGet(attn, ipos, jpos, seqln)
                inv    = Subtract(256, aw)
                tmp1   = Multiply(raw_ds, aw)
                tmp2   = Divide(tmp1, 256)
                tmp3   = Multiply(tmp2, inv)
                dsc    = Divide(tmp3, 256)
                TF_MatSet(dScores, ipos, jpos, seqln, dsc)
                jpos = Add(jpos, 1)
            }
            ipos = Add(ipos, 1)
        }

        TF_VecFree(dctx_row, dmod)
        TF_VecFree(vrow,     dmod)
        TF_VecFree(dv_accum, dmod)
        ReturnValue(1)
    }
}

// =============================================================================
// dQ dK from dScores
// Reads from NS000001_TFBackQK: .seqln .dmod
// =============================================================================
Function.TFTrain_BackQK {
    Input:  dQ:      Integer
    Input:  dK:      Integer
    Input:  dScores: Integer
    Input:  qvec:    Integer
    Input:  kvec:    Integer
    Output: Integer
    Body: {
        seqln = NS000001_TFBackQK.seqln
        dmod  = NS000001_TFBackQK.dmod

        qrow = TF_VecAlloc(dmod)
        DebugAssert(NotEqual(qrow, 0), "TFTrain_BackQK: alloc failed")

        TF_MatZero(dQ, seqln, dmod)
        TF_MatZero(dK, seqln, dmod)

        ipos = 0
        WhileLoop LessThan(ipos, seqln) {
            col = 0
            WhileLoop LessThan(col, dmod) {
                TF_VecSet(qrow, col, TF_MatGet(qvec, ipos, col, dmod))
                col = Add(col, 1)
            }
            jpos = 0
            WhileLoop LessThan(jpos, seqln) {
                ds = TF_MatGet(dScores, ipos, jpos, seqln)
                col = 0
                WhileLoop LessThan(col, dmod) {
                    kv     = TF_MatGet(kvec, jpos, col, dmod)
                    qv     = TF_VecGet(qrow, col)
                    old_dq = TF_MatGet(dQ,   ipos, col, dmod)
                    old_dk = TF_MatGet(dK,   jpos, col, dmod)
                    ndq    = Add(old_dq, Multiply(ds, kv))
                    ndk    = Add(old_dk, Multiply(ds, qv))
                    TF_MatSet(dQ, ipos, col, dmod, ndq)
                    TF_MatSet(dK, jpos, col, dmod, ndk)
                    col = Add(col, 1)
                }
                jpos = Add(jpos, 1)
            }
            ipos = Add(ipos, 1)
        }

        TF_VecFree(qrow, dmod)
        ReturnValue(1)
    }
}

// =============================================================================
// dWq dWk dWv and accumulate dEmb
// Reads from NS000001_TFBackWA: .Wq .Wk .Wv .emb .seqln .dmod .dK .dV
// =============================================================================
Function.TFTrain_BackWeightsA {
    Input:  dWq:  Integer
    Input:  dWk:  Integer
    Input:  dWv:  Integer
    Input:  dEmb: Integer
    Input:  dQ:   Integer
    Output: Integer
    Body: {
        Wq    = NS000001_TFBackWA.Wq
        Wk    = NS000001_TFBackWA.Wk
        Wv    = NS000001_TFBackWA.Wv
        emb   = NS000001_TFBackWA.emb
        seqln = NS000001_TFBackWA.seqln
        dmod  = NS000001_TFBackWA.dmod
        dK    = NS000001_TFBackWA.dK
        dV    = NS000001_TFBackWA.dV

        emb_row = TF_VecAlloc(dmod)
        dq_row  = TF_VecAlloc(dmod)
        dk_row  = TF_VecAlloc(dmod)
        dv_row  = TF_VecAlloc(dmod)
        tmp_row = TF_VecAlloc(dmod)
        DebugAssert(NotEqual(emb_row, 0), "TFTrain_BackWeightsA: alloc failed")

        pos = 0
        WhileLoop LessThan(pos, seqln) {
            col = 0
            WhileLoop LessThan(col, dmod) {
                TF_VecSet(emb_row, col, TF_MatGet(emb, pos, col, dmod))
                TF_VecSet(dq_row,  col, TF_MatGet(dQ,  pos, col, dmod))
                TF_VecSet(dk_row,  col, TF_MatGet(dK,  pos, col, dmod))
                TF_VecSet(dv_row,  col, TF_MatGet(dV,  pos, col, dmod))
                col = Add(col, 1)
            }
            TF_FOuterAccum(dWq, dq_row, emb_row, dmod, dmod)
            TF_FOuterAccum(dWk, dk_row, emb_row, dmod, dmod)
            TF_FOuterAccum(dWv, dv_row, emb_row, dmod, dmod)

            TF_MatTVecMul(tmp_row, Wq, dq_row, dmod, dmod)
            col = 0
            WhileLoop LessThan(col, dmod) {
                old = TF_MatGet(dEmb, pos, col, dmod)
                TF_MatSet(dEmb, pos, col, dmod, Add(old, TF_VecGet(tmp_row, col)))
                col = Add(col, 1)
            }
            TF_MatTVecMul(tmp_row, Wk, dk_row, dmod, dmod)
            col = 0
            WhileLoop LessThan(col, dmod) {
                old = TF_MatGet(dEmb, pos, col, dmod)
                TF_MatSet(dEmb, pos, col, dmod, Add(old, TF_VecGet(tmp_row, col)))
                col = Add(col, 1)
            }
            TF_MatTVecMul(tmp_row, Wv, dv_row, dmod, dmod)
            col = 0
            WhileLoop LessThan(col, dmod) {
                old = TF_MatGet(dEmb, pos, col, dmod)
                TF_MatSet(dEmb, pos, col, dmod, Add(old, TF_VecGet(tmp_row, col)))
                col = Add(col, 1)
            }
            pos = Add(pos, 1)
        }

        TF_VecFree(emb_row, dmod)
        TF_VecFree(dq_row,  dmod)
        TF_VecFree(dk_row,  dmod)
        TF_VecFree(dv_row,  dmod)
        TF_VecFree(tmp_row, dmod)
        ReturnValue(1)
    }
}

// =============================================================================
// dEmbed and dPosEmb from dEmb
// Reads from NS000001_TFBackWB: .tokens .seqln .dmod
// =============================================================================
Function.TFTrain_BackWeightsB {
    Input:  dEmbed:  Integer
    Input:  dPosEmb: Integer
    Input:  dEmb:    Integer
    Output: Integer
    Body: {
        tokens = NS000001_TFBackWB.tokens
        seqln  = NS000001_TFBackWB.seqln
        dmod   = NS000001_TFBackWB.dmod

        pos = 0
        WhileLoop LessThan(pos, seqln) {
            tok_off = Multiply(pos, TFElem.Size)
            tok     = Dereference(Add(tokens, tok_off))
            col = 0
            WhileLoop LessThan(col, dmod) {
                dv     = TF_MatGet(dEmb,    pos, col, dmod)
                old_te = TF_MatGet(dEmbed,  tok, col, dmod)
                old_pe = TF_MatGet(dPosEmb, pos, col, dmod)
                TF_MatSet(dEmbed,  tok, col, dmod, Add(old_te, dv))
                TF_MatSet(dPosEmb, pos, col, dmod, Add(old_pe, dv))
                col = Add(col, 1)
            }
            pos = Add(pos, 1)
        }
        ReturnValue(1)
    }
}

// =============================================================================
// ACCURACY
// =============================================================================
Function.TFTrain_Accuracy {
    Input:  probs:   Integer
    Input:  targets: Integer
    Input:  seqln:   Integer
    Input:  vocab:   Integer
    Output: Integer
    Body: {
        correct  = 0
        prob_row = TF_VecAlloc(vocab)
        pos = 0
        WhileLoop LessThan(pos, seqln) {
            col = 0
            WhileLoop LessThan(col, vocab) {
                TF_VecSet(prob_row, col, TF_MatGet(probs, pos, col, vocab))
                col = Add(col, 1)
            }
            pred = TF_VecArgMax(prob_row, vocab)
            tgt  = TF_VecGet(targets, pos)
            IfCondition EqualTo(pred, tgt) ThenBlock: {
                correct = Add(correct, 1)
            }
            pos = Add(pos, 1)
        }
        TF_VecFree(prob_row, vocab)
        ReturnValue(correct)
    }
}

// =============================================================================
// LOSS
// =============================================================================
Function.TFTrain_Loss {
    Input:  probs:   Integer
    Input:  targets: Integer
    Input:  seqln:   Integer
    Input:  vocab:   Integer
    Output: Integer
    Body: {
        prob_row  = TF_VecAlloc(vocab)
        step_loss = 0
        pos = 0
        WhileLoop LessThan(pos, seqln) {
            col = 0
            WhileLoop LessThan(col, vocab) {
                TF_VecSet(prob_row, col, TF_MatGet(probs, pos, col, vocab))
                col = Add(col, 1)
            }
            tgt  = TF_VecGet(targets, pos)
            loss = TFAct_CrossEntropy(prob_row, tgt)
            step_loss = Add(step_loss, loss)
            pos = Add(pos, 1)
        }
        avg = Divide(step_loss, seqln)
        TF_VecFree(prob_row, vocab)
        ReturnValue(avg)
    }
}

// === Inlined from TF.Float ===
// Library.Float.ailang
// Float backward pass operations (SSE2 Float Math).
// Copyright © 2025 Sean Collins, 2 Paws Machine and Engineering. All rights reserved. SCSL.


// =============================================================================
// FLOAT DOT PRODUCT
// sum(a[i] * b[i])
// =============================================================================
Function.TF_FDot {
    Input:  fdot_vecA: Integer
    Input:  fdot_vecB: Integer
    Input:  fdot_len:  Integer
    Output: Integer
    Body: {
        fdot_sum_f = Float_FromInt(0)
        fdot_i = 0
        WhileLoop LessThan(fdot_i, fdot_len) {
            fdot_va_i = TF_VecGet(fdot_vecA, fdot_i)
            fdot_vb_i = TF_VecGet(fdot_vecB, fdot_i)
            fdot_va_f = Float_FromInt(fdot_va_i)
            fdot_vb_f = Float_FromInt(fdot_vb_i)
            fdot_prod = Float_Mul(fdot_va_f, fdot_vb_f)
            fdot_sum_f = Float_Add(fdot_sum_f, fdot_prod)
            fdot_i = Add(fdot_i, 1)
        }
        fdot_res_i = Float_ToInt(fdot_sum_f)
        ReturnValue(fdot_res_i)
    }
}

// =============================================================================
// FLOAT OUTER ACCUMULATE
// grad[r][c] += a[r] * b[c]
// =============================================================================
Function.TF_FOuterAccum {
    Input:  facc_mat:   Integer
    Input:  facc_vecA:  Integer
    Input:  facc_vecB:  Integer
    Input:  facc_rows:  Integer
    Input:  facc_cols:  Integer
    Output: Integer
    Body: {
        facc_r = 0
        facc_scale_f = Float_FromInt(256)
        WhileLoop LessThan(facc_r, facc_rows) {
            facc_va_i = TF_VecGet(facc_vecA, facc_r)
            facc_va_f = Float_FromInt(facc_va_i)
            facc_c = 0
            WhileLoop LessThan(facc_c, facc_cols) {
                facc_vb_i = TF_VecGet(facc_vecB, facc_c)
                facc_vb_f = Float_FromInt(facc_vb_i)
                facc_prod = Float_Mul(facc_va_f, facc_vb_f)
                facc_prod_scaled = Float_Div(facc_prod, facc_scale_f)
                facc_old_i = TF_MatGet(facc_mat, facc_r, facc_c, facc_cols)
                facc_old_f = Float_FromInt(facc_old_i)
                facc_new_f = Float_Add(facc_old_f, facc_prod_scaled)
                facc_new_i = Float_ToInt(facc_new_f)
                TF_MatSet(facc_mat, facc_r, facc_c, facc_cols, facc_new_i)
                facc_c = Add(facc_c, 1)
            }
            facc_r = Add(facc_r, 1)
        }
        ReturnValue(1)
    }
}

// =============================================================================
// FLOAT SGD
// w -= lr_num * grad / lr_den
// =============================================================================
Function.TF_FSGD {
    Input:  fsgd_mat:    Integer
    Input:  fsgd_grad:   Integer
    Input:  fsgd_rows:   Integer
    Input:  fsgd_cols:   Integer
    Input:  fsgd_lr_num: Integer
    Input:  fsgd_lr_den: Integer
    Output: Integer
    Body: {
        fsgd_lr_n_f = Float_FromInt(fsgd_lr_num)
        fsgd_lr_d_f = Float_FromInt(fsgd_lr_den)
        fsgd_lr_f   = Float_Div(fsgd_lr_n_f, fsgd_lr_d_f)
        
        fsgd_r = 0
        WhileLoop LessThan(fsgd_r, fsgd_rows) {
            fsgd_c = 0
            WhileLoop LessThan(fsgd_c, fsgd_cols) {
                fsgd_g_i = TF_MatGet(fsgd_grad, fsgd_r, fsgd_c, fsgd_cols)
                fsgd_w_i = TF_MatGet(fsgd_mat, fsgd_r, fsgd_c, fsgd_cols)
                fsgd_g_f = Float_FromInt(fsgd_g_i)
                fsgd_w_f = Float_FromInt(fsgd_w_i)
                
                fsgd_upd_f = Float_Mul(fsgd_g_f, fsgd_lr_f)
                fsgd_new_w_f = Float_Sub(fsgd_w_f, fsgd_upd_f)
                fsgd_new_w_i = Float_ToInt(fsgd_new_w_f)
                
                TF_MatSet(fsgd_mat, fsgd_r, fsgd_c, fsgd_cols, fsgd_new_w_i)
                fsgd_c = Add(fsgd_c, 1)
            }
            fsgd_r = Add(fsgd_r, 1)
        }
        ReturnValue(1)
    }
}

// === Main module ===
// ATTN.ailang
// Single orchestration file. Owns all state, all SubRoutines.
// Libraries are pure functions. State lives here only.
// Pattern: FixedPool carries head/tail state between SubRoutine calls.
// Copyright © 2025 Sean Collins, 2 Paws Machine and Engineering. All rights reserved. SCSL.



// =============================================================================
// BACKWARD PASS CARRIERS
// Used to pass extra args to train functions that exceed 6-input limit.
// Layout must match byte offsets used in Library.TF.Train functions.
// =============================================================================

// =============================================================================
// FORWARD PASS CARRIERS
// =============================================================================
FixedPool.NS000001_TFProjCarrier {
    "Wk":    Initialize=0
    "Wv":    Initialize=0
    "seqln": Initialize=0
    "dmod":  Initialize=0
}

FixedPool.NS000001_TFOutProjCarrier {
    "seqln": Initialize=0
    "dmod":  Initialize=0
    "vocab": Initialize=0
}

FixedPool.NS000001_TFBackOut {
    "Wout":    Initialize=0
    "targets": Initialize=0
    "seqln":   Initialize=0
    "dmod":    Initialize=0
    "vocab":   Initialize=0
}

FixedPool.NS000001_TFBackCtx {
    "attn":  Initialize=0
    "vvec":  Initialize=0
    "seqln": Initialize=0
    "dmod":  Initialize=0
    "scale": Initialize=0
}

FixedPool.NS000001_TFBackQK {
    "seqln": Initialize=0
    "dmod":  Initialize=0
}

FixedPool.NS000001_TFBackWA {
    "Wq":    Initialize=0
    "Wk":    Initialize=0
    "Wv":    Initialize=0
    "emb":   Initialize=0
    "seqln": Initialize=0
    "dmod":  Initialize=0
    "dK":    Initialize=0
    "dV":    Initialize=0
}

FixedPool.NS000001_TFBackWB {
    "tokens": Initialize=0
    "seqln":  Initialize=0
    "dmod":   Initialize=0
}

// =============================================================================
// ALL MODEL STATE — owned here, nowhere else
// =============================================================================
FixedPool.TFW {
    // Weights
    "Embed":  Initialize=0
    "PosEmb": Initialize=0
    "Wq":     Initialize=0
    "Wk":     Initialize=0
    "Wv":     Initialize=0
    "Wout":   Initialize=0
    // Forward cache
    "emb":    Initialize=0
    "qvec":   Initialize=0
    "kvec":   Initialize=0
    "vvec":   Initialize=0
    "scores": Initialize=0
    "attn":   Initialize=0
    "ctx":    Initialize=0
    "resid":  Initialize=0
    "logits": Initialize=0
    "probs":  Initialize=0
    // Gradient buffers
    "dEmbed":  Initialize=0
    "dPosEmb": Initialize=0
    "dWq":     Initialize=0
    "dWk":     Initialize=0
    "dWv":     Initialize=0
    "dWout":   Initialize=0
    "dLogits": Initialize=0
    "dResid":  Initialize=0
    "dCtx":    Initialize=0
    "dEmb":    Initialize=0
    "dQ":      Initialize=0
    "dK":      Initialize=0
    "dV":      Initialize=0
    "dScores": Initialize=0
}

// =============================================================================
// TRAINING HEAD/TAIL STATE
// =============================================================================
FixedPool.TFState {
    "tokens":   Initialize=0
    "targets":  Initialize=0
    "step":     Initialize=0
    "loss_acc": Initialize=0
    "acc_num":  Initialize=0
    "acc_den":  Initialize=0
}

// =============================================================================
// INIT
// =============================================================================
SubRoutine.ATTN_Init {
    dbg_seed = TFRand.seed
    PrintMessage("[DBG] RNG seed = ")
    PrintNumber(dbg_seed)
    PrintMessage("\n")
    PrintMessage("ATTN - AILANG IS ALL YOU NEED\n")
    PrintMessage("D=")
    PrintNumber(TFConfig.DModel)
    PrintMessage(" SEQ=")
    PrintNumber(TFConfig.SeqLen)
    PrintMessage(" V=")
    PrintNumber(TFConfig.VocabSize)
    PrintMessage("\n\n")

    init_dmod  = TFConfig.DModel
    init_seqln = TFConfig.SeqLen
    init_vocab = TFConfig.VocabSize

    // Init act tables
    TFAct_Init()

    // Allocate weights using SubRoutine to enable RNG updates
    TFAllocCarrier.rows = init_vocab
    TFAllocCarrier.cols = init_dmod
    TFAllocCarrier.range = 2
    TFLayer_AllocMatSub()
    TFW.Embed = TFAllocCarrier.result

    dbg_seed2 = TFRand.seed
    PrintMessage("[DBG] After Embed: seed = ")
    PrintNumber(dbg_seed2)
    PrintMessage("\n")
    PrintMessage("  Embed[0,0..3] = ")
    PrintNumber(TF_MatGet(TFW.Embed, 0, 0, init_dmod))
    PrintMessage(" ")
    PrintNumber(TF_MatGet(TFW.Embed, 0, 1, init_dmod))
    PrintMessage(" ")
    PrintNumber(TF_MatGet(TFW.Embed, 0, 2, init_dmod))
    PrintMessage(" ")
    PrintNumber(TF_MatGet(TFW.Embed, 0, 3, init_dmod))
    PrintMessage("\n")
    PrintMessage("  Embed[1,0..3] = ")
    PrintNumber(TF_MatGet(TFW.Embed, 1, 0, init_dmod))
    PrintMessage(" ")
    PrintNumber(TF_MatGet(TFW.Embed, 1, 1, init_dmod))
    PrintMessage(" ")
    PrintNumber(TF_MatGet(TFW.Embed, 1, 2, init_dmod))
    PrintMessage(" ")
    PrintNumber(TF_MatGet(TFW.Embed, 1, 3, init_dmod))
    PrintMessage("\n")

    TFAllocCarrier.rows = init_seqln
    TFAllocCarrier.cols = init_dmod
    TFAllocCarrier.range = 2
    TFLayer_AllocMatSub()
    TFW.PosEmb = TFAllocCarrier.result

    TFAllocCarrier.rows = init_dmod
    TFAllocCarrier.cols = init_dmod
    TFAllocCarrier.range = 2
    TFLayer_AllocMatSub()
    TFW.Wq = TFAllocCarrier.result

    TFAllocCarrier.rows = init_dmod
    TFAllocCarrier.cols = init_dmod
    TFAllocCarrier.range = 2
    TFLayer_AllocMatSub()
    TFW.Wk = TFAllocCarrier.result

    TFAllocCarrier.rows = init_dmod
    TFAllocCarrier.cols = init_dmod
    TFAllocCarrier.range = 2
    TFLayer_AllocMatSub()
    TFW.Wv = TFAllocCarrier.result

    TFAllocCarrier.rows = init_vocab
    TFAllocCarrier.cols = init_dmod
    TFAllocCarrier.range = 2
    TFLayer_AllocMatSub()
    TFW.Wout = TFAllocCarrier.result

    // Allocate forward cache
    TFW.emb    = TF_MatAlloc(init_seqln, init_dmod)
    TFW.qvec   = TF_MatAlloc(init_seqln, init_dmod)
    TFW.kvec   = TF_MatAlloc(init_seqln, init_dmod)
    TFW.vvec   = TF_MatAlloc(init_seqln, init_dmod)
    TFW.scores = TF_MatAlloc(init_seqln, init_seqln)
    TFW.attn   = TF_MatAlloc(init_seqln, init_seqln)
    TFW.ctx    = TF_MatAlloc(init_seqln, init_dmod)
    TFW.resid  = TF_MatAlloc(init_seqln, init_dmod)
    TFW.logits = TF_MatAlloc(init_seqln, init_vocab)
    TFW.probs  = TF_MatAlloc(init_seqln, init_vocab)

    // Allocate gradient buffers
    TFW.dEmbed  = TF_MatAlloc(init_vocab, init_dmod)
    TFW.dPosEmb = TF_MatAlloc(init_seqln, init_dmod)
    TFW.dWq     = TF_MatAlloc(init_dmod,  init_dmod)
    TFW.dWk     = TF_MatAlloc(init_dmod,  init_dmod)
    TFW.dWv     = TF_MatAlloc(init_dmod,  init_dmod)
    TFW.dWout   = TF_MatAlloc(init_vocab, init_dmod)
    TFW.dLogits = TF_MatAlloc(init_seqln, init_vocab)
    TFW.dResid  = TF_MatAlloc(init_seqln, init_dmod)
    TFW.dCtx    = TF_MatAlloc(init_seqln, init_dmod)
    TFW.dEmb    = TF_MatAlloc(init_seqln, init_dmod)
    TFW.dQ      = TF_MatAlloc(init_seqln, init_dmod)
    TFW.dK      = TF_MatAlloc(init_seqln, init_dmod)
    TFW.dV      = TF_MatAlloc(init_seqln, init_dmod)
    TFW.dScores = TF_MatAlloc(init_seqln, init_seqln)

    // Allocate token/target buffers
    TFState.tokens  = TF_VecAlloc(init_seqln)
    TFState.targets = TF_VecAlloc(init_seqln)
    TFState.step     = 0
    TFState.loss_acc = 0
    TFState.acc_num  = 0
    TFState.acc_den  = 0

    PrintMessage("[ATTN] tokens=")
    PrintNumber(TFState.tokens)
    PrintMessage(" targets=")
    PrintNumber(TFState.targets)
    PrintMessage("\n")

    // Print param count
    vd  = Multiply(init_vocab, init_dmod)
    sd  = Multiply(init_seqln, init_dmod)
    dd  = Multiply(init_dmod,  init_dmod)
    tot = Add(Add(Multiply(vd, 2), sd), Multiply(dd, 3))
    PrintMessage("[ATTN] init ok — params=")
    PrintNumber(tot)
    PrintMessage("\n\n")
}

// =============================================================================
// FORWARD — calls library functions in sequence, all state explicit
// =============================================================================
SubRoutine.ATTN_Forward {
    fwd_dmod  = TFConfig.DModel
    fwd_seqln = TFConfig.SeqLen
    fwd_vocab = TFConfig.VocabSize
    fwd_scale = TF_ISqrt(fwd_dmod)
    fwd_tok   = TFState.tokens

    TFLayer_Embed(TFW.emb, fwd_tok, TFW.Embed, TFW.PosEmb, fwd_seqln, fwd_dmod)

    NS000001_TFProjCarrier.Wk    = TFW.Wk
    NS000001_TFProjCarrier.Wv    = TFW.Wv
    NS000001_TFProjCarrier.seqln = fwd_seqln
    NS000001_TFProjCarrier.dmod  = fwd_dmod
    TFLayer_ProjQKV(TFW.qvec, TFW.kvec, TFW.vvec, TFW.emb, TFW.Wq)

    TFLayer_AttnScores(TFW.scores, TFW.qvec, TFW.kvec, fwd_seqln, fwd_dmod, fwd_scale)

    TFLayer_AttnSoftmax(TFW.attn, TFW.scores, fwd_seqln)

    TFLayer_Context(TFW.ctx, TFW.attn, TFW.vvec, fwd_seqln, fwd_dmod)

    TFLayer_Residual(TFW.resid, TFW.ctx, TFW.emb, fwd_seqln, fwd_dmod)

    NS000001_TFOutProjCarrier.seqln = fwd_seqln
    NS000001_TFOutProjCarrier.dmod  = fwd_dmod
    NS000001_TFOutProjCarrier.vocab = fwd_vocab
    TFLayer_OutputProj(TFW.logits, TFW.probs, TFW.resid, TFW.Wout)
}

// =============================================================================
// ZERO GRADS
// =============================================================================
SubRoutine.ATTN_ZeroGrads {
    zgd_dmod  = TFConfig.DModel
    zgd_seqln = TFConfig.SeqLen
    zgd_vocab = TFConfig.VocabSize

    TF_MatZero(TFW.dEmbed,  zgd_vocab, zgd_dmod)
    TF_MatZero(TFW.dPosEmb, zgd_seqln, zgd_dmod)
    TF_MatZero(TFW.dWq,     zgd_dmod,  zgd_dmod)
    TF_MatZero(TFW.dWk,     zgd_dmod,  zgd_dmod)
    TF_MatZero(TFW.dWv,     zgd_dmod,  zgd_dmod)
    TF_MatZero(TFW.dWout,   zgd_vocab, zgd_dmod)
    TF_MatZero(TFW.dLogits, zgd_seqln, zgd_vocab)
    TF_MatZero(TFW.dResid,  zgd_seqln, zgd_dmod)
    TF_MatZero(TFW.dCtx,    zgd_seqln, zgd_dmod)
    TF_MatZero(TFW.dEmb,    zgd_seqln, zgd_dmod)
    TF_MatZero(TFW.dQ,      zgd_seqln, zgd_dmod)
    TF_MatZero(TFW.dK,      zgd_seqln, zgd_dmod)
    TF_MatZero(TFW.dV,      zgd_seqln, zgd_dmod)
    TF_MatZero(TFW.dScores, zgd_seqln, zgd_seqln)
}

// =============================================================================
// BACKWARD — populates carriers then calls library functions
// =============================================================================
SubRoutine.ATTN_Backward {
    bwd_dmod  = TFConfig.DModel
    bwd_seqln = TFConfig.SeqLen
    bwd_vocab = TFConfig.VocabSize
    bwd_scale = TF_ISqrt(bwd_dmod)
    bwd_tgt   = TFState.targets
    bwd_tok   = TFState.tokens

    NS000001_TFBackOut.Wout    = TFW.Wout
    NS000001_TFBackOut.targets = bwd_tgt
    NS000001_TFBackOut.seqln   = bwd_seqln
    NS000001_TFBackOut.dmod    = bwd_dmod
    NS000001_TFBackOut.vocab   = bwd_vocab
    TFTrain_BackOutProj(TFW.dWout, TFW.dResid, TFW.dLogits, TFW.probs, TFW.resid)

    NS000001_TFBackCtx.attn  = TFW.attn
    NS000001_TFBackCtx.vvec  = TFW.vvec
    NS000001_TFBackCtx.seqln = bwd_seqln
    NS000001_TFBackCtx.dmod  = bwd_dmod
    NS000001_TFBackCtx.scale = bwd_scale
    TFTrain_BackAttnCtx(TFW.dCtx, TFW.dEmb, TFW.dV, TFW.dScores, TFW.dResid)

    NS000001_TFBackQK.seqln = bwd_seqln
    NS000001_TFBackQK.dmod  = bwd_dmod
    TFTrain_BackQK(TFW.dQ, TFW.dK, TFW.dScores, TFW.qvec, TFW.kvec)

    NS000001_TFBackWA.Wq    = TFW.Wq
    NS000001_TFBackWA.Wk    = TFW.Wk
    NS000001_TFBackWA.Wv    = TFW.Wv
    NS000001_TFBackWA.emb   = TFW.emb
    NS000001_TFBackWA.seqln = bwd_seqln
    NS000001_TFBackWA.dmod  = bwd_dmod
    NS000001_TFBackWA.dK    = TFW.dK
    NS000001_TFBackWA.dV    = TFW.dV
    TFTrain_BackWeightsA(TFW.dWq, TFW.dWk, TFW.dWv, TFW.dEmb, TFW.dQ)

    NS000001_TFBackWB.tokens = bwd_tok
    NS000001_TFBackWB.seqln  = bwd_seqln
    NS000001_TFBackWB.dmod   = bwd_dmod
    TFTrain_BackWeightsB(TFW.dEmbed, TFW.dPosEmb, TFW.dEmb)

    Debug("bwd", level=2) { PrintMessage("[DBG] bwd done\n") }
}

// =============================================================================
// SGD UPDATE
// =============================================================================
SubRoutine.ATTN_SGDUpdate {
    sgd_dmod  = TFConfig.DModel
    sgd_seqln = TFConfig.SeqLen
    sgd_vocab = TFConfig.VocabSize
    sgd_den   = TFConfig.LR_Scale
    sgd_lr_a  = TFConfig.LR_Attn
    sgd_lr_e  = TFConfig.LR_Embed
    sgd_lr_o  = TFConfig.LR_Out

    // Use integer SGD - float SGD has double-conversion bug in compiler
    TF_MatSGD(TFW.Wq,     TFW.dWq,     sgd_dmod,  sgd_dmod,  sgd_lr_a, sgd_den)
    TF_MatSGD(TFW.Wk,     TFW.dWk,     sgd_dmod,  sgd_dmod,  sgd_lr_a, sgd_den)
    TF_MatSGD(TFW.Wv,     TFW.dWv,     sgd_dmod,  sgd_dmod,  sgd_lr_a, sgd_den)
    TF_MatSGD(TFW.Embed,  TFW.dEmbed,  sgd_vocab, sgd_dmod,  sgd_lr_e, sgd_den)
    TF_MatSGD(TFW.PosEmb, TFW.dPosEmb, sgd_seqln, sgd_dmod,  sgd_lr_e, sgd_den)
    TF_MatSGD(TFW.Wout,   TFW.dWout,   sgd_vocab, sgd_dmod,  sgd_lr_o, sgd_den)
}

// =============================================================================
// GENERATE SAMPLE — fills TFState.tokens and TFState.targets
// =============================================================================
SubRoutine.ATTN_GenSample {
    gen_seqln = TFConfig.SeqLen
    gen_vocab = TFConfig.VocabSize
    gen_tok   = TFState.tokens
    gen_tgt   = TFState.targets

    gen_pos = 0
    WhileLoop LessThan(gen_pos, gen_seqln) {
        gen_rval = TF_RandMod(gen_vocab)
        TF_VecSet(gen_tok, gen_pos, gen_rval)
        gen_pos = Add(gen_pos, 1)
    }
    gen_pos = 0
    WhileLoop LessThan(gen_pos, gen_seqln) {
        gen_src = Subtract(Subtract(gen_seqln, 1), gen_pos)
        gen_val = TF_VecGet(gen_tok, gen_src)
        TF_VecSet(gen_tgt, gen_pos, gen_val)
        gen_pos = Add(gen_pos, 1)
    }
}

// =============================================================================
// TRAIN LOOP
// =============================================================================
SubRoutine.ATTN_Train {
    trn_max_steps = TFConfig.MaxSteps
    trn_log_every = TFConfig.LogEvery
    trn_seqln     = TFConfig.SeqLen
    trn_vocab     = TFConfig.VocabSize

    PrintMessage("TRAINING...\n")

    trn_step = 0
    WhileLoop LessThan(trn_step, trn_max_steps) {

        Debug("step", level=2) {
            PrintMessage("[DBG] step=")
            PrintNumber(trn_step)
            PrintMessage("\n")
        }

        ATTN_GenSample()
        ATTN_Forward()

        IfCondition EqualTo(trn_step, 0) ThenBlock: {
            PrintMessage("[DBG] --- STEP 0 FORWARD TRACE ---\n")
            PrintMessage("tokens[0]= ")
            PrintNumber(TF_VecGet(TFState.tokens, 0))
            PrintMessage(" targets[0]= ")
            PrintNumber(TF_VecGet(TFState.targets, 0))
            PrintMessage("\n")
            PrintMessage("emb[0,0] = ")
            PrintNumber(TF_MatGet(TFW.emb, 0, 0, 16))
            PrintMessage("  qvec[0,0] = ")
            PrintNumber(TF_MatGet(TFW.qvec, 0, 0, 16))
            PrintMessage("\n")
            PrintMessage("scores[0,0] = ")
            PrintNumber(TF_MatGet(TFW.scores, 0, 0, 8))
            PrintMessage("  attn[0,0] = ")
            PrintNumber(TF_MatGet(TFW.attn, 0, 0, 8))
            PrintMessage("\n")
            PrintMessage("resid[0,0..3] = ")
            PrintNumber(TF_MatGet(TFW.resid, 0, 0, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.resid, 0, 1, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.resid, 0, 2, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.resid, 0, 3, 16))
            PrintMessage("\n")
            PrintMessage("Wout[0,0..3] = ")
            PrintNumber(TF_MatGet(TFW.Wout, 0, 0, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.Wout, 0, 1, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.Wout, 0, 2, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.Wout, 0, 3, 16))
            PrintMessage("\n")
            PrintMessage("Wout[1,0..3] = ")
            PrintNumber(TF_MatGet(TFW.Wout, 1, 0, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.Wout, 1, 1, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.Wout, 1, 2, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.Wout, 1, 3, 16))
            PrintMessage("\n")
            PrintMessage("Wq[0,0..3] = ")
            PrintNumber(TF_MatGet(TFW.Wq, 0, 0, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.Wq, 0, 1, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.Wq, 0, 2, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.Wq, 0, 3, 16))
            PrintMessage("\n")
            PrintMessage("Embed[0,0..3] = ")
            PrintNumber(TF_MatGet(TFW.Embed, 0, 0, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.Embed, 0, 1, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.Embed, 0, 2, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.Embed, 0, 3, 16))
            PrintMessage("\n")
            PrintMessage("Wout[5,0..3] = ")
            PrintNumber(TF_MatGet(TFW.Wout, 5, 0, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.Wout, 5, 1, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.Wout, 5, 2, 16))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.Wout, 5, 3, 16))
            PrintMessage("\n")
            PrintMessage("logits[0,0..4] = ")
            PrintNumber(TF_MatGet(TFW.logits, 0, 0, 10))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.logits, 0, 1, 10))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.logits, 0, 2, 10))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.logits, 0, 3, 10))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.logits, 0, 4, 10))
            PrintMessage("\n")
            PrintMessage("probs[0,0..4] = ")
            PrintNumber(TF_MatGet(TFW.probs, 0, 0, 10))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.probs, 0, 1, 10))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.probs, 0, 2, 10))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.probs, 0, 3, 10))
            PrintMessage(" ")
            PrintNumber(TF_MatGet(TFW.probs, 0, 4, 10))
            PrintMessage("\n")
        }

        trn_loss = TFTrain_Loss(TFW.probs, TFState.targets, trn_seqln, trn_vocab)

        trn_correct = TFTrain_Accuracy(TFW.probs, TFState.targets, trn_seqln, trn_vocab)

        TFState.loss_acc = Add(TFState.loss_acc, trn_loss)
        TFState.acc_num  = Add(TFState.acc_num, trn_correct)
        TFState.acc_den  = Add(TFState.acc_den, trn_seqln)

        ATTN_ZeroGrads()
        ATTN_Backward()

        IfCondition EqualTo(trn_step, 0) ThenBlock: {
            PrintMessage("[DBG] --- STEP 0 GRADIENT TRACE ---\n")
            PrintMessage("dLogits[0,0] = ")
            PrintNumber(TF_MatGet(TFW.dLogits, 0, 0, 10))
            PrintMessage("  dLogits[0,tgt] = ")
            PrintNumber(TF_MatGet(TFW.dLogits, 0, TF_VecGet(TFState.targets, 0), 10))
            PrintMessage("\n")
            PrintMessage("dResid[0,0] = ")
            PrintNumber(TF_MatGet(TFW.dResid, 0, 0, 16))
            PrintMessage("  dCtx[0,0] = ")
            PrintNumber(TF_MatGet(TFW.dCtx, 0, 0, 16))
            PrintMessage("\n")
            PrintMessage("dScores[0,0] = ")
            PrintNumber(TF_MatGet(TFW.dScores, 0, 0, 8))
            PrintMessage("  dScores[0,1] = ")
            PrintNumber(TF_MatGet(TFW.dScores, 0, 1, 8))
            PrintMessage("\n")
            PrintMessage("dQ[0,0] = ")
            PrintNumber(TF_MatGet(TFW.dQ, 0, 0, 16))
            PrintMessage("  dK[0,0] = ")
            PrintNumber(TF_MatGet(TFW.dK, 0, 0, 16))
            PrintMessage("\n")
            PrintMessage("dWq[0,0] = ")
            PrintNumber(TF_MatGet(TFW.dWq, 0, 0, 16))
            PrintMessage("  dWout[0,0] = ")
            PrintNumber(TF_MatGet(TFW.dWout, 0, 0, 16))
            PrintMessage("\n")
            PrintMessage("Wq[0,0] before = ")
            PrintNumber(TF_MatGet(TFW.Wq, 0, 0, 16))
            PrintMessage("\n")
        }

        ATTN_SGDUpdate()

        IfCondition EqualTo(trn_step, 0) ThenBlock: {
            PrintMessage("[DBG] Wq[0,0] after: ")
            PrintNumber(TF_MatGet(TFW.Wq, 0, 0, 16))
            PrintMessage("\n")
        }

        trn_step = Add(trn_step, 1)

        // Logging
        trn_log_due = EqualTo(Modulo(trn_step, trn_log_every), 0)
        IfCondition EqualTo(trn_log_due, 1) ThenBlock: {
            trn_avg_loss = Divide(TFState.loss_acc, trn_log_every)
            trn_acc_pct  = 0
            IfCondition GreaterThan(TFState.acc_den, 0) ThenBlock: {
                trn_acc_pct = Divide(Multiply(TFState.acc_num, 100), TFState.acc_den)
            }
            trn_loss_int   = Divide(trn_avg_loss, 4096)
            trn_loss_frac  = Modulo(trn_avg_loss, 4096)
            trn_loss_frac4 = Divide(Multiply(trn_loss_frac, 10000), 4096)
            PrintMessage(" STEP ")
            PrintNumber(trn_step)
            PrintMessage("  LOSS=")
            PrintNumber(trn_loss_int)
            PrintMessage(".")
            IfCondition LessThan(trn_loss_frac4, 1000) ThenBlock: { PrintMessage("0") }
            IfCondition LessThan(trn_loss_frac4, 100)  ThenBlock: { PrintMessage("0") }
            IfCondition LessThan(trn_loss_frac4, 10)   ThenBlock: { PrintMessage("0") }
            PrintNumber(trn_loss_frac4)
            PrintMessage("  ACC=0.")
            IfCondition LessThan(trn_acc_pct, 10) ThenBlock: { PrintMessage("0") }
            PrintNumber(trn_acc_pct)
            PrintMessage("\n")
            TFState.loss_acc = 0
            TFState.acc_num  = 0
            TFState.acc_den  = 0
        }

        TFState.step = trn_step
    }
    PrintMessage("\n")
}

// =============================================================================
// INFERENCE
// =============================================================================
SubRoutine.ATTN_Infer {
    inf_seqln = TFConfig.SeqLen
    inf_vocab = TFConfig.VocabSize
    inf_total = 10
    inf_ok    = 0
    inf_pred  = TF_VecAlloc(inf_seqln)
    inf_prow  = TF_VecAlloc(inf_vocab)

    inf_i = 0
    WhileLoop LessThan(inf_i, inf_total) {
        ATTN_GenSample()
        ATTN_Forward()

        inf_pos = 0
        WhileLoop LessThan(inf_pos, inf_seqln) {
            inf_col = 0
            WhileLoop LessThan(inf_col, inf_vocab) {
                inf_val = TF_MatGet(TFW.probs, inf_pos, inf_col, inf_vocab)
                TF_VecSet(inf_prow, inf_col, inf_val)
                inf_col = Add(inf_col, 1)
            }
            inf_pred_val = TF_VecArgMax(inf_prow, inf_vocab)
            TF_VecSet(inf_pred, inf_pos, inf_pred_val)
            inf_pos = Add(inf_pos, 1)
        }

        inf_all = 1
        inf_pos = 0
        WhileLoop LessThan(inf_pos, inf_seqln) {
            inf_pval = TF_VecGet(inf_pred,        inf_pos)
            inf_tval = TF_VecGet(TFState.targets, inf_pos)
            IfCondition NotEqual(inf_pval, inf_tval) ThenBlock: {
                inf_all = 0
            }
            inf_pos = Add(inf_pos, 1)
        }

        inf_pos = 0
        WhileLoop LessThan(inf_pos, inf_seqln) {
            PrintNumber(TF_VecGet(TFState.tokens, inf_pos))
            PrintMessage(" ")
            inf_pos = Add(inf_pos, 1)
        }
        PrintMessage("-> ")
        inf_pos = 0
        WhileLoop LessThan(inf_pos, inf_seqln) {
            PrintNumber(TF_VecGet(inf_pred, inf_pos))
            PrintMessage(" ")
            inf_pos = Add(inf_pos, 1)
        }
        IfCondition EqualTo(inf_all, 1) ThenBlock: {
            PrintMessage(" OK\n")
            inf_ok = Add(inf_ok, 1)
        } ElseBlock: {
            PrintMessage(" FAIL\n")
        }
        inf_i = Add(inf_i, 1)
    }

    PrintMessage("\nACCURACY ")
    PrintNumber(inf_ok)
    PrintMessage("/")
    PrintNumber(inf_total)
    PrintMessage("\n")

    TF_VecFree(inf_pred, inf_seqln)
    TF_VecFree(inf_prow, inf_vocab)
}

// =============================================================================
// SHUTDOWN
// =============================================================================
SubRoutine.ATTN_Shutdown {
    sdn_dmod  = TFConfig.DModel
    sdn_seqln = TFConfig.SeqLen
    sdn_vocab = TFConfig.VocabSize

    TFAct_Shutdown()

    TF_MatFree(TFW.Embed,   sdn_vocab, sdn_dmod)
    TF_MatFree(TFW.PosEmb,  sdn_seqln, sdn_dmod)
    TF_MatFree(TFW.Wq,      sdn_dmod,  sdn_dmod)
    TF_MatFree(TFW.Wk,      sdn_dmod,  sdn_dmod)
    TF_MatFree(TFW.Wv,      sdn_dmod,  sdn_dmod)
    TF_MatFree(TFW.Wout,    sdn_vocab, sdn_dmod)
    TF_MatFree(TFW.emb,     sdn_seqln, sdn_dmod)
    TF_MatFree(TFW.qvec,    sdn_seqln, sdn_dmod)
    TF_MatFree(TFW.kvec,    sdn_seqln, sdn_dmod)
    TF_MatFree(TFW.vvec,    sdn_seqln, sdn_dmod)
    TF_MatFree(TFW.scores,  sdn_seqln, sdn_seqln)
    TF_MatFree(TFW.attn,    sdn_seqln, sdn_seqln)
    TF_MatFree(TFW.ctx,     sdn_seqln, sdn_dmod)
    TF_MatFree(TFW.resid,   sdn_seqln, sdn_dmod)
    TF_MatFree(TFW.logits,  sdn_seqln, sdn_vocab)
    TF_MatFree(TFW.probs,   sdn_seqln, sdn_vocab)
    TF_MatFree(TFW.dEmbed,  sdn_vocab, sdn_dmod)
    TF_MatFree(TFW.dPosEmb, sdn_seqln, sdn_dmod)
    TF_MatFree(TFW.dWq,     sdn_dmod,  sdn_dmod)
    TF_MatFree(TFW.dWk,     sdn_dmod,  sdn_dmod)
    TF_MatFree(TFW.dWv,     sdn_dmod,  sdn_dmod)
    TF_MatFree(TFW.dWout,   sdn_vocab, sdn_dmod)
    TF_MatFree(TFW.dLogits, sdn_seqln, sdn_vocab)
    TF_MatFree(TFW.dResid,  sdn_seqln, sdn_dmod)
    TF_MatFree(TFW.dCtx,    sdn_seqln, sdn_dmod)
    TF_MatFree(TFW.dEmb,    sdn_seqln, sdn_dmod)
    TF_MatFree(TFW.dQ,      sdn_seqln, sdn_dmod)
    TF_MatFree(TFW.dK,      sdn_seqln, sdn_dmod)
    TF_MatFree(TFW.dV,      sdn_seqln, sdn_dmod)
    TF_MatFree(TFW.dScores, sdn_seqln, sdn_seqln)

    TF_VecFree(TFState.tokens,  sdn_seqln)
    TF_VecFree(TFState.targets, sdn_seqln)

    PrintMessage("[ATTN] done\n")
}

// =============================================================================
// MAIN — entry point only, no fall-through
// =============================================================================
SubRoutine.Main {
    ATTN_Init()
    ATTN_Train()
    ATTN_Infer()
    ATTN_Shutdown()
}

// =============================================================================
// ENTRY
// =============================================================================
RunTask(Main)
