    }
}

// =============================================================================
// LINKED LIST
// =============================================================================

Function.XList.XCreate {
    Output: Address
    Body: {
        XArrays_EnsureArena()
        list = Arena_Alloc24()
        StoreValue(list, 0)
        StoreValue(Add(list, 8), 0)
        StoreValue(Add(list, 16), 0)
        ReturnValue(list)
    }
}

Function.XList.XAppend {
    Input: list: Address
    Input: value: Integer
    Output: Integer
    Body: {
        new_node = Arena_Alloc24()
        StoreValue(new_node, value)
        StoreValue(Add(new_node, 8), 0)
        head = Dereference(list)
        tail = Dereference(Add(list, 8))
        IfCondition EqualTo(head, 0) ThenBlock: {
            StoreValue(list, new_node)
            StoreValue(Add(list, 8), new_node)
        } ElseBlock: {
            StoreValue(Add(tail, 8), new_node)
            StoreValue(Add(list, 8), new_node)
        }
        size = Dereference(Add(list, 16))
        StoreValue(Add(list, 16), Add(size, 1))
        ReturnValue(1)
    }
}

Function.XList.XPrepend {
    Input: list: Address
    Input: value: Integer
    Output: Integer
    Body: {
        new_node = Arena_Alloc24()
        StoreValue(new_node, value)
        head = Dereference(list)
        StoreValue(Add(new_node, 8), head)
        StoreValue(list, new_node)
        IfCondition EqualTo(head, 0) ThenBlock: {
            StoreValue(Add(list, 8), new_node)
        }
        size = Dereference(Add(list, 16))
        StoreValue(Add(list, 16), Add(size, 1))
        ReturnValue(1)
    }
}

Function.XList.XPopFront {
    Input: list: Address
    Output: Integer
    Body: {
        head = Dereference(list)
        IfCondition EqualTo(head, 0) ThenBlock: {
            ReturnValue(0)
        }
        value = Dereference(head)
        next_node = Dereference(Add(head, 8))
        StoreValue(list, next_node)
        IfCondition EqualTo(next_node, 0) ThenBlock: {
            StoreValue(Add(list, 8), 0)
        }
        size = Dereference(Add(list, 16))
        StoreValue(Add(list, 16), Subtract(size, 1))
        Arena_Free24(head)
        ReturnValue(value)
    }
}

Function.XList.XPopBack {
    Input: list: Address
    Output: Integer
    Body: {
        tail = Dereference(Add(list, 8))
        IfCondition EqualTo(tail, 0) ThenBlock: {
            ReturnValue(0)
        }
        head = Dereference(list)
        IfCondition EqualTo(head, tail) ThenBlock: {
            value = Dereference(tail)
            Arena_Free24(tail)
            StoreValue(list, 0)
            StoreValue(Add(list, 8), 0)
            StoreValue(Add(list, 16), 0)
            ReturnValue(value)
        }
        current = head
        WhileLoop NotEqual(Dereference(Add(current, 8)), tail) {
            current = Dereference(Add(current, 8))
        }
        value = Dereference(tail)
        Arena_Free24(tail)
        StoreValue(Add(current, 8), 0)
        StoreValue(Add(list, 8), current)
        size = Dereference(Add(list, 16))
        StoreValue(Add(list, 16), Subtract(size, 1))
        ReturnValue(value)
    }
}

Function.XList.XSize {
    Input: list: Address
    Output: Integer
    Body: {
        ReturnValue(Dereference(Add(list, 16)))
    }
}

Function.XList.XDestroy {
    Input: list: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(list, 0) ThenBlock: {
            ReturnValue(0)
        }
        head = Dereference(list)
        WhileLoop NotEqual(head, 0) {
            next = Dereference(Add(head, 8))
            Arena_Free24(head)
            head = next
        }
        Arena_Free24(list)
        ReturnValue(1)
    }
}

Function.XList.XDestroyDeep {
    Input: list: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(list, 0) ThenBlock: {
            ReturnValue(0)
        }
        head = Dereference(list)
        WhileLoop NotEqual(head, 0) {
            next = Dereference(Add(head, 8))
            value = Dereference(head)
            IfCondition NotEqual(value, 0) ThenBlock: {
                value_len = StringLength(value)
                Deallocate(value, Add(value_len, 1))
            }
            Arena_Free24(head)
            head = next
        }
        Arena_Free24(list)
        ReturnValue(1)
    }
}

// =============================================================================
// UTILITY FUNCTIONS
// =============================================================================

Function.XUtil.XBinarySearch {
    Input: arr: Address
    Input: target: Integer
    Output: Integer
    Body: {
        size = XArray.XSize(arr)
        left = 0
        right = Subtract(size, 1)
        WhileLoop LessEqual(left, right) {
            mid = Divide(Add(left, right), 2)
            mid_val = XArray.XGet(arr, mid)
            IfCondition EqualTo(mid_val, target) ThenBlock: {
                ReturnValue(mid)
            }
            IfCondition LessThan(mid_val, target) ThenBlock: {
                left = Add(mid, 1)
            } ElseBlock: {
                right = Subtract(mid, 1)
            }
        }
        ReturnValue(XArrays.XNULL)
    }
}

Function.XUtil.XQuickSort {
    Input: arr: Address
    Input: low: Integer
    Input: high: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(low, high) ThenBlock: {
            pivot_index = XUtil.XPartition(arr, low, high)
            XUtil.XQuickSort(arr, low, Subtract(pivot_index, 1))
            XUtil.XQuickSort(arr, Add(pivot_index, 1), high)
        }
        ReturnValue(1)
    }
}

Function.XUtil.XPartition {
    Input: arr: Address
    Input: low: Integer
    Input: high: Integer
    Output: Integer
    Body: {
        pivot = XArray.XGet(arr, high)
        i = Subtract(low, 1)
        j = low
        WhileLoop LessThan(j, high) {
            current = XArray.XGet(arr, j)
            IfCondition LessEqual(current, pivot) ThenBlock: {
                i = Add(i, 1)
                temp = XArray.XGet(arr, i)
                XArray.XSet(arr, i, current)
                XArray.XSet(arr, j, temp)
            }
            j = Add(j, 1)
        }
        i = Add(i, 1)
        temp = XArray.XGet(arr, i)
        XArray.XSet(arr, i, pivot)
        XArray.XSet(arr, high, temp)
        ReturnValue(i)
    }
}

Function.XUtil.XFindMax {
    Input: arr: Address
    Output: Integer
    Body: {
        size = XArray.XSize(arr)
        IfCondition EqualTo(size, 0) ThenBlock: {
            ReturnValue(XArrays.XERROR)
        }
        max_val = XArray.XGet(arr, 0)
        i = 1
        WhileLoop LessThan(i, size) {
            current = XArray.XGet(arr, i)
            IfCondition GreaterThan(current, max_val) ThenBlock: {
                max_val = current
            }
            i = Add(i, 1)
        }
        ReturnValue(max_val)
    }
}

Function.XUtil.XFindMin {
    Input: arr: Address
    Output: Integer
    Body: {
        size = XArray.XSize(arr)
        IfCondition EqualTo(size, 0) ThenBlock: {
            ReturnValue(XArrays.XERROR)
        }
        min_val = XArray.XGet(arr, 0)
        i = 1
        WhileLoop LessThan(i, size) {
            current = XArray.XGet(arr, i)
            IfCondition LessThan(current, min_val) ThenBlock: {
                min_val = current
            }
            i = Add(i, 1)
        }
        ReturnValue(min_val)
    }
}

Function.XUtil.XReverse {
    Input: arr: Address
    Output: Integer
    Body: {
        size = XArray.XSize(arr)
        left = 0
        right = Subtract(size, 1)
        WhileLoop LessThan(left, right) {
            left_val = XArray.XGet(arr, left)
            right_val = XArray.XGet(arr, right)
            XArray.XSet(arr, left, right_val)
            XArray.XSet(arr, right, left_val)
            left = Add(left, 1)
            right = Subtract(right, 1)
        }
        ReturnValue(1)
    }
}

// =============================================================================
// STREAM OPERATIONS
// =============================================================================

Function.XStream.XDestroy {
    Input: stream: Address
    Output: Integer
    Body: {
        IfCondition NotEqual(stream, 0) ThenBlock: {
            size = XArray.XSize(stream)
            i = 0
            WhileLoop LessThan(i, size) {
                entry = XArray.XGet(stream, i)
                entry_size = XArray.XSize(entry)
                j = 0
                WhileLoop LessThan(j, entry_size) {
                    field_or_value = XArray.XGet(entry, j)
                    fv_len = StringLength(field_or_value)
                    Deallocate(field_or_value, Add(fv_len, 1))
                    j = Add(j, 1)
                }
                XArray.XDestroy(entry)
                i = Add(i, 1)
            }
            XArray.XDestroy(stream)
        }
        ReturnValue(1)
    }
}


// === Inlined from Arena ===
// Library.Arena.ailang
// Slab allocator for fixed-size allocations
// Eliminates per-allocation mmap overhead
//
// Design:
//   - mmap large chunks (4MB) once
//   - Divide into fixed-size blocks (24, 32, 64, 128 bytes)
//   - Free list per size class
//   - Allocate = pop from free list or bump pointer
//   - Deallocate = push to free list (instant reuse)

// =============================================================================
// CONSTANTS
// =============================================================================
FixedPool.ArenaConst {
    "CHUNK_SIZE": Initialize=4194304   
    "SLAB_24": Initialize=24
    "SLAB_32": Initialize=32
    "SLAB_64": Initialize=64
    "SLAB_128": Initialize=128
    "SLAB_256": Initialize=256
}

// =============================================================================
// SLAB STATE - One per size class
// =============================================================================
FixedPool.Slab24 {
    "chunk": Initialize=0         
    "next": Initialize=0           
    "end": Initialize=0            
    "free_list": Initialize=0     
    "alloc_count": Initialize=0     
    "free_count": Initialize=0
    "chunk_count": Initialize=0
}

FixedPool.Slab32 {
    "chunk": Initialize=0
    "next": Initialize=0
    "end": Initialize=0
    "free_list": Initialize=0
    "alloc_count": Initialize=0
    "free_count": Initialize=0
    "chunk_count": Initialize=0
}

FixedPool.Slab256 {
    "chunk": Initialize=0
    "next": Initialize=0
    "end": Initialize=0
    "free_list": Initialize=0
    "alloc_count": Initialize=0
    "free_count": Initialize=0
    "chunk_count": Initialize=0
}

FixedPool.Slab512 {
    "chunk": Initialize=0
    "next": Initialize=0
    "end": Initialize=0
    "free_list": Initialize=0
    "alloc_count": Initialize=0
    "free_count": Initialize=0
    "chunk_count": Initialize=0
}

FixedPool.Slab1024 {
    "chunk": Initialize=0
    "next": Initialize=0
    "end": Initialize=0
    "free_list": Initialize=0
    "alloc_count": Initialize=0
    "free_count": Initialize=0
    "chunk_count": Initialize=0
}

FixedPool.Slab2048 {
    "chunk": Initialize=0
    "next": Initialize=0
    "end": Initialize=0
    "free_list": Initialize=0
    "alloc_count": Initialize=0
    "free_count": Initialize=0
    "chunk_count": Initialize=0
}

FixedPool.Slab64 {
    "chunk": Initialize=0
    "next": Initialize=0
    "end": Initialize=0
    "free_list": Initialize=0
    "alloc_count": Initialize=0
    "free_count": Initialize=0
    "chunk_count": Initialize=0
}

FixedPool.Slab128 {
    "chunk": Initialize=0
    "next": Initialize=0
    "end": Initialize=0
    "free_list": Initialize=0
    "alloc_count": Initialize=0
    "free_count": Initialize=0
    "chunk_count": Initialize=0
}


FixedPool.Slab4096 {
    "chunk": Initialize=0
    "next": Initialize=0
    "end": Initialize=0
    "free_list": Initialize=0
    "alloc_count": Initialize=0
    "free_count": Initialize=0
    "chunk_count": Initialize=0
}

// General arena for large/variable allocations
FixedPool.ArenaGeneral {
    "chunk": Initialize=0
    "next": Initialize=0
    "end": Initialize=0
    "alloc_count": Initialize=0
    "chunk_count": Initialize=0
    "fallback_count": Initialize=0 
}

// =============================================================================
// INITIALIZATION
// =============================================================================
Function.Arena_Init {
    Body: {
        // Initialize 24-byte slab
        Arena_InitSlab24()
        
        // Initialize 32-byte slab
        Arena_InitSlab32()
        
        // Initialize 64-byte slab  
        Arena_InitSlab64()
        
        // Initialize 128-byte slab
        Arena_InitSlab128()
        
        // Initialize 256-byte slab
        Arena_InitSlab256()
        
        // Initialize 512-byte slab
        Arena_InitSlab512()
        
        // Initialize 1024-byte slab
        Arena_InitSlab1024()
        
        // Initialize 2048-byte slab
        Arena_InitSlab2048()
        
        // Initialize 4096-byte slab
        Arena_InitSlab4096()
        
        // Initialize general arena
        Arena_InitGeneral()
        
        ReturnValue(1)
    }
}

Function.Arena_InitSlab24 {
    Body: {
        chunk = Arena_MmapChunk()
        StoreValue(chunk, 0)
        Slab24.chunk = chunk
        Slab24.next = Add(chunk, 8)
        Slab24.end = Add(chunk, ArenaConst.CHUNK_SIZE)
        Slab24.free_list = 0
        Slab24.alloc_count = 0
        Slab24.free_count = 0
        Slab24.chunk_count = 1
    }
}

