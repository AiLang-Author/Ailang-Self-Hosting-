// === Main module ===
// === Inlined from XArrays ===
// Library.XArrays.ailang - Arena-Integrated Version (COMPLETE)
// 
// STRATEGY: Use arena for structs (24, 32, 64 bytes)
// Data storage uses ArrayCreate (proven to work)
//
// CRITICAL: This is the COMPLETE library with ALL functions restored


Debug("library.load", level=1) {
    PrintMessage("Loading XArrays Library v2.1 (Arena-Integrated, Complete)\n")
}

// ====================
// Configuration & Constants
// ====================
FixedPool.XArrays {
    "XMAX_ARRAY_SIZE": Initialize=65536
    "XMAX_HASH_BUCKETS": Initialize=127
    "XSTACK_SIZE": Initialize=1024
    "XQUEUE_SIZE": Initialize=1024
    "XNULL": Initialize=-1
    "XERROR": Initialize=-999999
    "arena_initialized": Initialize=0
}

// ====================
// Arena Initialization
// ====================
Function.XArrays_EnsureArena {
    Body: {
        IfCondition EqualTo(XArrays.arena_initialized, 0) ThenBlock: {
            Arena_Init()
            XArrays.arena_initialized = 1
        }
    }
}

// Helper to copy a string
Function.Helpers.StringCopy {
    Input: str: Address
    Output: Address
    Body: {
        IfCondition EqualTo(str, 0) ThenBlock: {
            ReturnValue(0)
        }
        len = StringLength(str)
        new_str = Allocate(Add(len, 1))
        idx = 0
        WhileLoop LessThan(idx, len) {
            SetByte(new_str, idx, GetByte(str, idx))
            idx = Add(idx, 1)
        }
        SetByte(new_str, len, 0)
        ReturnValue(new_str)
    }
}

// =============================================================================
// DYNAMIC ARRAY OPERATIONS
// =============================================================================

// Create a dynamic array with metadata
// Structure: [capacity:8, size:8, data_ptr:8] = 24 bytes
Function.XArray.XCreate {
    Input: initial_capacity: Integer
    Output: Address
    Body: {
        XArrays_EnsureArena()
        arr_struct = Arena_Alloc24()
        StoreValue(arr_struct, initial_capacity)
        StoreValue(Add(arr_struct, 8), 0)
        data = ArrayCreate(initial_capacity)
        StoreValue(Add(arr_struct, 16), data)
        ReturnValue(arr_struct)
    }
}

Function.XArray.XSize {
    Input: arr: Address
    Output: Integer
    Body: {
        ReturnValue(Dereference(Add(arr, 8)))
    }
}

Function.XArray.XCapacity {
    Input: arr: Address
    Output: Integer
    Body: {
        ReturnValue(Dereference(arr))
    }
}

Function.XArray.XPush {
    Input: arr: Address
    Input: value: Integer
    Output: Integer
    Body: {
        capacity = Dereference(arr)
        size = Dereference(Add(arr, 8))
        data = Dereference(Add(arr, 16))
        
        IfCondition GreaterEqual(size, capacity) ThenBlock: {
            new_capacity = Multiply(capacity, 2)
            new_data = ArrayCreate(new_capacity)
            copy_idx = 0
            WhileLoop LessThan(copy_idx, size) {
                old_val = ArrayGet(data, copy_idx)
                ArraySet(new_data, copy_idx, old_val)
                copy_idx = Add(copy_idx, 1)
            }
            ArrayDestroy(data)
            StoreValue(arr, new_capacity)
            StoreValue(Add(arr, 16), new_data)
            data = new_data
        }
        
        ArraySet(data, size, value)
        StoreValue(Add(arr, 8), Add(size, 1))
        ReturnValue(1)
    }
}

Function.XArray.XPop {
    Input: arr: Address
    Output: Integer
    Body: {
        size = Dereference(Add(arr, 8))
        IfCondition EqualTo(size, 0) ThenBlock: {
            ReturnValue(XArrays.XERROR)
        }
        data = Dereference(Add(arr, 16))
        new_size = Subtract(size, 1)
        value = ArrayGet(data, new_size)
        StoreValue(Add(arr, 8), new_size)
        ReturnValue(value)
    }
}

Function.XArray.XGet {
    Input: arr: Address
    Input: index: Integer
    Output: Integer
    Body: {
        size = Dereference(Add(arr, 8))
        IfCondition Or(LessThan(index, 0), GreaterEqual(index, size)) ThenBlock: {
            ReturnValue(XArrays.XERROR)
        }
        data = Dereference(Add(arr, 16))
        ReturnValue(ArrayGet(data, index))
    }
}

Function.XArray.XSet {
    Input: arr: Address
    Input: index: Integer
    Input: value: Integer
    Output: Integer
    Body: {
        size = Dereference(Add(arr, 8))
        IfCondition Or(LessThan(index, 0), GreaterEqual(index, size)) ThenBlock: {
            ReturnValue(0)
        }
        data = Dereference(Add(arr, 16))
        ArraySet(data, index, value)
        ReturnValue(1)
    }
}

Function.XArray.XClear {
    Input: arr: Address
    Output: Integer
    Body: {
        StoreValue(Add(arr, 8), 0)
        ReturnValue(1)
    }
}

Function.XArray.XDestroy {
    Input: arr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(arr, 0) ThenBlock: {
            ReturnValue(0)
        }
        data = Dereference(Add(arr, 16))
        ArrayDestroy(data)
        Arena_Free24(arr)
        ReturnValue(1)
    }
}

// Remove first element and shift all others down (O(n) operation)
Function.XArray.XShift {
    Input: array: Address
    Output: Address
    Body: {
        IfCondition EqualTo(array, 0) ThenBlock: {
            ReturnValue(0)
        }
        size_addr = Add(array, 8)
        size = Dereference(size_addr)
        IfCondition LessEqual(size, 0) ThenBlock: {
            ReturnValue(0)
        }
        first_element = XArray.XGet(array, 0)
        i = 1
        WhileLoop LessThan(i, size) {
            element = XArray.XGet(array, i)
            XArray.XSet(array, Subtract(i, 1), element)
            i = Add(i, 1)
        }
        new_size = Subtract(size, 1)
        StoreValue(size_addr, new_size)
        ReturnValue(first_element)
    }
}

// Find index of first occurrence of value
Function.XArray.XIndexOf {
    Input: arr: Address
    Input: value: Integer
    Output: Integer
    Body: {
        size = Dereference(Add(arr, 8))
        data = Dereference(Add(arr, 16))
        i = 0
        WhileLoop LessThan(i, size) {
            current = ArrayGet(data, i)
            IfCondition EqualTo(current, value) ThenBlock: {
                ReturnValue(i)
            }
            i = Add(i, 1)
        }
        ReturnValue(XArrays.XNULL)
    }
}

// Copy an array
Function.XArray.XCopy {
    Input: arr: Address
    Output: Address
    Body: {
        size = Dereference(Add(arr, 8))
        capacity = Dereference(arr)
        data = Dereference(Add(arr, 16))
        new_arr = XArray.XCreate(capacity)
        new_data = Dereference(Add(new_arr, 16))
        i = 0
        WhileLoop LessThan(i, size) {
            val = ArrayGet(data, i)
            ArraySet(new_data, i, val)
            i = Add(i, 1)
        }
        StoreValue(Add(new_arr, 8), size)
        ReturnValue(new_arr)
    }
}

// Insert element at specific index
Function.XArray.XInsert {
    Input: arr: Address
    Input: index: Integer
    Input: value: Integer
    Output: Integer
    Body: {
        capacity = Dereference(arr)
        size = Dereference(Add(arr, 8))
        data = Dereference(Add(arr, 16))
        
        IfCondition Or(LessThan(index, 0), GreaterThan(index, size)) ThenBlock: {
            ReturnValue(0)
        }
        
        IfCondition GreaterEqual(size, capacity) ThenBlock: {
            new_capacity = Multiply(capacity, 2)
            new_data = ArrayCreate(new_capacity)
            i = 0
            WhileLoop LessThan(i, size) {
                old_val = ArrayGet(data, i)
                ArraySet(new_data, i, old_val)
                i = Add(i, 1)
            }
            ArrayDestroy(data)
            StoreValue(arr, new_capacity)
            StoreValue(Add(arr, 16), new_data)
            data = new_data
        }
        
        i = size
        WhileLoop GreaterThan(i, index) {
            prev_val = ArrayGet(data, Subtract(i, 1))
            ArraySet(data, i, prev_val)
            i = Subtract(i, 1)
        }
        ArraySet(data, index, value)
        StoreValue(Add(arr, 8), Add(size, 1))
        ReturnValue(1)
    }
}

// Delete element at specific index
Function.XArray.XDelete {
    Input: arr: Address
    Input: index: Integer
    Output: Integer
    Body: {
        size = Dereference(Add(arr, 8))
        data = Dereference(Add(arr, 16))
        IfCondition Or(LessThan(index, 0), GreaterEqual(index, size)) ThenBlock: {
            ReturnValue(XArrays.XERROR)
        }
        deleted_value = ArrayGet(data, index)
        i = index
        last_idx = Subtract(size, 1)
        WhileLoop LessThan(i, last_idx) {
            next_val = ArrayGet(data, Add(i, 1))
            ArraySet(data, i, next_val)
            i = Add(i, 1)
        }
        StoreValue(Add(arr, 8), Subtract(size, 1))
        ReturnValue(deleted_value)
    }
}

Function.XArray.XContains {
    Input: arr: Address
    Input: value: Integer
    Output: Integer
    Body: {
        idx = XArray.XIndexOf(arr, value)
        IfCondition NotEqual(idx, XArrays.XNULL) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.XArray.XInsertSorted {
    Input: arr: Address
    Input: value: Integer
    Output: Integer
    Body: {
        size = Dereference(Add(arr, 8))
        data = Dereference(Add(arr, 16))
        insert_idx = size
        i = 0
        found = 0
        WhileLoop And(LessThan(i, size), EqualTo(found, 0)) {
            current = ArrayGet(data, i)
            IfCondition GreaterThan(current, value) ThenBlock: {
                insert_idx = i
                found = 1
            }
            i = Add(i, 1)
        }
        XArray.XInsert(arr, insert_idx, value)
        ReturnValue(insert_idx)
    }
}

Function.XArray.XBinarySearch {
    Input: arr: Address
    Input: value: Integer
    Output: Integer
    Body: {
        size = Dereference(Add(arr, 8))
        data = Dereference(Add(arr, 16))
        left = 0
        right = Subtract(size, 1)
        WhileLoop LessEqual(left, right) {
            mid = Divide(Add(left, right), 2)
            mid_val = ArrayGet(data, mid)
            IfCondition EqualTo(mid_val, value) ThenBlock: {
                ReturnValue(mid)
            }
            IfCondition LessThan(mid_val, value) ThenBlock: {
                left = Add(mid, 1)
            } ElseBlock: {
                right = Subtract(mid, 1)
            }
        }
        ReturnValue(XArrays.XNULL)
    }
}

Function.XArray.XSwap {
    Input: arr: Address
    Input: idx1: Integer
    Input: idx2: Integer
    Output: Integer
    Body: {
        size = Dereference(Add(arr, 8))
        IfCondition Or(LessThan(idx1, 0), GreaterEqual(idx1, size)) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition Or(LessThan(idx2, 0), GreaterEqual(idx2, size)) ThenBlock: {
            ReturnValue(0)
        }
        data = Dereference(Add(arr, 16))
        val1 = ArrayGet(data, idx1)
        val2 = ArrayGet(data, idx2)
        ArraySet(data, idx1, val2)
        ArraySet(data, idx2, val1)
        ReturnValue(1)
    }
}

Function.XArray.XLast {
    Input: arr: Address
    Output: Integer
    Body: {
        size = Dereference(Add(arr, 8))
        IfCondition EqualTo(size, 0) ThenBlock: {
            ReturnValue(XArrays.XERROR)
        }
        data = Dereference(Add(arr, 16))
        ReturnValue(ArrayGet(data, Subtract(size, 1)))
    }
}

Function.XArray.XFirst {
    Input: arr: Address
    Output: Integer
    Body: {
        size = Dereference(Add(arr, 8))
        IfCondition EqualTo(size, 0) ThenBlock: {
            ReturnValue(XArrays.XERROR)
        }
        data = Dereference(Add(arr, 16))
        ReturnValue(ArrayGet(data, 0))
    }
}

Function.XArray.XIsEmpty {
    Input: arr: Address
    Output: Integer
    Body: {
        size = Dereference(Add(arr, 8))
        IfCondition EqualTo(size, 0) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.XArray.XResize {
    Input: arr: Address
    Input: new_capacity: Integer
    Output: Integer
    Body: {
        old_capacity = Dereference(arr)
        size = Dereference(Add(arr, 8))
        old_data = Dereference(Add(arr, 16))
        IfCondition LessThan(new_capacity, size) ThenBlock: {
            new_capacity = size
        }
        new_data = ArrayCreate(new_capacity)
        i = 0
        WhileLoop LessThan(i, size) {
            val = ArrayGet(old_data, i)
            ArraySet(new_data, i, val)
            i = Add(i, 1)
        }
        ArrayDestroy(old_data)
        StoreValue(arr, new_capacity)
        StoreValue(Add(arr, 16), new_data)
        ReturnValue(1)
    }
}

// Address variants for storing pointers
Function.XArray.XInsertAddr {
    Input: arr: Address
    Input: index: Integer
    Input: value: Address
    Output: Integer
    Body: {
        ReturnValue(XArray.XInsert(arr, index, value))
    }
}

Function.XArray.XGetAddr {
    Input: arr: Address
    Input: index: Integer
    Output: Address
    Body: {
        ReturnValue(XArray.XGet(arr, index))
    }
}

Function.XArray.XDeleteAddr {
    Input: arr: Address
    Input: index: Integer
    Output: Address
    Body: {
        ReturnValue(XArray.XDelete(arr, index))
    }
}

// =============================================================================
// STACK OPERATIONS
// =============================================================================

Function.XStack.XCreate {
    Input: capacity: Integer
    Output: Address
    Body: {
        ReturnValue(XArray.XCreate(capacity))
    }
}

Function.XStack.XPush {
    Input: stack: Address
    Input: value: Integer
    Output: Integer
    Body: {
        ReturnValue(XArray.XPush(stack, value))
    }
}

Function.XStack.XPop {
    Input: stack: Address
    Output: Integer
    Body: {
        ReturnValue(XArray.XPop(stack))
    }
}

Function.XStack.XPeek {
    Input: stack: Address
    Output: Integer
    Body: {
        size = XArray.XSize(stack)
        IfCondition EqualTo(size, 0) ThenBlock: {
            ReturnValue(XArrays.XERROR)
        }
        ReturnValue(XArray.XGet(stack, Subtract(size, 1)))
    }
}

Function.XStack.XIsEmpty {
    Input: stack: Address
    Output: Integer
    Body: {
        ReturnValue(EqualTo(XArray.XSize(stack), 0))
    }
}

// =============================================================================
// QUEUE OPERATIONS
// =============================================================================

Function.XQueue.XCreate {
    Input: capacity: Integer
    Output: Address
    Body: {
        XArrays_EnsureArena()
        queue = Arena_Alloc64()
        StoreValue(queue, capacity)
        StoreValue(Add(queue, 8), 0)
        StoreValue(Add(queue, 16), 0)
        StoreValue(Add(queue, 24), 0)
        data = ArrayCreate(capacity)
        StoreValue(Add(queue, 32), data)
        ReturnValue(queue)
    }
}

Function.XQueue.XEnqueue {
    Input: queue: Address
    Input: value: Integer
    Output: Integer
    Body: {
        capacity = Dereference(queue)
        size = Dereference(Add(queue, 8))
        IfCondition GreaterEqual(size, capacity) ThenBlock: {
            ReturnValue(0)
        }
        tail = Dereference(Add(queue, 24))
        data = Dereference(Add(queue, 32))
        ArraySet(data, tail, value)
        new_tail = Modulo(Add(tail, 1), capacity)
        StoreValue(Add(queue, 24), new_tail)
        StoreValue(Add(queue, 8), Add(size, 1))
        ReturnValue(1)
    }
}

Function.XQueue.XDequeue {
    Input: queue: Address
    Output: Integer
    Body: {
        size = Dereference(Add(queue, 8))
        IfCondition EqualTo(size, 0) ThenBlock: {
            ReturnValue(XArrays.XERROR)
        }
        capacity = Dereference(queue)
        head = Dereference(Add(queue, 16))
        data = Dereference(Add(queue, 32))
        value = ArrayGet(data, head)
        new_head = Modulo(Add(head, 1), capacity)
        StoreValue(Add(queue, 16), new_head)
        StoreValue(Add(queue, 8), Subtract(size, 1))
        ReturnValue(value)
    }
}

Function.XQueue.XDestroy {
    Input: queue: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(queue, 0) ThenBlock: {
            ReturnValue(0)
        }
        data = Dereference(Add(queue, 32))
        ArrayDestroy(data)
        Arena_Free64(queue)
        ReturnValue(1)
    }
}

// =============================================================================
// HASH TABLE (Integer Keys)
// =============================================================================

Function.XHash.XHashInt {
    Input: key: Integer
    Input: buckets: Integer
    Output: Integer
    Body: {
        abs_key = key
        IfCondition LessThan(key, 0) ThenBlock: {
            abs_key = Subtract(0, key)
        }
        ReturnValue(Modulo(abs_key, buckets))
    }
}

Function.XHash.XCreate {
    Input: bucket_count: Integer
    Output: Address
    Body: {
        XArrays_EnsureArena()
        hash_table = Arena_Alloc24()
        StoreValue(hash_table, bucket_count)
        StoreValue(Add(hash_table, 8), 0)
        buckets = ArrayCreate(bucket_count)
        idx = 0
        WhileLoop LessThan(idx, bucket_count) {
            ArraySet(buckets, idx, 0)
            idx = Add(idx, 1)
        }
        StoreValue(Add(hash_table, 16), buckets)
        ReturnValue(hash_table)
    }
}

Function.XHash.XInsert {
    Input: hash_table: Address
    Input: key: Integer
    Input: value: Integer
    Output: Integer
    Body: {
        bucket_count = Dereference(hash_table)
        buckets = Dereference(Add(hash_table, 16))
        hash = XHash.XHashInt(key, bucket_count)
        new_node = Arena_Alloc24()
        StoreValue(new_node, key)
        StoreValue(Add(new_node, 8), value)
        head = ArrayGet(buckets, hash)
        StoreValue(Add(new_node, 16), head)
        ArraySet(buckets, hash, new_node)
        item_count = Dereference(Add(hash_table, 8))
        StoreValue(Add(hash_table, 8), Add(item_count, 1))
        ReturnValue(1)
    }
}

Function.XHash.XLookup {
    Input: hash_table: Address
    Input: key: Integer
    Output: Integer
    Body: {
        bucket_count = Dereference(hash_table)
        buckets = Dereference(Add(hash_table, 16))
        hash = XHash.XHashInt(key, bucket_count)
        current = ArrayGet(buckets, hash)
        WhileLoop NotEqual(current, 0) {
            node_key = Dereference(current)
            IfCondition EqualTo(node_key, key) ThenBlock: {
                ReturnValue(Dereference(Add(current, 8)))
            }
            current = Dereference(Add(current, 16))
        }
        ReturnValue(XArrays.XERROR)
    }
}

Function.XHash.XDestroy {
    Input: hash_table: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(hash_table, 0) ThenBlock: {
            ReturnValue(0)
        }
        buckets = Dereference(Add(hash_table, 16))
        bucket_count = Dereference(hash_table)
        idx = 0
        WhileLoop LessThan(idx, bucket_count) {
            current = ArrayGet(buckets, idx)
            WhileLoop NotEqual(current, 0) {
                next = Dereference(Add(current, 16))
                Arena_Free24(current)
                current = next
            }
            idx = Add(idx, 1)
        }
        ArrayDestroy(buckets)
        Arena_Free24(hash_table)
        ReturnValue(1)
    }
}

// =============================================================================
// STRING HASH TABLE (XSHash)
// =============================================================================

Function.XSHash.XCreate {
    Input: bucket_count: Integer
    Output: Address
    Body: {
        XArrays_EnsureArena()
        hash_table = Arena_Alloc24()
        StoreValue(hash_table, bucket_count)
        StoreValue(Add(hash_table, 8), 0)
        buckets = ArrayCreate(bucket_count)
        idx = 0
        WhileLoop LessThan(idx, bucket_count) {
            ArraySet(buckets, idx, 0)
            idx = Add(idx, 1)
        }
        StoreValue(Add(hash_table, 16), buckets)
        ReturnValue(hash_table)
    }
}

Function.XSHash.XInsert {
    Input: hash_table: Address
    Input: key: Address
    Input: value: Integer
    Output: Integer
    Body: {
        hash_value = 0
        idx = 0
        key_len = StringLength(key)
        WhileLoop LessThan(idx, key_len) {
            byte = GetByte(key, idx)
            hash_value = Add(Multiply(hash_value, 31), byte)
            idx = Add(idx, 1)
        }
        IfCondition LessThan(hash_value, 0) ThenBlock: {
            hash_value = Multiply(hash_value, -1)
        }
        bucket_count = Dereference(hash_table)
        bucket_idx = Modulo(hash_value, bucket_count)
        buckets = Dereference(Add(hash_table, 16))
        
        current = ArrayGet(buckets, bucket_idx)
        WhileLoop NotEqual(current, 0) {
            stored_key = Dereference(current)
            cmp = StringCompare(stored_key, key)
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                StoreValue(Add(current, 8), value)
                ReturnValue(0)
            }
            current = Dereference(Add(current, 16))
        }
        
        new_node = Arena_Alloc24()
        key_copy = Helpers.StringCopy(key)
        StoreValue(new_node, key_copy)
        StoreValue(Add(new_node, 8), value)
        head = ArrayGet(buckets, bucket_idx)
        StoreValue(Add(new_node, 16), head)
        ArraySet(buckets, bucket_idx, new_node)
        item_count = Dereference(Add(hash_table, 8))
        StoreValue(Add(hash_table, 8), Add(item_count, 1))
        ReturnValue(1)
    }
}

Function.XSHash.XLookup {
    Input: hash_table: Address
    Input: key: Address
    Output: Integer
    Body: {
        hash_value = 0
        idx = 0
        key_len = StringLength(key)
        WhileLoop LessThan(idx, key_len) {
            byte = GetByte(key, idx)
            hash_value = Add(Multiply(hash_value, 31), byte)
            idx = Add(idx, 1)
        }
        IfCondition LessThan(hash_value, 0) ThenBlock: {
            hash_value = Multiply(hash_value, -1)
        }
        bucket_count = Dereference(hash_table)
        bucket_idx = Modulo(hash_value, bucket_count)
        buckets = Dereference(Add(hash_table, 16))
        current = ArrayGet(buckets, bucket_idx)
        WhileLoop NotEqual(current, 0) {
            stored_key = Dereference(current)
            cmp = StringCompare(stored_key, key)
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                ReturnValue(Dereference(Add(current, 8)))
            }
            current = Dereference(Add(current, 16))
        }
        ReturnValue(XArrays.XNULL)
    }
}

Function.XSHash.XExists {
    Input: hash_table: Address
    Input: key: Address
    Output: Integer
    Body: {
        result = XSHash.XLookup(hash_table, key)
        ReturnValue(NotEqual(result, XArrays.XNULL))
    }
}

Function.XSHash.XDelete {
    Input: hash_table: Address
    Input: key: Address
    Output: Integer
    Body: {
        hash_value = 0
        idx = 0
        key_len = StringLength(key)
        WhileLoop LessThan(idx, key_len) {
            byte = GetByte(key, idx)
            hash_value = Add(Multiply(hash_value, 31), byte)
            idx = Add(idx, 1)
        }
        IfCondition LessThan(hash_value, 0) ThenBlock: {
            hash_value = Multiply(hash_value, -1)
        }
        bucket_count = Dereference(hash_table)
        bucket_idx = Modulo(hash_value, bucket_count)
        buckets = Dereference(Add(hash_table, 16))
        current = ArrayGet(buckets, bucket_idx)
        prev = 0
        WhileLoop NotEqual(current, 0) {
            stored_key = Dereference(current)
            cmp = StringCompare(stored_key, key)
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                value = Dereference(Add(current, 8))
                next = Dereference(Add(current, 16))
                IfCondition EqualTo(prev, 0) ThenBlock: {
                    ArraySet(buckets, bucket_idx, next)
                } ElseBlock: {
                    StoreValue(Add(prev, 16), next)
                }
                sk_len = StringLength(stored_key)
                Deallocate(stored_key, Add(sk_len, 1))
                Arena_Free24(current)
                item_count = Dereference(Add(hash_table, 8))
                StoreValue(Add(hash_table, 8), Subtract(item_count, 1))
                ReturnValue(value)
            }
            prev = current
            current = Dereference(Add(current, 16))
        }
        ReturnValue(XArrays.XNULL)
    }
}

Function.XSHash.XKeys {
    Input: hash_table: Address
    Output: Address
    Body: {
        keys = XArray.XCreate(16)
        buckets = Dereference(Add(hash_table, 16))
        bucket_count = Dereference(hash_table)
        i = 0
        WhileLoop LessThan(i, bucket_count) {
            current = ArrayGet(buckets, i)
            WhileLoop NotEqual(current, 0) {
                key = Dereference(current)
                key_copy = Helpers.StringCopy(key)
                XArray.XPush(keys, key_copy)
                current = Dereference(Add(current, 16))
            }
            i = Add(i, 1)
        }
        ReturnValue(keys)
    }
}

Function.XSHash.XDestroy {
    Input: hash_table: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(hash_table, 0) ThenBlock: {
            ReturnValue(0)
        }
        buckets = Dereference(Add(hash_table, 16))
        bucket_count = Dereference(hash_table)
        idx = 0
        WhileLoop LessThan(idx, bucket_count) {
            current = ArrayGet(buckets, idx)
            WhileLoop NotEqual(current, 0) {
                next = Dereference(Add(current, 16))
                key = Dereference(current)
                key_len = StringLength(key)
                Deallocate(key, Add(key_len, 1))
                Arena_Free24(current)
                current = next
            }
            idx = Add(idx, 1)
        }
        ArrayDestroy(buckets)
        Arena_Free24(hash_table)
        ReturnValue(1)
    }
}

// Address variants for XSHash
Function.XSHash.XInsertAddr {
    Input: hash_table: Address
    Input: key: Address
    Input: value: Address
    Output: Integer
    Body: {
        hash_value = 0
        idx = 0
        key_len = StringLength(key)
        WhileLoop LessThan(idx, key_len) {
            byte = GetByte(key, idx)
            hash_value = Add(Multiply(hash_value, 31), byte)
            idx = Add(idx, 1)
        }
        IfCondition LessThan(hash_value, 0) ThenBlock: {
            hash_value = Multiply(hash_value, -1)
        }
        bucket_count = Dereference(hash_table)
        bucket_idx = Modulo(hash_value, bucket_count)
        buckets = Dereference(Add(hash_table, 16))
        current = ArrayGet(buckets, bucket_idx)
        WhileLoop NotEqual(current, 0) {
            stored_key = Dereference(current)
            cmp = StringCompare(stored_key, key)
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                StoreValue(Add(current, 8), value)
                ReturnValue(0)
            }
            current = Dereference(Add(current, 16))
        }
        new_node = Arena_Alloc24()
        key_copy = Helpers.StringCopy(key)
        StoreValue(new_node, key_copy)
        StoreValue(Add(new_node, 8), value)
        head = ArrayGet(buckets, bucket_idx)
        StoreValue(Add(new_node, 16), head)
        ArraySet(buckets, bucket_idx, new_node)
        item_count = Dereference(Add(hash_table, 8))
        StoreValue(Add(hash_table, 8), Add(item_count, 1))
        ReturnValue(1)
    }
}

Function.XSHash.XLookupAddr {
    Input: hash_table: Address
    Input: key: Address
    Output: Address
    Body: {
        hash_value = 0
        idx = 0
        key_len = StringLength(key)
        WhileLoop LessThan(idx, key_len) {
            byte = GetByte(key, idx)
            hash_value = Add(Multiply(hash_value, 31), byte)
            idx = Add(idx, 1)
        }
        IfCondition LessThan(hash_value, 0) ThenBlock: {
            hash_value = Multiply(hash_value, -1)
        }
        bucket_count = Dereference(hash_table)
        bucket_idx = Modulo(hash_value, bucket_count)
        buckets = Dereference(Add(hash_table, 16))
        current = ArrayGet(buckets, bucket_idx)
        WhileLoop NotEqual(current, 0) {
            stored_key = Dereference(current)
            cmp = StringCompare(stored_key, key)
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                ReturnValue(Dereference(Add(current, 8)))
            }
            current = Dereference(Add(current, 16))
        }
        ReturnValue(XArrays.XNULL)
    }
}

Function.XSHash.XExistsAddr {
    Input: hash_table: Address
    Input: key: Address
    Output: Integer
    Body: {
        result = XSHash.XLookupAddr(hash_table, key)
        ReturnValue(NotEqual(result, XArrays.XNULL))
    }
}

Function.XSHash.XDeleteAddr {
    Input: hash_table: Address
    Input: key: Address
    Output: Address
    Body: {
        hash_value = 0
        idx = 0
        key_len = StringLength(key)
        WhileLoop LessThan(idx, key_len) {
            byte = GetByte(key, idx)
            hash_value = Add(Multiply(hash_value, 31), byte)
            idx = Add(idx, 1)
        }
        IfCondition LessThan(hash_value, 0) ThenBlock: {
            hash_value = Multiply(hash_value, -1)
        }
        bucket_count = Dereference(hash_table)
        bucket_idx = Modulo(hash_value, bucket_count)
        buckets = Dereference(Add(hash_table, 16))
        current = ArrayGet(buckets, bucket_idx)
        prev = 0
        WhileLoop NotEqual(current, 0) {
            stored_key = Dereference(current)
            cmp = StringCompare(stored_key, key)
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                value = Dereference(Add(current, 8))
                next = Dereference(Add(current, 16))
                IfCondition EqualTo(prev, 0) ThenBlock: {
                    ArraySet(buckets, bucket_idx, next)
                } ElseBlock: {
                    StoreValue(Add(prev, 16), next)
                }
                sk_len = StringLength(stored_key)
                Deallocate(stored_key, Add(sk_len, 1))
                Arena_Free24(current)
                item_count = Dereference(Add(hash_table, 8))
                StoreValue(Add(hash_table, 8), Subtract(item_count, 1))
                ReturnValue(value)
            }
            prev = current
            current = Dereference(Add(current, 16))
        }
        ReturnValue(XArrays.XNULL)
    }
}

// =============================================================================
// LINKED LIST
// =============================================================================

Function.XList.XCreate {
    Output: Address
    Body: {
        XArrays_EnsureArena()
        list = Arena_Alloc24()
        StoreValue(list, 0)
        StoreValue(Add(list, 8), 0)
        StoreValue(Add(list, 16), 0)
        ReturnValue(list)
    }
}

Function.XList.XAppend {
    Input: list: Address
    Input: value: Integer
    Output: Integer
    Body: {
        new_node = Arena_Alloc24()
        StoreValue(new_node, value)
        StoreValue(Add(new_node, 8), 0)
        head = Dereference(list)
        tail = Dereference(Add(list, 8))
        IfCondition EqualTo(head, 0) ThenBlock: {
            StoreValue(list, new_node)
            StoreValue(Add(list, 8), new_node)
        } ElseBlock: {
            StoreValue(Add(tail, 8), new_node)
            StoreValue(Add(list, 8), new_node)
        }
        size = Dereference(Add(list, 16))
        StoreValue(Add(list, 16), Add(size, 1))
        ReturnValue(1)
    }
}

Function.XList.XPrepend {
    Input: list: Address
    Input: value: Integer
    Output: Integer
    Body: {
        new_node = Arena_Alloc24()
        StoreValue(new_node, value)
        head = Dereference(list)
        StoreValue(Add(new_node, 8), head)
        StoreValue(list, new_node)
        IfCondition EqualTo(head, 0) ThenBlock: {
            StoreValue(Add(list, 8), new_node)
        }
        size = Dereference(Add(list, 16))
        StoreValue(Add(list, 16), Add(size, 1))
        ReturnValue(1)
    }
}

Function.XList.XPopFront {
    Input: list: Address
    Output: Integer
    Body: {
        head = Dereference(list)
        IfCondition EqualTo(head, 0) ThenBlock: {
            ReturnValue(0)
        }
        value = Dereference(head)
        next_node = Dereference(Add(head, 8))
        StoreValue(list, next_node)
        IfCondition EqualTo(next_node, 0) ThenBlock: {
            StoreValue(Add(list, 8), 0)
        }
        size = Dereference(Add(list, 16))
        StoreValue(Add(list, 16), Subtract(size, 1))
        Arena_Free24(head)
        ReturnValue(value)
    }
}

Function.XList.XPopBack {
    Input: list: Address
    Output: Integer
    Body: {
        tail = Dereference(Add(list, 8))
        IfCondition EqualTo(tail, 0) ThenBlock: {
            ReturnValue(0)
        }
        head = Dereference(list)
        IfCondition EqualTo(head, tail) ThenBlock: {
            value = Dereference(tail)
            Arena_Free24(tail)
            StoreValue(list, 0)
            StoreValue(Add(list, 8), 0)
            StoreValue(Add(list, 16), 0)
            ReturnValue(value)
        }
        current = head
        WhileLoop NotEqual(Dereference(Add(current, 8)), tail) {
            current = Dereference(Add(current, 8))
        }
        value = Dereference(tail)
        Arena_Free24(tail)
        StoreValue(Add(current, 8), 0)
        StoreValue(Add(list, 8), current)
        size = Dereference(Add(list, 16))
        StoreValue(Add(list, 16), Subtract(size, 1))
        ReturnValue(value)
    }
}

Function.XList.XSize {
    Input: list: Address
    Output: Integer
    Body: {
        ReturnValue(Dereference(Add(list, 16)))
    }
}

Function.XList.XDestroy {
    Input: list: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(list, 0) ThenBlock: {
            ReturnValue(0)
        }
        head = Dereference(list)
        WhileLoop NotEqual(head, 0) {
            next = Dereference(Add(head, 8))
            Arena_Free24(head)
            head = next
        }
        Arena_Free24(list)
        ReturnValue(1)
    }
}

Function.XList.XDestroyDeep {
    Input: list: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(list, 0) ThenBlock: {
            ReturnValue(0)
        }
        head = Dereference(list)
        WhileLoop NotEqual(head, 0) {
            next = Dereference(Add(head, 8))
            value = Dereference(head)
            IfCondition NotEqual(value, 0) ThenBlock: {
                value_len = StringLength(value)
                Deallocate(value, Add(value_len, 1))
            }
            Arena_Free24(head)
            head = next
        }
        Arena_Free24(list)
        ReturnValue(1)
    }
}

// =============================================================================
// UTILITY FUNCTIONS
// =============================================================================

Function.XUtil.XBinarySearch {
    Input: arr: Address
    Input: target: Integer
    Output: Integer
    Body: {
        size = XArray.XSize(arr)
        left = 0
        right = Subtract(size, 1)
        WhileLoop LessEqual(left, right) {
            mid = Divide(Add(left, right), 2)
            mid_val = XArray.XGet(arr, mid)
            IfCondition EqualTo(mid_val, target) ThenBlock: {
                ReturnValue(mid)
            }
            IfCondition LessThan(mid_val, target) ThenBlock: {
                left = Add(mid, 1)
            } ElseBlock: {
                right = Subtract(mid, 1)
            }
        }
        ReturnValue(XArrays.XNULL)
    }
}

Function.XUtil.XQuickSort {
    Input: arr: Address
    Input: low: Integer
    Input: high: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(low, high) ThenBlock: {
            pivot_index = XUtil.XPartition(arr, low, high)
            XUtil.XQuickSort(arr, low, Subtract(pivot_index, 1))
            XUtil.XQuickSort(arr, Add(pivot_index, 1), high)
        }
        ReturnValue(1)
    }
}

Function.XUtil.XPartition {
    Input: arr: Address
    Input: low: Integer
    Input: high: Integer
    Output: Integer
    Body: {
        pivot = XArray.XGet(arr, high)
        i = Subtract(low, 1)
        j = low
        WhileLoop LessThan(j, high) {
            current = XArray.XGet(arr, j)
            IfCondition LessEqual(current, pivot) ThenBlock: {
                i = Add(i, 1)
                temp = XArray.XGet(arr, i)
                XArray.XSet(arr, i, current)
                XArray.XSet(arr, j, temp)
            }
            j = Add(j, 1)
        }
        i = Add(i, 1)
        temp = XArray.XGet(arr, i)
        XArray.XSet(arr, i, pivot)
        XArray.XSet(arr, high, temp)
        ReturnValue(i)
    }
}

Function.XUtil.XFindMax {
    Input: arr: Address
    Output: Integer
    Body: {
        size = XArray.XSize(arr)
        IfCondition EqualTo(size, 0) ThenBlock: {
            ReturnValue(XArrays.XERROR)
        }
        max_val = XArray.XGet(arr, 0)
        i = 1
        WhileLoop LessThan(i, size) {
            current = XArray.XGet(arr, i)
            IfCondition GreaterThan(current, max_val) ThenBlock: {
                max_val = current
            }
            i = Add(i, 1)
        }
        ReturnValue(max_val)
    }
}

Function.XUtil.XFindMin {
    Input: arr: Address
    Output: Integer
    Body: {
        size = XArray.XSize(arr)
        IfCondition EqualTo(size, 0) ThenBlock: {
            ReturnValue(XArrays.XERROR)
        }
        min_val = XArray.XGet(arr, 0)
        i = 1
        WhileLoop LessThan(i, size) {
            current = XArray.XGet(arr, i)
            IfCondition LessThan(current, min_val) ThenBlock: {
                min_val = current
            }
            i = Add(i, 1)
        }
        ReturnValue(min_val)
    }
}

Function.XUtil.XReverse {
    Input: arr: Address
    Output: Integer
    Body: {
        size = XArray.XSize(arr)
        left = 0
        right = Subtract(size, 1)
        WhileLoop LessThan(left, right) {
            left_val = XArray.XGet(arr, left)
            right_val = XArray.XGet(arr, right)
            XArray.XSet(arr, left, right_val)
            XArray.XSet(arr, right, left_val)
            left = Add(left, 1)
            right = Subtract(right, 1)
        }
        ReturnValue(1)
    }
}

// =============================================================================
// STREAM OPERATIONS
// =============================================================================

Function.XStream.XDestroy {
    Input: stream: Address
    Output: Integer
    Body: {
        IfCondition NotEqual(stream, 0) ThenBlock: {
            size = XArray.XSize(stream)
            i = 0
            WhileLoop LessThan(i, size) {
                entry = XArray.XGet(stream, i)
                entry_size = XArray.XSize(entry)
                j = 0
                WhileLoop LessThan(j, entry_size) {
                    field_or_value = XArray.XGet(entry, j)
                    fv_len = StringLength(field_or_value)
                    Deallocate(field_or_value, Add(fv_len, 1))
                    j = Add(j, 1)
                }
                XArray.XDestroy(entry)
                i = Add(i, 1)
            }
            XArray.XDestroy(stream)
        }
        ReturnValue(1)
    }
}

Debug("library.load", level=1) {
    PrintMessage("XArrays v2.1 loaded - Complete arena-integrated library\n")
}

// === Inlined from Arena ===
// Library.Arena.ailang
// Slab allocator for fixed-size allocations
// Eliminates per-allocation mmap overhead
//
// Design:
//   - mmap large chunks (4MB) once
//   - Divide into fixed-size blocks (24, 32, 64, 128 bytes)
//   - Free list per size class
//   - Allocate = pop from free list or bump pointer
//   - Deallocate = push to free list (instant reuse)

// =============================================================================
// CONSTANTS
// =============================================================================
FixedPool.ArenaConst {
    "CHUNK_SIZE": Initialize=4194304   
    "SLAB_24": Initialize=24
    "SLAB_32": Initialize=32
    "SLAB_64": Initialize=64
    "SLAB_128": Initialize=128
    "SLAB_256": Initialize=256
}

// =============================================================================
// SLAB STATE - One per size class
// =============================================================================
FixedPool.Slab24 {
    "chunk": Initialize=0         
    "next": Initialize=0           
    "end": Initialize=0            
    "free_list": Initialize=0     
    "alloc_count": Initialize=0     
    "free_count": Initialize=0
    "chunk_count": Initialize=0
}

FixedPool.Slab32 {
    "chunk": Initialize=0
    "next": Initialize=0
    "end": Initialize=0
    "free_list": Initialize=0
    "alloc_count": Initialize=0
    "free_count": Initialize=0
    "chunk_count": Initialize=0
}

FixedPool.Slab64 {
    "chunk": Initialize=0
    "next": Initialize=0
    "end": Initialize=0
    "free_list": Initialize=0
    "alloc_count": Initialize=0
    "free_count": Initialize=0
    "chunk_count": Initialize=0
}

FixedPool.Slab128 {
    "chunk": Initialize=0
    "next": Initialize=0
    "end": Initialize=0
    "free_list": Initialize=0
    "alloc_count": Initialize=0
    "free_count": Initialize=0
    "chunk_count": Initialize=0
}

// General arena for large/variable allocations
FixedPool.ArenaGeneral {
    "chunk": Initialize=0
    "next": Initialize=0
    "end": Initialize=0
    "alloc_count": Initialize=0
    "chunk_count": Initialize=0
    "fallback_count": Initialize=0 
}

// =============================================================================
// INITIALIZATION
// =============================================================================
Function.Arena_Init {
    Body: {
        // Initialize 24-byte slab
        Arena_InitSlab24()
        
        // Initialize 32-byte slab
        Arena_InitSlab32()
        
        // Initialize 64-byte slab  
        Arena_InitSlab64()
        
        // Initialize 128-byte slab
        Arena_InitSlab128()
        
        // Initialize general arena
        Arena_InitGeneral()
        
        ReturnValue(1)
    }
}

Function.Arena_InitSlab24 {
    Body: {
        chunk = Arena_MmapChunk()
        Slab24.chunk = chunk
        Slab24.next = chunk
        Slab24.end = Add(chunk, ArenaConst.CHUNK_SIZE)
        Slab24.free_list = 0
        Slab24.alloc_count = 0
        Slab24.free_count = 0
        Slab24.chunk_count = 1
    }
}

Function.Arena_InitSlab32 {
    Body: {
        chunk = Arena_MmapChunk()
        Slab32.chunk = chunk
        Slab32.next = chunk
        Slab32.end = Add(chunk, ArenaConst.CHUNK_SIZE)
        Slab32.free_list = 0
        Slab32.alloc_count = 0
        Slab32.free_count = 0
        Slab32.chunk_count = 1
    }
}

Function.Arena_InitSlab64 {
    Body: {
        chunk = Arena_MmapChunk()
        Slab64.chunk = chunk
        Slab64.next = chunk
        Slab64.end = Add(chunk, ArenaConst.CHUNK_SIZE)
        Slab64.free_list = 0
        Slab64.alloc_count = 0
        Slab64.free_count = 0
        Slab64.chunk_count = 1
    }
}

Function.Arena_InitSlab128 {
    Body: {
        chunk = Arena_MmapChunk()
        Slab128.chunk = chunk
        Slab128.next = chunk
        Slab128.end = Add(chunk, ArenaConst.CHUNK_SIZE)
        Slab128.free_list = 0
        Slab128.alloc_count = 0
        Slab128.free_count = 0
        Slab128.chunk_count = 1
    }
}

Function.Arena_InitGeneral {
    Body: {
        chunk = Arena_MmapChunk()
        ArenaGeneral.chunk = chunk
        ArenaGeneral.next = chunk
        ArenaGeneral.end = Add(chunk, ArenaConst.CHUNK_SIZE)
        ArenaGeneral.alloc_count = 0
        ArenaGeneral.chunk_count = 1
        ArenaGeneral.fallback_count = 0
    }
}

// =============================================================================
// RAW MMAP - Get a new chunk from kernel
// =============================================================================
Function.Arena_MmapChunk {
    Output: Address
    Body: {
        // mmap(NULL, CHUNK_SIZE, PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANONYMOUS, -1, 0)
        // syscall 9: rdi=addr, rsi=len, rdx=prot, r10=flags, r8=fd, r9=offset
        addr = SystemCall(9, 0, ArenaConst.CHUNK_SIZE, 3, 34, -1, 0)
        
        PrintMessage("[MMAP] Got address: ")
        PrintNumber(addr)
        PrintMessage("\n")

        IfCondition LessThan(addr, 0) ThenBlock: {
            PrintMessage("[ARENA] FATAL: mmap failed!\n")
            Exit(1)
        }
        
        ReturnValue(addr)
    }
}

// =============================================================================
// SLAB 24 - Allocate/Free 24-byte blocks
// =============================================================================
Function.Arena_Alloc24 {
    Output: Address
    Body: {
        Slab24.alloc_count = Add(Slab24.alloc_count, 1)
        
        // Check free list first (instant reuse)
        IfCondition NotEqual(Slab24.free_list, 0) ThenBlock: {
            ptr = Slab24.free_list
            // Free list stores next pointer at [ptr]
            Slab24.free_list = Dereference(ptr)
            ReturnValue(ptr)
        }
        
        // Bump allocate
        IfCondition GreaterEqual(Add(Slab24.next, 24), Slab24.end) ThenBlock: {
            // Need new chunk
            Arena_GrowSlab24()
        }
        
        ptr = Slab24.next
        Slab24.next = Add(Slab24.next, 24)
        ReturnValue(ptr)
    }
}

Function.Arena_Free24 {
    Input: ptr: Address
    Body: {
        Slab24.free_count = Add(Slab24.free_count, 1)
        
        // Push to free list (store current head at ptr, update head)
        StoreValue(ptr, Slab24.free_list)
        Slab24.free_list = ptr
    }
}

Function.Arena_GrowSlab24 {
    Body: {
        // Allocate new chunk
        chunk = Arena_MmapChunk()
        Slab24.chunk = chunk
        Slab24.next = chunk
        Slab24.end = Add(chunk, ArenaConst.CHUNK_SIZE)
        Slab24.chunk_count = Add(Slab24.chunk_count, 1)
    }
}

// =============================================================================
// SLAB 32 - Allocate/Free 32-byte blocks
// =============================================================================
Function.Arena_Alloc32 {
    Output: Address
    Body: {
        Slab32.alloc_count = Add(Slab32.alloc_count, 1)
        
        IfCondition NotEqual(Slab32.free_list, 0) ThenBlock: {
            ptr = Slab32.free_list
            Slab32.free_list = Dereference(ptr)
            ReturnValue(ptr)
        }
        
        IfCondition GreaterEqual(Add(Slab32.next, 32), Slab32.end) ThenBlock: {
            Arena_GrowSlab32()
        }
        
        ptr = Slab32.next
        Slab32.next = Add(Slab32.next, 32)
        ReturnValue(ptr)
    }
}

Function.Arena_Free32 {
    Input: ptr: Address
    Body: {
        Slab32.free_count = Add(Slab32.free_count, 1)
        StoreValue(ptr, Slab32.free_list)
        Slab32.free_list = ptr
    }
}

Function.Arena_GrowSlab32 {
    Body: {
        chunk = Arena_MmapChunk()
        Slab32.chunk = chunk
        Slab32.next = chunk
        Slab32.end = Add(chunk, ArenaConst.CHUNK_SIZE)
        Slab32.chunk_count = Add(Slab32.chunk_count, 1)
    }
}

// =============================================================================
// SLAB 64 - Allocate/Free 64-byte blocks
// =============================================================================
Function.Arena_Alloc64 {
    Output: Address
    Body: {
        Slab64.alloc_count = Add(Slab64.alloc_count, 1)
        
        IfCondition NotEqual(Slab64.free_list, 0) ThenBlock: {
            ptr = Slab64.free_list
            Slab64.free_list = Dereference(ptr)
            ReturnValue(ptr)
        }
        
        IfCondition GreaterEqual(Add(Slab64.next, 64), Slab64.end) ThenBlock: {
            Arena_GrowSlab64()
        }
        
        ptr = Slab64.next
        Slab64.next = Add(Slab64.next, 64)
        ReturnValue(ptr)
    }
}

Function.Arena_Free64 {
    Input: ptr: Address
    Body: {
        Slab64.free_count = Add(Slab64.free_count, 1)
        StoreValue(ptr, Slab64.free_list)
        Slab64.free_list = ptr
    }
}

Function.Arena_GrowSlab64 {
    Body: {
        chunk = Arena_MmapChunk()
        Slab64.chunk = chunk
        Slab64.next = chunk
        Slab64.end = Add(chunk, ArenaConst.CHUNK_SIZE)
        Slab64.chunk_count = Add(Slab64.chunk_count, 1)
    }
}

// =============================================================================
// SLAB 128 - Allocate/Free 128-byte blocks  
// =============================================================================
Function.Arena_Alloc128 {
    Output: Address
    Body: {
        Slab128.alloc_count = Add(Slab128.alloc_count, 1)
        
        IfCondition NotEqual(Slab128.free_list, 0) ThenBlock: {
            ptr = Slab128.free_list
            Slab128.free_list = Dereference(ptr)
            ReturnValue(ptr)
        }
        
        IfCondition GreaterEqual(Add(Slab128.next, 128), Slab128.end) ThenBlock: {
            Arena_GrowSlab128()
        }
        
        ptr = Slab128.next
        Slab128.next = Add(Slab128.next, 128)
        ReturnValue(ptr)
    }
}

Function.Arena_Free128 {
    Input: ptr: Address
    Body: {
        Slab128.free_count = Add(Slab128.free_count, 1)
        StoreValue(ptr, Slab128.free_list)
        Slab128.free_list = ptr
    }
}

Function.Arena_GrowSlab128 {
    Body: {
        chunk = Arena_MmapChunk()
        Slab128.chunk = chunk
        Slab128.next = chunk
        Slab128.end = Add(chunk, ArenaConst.CHUNK_SIZE)
        Slab128.chunk_count = Add(Slab128.chunk_count, 1)
    }
}

// =============================================================================
// GENERAL ALLOCATOR - For variable/large sizes
// =============================================================================
Function.Arena_AllocGeneral {
    Input: size: Integer
    Output: Address
    Body: {
        ArenaGeneral.alloc_count = Add(ArenaGeneral.alloc_count, 1)
        
        // Align to 8 bytes
        aligned = BitwiseAnd(Add(size, 7), -8)
        
        // If too large, fall back to direct mmap
        IfCondition GreaterThan(aligned, 65536) ThenBlock: {
            ArenaGeneral.fallback_count = Add(ArenaGeneral.fallback_count, 1)
            ReturnValue(Arena_MmapDirect(aligned))
        }
        
        // Check if fits in current chunk
        IfCondition GreaterEqual(Add(ArenaGeneral.next, aligned), ArenaGeneral.end) ThenBlock: {
            Arena_GrowGeneral()
        }
        
        ptr = ArenaGeneral.next
        ArenaGeneral.next = Add(ArenaGeneral.next, aligned)
        ReturnValue(ptr)
    }
}

Function.Arena_GrowGeneral {
    Body: {
        chunk = Arena_MmapChunk()
        ArenaGeneral.chunk = chunk
        ArenaGeneral.next = chunk
        ArenaGeneral.end = Add(chunk, ArenaConst.CHUNK_SIZE)
        ArenaGeneral.chunk_count = Add(ArenaGeneral.chunk_count, 1)
    }
}

Function.Arena_MmapDirect {
    Input: size: Integer
    Output: Address
    Body: {
        // Round up to page size
        page_size = 4096
        pages = Divide(Add(size, 4095), 4096)
        total = Multiply(pages, page_size)
        
        addr = SystemCall(9, 0, total, 3, 34, -1, 0)
        ReturnValue(addr)
    }
}

// =============================================================================
// UNIFIED ALLOCATOR - Replaces Allocate()
// Routes to appropriate slab based on size
// =============================================================================
Function.Arena_Alloc {
    Input: size: Integer
    Output: Address
    Body: {
        // Route to appropriate slab
        IfCondition LessEqual(size, 24) ThenBlock: {
            ReturnValue(Arena_Alloc24())
        }
        
        IfCondition LessEqual(size, 32) ThenBlock: {
            ReturnValue(Arena_Alloc32())
        }
        
        IfCondition LessEqual(size, 64) ThenBlock: {
            ReturnValue(Arena_Alloc64())
        }
        
        IfCondition LessEqual(size, 128) ThenBlock: {
            ReturnValue(Arena_Alloc128())
        }
        
        // Larger sizes go to general arena
        ReturnValue(Arena_AllocGeneral(size))
    }
}

// =============================================================================
// UNIFIED FREE - Replaces Deallocate()
// Routes to appropriate slab based on size
// =============================================================================
Function.Arena_Free {
    Input: ptr: Address
    Input: size: Integer
    Body: {
        IfCondition EqualTo(ptr, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        IfCondition LessEqual(size, 24) ThenBlock: {
            Arena_Free24(ptr)
            ReturnValue(1)
        }
        
        IfCondition LessEqual(size, 32) ThenBlock: {
            Arena_Free32(ptr)
            ReturnValue(1)
        }
        
        IfCondition LessEqual(size, 64) ThenBlock: {
            Arena_Free64(ptr)
            ReturnValue(1)
        }
        
        IfCondition LessEqual(size, 128) ThenBlock: {
            Arena_Free128(ptr)
            ReturnValue(1)
        }
        
        // Large allocations: can't easily free (would need tracking)
        // For now, just leak - arena cleanup handles it
        ReturnValue(0)
    }
}

// =============================================================================
// DIAGNOSTICS
// =============================================================================
Function.Arena_Report {
    Body: {
        PrintMessage("\n========== ARENA MEMORY REPORT ==========\n")
        
        PrintMessage("Slab 24-byte:\n")
        PrintMessage("  Chunks: ")
        PrintNumber(Slab24.chunk_count)
        PrintMessage(" (")
        PrintNumber(Multiply(Slab24.chunk_count, 4))
        PrintMessage(" MB)\n")
        PrintMessage("  Allocs: ")
        PrintNumber(Slab24.alloc_count)
        PrintMessage("\n  Frees: ")
        PrintNumber(Slab24.free_count)
        PrintMessage("\n  In use: ")
        PrintNumber(Subtract(Slab24.alloc_count, Slab24.free_count))
        PrintMessage("\n")
        
        PrintMessage("Slab 32-byte:\n")
        PrintMessage("  Chunks: ")
        PrintNumber(Slab32.chunk_count)
        PrintMessage("\n  Allocs: ")
        PrintNumber(Slab32.alloc_count)
        PrintMessage("\n  Frees: ")
        PrintNumber(Slab32.free_count)
        PrintMessage("\n")
        
        PrintMessage("Slab 64-byte:\n")
        PrintMessage("  Chunks: ")
        PrintNumber(Slab64.chunk_count)
        PrintMessage("\n  Allocs: ")
        PrintNumber(Slab64.alloc_count)
        PrintMessage("\n  Frees: ")
        PrintNumber(Slab64.free_count)
        PrintMessage("\n")
        
        PrintMessage("Slab 128-byte:\n")
        PrintMessage("  Chunks: ")
        PrintNumber(Slab128.chunk_count)
        PrintMessage("\n  Allocs: ")
        PrintNumber(Slab128.alloc_count)
        PrintMessage("\n  Frees: ")
        PrintNumber(Slab128.free_count)
        PrintMessage("\n")
        
        PrintMessage("General arena:\n")
        PrintMessage("  Chunks: ")
        PrintNumber(ArenaGeneral.chunk_count)
        PrintMessage("\n  Allocs: ")
        PrintNumber(ArenaGeneral.alloc_count)
        PrintMessage("\n  Fallbacks: ")
        PrintNumber(ArenaGeneral.fallback_count)
        PrintMessage("\n")
        
        total_chunks = Add(Slab24.chunk_count, Slab32.chunk_count)
        total_chunks = Add(total_chunks, Slab64.chunk_count)
        total_chunks = Add(total_chunks, Slab128.chunk_count)
        total_chunks = Add(total_chunks, ArenaGeneral.chunk_count)
        
        PrintMessage("Total: ")
        PrintNumber(total_chunks)
        PrintMessage(" chunks = ")
        PrintNumber(Multiply(total_chunks, 4))
        PrintMessage(" MB\n")
        PrintMessage("=========================================\n")
    }
}

