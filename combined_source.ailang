// =============================================================================
// TABLE ACCESS
// FixedPool fields aren't array-indexable at runtime, so we copy
// both tables into flat heap buffers at init time.
// TFActState holds the pointers.
// =============================================================================
FixedPool.TFActState {
    "exp_tbl": Initialize=0
    "log_tbl": Initialize=0
}

SubRoutine.TFAct_Init {
    // Allocate and populate exp table (256 entries)
    etbl = Allocate(Multiply(256, TFElem.Size))
    StoreValue(Add(etbl, Multiply(0,   TFElem.Size)), TFExpTbl.e000)
    StoreValue(Add(etbl, Multiply(1,   TFElem.Size)), TFExpTbl.e001)
