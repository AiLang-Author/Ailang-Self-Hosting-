// =============================================================================
// IMPORT RESOLVER - CONFLICT-ONLY PREFIXING
// Matches Python reference implementation logic
// ALL FUNCTION CALLS FLATTENED - no nested calls as arguments
// =============================================================================


// =============================================================================
// STATE STRUCTURE
// =============================================================================
// [0]:   loaded_paths      - XArray of file path hashes
// [8]:   loaded_content    - XArray of file content pointers
// [16]:  loaded_names      - XArray of module name pointers
// [24]:  symbol_names      - XArray of all symbol names
// [32]:  symbol_modules    - XArray of module index for each symbol
// [40]:  conflict_symbols  - XArray of symbols that have conflicts
// [48]:  module_prefixes   - XArray of prefix per module (0 if no conflicts)
// [56]:  prefix_counter    - Counter for generating prefixes
// [64]:  error_count       - Error count
// [72]:  lib_base          - "Librarys" string

Function.Import_Init {
    Output: Address
    Body: {
        state = Allocate(80)
        
        arr_paths = XArray.XCreate(64)
        StoreValue(state, arr_paths)
        
        ptr8 = Add(state, 8)
        arr_content = XArray.XCreate(64)
        StoreValue(ptr8, arr_content)
        
        ptr16 = Add(state, 16)
        arr_names = XArray.XCreate(64)
        StoreValue(ptr16, arr_names)
        
        ptr24 = Add(state, 24)
        arr_sym_names = XArray.XCreate(1024)
        StoreValue(ptr24, arr_sym_names)
        
        ptr32 = Add(state, 32)
        arr_sym_mods = XArray.XCreate(1024)
        StoreValue(ptr32, arr_sym_mods)
        
        ptr40 = Add(state, 40)
        arr_conflicts = XArray.XCreate(256)
        StoreValue(ptr40, arr_conflicts)
        
        ptr48 = Add(state, 48)
        arr_prefixes = XArray.XCreate(64)
        StoreValue(ptr48, arr_prefixes)
        
        ptr56 = Add(state, 56)
        StoreValue(ptr56, 1)
        
        ptr64 = Add(state, 64)
        StoreValue(ptr64, 0)
        
        lib_base = Allocate(9)
        SetByte(lib_base, 0, 76)
        SetByte(lib_base, 1, 105)
        SetByte(lib_base, 2, 98)
        SetByte(lib_base, 3, 114)
        SetByte(lib_base, 4, 97)
        SetByte(lib_base, 5, 114)
        SetByte(lib_base, 6, 121)
        SetByte(lib_base, 7, 115)
        SetByte(lib_base, 8, 0)
        ptr72 = Add(state, 72)
        StoreValue(ptr72, lib_base)
        
        ReturnValue(state)
    }
}

// =============================================================================
// STRING HELPERS
// =============================================================================
Function.Import_CopyStr {
    Input: str: Address
    Output: Address
    Body: {
        IfCondition EqualTo(str, 0) ThenBlock: {
            ReturnValue(0)
        }
        len = StringLength(str)
        alloc_size = Add(len, 1)
        copy = Allocate(alloc_size)
        i = 0
        WhileLoop LessThan(i, len) {
            c = GetByte(str, i)
            SetByte(copy, i, c)
            i = Add(i, 1)
        }
        SetByte(copy, len, 0)
        ReturnValue(copy)
    }
}

Function.Import_StrEqual {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(a, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(b, 0) ThenBlock: {
            ReturnValue(0)
        }
        result = StringCompare(a, b)
        IfCondition EqualTo(result, 0) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.Import_HashString {
    Input: str: Address
    Output: Integer
    Body: {
        hash = 5381
        len = StringLength(str)
        i = 0
        WhileLoop LessThan(i, len) {
            c = GetByte(str, i)
            mult = Multiply(hash, 33)
            hash = Add(mult, c)
            i = Add(i, 1)
        }
        ReturnValue(hash)
    }
}

// =============================================================================
// PREFIX GENERATION
// =============================================================================
Function.Import_GenPrefix {
    Input: state: Address
    Output: Address
    Body: {
        ptr56 = Add(state, 56)
        counter = Dereference(ptr56)
        
        prefix = Allocate(9)
        SetByte(prefix, 0, 78)
        SetByte(prefix, 1, 83)
        
        val = counter
        i = 7
        WhileLoop GreaterEqual(i, 2) {
            digit = Modulo(val, 36)
            IfCondition LessThan(digit, 10) ThenBlock: {
                ch = Add(48, digit)
                SetByte(prefix, i, ch)
            } ElseBlock: {
                ch = Add(55, digit)
                SetByte(prefix, i, ch)
            }
            val = Divide(val, 36)
            i = Subtract(i, 1)
        }
        SetByte(prefix, 8, 0)
        
        new_counter = Add(counter, 1)
        StoreValue(ptr56, new_counter)
        ReturnValue(prefix)
    }
}

// =============================================================================
// SYMBOL TRACKING
// =============================================================================
Function.Import_RecordSymbol {
    Input: state: Address
    Input: symbol: Address
    Input: module_idx: Integer
    Body: {
        ptr24 = Add(state, 24)
        symbol_names = Dereference(ptr24)
        ptr32 = Add(state, 32)
        symbol_modules = Dereference(ptr32)
        
        sym_copy = Import_CopyStr(symbol)
        XArray.XPush(symbol_names, sym_copy)
        XArray.XPush(symbol_modules, module_idx)
    }
}

// =============================================================================
// CONFLICT DETECTION
// =============================================================================
Function.Import_DetectConflicts {
    Input: state: Address
    Body: {
        ptr24 = Add(state, 24)
        symbol_names = Dereference(ptr24)
        ptr32 = Add(state, 32)
        symbol_modules = Dereference(ptr32)
        ptr40 = Add(state, 40)
        conflict_symbols = Dereference(ptr40)
        
        count = XArray.XSize(symbol_names)
        
        PrintMessage("[IMPORT] Checking ")
        PrintNumber(count)
        PrintMessage(" symbols for conflicts\n")
        
        i = 0
        WhileLoop LessThan(i, count) {
            sym_i = XArray.XGet(symbol_names, i)
            mod_i = XArray.XGet(symbol_modules, i)
            
            already_conflict = Import_IsInConflictList(state, sym_i)
            
            IfCondition EqualTo(already_conflict, 0) ThenBlock: {
                j = Add(i, 1)
                WhileLoop LessThan(j, count) {
                    sym_j = XArray.XGet(symbol_names, j)
                    mod_j = XArray.XGet(symbol_modules, j)
                    
                    IfCondition NotEqual(mod_i, mod_j) ThenBlock: {
                        is_same = Import_StrEqual(sym_i, sym_j)
                        IfCondition EqualTo(is_same, 1) ThenBlock: {
                            sym_copy = Import_CopyStr(sym_i)
                            XArray.XPush(conflict_symbols, sym_copy)
                            
                            PrintMessage("[IMPORT] Conflict: ")
                            PrintMessage(sym_i)
                            PrintMessage(" in modules ")
                            PrintNumber(mod_i)
                            PrintMessage(" and ")
                            PrintNumber(mod_j)
                            PrintMessage("\n")
                            
                            j = count
                        }
                    }
                    j = Add(j, 1)
                }
            }
            i = Add(i, 1)
        }
        
        num_conflicts = XArray.XSize(conflict_symbols)
        PrintMessage("[IMPORT] Found ")
        PrintNumber(num_conflicts)
        PrintMessage(" conflicting symbols\n")
    }
}

Function.Import_IsInConflictList {
    Input: state: Address
    Input: symbol: Address
    Output: Integer
    Body: {
        ptr40 = Add(state, 40)
        conflict_symbols = Dereference(ptr40)
        count = XArray.XSize(conflict_symbols)
        
        i = 0
        WhileLoop LessThan(i, count) {
            existing = XArray.XGet(conflict_symbols, i)
            is_eq = Import_StrEqual(existing, symbol)
            IfCondition EqualTo(is_eq, 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// ASSIGN PREFIXES
// =============================================================================
Function.Import_AssignPrefixes {
    Input: state: Address
    Body: {
        ptr24 = Add(state, 24)
        symbol_names = Dereference(ptr24)
        ptr32 = Add(state, 32)
        symbol_modules = Dereference(ptr32)
        ptr40 = Add(state, 40)
        conflict_symbols = Dereference(ptr40)
        ptr48 = Add(state, 48)
        module_prefixes = Dereference(ptr48)
        ptr8 = Add(state, 8)
        loaded_content = Dereference(ptr8)
        
        num_modules = XArray.XSize(loaded_content)
        num_conflicts = XArray.XSize(conflict_symbols)
        
        num_plus_one = Add(num_modules, 1)
        i = 0
        WhileLoop LessThan(i, num_plus_one) {
            XArray.XPush(module_prefixes, 0)
            i = Add(i, 1)
        }
        
        i = 0
        WhileLoop LessThan(i, num_conflicts) {
            conflict_sym = XArray.XGet(conflict_symbols, i)
            
            sym_count = XArray.XSize(symbol_names)
            j = 0
            WhileLoop LessThan(j, sym_count) {
                sym = XArray.XGet(symbol_names, j)
                is_eq = Import_StrEqual(sym, conflict_sym)
                IfCondition EqualTo(is_eq, 1) ThenBlock: {
                    mod_idx = XArray.XGet(symbol_modules, j)
                    
                    existing = XArray.XGet(module_prefixes, mod_idx)
                    IfCondition EqualTo(existing, 0) ThenBlock: {
                        prefix = Import_GenPrefix(state)
                        XArray.XSet(module_prefixes, mod_idx, prefix)
                        
                        PrintMessage("[IMPORT] Module ")
                        PrintNumber(mod_idx)
                        PrintMessage(" gets prefix ")
                        PrintMessage(prefix)
                        PrintMessage("\n")
                    }
                }
                j = Add(j, 1)
            }
            i = Add(i, 1)
        }
    }
}

// =============================================================================
// BUILD REWRITE MAP
// =============================================================================
Function.Import_BuildRewriteMap {
    Input: state: Address
    Output: Address
    Body: {
        rewrite_map = XArray.XCreate(256)
        
        ptr24 = Add(state, 24)
        symbol_names = Dereference(ptr24)
        ptr32 = Add(state, 32)
        symbol_modules = Dereference(ptr32)
        ptr40 = Add(state, 40)
        conflict_symbols = Dereference(ptr40)
        ptr48 = Add(state, 48)
        module_prefixes = Dereference(ptr48)
        
        num_conflicts = XArray.XSize(conflict_symbols)
        sym_count = XArray.XSize(symbol_names)
        
        i = 0
        WhileLoop LessThan(i, num_conflicts) {
            conflict_sym = XArray.XGet(conflict_symbols, i)
            
            j = 0
            WhileLoop LessThan(j, sym_count) {
                sym = XArray.XGet(symbol_names, j)
                is_eq = Import_StrEqual(sym, conflict_sym)
                IfCondition EqualTo(is_eq, 1) ThenBlock: {
                    mod_idx = XArray.XGet(symbol_modules, j)
                    prefix = XArray.XGet(module_prefixes, mod_idx)
                    
                    IfCondition NotEqual(prefix, 0) ThenBlock: {
                        prefixed = Import_BuildPrefixed(prefix, sym)
                        
                        sym_copy = Import_CopyStr(sym)
                        XArray.XPush(rewrite_map, sym_copy)
                        XArray.XPush(rewrite_map, mod_idx)
                        XArray.XPush(rewrite_map, prefixed)
                    }
                }
                j = Add(j, 1)
            }
            i = Add(i, 1)
        }
        
        ReturnValue(rewrite_map)
    }
}

Function.Import_BuildPrefixed {
    Input: prefix: Address
    Input: symbol: Address
    Output: Address
    Body: {
        pre_len = StringLength(prefix)
        sym_len = StringLength(symbol)
        mid = Add(pre_len, 1)
        total = Add(mid, sym_len)
        alloc_size = Add(total, 1)
        
        result = Allocate(alloc_size)
        pos = 0
        
        i = 0
        WhileLoop LessThan(i, pre_len) {
            c = GetByte(prefix, i)
            SetByte(result, pos, c)
            pos = Add(pos, 1)
            i = Add(i, 1)
        }
        
        SetByte(result, pos, 95)
        pos = Add(pos, 1)
        
        i = 0
        WhileLoop LessThan(i, sym_len) {
            c = GetByte(symbol, i)
            SetByte(result, pos, c)
            pos = Add(pos, 1)
            i = Add(i, 1)
        }
        
        SetByte(result, total, 0)
        ReturnValue(result)
    }
}

// =============================================================================
// GET PREFIXED SYMBOL FOR A MODULE
// =============================================================================
// =============================================================================
// GET PREFIXED SYMBOL FOR A MODULE
// PATCHED: Returns prefixed name if symbol is in rewrite map, regardless of
// which module is currently being processed. This ensures cross-module calls
// (e.g., XArrays calling Arena_Init) get rewritten properly.
// =============================================================================
Function.Import_GetPrefixedFor {
    Input: rewrite_map: Address
    Input: symbol: Address
    Input: module_idx: Integer
    Output: Address
    Body: {
        count = XArray.XSize(rewrite_map)
        
        i = 0
        WhileLoop LessThan(i, count) {
            i1 = Add(i, 1)
            i2 = Add(i, 2)
            map_sym = XArray.XGet(rewrite_map, i)
            map_mod = XArray.XGet(rewrite_map, i1)
            map_pre = XArray.XGet(rewrite_map, i2)
            
            // Check if symbol matches - return first matching prefix
            // Don't filter by module_idx; we want to rewrite ALL calls
            // to conflicting symbols, not just calls within the defining module
            is_eq = Import_StrEqual(map_sym, symbol)
            IfCondition EqualTo(is_eq, 1) ThenBlock: {
                ReturnValue(map_pre)
            }
            
            i = Add(i, 3)
        }
        
        ReturnValue(0)
    }
}

// =============================================================================
// SYMBOL TYPE DETECTION
// =============================================================================
Function.Import_GetSymbolType {
    Input: source: Address
    Input: start: Integer
    Input: len: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(len, 9) ThenBlock: {
            ReturnValue(0)
        }
        
        IfCondition GreaterEqual(len, 9) ThenBlock: {
            match = Import_MatchPrefix(source, start, "Function.")
            IfCondition EqualTo(match, 1) ThenBlock: {
                ReturnValue(1)
            }
        }
        
        IfCondition GreaterEqual(len, 11) ThenBlock: {
            match = Import_MatchPrefix(source, start, "SubRoutine.")
            IfCondition EqualTo(match, 1) ThenBlock: {
                ReturnValue(2)
            }
        }
        
        IfCondition GreaterEqual(len, 10) ThenBlock: {
            match = Import_MatchPrefix(source, start, "FixedPool.")
            IfCondition EqualTo(match, 1) ThenBlock: {
                ReturnValue(3)
            }
        }
        
        IfCondition GreaterEqual(len, 12) ThenBlock: {
            match = Import_MatchPrefix(source, start, "DynamicPool.")
            IfCondition EqualTo(match, 1) ThenBlock: {
                ReturnValue(4)
            }
        }
        
        IfCondition GreaterEqual(len, 13) ThenBlock: {
            match = Import_MatchPrefix(source, start, "TemporalPool.")
            IfCondition EqualTo(match, 1) ThenBlock: {
                ReturnValue(5)
            }
        }
        
        IfCondition GreaterEqual(len, 11) ThenBlock: {
            match = Import_MatchPrefix(source, start, "NeuralPool.")
            IfCondition EqualTo(match, 1) ThenBlock: {
                ReturnValue(6)
            }
        }
        
        IfCondition GreaterEqual(len, 11) ThenBlock: {
            match = Import_MatchPrefix(source, start, "KernelPool.")
            IfCondition EqualTo(match, 1) ThenBlock: {
                ReturnValue(7)
            }
        }
        
        IfCondition GreaterEqual(len, 10) ThenBlock: {
            match = Import_MatchPrefix(source, start, "ActorPool.")
            IfCondition EqualTo(match, 1) ThenBlock: {
                ReturnValue(8)
            }
        }
        
        IfCondition GreaterEqual(len, 13) ThenBlock: {
            match = Import_MatchPrefix(source, start, "SecurityPool.")
            IfCondition EqualTo(match, 1) ThenBlock: {
                ReturnValue(9)
            }
        }
        
        IfCondition GreaterEqual(len, 16) ThenBlock: {
            match = Import_MatchPrefix(source, start, "ConstrainedPool.")
            IfCondition EqualTo(match, 1) ThenBlock: {
                ReturnValue(10)
            }
        }
        
        IfCondition GreaterEqual(len, 9) ThenBlock: {
            match = Import_MatchPrefix(source, start, "FilePool.")
            IfCondition EqualTo(match, 1) ThenBlock: {
                ReturnValue(11)
            }
        }
        
        IfCondition GreaterEqual(len, 12) ThenBlock: {
            match = Import_MatchPrefix(source, start, "LinkagePool.")
            IfCondition EqualTo(match, 1) ThenBlock: {
                ReturnValue(12)
            }
        }
        
        ReturnValue(0)
    }
}

Function.Import_MatchPrefix {
    Input: source: Address
    Input: start: Integer
    Input: pattern: Address
    Output: Integer
    Body: {
        pat_len = StringLength(pattern)
        i = 0
        WhileLoop LessThan(i, pat_len) {
            src_pos = Add(start, i)
            src_char = GetByte(source, src_pos)
            pat_char = GetByte(pattern, i)
            IfCondition NotEqual(src_char, pat_char) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

// =============================================================================
// GET KEYWORD LENGTH
// =============================================================================
Function.Import_GetKeywordLen {
    Input: sym_type: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sym_type, 1) ThenBlock: { ReturnValue(9) }
        IfCondition EqualTo(sym_type, 2) ThenBlock: { ReturnValue(11) }
        IfCondition EqualTo(sym_type, 3) ThenBlock: { ReturnValue(10) }
        IfCondition EqualTo(sym_type, 4) ThenBlock: { ReturnValue(12) }
        IfCondition EqualTo(sym_type, 5) ThenBlock: { ReturnValue(13) }
        IfCondition EqualTo(sym_type, 6) ThenBlock: { ReturnValue(11) }
        IfCondition EqualTo(sym_type, 7) ThenBlock: { ReturnValue(11) }
        IfCondition EqualTo(sym_type, 8) ThenBlock: { ReturnValue(10) }
        IfCondition EqualTo(sym_type, 9) ThenBlock: { ReturnValue(13) }
        IfCondition EqualTo(sym_type, 10) ThenBlock: { ReturnValue(16) }
        IfCondition EqualTo(sym_type, 11) ThenBlock: { ReturnValue(9) }
        IfCondition EqualTo(sym_type, 12) ThenBlock: { ReturnValue(12) }
        ReturnValue(0)
    }
}

// =============================================================================
// EXTRACT SYMBOL NAME
// =============================================================================
Function.Import_ExtractSymbolName {
    Input: source: Address
    Input: start: Integer
    Input: len: Integer
    Input: sym_type: Integer
    Output: Address
    Body: {
        prefix_len = Import_GetKeywordLen(sym_type)
        name_start = Add(start, prefix_len)
        
        name_end = name_start
        max_pos = Add(start, len)
        WhileLoop LessThan(name_end, max_pos) {
            c = GetByte(source, name_end)
            is_space = EqualTo(c, 32)
            is_brace = EqualTo(c, 123)
            is_cr = EqualTo(c, 13)
            is_lf = EqualTo(c, 10)
            is_tab = EqualTo(c, 9)
            stop1 = Or(is_space, is_brace)
            stop2 = Or(is_cr, is_lf)
            stop3 = Or(stop1, stop2)
            should_stop = Or(stop3, is_tab)
            IfCondition EqualTo(should_stop, 1) ThenBlock: {
                BreakLoop
            }
            name_end = Add(name_end, 1)
        }
        
        name_len = Subtract(name_end, name_start)
        
        IfCondition LessEqual(name_len, 0) ThenBlock: {
            empty = Allocate(1)
            SetByte(empty, 0, 0)
            ReturnValue(empty)
        }
        
        alloc_size = Add(name_len, 1)
        name = Allocate(alloc_size)
        i = 0
        WhileLoop LessThan(i, name_len) {
            src_pos = Add(name_start, i)
            c = GetByte(source, src_pos)
            SetByte(name, i, c)
            i = Add(i, 1)
        }
        SetByte(name, name_len, 0)
        
        ReturnValue(name)
    }
}

// =============================================================================
// CHECK IF LINE IS IMPORT
// =============================================================================
Function.Import_IsImportLine {
    Input: source: Address
    Input: start: Integer
    Input: len: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(len, 7) ThenBlock: {
            ReturnValue(0)
        }
        
        IfCondition GreaterEqual(len, 14) ThenBlock: {
            match = Import_MatchPrefix(source, start, "LibraryImport.")
            IfCondition EqualTo(match, 1) ThenBlock: {
                ReturnValue(1)
            }
        }
        
        match = Import_MatchPrefix(source, start, "Import.")
        IfCondition EqualTo(match, 1) ThenBlock: {
            ReturnValue(1)
        }
        
        ReturnValue(0)
    }
}

// =============================================================================
// COPY LINE
// =============================================================================
Function.Import_CopyLine {
    Input: source: Address
    Input: start: Integer
    Input: len: Integer
    Output: Address
    Body: {
        alloc_size = Add(len, 1)
        line = Allocate(alloc_size)
        i = 0
        WhileLoop LessThan(i, len) {
            src_pos = Add(start, i)
            c = GetByte(source, src_pos)
            SetByte(line, i, c)
            i = Add(i, 1)
        }
        SetByte(line, len, 0)
        ReturnValue(line)
    }
}

// =============================================================================
// JOIN LINES
// =============================================================================
Function.Import_JoinLines {
    Input: lines: Address
    Output: Address
    Body: {
        total_size = 0
        line_count = XArray.XSize(lines)
        
        i = 0
        WhileLoop LessThan(i, line_count) {
            line = XArray.XGet(lines, i)
            len = StringLength(line)
            total_size = Add(total_size, len)
            total_size = Add(total_size, 1)
            i = Add(i, 1)
        }
        
        alloc_size = Add(total_size, 1)
        result = Allocate(alloc_size)
        pos = 0
        
        i = 0
        WhileLoop LessThan(i, line_count) {
            line = XArray.XGet(lines, i)
            line_len = StringLength(line)
            
            j = 0
            WhileLoop LessThan(j, line_len) {
                c = GetByte(line, j)
                SetByte(result, pos, c)
                pos = Add(pos, 1)
                j = Add(j, 1)
            }
            SetByte(result, pos, 10)
            pos = Add(pos, 1)
            
            i = Add(i, 1)
        }
        
        SetByte(result, pos, 0)
        ReturnValue(result)
    }
}

// =============================================================================
// MAKE HEADER
// =============================================================================
Function.Import_MakeHeader {
    Input: mod_name: Address
    Output: Address
    Body: {
        prefix = "// === Inlined from "
        suffix = " ==="
        
        pre_len = StringLength(prefix)
        name_len = StringLength(mod_name)
        suf_len = StringLength(suffix)
        
        mid = Add(pre_len, name_len)
        total = Add(mid, suf_len)
        alloc_size = Add(total, 1)
        result = Allocate(alloc_size)
        pos = 0
        
        i = 0
        WhileLoop LessThan(i, pre_len) {
            c = GetByte(prefix, i)
            SetByte(result, pos, c)
            pos = Add(pos, 1)
            i = Add(i, 1)
        }
        
        i = 0
        WhileLoop LessThan(i, name_len) {
            c = GetByte(mod_name, i)
            SetByte(result, pos, c)
            pos = Add(pos, 1)
            i = Add(i, 1)
        }
        
        i = 0
        WhileLoop LessThan(i, suf_len) {
            c = GetByte(suffix, i)
            SetByte(result, pos, c)
            pos = Add(pos, 1)
            i = Add(i, 1)
        }
        
        SetByte(result, total, 0)
        ReturnValue(result)
    }
}

// =============================================================================
// EXTRACT IMPORTS
// =============================================================================
Function.Import_ExtractImports {
    Input: source: Address
    Output: Address
    Body: {
        imports = XArray.XCreate(32)
        len = StringLength(source)
        
        pos = 0
        line_start = 0
        
        WhileLoop LessThan(pos, len) {
            c = GetByte(source, pos)
            
            IfCondition EqualTo(c, 10) ThenBlock: {
                line_len = Subtract(pos, line_start)
                
                IfCondition GreaterEqual(line_len, 14) ThenBlock: {
                    c0 = GetByte(source, line_start)
                    IfCondition EqualTo(c0, 76) ThenBlock: {
                        match = Import_MatchPrefix(source, line_start, "LibraryImport.")
                        IfCondition EqualTo(match, 1) ThenBlock: {
                            name_start = Add(line_start, 14)
                            name_max = Subtract(line_len, 14)
                            mod_name = Import_ExtractModuleName(source, name_start, name_max)
                            XArray.XPush(imports, mod_name)
                        }
                    }
                }
                
                IfCondition GreaterEqual(line_len, 7) ThenBlock: {
                    c0 = GetByte(source, line_start)
                    IfCondition EqualTo(c0, 73) ThenBlock: {
                        match = Import_MatchPrefix(source, line_start, "Import.")
                        IfCondition EqualTo(match, 1) ThenBlock: {
                            name_start = Add(line_start, 7)
                            name_max = Subtract(line_len, 7)
                            mod_name = Import_ExtractModuleName(source, name_start, name_max)
                            XArray.XPush(imports, mod_name)
                        }
                    }
                }
                
                line_start = Add(pos, 1)
            }
            pos = Add(pos, 1)
        }
        
        ReturnValue(imports)
    }
}

Function.Import_ExtractModuleName {
    Input: source: Address
    Input: start: Integer
    Input: max_len: Integer
    Output: Address
    Body: {
        end = 0
        WhileLoop LessThan(end, max_len) {
            src_pos = Add(start, end)
            c = GetByte(source, src_pos)
            is_space = EqualTo(c, 32)
            is_lf = EqualTo(c, 10)
            is_cr = EqualTo(c, 13)
            is_tab = EqualTo(c, 9)
            stop1 = Or(is_space, is_lf)
            stop2 = Or(is_cr, is_tab)
            should_stop = Or(stop1, stop2)
            IfCondition EqualTo(should_stop, 1) ThenBlock: {
                BreakLoop
            }
            end = Add(end, 1)
        }
        
        alloc_size = Add(end, 1)
        name = Allocate(alloc_size)
        i = 0
        WhileLoop LessThan(i, end) {
            src_pos = Add(start, i)
            c = GetByte(source, src_pos)
            SetByte(name, i, c)
            i = Add(i, 1)
        }
        SetByte(name, end, 0)
        ReturnValue(name)
    }
}

// =============================================================================
// CHECK IF MODULE ALREADY LOADED
// PATCHED: Check by module NAME, not just path
// This prevents duplicate loading when same library exists in multiple locations
// (e.g., Librarys/Library.Arena.ailang and Librarys/Core/Library.Arena.ailang)
// =============================================================================
Function.Import_IsLoaded {
    Input: state: Address
    Input: path: Address
    Output: Integer
    Body: {
        // Still check path hash for exact duplicates (fast path)
        hash = Import_HashString(path)
        loaded_paths = Dereference(state)
        count = XArray.XSize(loaded_paths)
        
        i = 0
        WhileLoop LessThan(i, count) {
            stored_hash = XArray.XGet(loaded_paths, i)
            IfCondition EqualTo(hash, stored_hash) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        
        // NEW: Also check by library filename (handles multiple locations)
        lib_name = Import_ExtractLibName(path)
        IfCondition NotEqual(lib_name, 0) ThenBlock: {
            ptr16 = Add(state, 16)
            loaded_names = Dereference(ptr16)
            name_count = XArray.XSize(loaded_names)
            
            i = 0
            WhileLoop LessThan(i, name_count) {
                stored_name = XArray.XGet(loaded_names, i)
                // Extract lib name from stored module name for comparison
                stored_lib = Import_ExtractLibNameFromModule(stored_name)
                
                IfCondition NotEqual(stored_lib, 0) ThenBlock: {
                    is_eq = Import_StrEqual(lib_name, stored_lib)
                    IfCondition EqualTo(is_eq, 1) ThenBlock: {
                        PrintMessage("[IMPORT] Skipping duplicate: ")
                        PrintMessage(path)
                        PrintMessage(" (already have ")
                        PrintMessage(stored_name)
                        PrintMessage(")\n")
                        ReturnValue(1)
                    }
                }
                
                i = Add(i, 1)
            }
        }
        
        ReturnValue(0)
    }
}

// =============================================================================
// EXTRACT LIBRARY NAME FROM PATH
// "Librarys/Core/Library.Arena.ailang" -> "Arena"
// "Librarys/Library.XArrays.ailang" -> "XArrays"
// =============================================================================
Function.Import_ExtractLibName {
    Input: path: Address
    Output: Address
    Body: {
        IfCondition EqualTo(path, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        len = StringLength(path)
        
        // Find "Library." in the path
        lib_prefix = "Library."
        prefix_len = 8
        
        start_pos = -1
        i = 0
        max_search = Subtract(len, prefix_len)
        
        WhileLoop LessEqual(i, max_search) {
            match = 1
            j = 0
            WhileLoop LessThan(j, prefix_len) {
                c1 = GetByte(path, Add(i, j))
                c2 = GetByte(lib_prefix, j)
                IfCondition NotEqual(c1, c2) ThenBlock: {
                    match = 0
                    BreakLoop
                }
                j = Add(j, 1)
            }
            
            IfCondition EqualTo(match, 1) ThenBlock: {
                start_pos = Add(i, prefix_len)
                BreakLoop
            }
            
            i = Add(i, 1)
        }
        
        IfCondition LessThan(start_pos, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        // Find end - either ".ailang" or end of string
        end_pos = start_pos
        WhileLoop LessThan(end_pos, len) {
            c = GetByte(path, end_pos)
            // Stop at '.' (for .ailang extension)
            IfCondition EqualTo(c, 46) ThenBlock: {
                BreakLoop
            }
            end_pos = Add(end_pos, 1)
        }
        
        name_len = Subtract(end_pos, start_pos)
        IfCondition LessEqual(name_len, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        // Allocate and copy
        alloc_size = Add(name_len, 1)
        result = Allocate(alloc_size)
        
        i = 0
        WhileLoop LessThan(i, name_len) {
            c = GetByte(path, Add(start_pos, i))
            SetByte(result, i, c)
            i = Add(i, 1)
        }
        SetByte(result, name_len, 0)
        
        ReturnValue(result)
    }
}

// =============================================================================
// EXTRACT LIBRARY NAME FROM MODULE NAME
// "Core.Arena" -> "Arena"
// "Arena" -> "Arena"
// "Compiler.Frontend.Lexer.CLexerMain" -> "CLexerMain"
// =============================================================================
Function.Import_ExtractLibNameFromModule {
    Input: mod_name: Address
    Output: Address
    Body: {
        IfCondition EqualTo(mod_name, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        len = StringLength(mod_name)
        
        // Find last dot
        last_dot = -1
        i = 0
        WhileLoop LessThan(i, len) {
            c = GetByte(mod_name, i)
            IfCondition EqualTo(c, 46) ThenBlock: {
                last_dot = i
            }
            i = Add(i, 1)
        }
        
        // Start after last dot, or at beginning if no dot
        start_pos = 0
        IfCondition GreaterEqual(last_dot, 0) ThenBlock: {
            start_pos = Add(last_dot, 1)
        }
        
        name_len = Subtract(len, start_pos)
        IfCondition LessEqual(name_len, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        // Allocate and copy
        alloc_size = Add(name_len, 1)
        result = Allocate(alloc_size)
        
        i = 0
        WhileLoop LessThan(i, name_len) {
            c = GetByte(mod_name, Add(start_pos, i))
            SetByte(result, i, c)
            i = Add(i, 1)
        }
        SetByte(result, name_len, 0)
        
        ReturnValue(result)
    }
}

Function.Import_MarkLoaded {
    Input: state: Address
    Input: path: Address
    Input: content: Address
    Input: name: Address
    Body: {
        hash = Import_HashString(path)
        loaded_paths = Dereference(state)
        ptr8 = Add(state, 8)
        loaded_content = Dereference(ptr8)
        ptr16 = Add(state, 16)
        loaded_names = Dereference(ptr16)
        
        XArray.XPush(loaded_paths, hash)
        XArray.XPush(loaded_content, content)
        XArray.XPush(loaded_names, name)
    }
}

Function.Import_ReadFile {
    Input: path: Address
    Output: Address
    Body: {
        max_size = 524288
        alloc_size = Add(max_size, 1)
        buffer = Allocate(alloc_size)
        
        bytes_read = ReadBinaryFile(path, buffer, max_size)
        
        IfCondition LessEqual(bytes_read, 0) ThenBlock: {
            Deallocate(buffer, alloc_size)
            ReturnValue(0)
        }
        
        SetByte(buffer, bytes_read, 0)
        ReturnValue(buffer)
    }
}

Function.Import_BuildPath {
    Input: state: Address
    Input: module_name: Address
    Output: Address
    Body: {
        ptr72 = Add(state, 72)
        lib_base = Dereference(ptr72)
        lib_len = StringLength(lib_base)
        name_len = StringLength(module_name)
        
        last_dot = 0
        i = 0
        WhileLoop LessThan(i, name_len) {
            c = GetByte(module_name, i)
            IfCondition EqualTo(c, 46) ThenBlock: {
                last_dot = i
            }
            i = Add(i, 1)
        }
        
        prefix = "Library."
        prefix_len = 8
        suffix = ".ailang"
        suffix_len = 7
        
        t1 = Add(lib_len, 1)
        t2 = Add(t1, name_len)
        t3 = Add(t2, prefix_len)
        total_len = Add(t3, suffix_len)
        alloc_size = Add(total_len, 1)
        path = Allocate(alloc_size)
        pos = 0
        
        i = 0
        WhileLoop LessThan(i, lib_len) {
            c = GetByte(lib_base, i)
            SetByte(path, pos, c)
            pos = Add(pos, 1)
            i = Add(i, 1)
        }
        SetByte(path, pos, 47)
        pos = Add(pos, 1)
        
        i = 0
        WhileLoop LessThan(i, last_dot) {
            c = GetByte(module_name, i)
            IfCondition EqualTo(c, 46) ThenBlock: {
                SetByte(path, pos, 47)
            } ElseBlock: {
                SetByte(path, pos, c)
            }
            pos = Add(pos, 1)
            i = Add(i, 1)
        }
        
        IfCondition GreaterThan(last_dot, 0) ThenBlock: {
            SetByte(path, pos, 47)
            pos = Add(pos, 1)
        }
        
        i = 0
        WhileLoop LessThan(i, prefix_len) {
            c = GetByte(prefix, i)
            SetByte(path, pos, c)
            pos = Add(pos, 1)
            i = Add(i, 1)
        }
        
        file_start = 0
        IfCondition GreaterThan(last_dot, 0) ThenBlock: {
            file_start = Add(last_dot, 1)
        }
        i = file_start
        WhileLoop LessThan(i, name_len) {
            c = GetByte(module_name, i)
            SetByte(path, pos, c)
            pos = Add(pos, 1)
            i = Add(i, 1)
        }
        
        i = 0
        WhileLoop LessThan(i, suffix_len) {
            c = GetByte(suffix, i)
            SetByte(path, pos, c)
            pos = Add(pos, 1)
            i = Add(i, 1)
        }
        
        SetByte(path, pos, 0)
        ReturnValue(path)
    }
}

Function.Import_BuildFilePath {
    Input: file_name: Address
    Output: Address
    Body: {
        name_len = StringLength(file_name)
        suffix = ".ailang"
        suffix_len = 7
        
        total = Add(name_len, suffix_len)
        alloc_size = Add(total, 1)
        path = Allocate(alloc_size)
        
        i = 0
        WhileLoop LessThan(i, name_len) {
            c = GetByte(file_name, i)
            SetByte(path, i, c)
            i = Add(i, 1)
        }
        
        i = 0
        WhileLoop LessThan(i, suffix_len) {
            dst = Add(name_len, i)
            c = GetByte(suffix, i)
            SetByte(path, dst, c)
            i = Add(i, 1)
        }
        
        end_pos = Add(name_len, suffix_len)
        SetByte(path, end_pos, 0)
        ReturnValue(path)
    }
}

Function.Import_LoadModule {
    Input: state: Address
    Input: module_name: Address
    Output: Integer
    Body: {
        path = Import_BuildPath(state, module_name)
        
        is_loaded = Import_IsLoaded(state, path)
        IfCondition EqualTo(is_loaded, 1) ThenBlock: {
            path_len = StringLength(path)
            dealloc_size = Add(path_len, 1)
            Deallocate(path, dealloc_size)
            ReturnValue(1)
        }
        
        content = Import_ReadFile(path)
        
        IfCondition EqualTo(content, 0) ThenBlock: {
            path_len = StringLength(path)
            dealloc_size = Add(path_len, 1)
            Deallocate(path, dealloc_size)
            path = Import_BuildFilePath(module_name)
            
            is_loaded = Import_IsLoaded(state, path)
            IfCondition EqualTo(is_loaded, 1) ThenBlock: {
                path_len = StringLength(path)
                dealloc_size = Add(path_len, 1)
                Deallocate(path, dealloc_size)
                ReturnValue(1)
            }
            
            content = Import_ReadFile(path)
        }
        
        IfCondition EqualTo(content, 0) ThenBlock: {
            PrintMessage("[IMPORT ERROR] Cannot read: ")
            PrintMessage(module_name)
            PrintMessage("\n")
            ptr64 = Add(state, 64)
            error_count = Dereference(ptr64)
            new_err = Add(error_count, 1)
            StoreValue(ptr64, new_err)
            ReturnValue(0)
        }
        
        PrintMessage("[IMPORT] Loaded: ")
        PrintMessage(module_name)
        PrintMessage("\n")
        
        mod_name_str = Import_CopyStr(module_name)
        Import_MarkLoaded(state, path, content, mod_name_str)
        
        sub_imports = Import_ExtractImports(content)
        sub_count = XArray.XSize(sub_imports)
        
        i = 0
        WhileLoop LessThan(i, sub_count) {
            sub_name = XArray.XGet(sub_imports, i)
            Import_LoadModule(state, sub_name)
            i = Add(i, 1)
        }
        XArray.XDestroy(sub_imports)
        
        ReturnValue(1)
    }
}

// =============================================================================
// REWRITE LINE
// =============================================================================
Function.Import_RewriteLine {
    Input: state: Address
    Input: rewrite_map: Address
    Input: line: Address
    Input: module_idx: Integer
    Output: Address
    Body: {
        ptr40 = Add(state, 40)
        conflict_symbols = Dereference(ptr40)
        num_conflicts = XArray.XSize(conflict_symbols)
        
        IfCondition EqualTo(num_conflicts, 0) ThenBlock: {
            ReturnValue(line)
        }
        
        line_len = StringLength(line)
        buf_size = Multiply(line_len, 3)
        alloc_size = Add(buf_size, 1)
        result = Allocate(alloc_size)
        
        src_pos = 0
        dst_pos = 0
        in_string = 0
        
        WhileLoop LessThan(src_pos, line_len) {
            c = GetByte(line, src_pos)
            
            IfCondition EqualTo(c, 34) ThenBlock: {
                is_escaped = 0
                IfCondition GreaterThan(src_pos, 0) ThenBlock: {
                    prev_pos = Subtract(src_pos, 1)
                    prev_c = GetByte(line, prev_pos)
                    IfCondition EqualTo(prev_c, 92) ThenBlock: {
                        is_escaped = 1
                    }
                }
                IfCondition EqualTo(is_escaped, 0) ThenBlock: {
                    in_string = Subtract(1, in_string)
                }
            }
            
            IfCondition EqualTo(in_string, 1) ThenBlock: {
                SetByte(result, dst_pos, c)
                dst_pos = Add(dst_pos, 1)
                src_pos = Add(src_pos, 1)
            } ElseBlock: {
                matched = 0
                
                i = 0
                WhileLoop LessThan(i, num_conflicts) {
                    sym = XArray.XGet(conflict_symbols, i)
                    sym_len = StringLength(sym)
                    
                    end_pos = Add(src_pos, sym_len)
                    IfCondition LessEqual(end_pos, line_len) ThenBlock: {
                        is_match = Import_MatchAt(line, src_pos, sym, sym_len)
                        
                        IfCondition EqualTo(is_match, 1) ThenBlock: {
                            is_boundary = Import_IsWordBoundary(line, src_pos, sym_len, line_len)
                            
                            IfCondition EqualTo(is_boundary, 1) ThenBlock: {
                                prefixed = Import_GetPrefixedFor(rewrite_map, sym, module_idx)
                                
                                IfCondition NotEqual(prefixed, 0) ThenBlock: {
                                    pre_len = StringLength(prefixed)
                                    j = 0
                                    WhileLoop LessThan(j, pre_len) {
                                        pc = GetByte(prefixed, j)
                                        SetByte(result, dst_pos, pc)
                                        dst_pos = Add(dst_pos, 1)
                                        j = Add(j, 1)
                                    }
                                    src_pos = Add(src_pos, sym_len)
                                    matched = 1
                                    i = num_conflicts
                                }
                            }
                        }
                    }
                    i = Add(i, 1)
                }
                
                IfCondition EqualTo(matched, 0) ThenBlock: {
                    SetByte(result, dst_pos, c)
                    dst_pos = Add(dst_pos, 1)
                    src_pos = Add(src_pos, 1)
                }
            }
        }
        
        SetByte(result, dst_pos, 0)
        ReturnValue(result)
    }
}

Function.Import_MatchAt {
    Input: str: Address
    Input: pos: Integer
    Input: pattern: Address
    Input: pat_len: Integer
    Output: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, pat_len) {
            str_pos = Add(pos, i)
            str_c = GetByte(str, str_pos)
            pat_c = GetByte(pattern, i)
            IfCondition NotEqual(str_c, pat_c) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

Function.Import_IsWordBoundary {
    Input: str: Address
    Input: pos: Integer
    Input: match_len: Integer
    Input: str_len: Integer
    Output: Integer
    Body: {
        IfCondition GreaterThan(pos, 0) ThenBlock: {
            prev_pos = Subtract(pos, 1)
            before = GetByte(str, prev_pos)
            is_alnum = Import_IsAlphaNum(before)
            IfCondition EqualTo(is_alnum, 1) ThenBlock: {
                ReturnValue(0)
            }
        }
        
        after_pos = Add(pos, match_len)
        IfCondition LessThan(after_pos, str_len) ThenBlock: {
            after = GetByte(str, after_pos)
            is_alnum = Import_IsAlphaNum(after)
            IfCondition EqualTo(is_alnum, 1) ThenBlock: {
                ReturnValue(0)
            }
        }
        
        ReturnValue(1)
    }
}

Function.Import_IsAlphaNum {
    Input: c: Integer
    Output: Integer
    Body: {
        is_upper = And(GreaterEqual(c, 65), LessEqual(c, 90))
        IfCondition EqualTo(is_upper, 1) ThenBlock: {
            ReturnValue(1)
        }
        is_lower = And(GreaterEqual(c, 97), LessEqual(c, 122))
        IfCondition EqualTo(is_lower, 1) ThenBlock: {
            ReturnValue(1)
        }
        is_digit = And(GreaterEqual(c, 48), LessEqual(c, 57))
        IfCondition EqualTo(is_digit, 1) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(c, 95) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// EXTRACT FILE SYMBOLS
// =============================================================================
Function.Import_ExtractFileSymbols {
    Input: state: Address
    Input: content: Address
    Input: module_idx: Integer
    Body: {
        len = StringLength(content)
        pos = 0
        line_start = 0
        
        WhileLoop LessThan(pos, len) {
            c = GetByte(content, pos)
            
            IfCondition EqualTo(c, 10) ThenBlock: {
                line_len = Subtract(pos, line_start)
                Import_MaybeRecordSymbol(state, content, line_start, line_len, module_idx)
                line_start = Add(pos, 1)
            }
            pos = Add(pos, 1)
        }
        
        IfCondition LessThan(line_start, len) ThenBlock: {
            line_len = Subtract(len, line_start)
            Import_MaybeRecordSymbol(state, content, line_start, line_len, module_idx)
        }
    }
}

Function.Import_MaybeRecordSymbol {
    Input: state: Address
    Input: content: Address
    Input: start: Integer
    Input: len: Integer
    Input: module_idx: Integer
    Body: {
        sym_type = Import_GetSymbolType(content, start, len)
        
        IfCondition GreaterThan(sym_type, 0) ThenBlock: {
            sym_name = Import_ExtractSymbolName(content, start, len, sym_type)
            Import_RecordSymbol(state, sym_name, module_idx)
            sym_len = StringLength(sym_name)
            dealloc_size = Add(sym_len, 1)
            Deallocate(sym_name, dealloc_size)
        }
    }
}

// =============================================================================
// EMIT ALL
// =============================================================================
Function.Import_EmitAll {
    Input: state: Address
    Input: rewrite_map: Address
    Input: main_source: Address
    Output: Address
    Body: {
        output = XArray.XCreate(4096)
        
        // === NEW: Initialize the file map ===
        FileMap_Init()
        
        ptr8 = Add(state, 8)
        loaded_content = Dereference(ptr8)
        ptr16 = Add(state, 16)
        loaded_names = Dereference(ptr16)
        num_modules = XArray.XSize(loaded_content)
        
        i = 0
        WhileLoop LessThan(i, num_modules) {
            content = XArray.XGet(loaded_content, i)
            mod_name = XArray.XGet(loaded_names, i)
            
            header = Import_MakeHeader(mod_name)
            XArray.XPush(output, header)
            
            // === NEW: Record where this module starts in combined output ===
            // +1 because the header line was just pushed, content starts on next line
            // XArray.XSize(output) + 1 = 1-based line number for next emitted line
            combined_start = Add(XArray.XSize(output), 1)
            FileMap_AddEntry(combined_start, mod_name)
            
            Import_EmitFile(state, rewrite_map, content, i, output)
            
            blank = Import_CopyStr("")
            XArray.XPush(output, blank)
            
            i = Add(i, 1)
        }
        
        main_header = Import_CopyStr("// === Main module ===")
        XArray.XPush(output, main_header)
        
        // === NEW: Record where main module starts ===
        combined_start = Add(XArray.XSize(output), 1)
        FileMap_AddEntry(combined_start, "main")
        
        Import_EmitFile(state, rewrite_map, main_source, num_modules, output)
        
        result = Import_JoinLines(output)
        ReturnValue(result)
    }
}

Function.Import_EmitFile {
    Input: state: Address
    Input: rewrite_map: Address
    Input: content: Address
    Input: module_idx: Integer
    Input: output: Address
    Body: {
        len = StringLength(content)
        pos = 0
        line_start = 0
        
        WhileLoop LessThan(pos, len) {
            c = GetByte(content, pos)
            
            IfCondition EqualTo(c, 10) ThenBlock: {
                line_len = Subtract(pos, line_start)
                
                is_import = Import_IsImportLine(content, line_start, line_len)
                IfCondition EqualTo(is_import, 0) ThenBlock: {
                    line = Import_CopyLine(content, line_start, line_len)
                    rewritten = Import_RewriteLine(state, rewrite_map, line, module_idx)
                    XArray.XPush(output, rewritten)
                    IfCondition NotEqual(rewritten, line) ThenBlock: {
                        line_len_plus = Add(line_len, 1)
                        Deallocate(line, line_len_plus)
                    }
                }
                
                line_start = Add(pos, 1)
            }
            pos = Add(pos, 1)
        }
        
        IfCondition LessThan(line_start, len) ThenBlock: {
            line_len = Subtract(len, line_start)
            IfCondition GreaterThan(line_len, 0) ThenBlock: {
                is_import = Import_IsImportLine(content, line_start, line_len)
                IfCondition EqualTo(is_import, 0) ThenBlock: {
                    line = Import_CopyLine(content, line_start, line_len)
                    rewritten = Import_RewriteLine(state, rewrite_map, line, module_idx)
                    XArray.XPush(output, rewritten)
                    IfCondition NotEqual(rewritten, line) ThenBlock: {
                        line_len_plus = Add(line_len, 1)
                        Deallocate(line, line_len_plus)
                    }
                }
            }
        }
    }
}


// =============================================================================
// CHECK IF IMPORT EXISTS
// =============================================================================
Function.Import_HasImport {
    Input: imports: Address
    Input: name: Address
    Output: Integer
    Body: {
        count = XArray.XSize(imports)
        i = 0
        WhileLoop LessThan(i, count) {
            mod_name = XArray.XGet(imports, i)
            is_eq = Import_StrEqual(mod_name, name)
            IfCondition EqualTo(is_eq, 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}
// =============================================================================
// MAIN ENTRY POINT
// =============================================================================
Function.Import_ResolveAll {
    Input: main_source: Address
    Output: Address
    Body: {
        state = Import_Init()
        
        PrintMessage("[IMPORT] Starting conflict-only resolution...\n")
        
        imports = Import_ExtractImports(main_source)
        count = XArray.XSize(imports)
        
        PrintMessage("[IMPORT] Found ")
        PrintNumber(count)
        PrintMessage(" imports\n")
        
        i = 0
        WhileLoop LessThan(i, count) {
            mod_name = XArray.XGet(imports, i)
            Import_LoadModule(state, mod_name)
            i = Add(i, 1)
        }
        
        ptr8 = Add(state, 8)
        loaded_content = Dereference(ptr8)
        num_modules = XArray.XSize(loaded_content)
        
        PrintMessage("[IMPORT] Extracting symbols from ")
        PrintNumber(num_modules)
        PrintMessage(" modules\n")
        
        i = 0
        WhileLoop LessThan(i, num_modules) {
            content = XArray.XGet(loaded_content, i)
            Import_ExtractFileSymbols(state, content, i)
            i = Add(i, 1)
        }
        
        Import_ExtractFileSymbols(state, main_source, num_modules)
        
        Import_DetectConflicts(state)
        
        Import_AssignPrefixes(state)
        
        rewrite_map = Import_BuildRewriteMap(state)
        
        result = Import_EmitAll(state, rewrite_map, main_source)
        
        XArray.XDestroy(imports)
        PrintMessage("[IMPORT] Done.\n")
        
        ReturnValue(result)
    }
}

// === Inlined from Compiler.Import.CFileMap ===
// Library.CFileMap.ailang
// Maps combined-source line numbers back to original file + local line
// Built during Import_EmitAll, queried by analyzers
//
// Usage:
//   FileMap_Init()                          — call before import resolution
//   FileMap_AddEntry(combined_line, name)   — called by Import_EmitAll per module
//   FileMap_Lookup(combined_line)           — sets FileMap.result_file, FileMap.result_line
//   FileMap_Format(combined_line)           — returns "filename:line" string
//
// Location: Librarys/Compiler/Import/Library.CFileMap.ailang
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL).


// =============================================================================
// STATE
// =============================================================================
FixedPool.FileMap {
    // Parallel arrays: entry i → module starting at combined line N
    "start_lines": Initialize=0, CanChange=True    // XArray of Integer (1-based combined line)
    "filenames": Initialize=0, CanChange=True       // XArray of Address (module name strings)
    "entry_count": Initialize=0, CanChange=True
    
    // Lookup result (set by FileMap_Lookup)
    "result_file": Initialize=0, CanChange=True     // Address: filename string
    "result_line": Initialize=0, CanChange=True     // Integer: local line within file
    
    // State
    "initialized": Initialize=0, CanChange=True
}

// =============================================================================
// INITIALIZATION
// =============================================================================
Function.FileMap_Init {
    Body: {
        // Free old data if reinitializing
        IfCondition NotEqual(FileMap.start_lines, 0) ThenBlock: {
            XArray.XDestroy(FileMap.start_lines)
        }
        IfCondition NotEqual(FileMap.filenames, 0) ThenBlock: {
            XArray.XDestroy(FileMap.filenames)
        }
        
        FileMap.start_lines = XArray.XCreate(64)
        FileMap.filenames = XArray.XCreate(64)
        FileMap.entry_count = 0
        FileMap.result_file = 0
        FileMap.result_line = 0
        FileMap.initialized = 1
    }
}

// =============================================================================
// ADD ENTRY
// Called by Import_EmitAll before emitting each module's content.
// combined_line: the 1-based line number in the combined output where this
//                module's content starts
// name:          module name string (e.g. "Library.XArrays" or "main")
// =============================================================================
Function.FileMap_AddEntry {
    Input: combined_line: Integer
    Input: name: Address
    Body: {
        IfCondition EqualTo(FileMap.initialized, 0) ThenBlock: {
            FileMap_Init()
        }
        
        XArray.XPush(FileMap.start_lines, combined_line)
        XArray.XPush(FileMap.filenames, name)
        FileMap.entry_count = Add(FileMap.entry_count, 1)
    }
}

// =============================================================================
// LOOKUP
// Given a combined-source line number, find which file it belongs to
// and compute the local line within that file.
//
// Sets: FileMap.result_file  → filename (Address, or 0 if not found)
//       FileMap.result_line  → local line number within that file
//
// Returns: 1 if found, 0 if not
// =============================================================================
Function.FileMap_Lookup {
    Input: combined_line: Integer
    Output: Integer
    Body: {
        FileMap.result_file = 0
        FileMap.result_line = combined_line
        
        IfCondition EqualTo(FileMap.initialized, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        IfCondition EqualTo(FileMap.entry_count, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        IfCondition LessEqual(combined_line, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        // Walk entries in reverse to find the last entry where start_line <= combined_line
        // This is the module that contains the line
        best_idx = -1
        i = Subtract(FileMap.entry_count, 1)
        
        WhileLoop GreaterEqual(i, 0) {
            start = XArray.XGet(FileMap.start_lines, i)
            IfCondition LessEqual(start, combined_line) ThenBlock: {
                best_idx = i
                i = -1  // break
                ContinueLoop
            }
            i = Subtract(i, 1)
        }
        
        IfCondition EqualTo(best_idx, -1) ThenBlock: {
            // Line is before any module — shouldn't happen
            ReturnValue(0)
        }
        
        // Compute local line: combined_line - module_start + 1
        module_start = XArray.XGet(FileMap.start_lines, best_idx)
        local_line = Add(Subtract(combined_line, module_start), 1)
        
        FileMap.result_file = XArray.XGet(FileMap.filenames, best_idx)
        FileMap.result_line = local_line
        
        ReturnValue(1)
    }
}

// =============================================================================
// FORMAT
// Returns a "filename:line" string for diagnostic output.
// If no mapping found, returns "unknown:combined_line".
// Caller does NOT need to free — uses arena allocation (StringConcat).
// =============================================================================
Function.FileMap_Format {
    Input: combined_line: Integer
    Output: Address
    Body: {
        found = FileMap_Lookup(combined_line)
        
        IfCondition EqualTo(found, 1) ThenBlock: {
            result = StringConcat(FileMap.result_file, ":")
            result = StringConcat(result, NumberToString(FileMap.result_line))
            ReturnValue(result)
        }
        
        // Fallback
        result = StringConcat("unknown:", NumberToString(combined_line))
        ReturnValue(result)
    }
}

// =============================================================================
// DEBUG: DUMP THE FILE MAP
// =============================================================================
Function.FileMap_Dump {
    Body: {
        PrintMessage("[FILEMAP] Entries: ")
        PrintNumber(FileMap.entry_count)
        PrintMessage("\n")
        
        i = 0
        WhileLoop LessThan(i, FileMap.entry_count) {
            start = XArray.XGet(FileMap.start_lines, i)
            name = XArray.XGet(FileMap.filenames, i)
            
            PrintMessage("  [")
            PrintNumber(i)
            PrintMessage("] Line ")
            PrintNumber(start)
            PrintMessage(" → ")
            IfCondition NotEqual(name, 0) ThenBlock: {
                PrintMessage(name)
            } ElseBlock: {
                PrintMessage("<null>")
            }
            PrintMessage("\n")
            
            i = Add(i, 1)
        }
    }
}

// =============================================================================
// CLEANUP
// =============================================================================
Function.FileMap_Free {
    Body: {
        IfCondition NotEqual(FileMap.start_lines, 0) ThenBlock: {
            XArray.XDestroy(FileMap.start_lines)
            FileMap.start_lines = 0
        }
        IfCondition NotEqual(FileMap.filenames, 0) ThenBlock: {
            XArray.XDestroy(FileMap.filenames)
            FileMap.filenames = 0
        }
        FileMap.entry_count = 0
        FileMap.result_file = 0
        FileMap.result_line = 0
        FileMap.initialized = 0
    }
}

// === Inlined from Analyzer ===
// Library.Analyzer.ailang
// Self-Contained Code Analysis Tool for AILang
// Owns its own pipeline: Load → Resolve → Lex → Parse → Analyze
//
// Features:
//   - Memory leak detection (Allocate/Deallocate pairing)
//   - Unmatched deallocation detection
//   - Function-scoped tracking
//   - Style warnings (nesting depth, param count)
//   - Standalone operation - no dependency on compiler state
//
// Usage:
//   Analyzer.AnalyzeFile("myfile.ailang")
//   -- or --
//   Analyzer.AnalyzeSource(source_string, source_len)




// =============================================================================
// ANALYZER STATE
// =============================================================================
FixedPool.Analyzer {
    // Pipeline state (owned by analyzer)
    "source": Initialize=0, CanChange=True
    "source_len": Initialize=0, CanChange=True
    "resolved_source": Initialize=0, CanChange=True
    "ast": Initialize=0, CanChange=True
    "owns_source": Initialize=0, CanChange=True
    
    // Results
    "warnings": Initialize=0, CanChange=True
    "errors": Initialize=0, CanChange=True
    "warning_count": Initialize=0, CanChange=True
    "error_count": Initialize=0, CanChange=True
    
    // Per-function tracking
    "current_func": Initialize=0, CanChange=True
    "current_func_line": Initialize=0, CanChange=True
    "func_alloc_vars": Initialize=0, CanChange=True
    "func_alloc_lines": Initialize=0, CanChange=True
    "func_dealloc_vars": Initialize=0, CanChange=True
    "func_dealloc_lines": Initialize=0, CanChange=True
    "func_has_output": Initialize=0, CanChange=True
    "func_has_return": Initialize=0, CanChange=True
    "func_returned_vars": Initialize=0, CanChange=True
    
    // Variable tracking (per function)
    "func_assigned_vars": Initialize=0, CanChange=True
    "func_used_vars": Initialize=0, CanChange=True
    
    // Function definition/call tracking (global)
    "defined_funcs": Initialize=0, CanChange=True
    "called_funcs": Initialize=0, CanChange=True
    "func_call_counts": Initialize=0, CanChange=True
    
    // Nesting tracking
    "block_depth": Initialize=0, CanChange=True
    "max_block_depth": Initialize=0, CanChange=True
    "max_depth_func": Initialize=0, CanChange=True
    "max_depth_line": Initialize=0, CanChange=True
    
    // Stats
    "total_allocs": Initialize=0, CanChange=True
    "total_deallocs": Initialize=0, CanChange=True
    "functions_analyzed": Initialize=0, CanChange=True
    "subroutines_analyzed": Initialize=0, CanChange=True
    
    // Config
    "enabled": Initialize=0, CanChange=True
    "check_memory": Initialize=1, CanChange=True
    "check_style": Initialize=1, CanChange=True
    "check_unused": Initialize=1, CanChange=True
    "check_undefined": Initialize=1, CanChange=True
    "check_returns": Initialize=1, CanChange=True
    "max_nesting": Initialize=5
    "max_params": Initialize=6
    "max_func_lines": Initialize=100
    "verbose": Initialize=0, CanChange=True
}


// =============================================================================
// FILE LOADING
// =============================================================================
Function.Analyzer.LoadFile {
    Input: filename: Address
    Output: Address
    Body: {
        // Open file
        fd = SystemCall(2, filename, 0, 0)  // O_RDONLY
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        // Get file size
        size = SystemCall(8, fd, 0, 2)  // lseek SEEK_END
        SystemCall(8, fd, 0, 0)          // lseek SEEK_SET
        
        IfCondition LessEqual(size, 0) ThenBlock: {
            SystemCall(3, fd)  // close
            ReturnValue(0)
        }
        
        // Allocate buffer
        buffer = Allocate(Add(size, 1))
        IfCondition EqualTo(buffer, 0) ThenBlock: {
            SystemCall(3, fd)
            ReturnValue(0)
        }
        
        // Read file
        bytes_read = SystemCall(0, fd, buffer, size)
        SystemCall(3, fd)
        
        IfCondition LessThan(bytes_read, 0) ThenBlock: {
            Deallocate(buffer, Add(size, 1))
            ReturnValue(0)
        }
        
        // Null terminate
        SetByte(buffer, bytes_read, 0)
        
        ReturnValue(buffer)
    }
}

// =============================================================================
// PIPELINE CLEANUP
// =============================================================================
Function.Analyzer.PipelineCleanup {
    Body: {
        // Free resolved source if different from original
        IfCondition NotEqual(Analyzer.resolved_source, Analyzer.source) ThenBlock: {
            IfCondition NotEqual(Analyzer.resolved_source, 0) ThenBlock: {
                // resolved_source is allocated by Import_ResolveAll
                // Deallocate it
                res_len = StringLength(Analyzer.resolved_source)
                Deallocate(Analyzer.resolved_source, Add(res_len, 1))
            }
        }
        
        // Free source if we own it
        IfCondition EqualTo(Analyzer.owns_source, 1) ThenBlock: {
            IfCondition NotEqual(Analyzer.source, 0) ThenBlock: {
                Deallocate(Analyzer.source, Add(Analyzer.source_len, 1))
            }
        }
        
        Analyzer.source = 0
        Analyzer.source_len = 0
        Analyzer.resolved_source = 0
        Analyzer.ast = 0
        Analyzer.owns_source = 0
    }
}

// =============================================================================
// ANALYSIS STATE INITIALIZATION
// =============================================================================
Function.Analyzer.Init {
    Body: {
        Analyzer.warnings = XArray.XCreate(128)
        Analyzer.errors = XArray.XCreate(32)
        Analyzer.warning_count = 0
        Analyzer.error_count = 0
        
        // Per-function memory tracking
        Analyzer.func_alloc_vars = XArray.XCreate(32)
        Analyzer.func_alloc_lines = XArray.XCreate(32)
        Analyzer.func_dealloc_vars = XArray.XCreate(32)
        Analyzer.func_dealloc_lines = XArray.XCreate(32)
        Analyzer.func_returned_vars = XArray.XCreate(16)
        
        // Per-function variable tracking
        Analyzer.func_assigned_vars = XArray.XCreate(64)
        Analyzer.func_used_vars = XArray.XCreate(64)
        
        // Global function tracking
        Analyzer.defined_funcs = XArray.XCreate(256)
        Analyzer.called_funcs = XArray.XCreate(256)
        Analyzer.func_call_counts = XArray.XCreate(256)
        
        Analyzer.current_func = 0
        Analyzer.current_func_line = 0
        Analyzer.func_has_output = 0
        Analyzer.func_has_return = 0
        Analyzer.block_depth = 0
        Analyzer.max_block_depth = 0
        Analyzer.max_depth_func = 0
        Analyzer.max_depth_line = 0
        
        Analyzer.total_allocs = 0
        Analyzer.total_deallocs = 0
        Analyzer.functions_analyzed = 0
        Analyzer.subroutines_analyzed = 0
        
        ReturnValue(1)
    }
}

// =============================================================================
// DIAGNOSTICS
// =============================================================================
Function.Analyzer.AddWarning {
    Input: msg: Address
    Body: {
        XArray.XPush(Analyzer.warnings, msg)
        Analyzer.warning_count = Add(Analyzer.warning_count, 1)
    }
}

Function.Analyzer.AddError {
    Input: msg: Address
    Body: {
        XArray.XPush(Analyzer.errors, msg)
        Analyzer.error_count = Add(Analyzer.error_count, 1)
    }
}

// =============================================================================
// STRING HELPERS
// =============================================================================
Function.Analyzer.StrEqual {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(a, 0) ThenBlock: {
            IfCondition EqualTo(b, 0) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(b, 0) ThenBlock: {
            ReturnValue(0)
        }
        cmp = StringCompare(a, b)
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// PER-FUNCTION TRACKING
// =============================================================================
Function.Analyzer.EnterFunction {
    Input: name: Address
    Input: line: Integer
    Input: is_subroutine: Integer
    Body: {
        // Clear per-function tracking
        XArray.XClear(Analyzer.func_alloc_vars)
        XArray.XClear(Analyzer.func_alloc_lines)
        XArray.XClear(Analyzer.func_dealloc_vars)
        XArray.XClear(Analyzer.func_dealloc_lines)
        XArray.XClear(Analyzer.func_returned_vars)
        XArray.XClear(Analyzer.func_assigned_vars)
        XArray.XClear(Analyzer.func_used_vars)
        
        Analyzer.current_func = name
        Analyzer.current_func_line = line
        Analyzer.func_has_output = 0
        Analyzer.func_has_return = 0
        Analyzer.block_depth = 0
        
        IfCondition EqualTo(is_subroutine, 1) ThenBlock: {
            Analyzer.subroutines_analyzed = Add(Analyzer.subroutines_analyzed, 1)
        } ElseBlock: {
            Analyzer.functions_analyzed = Add(Analyzer.functions_analyzed, 1)
        }
        
        // Record as defined
        IfCondition NotEqual(name, 0) ThenBlock: {
            Analyzer.RecordDefinedFunc(name)
        }
        
        IfCondition EqualTo(Analyzer.verbose, 1) ThenBlock: {
            PrintMessage("  >> Entering: ")
            IfCondition NotEqual(name, 0) ThenBlock: {
                PrintMessage(name)
            } ElseBlock: {
                PrintMessage("<anonymous>")
            }
            PrintMessage("\n")
        }
    }
}

Function.Analyzer.RecordDefinedFunc {
    Input: name: Address
    Body: {
        // Check if already in list
        count = XArray.XSize(Analyzer.defined_funcs)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = XArray.XGet(Analyzer.defined_funcs, i)
            IfCondition EqualTo(Analyzer.StrEqual(existing, name), 1) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        XArray.XPush(Analyzer.defined_funcs, name)
    }
}

Function.Analyzer.RecordCalledFunc {
    Input: name: Address
    Body: {
        // Check if already in list and increment count
        count = XArray.XSize(Analyzer.called_funcs)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = XArray.XGet(Analyzer.called_funcs, i)
            IfCondition EqualTo(Analyzer.StrEqual(existing, name), 1) ThenBlock: {
                // Increment call count
                curr = XArray.XGet(Analyzer.func_call_counts, i)
                XArray.XSet(Analyzer.func_call_counts, i, Add(curr, 1))
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        XArray.XPush(Analyzer.called_funcs, name)
        XArray.XPush(Analyzer.func_call_counts, 1)
    }
}

Function.Analyzer.RecordAssignment {
    Input: var_name: Address
    Body: {
        IfCondition EqualTo(var_name, 0) ThenBlock: {
            ReturnValue(0)
        }
        // Check if already tracked
        count = XArray.XSize(Analyzer.func_assigned_vars)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = XArray.XGet(Analyzer.func_assigned_vars, i)
            IfCondition EqualTo(Analyzer.StrEqual(existing, var_name), 1) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        XArray.XPush(Analyzer.func_assigned_vars, var_name)
    }
}

Function.Analyzer.RecordUsage {
    Input: var_name: Address
    Body: {
        IfCondition EqualTo(var_name, 0) ThenBlock: {
            ReturnValue(0)
        }
        // Check if already tracked
        count = XArray.XSize(Analyzer.func_used_vars)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = XArray.XGet(Analyzer.func_used_vars, i)
            IfCondition EqualTo(Analyzer.StrEqual(existing, var_name), 1) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        XArray.XPush(Analyzer.func_used_vars, var_name)
    }
}

Function.Analyzer.RecordReturnedVar {
    Input: var_name: Address
    Body: {
        IfCondition EqualTo(var_name, 0) ThenBlock: {
            ReturnValue(0)
        }
        XArray.XPush(Analyzer.func_returned_vars, var_name)
    }
}

Function.Analyzer.RecordAlloc {
    Input: var_name: Address
    Input: line: Integer
    Body: {
        XArray.XPush(Analyzer.func_alloc_vars, var_name)
        XArray.XPush(Analyzer.func_alloc_lines, line)
        Analyzer.total_allocs = Add(Analyzer.total_allocs, 1)
        
        IfCondition EqualTo(Analyzer.verbose, 1) ThenBlock: {
            PrintMessage("     [ALLOC] ")
            IfCondition NotEqual(var_name, 0) ThenBlock: {
                PrintMessage(var_name)
            }
            PrintMessage(" @ line ")
            PrintNumber(line)
            PrintMessage("\n")
        }
    }
}

Function.Analyzer.RecordDealloc {
    Input: var_name: Address
    Input: line: Integer
    Body: {
        XArray.XPush(Analyzer.func_dealloc_vars, var_name)
        XArray.XPush(Analyzer.func_dealloc_lines, line)
        Analyzer.total_deallocs = Add(Analyzer.total_deallocs, 1)
        
        IfCondition EqualTo(Analyzer.verbose, 1) ThenBlock: {
            PrintMessage("     [DEALLOC] ")
            IfCondition NotEqual(var_name, 0) ThenBlock: {
                PrintMessage(var_name)
            }
            PrintMessage(" @ line ")
            PrintNumber(line)
            PrintMessage("\n")
        }
    }
}

Function.Analyzer.ExitFunction {
    Body: {
        // === CHECK: Missing return value ===
        IfCondition EqualTo(Analyzer.check_returns, 1) ThenBlock: {
            IfCondition EqualTo(Analyzer.func_has_output, 1) ThenBlock: {
                IfCondition EqualTo(Analyzer.func_has_return, 0) ThenBlock: {
                    msg = StringConcat("Function '", "")
                    IfCondition NotEqual(Analyzer.current_func, 0) ThenBlock: {
                        msg = StringConcat(msg, Analyzer.current_func)
                    } ElseBlock: {
                        msg = StringConcat(msg, "<unknown>")
                    }
                    msg = StringConcat(msg, "' declares Output but has no ReturnValue")
                    Analyzer.AddWarning(msg)
                }
            }
        }
        
        // === CHECK: Unused variables ===
        IfCondition EqualTo(Analyzer.check_unused, 1) ThenBlock: {
            assigned_count = XArray.XSize(Analyzer.func_assigned_vars)
            i = 0
            WhileLoop LessThan(i, assigned_count) {
                var = XArray.XGet(Analyzer.func_assigned_vars, i)
                is_used = Analyzer.IsVarUsed(var)
                IfCondition EqualTo(is_used, 0) ThenBlock: {
                    is_ignorable = Analyzer.IsIgnorableVar(var)
                    IfCondition EqualTo(is_ignorable, 0) ThenBlock: {
                        msg = StringConcat("Variable '", "")
                        IfCondition NotEqual(var, 0) ThenBlock: {
                            msg = StringConcat(msg, var)
                        }
                        msg = StringConcat(msg, "' assigned but never used in '")
                        IfCondition NotEqual(Analyzer.current_func, 0) ThenBlock: {
                            msg = StringConcat(msg, Analyzer.current_func)
                        }
                        msg = StringConcat(msg, "'")
                        Analyzer.AddWarning(msg)
                    }
                }
                i = Add(i, 1)
            }
        }
        
        // === CHECK: Memory leaks (skip if returned or FixedPool member) ===
        IfCondition EqualTo(Analyzer.check_memory, 1) ThenBlock: {
            alloc_count = XArray.XSize(Analyzer.func_alloc_vars)
            
            i = 0
            WhileLoop LessThan(i, alloc_count) {
                alloc_var = XArray.XGet(Analyzer.func_alloc_vars, i)
                alloc_line = XArray.XGet(Analyzer.func_alloc_lines, i)
                
                // Skip FixedPool members (contain dot) - managed globally
                is_pool_member = Analyzer.IsPoolMember(alloc_var)
                IfCondition EqualTo(is_pool_member, 0) ThenBlock: {
                    // Check if deallocated
                    found_dealloc = Analyzer.IsVarDeallocated(alloc_var)
                    
                    // Check if returned (not a leak if returned)
                    is_returned = Analyzer.IsVarReturned(alloc_var)
                    
                    IfCondition EqualTo(found_dealloc, 0) ThenBlock: {
                        IfCondition EqualTo(is_returned, 0) ThenBlock: {
                            msg = StringConcat("Line ", NumberToString(alloc_line))
                            msg = StringConcat(msg, ": '")
                            IfCondition NotEqual(alloc_var, 0) ThenBlock: {
                                msg = StringConcat(msg, alloc_var)
                            } ElseBlock: {
                                msg = StringConcat(msg, "<expr>")
                            }
                            msg = StringConcat(msg, "' allocated but not deallocated/returned in '")
                            IfCondition NotEqual(Analyzer.current_func, 0) ThenBlock: {
                                msg = StringConcat(msg, Analyzer.current_func)
                            } ElseBlock: {
                                msg = StringConcat(msg, "<unknown>")
                            }
                            msg = StringConcat(msg, "'")
                            Analyzer.AddWarning(msg)
                        }
                    }
                }
                
                i = Add(i, 1)
            }
        }
        
        IfCondition EqualTo(Analyzer.verbose, 1) ThenBlock: {
            PrintMessage("  << Exiting: ")
            IfCondition NotEqual(Analyzer.current_func, 0) ThenBlock: {
                PrintMessage(Analyzer.current_func)
            }
            PrintMessage(" (")
            PrintNumber(XArray.XSize(Analyzer.func_alloc_vars))
            PrintMessage(" allocs, ")
            PrintNumber(XArray.XSize(Analyzer.func_dealloc_vars))
            PrintMessage(" deallocs, ")
            PrintNumber(XArray.XSize(Analyzer.func_assigned_vars))
            PrintMessage(" assigns, ")
            PrintNumber(XArray.XSize(Analyzer.func_used_vars))
            PrintMessage(" uses)\n")
        }
    }
}

Function.Analyzer.IsPoolMember {
    Input: var_name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(var_name, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        len = StringLength(var_name)
        i = 0
        WhileLoop LessThan(i, len) {
            ch = GetByte(var_name, i)
            IfCondition EqualTo(ch, 46) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Analyzer.IsVarDeallocated {
    Input: var_name: Address
    Output: Integer
    Body: {
        dealloc_count = XArray.XSize(Analyzer.func_dealloc_vars)
        j = 0
        WhileLoop LessThan(j, dealloc_count) {
            dealloc_var = XArray.XGet(Analyzer.func_dealloc_vars, j)
            IfCondition EqualTo(Analyzer.StrEqual(var_name, dealloc_var), 1) ThenBlock: {
                ReturnValue(1)
            }
            j = Add(j, 1)
        }
        ReturnValue(0)
    }
}

Function.Analyzer.IsVarReturned {
    Input: var_name: Address
    Output: Integer
    Body: {
        ret_count = XArray.XSize(Analyzer.func_returned_vars)
        j = 0
        WhileLoop LessThan(j, ret_count) {
            ret_var = XArray.XGet(Analyzer.func_returned_vars, j)
            IfCondition EqualTo(Analyzer.StrEqual(var_name, ret_var), 1) ThenBlock: {
                ReturnValue(1)
            }
            j = Add(j, 1)
        }
        ReturnValue(0)
    }
}

Function.Analyzer.IsVarUsed {
    Input: var_name: Address
    Output: Integer
    Body: {
        used_count = XArray.XSize(Analyzer.func_used_vars)
        j = 0
        WhileLoop LessThan(j, used_count) {
            used_var = XArray.XGet(Analyzer.func_used_vars, j)
            IfCondition EqualTo(Analyzer.StrEqual(var_name, used_var), 1) ThenBlock: {
                ReturnValue(1)
            }
            j = Add(j, 1)
        }
        ReturnValue(0)
    }
}

Function.Analyzer.IsIgnorableVar {
    Input: var_name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(var_name, 0) ThenBlock: {
            ReturnValue(1)
        }
        
        len = StringLength(var_name)
        
        // Single char vars like i, j, k are often loop counters
        IfCondition EqualTo(len, 1) ThenBlock: {
            ReturnValue(1)
        }
        
        // Variables starting with underscore are intentionally unused
        first = GetByte(var_name, 0)
        IfCondition EqualTo(first, 95) ThenBlock: {
            ReturnValue(1)
        }
        
        // FixedPool members (contain a dot) - these are global state
        i = 0
        WhileLoop LessThan(i, len) {
            ch = GetByte(var_name, i)
            IfCondition EqualTo(ch, 46) ThenBlock: {
                // Found a dot - it's Pool.member syntax
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        
        ReturnValue(0)
    }
}

// =============================================================================
// AST WALKER
// =============================================================================
Function.Analyzer.WalkNode {
    Input: node: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        node_type = AST_GetType(node)
        node_line = AST_GetLine(node)
        
        // === FUNCTION ENTRY ===
        IfCondition EqualTo(node_type, AST.FUNCTION) ThenBlock: {
            func_name = AST_GetData1(node)
            Analyzer.EnterFunction(func_name, node_line, 0)
            
            // Check for Output declaration and parameter count
            Analyzer.ScanFunctionHeader(node)
            
            // Walk children
            Analyzer.WalkChildren(node)
            
            // Exit function - run all checks
            Analyzer.ExitFunction()
            ReturnValue(0)
        }
        
        // === SUBROUTINE ===
        IfCondition EqualTo(node_type, AST.SUBROUTINE) ThenBlock: {
            func_name = AST_GetData1(node)
            Analyzer.EnterFunction(func_name, node_line, 1)
            Analyzer.WalkChildren(node)
            Analyzer.ExitFunction()
            ReturnValue(0)
        }
        
        // === OUTPUT DECLARATION ===
        IfCondition EqualTo(node_type, AST.OUTPUT_DECL) ThenBlock: {
            Analyzer.func_has_output = 1
            ReturnValue(0)
        }
        
        // === RETURN VALUE ===
        IfCondition EqualTo(node_type, AST.RETURN) ThenBlock: {
            Analyzer.func_has_return = 1
            
            // Track what variable is returned (for memory analysis)
            child_count = AST_GetChildCount(node)
            IfCondition GreaterThan(child_count, 0) ThenBlock: {
                ret_expr = AST_GetChild(node, 0)
                IfCondition NotEqual(ret_expr, 0) ThenBlock: {
                    ret_type = AST_GetType(ret_expr)
                    IfCondition EqualTo(ret_type, AST.IDENTIFIER) ThenBlock: {
                        ret_var = AST_GetData1(ret_expr)
                        Analyzer.RecordReturnedVar(ret_var)
                        Analyzer.RecordUsage(ret_var)
                    } ElseBlock: {
                        // Walk the return expression to track any var usage
                        Analyzer.WalkNode(ret_expr)
                    }
                }
            }
            ReturnValue(0)
        }
        
        // === BLOCK NESTING ===
        IfCondition EqualTo(node_type, AST.BODY) ThenBlock: {
            Analyzer.block_depth = Add(Analyzer.block_depth, 1)
            IfCondition GreaterThan(Analyzer.block_depth, Analyzer.max_block_depth) ThenBlock: {
                Analyzer.max_block_depth = Analyzer.block_depth
                Analyzer.max_depth_func = Analyzer.current_func
                Analyzer.max_depth_line = node_line
            }
            Analyzer.WalkChildren(node)
            Analyzer.block_depth = Subtract(Analyzer.block_depth, 1)
            ReturnValue(0)
        }
        
        IfCondition EqualTo(node_type, AST.BLOCK) ThenBlock: {
            Analyzer.block_depth = Add(Analyzer.block_depth, 1)
            IfCondition GreaterThan(Analyzer.block_depth, Analyzer.max_block_depth) ThenBlock: {
                Analyzer.max_block_depth = Analyzer.block_depth
                Analyzer.max_depth_func = Analyzer.current_func
                Analyzer.max_depth_line = node_line
            }
            Analyzer.WalkChildren(node)
            Analyzer.block_depth = Subtract(Analyzer.block_depth, 1)
            ReturnValue(0)
        }
        
        // === ASSIGNMENT - check for Allocate, track variable ===
        IfCondition EqualTo(node_type, AST.ASSIGNMENT) ThenBlock: {
            target = AST_GetData1(node)
            Analyzer.RecordAssignment(target)
            
            child_count = AST_GetChildCount(node)
            IfCondition GreaterThan(child_count, 0) ThenBlock: {
                value = AST_GetChild(node, 0)
                IfCondition NotEqual(value, 0) ThenBlock: {
                    value_type = AST_GetType(value)
                    
                    // Check if RHS is Allocate call
                    IfCondition EqualTo(value_type, AST.CALL) ThenBlock: {
                        call_name = AST_GetData1(value)
                        IfCondition NotEqual(call_name, 0) ThenBlock: {
                            is_alloc = Analyzer.StrEqual(call_name, "Allocate")
                            IfCondition EqualTo(is_alloc, 1) ThenBlock: {
                                Analyzer.RecordAlloc(target, node_line)
                            }
                        }
                    }
                    
                    // Walk RHS to track variable usage
                    Analyzer.WalkNode(value)
                }
            }
            ReturnValue(0)
        }
        
        // === IDENTIFIER - track variable usage ===
        IfCondition EqualTo(node_type, AST.IDENTIFIER) ThenBlock: {
            var_name = AST_GetData1(node)
            Analyzer.RecordUsage(var_name)
            ReturnValue(0)
        }
        
        // === FUNCTION CALL ===
        IfCondition EqualTo(node_type, AST.CALL) ThenBlock: {
            call_name = AST_GetData1(node)
            
            IfCondition NotEqual(call_name, 0) ThenBlock: {
                // Record as called
                Analyzer.RecordCalledFunc(call_name)
                
                // Check for Deallocate
                is_dealloc = Analyzer.StrEqual(call_name, "Deallocate")
                IfCondition EqualTo(is_dealloc, 1) ThenBlock: {
                    child_count = AST_GetChildCount(node)
                    IfCondition GreaterThan(child_count, 0) ThenBlock: {
                        arg = AST_GetChild(node, 0)
                        IfCondition NotEqual(arg, 0) ThenBlock: {
                            arg_type = AST_GetType(arg)
                            IfCondition EqualTo(arg_type, AST.IDENTIFIER) ThenBlock: {
                                var_name = AST_GetData1(arg)
                                Analyzer.RecordDealloc(var_name, node_line)
                                Analyzer.RecordUsage(var_name)
                            }
                        }
                    }
                }
            }
            
            // Walk arguments to track usage
            Analyzer.WalkChildren(node)
            ReturnValue(0)
        }
        
        // === DEFAULT: recurse ===
        Analyzer.WalkChildren(node)
    }
}

Function.Analyzer.ScanFunctionHeader {
    Input: func_node: Address
    Body: {
        child_count = AST_GetChildCount(func_node)
        param_count = 0
        
        i = 0
        WhileLoop LessThan(i, child_count) {
            child = AST_GetChild(func_node, i)
            IfCondition NotEqual(child, 0) ThenBlock: {
                child_type = AST_GetType(child)
                
                // Count parameters
                IfCondition EqualTo(child_type, AST.PARAMETER) ThenBlock: {
                    param_count = Add(param_count, 1)
                    // Record parameter as assigned (it has a value from caller)
                    param_name = AST_GetData1(child)
                    Analyzer.RecordAssignment(param_name)
                }
                
                // Check for output declaration
                IfCondition EqualTo(child_type, AST.OUTPUT_DECL) ThenBlock: {
                    Analyzer.func_has_output = 1
                }
            }
            i = Add(i, 1)
        }
        
        // Check parameter count
        IfCondition EqualTo(Analyzer.check_style, 1) ThenBlock: {
            IfCondition GreaterThan(param_count, Analyzer.max_params) ThenBlock: {
                func_name = AST_GetData1(func_node)
                node_line = AST_GetLine(func_node)
                msg = StringConcat("Line ", NumberToString(node_line))
                msg = StringConcat(msg, ": Function '")
                IfCondition NotEqual(func_name, 0) ThenBlock: {
                    msg = StringConcat(msg, func_name)
                }
                msg = StringConcat(msg, "' has ")
                msg = StringConcat(msg, NumberToString(param_count))
                msg = StringConcat(msg, " params (max: ")
                msg = StringConcat(msg, NumberToString(Analyzer.max_params))
                msg = StringConcat(msg, ")")
                Analyzer.AddWarning(msg)
            }
        }
    }
}

Function.Analyzer.WalkChildren {
    Input: node: Address
    Body: {
        child_count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, child_count) {
            child = AST_GetChild(node, i)
            Analyzer.WalkNode(child)
            i = Add(i, 1)
        }
    }
}

// =============================================================================
// POST-ANALYSIS CHECKS
// =============================================================================
Function.Analyzer.PostAnalysis {
    Body: {
        // Check for undefined functions (called but not defined)
        called_count = XArray.XSize(Analyzer.called_funcs)
        i = 0
        WhileLoop LessThan(i, called_count) {
            called = XArray.XGet(Analyzer.called_funcs, i)
            is_defined = Analyzer.IsFuncDefined(called)
            IfCondition EqualTo(is_defined, 0) ThenBlock: {
                // Check if it's a builtin
                is_builtin = Analyzer.IsBuiltinFunc(called)
                IfCondition EqualTo(is_builtin, 0) ThenBlock: {
                    msg = StringConcat("Function '", "")
                    IfCondition NotEqual(called, 0) ThenBlock: {
                        msg = StringConcat(msg, called)
                    }
                    msg = StringConcat(msg, "' called but not defined")
                    Analyzer.AddWarning(msg)
                }
            }
            i = Add(i, 1)
        }
        
        // Check for unused functions (defined but never called)
        // Skip entry points like Main, Init, Run*, Test*
        defined_count = XArray.XSize(Analyzer.defined_funcs)
        i = 0
        WhileLoop LessThan(i, defined_count) {
            defined = XArray.XGet(Analyzer.defined_funcs, i)
            is_called = Analyzer.IsFuncCalled(defined)
            IfCondition EqualTo(is_called, 0) ThenBlock: {
                is_entry = Analyzer.IsEntryPoint(defined)
                IfCondition EqualTo(is_entry, 0) ThenBlock: {
                    msg = StringConcat("Function '", "")
                    IfCondition NotEqual(defined, 0) ThenBlock: {
                        msg = StringConcat(msg, defined)
                    }
                    msg = StringConcat(msg, "' defined but never called")
                    Analyzer.AddWarning(msg)
                }
            }
            i = Add(i, 1)
        }
    }
}

Function.Analyzer.IsFuncDefined {
    Input: name: Address
    Output: Integer
    Body: {
        count = XArray.XSize(Analyzer.defined_funcs)
        i = 0
        WhileLoop LessThan(i, count) {
            defined = XArray.XGet(Analyzer.defined_funcs, i)
            IfCondition EqualTo(Analyzer.StrEqual(name, defined), 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Analyzer.IsFuncCalled {
    Input: name: Address
    Output: Integer
    Body: {
        count = XArray.XSize(Analyzer.called_funcs)
        i = 0
        WhileLoop LessThan(i, count) {
            called = XArray.XGet(Analyzer.called_funcs, i)
            IfCondition EqualTo(Analyzer.StrEqual(name, called), 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Analyzer.IsEntryPoint {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        len = StringLength(name)
        IfCondition LessThan(len, 3) ThenBlock: {
            ReturnValue(0)
        }
        
        // Check common prefixes
        c0 = GetByte(name, 0)
        c1 = GetByte(name, 1)
        c2 = GetByte(name, 2)
        
        // "Run" = 82,117,110
        IfCondition And(EqualTo(c0, 82), And(EqualTo(c1, 117), EqualTo(c2, 110))) ThenBlock: {
            ReturnValue(1)
        }
        
        IfCondition GreaterEqual(len, 4) ThenBlock: {
            c3 = GetByte(name, 3)
            // "Main" = 77,97,105,110
            IfCondition And(EqualTo(c0, 77), And(EqualTo(c1, 97), And(EqualTo(c2, 105), EqualTo(c3, 110)))) ThenBlock: {
                ReturnValue(1)
            }
            // "Init" = 73,110,105,116
            IfCondition And(EqualTo(c0, 73), And(EqualTo(c1, 110), And(EqualTo(c2, 105), EqualTo(c3, 116)))) ThenBlock: {
                ReturnValue(1)
            }
            // "Test" = 84,101,115,116
            IfCondition And(EqualTo(c0, 84), And(EqualTo(c1, 101), And(EqualTo(c2, 115), EqualTo(c3, 116)))) ThenBlock: {
                ReturnValue(1)
            }
        }
        
        ReturnValue(0)
    }
}

Function.Analyzer.IsBuiltinFunc {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        // Common builtins
        cmp = StringCompare(name, "Add")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "Subtract")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "Multiply")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "Divide")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "Modulo")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "EqualTo")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "NotEqual")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "LessThan")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "GreaterThan")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "LessEqual")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "GreaterEqual")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "And")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "Or")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "Not")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "BitwiseAnd")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "BitwiseOr")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "BitwiseXor")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "ShiftLeft")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "ShiftRight")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "PrintMessage")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "PrintNumber")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "PrintChar")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "PrintString")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "StringLength")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "StringCompare")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "StringConcat")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "NumberToString")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "GetByte")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "SetByte")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "Allocate")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "Deallocate")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "ArrayCreate")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "ArrayGet")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "ArraySet")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "ArrayDestroy")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "Dereference")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "StoreValue")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "SystemCall")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "Exit")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        
        ReturnValue(0)
    }
}

// =============================================================================
// HELPERS
// =============================================================================
Function.Analyzer.CountParams {
    Input: func_node: Address
    Output: Integer
    Body: {
        count = 0
        child_count = AST_GetChildCount(func_node)
        
        i = 0
        WhileLoop LessThan(i, child_count) {
            child = AST_GetChild(func_node, i)
            IfCondition NotEqual(child, 0) ThenBlock: {
                child_type = AST_GetType(child)
                IfCondition EqualTo(child_type, AST.PARAMETER) ThenBlock: {
                    count = Add(count, 1)
                }
            }
            i = Add(i, 1)
        }
        
        ReturnValue(count)
    }
}

// =============================================================================
// REPORT
// =============================================================================
Function.Analyzer.Report {
    Body: {
        PrintMessage("\n")
        PrintMessage("========================================\n")
        PrintMessage("        Code Analysis Report\n")
        PrintMessage("========================================\n")
        PrintMessage("NOTE: Line numbers show 0 when AST lacks\n")
        PrintMessage("      position info. Use 'dump' to get\n")
        PrintMessage("      combined_source.ailang for reference.\n")
        PrintMessage("========================================\n\n")
        
        // Stats
        PrintMessage("--- Statistics ---\n")
        PrintMessage("Functions analyzed: ")
        PrintNumber(Analyzer.functions_analyzed)
        PrintMessage("\n")
        PrintMessage("SubRoutines analyzed: ")
        PrintNumber(Analyzer.subroutines_analyzed)
        PrintMessage("\n")
        PrintMessage("Functions defined: ")
        PrintNumber(XArray.XSize(Analyzer.defined_funcs))
        PrintMessage("\n")
        PrintMessage("Functions called: ")
        PrintNumber(XArray.XSize(Analyzer.called_funcs))
        PrintMessage("\n\n")
        
        PrintMessage("--- Memory ---\n")
        PrintMessage("Total Allocate() calls: ")
        PrintNumber(Analyzer.total_allocs)
        PrintMessage("\n")
        PrintMessage("Total Deallocate() calls: ")
        PrintNumber(Analyzer.total_deallocs)
        PrintMessage("\n")
        
        diff = Subtract(Analyzer.total_allocs, Analyzer.total_deallocs)
        IfCondition GreaterThan(diff, 0) ThenBlock: {
            PrintMessage("Allocation imbalance: +")
            PrintNumber(diff)
            PrintMessage(" (review warnings)\n")
        }
        IfCondition LessThan(diff, 0) ThenBlock: {
            neg_diff = Subtract(0, diff)
            PrintMessage("Deallocation excess: +")
            PrintNumber(neg_diff)
            PrintMessage(" (possible double-free risk)\n")
        }
        IfCondition EqualTo(diff, 0) ThenBlock: {
            PrintMessage("Allocation balance: OK\n")
        }
        PrintMessage("\n")
        
        PrintMessage("--- Style ---\n")
        PrintMessage("Max nesting depth: ")
        PrintNumber(Analyzer.max_block_depth)
        IfCondition NotEqual(Analyzer.max_depth_func, 0) ThenBlock: {
            PrintMessage(" (in '")
            PrintMessage(Analyzer.max_depth_func)
            PrintMessage("')")
        }
        PrintMessage("\n")
        
        // Check nesting limit
        IfCondition GreaterThan(Analyzer.max_block_depth, Analyzer.max_nesting) ThenBlock: {
            msg = StringConcat("Max nesting depth ", NumberToString(Analyzer.max_block_depth))
            msg = StringConcat(msg, " exceeds limit of ")
            msg = StringConcat(msg, NumberToString(Analyzer.max_nesting))
            Analyzer.AddWarning(msg)
        }
        
        PrintMessage("\n")
        
        // Errors
        IfCondition GreaterThan(Analyzer.error_count, 0) ThenBlock: {
            PrintMessage("========================================\n")
            PrintMessage("ERRORS (")
            PrintNumber(Analyzer.error_count)
            PrintMessage("):\n")
            PrintMessage("========================================\n")
            
            i = 0
            WhileLoop LessThan(i, Analyzer.error_count) {
                msg = XArray.XGet(Analyzer.errors, i)
                PrintMessage("  [ERROR] ")
                PrintMessage(msg)
                PrintMessage("\n")
                i = Add(i, 1)
            }
            PrintMessage("\n")
        }
        
        // Warnings
        IfCondition GreaterThan(Analyzer.warning_count, 0) ThenBlock: {
            PrintMessage("========================================\n")
            PrintMessage("WARNINGS (")
            PrintNumber(Analyzer.warning_count)
            PrintMessage("):\n")
            PrintMessage("========================================\n")
            
            i = 0
            WhileLoop LessThan(i, Analyzer.warning_count) {
                msg = XArray.XGet(Analyzer.warnings, i)
                PrintMessage("  [WARN] ")
                PrintMessage(msg)
                PrintMessage("\n")
                i = Add(i, 1)
            }
            PrintMessage("\n")
        }
        
        // Summary
        PrintMessage("========================================\n")
        IfCondition And(EqualTo(Analyzer.error_count, 0), EqualTo(Analyzer.warning_count, 0)) ThenBlock: {
            PrintMessage("  No issues found!\n")
        } ElseBlock: {
            PrintMessage("  Summary: ")
            PrintNumber(Analyzer.error_count)
            PrintMessage(" error(s), ")
            PrintNumber(Analyzer.warning_count)
            PrintMessage(" warning(s)\n")
        }
        PrintMessage("========================================\n\n")
    }
}

// =============================================================================
// CLEANUP
// =============================================================================
Function.Analyzer.Cleanup {
    Body: {
        IfCondition NotEqual(Analyzer.warnings, 0) ThenBlock: {
            XArray.XDestroy(Analyzer.warnings)
            Analyzer.warnings = 0
        }
        IfCondition NotEqual(Analyzer.errors, 0) ThenBlock: {
            XArray.XDestroy(Analyzer.errors)
            Analyzer.errors = 0
        }
        IfCondition NotEqual(Analyzer.func_alloc_vars, 0) ThenBlock: {
            XArray.XDestroy(Analyzer.func_alloc_vars)
            Analyzer.func_alloc_vars = 0
        }
        IfCondition NotEqual(Analyzer.func_alloc_lines, 0) ThenBlock: {
            XArray.XDestroy(Analyzer.func_alloc_lines)
            Analyzer.func_alloc_lines = 0
        }
        IfCondition NotEqual(Analyzer.func_dealloc_vars, 0) ThenBlock: {
            XArray.XDestroy(Analyzer.func_dealloc_vars)
            Analyzer.func_dealloc_vars = 0
        }
        IfCondition NotEqual(Analyzer.func_dealloc_lines, 0) ThenBlock: {
            XArray.XDestroy(Analyzer.func_dealloc_lines)
            Analyzer.func_dealloc_lines = 0
        }
        IfCondition NotEqual(Analyzer.func_returned_vars, 0) ThenBlock: {
            XArray.XDestroy(Analyzer.func_returned_vars)
            Analyzer.func_returned_vars = 0
        }
        IfCondition NotEqual(Analyzer.func_assigned_vars, 0) ThenBlock: {
            XArray.XDestroy(Analyzer.func_assigned_vars)
            Analyzer.func_assigned_vars = 0
        }
        IfCondition NotEqual(Analyzer.func_used_vars, 0) ThenBlock: {
            XArray.XDestroy(Analyzer.func_used_vars)
            Analyzer.func_used_vars = 0
        }
        IfCondition NotEqual(Analyzer.defined_funcs, 0) ThenBlock: {
            XArray.XDestroy(Analyzer.defined_funcs)
            Analyzer.defined_funcs = 0
        }
        IfCondition NotEqual(Analyzer.called_funcs, 0) ThenBlock: {
            XArray.XDestroy(Analyzer.called_funcs)
            Analyzer.called_funcs = 0
        }
        IfCondition NotEqual(Analyzer.func_call_counts, 0) ThenBlock: {
            XArray.XDestroy(Analyzer.func_call_counts)
            Analyzer.func_call_counts = 0
        }
        
        Analyzer.warning_count = 0
        Analyzer.error_count = 0
    }
}

// =============================================================================
// CONFIGURATION
// =============================================================================
Function.Analyzer.Enable {
    Body: {
        Analyzer.enabled = 1
    }
}

Function.Analyzer.Disable {
    Body: {
        Analyzer.enabled = 0
    }
}

Function.Analyzer.SetVerbose {
    Input: val: Integer
    Body: {
        Analyzer.verbose = val
    }
}

Function.Analyzer.IsEnabled {
    Output: Integer
    Body: {
        ReturnValue(Analyzer.enabled)
    }
}

// === Inlined from DiagnosticStore ===
// Library.DiagnosticStore.ailang
// Shared diagnostic output contract for analyzers and consumers (console, LSP, IDE)
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL).


// =============================================================================
// SEVERITY CONSTANTS
// =============================================================================
FixedPool.DiagSeverity {
    "ERROR": Initialize=1
    "WARNING": Initialize=2
    "INFO": Initialize=3
    "HINT": Initialize=4
}

// =============================================================================
// DIAGNOSTIC STORE STATE
// =============================================================================
FixedPool.DiagStore {
    "diagnostics": Initialize=0, CanChange=True
    "count": Initialize=0, CanChange=True
    "file": Initialize=0, CanChange=True
}

// =============================================================================
// INITIALIZATION / LIFECYCLE
// =============================================================================

Function.DiagStore.Init {
    Body: {
        // Destroy old array if re-initializing
        IfCondition NotEqual(DiagStore.diagnostics, 0) ThenBlock: {
            XArray.XDestroy(DiagStore.diagnostics)
        }
        DiagStore.diagnostics = XArray.XCreate(64)
        DiagStore.count = 0
        DiagStore.file = 0
    }
}

Function.DiagStore.SetFile {
    Input: filename: Address
    Body: {
        DiagStore.file = filename
    }
}

Function.DiagStore.Clear {
    Body: {
        // Don't JSON.Free individual diagnostics — they contain
        // string literals and arena pointers that must not be freed.
        // Just destroy the container and recreate.
        XArray.XDestroy(DiagStore.diagnostics)
        DiagStore.diagnostics = XArray.XCreate(64)
        DiagStore.count = 0
    }
}

Function.DiagStore.Cleanup {
    Body: {
        IfCondition NotEqual(DiagStore.diagnostics, 0) ThenBlock: {
            // Don't JSON.Free individual diagnostics — they contain
            // string literals and arena pointers that must not be freed.
            // Just destroy the container.
            XArray.XDestroy(DiagStore.diagnostics)
            DiagStore.diagnostics = 0
        }
        DiagStore.count = 0
        DiagStore.file = 0
    }
}

// =============================================================================
// ADD DIAGNOSTIC
// =============================================================================

Function.DiagStore.Add {
    Input: line: Integer
    Input: col: Integer
    Input: severity: Integer
    Input: code: Address
    Input: message: Address
    Body: {
        obj = JSON.NewObject()

        // Set file if we have one
        IfCondition NotEqual(DiagStore.file, 0) ThenBlock: {
            JSON.SetString(obj, "file", DiagStore.file)
        } ElseBlock: {
            JSON.SetString(obj, "file", "unknown")
        }

        JSON.SetNumber(obj, "line", line)
        JSON.SetNumber(obj, "col", col)
        JSON.SetNumber(obj, "severity", severity)
        JSON.SetString(obj, "code", code)
        JSON.SetString(obj, "message", message)

        // Tag as object and push
        tagged = JSON.Tag(JType.OBJECT, obj)
        XArray.XPush(DiagStore.diagnostics, tagged)
        DiagStore.count = Add(DiagStore.count, 1)
    }
}

// =============================================================================
// ACCESSORS
// =============================================================================

Function.DiagStore.Count {
    Output: Integer
    Body: {
        ReturnValue(DiagStore.count)
    }
}

Function.DiagStore.Get {
    Input: index: Integer
    Output: Address
    Body: {
        IfCondition GreaterEqual(index, DiagStore.count) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition LessThan(index, 0) ThenBlock: {
            ReturnValue(0)
        }
        tagged = XArray.XGet(DiagStore.diagnostics, index)
        ReturnValue(tagged)
    }
}

// =============================================================================
// OUTPUT: JSON SERIALIZATION
// =============================================================================

Function.DiagStore.ToJSON {
    Output: Address
    Body: {
        // Build an XArray of the diagnostic objects, serialize as JSON array
        ct = DiagStore.count

        IfCondition EqualTo(ct, 0) ThenBlock: {
            // Return "[]"
            empty = Allocate(3)
            StoreValue(empty, 91)
            StoreValue(Add(empty, 1), 93)
            StoreValue(Add(empty, 2), 0)
            ReturnValue(empty)
        }

        // Build result string manually: [ obj1, obj2, ... ]
        result = StringConcat("[", "")

        i = 0
        WhileLoop LessThan(i, ct) {
            tagged = XArray.XGet(DiagStore.diagnostics, i)
            obj = JSON.AsObject(tagged)
            serialized = JSON.SerializeObject(obj)

            IfCondition GreaterThan(i, 0) ThenBlock: {
                temp = result
                result = StringConcat(result, ",")
                Deallocate(temp, 0)
            }

            temp = result
            result = StringConcat(result, serialized)
            Deallocate(temp, 0)

            i = Add(i, 1)
        }

        temp = result
        result = StringConcat(result, "]")
        Deallocate(temp, 0)

        ReturnValue(result)
    }
}

// =============================================================================
// OUTPUT: CONSOLE PRETTY-PRINT
// =============================================================================

Function.DiagStore.PrintConsole {
    Body: {
        ct = DiagStore.count

        IfCondition EqualTo(ct, 0) ThenBlock: {
            PrintMessage("  No diagnostics.\n")
        } ElseBlock: {

        i = 0
        WhileLoop LessThan(i, ct) {
            tagged = XArray.XGet(DiagStore.diagnostics, i)
            obj = JSON.AsObject(tagged)

            // Severity label
            sev = JSON.GetNumber(obj, "severity")
            IfCondition EqualTo(sev, DiagSeverity.ERROR) ThenBlock: {
                PrintMessage("[ERROR] ")
            }
            IfCondition EqualTo(sev, DiagSeverity.WARNING) ThenBlock: {
                PrintMessage("[WARN]  ")
            }
            IfCondition EqualTo(sev, DiagSeverity.INFO) ThenBlock: {
                PrintMessage("[INFO]  ")
            }
            IfCondition EqualTo(sev, DiagSeverity.HINT) ThenBlock: {
                PrintMessage("[HINT]  ")
            }

            // file:line:col
            file_str = JSON.GetString(obj, "file")
            IfCondition NotEqual(file_str, 0) ThenBlock: {
                PrintMessage(file_str)
            }
            PrintMessage(":")
            line_num = JSON.GetNumber(obj, "line")
            PrintNumber(line_num)
            PrintMessage(":")
            col_num = JSON.GetNumber(obj, "col")
            PrintNumber(col_num)
            PrintMessage(" ")

            // code + message
            code_str = JSON.GetString(obj, "code")
            IfCondition NotEqual(code_str, 0) ThenBlock: {
                PrintMessage(code_str)
                PrintMessage(": ")
            }
            msg_str = JSON.GetString(obj, "message")
            IfCondition NotEqual(msg_str, 0) ThenBlock: {
                PrintMessage(msg_str)
            }
            PrintMessage("\n")

            i = Add(i, 1)
        }

        }
    }
}

// =============================================================================
// HELPER: Severity name for external use
// =============================================================================

Function.DiagStore.SeverityName {
    Input: severity: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(severity, DiagSeverity.ERROR) ThenBlock: {
            ReturnValue("error")
        }
        IfCondition EqualTo(severity, DiagSeverity.WARNING) ThenBlock: {
            ReturnValue("warning")
        }
        IfCondition EqualTo(severity, DiagSeverity.INFO) ThenBlock: {
            ReturnValue("info")
        }
        IfCondition EqualTo(severity, DiagSeverity.HINT) ThenBlock: {
            ReturnValue("hint")
        }
        ReturnValue("unknown")
    }
}

// === Inlined from JSON ===
// Library.JSON.ailang
// JSON Parse & Build Library for AILang - v2.2
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering.
// Licensed under SCSL.
//
// v2.2 FIX:
//   - Removed ConcatFree function entirely. The self-hosting compiler
//     has codegen issues with a helper that calls StringConcat then
//     Deallocate on its own input parameter (register clobber between
//     the two built-in calls).
//   - All serialization now uses the proven v1 inline temp pattern:
//       temp = result
//       result = StringConcat(result, something)
//       Deallocate(temp, 0)
//   - All Deallocate calls use size 0 (allocator auto-detect)
//
// TAGGED VALUE LAYOUT (16 bytes):
//   [0-7]  type tag (JType constant)
//   [8-15] value (Address for strings/objects/arrays, Integer for numbers/bools)


// =============================================================================
// CONSTANTS
// =============================================================================
FixedPool.JType {
    "NULL": Initialize=0
    "STRING": Initialize=1
    "NUMBER": Initialize=2
    "BOOL": Initialize=3
    "OBJECT": Initialize=4
    "ARRAY": Initialize=5
}

FixedPool.JParse {
    "buffer": Initialize=0, CanChange=True
    "size": Initialize=0, CanChange=True
    "pos": Initialize=0, CanChange=True
    "error": Initialize=0, CanChange=True
    "error_msg": Initialize=0, CanChange=True
}

// =============================================================================
// TAGGED VALUE MANAGEMENT
// =============================================================================
Function.JSON.Tag {
    Input: vtype: Integer
    Input: value: Address
    Output: Address
    Body: {
        t = Allocate(16)
        StoreValue(t, vtype)
        StoreValue(Add(t, 8), value)
        ReturnValue(t)
    }
}

Function.JSON.TagType {
    Input: tagged: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(tagged, 0) ThenBlock: { ReturnValue(JType.NULL) }
        ReturnValue(Dereference(tagged))
    }
}

Function.JSON.TagValue {
    Input: tagged: Address
    Output: Address
    Body: {
        IfCondition EqualTo(tagged, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(Add(tagged, 8)))
    }
}

// =============================================================================
// UNWRAP HELPERS
// =============================================================================
Function.JSON.AsObject {
    Input: tagged: Address
    Output: Address
    Body: {
        IfCondition EqualTo(tagged, 0) ThenBlock: { ReturnValue(0) }
        vtype = Dereference(tagged)
        IfCondition NotEqual(vtype, JType.OBJECT) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(Add(tagged, 8)))
    }
}

Function.JSON.AsArray {
    Input: tagged: Address
    Output: Address
    Body: {
        IfCondition EqualTo(tagged, 0) ThenBlock: { ReturnValue(0) }
        vtype = Dereference(tagged)
        IfCondition NotEqual(vtype, JType.ARRAY) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(Add(tagged, 8)))
    }
}

Function.JSON.AsString {
    Input: tagged: Address
    Output: Address
    Body: {
        IfCondition EqualTo(tagged, 0) ThenBlock: { ReturnValue(0) }
        vtype = Dereference(tagged)
        IfCondition NotEqual(vtype, JType.STRING) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(Add(tagged, 8)))
    }
}

Function.JSON.AsNumber {
    Input: tagged: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(tagged, 0) ThenBlock: { ReturnValue(0) }
        vtype = Dereference(tagged)
        IfCondition NotEqual(vtype, JType.NUMBER) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(Add(tagged, 8)))
    }
}

Function.JSON.AsBool {
    Input: tagged: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(tagged, 0) ThenBlock: { ReturnValue(0) }
        vtype = Dereference(tagged)
        IfCondition NotEqual(vtype, JType.BOOL) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(Add(tagged, 8)))
    }
}

