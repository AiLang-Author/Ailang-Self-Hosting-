    "target": Initialize=1, CanChange=True
    "code": Initialize=0, CanChange=True
    "code_size": Initialize=0, CanChange=True
    "code_capacity": Initialize=0, CanChange=True
    
   
    "data": Initialize=0, CanChange=True
