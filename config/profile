# /etc/profile — login shell environment for Ailang OS
# Sourced by busybox ash when argv[0] is -sh (see terminal_ipc.ailang).

export PATH="/system/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
export HOSTNAME="${HOSTNAME:-$(hostname 2>/dev/null)}"
export USER="${USER:-$(id -un 2>/dev/null)}"
export LOGNAME="${LOGNAME:-$USER}"
export SHELL="${SHELL:-/bin/sh}"
export EDITOR="${EDITOR:-/bin/vi}"
export HISTFILE="${HOME:-/root}/.ash_history"
export HISTSIZE="${HISTSIZE:-1000}"

if [ -t 0 ] || [ -n "$PS1" ]; then
	# busybox FEATURE_EDITING_FANCY_PROMPT: user@host:cwd#
	export PS1='\u@\h:\w\$ '
	set -o emacs 2>/dev/null
	alias ls='ls -F'
	alias ll='ls -lF'
fi

if [ -d /etc/profile.d ]; then
	for i in /etc/profile.d/*.sh; do
		[ -r "$i" ] && . "$i"
	done
	unset i
fi

cd "${HOME:-/root}" 2>/dev/null
