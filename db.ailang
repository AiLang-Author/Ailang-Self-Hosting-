LibraryImport.HashMap

SubRoutine.Main {
    PrintMessage("=== Full Stress Test ===\n")
    
    map = HashMap.Create(64)
    
    // Insert 100
    PrintMessage("Inserting 100 keys...\n")
    i = 0
    WhileLoop LessThan(i, 100) {
        key = StringConcat("key_", NumberToString(i))
        HashMap.Set(map, key, i)
        i = Add(i, 1)
    }
    PrintMessage("Insert done.\n")
    
    // Verify all 100
    PrintMessage("Verifying 100 keys...\n")
    i = 0
    WhileLoop LessThan(i, 100) {
        key = StringConcat("key_", NumberToString(i))
        val = HashMap.Get(map, key)
        IfCondition NotEqual(val, i) ThenBlock: {
            PrintMessage("MISMATCH at ")
            PrintNumber(i)
            PrintMessage("\n")
        }
        i = Add(i, 1)
    }
    PrintMessage("Verify done.\n")
    
    // Check size
    PrintMessage("Size: ")
    PrintNumber(HashMap.Size(map))
    PrintMessage("\n")
    
    PrintMessage("SUCCESS!\n")
}

RunTask(Main)