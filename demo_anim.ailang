LibraryImport.Arena
LibraryImport.Anim
LibraryImport.Display.Render.DSurfaceTypes
LibraryImport.Display.Render.DSurface
LibraryImport.Display.Render.DDrawPixel
LibraryImport.Display.Render.Framebuffer

Function.DebugLog_Push {
    Input: tag: Address
    Input: n: Integer
    Output: Integer
    Body: { ReturnValue(0) }
}

FixedPool.DA {
    "run": Initialize=1, CanChange=True
    "ball": Initialize=-1, CanChange=True
    "x": Initialize=24, CanChange=True
    "dx": Initialize=4, CanChange=True
    "sw_on_id": Initialize=-1, CanChange=True
    "sw_off_id": Initialize=-1, CanChange=True
}

Function.DA_RGBA {
    Input: r: Integer
    Input: g: Integer
    Input: b: Integer
    Output: Integer
    Body: {
        rr = r
        gg = g
        bb = b
        c = FB_RGB(rr, gg, bb)
        ReturnValue(BitwiseOr(c, ShiftLeft(255, 24)))
    }
}

Function.DA_MakeStrip {
    Output: Integer
    Body: {
        surf = Surface_Create(SurfaceFormat.PIXEL_32, 256, 32)
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, 8) {
            r = 42
            g = 140
            b = 255
            IfCondition EqualTo(i, 1) ThenBlock: {
                r = 42
                g = 212
                b = 255
            }
            IfCondition EqualTo(i, 2) ThenBlock: {
                r = 61
                g = 220
                b = 151
            }
            IfCondition EqualTo(i, 3) ThenBlock: {
                r = 232
                g = 189
                b = 80
            }
            IfCondition EqualTo(i, 4) ThenBlock: {
                r = 226
                g = 93
                b = 216
            }
            IfCondition EqualTo(i, 5) ThenBlock: {
                r = 74
                g = 140
                b = 255
            }
            IfCondition EqualTo(i, 6) ThenBlock: {
                r = 255
                g = 255
                b = 255
            }
            IfCondition EqualTo(i, 7) ThenBlock: {
                r = 204
                g = 51
                b = 85
            }
            col = DA_RGBA(r, g, b)
            Draw_Pix_FillRect(surf, Multiply(i, 32), 0, 32, 32, col)
            ink = DA_RGBA(14, 23, 48)
            Draw_Pix_FillRect(surf, Add(Multiply(i, 32), 12), 12, 8, 8, ink)
            i = Add(i, 1)
        }
        ReturnValue(surf)
    }
}

SubRoutine.Main {
    PrintMessage("demo_anim: loop /tmp/anim_app (quit via host)\n")
    IfCondition EqualTo(FB_InitHeadless(640, 240), 0) ThenBlock: {
        PrintMessage("FAIL fb\n")
        SystemCall(60, 1, 0, 0)
    }
    IfCondition EqualTo(Anim.Init(), 0) ThenBlock: {
        PrintMessage("FAIL init\n")
        SystemCall(60, 1, 0, 0)
    }
    IfCondition EqualTo(Anim.BindFB(), 0) ThenBlock: {
        PrintMessage("FAIL bind\n")
        SystemCall(60, 1, 0, 0)
    }
    Anim.EnsureIpc()
    surf = DA_MakeStrip()
    IfCondition EqualTo(surf, 0) ThenBlock: {
        PrintMessage("FAIL strip\n")
        SystemCall(60, 1, 0, 0)
    }
    sh = Anim.AddSurf(surf)
    Anim.Grid(sh, 8, 1)
    cl = Anim.Clip(sh, 0, 7, 80)

    i = 0
    WhileLoop LessThan(i, 8) {
        Anim.Spawn(cl, Add(24, Multiply(i, 40)), 32)
        i = Add(i, 1)
    }
    DA.ball = Anim.Spawn(cl, 24, 120)
    Anim.Play(DA.ball, 1)

    on = Anim.LoadWH("ECU/assets/switch_on.svg", 72, 24)
    off = Anim.LoadWH("ECU/assets/switch_off.svg", 72, 24)
    IfCondition GreaterEqual(on, 0) ThenBlock: {
        IfCondition GreaterEqual(off, 0) ThenBlock: {
            con = Anim.Clip(on, 0, 0, 0)
            coff = Anim.Clip(off, 0, 0, 0)
            son = Anim.Spawn(con, 420, 124)
            soff = Anim.Spawn(coff, 420, 124)
            Anim.Play(son, 0)
            Anim.Play(soff, 0)
            Anim.Show(soff, 0)
            DA.sw_on_id = son
            DA.sw_off_id = soff
        }
    }

    DA.run = 1
    WhileLoop EqualTo(DA.run, 1) {
        IfCondition EqualTo(Anim.PollQuit(), 1) ThenBlock: {
            DA.run = 0
        }
        IfCondition EqualTo(DA.run, 1) ThenBlock: {
            FB_FillRect(0, 0, 640, 240, FB_RGB(14, 23, 48))
            Anim.Tick(33)
            DA.x = Add(DA.x, DA.dx)
            IfCondition GreaterThan(DA.x, 360) ThenBlock: { DA.dx = Subtract(0, 4) }
            IfCondition LessThan(DA.x, 24) ThenBlock: { DA.dx = 4 }
            Anim.Place(DA.ball, DA.x, 120)
            IfCondition GreaterEqual(DA.sw_on_id, 0) ThenBlock: {
                g = Modulo(Anim_State.gen, 16)
                IfCondition EqualTo(g, 0) ThenBlock: {
                    Anim.Show(DA.sw_on_id, 0)
                    Anim.Show(DA.sw_off_id, 1)
                }
                IfCondition EqualTo(g, 8) ThenBlock: {
                    Anim.Show(DA.sw_on_id, 1)
                    Anim.Show(DA.sw_off_id, 0)
                }
            }
            Anim.DrawAll()
            Anim.Present()
            Anim.Sleep(33)
        }
    }
    PrintMessage("demo_anim stop\n")
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
