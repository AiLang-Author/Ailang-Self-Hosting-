// demo_bars — vertical + horizontal bar graphs. Same IPC as demo_anim.
// Host: ./ECU/host/anim_shell_gtk /tmp/anim_app
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Anim
LibraryImport.Gauge
LibraryImport.Display.Render.Framebuffer

Function.DebugLog_Push {
    Input: tag: Address
    Input: n: Integer
    Output: Integer
    Body: { ReturnValue(0) }
}

FixedPool.DB {
    "run": Initialize=1, CanChange=True
    "v":   Initialize=0, CanChange=True
    "dv":  Initialize=10, CanChange=True
    "rpm": Initialize=-1, CanChange=True
    "map": Initialize=-1, CanChange=True
    "tps": Initialize=-1, CanChange=True
    "fuel": Initialize=-1, CanChange=True
    "load": Initialize=-1, CanChange=True
}

SubRoutine.Main {
    PrintMessage("demo_bars: /tmp/anim_app\n")
    IfCondition EqualTo(FB_InitHeadless(640, 400), 0) ThenBlock: {
        PrintMessage("FAIL fb\n")
        SystemCall(60, 1, 0, 0)
    }
    IfCondition EqualTo(Anim.Init(), 0) ThenBlock: {
        PrintMessage("FAIL anim\n")
        SystemCall(60, 1, 0, 0)
    }
    IfCondition EqualTo(Anim.BindFB(), 0) ThenBlock: {
        PrintMessage("FAIL bind\n")
        SystemCall(60, 1, 0, 0)
    }
    Anim.EnsureIpc()
    FB_FontInit()
    DB.rpm = Gauge.Bar(40, 36, 44, 280)
    DB.map = Gauge.Bar(160, 36, 44, 280)
    DB.tps = Gauge.Bar(280, 36, 44, 280)
    DB.fuel = Gauge.Bar(400, 36, 44, 280)
    DB.load = Gauge.BarH(40, 340, 560, 36)
    IfCondition LessThan(DB.rpm, 0) ThenBlock: {
        PrintMessage("FAIL bar\n")
        SystemCall(60, 1, 0, 0)
    }
    PrintMessage("bars ready\n")
    DB.v = 0
    DB.dv = 10
    DB.run = 1
    WhileLoop EqualTo(DB.run, 1) {
        IfCondition EqualTo(Anim.PollQuit(), 1) ThenBlock: {
            DB.run = 0
        }
        IfCondition EqualTo(DB.run, 1) ThenBlock: {
            FB_FillRect(0, 0, 640, 400, FB_RGB(14, 23, 48))
            v = DB.v
            Gauge.BarSet(DB.rpm, v, 0, 1000)
            Gauge.BarSet(DB.map, Divide(Multiply(v, 7), 10), 0, 1000)
            Gauge.BarSet(DB.tps, Subtract(1000, v), 0, 1000)
            Gauge.BarSet(DB.fuel, Add(200, Divide(v, 2)), 0, 1000)
            Gauge.BarSet(DB.load, v, 0, 1000)
            Anim.DrawAll()
            Gauge.DrawBars()
            ink = FB_RGB(255, 255, 255)
            dim = FB_RGB(122, 138, 170)
            cyan = FB_RGB(42, 212, 255)
            bg = FB_RGB(14, 23, 48)
            FB_DrawString(42, 16, "RPM", ink, -1)
            FB_DrawString(160, 16, "MAP", ink, -1)
            FB_DrawString(282, 16, "TPS", ink, -1)
            FB_DrawString(396, 16, "FUEL", ink, -1)
            FB_DrawString(40, 324, "LOAD", dim, -1)
            FB_DrawNumber(42, 322, v, cyan, bg)
            Anim.Present()
            DB.v = Add(DB.v, DB.dv)
            IfCondition GreaterThan(DB.v, 1000) ThenBlock: {
                DB.v = 1000
                DB.dv = Subtract(0, 10)
            }
            IfCondition LessThan(DB.v, 0) ThenBlock: {
                DB.v = 0
                DB.dv = 10
            }
            Anim.Sleep(33)
        }
    }
    PrintMessage("demo_bars stop\n")
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
