// demo_gauge — one 270° analog gauge. Same IPC as demo_anim.
// Host: ./ECU/host/anim_shell_gtk /tmp/anim_app
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Anim
LibraryImport.Gauge
LibraryImport.Display.Render.Framebuffer

Function.DebugLog_Push {
    Input: tag: Address
    Input: n: Integer
    Output: Integer
    Body: { ReturnValue(0) }
}

FixedPool.DG {
    "run": Initialize=1, CanChange=True
    "v":   Initialize=0, CanChange=True
    "dv":  Initialize=12, CanChange=True
}

SubRoutine.Main {
    PrintMessage("demo_gauge: 270 deg sweep /tmp/anim_app\n")
    IfCondition EqualTo(FB_InitHeadless(480, 480), 0) ThenBlock: {
        PrintMessage("FAIL fb\n")
        SystemCall(60, 1, 0, 0)
    }
    IfCondition EqualTo(Anim.Init(), 0) ThenBlock: {
        PrintMessage("FAIL anim\n")
        SystemCall(60, 1, 0, 0)
    }
    IfCondition EqualTo(Anim.BindFB(), 0) ThenBlock: {
        PrintMessage("FAIL bind\n")
        SystemCall(60, 1, 0, 0)
    }
    Anim.EnsureIpc()
    FB_FontInit()
    IfCondition NotEqual(Gauge.Make(120, 48, 240), 0) ThenBlock: {
        PrintMessage("FAIL gauge bake\n")
        SystemCall(60, 1, 0, 0)
    }
    PrintMessage("gauge ready\n")
    DG.v = 0
    DG.dv = 12
    DG.run = 1
    WhileLoop EqualTo(DG.run, 1) {
        IfCondition EqualTo(Anim.PollQuit(), 1) ThenBlock: {
            DG.run = 0
        }
        IfCondition EqualTo(DG.run, 1) ThenBlock: {
            FB_FillRect(0, 0, 480, 480, FB_RGB(14, 23, 48))
            Gauge.Set(DG.v, 0, 1000)
            Anim.DrawAll()
            FB_DrawString(220, 20, "MAP", FB_RGB(255, 255, 255), -1)
            FB_DrawNumber(216, 312, Divide(DG.v, 10), FB_RGB(42, 212, 255), FB_RGB(14, 23, 48))
            FB_DrawString(248, 312, "kPa", FB_RGB(122, 138, 170), -1)
            Anim.Present()
            DG.v = Add(DG.v, DG.dv)
            IfCondition GreaterThan(DG.v, 1000) ThenBlock: {
                DG.v = 1000
                DG.dv = Subtract(0, 12)
            }
            IfCondition LessThan(DG.v, 0) ThenBlock: {
                DG.v = 0
                DG.dv = 12
            }
            Anim.Sleep(33)
        }
    }
    PrintMessage("demo_gauge stop\n")
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
