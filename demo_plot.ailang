LibraryImport.Arena
LibraryImport.Anim
LibraryImport.Gauge
LibraryImport.Display.Render.Framebuffer

Function.DebugLog_Push {
    Input: tag: Address
    Input: n: Integer
    Output: Integer
    Body: { ReturnValue(0) }
}

FixedPool.DP {
    "run":  Initialize=1, CanChange=True
    "tick": Initialize=0, CanChange=True
    "p0":   Initialize=-1, CanChange=True
    "p1":   Initialize=-1, CanChange=True
}

Function.DP_Wave {
    Input: tick: Integer
    Input: phase: Integer
    Output: Integer
    Body: {
        d2r = Float_Div(0x400921FB54442D18, Float_FromInt(180))
        deg = Add(Multiply(tick, 6), phase)
        deg = Modulo(deg, 360)
        a = Float_Mul(d2r, Float_FromInt(deg))
        s = Gauge.Sin(a)
        ReturnValue(Add(500, Float_ToInt(Float_Mul(s, Float_FromInt(400)))))
    }
}

SubRoutine.Main {
    PrintMessage("demo_plot: live lines /tmp/anim_app\n")
    IfCondition EqualTo(FB_InitHeadless(640, 400), 0) ThenBlock: {
        PrintMessage("FAIL fb\n")
        SystemCall(60, 1, 0, 0)
    }
    IfCondition EqualTo(Anim.Init(), 0) ThenBlock: {
        PrintMessage("FAIL anim\n")
        SystemCall(60, 1, 0, 0)
    }
    IfCondition EqualTo(Anim.BindFB(), 0) ThenBlock: {
        PrintMessage("FAIL bind\n")
        SystemCall(60, 1, 0, 0)
    }
    Anim.EnsureIpc()
    FB_FontInit()
    DP.p0 = Gauge.Plot(24, 36, 592, 160)
    DP.p1 = Gauge.Plot(24, 220, 592, 160)
    IfCondition LessThan(DP.p0, 0) ThenBlock: {
        PrintMessage("FAIL plot\n")
        SystemCall(60, 1, 0, 0)
    }
    Gauge.PlotRange(DP.p0, 0, 1000)
    Gauge.PlotRange(DP.p1, 0, 1000)
    PrintMessage("plots ready\n")
    DP.tick = 0
    DP.run = 1
    WhileLoop EqualTo(DP.run, 1) {
        IfCondition EqualTo(Anim.PollQuit(), 1) ThenBlock: {
            DP.run = 0
        }
        IfCondition EqualTo(DP.run, 1) ThenBlock: {
            FB_FillRect(0, 0, 640, 400, FB_RGB(14, 23, 48))
            Gauge.PlotPush(DP.p0, DP_Wave(DP.tick, 0))
            Gauge.PlotPush(DP.p1, DP_Wave(DP.tick, 90))
            Anim.DrawAll()
            Gauge.DrawPlots()
            ink = FB_RGB(255, 255, 255)
            cyan = FB_RGB(42, 212, 255)
            gold = FB_RGB(232, 189, 80)
            FB_DrawString(24, 16, "RPM", cyan, -1)
            FB_DrawString(24, 200, "MAP", gold, -1)
            FB_DrawString(580, 16, "live", ink, -1)
            Anim.Present()
            DP.tick = Add(DP.tick, 1)
            Anim.Sleep(33)
        }
    }
    PrintMessage("demo_plot stop\n")
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
