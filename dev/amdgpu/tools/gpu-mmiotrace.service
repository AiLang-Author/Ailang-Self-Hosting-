[Unit]
Description=Capture GPU amdgpu init sequence via mmiotrace
After=local-fs.target sysinit.target
Before=display-manager.service graphical.target
ConditionPathExists=/home/bob/Ailang-Self-Hosting-/radeon_trace_boot.sh

[Service]
Type=oneshot
ExecStart=/home/bob/Ailang-Self-Hosting-/radeon_trace_boot.sh
TimeoutSec=120
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
