// Bench.InlineFunction.ailang
// Compare call overhead: regular Function.Add2 vs InlineFunction.Add2i
// at 10 million iterations to get a clear delta.

RunTask(Main)

Function.Add2 {
    Input: a: Integer
    Input: b: Integer
    Output: Integer
    Body: {
        ReturnValue(Add(a, b))
    }
}

InlineFunction.Add2i {
    Input: ai: Integer
    Input: bi: Integer
    Output: Integer
    Body: {
        ReturnValue(Add(ai, bi))
    }
}

SubRoutine.Main {
    rounds = 10000000

    // --- Regular CALL benchmark ---
    PrintMessage("Bench: Function.Add2 (")
    PrintNumber(rounds)
    PrintMessage(" rounds)...\n")
    t0 = GetTime()
    acc1 = 0
    i = 0
    WhileLoop LessThan(i, rounds) {
        acc1 = Add2(acc1, i)
        i = Add(i, 1)
    }
    t1 = GetTime()
    elapsed1 = Subtract(t1, t0)
    PrintMessage("  result=")
    PrintNumber(acc1)
    PrintMessage("  time=")
    PrintNumber(elapsed1)
    PrintMessage("ms\n")

    // --- Inline expansion benchmark ---
    PrintMessage("Bench: InlineFunction.Add2i (")
    PrintNumber(rounds)
    PrintMessage(" rounds)...\n")
    t2 = GetTime()
    acc2 = 0
    j = 0
    WhileLoop LessThan(j, rounds) {
        acc2 = Add2i(acc2, j)
        j = Add(j, 1)
    }
    t3 = GetTime()
    elapsed2 = Subtract(t3, t2)
    PrintMessage("  result=")
    PrintNumber(acc2)
    PrintMessage("  time=")
    PrintNumber(elapsed2)
    PrintMessage("ms\n")
}
