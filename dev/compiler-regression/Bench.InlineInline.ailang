// Bench.InlineInline.ailang
// Benchmark: InlineFunction expansion — compare with Bench.InlineCall.ailang
// Run: time ./Bench.InlineInline.x vs time ./Bench.InlineCall.x

InlineFunction.Add2i {
    Input: ai: Integer
    Input: bi: Integer
    Output: Integer
    Body: {
        ReturnValue(Add(ai, bi))
    }
}

SubRoutine.Main {
    rounds = 2000000
    acc = 0
    i = 0
    WhileLoop LessThan(i, rounds) {
        acc = Add2i(acc, i)
        i = Add(i, 1)
    }
    PrintMessage("inline checksum=")
    PrintNumber(acc)
    PrintMessage("\n")
}

RunTask(Main)
