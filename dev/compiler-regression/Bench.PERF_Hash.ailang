// Bench.PERF_Hash.ailang
// Benchmark: Hash (CRC32, linear probe, 32-byte slots)
// Run with: time ./Bench.PERF_Hash.x
// Compare against: time ./Bench.THash.x

LibraryImport.Arena
LibraryImport.Hash

SubRoutine.Main {
    Arena_Init()

    ROUNDS = 10000
    t = Hash.Create(32)

    // --- SET phase ---
    i = 0
    WhileLoop LessThan(i, ROUNDS) {
        Hash.Set(t, "alpha",   1)
        Hash.Set(t, "beta",    2)
        Hash.Set(t, "gamma",   3)
        Hash.Set(t, "delta",   4)
        Hash.Set(t, "epsilon", 5)
        i = Add(i, 1)
    }

    // --- GET phase ---
    sum = 0
    i = 0
    WhileLoop LessThan(i, ROUNDS) {
        sum = Add(sum, Hash.Get(t, "alpha"))
        sum = Add(sum, Hash.Get(t, "beta"))
        sum = Add(sum, Hash.Get(t, "gamma"))
        sum = Add(sum, Hash.Get(t, "delta"))
        sum = Add(sum, Hash.Get(t, "epsilon"))
        i = Add(i, 1)
    }

    Hash.Destroy(t)

    PrintMessage("Hash checksum=")
    PrintNumber(sum)
    PrintMessage("\n")
}

RunTask(Main)
