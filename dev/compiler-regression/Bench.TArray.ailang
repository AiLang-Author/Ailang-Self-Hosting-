// Bench.TArray.ailang
// Benchmark: TArray (ArrayCreate/ArrayGet/ArraySet builtins)
// Run with: time ./Bench.TArray.x
// Compare against: time ./Bench.PERF_Array.x

LibraryImport.Arena
LibraryImport.Array

SubRoutine.Main {
    Arena_Init()

    ROUNDS = 10000

    // --- PUSH phase ---
    a = Array.Create(64)
    i = 0
    WhileLoop LessThan(i, ROUNDS) {
        Array.Push(a, 1)
        Array.Push(a, 2)
        Array.Push(a, 3)
        Array.Push(a, 4)
        Array.Push(a, 5)
        Array.Push(a, 6)
        Array.Push(a, 7)
        Array.Push(a, 8)
        i = Add(i, 1)
    }

    // --- GET phase ---
    sum = 0
    i = 0
    size = Array.Size(a)
    WhileLoop LessThan(i, size) {
        sum = Add(sum, Array.Get(a, i))
        i = Add(i, 1)
    }

    // --- SET phase ---
    i = 0
    WhileLoop LessThan(i, size) {
        Array.Set(a, i, Multiply(i, 2))
        i = Add(i, 1)
    }

    // Verify SET worked
    i = 0
    WhileLoop LessThan(i, size) {
        sum = Add(sum, Array.Get(a, i))
        i = Add(i, 1)
    }

    Array.Destroy(a)

    PrintMessage("TArray checksum=")
    PrintNumber(sum)
    PrintMessage("\n")
}

RunTask(Main)
