// Test.AilangDoc.ailang
// Headless paper solver + typewriter wrap. No Auckland, no Postgres.
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.Display.Render.DSurfaceTypes
LibraryImport.Display.Render.DSurface
LibraryImport.Display.Render.DDrawPixel
LibraryImport.Display.Render.VIF
LibraryImport.Display.Render.SurfaceBlit
LibraryImport.Display.Render.Fonts
LibraryImport.Display.Content.AilangDoc
LibraryImport.Display.Content.DocLayout

FixedPool.TResult {
    "pass_count": Initialize=0, CanChange=True
    "fail_count": Initialize=0, CanChange=True
    "test_num":   Initialize=0, CanChange=True
    "doc":        Initialize=0, CanChange=True
}

Function.TR_Pass {
    Input: msg: Address
    Body: {
        TResult.test_num = Add(TResult.test_num, 1)
        TResult.pass_count = Add(TResult.pass_count, 1)
        PrintMessage("  PASS ")
        PrintNumber(TResult.test_num)
        PrintMessage(": ")
        PrintMessage(msg)
        PrintMessage("\n")
    }
}

Function.TR_Fail {
    Input: msg: Address
    Body: {
        TResult.test_num = Add(TResult.test_num, 1)
        TResult.fail_count = Add(TResult.fail_count, 1)
        PrintMessage("  FAIL ")
        PrintNumber(TResult.test_num)
        PrintMessage(": ")
        PrintMessage(msg)
        PrintMessage("\n")
    }
}

Function.TR_Check {
    Input: cond: Integer
    Input: msg: Address
    Body: {
        IfCondition EqualTo(cond, 1) ThenBlock: {
            TR_Pass(msg)
        }
        IfCondition NotEqual(cond, 1) ThenBlock: {
            TR_Fail(msg)
        }
    }
}

Function.TR_CheckEqual {
    Input: actual: Integer
    Input: expected: Integer
    Input: msg: Address
    Body: {
        IfCondition EqualTo(actual, expected) ThenBlock: {
            TR_Pass(msg)
        }
        IfCondition NotEqual(actual, expected) ThenBlock: {
            TR_Fail(msg)
            PrintMessage("    expected=")
            PrintNumber(expected)
            PrintMessage(" actual=")
            PrintNumber(actual)
            PrintMessage("\n")
        }
    }
}

SubRoutine.TestPaperSizes {
    PrintMessage("\n=== Paper solver ===\n")
    ok = DocPaper_SizePt(DocPaper.LETTER, DocPaper.PORTRAIT, 0, 0, 0, 0)
    TR_CheckEqual(ok, 1, "Letter ok")
    TR_CheckEqual(DocPaperOut.w, 612, "Letter w 612pt")
    TR_CheckEqual(DocPaperOut.h, 792, "Letter h 792pt")

    ok = DocPaper_SizePt(DocPaper.LETTER, DocPaper.LANDSCAPE, 0, 0, 0, 0)
    TR_CheckEqual(DocPaperOut.w, 792, "Letter landscape w")
    TR_CheckEqual(DocPaperOut.h, 612, "Letter landscape h")

    ok = DocPaper_SizePt(DocPaper.LEGAL, DocPaper.PORTRAIT, 0, 0, 0, 0)
    TR_CheckEqual(DocPaperOut.w, 612, "Legal w")
    TR_CheckEqual(DocPaperOut.h, 1008, "Legal h")

    ok = DocPaper_SizePt(DocPaper.CUSTOM, DocPaper.PORTRAIT, 500, 700, 0, 0)
    TR_CheckEqual(ok, 1, "Custom ok")
    TR_CheckEqual(DocPaperOut.w, 500, "Custom w")
    TR_CheckEqual(DocPaperOut.h, 700, "Custom h")

    ok = DocPaper_SizePt(DocPaper.CUSTOM, DocPaper.LANDSCAPE, 500, 700, 0, 0)
    TR_CheckEqual(DocPaperOut.w, 700, "Custom landscape swap w")
    TR_CheckEqual(DocPaperOut.h, 500, "Custom landscape swap h")

    ok = DocPaper_SizePt(DocPaper.FREE, DocPaper.PORTRAIT, 0, 0, 0, 0)
    TR_CheckEqual(ok, 0, "FREE rejected")

    ok = DocPaper_ContentBox(612, 792, 72, 72, 72, 72)
    TR_CheckEqual(ok, 1, "Content box ok")
    TR_CheckEqual(DocPaperOut.cw, 468, "Content w 468pt")
    TR_CheckEqual(DocPaperOut.ch, 648, "Content h 648pt")
}

SubRoutine.TestEmptyDoc {
    PrintMessage("\n=== Empty document ===\n")
    TResult.doc = ADoc_Create(DocPaper.LETTER, DocPaper.PORTRAIT)
    TR_Check(GreaterEqual(TResult.doc, 0), "Create letter doc")
    ok = DocLayout_Paginate(TResult.doc)
    TR_CheckEqual(ok, 1, "Paginate empty")
    TR_CheckEqual(ADoc_Get(TResult.doc, ADocField.PAGE_COUNT), 1, "Empty is one blank page")
    TR_CheckEqual(ADoc_Get(TResult.doc, ADocField.LINE_COUNT), 0, "Empty has no lines")
}

SubRoutine.TestWordWrap {
    PrintMessage("\n=== Wrap word to 4 Letter pages ===\n")
    TResult.doc = ADoc_Create(DocPaper.LETTER, DocPaper.PORTRAIT)
    TR_Check(GreaterEqual(TResult.doc, 0), "Create wrap doc")

    word = "word "
    n = 0
    WhileLoop LessThan(n, 3000) {
        ADoc_Append(TResult.doc, word, 5)
        n = Add(n, 1)
    }
    DocLayout_Paginate(TResult.doc)
    pc = ADoc_Get(TResult.doc, ADocField.PAGE_COUNT)
    WhileLoop LessThan(pc, 4) {
        n = 0
        WhileLoop LessThan(n, 400) {
            ADoc_Append(TResult.doc, word, 5)
            n = Add(n, 1)
        }
        DocLayout_Paginate(TResult.doc)
        pc = ADoc_Get(TResult.doc, ADocField.PAGE_COUNT)
        IfCondition GreaterThan(ADoc_Get(TResult.doc, ADocField.RUN_LEN), 200000) ThenBlock: {
            pc = 4
        }
    }

    pc = ADoc_Get(TResult.doc, ADocField.PAGE_COUNT)
    lc = ADoc_Get(TResult.doc, ADocField.LINE_COUNT)
    PrintMessage("    pages=")
    PrintNumber(pc)
    PrintMessage(" lines=")
    PrintNumber(lc)
    PrintMessage(" bytes=")
    PrintNumber(ADoc_Get(TResult.doc, ADocField.RUN_LEN))
    PrintMessage("\n")

    TR_CheckEqual(pc, 4, "page_count == 4")
    TR_Check(GreaterThan(lc, 4), "line_count > 4")

    off = DocLayout_Hit(TResult.doc, 3, 8, 8)
    PrintMessage("    hit page3 off=")
    PrintNumber(off)
    PrintMessage("\n")
    TR_Check(GreaterThan(off, 0), "Hit page 3 returns a run offset")

    n = ADoc_Get(TResult.doc, ADocField.LINE_COUNT)
    found = 0
    i = 0
    WhileLoop LessThan(i, n) {
        lp = ADoc_LinePtr(TResult.doc, i)
        pg = Dereference(Add(lp, DocLineOff.PAGE))
        IfCondition EqualTo(pg, 3) ThenBlock: {
            o0 = Dereference(Add(lp, DocLineOff.OFF0))
            o1 = Dereference(Add(lp, DocLineOff.OFF1))
            IfCondition And(GreaterEqual(off, o0), LessEqual(off, o1)) ThenBlock: {
                found = 1
            }
        }
        i = Add(i, 1)
    }
    TR_CheckEqual(found, 1, "Hit offset is on page 3")
}

SubRoutine.RunAll {
    PrintMessage("========================================\n")
    PrintMessage("  AilangDoc paper + wrap\n")
    PrintMessage("========================================\n")

    Arena_Init()
    VIF_Init()
    VFont_Init()
    ok = VFont_LoadVIF("fonts/TimesRoman.vif")
    IfCondition EqualTo(ok, 0) ThenBlock: {
        PrintMessage("[test] Times missing, DejaVu fallback\n")
        ok = VFont_LoadVIF("fonts/DejaVuSans.vif")
    }
    TR_CheckEqual(ok, 1, "Load doc face")
    VFont_SetDocFace(FontState.default_face)
    ADoc_Init()

    RunTask(TestPaperSizes)
    RunTask(TestEmptyDoc)
    RunTask(TestWordWrap)

    PrintMessage("\n========================================\n")
    PrintMessage("  Results: ")
    PrintNumber(TResult.pass_count)
    PrintMessage(" PASS, ")
    PrintNumber(TResult.fail_count)
    PrintMessage(" FAIL\n")
    PrintMessage("========================================\n")
}

RunTask(RunAll)
