// ─── Override: headless framebuffer (skip /dev/fb0) ──────────────────────────
Function.RenderFB_InitDouble {
    Output: Integer
    Body: {
        FB_InitHeadless(1920, 1080)
        ReturnValue(1)
    }
}

// ─── Override: no real evdev/TTY input ───────────────────────────────────────
Function.Evdev_Poll {
    Body: { ReturnValue(0) }
}
Function.SysDisplay_InitTTY {
    Body: { ReturnValue(0) }
}
Function.SysDisplay_InitInput {
    Body: { ReturnValue(0) }
}

// ─── Test helper ─────────────────────────────────────────────────────────────
Function.TestCheck {
    Input: label: Address
    Input: got: Integer
    Input: expected: Integer
    Body: {
        IfCondition EqualTo(got, expected) ThenBlock: {
            PrintMessage("[PASS] ")
        } ElseBlock: {
            PrintMessage("[FAIL] ")
        }
        PrintMessage(label)
        PrintMessage(" got=")
        PrintNumber(got)
        PrintMessage(" expected=")
        PrintNumber(expected)
        PrintMessage("\n")
        ReturnValue(0)
    }
}

// ─── MAIN ────────────────────────────────────────────────────────────────────
SubRoutine.Main {
    Arena_Init()

    // SysDisplay_Init redirects fd 0/1/2 -> /dev/null (SysDisplay.ailang:1745),
    // which mutes every PrintMessage after boot. Save the real stdout first
    // (dup(1) -> saved_fd), then restore it (dup2(saved_fd,1)) so our PASS/FAIL
    // lines are visible. SYS_DUP=32, SYS_DUP2=33.
    saved_fd = SystemCall(32, 1, 0, 0, 0, 0)
    SysDisplay_Init()
    SystemCall(33, saved_fd, 1, 0, 0, 0)

    PrintMessage("[CP] Init complete, booting notepad\n")

    KeyMap_Init()
    TextBuf_Init()
    ClipHistory_Init()
    SynColor_Init()
    SynColor_ThemeInit()
    EventRouter_Init()
    Dialog_Init()
    Menu_Init()
    Deskbar_Init(SysDisplayState.scr_w, SysDisplayState.scr_h)
    IPCBroker_Init()
    StartMenu_Init()
    CascadeMenu_Init()
    ContextMenu_Init()
    HTML_Init()
    PageSurface_Init()
    Doc_Init()
    VFont_UseSize(UIScale.font_body)

    // Open a real Notepad window (textfield-backed via config/notepad.html).
    // AppHost rewrites a leading "config/" to "/system/config/" (VM deploy path)
    // which is absent on the dev box, so pass an absolute repo path (no rewrite).
    // No Win_BlitAll / render — fonts at /system/fonts may be absent on the dev
    // box, and copy/paste operates purely on the TextBuffer data model.
    np_idx = AppHost_Open("/home/bob/Ailang-Self-Hosting-/config/notepad.html", 0)

    PrintMessage("\n=== NOTEPAD COPY/PASTE TEST ===\n")
    PrintMessage("[CP] notepad win idx=") PrintNumber(np_idx) PrintMessage("\n")

    np_ctx = WinView_GetContentCtx(np_idx)
    IfCondition LessEqual(np_ctx, 0) ThenBlock: {
        PrintMessage("[FAIL] no content ctx for notepad\n")
        ReturnValue(0)
    }

    tf_node = AK_FindTextField(np_ctx, AK_GetTreeRoot(np_ctx))
    IfCondition LessThan(tf_node, 0) ThenBlock: {
        PrintMessage("[FAIL] no TEXTFIELD in notepad tree\n")
        ReturnValue(0)
    }
    tf_tbh = AK_ExtraGet(np_ctx, tf_node, AKExtra.TEXTBUF_H)
    PrintMessage("[CP] tf_node=") PrintNumber(tf_node)
    PrintMessage(" tbh=") PrintNumber(tf_tbh) PrintMessage("\n")

    // NOTE: AucklandBind already sets this textfield as focus_node during HTML
    // bind; AK_EventKey also falls back to AK_FindTextField, so no manual focus.

    // Known buffer state: "Hello World" (single line, 11 chars)
    TextBuf_SetText(tf_tbh, "Hello World", 11)

    // ── COPY: select "Hello" (r0c0..r0c5), send Ctrl+C ──────────────────────
    PrintMessage("\n--- COPY 'Hello' ---\n")
    AK_ExtraSet(np_ctx, tf_node, AKExtra.SEL_START_ROW, 0)
    AK_ExtraSet(np_ctx, tf_node, AKExtra.SEL_START_COL, 0)
    AK_ExtraSet(np_ctx, tf_node, AKExtra.SEL_END_ROW, 0)
    AK_ExtraSet(np_ctx, tf_node, AKExtra.SEL_END_COL, 5)
    TestCheck("has selection", AK_HasSelection(np_ctx, tf_node), 1)

    // Ctrl+C: keycode=46 (KEY_C), ch=99 ('c'), shift=0, ctrl=1
    hc = AK_EventKey(np_ctx, 46, 99, 0, 1)
    TestCheck("ctrl+c handled", hc, 1)
    TestCheck("clipboard len == 5", Clipboard.len, 5)
    IfCondition GreaterThan(Clipboard.len, 4) ThenBlock: {
        TestCheck("clip[0]=='H'", GetByte(Clipboard.ptr, 0), 72)
        TestCheck("clip[4]=='o'", GetByte(Clipboard.ptr, 4), 111)
    }

    // ── PASTE: cursor to end, send Ctrl+V ───────────────────────────────────
    PrintMessage("\n--- PASTE at end ---\n")
    AK_ClearSelection(np_ctx, tf_node)
    TextBuf_SetCursor(tf_tbh, 0, 11)

    // Ctrl+V: keycode=47 (KEY_V), ch=118 ('v'), shift=0, ctrl=1
    hv = AK_EventKey(np_ctx, 47, 118, 0, 1)
    TestCheck("ctrl+v handled", hv, 1)

    // Line should now be "Hello WorldHello" = 16 chars
    pv_line = TextBuf_GetLine(tf_tbh, 0)
    TestCheck("line len after paste == 16", StringLength(pv_line), 16)
    IfCondition GreaterThan(StringLength(pv_line), 15) ThenBlock: {
        TestCheck("line[11]=='H'", GetByte(pv_line, 11), 72)
        TestCheck("line[15]=='o'", GetByte(pv_line, 15), 111)
    }

    // ── KEYBOARD Select-All (Ctrl+A) + Cut (Ctrl+X) ─────────────────────────
    PrintMessage("\n--- Ctrl+A select-all then Ctrl+X cut ---\n")
    TextBuf_SetText(tf_tbh, "CutMe", 5)
    AK_EventKey(np_ctx, 30, 97, 0, 1)   // Ctrl+A (ch='a')
    TestCheck("select-all -> has selection", AK_HasSelection(np_ctx, tf_node), 1)
    AK_EventKey(np_ctx, 45, 120, 0, 1)  // Ctrl+X (ch='x')
    TestCheck("cut clipboard len == 5", Clipboard.len, 5)
    cut_line = TextBuf_GetLine(tf_tbh, 0)
    TestCheck("buffer empty after cut", StringLength(cut_line), 0)

    // ── RIGHT-CLICK MENU Copy/Paste (ContextMenu_FireAction) ────────────────
    // Simulate what a right-click + menu-item click ultimately invokes: the
    // menu captures source_ctx/source_node (ContextMenu_HandleRightClick:487)
    // then dispatches the action string to ContextMenu_FireAction.
    PrintMessage("\n--- Right-click menu Copy then Paste ---\n")
    TextBuf_SetText(tf_tbh, "RightClick", 10)
    CtxMenuState.source_win  = np_idx
    CtxMenuState.source_ctx  = np_ctx
    CtxMenuState.source_node = tf_node
    AK_ExtraSet(np_ctx, tf_node, AKExtra.SEL_START_ROW, 0)
    AK_ExtraSet(np_ctx, tf_node, AKExtra.SEL_START_COL, 0)
    AK_ExtraSet(np_ctx, tf_node, AKExtra.SEL_END_ROW, 0)
    AK_ExtraSet(np_ctx, tf_node, AKExtra.SEL_END_COL, 5)
    ContextMenu_FireAction("ctx.copy", 8)
    TestCheck("menu-copy clipboard len == 5", Clipboard.len, 5)

    AK_ClearSelection(np_ctx, tf_node)
    TextBuf_SetCursor(tf_tbh, 0, 10)
    ContextMenu_FireAction("ctx.paste", 9)
    rc_line = TextBuf_GetLine(tf_tbh, 0)
    TestCheck("menu-paste line len == 15", StringLength(rc_line), 15)

    // ── FULL CONTEXT-MENU FLOW: Show menu, click the "Copy" item ────────────
    // This exercises the live path the user actually uses: menu open ->
    // AK_HitTest to find the item -> focus_node -> action extraction ->
    // ContextMenu_FireAction. (Direct FireAction already passed above; this
    // catches bugs in the click->item->action wiring.)
    PrintMessage("\n--- Full menu flow: Show + click Copy item ---\n")
    TextBuf_SetText(tf_tbh, "MenuFlow", 8)
    AK_ExtraSet(np_ctx, tf_node, AKExtra.SEL_START_ROW, 0)
    AK_ExtraSet(np_ctx, tf_node, AKExtra.SEL_START_COL, 0)
    AK_ExtraSet(np_ctx, tf_node, AKExtra.SEL_END_ROW, 0)
    AK_ExtraSet(np_ctx, tf_node, AKExtra.SEL_END_COL, 4)
    CtxMenuState.source_win  = np_idx
    CtxMenuState.source_ctx  = np_ctx
    CtxMenuState.source_node = tf_node

    shown = ContextMenu_Show(100, 100)
    TestCheck("menu shown", shown, 1)
    PrintMessage("[CP] menu screen_x=") PrintNumber(CtxMenuState.screen_x)
    PrintMessage(" screen_y=") PrintNumber(CtxMenuState.screen_y)
    PrintMessage(" w=") PrintNumber(CtxMenuState.width)
    PrintMessage(" h=") PrintNumber(CtxMenuState.height) PrintMessage("\n")

    // "Copy" is item 2: menu-local center ≈ (PAD_L+ITEM_W/2, PAD_T+ITEM_H*1+ITEM_H/2)
    // = (4+90, 4+26+13) = (94, 43). Convert to screen coords.
    copy_x = Add(CtxMenuState.screen_x, 94)
    copy_y = Add(CtxMenuState.screen_y, 43)
    Clipboard_Clear()
    hit = ContextMenu_HitTest(copy_x, copy_y)
    TestCheck("hittest over Copy item", hit, 1)
    ContextMenu_Event(copy_x, copy_y, AKMouseEv.DOWN)
    ContextMenu_Event(copy_x, copy_y, AKMouseEv.UP)
    TestCheck("full-flow copy clipboard len == 4", Clipboard.len, 4)

    // ── LIVE-GEOMETRY RIGHT-CLICK: ContextMenu_HandleRightClick ─────────────
    // The one live-path piece not yet exercised: the actual right-click entry
    // that runs Win_HitTest -> screen->content transform -> AK_HitTest to find
    // the textfield and capture source_ctx/source_node. Uses the textfield's
    // real solved rect (AppHost_Open already solved the layout via AK_Draw).
    PrintMessage("\n--- Live-geometry right-click (HandleRightClick) ---\n")
    tsx = AK_Get(np_ctx, tf_node, AKF.SOLVED_X)
    tsy = AK_Get(np_ctx, tf_node, AKF.SOLVED_Y)
    tsw = AK_Get(np_ctx, tf_node, AKF.SOLVED_W)
    tsh = AK_Get(np_ctx, tf_node, AKF.SOLVED_H)
    PrintMessage("[CP] textfield solved x=") PrintNumber(tsx)
    PrintMessage(" y=") PrintNumber(tsy)
    PrintMessage(" w=") PrintNumber(tsw)
    PrintMessage(" h=") PrintNumber(tsh) PrintMessage("\n")

    wx = Win_GetX(np_idx)
    wy = Win_GetY(np_idx)
    bw = DecorConfig.border_w
    click_sx = Add(Add(wx, bw), Add(tsx, Divide(tsw, 2)))
    click_sy = Add(Add(wy, bw), Add(tsy, Divide(tsh, 2)))
    PrintMessage("[CP] win x=") PrintNumber(wx) PrintMessage(" y=") PrintNumber(wy)
    PrintMessage(" bw=") PrintNumber(bw)
    PrintMessage(" -> click screen (") PrintNumber(click_sx)
    PrintMessage(",") PrintNumber(click_sy) PrintMessage(")\n")

    // Reset menu + source, then fire the real right-click handler
    ContextMenu_Close()
    CtxMenuState.source_ctx  = 0
    CtxMenuState.source_node = Negate(1)
    win_at_click = Win_HitTest(click_sx, click_sy)
    PrintMessage("[CP] Win_HitTest -> ") PrintNumber(win_at_click) PrintMessage("\n")
    ContextMenu_HandleRightClick(click_sx, click_sy)
    TestCheck("RC menu open", CtxMenuState.open, 1)
    TestCheck("RC source_node == tf_node", CtxMenuState.source_node, tf_node)
    TestCheck("RC source_ctx == np_ctx", CtxMenuState.source_ctx, np_ctx)

    // ── REGRESSION: right-click PASTE with a menu ALREADY OPEN ──────────────
    // The bug: ContextMenu_HandleRightClick set source_node, then Show() closed a
    // stale open menu, and Close() reset source_node = -1 -> FireAction bailed ->
    // paste no-op. Fix: HandleRightClick closes any open menu BEFORE capturing
    // source. This reproduces the precondition (a menu already open) and drives
    // the real HandleRightClick -> click Paste path end-to-end.
    PrintMessage("\n--- Regression: right-click PASTE with stale menu open ---\n")
    TextBuf_SetText(tf_tbh, "AB", 2)
    Clipboard_Clear()
    Clipboard_Set("XY", 2)
    TextBuf_SetCursor(tf_tbh, 0, 2)
    AK_ClearSelection(np_ctx, tf_node)

    // Precondition: a context menu is already open (the trigger for the bug)
    ContextMenu_Show(500, 500)
    TestCheck("precondition: a menu is open", CtxMenuState.open, 1)

    // Real right-click over the textfield center (screen coords from solved rect)
    tfx = AK_Get(np_ctx, tf_node, AKF.SOLVED_X)
    tfy = AK_Get(np_ctx, tf_node, AKF.SOLVED_Y)
    tfw = AK_Get(np_ctx, tf_node, AKF.SOLVED_W)
    tfh = AK_Get(np_ctx, tf_node, AKF.SOLVED_H)
    rcx = Add(Add(Win_GetX(np_idx), DecorConfig.border_w), Add(tfx, Divide(tfw, 2)))
    rcy = Add(Add(Win_GetY(np_idx), DecorConfig.border_w), Add(tfy, Divide(tfh, 2)))
    ContextMenu_HandleRightClick(rcx, rcy)
    // Post-fix, the stale menu was closed before capture, so source survives:
    TestCheck("source_node survives re-right-click", CtxMenuState.source_node, tf_node)

    // Click the Paste item (menu-local center (94,69)) via the real event path
    mpx = Add(CtxMenuState.screen_x, 94)
    mpy = Add(CtxMenuState.screen_y, 69)
    ContextMenu_Event(mpx, mpy, AKMouseEv.DOWN)
    ContextMenu_Event(mpx, mpy, AKMouseEv.UP)
    pline = TextBuf_GetLine(tf_tbh, 0)
    TestCheck("right-click paste inserted: line 'ABXY' len==4", StringLength(pline), 4)

    // ── FAITHFUL LIVE SEQUENCE: menu-copy -> click cursor -> menu-paste ─────
    // Mirrors exactly what the user does: right-click Copy, left-click to place
    // the cursor (deselect), right-click Paste. All via the real HandleRightClick
    // + ContextMenu_Event + content AK_EventMouse paths.
    PrintMessage("\n--- Faithful sequence: menu-copy, click, menu-paste ---\n")
    TextBuf_SetText(tf_tbh, "test", 4)
    AK_ExtraSet(np_ctx, tf_node, AKExtra.SEL_START_ROW, 0)
    AK_ExtraSet(np_ctx, tf_node, AKExtra.SEL_START_COL, 0)
    AK_ExtraSet(np_ctx, tf_node, AKExtra.SEL_END_ROW, 0)
    AK_ExtraSet(np_ctx, tf_node, AKExtra.SEL_END_COL, 4)
    Clipboard_Clear()
    ContextMenu_Close()

    sfx = AK_Get(np_ctx, tf_node, AKF.SOLVED_X)
    sfy = AK_Get(np_ctx, tf_node, AKF.SOLVED_Y)
    sfw = AK_Get(np_ctx, tf_node, AKF.SOLVED_W)
    sfh = AK_Get(np_ctx, tf_node, AKF.SOLVED_H)
    seq_rcx = Add(Add(Win_GetX(np_idx), DecorConfig.border_w), Add(sfx, Divide(sfw, 2)))
    seq_rcy = Add(Add(Win_GetY(np_idx), DecorConfig.border_w), Add(sfy, Divide(sfh, 2)))

    // 1) menu COPY
    ContextMenu_HandleRightClick(seq_rcx, seq_rcy)
    ccx = Add(CtxMenuState.screen_x, 94)
    ccy = Add(CtxMenuState.screen_y, 43)
    ContextMenu_Event(ccx, ccy, AKMouseEv.DOWN)
    ContextMenu_Event(ccx, ccy, AKMouseEv.UP)
    TestCheck("seq: menu-copy clipboard len == 4", Clipboard.len, 4)
    TestCheck("seq: menu closed after copy", CtxMenuState.open, 0)

    // 2) content left-click to place cursor (deselect)
    cnx = Add(Add(Win_GetX(np_idx), DecorConfig.border_w), Add(sfx, 30))
    cny = Add(Add(Win_GetY(np_idx), DecorConfig.border_w), Add(sfy, 8))
    AK_EventMouse(np_ctx, Add(sfx, 30), Add(sfy, 8), AKMouseEv.DOWN, 0)
    AK_EventMouse(np_ctx, Add(sfx, 30), Add(sfy, 8), AKMouseEv.UP, 0)

    // 3) menu PASTE
    ContextMenu_HandleRightClick(seq_rcx, seq_rcy)
    TestCheck("seq: source_node valid for paste", CtxMenuState.source_node, tf_node)
    spx = Add(CtxMenuState.screen_x, 94)
    spy = Add(CtxMenuState.screen_y, 69)
    ContextMenu_Event(spx, spy, AKMouseEv.DOWN)
    ContextMenu_Event(spx, spy, AKMouseEv.UP)
    seqline = TextBuf_GetLine(tf_tbh, 0)
    PrintMessage("[SEQ] line after menu-paste len=") PrintNumber(StringLength(seqline)) PrintMessage("\n")
    TestCheck("seq: menu-paste grew buffer (>4)", GreaterThan(StringLength(seqline), 4), 1)

    // ── REGRESSION: empty-selection copy must NOT wipe the clipboard ─────────
    // The live menu-paste bug (cp3: cb.G0!/cb.0! empty at paste): a zero-width
    // selection copy pushed an empty string through Clipboard_Set, which zeroed
    // Clipboard.len — destroying content the user had just copied. A stray empty
    // copy in the live flow therefore made the next paste a no-op. Fix: empty
    // copy is a no-op; the clipboard survives.
    PrintMessage("\n--- Regression: empty-selection copy keeps clipboard ---\n")
    TextBuf_SetText(tf_tbh, "keepme", 6)
    // Real copy fills the clipboard
    AK_ExtraSet(np_ctx, tf_node, AKExtra.SEL_START_ROW, 0)
    AK_ExtraSet(np_ctx, tf_node, AKExtra.SEL_START_COL, 0)
    AK_ExtraSet(np_ctx, tf_node, AKExtra.SEL_END_ROW, 0)
    AK_ExtraSet(np_ctx, tf_node, AKExtra.SEL_END_COL, 6)
    AK_CopySelection(np_ctx, tf_node, tf_tbh)
    TestCheck("clipboard filled == 6", Clipboard.len, 6)
    // Now a zero-width selection copy (cursor, nothing highlighted)
    AK_ExtraSet(np_ctx, tf_node, AKExtra.SEL_START_ROW, 0)
    AK_ExtraSet(np_ctx, tf_node, AKExtra.SEL_START_COL, 3)
    AK_ExtraSet(np_ctx, tf_node, AKExtra.SEL_END_ROW, 0)
    AK_ExtraSet(np_ctx, tf_node, AKExtra.SEL_END_COL, 3)
    AK_CopySelection(np_ctx, tf_node, tf_tbh)
    TestCheck("empty copy left clipboard intact == 6", Clipboard.len, 6)

    // Reverse drag (end before start) must still copy
    PrintMessage("\n--- Reverse selection copy ---\n")
    TextBuf_SetText(tf_tbh, "Hello World", 11)
    AK_ExtraSet(np_ctx, tf_node, AKExtra.SEL_START_ROW, 0)
    AK_ExtraSet(np_ctx, tf_node, AKExtra.SEL_START_COL, 5)
    AK_ExtraSet(np_ctx, tf_node, AKExtra.SEL_END_ROW, 0)
    AK_ExtraSet(np_ctx, tf_node, AKExtra.SEL_END_COL, 0)
    Clipboard_Clear()
    AK_CopySelection(np_ctx, tf_node, tf_tbh)
    TestCheck("reverse sel clipboard len == 5", Clipboard.len, 5)
    IfCondition GreaterThan(Clipboard.len, 4) ThenBlock: {
        TestCheck("reverse clip[0]=='H'", GetByte(Clipboard.ptr, 0), 72)
        TestCheck("reverse clip[4]=='o'", GetByte(Clipboard.ptr, 4), 111)
    }

    TestClipboardService()

    PrintMessage("\n=== COPY/PASTE TEST COMPLETE ===\n")
}

// One system slot, typed, IPC set path, empty-set no-op
Function.TestClipboardService {
    Body: {
        PrintMessage("\n--- System clipboard service ---\n")
        Clipboard_Clear()
        TestCheck("cleared type == 0", Clipboard.type, 0)
        Clipboard_Set("hello", 5)
        TestCheck("set type TEXT", Clipboard.type, ClipType.TEXT)
        TestCheck("set len 5", Clipboard.len, 5)
        TestCheck("seq > 0", GreaterThan(Clipboard.seq, 0), 1)
        seq1 = Clipboard.seq
        Clipboard_Set("", 0)
        TestCheck("empty set kept len", Clipboard.len, 5)
        TestCheck("empty set kept seq", Clipboard.seq, seq1)
        TestCheck("type name text", StringCompare(Clipboard_TypeName(), "text"), 0)

        obj = JSON.NewObject()
        JSON.SetString(obj, "method", "clipboard.set")
        JSON.SetString(obj, "type", "text")
        JSON.SetString(obj, "data", "fromipc")
        IPCBroker_HandleClipboardSet(0, obj)
        JSON.Free(obj)
        TestCheck("ipc set len 7", Clipboard.len, 7)
        TestCheck("ipc set type TEXT", Clipboard.type, ClipType.TEXT)
        TestCheck("ipc seq bumped", GreaterThan(Clipboard.seq, seq1), 1)

        obj2 = JSON.NewObject()
        JSON.SetString(obj2, "type", "binary")
        JSON.SetString(obj2, "data", "XY")
        IPCBroker_HandleClipboardSet(0, obj2)
        JSON.Free(obj2)
        TestCheck("ipc binary type", Clipboard.type, ClipType.BINARY)
        TestCheck("ipc binary len", Clipboard.len, 2)
        TestCheck("type name binary", StringCompare(Clipboard_TypeName(), "binary"), 0)
        TestCheck("type from name image", Clipboard_TypeFromName("image"), ClipType.IMAGE)
        TestCheck("type from name file", Clipboard_TypeFromName("file"), ClipType.FILE_REF)
    }
}

RunTask(Main)
