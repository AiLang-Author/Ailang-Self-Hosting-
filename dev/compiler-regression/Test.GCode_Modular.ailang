// Test.GCode_Modular.ailang
// Comprehensive Unit Test for the Modular G-Code Library System

LibraryImport.Motion.GCode_Core
LibraryImport.Motion.GCode_Queue
LibraryImport.Motion.GCode_Motion
LibraryImport.Motion.GCode_Machine
LibraryImport.Motion.GCode_Statements
LibraryImport.Motion.GCode_Interpreter
LibraryImport.Arena

PrintMessage("==============================================\n")
PrintMessage("G-CODE MODULAR LIBRARY TEST SUITE\n")
PrintMessage("==============================================\n\n")

FixedPool.TestGlobals {
    "total_tests": Initialize=0
    "passed_tests": Initialize=0
    "failed_tests": Initialize=0
    "test_name": Initialize=0
    "expected": Initialize=0
    "actual": Initialize=0
    "void_result": Initialize=0
}

Function.AssertEqual {
    Output: Integer
    Body: {
        TestGlobals.total_tests = Add(TestGlobals.total_tests, 1)

        Fork EqualTo(TestGlobals.expected, TestGlobals.actual) TrueBlock: {
            PrintMessage("[PASS] ")
            PrintMessage(TestGlobals.test_name)
            PrintMessage("\n")
            TestGlobals.passed_tests = Add(TestGlobals.passed_tests, 1)
        } FalseBlock: {
            PrintMessage("[FAIL] ")
            PrintMessage(TestGlobals.test_name)
            PrintMessage(" - Expected: ")
            PrintNumber(TestGlobals.expected)
            PrintMessage(", Got: ")
            PrintNumber(TestGlobals.actual)
            PrintMessage("\n")
            TestGlobals.failed_tests = Add(TestGlobals.failed_tests, 1)
        }

        ReturnValue(1)
    }
}

Function.ClearQueue {
    Output: Integer
    Body: {
        result = MotionQueue.Clear()
        ReturnValue(1)
    }
}

// ============================================================================
// TEST 1: LIBRARY INITIALIZATION
// ============================================================================

Function.Test_Initialization {
    Output: Integer
    Body: {
        PrintMessage("\n--- Test Group 1: Library Initialization ---\n")

        result = MotionQueue.Initialize()

        TestGlobals.test_name = "MotionQueue Initialization"
        TestGlobals.expected = 1
        TestGlobals.actual = result
        result = AssertEqual()

        TestGlobals.test_name = "Queue Initially Empty"
        TestGlobals.expected = 0
        TestGlobals.actual = MotionQueue.count
        result = AssertEqual()

        result = Core.ResetModalState()

        TestGlobals.test_name = "Modal State Reset Returns Success"
        TestGlobals.expected = 1
        TestGlobals.actual = result
        result = AssertEqual()

        TestGlobals.test_name = "Default Motion Mode is G00"
        TestGlobals.expected = 0
        TestGlobals.actual = ModalState.motion_mode
        result = AssertEqual()

        TestGlobals.test_name = "Default Units are Millimeters (G21)"
        TestGlobals.expected = 21
        TestGlobals.actual = ModalState.units
        result = AssertEqual()

        ReturnValue(1)
    }
}

// ============================================================================
// TEST 2: MODAL STATE PARSING
// ============================================================================

Function.Test_ModalState {
    Output: Integer
    Body: {
        PrintMessage("\n--- Test Group 2: Modal State Parsing ---\n")

        result = ClearQueue()
        result = Core.ResetModalState()

        test_line = "G90 G01"
        TestGlobals.void_result = Interpreter.ProcessLine(test_line)

        TestGlobals.test_name = "G90 sets Absolute Distance Mode"
        TestGlobals.expected = 90
        TestGlobals.actual = ModalState.distance_mode
        result = AssertEqual()

        TestGlobals.test_name = "G01 sets Linear Feed Mode"
        TestGlobals.expected = 1
        TestGlobals.actual = ModalState.motion_mode
        result = AssertEqual()

        test_line2 = "G17"
        TestGlobals.void_result = Interpreter.ProcessLine(test_line2)

        TestGlobals.test_name = "G17 sets XY Plane"
        TestGlobals.expected = 17
        TestGlobals.actual = ModalState.plane
        result = AssertEqual()

        ReturnValue(1)
    }
}

// ============================================================================
// TEST 3: COORDINATE PARSING
// ============================================================================

Function.Test_Coordinates {
    Output: Integer
    Body: {
        PrintMessage("\n--- Test Group 3: Coordinate Parsing ---\n")

        result = ClearQueue()
        result = Core.ResetModalState()

        test_line = "G00 X12.34 Y-56.78 Z100.5"
        TestGlobals.void_result = Interpreter.ProcessLine(test_line)

        TestGlobals.test_name = "X Coordinate Update (12.34)"
        TestGlobals.expected = 123400
        TestGlobals.actual = ModalState.current_x
        result = AssertEqual()

        TestGlobals.test_name = "Y Coordinate Update (-56.78)"
        TestGlobals.expected = -567800
        TestGlobals.actual = ModalState.current_y
        result = AssertEqual()

        TestGlobals.test_name = "Z Coordinate Update (100.5)"
        TestGlobals.expected = 1005000
        TestGlobals.actual = ModalState.current_z
        result = AssertEqual()

        TestGlobals.test_name = "Command Queued"
        TestGlobals.expected = 1
        TestGlobals.actual = MotionQueue.count
        result = AssertEqual()

        ReturnValue(1)
    }
}

// ============================================================================
// TEST 4: MOTION QUEUE SERIALIZATION
// ============================================================================

Function.Test_QueueData {
    Output: Integer
    Body: {
        PrintMessage("\n--- Test Group 4: Queue Data Integrity ---\n")

        result = ClearQueue()
        result = Core.ResetModalState()

        ModalState.motion_mode = 1
        ModalState.feed_rate = 5000000

        TestGlobals.void_result = MotionQueue.PushCommand(CommandTypes.CMD_STRAIGHT_FEED, 100000, 200000, 300000)

        offset = 0
        addr = Add(MotionQueue.buffer, offset)

        type = Dereference(addr)
        x = Dereference(Add(addr, 8))
        y = Dereference(Add(addr, 16))
        z = Dereference(Add(addr, 24))
        feed = Dereference(Add(addr, 32))

        TestGlobals.test_name = "Queue: Command Type (G01)"
        TestGlobals.expected = CommandTypes.CMD_STRAIGHT_FEED
        TestGlobals.actual = type
        result = AssertEqual()

        TestGlobals.test_name = "Queue: X Value (10.0)"
        TestGlobals.expected = 100000
        TestGlobals.actual = x
        result = AssertEqual()

        TestGlobals.test_name = "Queue: Y Value (20.0)"
        TestGlobals.expected = 200000
        TestGlobals.actual = y
        result = AssertEqual()

        TestGlobals.test_name = "Queue: Z Value (30.0)"
        TestGlobals.expected = 300000
        TestGlobals.actual = z
        result = AssertEqual()

        TestGlobals.test_name = "Queue: Feed Rate (500)"
        TestGlobals.expected = 5000000
        TestGlobals.actual = feed
        result = AssertEqual()

        ReturnValue(1)
    }
}

// ============================================================================
// TEST 5: PARSE FLOAT LOGIC
// ============================================================================

Function.Test_ParseFloat {
    Output: Integer
    Body: {
        PrintMessage("\n--- Test Group 5: Float Parsing Logic ---\n")

        str_pos = "12.345"
        TestGlobals.void_result = Parser.ParseFloat(str_pos, 0)
        TestGlobals.test_name = "Parse Positive Float (12.345)"
        TestGlobals.expected = 123450
        TestGlobals.actual = ParserResult.last_float_value
        result = AssertEqual()

        str_neg = "-98.7"
        TestGlobals.void_result = Parser.ParseFloat(str_neg, 0)
        TestGlobals.test_name = "Parse Negative Float (-98.7)"
        TestGlobals.expected = -987000
        TestGlobals.actual = ParserResult.last_float_value
        result = AssertEqual()

        str_int = "42"
        TestGlobals.void_result = Parser.ParseFloat(str_int, 0)
        TestGlobals.test_name = "Parse Integer as Float (42)"
        TestGlobals.expected = 420000
        TestGlobals.actual = ParserResult.last_float_value
        result = AssertEqual()

        ReturnValue(1)
    }
}

// ============================================================================
// TEST 6: FEED RATE AND SPINDLE SPEED
// ============================================================================

Function.Test_FeedSpindle {
    Output: Integer
    Body: {
        PrintMessage("\n--- Test Group 6: Feed Rate and Spindle Speed ---\n")

        result = Core.ResetModalState()

        test_line = "F500.5 S1200"
        TestGlobals.void_result = Interpreter.ProcessLine(test_line)

        TestGlobals.test_name = "Feed Rate Set (F500.5)"
        TestGlobals.expected = 5005000
        TestGlobals.actual = ModalState.feed_rate
        result = AssertEqual()

        TestGlobals.test_name = "Spindle Speed Set (S1200)"
        TestGlobals.expected = 1200
        TestGlobals.actual = ModalState.spindle_speed
        result = AssertEqual()

        ReturnValue(1)
    }
}

// ============================================================================
// TEST 7: MOTION COMMAND INTEGRATION
// ============================================================================

Function.Test_MotionIntegration {
    Output: Integer
    Body: {
        PrintMessage("\n--- Test Group 7: Motion Command Integration ---\n")

        result = ClearQueue()
        result = Core.ResetModalState()

        result = Motion.G00_RapidTraverse(50000, 60000, 70000)

        TestGlobals.test_name = "G00 Returns Success"
        TestGlobals.expected = 1
        TestGlobals.actual = result
        result = AssertEqual()

        TestGlobals.test_name = "G00 Updates Modal State"
        TestGlobals.expected = 0
        TestGlobals.actual = ModalState.motion_mode
        result = AssertEqual()

        TestGlobals.test_name = "G00 Queues Command"
        TestGlobals.expected = 1
        TestGlobals.actual = MotionQueue.count
        result = AssertEqual()

        result = Motion.G01_LinearFeed(80000, 90000, 100000)

        TestGlobals.test_name = "G01 Returns Success"
        TestGlobals.expected = 1
        TestGlobals.actual = result
        result = AssertEqual()

        TestGlobals.test_name = "G01 Updates Modal State"
        TestGlobals.expected = 1
        TestGlobals.actual = ModalState.motion_mode
        result = AssertEqual()

        TestGlobals.test_name = "Two Commands Queued"
        TestGlobals.expected = 2
        TestGlobals.actual = MotionQueue.count
        result = AssertEqual()

        ReturnValue(1)
    }
}

// ============================================================================
// TEST 8: COMPLEX LINE PARSING
// ============================================================================

Function.Test_ComplexLine {
    Output: Integer
    Body: {
        PrintMessage("\n--- Test Group 8: Complex Line Parsing ---\n")

        result = ClearQueue()
        result = Core.ResetModalState()

        test_line = "G90 G21 G01 X10.5 Y20.3 Z-5.1 F250 S1000"
        TestGlobals.void_result = Interpreter.ProcessLine(test_line)

        TestGlobals.test_name = "Complex Line: Distance Mode"
        TestGlobals.expected = 90
        TestGlobals.actual = ModalState.distance_mode
        result = AssertEqual()

        TestGlobals.test_name = "Complex Line: Units"
        TestGlobals.expected = 21
        TestGlobals.actual = ModalState.units
        result = AssertEqual()

        TestGlobals.test_name = "Complex Line: Motion Mode"
        TestGlobals.expected = 1
        TestGlobals.actual = ModalState.motion_mode
        result = AssertEqual()

        TestGlobals.test_name = "Complex Line: X Position"
        TestGlobals.expected = 105000
        TestGlobals.actual = ModalState.current_x
        result = AssertEqual()

        TestGlobals.test_name = "Complex Line: Feed Rate"
        TestGlobals.expected = 2500000
        TestGlobals.actual = ModalState.feed_rate
        result = AssertEqual()

        TestGlobals.test_name = "Complex Line: Spindle Speed"
        TestGlobals.expected = 1000
        TestGlobals.actual = ModalState.spindle_speed
        result = AssertEqual()

        ReturnValue(1)
    }
}

// ============================================================================
// MAIN RUNNER
// ============================================================================

Function.Main.Run {
    Body: {
        result = Test_Initialization()
        result = Test_ModalState()
        result = Test_Coordinates()
        result = Test_QueueData()
        result = Test_ParseFloat()
        result = Test_FeedSpindle()
        result = Test_MotionIntegration()
        result = Test_ComplexLine()

        PrintMessage("\n==============================================\n")
        PrintMessage("TEST SUMMARY\n")
        PrintMessage("==============================================\n")
        PrintMessage("Total Tests:  ")
        PrintNumber(TestGlobals.total_tests)
        PrintMessage("\n")
        PrintMessage("Passed:       ")
        PrintNumber(TestGlobals.passed_tests)
        PrintMessage("\n")
        PrintMessage("Failed:       ")
        PrintNumber(TestGlobals.failed_tests)
        PrintMessage("\n")
        PrintMessage("==============================================\n")

        Fork EqualTo(TestGlobals.failed_tests, 0) TrueBlock: {
            PrintMessage("RESULT: ALL SYSTEMS GO\n")
            PrintMessage("\nModular Library System Verified:\n")
            PrintMessage("  [OK] GCode_Core: Modal state and parsing\n")
            PrintMessage("  [OK] GCode_Queue: Ring buffer operations\n")
            PrintMessage("  [OK] GCode_Motion: G00, G01, G17-G21, G90-G91\n")
            PrintMessage("  [OK] GCode_Machine: M-code stubs\n")
            PrintMessage("  [OK] GCode_Interpreter: Line processing\n")
        } FalseBlock: {
            PrintMessage("RESULT: FAILURES DETECTED\n")
            PrintMessage("Review failed tests above\n")
        }

        PrintMessage("==============================================\n")
        ProcessExit(0)
    }
}

Main.Run()
