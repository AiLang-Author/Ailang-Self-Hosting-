// Test.ImgCanvas.ailang
// Headless P0 ImageEdit: paper solver, canvas, BMP round-trip. No Auckland, no Fonts.
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.Display.Render.DSurfaceTypes
LibraryImport.Display.Render.DSurface
LibraryImport.Display.Render.DDrawPixel
LibraryImport.ImageEdit.ImgCanvas

FixedPool.TResult {
    "pass_count": Initialize=0, CanChange=True
    "fail_count": Initialize=0, CanChange=True
    "test_num":   Initialize=0, CanChange=True
    "h":          Initialize=0, CanChange=True
    "h2":         Initialize=0, CanChange=True
    "surf":       Initialize=0, CanChange=True
    "c":          Initialize=0, CanChange=True
}

Function.TR_Pass {
    Input: msg: Address
    Body: {
        TResult.test_num = Add(TResult.test_num, 1)
        TResult.pass_count = Add(TResult.pass_count, 1)
        PrintMessage("  PASS ")
        PrintNumber(TResult.test_num)
        PrintMessage(": ")
        PrintMessage(msg)
        PrintMessage("\n")
    }
}

Function.TR_Fail {
    Input: msg: Address
    Body: {
        TResult.test_num = Add(TResult.test_num, 1)
        TResult.fail_count = Add(TResult.fail_count, 1)
        PrintMessage("  FAIL ")
        PrintNumber(TResult.test_num)
        PrintMessage(": ")
        PrintMessage(msg)
        PrintMessage("\n")
    }
}

Function.TR_Check {
    Input: cond: Integer
    Input: msg: Address
    Body: {
        IfCondition EqualTo(cond, 1) ThenBlock: {
            TR_Pass(msg)
        }
        IfCondition NotEqual(cond, 1) ThenBlock: {
            TR_Fail(msg)
        }
    }
}

Function.TR_CheckEqual {
    Input: actual: Integer
    Input: expected: Integer
    Input: msg: Address
    Body: {
        IfCondition EqualTo(actual, expected) ThenBlock: {
            TR_Pass(msg)
        }
        IfCondition NotEqual(actual, expected) ThenBlock: {
            TR_Fail(msg)
            PrintMessage("    expected=")
            PrintNumber(expected)
            PrintMessage(" actual=")
            PrintNumber(actual)
            PrintMessage("\n")
        }
    }
}

SubRoutine.TestPaperSizes {
    PrintMessage("\n=== Paper solver ===\n")
    ok = ImgPaper_SizePt(ImgPaper.LETTER, ImgPaper.PORTRAIT, 0, 0)
    TR_CheckEqual(ok, 1, "Letter ok")
    TR_CheckEqual(ImgCnvOut.phys_w, 612, "Letter w 612pt")
    TR_CheckEqual(ImgCnvOut.phys_h, 792, "Letter h 792pt")

    ok = ImgPaper_SizePt(ImgPaper.LETTER, ImgPaper.LANDSCAPE, 0, 0)
    TR_CheckEqual(ImgCnvOut.phys_w, 792, "Letter landscape w")
    TR_CheckEqual(ImgCnvOut.phys_h, 612, "Letter landscape h")

    ok = ImgPaper_SizePt(ImgPaper.LEGAL, ImgPaper.PORTRAIT, 0, 0)
    TR_CheckEqual(ImgCnvOut.phys_w, 612, "Legal w")
    TR_CheckEqual(ImgCnvOut.phys_h, 1008, "Legal h")

    ok = ImgPaper_SizePt(ImgPaper.A4, ImgPaper.PORTRAIT, 0, 0)
    TR_CheckEqual(ok, 1, "A4 ok")
    TR_CheckEqual(ImgCnvOut.phys_w, 595, "A4 w 595pt")
    TR_CheckEqual(ImgCnvOut.phys_h, 842, "A4 h 842pt")

    ok = ImgPaper_SizePt(ImgPaper.A3, ImgPaper.PORTRAIT, 0, 0)
    TR_CheckEqual(ImgCnvOut.phys_w, 842, "A3 w")
    TR_CheckEqual(ImgCnvOut.phys_h, 1191, "A3 h")

    ok = ImgPaper_SizePt(ImgPaper.CUSTOM, ImgPaper.PORTRAIT, 500, 700)
    TR_CheckEqual(ok, 1, "Custom ok")
    TR_CheckEqual(ImgCnvOut.phys_w, 500, "Custom w")
    TR_CheckEqual(ImgCnvOut.phys_h, 700, "Custom h")

    ok = ImgPaper_SizePt(ImgPaper.CUSTOM, ImgPaper.LANDSCAPE, 500, 700)
    TR_CheckEqual(ImgCnvOut.phys_w, 700, "Custom landscape swap w")
    TR_CheckEqual(ImgCnvOut.phys_h, 500, "Custom landscape swap h")

    ok = ImgPaper_SizePt(ImgPaper.FREE, ImgPaper.PORTRAIT, 0, 0)
    TR_CheckEqual(ok, 0, "FREE rejected by SizePt")
}

SubRoutine.TestCreatePaper {
    PrintMessage("\n=== Create paper / FREE ===\n")
    TResult.h = ImgCanvas_CreatePaper(ImgPaper.LETTER, ImgPaper.PORTRAIT, 96)
    TR_Check(GreaterThan(TResult.h, 0), "Create Letter 96")
    TR_CheckEqual(ImgCanvas_Get(TResult.h, ImgCnvField.PIX_W), 816, "Letter96 PIX_W 816")
    TR_CheckEqual(ImgCanvas_Get(TResult.h, ImgCnvField.PIX_H), 1056, "Letter96 PIX_H 1056")
    TR_CheckEqual(ImgCanvas_Get(TResult.h, ImgCnvField.PHYS_W), 612, "Letter96 PHYS_W 612")
    TR_CheckEqual(ImgCanvas_Get(TResult.h, ImgCnvField.PHYS_H), 792, "Letter96 PHYS_H 792")
    ImgCanvas_Destroy(TResult.h)

    TResult.h = ImgCanvas_CreatePaper(ImgPaper.LETTER, ImgPaper.PORTRAIT, 300)
    TR_Check(GreaterThan(TResult.h, 0), "Create Letter 300")
    TR_CheckEqual(ImgCanvas_Get(TResult.h, ImgCnvField.PIX_W), 2550, "Letter300 PIX_W 2550")
    TR_CheckEqual(ImgCanvas_Get(TResult.h, ImgCnvField.PIX_H), 3300, "Letter300 PIX_H 3300")
    TR_CheckEqual(ImgCanvas_Get(TResult.h, ImgCnvField.PHYS_W), 612, "Letter300 PHYS_W still 612")
    TR_CheckEqual(ImgCanvas_Get(TResult.h, ImgCnvField.PHYS_H), 792, "Letter300 PHYS_H still 792")
    ImgCanvas_Destroy(TResult.h)

    TResult.h = ImgCanvas_CreatePaper(ImgPaper.A4, ImgPaper.PORTRAIT, 96)
    TR_Check(GreaterThan(TResult.h, 0), "Create A4 96")
    TR_CheckEqual(ImgCanvas_Get(TResult.h, ImgCnvField.PIX_W), 793, "A4 PIX_W 793")
    TR_CheckEqual(ImgCanvas_Get(TResult.h, ImgCnvField.PIX_H), 1122, "A4 PIX_H 1122")
    TR_CheckEqual(ImgCanvas_Get(TResult.h, ImgCnvField.PHYS_W), 595, "A4 PHYS_W 595 not 594")
    TR_CheckEqual(ImgCanvas_Get(TResult.h, ImgCnvField.PHYS_H), 842, "A4 PHYS_H 842 not 841")
    ImgCanvas_Destroy(TResult.h)

    TResult.h = ImgCanvas_CreateFree(640, 480, 96)
    TR_Check(GreaterThan(TResult.h, 0), "CreateFree 640x480")
    TR_CheckEqual(ImgCanvas_Get(TResult.h, ImgCnvField.PIX_W), 640, "FREE PIX_W")
    TR_CheckEqual(ImgCanvas_Get(TResult.h, ImgCnvField.PIX_H), 480, "FREE PIX_H")
    TR_CheckEqual(ImgCanvas_Get(TResult.h, ImgCnvField.PHYS_W), 480, "FREE PHYS_W 480")
    TR_CheckEqual(ImgCanvas_Get(TResult.h, ImgCnvField.PHYS_H), 360, "FREE PHYS_H 360")
    TR_CheckEqual(ImgCanvas_Get(TResult.h, ImgCnvField.PAPER), ImgPaper.FREE, "FREE paper id")
    ImgCanvas_Destroy(TResult.h)

    TResult.h = ImgCanvas_CreatePaper(ImgPaper.A3, ImgPaper.PORTRAIT, 300)
    TR_CheckEqual(TResult.h, -1, "A3 @ 300 refuses MAX_DIM")

    TResult.h = ImgCanvas_CreatePaper(ImgPaper.FREE, ImgPaper.PORTRAIT, 96)
    TR_CheckEqual(TResult.h, -1, "CreatePaper rejects FREE")
}

SubRoutine.TestSetAndRecycle {
    PrintMessage("\n=== Set / recycle ===\n")
    TResult.h = ImgCanvas_CreateFree(32, 32, 96)
    TR_Check(GreaterThan(TResult.h, 0), "Create 32x32")
    ok = ImgCanvas_Set(TResult.h, ImgCnvField.PIX_W, 64)
    TR_CheckEqual(ok, 0, "Set PIX_W illegal")
    TR_CheckEqual(ImgCanvas_Get(TResult.h, ImgCnvField.PIX_W), 32, "PIX_W unchanged")
    ok = ImgCanvas_SetDpi(TResult.h, 300)
    TR_CheckEqual(ok, 1, "SetDpi 300")
    TR_CheckEqual(ImgCanvas_Get(TResult.h, ImgCnvField.PAPER), ImgPaper.FREE, "SetDpi stays/becomes FREE")
    TR_CheckEqual(ImgCanvas_Get(TResult.h, ImgCnvField.PIX_W), 32, "SetDpi PIX stay")
    ok = ImgCanvas_SetDpi(TResult.h, 0)
    TR_CheckEqual(ok, 0, "SetDpi 0 fails")

    idx = BitwiseAnd(TResult.h, 65535)
    gen = ShiftRight(TResult.h, 16)
    used = ImgCnvTable.used
    ImgCanvas_Destroy(TResult.h)
    TR_CheckEqual(ImgCnvTable.used, Subtract(used, 1), "used decrements")
    TResult.h2 = ImgCanvas_CreateFree(16, 16, 96)
    TR_CheckEqual(BitwiseAnd(TResult.h2, 65535), idx, "recycle same index")
    TR_Check(NotEqual(ShiftRight(TResult.h2, 16), gen), "recycle different GEN")
    ImgCanvas_Destroy(TResult.h2)
}

SubRoutine.TestBmpRoundTrip {
    PrintMessage("\n=== BMP round-trip ===\n")
    TResult.h = ImgCanvas_CreateFree(48, 32, 96)
    TR_Check(GreaterThan(TResult.h, 0), "Create 48x32")
    TResult.surf = ImgCanvas_ActiveSurf(TResult.h)
    TR_Check(NotEqual(TResult.surf, 0), "ActiveSurf")
    TResult.c = ImgPixels_Get(TResult.surf, 0, 0)
    TR_CheckEqual(TResult.c, 0xFFFFFFFF, "BG fill opaque white")
    ImgPixels_Fill(TResult.surf, 4, 4, 10, 8, 0xFF0000FF)
    ImgPixels_Put(TResult.surf, 20, 10, 0xFF112233)
    TResult.c = ImgPixels_Get(TResult.surf, 20, 10)
    TR_CheckEqual(TResult.c, 0xFF112233, "Put/Get dword")
    ok = ImgIO_SaveBMP(TResult.h, "/tmp/imgcanvas_test.bmp")
    TR_CheckEqual(ok, 1, "SaveBMP")
    ImgCanvas_Destroy(TResult.h)
    TResult.h2 = ImgIO_LoadBMP("/tmp/imgcanvas_test.bmp")
    TR_Check(GreaterThan(TResult.h2, 0), "LoadBMP")
    TR_CheckEqual(ImgCanvas_Get(TResult.h2, ImgCnvField.PIX_W), 48, "loaded PIX_W")
    TR_CheckEqual(ImgCanvas_Get(TResult.h2, ImgCnvField.PIX_H), 32, "loaded PIX_H")
    TResult.surf = ImgCanvas_ActiveSurf(TResult.h2)
    TResult.c = ImgPixels_Get(TResult.surf, 0, 0)
    TR_CheckEqual(TResult.c, 0xFFFFFFFF, "loaded corner white")
    TResult.c = ImgPixels_Get(TResult.surf, 4, 4)
    TR_CheckEqual(TResult.c, 0xFF0000FF, "loaded fill dword")
    TResult.c = ImgPixels_Get(TResult.surf, 20, 10)
    TR_CheckEqual(TResult.c, 0xFF112233, "loaded put dword")
    ImgCanvas_Destroy(TResult.h2)
}

SubRoutine.TestBrushLine {
    PrintMessage("\n=== Brush / line / sketch ===\n")
    TResult.h = ImgCanvas_CreateFree(64, 64, 96)
    TResult.surf = ImgCanvas_ActiveSurf(TResult.h)
    ImgWalk.thick = 3
    ImgWalk.color = 0xFF000000
    ImgPixels_ThickLine(TResult.surf, 4, 20, 50, 20)
    TResult.c = ImgPixels_Get(TResult.surf, 20, 20)
    TR_CheckEqual(TResult.c, 0xFF000000, "thick line pixel black")
    TResult.c = ImgPixels_Get(TResult.surf, 20, 0)
    TR_CheckEqual(TResult.c, 0xFFFFFFFF, "off-line stays white")

    n = ImgSketch_AddLine(4, 20, 50, 20)
    TR_Check(GreaterThan(n, 0), "sketch AddLine")
    TR_CheckEqual(ImgSketch_Count(), 1, "sketch count 1")

    ImgBrush_Set(16, 40, 0, 0xFF000000)
    ImgBrush_Begin()
    ImgBrush_Stamp(TResult.surf, 40, 40)
    TResult.c = ImgPixels_Get(TResult.surf, 40, 40)
    TR_Check(NotEqual(TResult.c, 0xFFFFFFFF), "airbrush center not white")
    TR_Check(NotEqual(TResult.c, 0xFF000000), "airbrush center not solid")
    TResult.c = ImgPixels_Get(TResult.surf, 0, 0)
    TR_CheckEqual(TResult.c, 0xFFFFFFFF, "airbrush misses far corner")

    ImgCanvas_Destroy(TResult.h)
    TResult.h = ImgCanvas_CreateFree(80, 80, 96)
    TResult.surf = ImgCanvas_ActiveSurf(TResult.h)
    ImgWalk.thick = 2
    ImgWalk.color = 0xFF000000
    ImgSketch.x0 = 10
    ImgSketch.y0 = 40
    ImgSketch.px = 40
    ImgSketch.qy = 12
    ImgSketch.x1 = 70
    ImgSketch.y1 = 40
    ImgSketch_RasterArc3(TResult.surf)
    found = 0
    yy = 8
    WhileLoop LessThan(yy, 36) {
        xx = 20
        WhileLoop LessThan(xx, 60) {
            TResult.c = ImgPixels_Get(TResult.surf, xx, yy)
            IfCondition NotEqual(TResult.c, 0xFFFFFFFF) ThenBlock: {
                found = 1
            }
            xx = Add(xx, 1)
        }
        yy = Add(yy, 1)
    }
    TR_CheckEqual(found, 1, "arc painted in bulge")
    ImgSketch_ClearPts()
    ImgSketch_AddPt(8, 8)
    ImgSketch_AddPt(40, 8)
    ImgSketch_AddPt(70, 40)
    ImgSketch_RasterPoly(TResult.surf)
    TR_CheckEqual(ImgSketch_NPts(), 3, "poly 3 pts")
    TResult.c = ImgPixels_Get(TResult.surf, 40, 8)
    TR_CheckEqual(TResult.c, 0xFF000000, "poly segment")
    ImgCanvas_Destroy(TResult.h)
}

SubRoutine.RunAll {
    PrintMessage("========================================\n")
    PrintMessage("  ImageEdit P0 canvas + BMP\n")
    PrintMessage("========================================\n")

    Arena_Init()
    ok = ImgCanvas_Init()
    TR_CheckEqual(ok, 1, "ImgCanvas_Init")

    RunTask(TestPaperSizes)
    RunTask(TestCreatePaper)
    RunTask(TestSetAndRecycle)
    RunTask(TestBmpRoundTrip)
    RunTask(TestBrushLine)

    PrintMessage("\n========================================\n")
    PrintMessage("  Results: ")
    PrintNumber(TResult.pass_count)
    PrintMessage(" PASS, ")
    PrintNumber(TResult.fail_count)
    PrintMessage(" FAIL\n")
    PrintMessage("========================================\n")
    IfCondition GreaterThan(TResult.fail_count, 0) ThenBlock: {
        SystemCall(60, 1)
    }
}

RunTask(RunAll)
