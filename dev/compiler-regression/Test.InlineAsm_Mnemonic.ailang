// Test.InlineAsm_Mnemonic.ailang
// Tests InlineAsm mnemonic path (InlineAsm["NOP"], InlineAsm["PUSH rax"], etc.)
// Companion to Test.InlineAsm.ailang which tests the raw hex path.

LibraryImport.Arena

FixedPool.MnemonicSuite {
    "pass": Initialize=0, CanChange=True
    "fail": Initialize=0, CanChange=True
}

Function.M_Pass {
    Input: name: Address
    Body: {
        MnemonicSuite.pass = Add(MnemonicSuite.pass, 1)
        PrintMessage("  [PASS] ")
        PrintMessage(name)
        PrintMessage("\n")
    }
}

Function.M_Fail {
    Input: name: Address
    Input: got: Integer
    Input: exp: Integer
    Body: {
        MnemonicSuite.fail = Add(MnemonicSuite.fail, 1)
        PrintMessage("  [FAIL] ")
        PrintMessage(name)
        PrintMessage("  got=")
        PrintNumber(got)
        PrintMessage("  exp=")
        PrintNumber(exp)
        PrintMessage("\n")
    }
}

Function.M_Check {
    Input: name: Address
    Input: got: Integer
    Input: exp: Integer
    Body: {
        IfCondition EqualTo(got, exp) ThenBlock: {
            M_Pass(name)
        } ElseBlock: {
            M_Fail(name, got, exp)
        }
    }
}

// =============================================================================
// T1 - NOP survives (program continues after NOP)
// =============================================================================
Function.Test_Mnem_NOP {
    Output: Integer
    Body: {
        x = 77
        InlineAsm["NOP"]
        ReturnValue(x)
    }
}

// =============================================================================
// T2 - Multiple NOPs
// =============================================================================
Function.Test_Mnem_MultiNOP {
    Output: Integer
    Body: {
        x = 55
        InlineAsm["NOP"]
        InlineAsm["NOP"]
        InlineAsm["NOP"]
        ReturnValue(x)
    }
}

// =============================================================================
// T3 - PUSH rax / POP rax round-trip preserves value
// =============================================================================
Function.Test_Mnem_PushPop {
    Output: Integer
    Body: {
        x = 123
        InlineAsm["PUSH rax"]
        InlineAsm["POP rax"]
        ReturnValue(x)
    }
}

// =============================================================================
// T4 - NOP then arithmetic still works
// =============================================================================
Function.Test_Mnem_NopArith {
    Output: Integer
    Body: {
        x = 10
        InlineAsm["NOP"]
        y = Multiply(x, 5)
        ReturnValue(y)
    }
}

// =============================================================================
// MAIN
// =============================================================================
SubRoutine.Main {
    Arena_Init()

    PrintMessage("=== InlineAsm mnemonic smoke tests ===\n")

    M_Check("NOP preserves value",        Test_Mnem_NOP(),      77)
    M_Check("3x NOP preserves value",     Test_Mnem_MultiNOP(), 55)
    M_Check("PUSH/POP round-trip",        Test_Mnem_PushPop(),  123)
    M_Check("NOP then arith still works", Test_Mnem_NopArith(), 50)

    PrintMessage("\n=== Results ===\n")
    PrintMessage("PASS: ")
    PrintNumber(MnemonicSuite.pass)
    PrintMessage("\nFAIL: ")
    PrintNumber(MnemonicSuite.fail)
    PrintMessage("\n")
}

RunTask(Main)
