// Test.InlineAsm_Real.ailang
// Real-world InlineAsm mnemonic tests: arithmetic, bitwise, shifts, POPCNT, BSF.
// These demonstrate instructions that are tedious to write in hex.

LibraryImport.Arena

FixedPool.RealSuite {
    "pass": Initialize=0, CanChange=True
    "fail": Initialize=0, CanChange=True
}

Function.R_Pass {
    Input: name: Address
    Body: {
        RealSuite.pass = Add(RealSuite.pass, 1)
        PrintMessage("  [PASS] ")
        PrintMessage(name)
        PrintMessage("\n")
    }
}

Function.R_Fail {
    Input: name: Address
    Input: got: Integer
    Input: exp: Integer
    Body: {
        RealSuite.fail = Add(RealSuite.fail, 1)
        PrintMessage("  [FAIL] ")
        PrintMessage(name)
        PrintMessage("  got=")
        PrintNumber(got)
        PrintMessage("  exp=")
        PrintNumber(exp)
        PrintMessage("\n")
    }
}

Function.R_Check {
    Input: name: Address
    Input: got: Integer
    Input: exp: Integer
    Body: {
        IfCondition EqualTo(got, exp) ThenBlock: {
            R_Pass(name)
        } ElseBlock: {
            R_Fail(name, got, exp)
        }
    }
}

// =============================================================================
// T1 - IMUL rax, rax, 33  (djb2 hash multiplier)
// Start with 10 in rax, multiply by 33 -> 330
// =============================================================================
Function.Test_IMUL33 {
    Output: Integer
    Body: {
        result = InlineAsm["48 c7 c0 0a 00 00 00  48 69 c0 21 00 00 00"]
        ReturnValue(result)
    }
}

// Same via mnemonic — should produce identical bytes
Function.Test_IMUL33_Mnem {
    Output: Integer
    Body: {
        InlineAsm["MOV rax, 10"]
        result = InlineAsm["IMUL rax, rax, 33"]
        ReturnValue(result)
    }
}

// =============================================================================
// T2 - POPCNT: count set bits in 0b10110101 = 0xB5 = 181 -> 5 bits
// =============================================================================
Function.Test_POPCNT {
    Output: Integer
    Body: {
        InlineAsm["MOV rax, 181"]
        result = InlineAsm["POPCNT rax, rax"]
        ReturnValue(result)
    }
}

// =============================================================================
// T3 - BSF: bit scan forward on 0b00010000 = 16 -> lowest set bit index = 4
// =============================================================================
Function.Test_BSF {
    Output: Integer
    Body: {
        InlineAsm["MOV rax, 16"]
        result = InlineAsm["BSF rax, rax"]
        ReturnValue(result)
    }
}

// =============================================================================
// T4 - XOR rax, rax -> 0
// =============================================================================
Function.Test_XOR_Zero {
    Output: Integer
    Body: {
        InlineAsm["MOV rax, 9999"]
        result = InlineAsm["XOR rax, rax"]
        ReturnValue(result)
    }
}

// =============================================================================
// T5 - NOT rax on 0 -> -1 (all bits set, twos complement)
// =============================================================================
Function.Test_NOT {
    Output: Integer
    Body: {
        InlineAsm["XOR rax, rax"]
        result = InlineAsm["NOT rax"]
        ReturnValue(result)
    }
}

// =============================================================================
// T6 - NEG rax on 42 -> -42
// =============================================================================
Function.Test_NEG {
    Output: Integer
    Body: {
        InlineAsm["MOV rax, 42"]
        result = InlineAsm["NEG rax"]
        ReturnValue(result)
    }
}

// =============================================================================
// MAIN
// =============================================================================
SubRoutine.Main {
    Arena_Init()

    PrintMessage("=== InlineAsm real instruction tests ===\n\n")

    PrintMessage("--- IMUL ---\n")
    R_Check("IMUL33 hex path",   Test_IMUL33(),       330)
    R_Check("IMUL33 mnemonic",   Test_IMUL33_Mnem(),  330)

    PrintMessage("--- Bit ops ---\n")
    R_Check("POPCNT(181)=5",     Test_POPCNT(),  5)
    R_Check("BSF(16)=4",         Test_BSF(),     4)
    R_Check("XOR rax,rax = 0",   Test_XOR_Zero(), 0)
    R_Check("NOT 0 = -1",        Test_NOT(),     -1)
    R_Check("NEG 42 = -42",      Test_NEG(),     -42)

    PrintMessage("\n=== Results ===\n")
    PrintMessage("PASS: ")
    PrintNumber(RealSuite.pass)
    PrintMessage("\nFAIL: ")
    PrintNumber(RealSuite.fail)
    PrintMessage("\n")
}

RunTask(Main)
