// Test.InlineFunction.ailang
RunTask(Main)
// Validates InlineFunction keyword: call sites are expanded inline,
// ReturnValue jumps to the inline return label, result lands in RAX.

InlineFunction.Add2 {
    Input: a: Integer
    Input: b: Integer
    Output: Integer
    Body: {
        ReturnValue(Add(a, b))
    }
}

InlineFunction.Square {
    Input: x: Integer
    Output: Integer
    Body: {
        ReturnValue(Multiply(x, x))
    }
}

InlineFunction.Max2 {
    Input: p: Integer
    Input: q: Integer
    Output: Integer
    Body: {
        result = p
        IfCondition GreaterThan(q, p) ThenBlock: {
            result = q
        }
        ReturnValue(result)
    }
}

InlineFunction.AbsDiff {
    Input: m: Integer
    Input: n: Integer
    Output: Integer
    Body: {
        diff = Subtract(m, n)
        IfCondition LessThan(diff, 0) ThenBlock: {
            diff = Subtract(n, m)
        }
        ReturnValue(diff)
    }
}

SubRoutine.Main {
    pass = 0
    fail = 0

    // Test 1: Add2(3, 4) == 7
    r1 = Add2(3, 4)
    IfCondition EqualTo(r1, 7) ThenBlock: {
        pass = Add(pass, 1)
    } ElseBlock: {
        PrintMessage("FAIL Add2(3,4): expected 7 got ")
        PrintNumber(r1)
        PrintMessage("\n")
        fail = Add(fail, 1)
    }

    // Test 2: Add2(0, 0) == 0
    r2 = Add2(0, 0)
    IfCondition EqualTo(r2, 0) ThenBlock: {
        pass = Add(pass, 1)
    } ElseBlock: {
        PrintMessage("FAIL Add2(0,0): expected 0 got ")
        PrintNumber(r2)
        PrintMessage("\n")
        fail = Add(fail, 1)
    }

    // Test 3: Add2(-5, 5) == 0
    r3 = Add2(-5, 5)
    IfCondition EqualTo(r3, 0) ThenBlock: {
        pass = Add(pass, 1)
    } ElseBlock: {
        PrintMessage("FAIL Add2(-5,5): expected 0 got ")
        PrintNumber(r3)
        PrintMessage("\n")
        fail = Add(fail, 1)
    }

    // Test 4: Square(7) == 49
    r4 = Square(7)
    IfCondition EqualTo(r4, 49) ThenBlock: {
        pass = Add(pass, 1)
    } ElseBlock: {
        PrintMessage("FAIL Square(7): expected 49 got ")
        PrintNumber(r4)
        PrintMessage("\n")
        fail = Add(fail, 1)
    }

    // Test 5: Square(0) == 0
    r5 = Square(0)
    IfCondition EqualTo(r5, 0) ThenBlock: {
        pass = Add(pass, 1)
    } ElseBlock: {
        PrintMessage("FAIL Square(0): expected 0 got ")
        PrintNumber(r5)
        PrintMessage("\n")
        fail = Add(fail, 1)
    }

    // Test 6: Max2(10, 20) == 20
    r6 = Max2(10, 20)
    IfCondition EqualTo(r6, 20) ThenBlock: {
        pass = Add(pass, 1)
    } ElseBlock: {
        PrintMessage("FAIL Max2(10,20): expected 20 got ")
        PrintNumber(r6)
        PrintMessage("\n")
        fail = Add(fail, 1)
    }

    // Test 7: Max2(99, 1) == 99
    r7 = Max2(99, 1)
    IfCondition EqualTo(r7, 99) ThenBlock: {
        pass = Add(pass, 1)
    } ElseBlock: {
        PrintMessage("FAIL Max2(99,1): expected 99 got ")
        PrintNumber(r7)
        PrintMessage("\n")
        fail = Add(fail, 1)
    }

    // Test 8: Max2(5, 5) == 5
    r8 = Max2(5, 5)
    IfCondition EqualTo(r8, 5) ThenBlock: {
        pass = Add(pass, 1)
    } ElseBlock: {
        PrintMessage("FAIL Max2(5,5): expected 5 got ")
        PrintNumber(r8)
        PrintMessage("\n")
        fail = Add(fail, 1)
    }

    // Test 9: AbsDiff(10, 3) == 7
    r9 = AbsDiff(10, 3)
    IfCondition EqualTo(r9, 7) ThenBlock: {
        pass = Add(pass, 1)
    } ElseBlock: {
        PrintMessage("FAIL AbsDiff(10,3): expected 7 got ")
        PrintNumber(r9)
        PrintMessage("\n")
        fail = Add(fail, 1)
    }

    // Test 10: AbsDiff(3, 10) == 7
    r10 = AbsDiff(3, 10)
    IfCondition EqualTo(r10, 7) ThenBlock: {
        pass = Add(pass, 1)
    } ElseBlock: {
        PrintMessage("FAIL AbsDiff(3,10): expected 7 got ")
        PrintNumber(r10)
        PrintMessage("\n")
        fail = Add(fail, 1)
    }

    // Test 11: chained — Square(Add2(2, 3)) == 25
    tmp = Add2(2, 3)
    r11 = Square(tmp)
    IfCondition EqualTo(r11, 25) ThenBlock: {
        pass = Add(pass, 1)
    } ElseBlock: {
        PrintMessage("FAIL Square(Add2(2,3)): expected 25 got ")
        PrintNumber(r11)
        PrintMessage("\n")
        fail = Add(fail, 1)
    }

    // Test 12: Add2 called in an expression
    r12 = Add(Add2(1, 2), Add2(3, 4))
    IfCondition EqualTo(r12, 10) ThenBlock: {
        pass = Add(pass, 1)
    } ElseBlock: {
        PrintMessage("FAIL Add(Add2(1,2),Add2(3,4)): expected 10 got ")
        PrintNumber(r12)
        PrintMessage("\n")
        fail = Add(fail, 1)
    }

    PrintMessage("InlineFunction: ")
    PrintNumber(pass)
    PrintMessage("/")
    PrintNumber(Add(pass, fail))
    PrintMessage(" passed\n")
}
