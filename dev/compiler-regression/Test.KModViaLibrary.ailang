// Test.KModViaLibrary.ailang
// Same end-to-end as Test.KModPrintk.ailang but uses the canonical
// Library.KernelShim instead of declaring externs inline. This is the
// pattern real kernel-module sources should follow.
//
// Build:
//   ./ailang.x -kmod dev/compiler-regression/Test.KModViaLibrary.ailang ail_payload_lib.o
//
// Verify:
//   readelf -s ail_payload_lib.o   →  ail_main DEFINED, ail_printk UND,
//                                     ail_kmalloc UND, ail_kfree UND
//   readelf -r ail_payload_lib.o   →  PLT32 relocs against each used
//                                     extern (deduped one symtab entry
//                                     each); R_X86_64_64 against .data
//                                     for every string literal.

LibraryImport.KernelShim

Function.ail_main {
    Output: Integer
    Body: {
        ail_printk("kmod-via-library: ail_main entered")

        // Exercise kmalloc/kfree to prove the library declarations work
        // for every shape (Address return, multi-arg, void return).
        buf = ail_kmalloc(64)
        ail_kfree(buf)

        ail_printk("kmod-via-library: returning 0")
        ReturnValue(0)
    }
}

Function.ail_exit {
    Body: {
        ail_printk("kmod-via-library: ail_exit")
    }
}
