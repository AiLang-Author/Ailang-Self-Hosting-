// Test.PERF_Array.ailang
// Smoke tests for Library.PERF_Array.ailang
// Covers: Create/Destroy, Get/Set, Push/Pop, Clear, Insert/Delete,
//         IndexOf/Contains, Copy, Extend, Reverse, Sort, Slice, IsArray.

LibraryImport.Arena
LibraryImport.Array

// =============================================================================
// TEST HELPERS
// =============================================================================
FixedPool.Suite {
    "pass": Initialize=0, CanChange=True
    "fail": Initialize=0, CanChange=True
}

Function.Pass {
    Input: name: Address
    Body: {
        Suite.pass = Add(Suite.pass, 1)
        PrintMessage("  [PASS] ")
        PrintMessage(name)
        PrintMessage("\n")
    }
}

Function.Fail {
    Input: name: Address
    Input: got:  Integer
    Input: exp:  Integer
    Body: {
        Suite.fail = Add(Suite.fail, 1)
        PrintMessage("  [FAIL] ")
        PrintMessage(name)
        PrintMessage("  got=")
        PrintNumber(got)
        PrintMessage("  expected=")
        PrintNumber(exp)
        PrintMessage("\n")
    }
}

Function.Check {
    Input: name: Address
    Input: got:  Integer
    Input: exp:  Integer
    Body: {
        IfCondition EqualTo(got, exp) ThenBlock: {
            Pass(name)
        } ElseBlock: {
            Fail(name, got, exp)
        }
    }
}

// =============================================================================
// T1 — Create / Size / Destroy
// =============================================================================
Function.Test_Create {
    Body: {
        PrintMessage("--- Create/Size/Destroy ---\n")
        a = Array.Create(8)
        Check("initial size = 0",      Array.Size(a),     0)
        Check("initial capacity = 8",  Array.Capacity(a), 8)
        Check("IsArray = 1",           Array.IsArray(a),  1)
        Check("IsArray(0) = 0",        Array.IsArray(0),  0)
        Check("IsArray(1) = 0",        Array.IsArray(1),  0)
        Array.Destroy(a)
    }
}

// =============================================================================
// T2 — Push / Get / Set
// =============================================================================
Function.Test_PushGet {
    Body: {
        PrintMessage("--- Push/Get/Set ---\n")
        a = Array.Create(4)

        Array.Push(a, 10)
        Array.Push(a, 20)
        Array.Push(a, 30)

        Check("size after 3 pushes", Array.Size(a), 3)
        Check("get[0] = 10",         Array.Get(a, 0), 10)
        Check("get[1] = 20",         Array.Get(a, 1), 20)
        Check("get[2] = 30",         Array.Get(a, 2), 30)
        Check("get OOB = 0",         Array.Get(a, 5),  0)

        Array.Set(a, 1, 99)
        Check("set[1] = 99",         Array.Get(a, 1), 99)

        Array.Destroy(a)
    }
}

// =============================================================================
// T3 — Pop / Clear
// =============================================================================
Function.Test_PopClear {
    Body: {
        PrintMessage("--- Pop/Clear ---\n")
        a = Array.Create(4)

        Array.Push(a, 1)
        Array.Push(a, 2)
        Array.Push(a, 3)

        v = Array.Pop(a)
        Check("pop returns 3",       v,               3)
        Check("size after pop = 2",  Array.Size(a),  2)

        Array.Clear(a)
        Check("size after clear = 0", Array.Size(a), 0)
        Check("pop empty = 0",        Array.Pop(a),  0)

        Array.Destroy(a)
    }
}

// =============================================================================
// T4 — Grow (auto-resize on push past capacity)
// =============================================================================
Function.Test_Grow {
    Body: {
        PrintMessage("--- Grow ---\n")
        a = Array.Create(2)

        Array.Push(a, 1)
        Array.Push(a, 2)
        Array.Push(a, 3)
        Array.Push(a, 4)
        Array.Push(a, 5)

        Check("size after grow = 5", Array.Size(a),   5)
        Check("get[0] after grow",   Array.Get(a, 0), 1)
        Check("get[4] after grow",   Array.Get(a, 4), 5)

        Array.Destroy(a)
    }
}

// =============================================================================
// T5 — Insert / Delete
// =============================================================================
Function.Test_InsertDelete {
    Body: {
        PrintMessage("--- Insert/Delete ---\n")
        a = Array.Create(8)

        Array.Push(a, 1)
        Array.Push(a, 2)
        Array.Push(a, 3)

        Array.Insert(a, 1, 99)
        Check("size after insert = 4", Array.Size(a),   4)
        Check("get[1] = 99",           Array.Get(a, 1), 99)
        Check("get[2] shifted = 2",    Array.Get(a, 2),  2)

        deleted = Array.Delete(a, 1)
        Check("delete returns 99",     deleted,          99)
        Check("size after delete = 3", Array.Size(a),    3)
        Check("get[1] restored = 2",   Array.Get(a, 1),  2)

        Array.Destroy(a)
    }
}

// =============================================================================
// T6 — IndexOf / Contains
// =============================================================================
Function.Test_IndexOf {
    Body: {
        PrintMessage("--- IndexOf/Contains ---\n")
        a = Array.Create(4)

        Array.Push(a, 10)
        Array.Push(a, 20)
        Array.Push(a, 30)

        Check("indexOf 20 = 1",      Array.IndexOf(a, 20),  1)
        Check("indexOf 99 = -1",     Array.IndexOf(a, 99), -1)
        Check("contains 10 = 1",     Array.Contains(a, 10), 1)
        Check("contains 99 = 0",     Array.Contains(a, 99), 0)

        Array.Destroy(a)
    }
}

// =============================================================================
// T7 — Copy
// =============================================================================
Function.Test_Copy {
    Body: {
        PrintMessage("--- Copy ---\n")
        a = Array.Create(4)
        Array.Push(a, 7)
        Array.Push(a, 8)
        Array.Push(a, 9)

        b = Array.Copy(a)
        Check("copy size = 3",    Array.Size(b),   3)
        Check("copy[0] = 7",      Array.Get(b, 0), 7)
        Check("copy[2] = 9",      Array.Get(b, 2), 9)

        // Mutating b doesn't affect a
        Array.Set(b, 0, 42)
        Check("original[0] = 7", Array.Get(a, 0),  7)
        Check("copy[0] = 42",    Array.Get(b, 0), 42)

        Array.Destroy(a)
        Array.Destroy(b)
    }
}

// =============================================================================
// T8 — Extend
// =============================================================================
Function.Test_Extend {
    Body: {
        PrintMessage("--- Extend ---\n")
        a = Array.Create(4)
        b = Array.Create(4)

        Array.Push(a, 1)
        Array.Push(a, 2)
        Array.Push(b, 3)
        Array.Push(b, 4)

        Array.Extend(a, b)
        Check("size after extend = 4", Array.Size(a),   4)
        Check("a[2] = 3",              Array.Get(a, 2), 3)
        Check("a[3] = 4",              Array.Get(a, 3), 4)

        Array.Destroy(a)
        Array.Destroy(b)
    }
}

// =============================================================================
// T9 — Reverse
// =============================================================================
Function.Test_Reverse {
    Body: {
        PrintMessage("--- Reverse ---\n")
        a = Array.Create(4)

        Array.Push(a, 1)
        Array.Push(a, 2)
        Array.Push(a, 3)
        Array.Push(a, 4)

        Array.Reverse(a)
        Check("reverse[0] = 4", Array.Get(a, 0), 4)
        Check("reverse[1] = 3", Array.Get(a, 1), 3)
        Check("reverse[2] = 2", Array.Get(a, 2), 2)
        Check("reverse[3] = 1", Array.Get(a, 3), 1)

        Array.Destroy(a)
    }
}

// =============================================================================
// T10 — Sort
// =============================================================================
Function.Test_Sort {
    Body: {
        PrintMessage("--- Sort ---\n")
        a = Array.Create(8)

        Array.Push(a, 5)
        Array.Push(a, 2)
        Array.Push(a, 8)
        Array.Push(a, 1)
        Array.Push(a, 9)
        Array.Push(a, 3)

        Array.Sort(a)
        Check("sort[0] = 1", Array.Get(a, 0), 1)
        Check("sort[1] = 2", Array.Get(a, 1), 2)
        Check("sort[2] = 3", Array.Get(a, 2), 3)
        Check("sort[3] = 5", Array.Get(a, 3), 5)
        Check("sort[4] = 8", Array.Get(a, 4), 8)
        Check("sort[5] = 9", Array.Get(a, 5), 9)

        Array.Destroy(a)
    }
}

// =============================================================================
// T11 — Slice
// =============================================================================
Function.Test_Slice {
    Body: {
        PrintMessage("--- Slice ---\n")
        a = Array.Create(8)

        Array.Push(a, 10)
        Array.Push(a, 20)
        Array.Push(a, 30)
        Array.Push(a, 40)
        Array.Push(a, 50)

        s = Array.Slice(a, 1, 4)
        Check("slice size = 3",  Array.Size(s),   3)
        Check("slice[0] = 20",   Array.Get(s, 0), 20)
        Check("slice[1] = 30",   Array.Get(s, 1), 30)
        Check("slice[2] = 40",   Array.Get(s, 2), 40)

        Array.Destroy(s)
        Array.Destroy(a)
    }
}

// =============================================================================
// MAIN
// =============================================================================
SubRoutine.Main {
    Arena_Init()

    PrintMessage("=== PERF_Array smoke tests ===\n")

    Test_Create()
    Test_PushGet()
    Test_PopClear()
    Test_Grow()
    Test_InsertDelete()
    Test_IndexOf()
    Test_Copy()
    Test_Extend()
    Test_Reverse()
    Test_Sort()
    Test_Slice()

    PrintMessage("\n=== Results ===\n")
    PrintMessage("PASS: ")
    PrintNumber(Suite.pass)
    PrintMessage("\nFAIL: ")
    PrintNumber(Suite.fail)
    PrintMessage("\n")
}

RunTask(Main)
