// Test.PERF_Hash.ailang — migrated to LibraryImport.Hash
RunTask(Main)

LibraryImport.Arena
LibraryImport.Hash

FixedPool.Suite {
    "pass": Initialize=0, CanChange=True
    "fail": Initialize=0, CanChange=True
}

Function.Pass {
    Input: name: Address
    Body: {
        Suite.pass = Add(Suite.pass, 1)
        PrintMessage("  [PASS] ")
        PrintMessage(name)
        PrintMessage("\n")
    }
}

Function.Fail {
    Input: name: Address
    Input: got:  Integer
    Input: exp:  Integer
    Body: {
        Suite.fail = Add(Suite.fail, 1)
        PrintMessage("  [FAIL] ")
        PrintMessage(name)
        PrintMessage(" got=")
        PrintNumber(got)
        PrintMessage(" exp=")
        PrintNumber(exp)
        PrintMessage("\n")
    }
}

SubRoutine.Main {
    Arena_Init()

    t = Hash.Create(16)

    // Set and Get
    Hash.Set(t, "foo", 42)
    v = Hash.Get(t, "foo")
    IfCondition EqualTo(v, 42) ThenBlock: { Pass("Set/Get basic") } ElseBlock: { Fail("Set/Get basic", v, 42) }

    // Missing key returns 0
    v2 = Hash.Get(t, "missing")
    IfCondition EqualTo(v2, 0) ThenBlock: { Pass("Get missing=0") } ElseBlock: { Fail("Get missing=0", v2, 0) }

    // Contains true
    c1 = Hash.Contains(t, "foo")
    IfCondition EqualTo(c1, 1) ThenBlock: { Pass("Contains existing") } ElseBlock: { Fail("Contains existing", c1, 1) }

    // Contains false
    c2 = Hash.Contains(t, "bar")
    IfCondition EqualTo(c2, 0) ThenBlock: { Pass("Contains missing") } ElseBlock: { Fail("Contains missing", c2, 0) }

    // Size
    s1 = Hash.Size(t)
    IfCondition EqualTo(s1, 1) ThenBlock: { Pass("Size=1") } ElseBlock: { Fail("Size=1", s1, 1) }

    // Multiple keys
    Hash.Set(t, "bar", 100)
    Hash.Set(t, "baz", 200)
    s2 = Hash.Size(t)
    IfCondition EqualTo(s2, 3) ThenBlock: { Pass("Size=3") } ElseBlock: { Fail("Size=3", s2, 3) }

    // Update existing key
    Hash.Set(t, "foo", 99)
    v3 = Hash.Get(t, "foo")
    IfCondition EqualTo(v3, 99) ThenBlock: { Pass("Update key") } ElseBlock: { Fail("Update key", v3, 99) }

    // Size unchanged after update
    s3 = Hash.Size(t)
    IfCondition EqualTo(s3, 3) ThenBlock: { Pass("Size after update") } ElseBlock: { Fail("Size after update", s3, 3) }

    // Delete
    d1 = Hash.Delete(t, "bar")
    IfCondition EqualTo(d1, 1) ThenBlock: { Pass("Delete returns 1") } ElseBlock: { Fail("Delete returns 1", d1, 1) }
    c3 = Hash.Contains(t, "bar")
    IfCondition EqualTo(c3, 0) ThenBlock: { Pass("Deleted key gone") } ElseBlock: { Fail("Deleted key gone", c3, 0) }
    s4 = Hash.Size(t)
    IfCondition EqualTo(s4, 2) ThenBlock: { Pass("Size after delete") } ElseBlock: { Fail("Size after delete", s4, 2) }

    // Delete missing returns 0
    d2 = Hash.Delete(t, "nope")
    IfCondition EqualTo(d2, 0) ThenBlock: { Pass("Delete missing=0") } ElseBlock: { Fail("Delete missing=0", d2, 0) }

    // IncrBy
    Hash.Set(t, "counter", 10)
    nv = Hash.IncrBy(t, "counter", 5)
    IfCondition EqualTo(nv, 15) ThenBlock: { Pass("IncrBy") } ElseBlock: { Fail("IncrBy", nv, 15) }

    // Keys returns correct count
    keys = Hash.Keys(t)
    kcount = Array.Size(keys)
    // foo, baz, counter (bar was deleted)
    IfCondition EqualTo(kcount, 3) ThenBlock: { Pass("Keys count=3") } ElseBlock: { Fail("Keys count=3", kcount, 3) }
    Array.Destroy(keys)

    // Clear
    Hash.Clear(t)
    s5 = Hash.Size(t)
    IfCondition EqualTo(s5, 0) ThenBlock: { Pass("Clear") } ElseBlock: { Fail("Clear", s5, 0) }

    // Nested ops
    nt = Hash.CreateNested()
    Hash.HSet(nt, "user1", "age", 30)
    Hash.HSet(nt, "user1", "score", 500)
    Hash.HSet(nt, "user2", "age", 25)

    hv1 = Hash.HGet(nt, "user1", "age")
    IfCondition EqualTo(hv1, 30) ThenBlock: { Pass("HGet user1.age") } ElseBlock: { Fail("HGet user1.age", hv1, 30) }

    hv2 = Hash.HGet(nt, "user1", "score")
    IfCondition EqualTo(hv2, 500) ThenBlock: { Pass("HGet user1.score") } ElseBlock: { Fail("HGet user1.score", hv2, 500) }

    hv3 = Hash.HGet(nt, "user2", "age")
    IfCondition EqualTo(hv3, 25) ThenBlock: { Pass("HGet user2.age") } ElseBlock: { Fail("HGet user2.age", hv3, 25) }

    // HGet missing key
    hv4 = Hash.HGet(nt, "user3", "age")
    IfCondition EqualTo(hv4, 0) ThenBlock: { Pass("HGet missing=0") } ElseBlock: { Fail("HGet missing=0", hv4, 0) }

    // HExists
    he1 = Hash.HExists(nt, "user1", "age")
    IfCondition EqualTo(he1, 1) ThenBlock: { Pass("HExists true") } ElseBlock: { Fail("HExists true", he1, 1) }
    he2 = Hash.HExists(nt, "user1", "nope")
    IfCondition EqualTo(he2, 0) ThenBlock: { Pass("HExists false") } ElseBlock: { Fail("HExists false", he2, 0) }

    // HLen
    hl1 = Hash.HLen(nt, "user1")
    IfCondition EqualTo(hl1, 2) ThenBlock: { Pass("HLen=2") } ElseBlock: { Fail("HLen=2", hl1, 2) }

    // HDel
    hd1 = Hash.HDel(nt, "user1", "score")
    IfCondition EqualTo(hd1, 1) ThenBlock: { Pass("HDel returns 1") } ElseBlock: { Fail("HDel returns 1", hd1, 1) }
    hl2 = Hash.HLen(nt, "user1")
    IfCondition EqualTo(hl2, 1) ThenBlock: { Pass("HLen after HDel") } ElseBlock: { Fail("HLen after HDel", hl2, 1) }

    // Hash.Destroy (flat)
    Hash.Destroy(t)

    // Hash.DestroyNested
    Hash.DestroyNested(nt)

    // Auto-resize: fill past 70% load (8-slot table, 20 inserts forces multiple resizes)
    big = Hash.Create(8)
    Hash.Set(big, "k0",  0)
    Hash.Set(big, "k1",  1)
    Hash.Set(big, "k2",  2)
    Hash.Set(big, "k3",  3)
    Hash.Set(big, "k4",  4)
    Hash.Set(big, "k5",  5)
    Hash.Set(big, "k6",  6)
    Hash.Set(big, "k7",  7)
    Hash.Set(big, "k8",  8)
    Hash.Set(big, "k9",  9)
    Hash.Set(big, "k10", 10)
    Hash.Set(big, "k11", 11)
    Hash.Set(big, "k12", 12)
    Hash.Set(big, "k13", 13)
    Hash.Set(big, "k14", 14)
    Hash.Set(big, "k15", 15)
    Hash.Set(big, "k16", 16)
    Hash.Set(big, "k17", 17)
    Hash.Set(big, "k18", 18)
    Hash.Set(big, "k19", 19)
    sv = Hash.Get(big, "k7")
    IfCondition EqualTo(sv, 7) ThenBlock: { Pass("Auto-resize survives") } ElseBlock: { Fail("Auto-resize survives", sv, 7) }
    Hash.Destroy(big)

    PrintMessage("\nHash: ")
    PrintNumber(Suite.pass)
    PrintMessage("/")
    PrintNumber(Add(Suite.pass, Suite.fail))
    PrintMessage(" passed\n")
}
