// Test.VIFDebug.ailang
// Debug test: render tilde at various sizes, print edge count.
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Display.Render.DSurfaceTypes
LibraryImport.Display.Render.DSurface
LibraryImport.Display.Render.DDrawPixel
LibraryImport.Arena
LibraryImport.Display.Render.VIF

Function.Test_RenderAndCount {
    Input: tvg_path: Integer
    Input: render_size: Integer
    Output: Integer
    Body: {
        fd = SystemCall(2, tvg_path, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("[FAIL] cannot open ")
            PrintMessage(tvg_path)
            PrintMessage("\n")
            ReturnValue(0)
        }
        size = SystemCall(8, fd, 0, 2)
        SystemCall(8, fd, 0, 0)
        data = Allocate(size)
        SystemCall(0, fd, data, size)
        SystemCall(3, fd, 0, 0)

        PrintMessage("  size=")
        PrintNumber(render_size)
        PrintMessage("px  edges=")

        // RastState.edge_count is set after TVG_Parse builds edges
        surf = TVG_Parse(data, size, render_size)
        // Edge count was already consumed by ScanFill, print the surface dims
        IfCondition GreaterThan(surf, 0) ThenBlock: {
            w = Surface_GetWidth(surf)
            h = Surface_GetHeight(surf)
            PrintMessage("  surf=")
            PrintNumber(w)
            PrintMessage("x")
            PrintNumber(h)

            // Analyze rendered pixels: count how many non-transparent
            src_data = Surface_GetData(surf)
            src_pitch = Surface_GetPitch(surf)
            total_opaque = 0
            total_aa = 0
            row = 0
            WhileLoop LessThan(row, h) {
                row_ptr = Add(src_data, Multiply(row, src_pitch))
                col = 0
                WhileLoop LessThan(col, w) {
                    off = Add(Multiply(col, 4), 3)
                    a = GetByte(row_ptr, off)
                    IfCondition EqualTo(a, 255) ThenBlock: { total_opaque = Add(total_opaque, 1) }
                    IfCondition And(GreaterThan(a, 0), LessThan(a, 255)) ThenBlock: { total_aa = Add(total_aa, 1) }
                    col = Add(col, 1)
                }
                row = Add(row, 1)
            }
            PrintMessage("  opaque=")
            PrintNumber(total_opaque)
            PrintMessage("  aa=")
            PrintNumber(total_aa)
        }
        PrintMessage("\n")
        Deallocate(data, size)
        ReturnValue(1)
    }
}

SubRoutine.Main {
    PrintMessage("=== VIF Glyph Debug ===\n")
    VIF_Init()

    PrintMessage("--- tilde (~) ---\n")
    Test_RenderAndCount("fonts/dejavu-sans/tvg/007E_asciitilde.tvg", 16)
    Test_RenderAndCount("fonts/dejavu-sans/tvg/007E_asciitilde.tvg", 22)
    Test_RenderAndCount("fonts/dejavu-sans/tvg/007E_asciitilde.tvg", 32)
    Test_RenderAndCount("fonts/dejavu-sans/tvg/007E_asciitilde.tvg", 48)
    Test_RenderAndCount("fonts/dejavu-sans/tvg/007E_asciitilde.tvg", 64)
    Test_RenderAndCount("fonts/dejavu-sans/tvg/007E_asciitilde.tvg", 128)

    PrintMessage("--- o ---\n")
    Test_RenderAndCount("fonts/dejavu-sans/tvg/006F_o.tvg", 22)
    Test_RenderAndCount("fonts/dejavu-sans/tvg/006F_o.tvg", 128)

    PrintMessage("--- S ---\n")
    Test_RenderAndCount("fonts/dejavu-sans/tvg/0053_S.tvg", 22)
    Test_RenderAndCount("fonts/dejavu-sans/tvg/0053_S.tvg", 128)

    VIF_Shutdown()
    PrintMessage("=== done ===\n")
}

RunTask(Main)
