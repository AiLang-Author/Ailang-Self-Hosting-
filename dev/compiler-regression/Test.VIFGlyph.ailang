// Test.VIFGlyph.ailang
// Render individual font glyphs at various sizes, dump raw RGBA for inspection.
// Tests bezier flattening quality on curved characters like ~, o, S, etc.
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Display.Render.DSurfaceTypes
LibraryImport.Display.Render.DSurface
LibraryImport.Display.Render.DDrawPixel
LibraryImport.Arena
LibraryImport.Display.Render.VIF

Function.Test_DumpSurface {
    Input:  surf:     Integer
    Input:  filename: Integer
    Output: Integer
    Body: {
        w = Surface_GetWidth(surf)
        h = Surface_GetHeight(surf)
        fd = SystemCall(2, filename, 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("[dump] cannot create file\n")
            ReturnValue(0)
        }
        src_data  = Surface_GetData(surf)
        src_pitch = Surface_GetPitch(surf)
        row_bytes = Multiply(w, 4)
        row_buf   = Allocate(row_bytes)
        row = 0
        WhileLoop LessThan(row, h) {
            src_row = Multiply(row, src_pitch)
            src_row = Add(src_data, src_row)
            col = 0
            WhileLoop LessThan(col, w) {
                src_off = Multiply(col, 4)
                dst_off = Multiply(col, 4)
                b = GetByte(src_row, src_off)
                t = Add(src_off, 1)
                g = GetByte(src_row, t)
                t = Add(src_off, 2)
                r = GetByte(src_row, t)
                t = Add(src_off, 3)
                a = GetByte(src_row, t)
                SetByte(row_buf, dst_off, r)
                t = Add(dst_off, 1)
                SetByte(row_buf, t, g)
                t = Add(dst_off, 2)
                SetByte(row_buf, t, b)
                t = Add(dst_off, 3)
                SetByte(row_buf, t, a)
                col = Add(col, 1)
            }
            SystemCall(1, fd, row_buf, row_bytes)
            row = Add(row, 1)
        }
        Deallocate(row_buf, row_bytes)
        SystemCall(3, fd, 0, 0)
        PrintMessage("[dump] wrote ")
        PrintMessage(filename)
        PrintMessage(" (")
        PrintNumber(w)
        PrintMessage("x")
        PrintNumber(h)
        PrintMessage(")\n")
        ReturnValue(1)
    }
}

Function.Test_RenderGlyph {
    Input: tvg_path: Integer
    Input: render_size: Integer
    Input: out_path: Integer
    Output: Integer
    Body: {
        fd = SystemCall(2, tvg_path, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("[FAIL] cannot open ")
            PrintMessage(tvg_path)
            PrintMessage("\n")
            ReturnValue(0)
        }
        size = SystemCall(8, fd, 0, 2)
        SystemCall(8, fd, 0, 0)
        data = Allocate(size)
        SystemCall(0, fd, data, size)
        SystemCall(3, fd, 0, 0)

        PrintMessage("[test] ")
        PrintMessage(tvg_path)
        PrintMessage(" @ ")
        PrintNumber(render_size)
        PrintMessage("px -> ")

        surf = TVG_Parse(data, size, render_size)
        IfCondition GreaterThan(surf, 0) ThenBlock: {
            Test_DumpSurface(surf, out_path)
        }
        IfCondition EqualTo(surf, 0) ThenBlock: {
            PrintMessage("[FAIL] render returned null\n")
        }
        Deallocate(data, size)
        ReturnValue(surf)
    }
}

SubRoutine.Main {
    PrintMessage("=== VIF Glyph Render Test ===\n")
    VIF_Init()

    // Test tilde at multiple sizes
    Test_RenderGlyph("fonts/dejavu-sans/tvg/007E_asciitilde.tvg", 22, "/tmp/tilde_22.rgba")
    Test_RenderGlyph("fonts/dejavu-sans/tvg/007E_asciitilde.tvg", 44, "/tmp/tilde_44.rgba")
    Test_RenderGlyph("fonts/dejavu-sans/tvg/007E_asciitilde.tvg", 88, "/tmp/tilde_88.rgba")
    Test_RenderGlyph("fonts/dejavu-sans/tvg/007E_asciitilde.tvg", 256, "/tmp/tilde_256.rgba")

    // Test other curved glyphs
    Test_RenderGlyph("fonts/dejavu-sans/tvg/006F_o.tvg", 22, "/tmp/o_22.rgba")
    Test_RenderGlyph("fonts/dejavu-sans/tvg/006F_o.tvg", 88, "/tmp/o_88.rgba")

    Test_RenderGlyph("fonts/dejavu-sans/tvg/0053_S.tvg", 22, "/tmp/S_22.rgba")
    Test_RenderGlyph("fonts/dejavu-sans/tvg/0053_S.tvg", 88, "/tmp/S_88.rgba")

    Test_RenderGlyph("fonts/dejavu-sans/tvg/0033_three.tvg", 22, "/tmp/three_22.rgba")
    Test_RenderGlyph("fonts/dejavu-sans/tvg/0033_three.tvg", 88, "/tmp/three_88.rgba")

    // Test at body text size
    Test_RenderGlyph("fonts/dejavu-sans/tvg/0061_a.tvg", 22, "/tmp/a_22.rgba")
    Test_RenderGlyph("fonts/dejavu-sans/tvg/0065_e.tvg", 22, "/tmp/e_22.rgba")

    VIF_Shutdown()
    PrintMessage("=== done ===\n")
}

RunTask(Main)
