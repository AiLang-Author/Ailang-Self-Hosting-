// TestBSP.ailang
// Phase 4 smoke test: BSP tree init, split, query, merge

LibraryImport.Display.Render.DComposeTypes
LibraryImport.Display.Render.DComposeBSP

SubRoutine.Main {
    PrintMessage("TestBSP: BSP compositor tests\n")

    // =========================================================
    // TEST 1: Init root leaf 1280x1024
    // =========================================================
    PrintMessage("1: init BSP 1280x1024\n")
    root = BSP_Init(1280, 1024)
    IfCondition EqualTo(root, 0) ThenBlock: {
        PrintMessage("FAIL: BSP_Init returned 0\n")
        ReturnValue(0)
    }
    PrintMessage("   root type (expect 2=LEAF): ")
    PrintNumber(BSP_GetType(root))
    PrintMessage("\n   region: ")
    PrintNumber(BSP_GetRegionX(root))
    PrintMessage(",")
    PrintNumber(BSP_GetRegionY(root))
    PrintMessage(" ")
    PrintNumber(BSP_GetRegionW(root))
    PrintMessage("x")
    PrintNumber(BSP_GetRegionH(root))
    PrintMessage("\n")

    // =========================================================
    // TEST 2: Vertical split at x=640 (left/right halves)
    // =========================================================
    PrintMessage("2: vertical split at 640\n")
    right_leaf = BSP_Split(root, BSPNodeType.SPLIT_V, 640)
    IfCondition EqualTo(right_leaf, 0) ThenBlock: {
        PrintMessage("FAIL: BSP_Split returned 0\n")
        ReturnValue(0)
    }
    PrintMessage("   root type (expect 1=SPLIT_V): ")
    PrintNumber(BSP_GetType(root))
    PrintMessage("\n   child_a region: ")
    left_leaf = BSP_GetChildA(root)
    PrintNumber(BSP_GetRegionX(left_leaf))
    PrintMessage(",")
    PrintNumber(BSP_GetRegionY(left_leaf))
    PrintMessage(" ")
    PrintNumber(BSP_GetRegionW(left_leaf))
    PrintMessage("x")
    PrintNumber(BSP_GetRegionH(left_leaf))
    PrintMessage("\n   child_b region: ")
    PrintNumber(BSP_GetRegionX(right_leaf))
    PrintMessage(",")
    PrintNumber(BSP_GetRegionY(right_leaf))
    PrintMessage(" ")
    PrintNumber(BSP_GetRegionW(right_leaf))
    PrintMessage("x")
    PrintNumber(BSP_GetRegionH(right_leaf))
    PrintMessage("\n")

    // =========================================================
    // TEST 3: Horizontal split right leaf at y=512
    // =========================================================
    PrintMessage("3: horizontal split right leaf at 512\n")
    bot_right = BSP_Split(right_leaf, BSPNodeType.SPLIT_H, 512)
    PrintMessage("   right_leaf type (expect 0=SPLIT_H): ")
    PrintNumber(BSP_GetType(right_leaf))
    PrintMessage("\n   top-right region: ")
    top_right = BSP_GetChildA(right_leaf)
    PrintNumber(BSP_GetRegionX(top_right))
    PrintMessage(",")
    PrintNumber(BSP_GetRegionY(top_right))
    PrintMessage(" ")
    PrintNumber(BSP_GetRegionW(top_right))
    PrintMessage("x")
    PrintNumber(BSP_GetRegionH(top_right))
    PrintMessage("\n   bot-right region: ")
    PrintNumber(BSP_GetRegionX(bot_right))
    PrintMessage(",")
    PrintNumber(BSP_GetRegionY(bot_right))
    PrintMessage(" ")
    PrintNumber(BSP_GetRegionW(bot_right))
    PrintMessage("x")
    PrintNumber(BSP_GetRegionH(bot_right))
    PrintMessage("\n")

    // =========================================================
    // TEST 4: Hit testing — query various points
    // =========================================================
    PrintMessage("4: hit testing\n")

    // Point in left half
    hit = BSP_Query(root, 100, 500)
    PrintMessage("   (100,500) -> leaf at ")
    PrintNumber(BSP_GetRegionX(hit))
    PrintMessage(",")
    PrintNumber(BSP_GetRegionY(hit))
    PrintMessage(" expect 0,0\n")

    // Point in top-right
    hit = BSP_Query(root, 900, 100)
    PrintMessage("   (900,100) -> leaf at ")
    PrintNumber(BSP_GetRegionX(hit))
    PrintMessage(",")
    PrintNumber(BSP_GetRegionY(hit))
    PrintMessage(" expect 640,0\n")

    // Point in bottom-right
    hit = BSP_Query(root, 900, 800)
    PrintMessage("   (900,800) -> leaf at ")
    PrintNumber(BSP_GetRegionX(hit))
    PrintMessage(",")
    PrintNumber(BSP_GetRegionY(hit))
    PrintMessage(" expect 640,512\n")

    // =========================================================
    // TEST 5: Merge right subtree back
    // =========================================================
    PrintMessage("5: merge right subtree\n")
    result = BSP_Merge(right_leaf)
    PrintMessage("   merge result (expect 1): ")
    PrintNumber(result)
    PrintMessage("\n   right_leaf type (expect 2=LEAF): ")
    PrintNumber(BSP_GetType(right_leaf))
    PrintMessage("\n")

    // Query after merge — top-right point should now hit right_leaf
    hit = BSP_Query(root, 900, 100)
    PrintMessage("   (900,100) after merge -> leaf at ")
    PrintNumber(BSP_GetRegionX(hit))
    PrintMessage(",")
    PrintNumber(BSP_GetRegionY(hit))
    PrintMessage(" expect 640,0\n")

    // =========================================================
    // TEST 6: Free tree
    // =========================================================
    PrintMessage("6: free BSP tree\n")
    BSP_Free(root)
    PrintMessage("   freed OK\n")

    PrintMessage("TestBSP: all tests done\n")
}

RunTask(Main)