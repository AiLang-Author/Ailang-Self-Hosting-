// TestFixedPointPrimitives.ailang
// Tests for FixedMul(a, b, bits) and FixedDiv(a, b, bits) compiler primitives
// Full IEEE compliance: exact division, signed arithmetic, all widths
//
// Build: ./ailang.x dev/compiler-regression/TestFixedPointPrimitives.ailang test_fp_prims.x
// Run:   ./test_fp_prims.x

LibraryImport.Arena

FixedPool.Test {
    "total_tests": Initialize=0
    "passed_tests": Initialize=0
    "failed_tests": Initialize=0
    "test_name": Initialize=0
    "expected": Initialize=0
    "actual": Initialize=0
}

SubRoutine.TestResult {
    Test.total_tests = Add(Test.total_tests, 1)
    PrintMessage("  TEST: ")
    PrintMessage(Test.test_name)
    PrintMessage("    Expected: ")
    PrintNumber(Test.expected)
    PrintMessage("    Actual:   ")
    PrintNumber(Test.actual)

    diff = Subtract(Test.expected, Test.actual)
    IfCondition LessThan(diff, 0) ThenBlock: {
        diff = Subtract(0, diff)
    }

    IfCondition EqualTo(diff, 0) ThenBlock: {
        PrintMessage("    PASS")
        Test.passed_tests = Add(Test.passed_tests, 1)
    } ElseBlock: {
        PrintMessage("    FAIL (diff=")
        PrintNumber(diff)
        PrintMessage(")")
        Test.failed_tests = Add(Test.failed_tests, 1)
    }
    PrintMessage("")
}

SubRoutine.Main {
    PrintMessage("================================================")
    PrintMessage("AILANG Fixed-Point Primitive Test Suite")
    PrintMessage("FixedMul / FixedDiv - Full IEEE Compliance")
    PrintMessage("================================================")
    PrintMessage("")

    // =============================================================================
    // SECTION 1: FixedMul Q8.8
    // =============================================================================
    PrintMessage("--- FixedMul Q8.8 (bits=8) ---")

    Test.test_name = "Q8 mul: 2.0 * 3.0 = 6.0"
    Test.expected = 1536
    Test.actual = FixedMul(512, 768, 8)
    RunTask(TestResult)

    Test.test_name = "Q8 mul: 1.5 * 2.0 = 3.0"
    Test.expected = 768
    Test.actual = FixedMul(384, 512, 8)
    RunTask(TestResult)

    Test.test_name = "Q8 mul: 0.5 * 0.5 = 0.25"
    Test.expected = 64
    Test.actual = FixedMul(128, 128, 8)
    RunTask(TestResult)

    // =============================================================================
    // SECTION 2: FixedMul Q16.16
    // =============================================================================
    PrintMessage("--- FixedMul Q16.16 (bits=16) ---")

    Test.test_name = "Q16 mul: 2.0 * 3.0 = 6.0"
    Test.expected = 393216
    Test.actual = FixedMul(131072, 196608, 16)
    RunTask(TestResult)

    Test.test_name = "Q16 mul: 1.5 * 4.0 = 6.0"
    Test.expected = 393216
    Test.actual = FixedMul(98304, 262144, 16)
    RunTask(TestResult)

    Test.test_name = "Q16 mul: 0.25 * 0.25 = 0.0625"
    Test.expected = 4096
    Test.actual = FixedMul(16384, 16384, 16)
    RunTask(TestResult)

    // =============================================================================
    // SECTION 3: FixedMul Q32.32
    // =============================================================================
    PrintMessage("--- FixedMul Q32.32 (bits=32) ---")

    Test.test_name = "Q32 mul: 2.0 * 3.0 = 6.0"
    Test.expected = 25769803776
    Test.actual = FixedMul(8589934592, 12884901888, 32)
    RunTask(TestResult)

    Test.test_name = "Q32 mul: 1.0 * 1.0 = 1.0"
    Test.expected = 4294967296
    Test.actual = FixedMul(4294967296, 4294967296, 32)
    RunTask(TestResult)

    // =============================================================================
    // SECTION 4: FixedMul Q64.64
    // =============================================================================
    PrintMessage("--- FixedMul Q64.64 (bits=64) ---")

    // 0.25 * 0.25 = 0.0625
    // 0.25 = 2^62 = 4611686018427387904
    // high64 of (2^62 * 2^62) = 2^60 = 1152921504606846976
    Test.test_name = "Q64 mul: 0.25 * 0.25 = 0.0625"
    Test.expected = 1152921504606846976
    Test.actual = FixedMul(4611686018427387904, 4611686018427387904, 64)
    RunTask(TestResult)

    // =============================================================================
    // SECTION 5: FixedDiv Q8.8 (exact with IDIV)
    // =============================================================================
    PrintMessage("--- FixedDiv Q8.8 (bits=8) ---")

    Test.test_name = "Q8 div: 6.0 / 3.0 = 2.0"
    Test.expected = 512
    Test.actual = FixedDiv(1536, 768, 8)
    RunTask(TestResult)

    Test.test_name = "Q8 div: 1.0 / 2.0 = 0.5"
    Test.expected = 128
    Test.actual = FixedDiv(256, 512, 8)
    RunTask(TestResult)

    Test.test_name = "Q8 div: 10.0 / 4.0 = 2.5"
    Test.expected = 640
    Test.actual = FixedDiv(2560, 1024, 8)
    RunTask(TestResult)

    // =============================================================================
    // SECTION 6: FixedDiv Q16.16 (exact with IDIV)
    // =============================================================================
    PrintMessage("--- FixedDiv Q16.16 (bits=16) ---")

    Test.test_name = "Q16 div: 6.0 / 2.0 = 3.0"
    Test.expected = 196608
    Test.actual = FixedDiv(393216, 131072, 16)
    RunTask(TestResult)

    Test.test_name = "Q16 div: 1.0 / 4.0 = 0.25"
    Test.expected = 16384
    Test.actual = FixedDiv(65536, 262144, 16)
    RunTask(TestResult)

    Test.test_name = "Q16 div: 7.0 / 2.0 = 3.5"
    Test.expected = 229376
    Test.actual = FixedDiv(458752, 131072, 16)
    RunTask(TestResult)

    // =============================================================================
    // SECTION 7: FixedDiv Q32.32 (exact with IDIV)
    // =============================================================================
    PrintMessage("--- FixedDiv Q32.32 (bits=32) ---")

    Test.test_name = "Q32 div: 6.0 / 3.0 = 2.0"
    Test.expected = 8589934592
    Test.actual = FixedDiv(25769803776, 12884901888, 32)
    RunTask(TestResult)

    Test.test_name = "Q32 div: 1.0 / 2.0 = 0.5"
    Test.expected = 2147483648
    Test.actual = FixedDiv(4294967296, 8589934592, 32)
    RunTask(TestResult)

    // =============================================================================
    // SECTION 8: FixedDiv Q64.64
    // =============================================================================
    PrintMessage("--- FixedDiv Q64.64 (bits=64) ---")

    // 0.25 / 0.125 = 2.0 ... but Q64 has no integer bits, so 2.0 overflows
    // Instead: (a << 64) / b where a and b are Q64 fractions
    // a = 2^61 (0.125), b = 2^62 (0.25)
    // (2^61 << 64) / 2^62 = 2^125 / 2^62 = 2^63
    // But 2^63 overflows signed. Try smaller:
    // a = 2^60 (0.0625), b = 2^62 (0.25)
    // (2^60 << 64) / 2^62 = 2^124 / 2^62 = 2^62 = 4611686018427387904
    // That's 0.25 in Q64 — correct! 0.0625 / 0.25 = 0.25
    Test.test_name = "Q64 div: 0.0625 / 0.25 = 0.25"
    Test.expected = 4611686018427387904
    Test.actual = FixedDiv(1152921504606846976, 4611686018427387904, 64)
    RunTask(TestResult)

    // =============================================================================
    // SECTION 9: Division by zero guard (all widths)
    // =============================================================================
    PrintMessage("--- Division by zero guard ---")

    Test.test_name = "Q8 div: div-by-zero = 0"
    Test.expected = 0
    Test.actual = FixedDiv(256, 0, 8)
    RunTask(TestResult)

    Test.test_name = "Q16 div: div-by-zero = 0"
    Test.expected = 0
    Test.actual = FixedDiv(65536, 0, 16)
    RunTask(TestResult)

    Test.test_name = "Q32 div: div-by-zero = 0"
    Test.expected = 0
    Test.actual = FixedDiv(4294967296, 0, 32)
    RunTask(TestResult)

    Test.test_name = "Q64 div: div-by-zero = 0"
    Test.expected = 0
    Test.actual = FixedDiv(1152921504606846976, 0, 64)
    RunTask(TestResult)

    // =============================================================================
    // SECTION 10: Negative FixedMul (all widths)
    // =============================================================================
    PrintMessage("--- Negative FixedMul ---")

    // Q8: -2.0 * 3.0 = -6.0
    Test.test_name = "Q8 mul: -2.0 * 3.0 = -6.0"
    Test.expected = -1536
    Test.actual = FixedMul(-512, 768, 8)
    RunTask(TestResult)

    // Q8: -2.0 * -3.0 = 6.0
    Test.test_name = "Q8 mul: -2.0 * -3.0 = 6.0"
    Test.expected = 1536
    Test.actual = FixedMul(-512, -768, 8)
    RunTask(TestResult)

    // Q16: -3.0 * 2.0 = -6.0
    Test.test_name = "Q16 mul: -3.0 * 2.0 = -6.0"
    Test.expected = -393216
    Test.actual = FixedMul(-196608, 131072, 16)
    RunTask(TestResult)

    // Q16: -1.5 * -4.0 = 6.0
    Test.test_name = "Q16 mul: -1.5 * -4.0 = 6.0"
    Test.expected = 393216
    Test.actual = FixedMul(-98304, -262144, 16)
    RunTask(TestResult)

    // Q32: -2.0 * 3.0 = -6.0
    Test.test_name = "Q32 mul: -2.0 * 3.0 = -6.0"
    Test.expected = -25769803776
    Test.actual = FixedMul(-8589934592, 12884901888, 32)
    RunTask(TestResult)

    // Q32: -1.0 * -1.0 = 1.0
    Test.test_name = "Q32 mul: -1.0 * -1.0 = 1.0"
    Test.expected = 4294967296
    Test.actual = FixedMul(-4294967296, -4294967296, 32)
    RunTask(TestResult)

    // =============================================================================
    // SECTION 11: Negative FixedDiv (all widths) - IEEE signed compliance
    // =============================================================================
    PrintMessage("--- Negative FixedDiv (signed IDIV) ---")

    // Q8: -6.0 / 3.0 = -2.0
    Test.test_name = "Q8 div: -6.0 / 3.0 = -2.0"
    Test.expected = -512
    Test.actual = FixedDiv(-1536, 768, 8)
    RunTask(TestResult)

    // Q8: 6.0 / -3.0 = -2.0
    Test.test_name = "Q8 div: 6.0 / -3.0 = -2.0"
    Test.expected = -512
    Test.actual = FixedDiv(1536, -768, 8)
    RunTask(TestResult)

    // Q8: -6.0 / -3.0 = 2.0
    Test.test_name = "Q8 div: -6.0 / -3.0 = 2.0"
    Test.expected = 512
    Test.actual = FixedDiv(-1536, -768, 8)
    RunTask(TestResult)

    // Q16: -6.0 / 3.0 = -2.0
    Test.test_name = "Q16 div: -6.0 / 3.0 = -2.0"
    Test.expected = -131072
    Test.actual = FixedDiv(-393216, 196608, 16)
    RunTask(TestResult)

    // Q16: 6.0 / -2.0 = -3.0
    Test.test_name = "Q16 div: 6.0 / -2.0 = -3.0"
    Test.expected = -196608
    Test.actual = FixedDiv(393216, -131072, 16)
    RunTask(TestResult)

    // Q16: -6.0 / -2.0 = 3.0
    Test.test_name = "Q16 div: -6.0 / -2.0 = 3.0"
    Test.expected = 196608
    Test.actual = FixedDiv(-393216, -131072, 16)
    RunTask(TestResult)

    // Q32: -6.0 / 3.0 = -2.0
    Test.test_name = "Q32 div: -6.0 / 3.0 = -2.0"
    Test.expected = -8589934592
    Test.actual = FixedDiv(-25769803776, 12884901888, 32)
    RunTask(TestResult)

    // Q32: -1.0 / -2.0 = 0.5
    Test.test_name = "Q32 div: -1.0 / -2.0 = 0.5"
    Test.expected = 2147483648
    Test.actual = FixedDiv(-4294967296, -8589934592, 32)
    RunTask(TestResult)

    // =============================================================================
    // FINAL SUMMARY
    // =============================================================================
    PrintMessage("================================================")
    PrintMessage("FINAL TEST SUMMARY")
    PrintMessage("================================================")
    PrintMessage("Total Tests: ")
    PrintNumber(Test.total_tests)
    PrintMessage("Passed: ")
    PrintNumber(Test.passed_tests)
    PrintMessage("Failed: ")
    PrintNumber(Test.failed_tests)

    IfCondition EqualTo(Test.failed_tests, 0) ThenBlock: {
        PrintMessage("")
        PrintMessage("=== ALL FIXED-POINT PRIMITIVE TESTS PASSED! ===")
    } ElseBlock: {
        PrintMessage("")
        PrintMessage("=== SOME TESTS FAILED ===")
    }
    PrintMessage("")
}

RunTask(Main)
