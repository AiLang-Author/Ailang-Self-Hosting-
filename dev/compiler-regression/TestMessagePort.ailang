// TestMessagePort.ailang
// Phase 8 — Message System Test Harness

LibraryImport.Arena
LibraryImport.Hash
LibraryImport.Arrays
LibraryImport.Display.Render.DRingTypes
LibraryImport.Display.Render.DRing0
LibraryImport.MessageTypes
LibraryImport.MessagePort
LibraryImport.MessageTranslate

FixedPool.T {
    "pass": Initialize=0
    "fail": Initialize=0
}

SubRoutine.Pass {
    PrintMessage(" [PASS]\n")
    T.pass = Add(T.pass, 1)
}

SubRoutine.Fail {
    PrintMessage(" [FAIL]\n")
    T.fail = Add(T.fail, 1)
}

// =============================================================================
// TEST 1: Port create, resolve, destroy
// =============================================================================
Function.Test1_PortLifecycle {
    Output: Integer
    Body: {
        PrintMessage("\n=== TEST 1: Port Lifecycle ===\n")

        pid = Port_Create(WellKnownPort.DISPLAY_SERVER, 32)

        PrintMessage("Port_Create returns nonzero")
        IfCondition NotEqual(pid, 0) ThenBlock: {
            RunTask(Pass)
        } ElseBlock: {
            RunTask(Fail)
        }

        PrintMessage("Port_Resolve finds by name_hash")
        found = Port_Resolve(WellKnownPort.DISPLAY_SERVER)
        IfCondition EqualTo(found, pid) ThenBlock: {
            RunTask(Pass)
        } ElseBlock: {
            PrintMessage(" got ")
            PrintNumber(found)
            RunTask(Fail)
        }

        PrintMessage("Port_IsEmpty on new port = 1")
        empty = Port_IsEmpty(pid)
        IfCondition EqualTo(empty, 1) ThenBlock: {
            RunTask(Pass)
        } ElseBlock: {
            RunTask(Fail)
        }

        Port_Destroy(pid)

        PrintMessage("Port_Resolve after destroy = 0")
        gone = Port_Resolve(WellKnownPort.DISPLAY_SERVER)
        IfCondition EqualTo(gone, 0) ThenBlock: {
            RunTask(Pass)
        } ElseBlock: {
            RunTask(Fail)
        }

        ReturnValue(0)
    }
}

// =============================================================================
// TEST 2: Envelope alloc, field add, field get
// NOTE: Minimal locals to avoid stack frame corruption.
// Pass/Fail checks done after all gets complete.
// =============================================================================
Function.Test2_EnvelopeFields {
    Output: Integer
    Body: {
        PrintMessage("\n=== TEST 2: Envelope + Fields ===\n")

        env = MsgEnv_Alloc(1, 2, 0, 1)
        MsgEnv_AddInt(env, 10, 800)
        MsgEnv_AddInt(env, 11, 600)
        MsgEnv_AddHandle(env, 12, 42)

        // Get all values first, check after
        w   = MsgEnv_GetInt(env, 10)
        h   = MsgEnv_GetInt(env, 11)
        tok = MsgEnv_GetHandle(env, 12)
        fc  = Env_GetFieldCount(env)

        PrintMessage("width = 800")
        IfCondition EqualTo(w, 800) ThenBlock: {
            RunTask(Pass)
        } ElseBlock: {
            PrintMessage(" got ")
            PrintNumber(w)
            RunTask(Fail)
        }

        PrintMessage("height = 600")
        IfCondition EqualTo(h, 600) ThenBlock: {
            RunTask(Pass)
        } ElseBlock: {
            PrintMessage(" got ")
            PrintNumber(h)
            RunTask(Fail)
        }

        PrintMessage("token = 42")
        IfCondition EqualTo(tok, 42) ThenBlock: {
            RunTask(Pass)
        } ElseBlock: {
            PrintMessage(" got ")
            PrintNumber(tok)
            RunTask(Fail)
        }

        PrintMessage("field_count = 3")
        IfCondition EqualTo(fc, 3) ThenBlock: {
            RunTask(Pass)
        } ElseBlock: {
            PrintMessage(" got ")
            PrintNumber(fc)
            RunTask(Fail)
        }

        MsgEnv_FreeState.env = env
        MsgEnv_Free()
        ReturnValue(0)
    }
}

// =============================================================================
// TEST 3: Send and receive — FIFO order
// Get all values before Pass/Fail checks
// =============================================================================
Function.Test3_SendReceive {
    Output: Integer
    Body: {
        PrintMessage("\n=== TEST 3: Send / Receive ===\n")

        pid = Port_Create(WellKnownPort.INPUT, 8)

        env1 = MsgEnv_Alloc(1, 2, 0, pid)
        env2 = MsgEnv_Alloc(2, 2, 0, pid)

        Port_Send(pid, env1)
        Port_Send(pid, env2)

        // Get all values first
        cnt     = Port_Count(pid)
        r1      = Port_Receive(pid)
        r1_what = Dereference(Add(r1, MsgEnvOfs.WHAT))
        r2      = Port_Receive(pid)
        r2_what = Dereference(Add(r2, MsgEnvOfs.WHAT))
        emp     = Port_IsEmpty(pid)
        r3      = Port_Receive(pid)

        // Now check
        PrintMessage("Port_Count = 2")
        IfCondition EqualTo(cnt, 2) ThenBlock: {
            RunTask(Pass)
        } ElseBlock: {
            PrintMessage(" got ")
            PrintNumber(cnt)
            RunTask(Fail)
        }

        PrintMessage("First receive what = 1")
        IfCondition EqualTo(r1_what, 1) ThenBlock: {
            RunTask(Pass)
        } ElseBlock: {
            PrintMessage(" got ")
            PrintNumber(r1_what)
            RunTask(Fail)
        }

        PrintMessage("Second receive what = 2")
        IfCondition EqualTo(r2_what, 2) ThenBlock: {
            RunTask(Pass)
        } ElseBlock: {
            PrintMessage(" got ")
            PrintNumber(r2_what)
            RunTask(Fail)
        }

        PrintMessage("Port empty after drain")
        IfCondition EqualTo(emp, 1) ThenBlock: {
            RunTask(Pass)
        } ElseBlock: {
            RunTask(Fail)
        }

        PrintMessage("Receive from empty = 0")
        IfCondition EqualTo(r3, 0) ThenBlock: {
            RunTask(Pass)
        } ElseBlock: {
            RunTask(Fail)
        }

        MsgEnv_FreeState.env = r1
        MsgEnv_Free()
        MsgEnv_FreeState.env = r2
        MsgEnv_Free()
        Port_Destroy(pid)
        ReturnValue(0)
    }
}

// =============================================================================
// TEST 4: Capacity overflow drops oldest
// =============================================================================
Function.Test4_Capacity {
    Output: Integer
    Body: {
        PrintMessage("\n=== TEST 4: Capacity / Drop Oldest ===\n")

        pid = Port_Create(WellKnownPort.DESKBAR, 3)

        e1 = MsgEnv_Alloc(1, MsgProtocol.AILANG, 0, pid)
        e2 = MsgEnv_Alloc(2, MsgProtocol.AILANG, 0, pid)
        e3 = MsgEnv_Alloc(3, MsgProtocol.AILANG, 0, pid)
        e4 = MsgEnv_Alloc(4, MsgProtocol.AILANG, 0, pid)

        Port_Send(pid, e1)
        Port_Send(pid, e2)
        Port_Send(pid, e3)
        Port_Send(pid, e4)

        cnt = Port_Count(pid)

        PrintMessage("Count <= 4 after 4 sends into cap-3")
        IfCondition LessThan(cnt, 5) ThenBlock: {
            RunTask(Pass)
        } ElseBlock: {
            PrintMessage(" got ")
            PrintNumber(cnt)
            RunTask(Fail)
        }

        Port_Destroy(pid)
        ReturnValue(0)
    }
}

// =============================================================================
// MAIN
// =============================================================================
SubRoutine.Main {
    Arena_Init()
    Port_Init()
    MsgTranslate_Init()

    PrintMessage("============================\n")
    PrintMessage("TestMessagePort Phase 8\n")
    PrintMessage("============================\n")

    Test1_PortLifecycle()
    Test2_EnvelopeFields()
    Test3_SendReceive()
    Test4_Capacity()

    PrintMessage("\n============================\n")
    PrintMessage("Results: ")
    PrintNumber(T.pass)
    PrintMessage(" passed, ")
    PrintNumber(T.fail)
    PrintMessage(" failed\n")
    PrintMessage("============================\n")

    Exit(0)
}

RunTask(Main)