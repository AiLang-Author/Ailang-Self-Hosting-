// Broken blocks. Each function is valid AILANG with one ownership bug.
// Not a runtime test. Main only marks the functions as called.

// expect: MEM-LEAK
Function.ForgottenScratch {
    Body: {
        buf = Allocate(64)
        SetByte(buf, 0, 65)
        ReturnValue(0)
    }
}

// expect: MEM-DROP
Function.ClobberScratch {
    Body: {
        buf = Allocate(32)
        SetByte(buf, 0, 65)
        buf = Allocate(32)
        SetByte(buf, 0, 66)
        Deallocate(buf, 32)
        ReturnValue(0)
    }
}

// expect: MEM-UAF
Function.UseAfterClose {
    Body: {
        buf = Allocate(16)
        SetByte(buf, 0, 65)
        Deallocate(buf, 16)
        n = GetByte(buf, 0)
        ReturnValue(n)
    }
}

// expect: MEM-DOUBLE
// expect: MEM-UAF
Function.CloseTwice {
    Body: {
        buf = Allocate(16)
        Deallocate(buf, 16)
        Deallocate(buf, 16)
        ReturnValue(0)
    }
}

// expect: MEM-SIZE
Function.ShortFree {
    Body: {
        buf = Allocate(64)
        SetByte(buf, 0, 65)
        Deallocate(buf, 32)
        ReturnValue(0)
    }
}

// expect: MEM-DISCARD
Function.IgnoredBlock {
    Body: {
        Allocate(128)
        ReturnValue(0)
    }
}

// expect: MEM-BOTH
// expect: MEM-UAF
Function.HandBackClosed {
    Output: Address
    Body: {
        buf = Allocate(16)
        Deallocate(buf, 16)
        ReturnValue(buf)
    }
}

// expect: quiet
Function.MakeBlock {
    Output: Address
    Body: {
        block = Allocate(16)
        ReturnValue(block)
    }
}

// expect: quiet
Function.Release {
    Input: ptr: Address
    Body: {
        Deallocate(ptr, 16)
        ReturnValue(0)
    }
}

// expect: MEM-LEAK
Function.ForgetMade {
    Body: {
        block = MakeBlock()
        SetByte(block, 0, 65)
        ReturnValue(0)
    }
}

// expect: MEM-UAF
Function.TouchAfterRelease {
    Body: {
        block = MakeBlock()
        SetByte(block, 0, 65)
        Release(block)
        SetByte(block, 0, 66)
        ReturnValue(0)
    }
}

// The second free is also a use of the name Release already freed.
// expect: MEM-DOUBLE
// expect: MEM-UAF
Function.CloseAndRelease {
    Body: {
        buf = Allocate(16)
        SetByte(buf, 0, 65)
        Release(buf)
        Deallocate(buf, 16)
        ReturnValue(0)
    }
}

// The copy is the same block. Freeing buf and then writing copy is a
// use-after-free.
// expect: MEM-UAF
Function.AliasUse {
    Body: {
        buf = Allocate(16)
        copy = buf
        SetByte(buf, 0, 65)
        Deallocate(buf, 16)
        SetByte(copy, 0, 66)
        ReturnValue(0)
    }
}

// Freed under the other name. That releases the block.
// expect: quiet
Function.AliasFree {
    Body: {
        buf = Allocate(16)
        copy = buf
        Deallocate(copy, 16)
        ReturnValue(0)
    }
}

// 8 bytes freed as Add(4, 12), which is 16.
// expect: MEM-SIZE
Function.ComputedSize {
    Body: {
        buf = Allocate(8)
        SetByte(buf, 0, 65)
        wide = Add(4, 12)
        Deallocate(buf, wide)
        ReturnValue(0)
    }
}

// Frees buf, then allocates it, once per trip. The first free is unowned.
// The free is before the allocate, so it does not cover the last block.
// expect: MEM-FREE
// expect: MEM-LEAK
// expect: MEM-LOOP
Function.FreeThenFill {
    Body: {
        buf = 0
        i = 0
        WhileLoop LessThan(i, 2) {
            Deallocate(buf, 8)
            buf = Allocate(8)
            SetByte(buf, 0, 65)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// expect: quiet
SubRoutine.Main {
    ForgottenScratch()
    ClobberScratch()
    UseAfterClose()
    CloseTwice()
    ShortFree()
    IgnoredBlock()
    HandBackClosed()
    ForgetMade()
    TouchAfterRelease()
    CloseAndRelease()
    AliasUse()
    AliasFree()
    ComputedSize()
    FreeThenFill()
    HaltProgram()
}

RunTask(Main)
