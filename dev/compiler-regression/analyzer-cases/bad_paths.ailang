// Broken control flow. Valid AILANG. Each function keeps one path or loop bug.
// Not a runtime test.

// expect: MEM-PATH
Function.CloseOnSunday {
    Body: {
        buf = Allocate(32)
        SetByte(buf, 0, 65)
        IfCondition EqualTo(1, 0) ThenBlock: {
            Deallocate(buf, 32)
        }
        ReturnValue(0)
    }
}

// expect: MEM-PATH
Function.OpenOnSunday {
    Body: {
        IfCondition EqualTo(1, 0) ThenBlock: {
            buf = Allocate(32)
            SetByte(buf, 0, 65)
        }
        ReturnValue(0)
    }
}

// expect: MEM-PATH
// expect: MEM-FREE
Function.CloseAfterMaybe {
    Body: {
        IfCondition EqualTo(1, 0) ThenBlock: {
            buf = Allocate(32)
            SetByte(buf, 0, 65)
        }
        Deallocate(buf, 32)
        ReturnValue(0)
    }
}

// expect: MEM-SIZE
Function.DifferentSizes {
    Body: {
        IfCondition EqualTo(1, 0) ThenBlock: {
            buf = Allocate(8)
        } ElseBlock: {
            buf = Allocate(32)
        }
        SetByte(buf, 0, 65)
        Deallocate(buf, 8)
        ReturnValue(0)
    }
}

// expect: MEM-KIND
Function.BytesAsArray {
    Body: {
        buf = Allocate(16)
        SetByte(buf, 0, 65)
        ArrayDestroy(buf)
        ReturnValue(0)
    }
}

// expect: MEM-KIND
Function.ArrayThenBytes {
    Body: {
        hold = ArrayCreate(4)
        Deallocate(hold, 32)
        ReturnValue(0)
    }
}

// expect: MEM-LOOP
Function.LineInLoop {
    Body: {
        i = 0
        WhileLoop LessThan(i, 4) {
            msg = StringConcat("row", "x")
            PrintMessage(msg)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// tmp is allocated on every trip and never freed.
// expect: MEM-LOOP
// expect: MEM-LEAK
Function.ScratchEachItem {
    Body: {
        items = Allocate(8)
        ForEvery item in items {
            tmp = Allocate(4)
            SetByte(tmp, 0, item)
        }
        Deallocate(items, 8)
        ReturnValue(0)
    }
}

// expect: MEM-REPEAT
Function.FreeOuterInLoop {
    Body: {
        buf = Allocate(16)
        SetByte(buf, 0, 65)
        i = 0
        WhileLoop LessThan(i, 3) {
            Deallocate(buf, 16)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// expect: MEM-ARENA
Function.FreeLine {
    Body: {
        msg = StringConcat("a", "b")
        PrintMessage(msg)
        Deallocate(msg, 8)
        ReturnValue(0)
    }
}

// expect: MEM-ARENA
Function.BareLine {
    Body: {
        StringConcat("a", "b")
        ReturnValue(0)
    }
}

// expect: MEM-FREE
Function.FreeUnknown {
    Body: {
        Deallocate(ghost, 16)
        ReturnValue(0)
    }
}

// Inner arm frees on one side only, so the outer join never sees a sure free.
// The else arm did not run the inner free, so it is not a second free.
// expect: MEM-PATH
Function.NestedOneSide {
    Body: {
        buf = Allocate(16)
        SetByte(buf, 0, 65)
        IfCondition EqualTo(1, 0) ThenBlock: {
            IfCondition EqualTo(1, 0) ThenBlock: {
                Deallocate(buf, 16)
            }
        } ElseBlock: {
            Deallocate(buf, 16)
        }
        ReturnValue(0)
    }
}

// Fork is a branch. A free that falls through is still one-sided.
// expect: MEM-PATH
// expect: MEM-UAF
Function.ForkFall {
    Body: {
        buf = Allocate(8)
        Fork EqualTo(1, 0) TrueBlock: {
            Deallocate(buf, 8)
        } FalseBlock: {
        }
        SetByte(buf, 0, 65)
        ReturnValue(0)
    }
}

// Returning without the block does not make the alloc disappear.
// expect: MEM-PATH
Function.DropOnReturn {
    Body: {
        IfCondition EqualTo(1, 0) ThenBlock: {
            buf = Allocate(8)
            ReturnValue(0)
        }
        ReturnValue(0)
    }
}

// expect: quiet
SubRoutine.Main {
    CloseOnSunday()
    OpenOnSunday()
    CloseAfterMaybe()
    DifferentSizes()
    BytesAsArray()
    ArrayThenBytes()
    LineInLoop()
    ScratchEachItem()
    FreeOuterInLoop()
    FreeLine()
    BareLine()
    FreeUnknown()
    NestedOneSide()
    ForkFall()
    DropOnReturn()
    HaltProgram()
}

RunTask(Main)
