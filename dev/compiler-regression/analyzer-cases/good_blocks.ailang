// Correct ownership. The analyzer should report no MEM- code in here.
// Not a runtime test.

// expect: quiet
Function.MatchedClose {
    Body: {
        buf = Allocate(64)
        SetByte(buf, 0, 65)
        n = GetByte(buf, 0)
        Deallocate(buf, 64)
        ReturnValue(n)
    }
}

// expect: quiet
Function.ReplaceClean {
    Body: {
        buf = Allocate(32)
        SetByte(buf, 0, 65)
        Deallocate(buf, 32)
        buf = Allocate(64)
        SetByte(buf, 0, 66)
        Deallocate(buf, 64)
        ReturnValue(0)
    }
}

// expect: quiet
Function.TwoBuffers {
    Body: {
        left = Allocate(16)
        right = Allocate(16)
        SetByte(left, 0, 65)
        SetByte(right, 0, 66)
        Deallocate(left, 16)
        Deallocate(right, 16)
        ReturnValue(0)
    }
}

// expect: quiet
Function.BothArms {
    Body: {
        buf = Allocate(16)
        SetByte(buf, 0, 65)
        IfCondition EqualTo(1, 0) ThenBlock: {
            Deallocate(buf, 16)
        } ElseBlock: {
            Deallocate(buf, 16)
        }
        ReturnValue(0)
    }
}

// expect: quiet
Function.LoopPair {
    Body: {
        i = 0
        WhileLoop LessThan(i, 4) {
            tmp = Allocate(8)
            SetByte(tmp, 0, 65)
            Deallocate(tmp, 8)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// expect: quiet
Function.HoldAcrossLoop {
    Body: {
        buf = Allocate(8)
        i = 0
        WhileLoop LessThan(i, 4) {
            SetByte(buf, 0, 65)
            i = Add(i, 1)
        }
        Deallocate(buf, 8)
        ReturnValue(0)
    }
}

// expect: quiet
Function.MakeBlock {
    Output: Address
    Body: {
        block = Allocate(16)
        ReturnValue(block)
    }
}

// expect: quiet
Function.Release {
    Input: ptr: Address
    Body: {
        Deallocate(ptr, 16)
        ReturnValue(0)
    }
}

// expect: quiet
Function.GiveAndRelease {
    Body: {
        block = MakeBlock()
        SetByte(block, 0, 65)
        Release(block)
        ReturnValue(0)
    }
}

// expect: quiet
Function.StoredLine {
    Body: {
        msg = StringConcat("hello", "there")
        PrintMessage(msg)
        ReturnValue(0)
    }
}

// expect: quiet
Function.PassedLine {
    Body: {
        PrintMessage(StringConcat("hello", "there"))
        ReturnValue(0)
    }
}

// expect: quiet
Function.StoredNumber {
    Body: {
        text = NumberToString(16)
        PrintMessage(text)
        ReturnValue(0)
    }
}

// expect: quiet
Function.SameSizeArms {
    Body: {
        IfCondition EqualTo(1, 0) ThenBlock: {
            buf = Allocate(16)
        } ElseBlock: {
            buf = Allocate(16)
        }
        SetByte(buf, 0, 65)
        Deallocate(buf, 16)
        ReturnValue(0)
    }
}

// expect: quiet
Function.ItemScratch {
    Body: {
        items = Allocate(8)
        ForEvery item in items {
            tmp = Allocate(4)
            SetByte(tmp, 0, item)
            Deallocate(tmp, 4)
        }
        Deallocate(items, 8)
        ReturnValue(0)
    }
}

// expect: quiet
Function.ArrayRoundTrip {
    Body: {
        hold = ArrayCreate(4)
        ArrayDestroy(hold)
        ReturnValue(0)
    }
}

// expect: quiet
Function.ArenaRoundTrip {
    Body: {
        buf = Arena_Alloc(32)
        SetByte(buf, 0, 65)
        Arena_Free(buf, 32)
        ReturnValue(0)
    }
}

// expect: quiet
Function.HalfInside {
    Body: {
        IfCondition EqualTo(1, 0) ThenBlock: {
            buf = Allocate(16)
            SetByte(buf, 0, 65)
            Deallocate(buf, 16)
        }
        ReturnValue(0)
    }
}

// The size is a name, not a literal. Both sides use that same name.
// expect: quiet
Function.SizeFromName {
    Body: {
        n = 16
        buf = Allocate(n)
        SetByte(buf, 0, 65)
        Deallocate(buf, n)
        ReturnValue(0)
    }
}

// expect: quiet
Function.NestedBoth {
    Body: {
        buf = Allocate(16)
        SetByte(buf, 0, 65)
        IfCondition EqualTo(1, 0) ThenBlock: {
            IfCondition EqualTo(1, 0) ThenBlock: {
                Deallocate(buf, 16)
            } ElseBlock: {
                Deallocate(buf, 16)
            }
        } ElseBlock: {
            Deallocate(buf, 16)
        }
        ReturnValue(0)
    }
}

// expect: quiet
Function.ReturnFresh {
    Output: Address
    Body: {
        buf = Allocate(16)
        SetByte(buf, 0, 65)
        ReturnValue(buf)
    }
}

// expect: quiet
SubRoutine.Main {
    MatchedClose()
    ReplaceClean()
    TwoBuffers()
    BothArms()
    LoopPair()
    HoldAcrossLoop()
    GiveAndRelease()
    StoredLine()
    PassedLine()
    StoredNumber()
    SameSizeArms()
    ItemScratch()
    ArrayRoundTrip()
    ArenaRoundTrip()
    HalfInside()
    SizeFromName()
    NestedBoth()
    ReturnFresh()
    HaltProgram()
}

RunTask(Main)
