FixedPool.DemoSys {
    "SYS_EXIT": Initialize=60
}

// Correct, but the checker is name-based and walks each body once.
// These stay out of the quiet file so a flag here is visible and not a
// regression of the straight cases. Not a runtime test.

// Failure frees the block and returns. Success hands it back.
// Those paths do not overlap.
// expect: quiet
Function.FailOrGive {
    Output: Address
    Body: {
        buf = Allocate(16)
        SetByte(buf, 0, 65)
        IfCondition EqualTo(1, 0) ThenBlock: {
            Deallocate(buf, 16)
            ReturnValue(0)
        }
        ReturnValue(buf)
    }
}

// Each trip frees the previous block and allocates the next one.
// The free after the loop releases the last block. Zero trips still frees
// the first block.
// expect: edge
Function.ReallocEachTrip {
    Body: {
        buf = Allocate(8)
        SetByte(buf, 0, 65)
        i = 0
        WhileLoop LessThan(i, 3) {
            Deallocate(buf, 8)
            buf = Allocate(8)
            SetByte(buf, 0, 66)
            i = Add(i, 1)
        }
        Deallocate(buf, 8)
        ReturnValue(0)
    }
}

// Both arms allocate, both arms free, then the name is used for a new block.
// expect: edge
Function.RefreshOnBoth {
    Body: {
        IfCondition EqualTo(1, 0) ThenBlock: {
            buf = Allocate(16)
            SetByte(buf, 0, 65)
            Deallocate(buf, 16)
        } ElseBlock: {
            buf = Allocate(16)
            SetByte(buf, 0, 66)
            Deallocate(buf, 16)
        }
        buf = Allocate(16)
        SetByte(buf, 0, 67)
        Deallocate(buf, 16)
        ReturnValue(0)
    }
}

// Failure arm of a Fork frees and returns. The other path frees once.
// expect: quiet
Function.ForkRelease {
    Body: {
        target = Allocate(24)
        Fork EqualTo(1, 0) TrueBlock: {
            Deallocate(target, 24)
            ReturnValue(0)
        } FalseBlock: {
        }
        Deallocate(target, 24)
        ReturnValue(0)
    }
}

// The short-read arm frees and halts. The later use is the other path.
// expect: quiet
Function.HaltRelease {
    Body: {
        buf = Allocate(8)
        IfCondition EqualTo(1, 0) ThenBlock: {
            Deallocate(buf, 8)
            HaltProgram()
        }
        SetByte(buf, 0, 65)
        Deallocate(buf, 8)
        ReturnValue(0)
    }
}

// SystemCall 60 ends the arm the same way HaltProgram does.
// expect: quiet
Function.ExitRelease {
    Body: {
        buf = Allocate(8)
        IfCondition EqualTo(1, 0) ThenBlock: {
            Deallocate(buf, 8)
            SystemCall(60, 1)
        }
        SetByte(buf, 0, 65)
        Deallocate(buf, 8)
        ReturnValue(0)
    }
}

// A loop counter is not a one-trip constant. Size 0 is not compared to it.
// expect: quiet
Function.CounterSize {
    Body: {
        file_len = 0
        pos = 0
        WhileLoop LessThan(pos, 4) {
            file_len = Add(file_len, 1)
            pos = Add(pos, 1)
        }
        filename = Allocate(Add(file_len, 1))
        Deallocate(filename, 0)
        ReturnValue(0)
    }
}

// Nothing to free when the pointer is 0.
// expect: quiet
Function.FreeIfLive {
    Body: {
        filename = Allocate(8)
        IfCondition EqualTo(filename, 0) ThenBlock: {
            PrintNumber(0)
        } ElseBlock: {
            Deallocate(filename, 8)
        }
        ReturnValue(0)
    }
}

// expect: quiet
Function.FreeIfSet {
    Body: {
        buf = Allocate(8)
        IfCondition NotEqual(buf, 0) ThenBlock: {
            Deallocate(buf, 8)
        }
        ReturnValue(0)
    }
}

// The block is returned, so the next iteration does not run.
// expect: quiet
Function.HandBack {
    Output: Address
    Body: {
        i = 0
        WhileLoop LessThan(i, 4) {
            buf = Allocate(8)
            ReturnValue(buf)
        }
        ReturnValue(0)
    }
}

// Each arm returns its own block.
// expect: quiet
Function.EitherBlock {
    Output: Address
    Body: {
        IfCondition EqualTo(1, 0) ThenBlock: {
            empty = Allocate(1)
            ReturnValue(empty)
        }
        buf = Allocate(8)
        ReturnValue(buf)
    }
}

// The block exists only in the arm that exits.
// expect: quiet
Function.ChildOnly {
    Body: {
        IfCondition EqualTo(1, 0) ThenBlock: {
            argv = Allocate(24)
            SystemCall(60, 1)
        }
        ReturnValue(0)
    }
}

// expect: quiet
Function.MemberExit {
    Body: {
        IfCondition EqualTo(1, 0) ThenBlock: {
            argv = Allocate(24)
            SystemCall(DemoSys.SYS_EXIT, 1)
        }
        ReturnValue(0)
    }
}

// expect: edge
SubRoutine.Main {
    FailOrGive()
    ReallocEachTrip()
    RefreshOnBoth()
    ForkRelease()
    HaltRelease()
    ExitRelease()
    CounterSize()
    FreeIfLive()
    FreeIfSet()
    HandBack()
    EitherBlock()
    ChildOnly()
    MemberExit()
    HaltProgram()
}

RunTask(Main)
