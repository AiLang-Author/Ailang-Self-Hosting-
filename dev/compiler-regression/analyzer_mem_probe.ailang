// Memory-analysis probe. The analyzer should flag every function here
// except Clean. This file is not a runtime test.

Function.Clean {
    Body: {
        buf = Allocate(16)
        SetByte(buf, 0, 65)
        Deallocate(buf, 16)
        ReturnValue(0)
    }
}

Function.Leaks {
    Body: {
        buf = Allocate(16)
        ReturnValue(0)
    }
}

Function.Drops {
    Body: {
        buf = Allocate(8)
        buf = Allocate(8)
        Deallocate(buf, 8)
        ReturnValue(0)
    }
}

Function.UsesFreed {
    Output: Integer
    Body: {
        buf = Allocate(8)
        Deallocate(buf, 8)
        n = GetByte(buf, 0)
        ReturnValue(n)
    }
}

Function.FreesTwice {
    Body: {
        buf = Allocate(8)
        Deallocate(buf, 8)
        Deallocate(buf, 8)
        ReturnValue(0)
    }
}

Function.ReturnsFreed {
    Output: Integer
    Body: {
        buf = Allocate(8)
        Deallocate(buf, 8)
        ReturnValue(buf)
    }
}

Function.Discards {
    Body: {
        Allocate(32)
        ReturnValue(0)
    }
}

Function.LoopLeak {
    Body: {
        i = 0
        WhileLoop LessThan(i, 4) {
            tmp = Allocate(8)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.ArrayLeak {
    Body: {
        hold = ArrayCreate(4)
        ReturnValue(0)
    }
}

Function.WrongSize {
    Body: {
        buf = Allocate(8)
        Deallocate(buf, 16)
        ReturnValue(0)
    }
}

Function.RightSize {
    Body: {
        buf = Allocate(8)
        Deallocate(buf, 8)
        ReturnValue(0)
    }
}

Function.OneSide {
    Body: {
        buf = Allocate(8)
        IfCondition EqualTo(1, 0) ThenBlock: {
            Deallocate(buf, 8)
        }
        ReturnValue(0)
    }
}

Function.BothSides {
    Body: {
        buf = Allocate(8)
        IfCondition EqualTo(1, 0) ThenBlock: {
            Deallocate(buf, 8)
        } ElseBlock: {
            Deallocate(buf, 8)
        }
        ReturnValue(0)
    }
}

Function.FreeAfterSide {
    Body: {
        buf = Allocate(8)
        IfCondition EqualTo(1, 0) ThenBlock: {
            Deallocate(buf, 8)
        }
        Deallocate(buf, 8)
        ReturnValue(0)
    }
}

Function.UseAfterSide {
    Body: {
        buf = Allocate(8)
        IfCondition EqualTo(1, 0) ThenBlock: {
            Deallocate(buf, 8)
        }
        SetByte(buf, 0, 65)
        ReturnValue(0)
    }
}

Function.BareConcat {
    Body: {
        StringConcat("a", "b")
        ReturnValue(0)
    }
}

Function.StoredConcat {
    Body: {
        msg = StringConcat("a", "b")
        PrintMessage(msg)
        ReturnValue(0)
    }
}

Function.PassedConcat {
    Body: {
        PrintMessage(StringConcat("a", "b"))
        ReturnValue(0)
    }
}

Function.Takes {
    Input: ptr: Address
    Body: {
        Deallocate(ptr, 8)
    }
}

Function.Gives {
    Output: Address
    Body: {
        block = Allocate(8)
        ReturnValue(block)
    }
}

Function.UsesGiveTake {
    Body: {
        block = Gives()
        Takes(block)
        ReturnValue(0)
    }
}

Function.LeaksGive {
    Body: {
        block = Gives()
        ReturnValue(0)
    }
}

Function.UseAfterTake {
    Body: {
        block = Gives()
        Takes(block)
        SetByte(block, 0, 65)
        ReturnValue(0)
    }
}

Function.ForLeak {
    Body: {
        items = Allocate(8)
        ForEvery item in items {
            tmp = Allocate(4)
        }
        Deallocate(items, 8)
        ReturnValue(0)
    }
}

Function.HalfAlloc {
    Body: {
        IfCondition EqualTo(1, 0) ThenBlock: {
            buf = Allocate(8)
        }
        ReturnValue(0)
    }
}

Function.HalfAllocFree {
    Body: {
        IfCondition EqualTo(1, 0) ThenBlock: {
            buf = Allocate(8)
            Deallocate(buf, 8)
        }
        ReturnValue(0)
    }
}

Function.HalfFree {
    Body: {
        IfCondition EqualTo(1, 0) ThenBlock: {
            buf = Allocate(8)
        }
        Deallocate(buf, 8)
        ReturnValue(0)
    }
}

Function.BothAlloc {
    Body: {
        IfCondition EqualTo(1, 0) ThenBlock: {
            buf = Allocate(8)
        } ElseBlock: {
            buf = Allocate(16)
        }
        Deallocate(buf, 8)
        ReturnValue(0)
    }
}

Function.KindMix {
    Body: {
        buf = Allocate(8)
        ArrayDestroy(buf)
        ReturnValue(0)
    }
}

Function.ArrayClean {
    Body: {
        hold = ArrayCreate(4)
        ArrayDestroy(hold)
        ReturnValue(0)
    }
}

Function.ArenaFree {
    Body: {
        msg = StringConcat("a", "b")
        Deallocate(msg, 8)
        ReturnValue(0)
    }
}

Function.FreeGhost {
    Body: {
        Deallocate(ghost, 8)
        ReturnValue(0)
    }
}

Function.SpinFree {
    Body: {
        buf = Allocate(8)
        i = 0
        WhileLoop LessThan(i, 2) {
            Deallocate(buf, 8)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

SubRoutine.Main {
    HaltProgram()
}

RunTask(Main)
