// arena_only_test.ailang
// Test Arena functions directly WITHOUT XArrays library
// This will tell us if Arena itself works

LibraryImport.Arena

PrintMessage("=== Arena Direct Test ===\n\n")

PrintMessage("Step 1: Arena_Init\n")
Arena_Init()
PrintMessage("  OK\n")

PrintMessage("Step 2: Arena_Alloc24\n")
ptr1 = Arena_Alloc24()
PrintMessage("  ptr1 = ")
PrintNumber(ptr1)
PrintMessage("\n")

PrintMessage("Step 3: Write to ptr1\n")
StoreValue(ptr1, 12345)
PrintMessage("  Wrote 12345\n")

PrintMessage("Step 4: Read from ptr1\n")
val1 = Dereference(ptr1)
PrintMessage("  Read: ")
PrintNumber(val1)
PrintMessage("\n")

PrintMessage("Step 5: Arena_Alloc24 again\n")
ptr2 = Arena_Alloc24()
PrintMessage("  ptr2 = ")
PrintNumber(ptr2)
PrintMessage("\n")

PrintMessage("Step 6: Verify ptr1 != ptr2\n")
IfCondition NotEqual(ptr1, ptr2) ThenBlock: {
    PrintMessage("  OK - different addresses\n")
} ElseBlock: {
    PrintMessage("  FAIL - same address!\n")
}

PrintMessage("Step 7: Arena_Alloc32\n")
ptr3 = Arena_Alloc32()
PrintMessage("  ptr3 = ")
PrintNumber(ptr3)
PrintMessage("\n")

PrintMessage("Step 8: Arena_Alloc64\n")
ptr4 = Arena_Alloc64()
PrintMessage("  ptr4 = ")
PrintNumber(ptr4)
PrintMessage("\n")

PrintMessage("Step 9: Arena_Free24(ptr1)\n")
Arena_Free24(ptr1)
PrintMessage("  OK\n")

PrintMessage("Step 10: Arena_Alloc24 after free\n")
ptr5 = Arena_Alloc24()
PrintMessage("  ptr5 = ")
PrintNumber(ptr5)
PrintMessage("\n")

PrintMessage("Step 11: Check if ptr5 == ptr1 (reuse)\n")
IfCondition EqualTo(ptr5, ptr1) ThenBlock: {
    PrintMessage("  OK - free list reuse working\n")
} ElseBlock: {
    PrintMessage("  Different address (bump allocation)\n")
}

PrintMessage("\n=== Arena Direct Test PASSED ===\n\n")

Arena_Report()