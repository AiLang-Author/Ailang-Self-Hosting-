// calc_test.ailang
// Calculator test client — sends JSON calc requests via broker,
// validates JSON responses. Proves the full messaging pipeline.
//
// Build: ./ailang.x Testcode/calc_test.ailang calc_test.x
// Run:   ./calc_test.x  (after msg_broker.x and calc_service.x)

LibraryImport.Arena
LibraryImport.Socket
LibraryImport.StringUtils
LibraryImport.JSON
LibraryImport.Arrays
LibraryImport.Hash

SubRoutine.Main {
    Arena_Init()

    PrintMessage("============================================\n")
    PrintMessage("  Calculator Test — Message Pipeline\n")
    PrintMessage("============================================\n\n")

    sock_path = "/tmp/ailang_broker.sock"
    pass_count = 0
    fail_count = 0

    // Connect to broker
    sock = Socket.Create(1, 1)
    IfCondition LessThan(sock, 0) ThenBlock: {
        PrintMessage("[Test] Socket create failed\n")
        HaltProgram
    }

    cres = Socket.ConnectUnix(sock, sock_path)
    IfCondition LessThan(cres, 0) ThenBlock: {
        PrintMessage("[Test] Connect failed — is broker running?\n")
        Socket.Close(sock)
        HaltProgram
    }
    PrintMessage("[Test] Connected to broker\n\n")

    // =========================================================================
    // TEST 1: CLEAR
    // =========================================================================
    PrintMessage("[Test] TEST 1: Clear\n")
    Socket.SendMsg(sock, "{\"method\":\"clear\"}")
    r1 = Socket.RecvMsg(sock)
    IfCondition NotEqual(r1, 0) ThenBlock: {
        p1 = ParseJSON(r1)
        o1 = JSON.AsObject(p1)
        d1 = JSON.GetString(o1, "display")
        c1 = StringCompare(d1, "0")
        IfCondition EqualTo(c1, 0) ThenBlock: {
            PrintMessage("[Test] PASS — display=\"0\"\n\n")
            pass_count = Add(pass_count, 1)
        } ElseBlock: {
            PrintMessage("[Test] FAIL — got \"")
            PrintString(d1)
            PrintMessage("\"\n\n")
            fail_count = Add(fail_count, 1)
        }
        JSON.Free(p1)
    } ElseBlock: {
        PrintMessage("[Test] FAIL — no response\n\n")
        fail_count = Add(fail_count, 1)
    }

    // =========================================================================
    // TEST 2: DIGIT ENTRY — 4, 2 = "42"
    // =========================================================================
    PrintMessage("[Test] TEST 2: Digit entry (42)\n")
    Socket.SendMsg(sock, "{\"method\":\"clear\"}")
    Socket.RecvMsg(sock)

    Socket.SendMsg(sock, "{\"method\":\"digit\",\"value\":4}")
    Socket.RecvMsg(sock)

    Socket.SendMsg(sock, "{\"method\":\"digit\",\"value\":2}")
    r2 = Socket.RecvMsg(sock)
    IfCondition NotEqual(r2, 0) ThenBlock: {
        p2 = ParseJSON(r2)
        o2 = JSON.AsObject(p2)
        d2 = JSON.GetString(o2, "display")
        c2 = StringCompare(d2, "42")
        IfCondition EqualTo(c2, 0) ThenBlock: {
            PrintMessage("[Test] PASS — display=\"42\"\n\n")
            pass_count = Add(pass_count, 1)
        } ElseBlock: {
            PrintMessage("[Test] FAIL — got \"")
            PrintString(d2)
            PrintMessage("\"\n\n")
            fail_count = Add(fail_count, 1)
        }
        JSON.Free(p2)
    } ElseBlock: {
        PrintMessage("[Test] FAIL — no response\n\n")
        fail_count = Add(fail_count, 1)
    }

    // =========================================================================
    // TEST 3: ADD — 25 + 17 = 42
    // =========================================================================
    PrintMessage("[Test] TEST 3: Addition (25 + 17 = 42)\n")
    Socket.SendMsg(sock, "{\"method\":\"clear\"}")
    Socket.RecvMsg(sock)

    Socket.SendMsg(sock, "{\"method\":\"digit\",\"value\":2}")
    Socket.RecvMsg(sock)
    Socket.SendMsg(sock, "{\"method\":\"digit\",\"value\":5}")
    Socket.RecvMsg(sock)
    Socket.SendMsg(sock, "{\"method\":\"operator\",\"op\":1}")
    Socket.RecvMsg(sock)
    Socket.SendMsg(sock, "{\"method\":\"digit\",\"value\":1}")
    Socket.RecvMsg(sock)
    Socket.SendMsg(sock, "{\"method\":\"digit\",\"value\":7}")
    Socket.RecvMsg(sock)

    Socket.SendMsg(sock, "{\"method\":\"equals\"}")
    r3 = Socket.RecvMsg(sock)
    IfCondition NotEqual(r3, 0) ThenBlock: {
        p3 = ParseJSON(r3)
        o3 = JSON.AsObject(p3)
        d3 = JSON.GetString(o3, "display")
        c3 = StringCompare(d3, "42")
        IfCondition EqualTo(c3, 0) ThenBlock: {
            PrintMessage("[Test] PASS — display=\"42\"\n\n")
            pass_count = Add(pass_count, 1)
        } ElseBlock: {
            PrintMessage("[Test] FAIL — got \"")
            PrintString(d3)
            PrintMessage("\"\n\n")
            fail_count = Add(fail_count, 1)
        }
        JSON.Free(p3)
    } ElseBlock: {
        PrintMessage("[Test] FAIL — no response\n\n")
        fail_count = Add(fail_count, 1)
    }

    // =========================================================================
    // TEST 4: MULTIPLY — 6 * 7 = 42
    // =========================================================================
    PrintMessage("[Test] TEST 4: Multiplication (6 * 7 = 42)\n")
    Socket.SendMsg(sock, "{\"method\":\"clear\"}")
    Socket.RecvMsg(sock)

    Socket.SendMsg(sock, "{\"method\":\"digit\",\"value\":6}")
    Socket.RecvMsg(sock)
    Socket.SendMsg(sock, "{\"method\":\"operator\",\"op\":3}")
    Socket.RecvMsg(sock)
    Socket.SendMsg(sock, "{\"method\":\"digit\",\"value\":7}")
    Socket.RecvMsg(sock)

    Socket.SendMsg(sock, "{\"method\":\"equals\"}")
    r4 = Socket.RecvMsg(sock)
    IfCondition NotEqual(r4, 0) ThenBlock: {
        p4 = ParseJSON(r4)
        o4 = JSON.AsObject(p4)
        d4 = JSON.GetString(o4, "display")
        c4 = StringCompare(d4, "42")
        IfCondition EqualTo(c4, 0) ThenBlock: {
            PrintMessage("[Test] PASS — display=\"42\"\n\n")
            pass_count = Add(pass_count, 1)
        } ElseBlock: {
            PrintMessage("[Test] FAIL — got \"")
            PrintString(d4)
            PrintMessage("\"\n\n")
            fail_count = Add(fail_count, 1)
        }
        JSON.Free(p4)
    } ElseBlock: {
        PrintMessage("[Test] FAIL — no response\n\n")
        fail_count = Add(fail_count, 1)
    }

    // =========================================================================
    // TEST 5: CHAIN — 10 + 20 + 12 = 42
    // =========================================================================
    PrintMessage("[Test] TEST 5: Chained ops (10 + 20 + 12 = 42)\n")
    Socket.SendMsg(sock, "{\"method\":\"clear\"}")
    Socket.RecvMsg(sock)

    Socket.SendMsg(sock, "{\"method\":\"digit\",\"value\":1}")
    Socket.RecvMsg(sock)
    Socket.SendMsg(sock, "{\"method\":\"digit\",\"value\":0}")
    Socket.RecvMsg(sock)
    Socket.SendMsg(sock, "{\"method\":\"operator\",\"op\":1}")
    Socket.RecvMsg(sock)
    Socket.SendMsg(sock, "{\"method\":\"digit\",\"value\":2}")
    Socket.RecvMsg(sock)
    Socket.SendMsg(sock, "{\"method\":\"digit\",\"value\":0}")
    Socket.RecvMsg(sock)
    Socket.SendMsg(sock, "{\"method\":\"operator\",\"op\":1}")
    Socket.RecvMsg(sock)
    Socket.SendMsg(sock, "{\"method\":\"digit\",\"value\":1}")
    Socket.RecvMsg(sock)
    Socket.SendMsg(sock, "{\"method\":\"digit\",\"value\":2}")
    Socket.RecvMsg(sock)

    Socket.SendMsg(sock, "{\"method\":\"equals\"}")
    r5 = Socket.RecvMsg(sock)
    IfCondition NotEqual(r5, 0) ThenBlock: {
        p5 = ParseJSON(r5)
        o5 = JSON.AsObject(p5)
        d5 = JSON.GetString(o5, "display")
        c5 = StringCompare(d5, "42")
        IfCondition EqualTo(c5, 0) ThenBlock: {
            PrintMessage("[Test] PASS — display=\"42\"\n\n")
            pass_count = Add(pass_count, 1)
        } ElseBlock: {
            PrintMessage("[Test] FAIL — got \"")
            PrintString(d5)
            PrintMessage("\"\n\n")
            fail_count = Add(fail_count, 1)
        }
        JSON.Free(p5)
    } ElseBlock: {
        PrintMessage("[Test] FAIL — no response\n\n")
        fail_count = Add(fail_count, 1)
    }

    // =========================================================================
    // TEST 6: NEGATE — 42 → -42
    // =========================================================================
    PrintMessage("[Test] TEST 6: Negate (42 -> -42)\n")
    Socket.SendMsg(sock, "{\"method\":\"clear\"}")
    Socket.RecvMsg(sock)

    Socket.SendMsg(sock, "{\"method\":\"digit\",\"value\":4}")
    Socket.RecvMsg(sock)
    Socket.SendMsg(sock, "{\"method\":\"digit\",\"value\":2}")
    Socket.RecvMsg(sock)

    Socket.SendMsg(sock, "{\"method\":\"negate\"}")
    r6 = Socket.RecvMsg(sock)
    IfCondition NotEqual(r6, 0) ThenBlock: {
        p6 = ParseJSON(r6)
        o6 = JSON.AsObject(p6)
        d6 = JSON.GetString(o6, "display")
        c6 = StringCompare(d6, "-42")
        IfCondition EqualTo(c6, 0) ThenBlock: {
            PrintMessage("[Test] PASS — display=\"-42\"\n\n")
            pass_count = Add(pass_count, 1)
        } ElseBlock: {
            PrintMessage("[Test] FAIL — got \"")
            PrintString(d6)
            PrintMessage("\"\n\n")
            fail_count = Add(fail_count, 1)
        }
        JSON.Free(p6)
    } ElseBlock: {
        PrintMessage("[Test] FAIL — no response\n\n")
        fail_count = Add(fail_count, 1)
    }

    // =========================================================================
    // SHUTDOWN
    // =========================================================================
    PrintMessage("[Test] Sending shutdown...\n")
    Socket.SendMsg(sock, "{\"method\":\"shutdown\"}")

    Socket.Close(sock)

    PrintMessage("\n============================================\n")
    PrintMessage("  Calculator Test Results: ")
    PrintNumber(pass_count)
    PrintMessage(" passed, ")
    PrintNumber(fail_count)
    PrintMessage(" failed\n")
    PrintMessage("============================================\n")
}

RunTask(Main)
