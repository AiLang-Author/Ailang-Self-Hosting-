// debug_test.ailang
// Comprehensive test for the AILANG debug system
// 
// Test with different debug levels:
//   debug 0  -> Only "Production mode" output, all debug stripped
//   debug 1  -> Assertions active, level 1 blocks
//   debug 2  -> Level 1-2 blocks, more tracing
//   debug 3  -> Level 1-3 blocks, detailed output
//   debug 4  -> Everything including breakpoints
//
// Expected: Higher levels show more output

// =============================================================================
// TEST 1: Debug Blocks at Different Levels
// =============================================================================

SubRoutine.Test_DebugLevels {
    PrintMessage("\n=== TEST 1: Debug Levels ===\n")
    PrintMessage("You should see more output at higher debug levels.\n\n")
    
    // Always prints (not a debug block)
    PrintMessage("[ALWAYS] This line always prints.\n")
    
    // Level 1 - Basic
    Debug("level1-test", level=1) {
        PrintMessage("[LEVEL 1] Basic debug block active.\n")
    }
    
    // Level 2 - Trace
    Debug("level2-test", level=2) {
        PrintMessage("[LEVEL 2] Trace debug block active.\n")
    }
    
    // Level 3 - Detailed
    Debug("level3-test", level=3) {
        PrintMessage("[LEVEL 3] Detailed debug block active.\n")
    }
    
    // Level 4 - Full
    Debug("level4-test", level=4) {
        PrintMessage("[LEVEL 4] Full debug block active.\n")
    }
    
    PrintMessage("[ALWAYS] Debug level test complete.\n")
}

// =============================================================================
// TEST 2: Debug Assertions (Passing)
// =============================================================================

SubRoutine.Test_AssertionsPass {
    PrintMessage("\n=== TEST 2: Assertions (Should Pass) ===\n")
    
    x = 10
    y = 5
    
    // These should all pass
    DebugAssert(GreaterThan(x, 0), "x must be positive")
    Debug("assert-trace", level=2) {
        PrintMessage("[TRACE] Passed: x > 0\n")
    }
    
    DebugAssert(LessThan(y, x), "y must be less than x")
    Debug("assert-trace", level=2) {
        PrintMessage("[TRACE] Passed: y < x\n")
    }
    
    DebugAssert(NotEqual(x, y), "x and y must differ")
    Debug("assert-trace", level=2) {
        PrintMessage("[TRACE] Passed: x != y\n")
    }
    
    // Assertion without message
    DebugAssert(GreaterEqual(x, 10))
    Debug("assert-trace", level=2) {
        PrintMessage("[TRACE] Passed: x >= 10\n")
    }
    
    // Complex condition
    DebugAssert(And(GreaterThan(x, 0), LessThan(x, 100)), "x must be in range 1-99")
    Debug("assert-trace", level=2) {
        PrintMessage("[TRACE] Passed: x in range\n")
    }
    
    PrintMessage("[PASS] All assertions passed!\n")
}

// =============================================================================
// TEST 3: Nested Debug Blocks
// =============================================================================

SubRoutine.Test_NestedBlocks {
    PrintMessage("\n=== TEST 3: Nested Debug Blocks ===\n")
    
    Debug("outer", level=1) {
        PrintMessage("[OUTER L1] Entering outer block\n")
        
        counter = 0
        
        Debug("inner-l2", level=2) {
            PrintMessage("[INNER L2] Inside level 2 nested block\n")
            counter = Add(counter, 1)
            
            Debug("innermost-l3", level=3) {
                PrintMessage("[INNERMOST L3] Deep inside level 3\n")
                counter = Add(counter, 10)
            }
        }
        
        Debug("report", level=2) {
            PrintMessage("[OUTER L1] Counter value: ")
            PrintNumber(counter)
            PrintMessage("\n")
        }
        
        PrintMessage("[OUTER L1] Exiting outer block\n")
    }
    
    PrintMessage("[ALWAYS] Nested block test complete.\n")
}

// =============================================================================
// TEST 4: Debug in a Loop
// =============================================================================

SubRoutine.Test_DebugInLoop {
    PrintMessage("\n=== TEST 4: Debug in Loop ===\n")
    
    sum = 0
    i = 1
    
    WhileLoop LessEqual(i, 5) {
        Debug("loop-trace", level=2) {
            PrintMessage("[LOOP] Iteration ")
            PrintNumber(i)
            PrintMessage("\n")
        }
        
        // Assertion inside loop
        DebugAssert(GreaterThan(i, 0), "Loop counter must be positive")
        
        sum = Add(sum, i)
        
        Debug("loop-detail", level=3) {
            PrintMessage("[LOOP DETAIL] Running sum: ")
            PrintNumber(sum)
            PrintMessage("\n")
        }
        
        i = Add(i, 1)
    }
    
    PrintMessage("[RESULT] Sum of 1-5 = ")
    PrintNumber(sum)
    PrintMessage("\n")
    
    DebugAssert(EqualTo(sum, 15), "Sum should be 15")
}

// =============================================================================
// TEST 5: Debug Breakpoint (Level 4 Only)
// =============================================================================

SubRoutine.Test_Breakpoint {
    PrintMessage("\n=== TEST 5: Breakpoint (Level 4 Only) ===\n")
    
    Debug("pre-break", level=4) {
        PrintMessage("[LEVEL 4] About to hit breakpoint...\n")
        PrintMessage("[LEVEL 4] If running under GDB, you'll stop here.\n")
    }
    
    // This only triggers at level 4
    // WARNING: Without a debugger attached, INT3 causes SIGTRAP!
    // DebugBreak("test-breakpoint")
    
    Debug("post-break", level=4) {
        PrintMessage("[LEVEL 4] Passed breakpoint (or it was stripped).\n")
    }
    
    PrintMessage("[ALWAYS] Breakpoint test complete.\n")
}

// =============================================================================
// TEST 6: Function with Debug (uses Body: syntax)
// =============================================================================

Function.CalculateWithDebug {
    Input: a: Integer
    Input: b: Integer
    Output: Integer
    Body: {
        Debug("calc-entry", level=2) {
            PrintMessage("[CALC] Entering with a=")
            PrintNumber(a)
            PrintMessage(", b=")
            PrintNumber(b)
            PrintMessage("\n")
        }
        
        DebugAssert(NotEqual(b, 0), "Division by zero!")
        
        result = Add(a, b)
        
        Debug("calc-exit", level=2) {
            PrintMessage("[CALC] Returning ")
            PrintNumber(result)
            PrintMessage("\n")
        }
        
        ReturnValue(result)
    }
}

SubRoutine.Test_FunctionDebug {
    PrintMessage("\n=== TEST 6: Function with Debug ===\n")
    
    result = CalculateWithDebug(10, 25)
    
    PrintMessage("[RESULT] CalculateWithDebug(10, 25) = ")
    PrintNumber(result)
    PrintMessage("\n")
    
    DebugAssert(EqualTo(result, 35), "Result should be 35")
    PrintMessage("[PASS] Function debug test passed!\n")
}

// =============================================================================
// TEST 7: Assertion Failure Test (OPTIONAL - will exit!)
// Uncomment to test assertion failure behavior
// =============================================================================

SubRoutine.Test_AssertionFail {
    PrintMessage("\n=== TEST 7: Assertion Failure (WILL EXIT) ===\n")
    PrintMessage("This test intentionally fails an assertion.\n")
    
    x = 5
    
    // This WILL fail and exit the program!
    DebugAssert(GreaterThan(x, 100), "x is not greater than 100 - EXPECTED FAIL")
    
    // This line should never print
    PrintMessage("[ERROR] This should not print!\n")
}

// =============================================================================
// MAIN - Run all tests
// =============================================================================

SubRoutine.Main {
    PrintMessage("\n")
    PrintMessage("============================================================\n")
    PrintMessage("           AILANG DEBUG SYSTEM TEST SUITE\n")
    PrintMessage("============================================================\n")
    PrintMessage("Current debug level determines output verbosity.\n")
    PrintMessage("Use 'debug N' command to change level (0-4).\n")
    PrintMessage("============================================================\n")
    
    // Run passing tests
    Test_DebugLevels()
    Test_AssertionsPass()
    Test_NestedBlocks()
    Test_DebugInLoop()
    Test_Breakpoint()
    Test_FunctionDebug()
    
    // Uncomment to test failure (will exit program):
    // Test_AssertionFail()
    
    PrintMessage("\n")
    PrintMessage("============================================================\n")
    PrintMessage("           ALL TESTS COMPLETE\n")
    PrintMessage("============================================================\n")
    PrintMessage("Try running again with different debug levels:\n")
    PrintMessage("  debug 0  ->  Minimal output (production)\n")
    PrintMessage("  debug 1  ->  Assertions checked\n")
    PrintMessage("  debug 2  ->  Trace output visible\n")
    PrintMessage("  debug 3  ->  Detailed output visible\n")
    PrintMessage("  debug 4  ->  Full debug (breakpoints active)\n")
    PrintMessage("============================================================\n")
    PrintMessage("\n")
}

RunTask(Main)