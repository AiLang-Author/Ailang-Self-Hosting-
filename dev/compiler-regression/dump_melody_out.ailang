LibraryImport.Arena
LibraryImport.Media.Sample
LibraryImport.Media.SF2
LibraryImport.Media.Synth

Function.DumpHit {
    Input: bank: Address
    Input: note: Integer
    Input: prog: Integer
    Input: nth: Integer
    Output: Address
    Body: {
        SF2_SetNth(nth)
        smp = SF2_LookupP(bank, note, 100, prog, 0)
        PrintMessage(" p")
        PrintNumber(prog)
        PrintMessage(" n")
        PrintNumber(note)
        PrintMessage(" z")
        PrintNumber(nth)
        IfCondition EqualTo(smp, 0) ThenBlock: {
            PrintMessage(" MISS\n")
            ReturnValue(0)
        }
        PrintMessage(" root=")
        PrintNumber(SF2_LastRoot())
        PrintMessage(" co=")
        PrintNumber(SF2_LastCoarse())
        PrintMessage(" sc=")
        PrintNumber(SF2_LastScale())
        PrintMessage(" at=")
        PrintNumber(SF2_LastAtten())
        PrintMessage(" nfr=")
        PrintNumber(Dereference(Add(smp, 16)))
        PrintMessage(" srate=")
        PrintNumber(Dereference(Add(smp, 24)))
        PrintMessage(" hroot=")
        PrintNumber(Dereference(Add(smp, 32)))
        PrintMessage(" mode=")
        PrintNumber(Dereference(Add(smp, 56)))
        d = SF2_LastCoarse()
        sc = SF2_LastScale()
        IfCondition GreaterThan(sc, 0) ThenBlock: {
            dk = Subtract(note, SF2_LastRoot())
            dk = Divide(Multiply(dk, sc), 100)
            d = Add(dk, SF2_LastCoarse())
        }
        PrintMessage(" dsemi=")
        PrintNumber(d)
        st = Smp_StepD(smp, d, 48000)
        PrintMessage(" step=")
        PrintNumber(st)
        PrintMessage("\n")
        ReturnValue(smp)
    }
}

Function.RenderNote {
    Input: bank: Address
    Input: note: Integer
    Input: prog: Integer
    Input: path: Address
    Body: {
        syn = Synth_New(16, 48000)
        Synth_SetMixGain(syn, 128)
        nth = 0
        nst = 0
        WhileLoop LessThan(nth, 16) {
            smp = DumpHit(bank, note, prog, nth)
            IfCondition EqualTo(smp, 0) ThenBlock: {
                nth = 16
            } ElseBlock: {
                vi = nst
                Synth_VoiceOnSample(syn, vi, smp, note, 100)
                playfc = Add(SF2_LastFc(), SF2_LastE2f())
                IfCondition LessThan(playfc, 0) ThenBlock: { playfc = 0 }
                IfCondition GreaterThan(playfc, 13500) ThenBlock: { playfc = 13500 }
                Synth_SetFilterCents(syn, vi, playfc, SF2_LastQ())
                v = Synth_Voice(syn, vi)
                PrintMessage("  WAVE=")
                PrintNumber(GetByte(v, 16))
                PrintMessage(" VSTEP=")
                PrintNumber(Dereference(Add(v, 8)))
                PrintMessage(" CUT=")
                PrintNumber(Dereference(Add(v, 96), "dword"))
                PrintMessage("\n")
                nst = Add(nst, 1)
                nth = Add(nth, 1)
            }
        }
        PrintMessage(" started=")
        PrintNumber(nst)
        PrintMessage(" -> ")
        PrintString(path)
        PrintMessage("\n")
        frames = 24000
        buf = Allocate(Multiply(frames, 2))
        MemorySet(buf, 0, Multiply(frames, 2))
        Synth_RenderS16(syn, buf, frames)
        zc = Synth_ZeroCross(buf, frames)
        PrintMessage(" zcr=")
        PrintNumber(zc)
        PrintMessage(" uniq=")
        PrintNumber(Synth_UniqueLevels(buf, frames))
        PrintMessage("\n")
        Synth_WriteWav16(path, buf, frames, 48000)
        Deallocate(buf, Multiply(frames, 2))
        Synth_Free(syn)
    }
}

SubRoutine.Main {
    Arena_Init()
    bank = SF2_Load("/home/bob/Downloads/GeneralUser-GS.sf2")
    PrintMessage("np=")
    PrintNumber(SF2_PresetCount(bank))
    PrintMessage(" nr=")
    PrintNumber(SF2_RegionCount(bank))
    PrintMessage("\n")
    PrintMessage("PIANO 60\n")
    RenderNote(bank, 60, 0, "/tmp/mel_piano60.wav")
    PrintMessage("PIANO 80\n")
    RenderNote(bank, 80, 0, "/tmp/mel_piano80.wav")
    PrintMessage("OCARINA 60\n")
    RenderNote(bank, 60, 79, "/tmp/mel_oca60.wav")
    PrintMessage("OCARINA 80\n")
    RenderNote(bank, 80, 79, "/tmp/mel_oca80.wav")
    PrintMessage("OCARINA 86\n")
    RenderNote(bank, 86, 79, "/tmp/mel_oca86.wav")
    PrintMessage("WHISTLE 86\n")
    RenderNote(bank, 86, 78, "/tmp/mel_whi86.wav")
    PrintMessage("BASS 36\n")
    RenderNote(bank, 36, 39, "/tmp/mel_bass36.wav")
    PrintMessage("STRINGS 80\n")
    RenderNote(bank, 80, 49, "/tmp/mel_str80.wav")
}

RunTask(Main)
