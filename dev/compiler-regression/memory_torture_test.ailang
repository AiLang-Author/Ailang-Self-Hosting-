// memory_torture_test.ailang
// Run for 24 hours, watch for leaks

LibraryImport.Arrays

FixedPool.Test {
    "iteration": Initialize=0
    "hour": Initialize=0
    "start_time": Initialize=0
}

Function.DoWork {
    Body: {
        // Allocate, use, free - typical program behavior
        i = 0
        WhileLoop LessThan(i, 1000) {
            // Array work
            arr = ArrayCreate(100)
            j = 0
            WhileLoop LessThan(j, 100) {
                ArraySet(arr, j, Multiply(i, j))
                j = Add(j, 1)
            }
            sum = 0
            j = 0
            WhileLoop LessThan(j, 100) {
                sum = Add(sum, ArrayGet(arr, j))
                j = Add(j, 1)
            }
            ArrayDestroy(arr)
            
            // XArray work
            xa = Array.Create(50)
            j = 0
            WhileLoop LessThan(j, 50) {
                Array.Push(xa, j)
                j = Add(j, 1)
            }
            Array.Destroy(xa)
            
            // String work
            s1 = StringConcat("Hello", "World")
            s2 = StringConcat(s1, "Test")
            len = StringLength(s2)
            
            i = Add(i, 1)
        }
    }
}

Function.Sleep60Seconds {
    Body: {
        // Busy wait ~60 seconds (adjust multiplier for your CPU)
        i = 0
        WhileLoop LessThan(i, 300000000) {
            x = Add(i, 1)
            x = Multiply(x, 2)
            x = Divide(x, 2)
            i = Add(i, 1)
        }
    }
}

SubRoutine.Main {
    PrintMessage("=== 24 Hour Memory Test ===\n")
    PrintMessage("Will report every ~hour\n\n")
    
    Test.hour = 0
    
    WhileLoop LessThan(Test.hour, 24) {
        // Do work 60 times (once per "minute")
        minute = 0
        WhileLoop LessThan(minute, 60) {
            DoWork()
            Sleep60Seconds()
            minute = Add(minute, 1)
        }
        
        Test.hour = Add(Test.hour, 1)
        
        PrintMessage("Hour ")
        PrintNumber(Test.hour)
        PrintMessage(" complete - ")
        PrintNumber(Multiply(Test.hour, 60000))
        PrintMessage(" work cycles done\n")
        
        // Print arena stats if available
        Arena_Report()
    }
    
    PrintMessage("\n=== 24 Hour Test Complete ===\n")
}

RunTask(Main)