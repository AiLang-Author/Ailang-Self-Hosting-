// pci_bar_restore.ailang — Restore PCI BARs after SBR wipes them
// Build: ./ailang.x dev/compiler-regression/pci_bar_restore.ailang pci_bar_restore.x
// Run:   sg video -c "./pci_bar_restore.x"
//
// After a PCI Secondary Bus Reset, the GPU's BAR registers are zeroed.
// This tool restores them from the kernel's resource file, then verifies
// MMIO is accessible by reading a known GPU register.

LibraryImport.Arena

// Helper: parse one hex line from the resource file to extract start address
// resource file format: "0xSTART 0xEND 0xFLAGS\n"
// Returns the start address (64-bit).
Function.ParseHexAddr {
    Input: line: Address
    Output: Integer
    Body: {
        // Skip "0x" prefix
        pos = 0
        IfCondition EqualTo(GetByte(line, 0), 48) ThenBlock: {   // '0'
            IfCondition EqualTo(GetByte(line, 1), 120) ThenBlock: {  // 'x'
                pos = 2
            }
        }

        result = 0
        WhileLoop NotEqual(GetByte(line, pos), 32) {  // until space
            IfCondition EqualTo(GetByte(line, pos), 0) ThenBlock: {
                ReturnValue(result)
            }
            IfCondition EqualTo(GetByte(line, pos), 10) ThenBlock: {
                ReturnValue(result)
            }

            ch = GetByte(line, pos)
            digit = 0

            // '0'-'9'
            IfCondition GreaterEqual(ch, 48) ThenBlock: {
                IfCondition LessEqual(ch, 57) ThenBlock: {
                    digit = Subtract(ch, 48)
                }
            }
            // 'a'-'f'
            IfCondition GreaterEqual(ch, 97) ThenBlock: {
                IfCondition LessEqual(ch, 102) ThenBlock: {
                    digit = Add(Subtract(ch, 97), 10)
                }
            }
            // 'A'-'F'
            IfCondition GreaterEqual(ch, 65) ThenBlock: {
                IfCondition LessEqual(ch, 70) ThenBlock: {
                    digit = Add(Subtract(ch, 65), 10)
                }
            }

            result = BitwiseOr(LeftShift(result, 4), digit)
            pos = Add(pos, 1)
        }
        ReturnValue(result)
    }
}

SubRoutine.Main {
    PrintMessage("=== PCI BAR Restore Tool ===\n\n")

    // =========================================================================
    // Step 1: Read the kernel resource file for the compute GPU
    //         This has the correct BAR addresses even after SBR.
    // =========================================================================
    gpu_cfg = "/sys/bus/pci/devices/0000:02:00.0/config"
    gpu_res = "/sys/bus/pci/devices/0000:02:00.0/resource"

    // Open resource file (O_RDONLY = 0)
    rfd = SystemCall(2, gpu_res, 0, 0)
    IfCondition LessThan(rfd, 0) ThenBlock: {
        PrintMessage("Cannot open resource file: ")
        PrintNumber(rfd)
        PrintMessage("\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }

    // Read resource file (up to 2048 bytes)
    rbuf = Allocate(2048)
    MemorySet(rbuf, 0, 2048)
    rn = SystemCall(0, rfd, rbuf, 2047)
    SystemCall(3, rfd)
    PrintMessage("Resource file (")
    PrintNumber(rn)
    PrintMessage(" bytes):\n")

    // Parse resource lines — each line: "0xSTART 0xEND 0xFLAGS\n"
    // Line 0 = BAR0, Line 1 = BAR1(upper), Line 2 = BAR2,
    // Line 3 = BAR3(upper), Line 4 = BAR4, Line 5 = BAR5
    bar0_addr = 0
    bar2_addr = 0
    bar4_addr = 0

    // Single-pass scan: walk byte-by-byte, track line boundaries
    line_num = 0
    line_start = 0
    lpos = 0
    WhileLoop LessThan(lpos, rn) {
        ch = GetByte(rbuf, lpos)
        IfCondition EqualTo(ch, 10) ThenBlock: {
            // End of line — parse if it's a BAR line we care about
            IfCondition EqualTo(line_num, 0) ThenBlock: {
                bar0_addr = ParseHexAddr(Add(rbuf, line_start))
            }
            IfCondition EqualTo(line_num, 2) ThenBlock: {
                bar2_addr = ParseHexAddr(Add(rbuf, line_start))
            }
            IfCondition EqualTo(line_num, 4) ThenBlock: {
                bar4_addr = ParseHexAddr(Add(rbuf, line_start))
            }
            line_num = Add(line_num, 1)
            line_start = Add(lpos, 1)
        }
        lpos = Add(lpos, 1)
    }

    PrintMessage("Kernel BAR0 address: 0x")
    PrintHex(bar0_addr)
    PrintMessage("\n")
    PrintMessage("Kernel BAR2 address: 0x")
    PrintHex(bar2_addr)
    PrintMessage("\n")
    PrintMessage("Kernel BAR4 address: 0x")
    PrintHex(bar4_addr)
    PrintMessage("\n\n")

    Deallocate(rbuf, 2048)

    // =========================================================================
    // Step 2: Read current PCI config and show current BAR state
    // =========================================================================
    fd = SystemCall(2, gpu_cfg, 2, 0)
    IfCondition LessThan(fd, 0) ThenBlock: {
        PrintMessage("Cannot open GPU config space (need root/video?): ")
        PrintNumber(fd)
        PrintMessage("\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }

    buf = Allocate(64)
    MemorySet(buf, 0, 64)
    SystemCall(8, fd, 0, 0)
    nr = SystemCall(0, fd, buf, 64)
    PrintMessage("Read ")
    PrintNumber(nr)
    PrintMessage(" bytes of config\n")

    // Show current BARs
    b0 = GetByte(buf, 16)
    b1 = GetByte(buf, 17)
    b2 = GetByte(buf, 18)
    b3 = GetByte(buf, 19)
    cur_bar0 = BitwiseOr(BitwiseOr(b0, LeftShift(b1, 8)), BitwiseOr(LeftShift(b2, 16), LeftShift(b3, 24)))
    PrintMessage("Current BAR0: 0x")
    PrintHex(cur_bar0)
    PrintMessage("\n")

    b0 = GetByte(buf, 24)
    b1 = GetByte(buf, 25)
    b2 = GetByte(buf, 26)
    b3 = GetByte(buf, 27)
    cur_bar2 = BitwiseOr(BitwiseOr(b0, LeftShift(b1, 8)), BitwiseOr(LeftShift(b2, 16), LeftShift(b3, 24)))
    PrintMessage("Current BAR2: 0x")
    PrintHex(cur_bar2)
    PrintMessage("\n")

    b0 = GetByte(buf, 32)
    b1 = GetByte(buf, 33)
    b2 = GetByte(buf, 34)
    b3 = GetByte(buf, 35)
    cur_bar4 = BitwiseOr(BitwiseOr(b0, LeftShift(b1, 8)), BitwiseOr(LeftShift(b2, 16), LeftShift(b3, 24)))
    PrintMessage("Current BAR4: 0x")
    PrintHex(cur_bar4)
    PrintMessage("\n")

    // Show COMMAND
    c0 = GetByte(buf, 4)
    c1 = GetByte(buf, 5)
    cur_cmd = BitwiseOr(c0, LeftShift(c1, 8))
    PrintMessage("Current COMMAND: 0x")
    PrintHex(cur_cmd)
    PrintMessage("\n\n")

    // =========================================================================
    // Step 3: Write correct BAR values
    // =========================================================================
    PrintMessage("Restoring BARs...\n")

    // Disable COMMAND first (clear Mem+BusMaster+IO)
    SetByte(buf, 0, 0)
    SetByte(buf, 1, 0)
    SystemCall(8, fd, 4, 0)
    SystemCall(1, fd, buf, 2)
    PrintMessage("  COMMAND disabled\n")

    // Build BAR0 value: address | type bits (0xC = 64-bit, prefetchable, memory)
    bar0_val = BitwiseOr(bar0_addr, 12)
    SetByte(buf, 0, BitwiseAnd(bar0_val, 255))
    SetByte(buf, 1, BitwiseAnd(RightShift(bar0_val, 8), 255))
    SetByte(buf, 2, BitwiseAnd(RightShift(bar0_val, 16), 255))
    SetByte(buf, 3, BitwiseAnd(RightShift(bar0_val, 24), 255))
    SystemCall(8, fd, 16, 0)
    SystemCall(1, fd, buf, 4)
    PrintMessage("  BAR0 = 0x")
    PrintHex(bar0_val)
    PrintMessage("\n")

    // BAR1 (upper 32 of BAR0) = 0
    SetByte(buf, 0, 0)
    SetByte(buf, 1, 0)
    SetByte(buf, 2, 0)
    SetByte(buf, 3, 0)
    SystemCall(8, fd, 20, 0)
    SystemCall(1, fd, buf, 4)

    // Build BAR2 value: address | type bits (0x4 = 64-bit, non-prefetchable, memory)
    bar2_val = BitwiseOr(bar2_addr, 4)
    SetByte(buf, 0, BitwiseAnd(bar2_val, 255))
    SetByte(buf, 1, BitwiseAnd(RightShift(bar2_val, 8), 255))
    SetByte(buf, 2, BitwiseAnd(RightShift(bar2_val, 16), 255))
    SetByte(buf, 3, BitwiseAnd(RightShift(bar2_val, 24), 255))
    SystemCall(8, fd, 24, 0)
    SystemCall(1, fd, buf, 4)
    PrintMessage("  BAR2 = 0x")
    PrintHex(bar2_val)
    PrintMessage("\n")

    // BAR3 (upper 32 of BAR2) = 0
    SetByte(buf, 0, 0)
    SetByte(buf, 1, 0)
    SetByte(buf, 2, 0)
    SetByte(buf, 3, 0)
    SystemCall(8, fd, 28, 0)
    SystemCall(1, fd, buf, 4)

    // Build BAR4 value: address | 1 (I/O space bit)
    bar4_val = BitwiseOr(bar4_addr, 1)
    SetByte(buf, 0, BitwiseAnd(bar4_val, 255))
    SetByte(buf, 1, BitwiseAnd(RightShift(bar4_val, 8), 255))
    SetByte(buf, 2, BitwiseAnd(RightShift(bar4_val, 16), 255))
    SetByte(buf, 3, BitwiseAnd(RightShift(bar4_val, 24), 255))
    SystemCall(8, fd, 32, 0)
    SystemCall(1, fd, buf, 4)
    PrintMessage("  BAR4 = 0x")
    PrintHex(bar4_val)
    PrintMessage("\n")

    // Re-enable COMMAND: IO + Mem + BusMaster = 0x07
    SetByte(buf, 0, 7)
    SetByte(buf, 1, 0)
    SystemCall(8, fd, 4, 0)
    SystemCall(1, fd, buf, 2)
    PrintMessage("  COMMAND = 0x0007\n\n")

    // =========================================================================
    // Step 4: Verify by reading back
    // =========================================================================
    SystemCall(8, fd, 0, 0)
    MemorySet(buf, 0, 64)
    SystemCall(0, fd, buf, 64)
    SystemCall(3, fd)

    PrintMessage("=== Verification ===\n")

    b0 = GetByte(buf, 16)
    b1 = GetByte(buf, 17)
    b2 = GetByte(buf, 18)
    b3 = GetByte(buf, 19)
    v_bar0 = BitwiseOr(BitwiseOr(b0, LeftShift(b1, 8)), BitwiseOr(LeftShift(b2, 16), LeftShift(b3, 24)))
    PrintMessage("BAR0: 0x")
    PrintHex(v_bar0)
    IfCondition EqualTo(v_bar0, bar0_val) ThenBlock: { PrintMessage(" OK\n") }
    ElseBlock: { PrintMessage(" FAIL\n") }

    b0 = GetByte(buf, 24)
    b1 = GetByte(buf, 25)
    b2 = GetByte(buf, 26)
    b3 = GetByte(buf, 27)
    v_bar2 = BitwiseOr(BitwiseOr(b0, LeftShift(b1, 8)), BitwiseOr(LeftShift(b2, 16), LeftShift(b3, 24)))
    PrintMessage("BAR2: 0x")
    PrintHex(v_bar2)
    IfCondition EqualTo(v_bar2, bar2_val) ThenBlock: { PrintMessage(" OK\n") }
    ElseBlock: { PrintMessage(" FAIL\n") }

    b0 = GetByte(buf, 32)
    b1 = GetByte(buf, 33)
    b2 = GetByte(buf, 34)
    b3 = GetByte(buf, 35)
    v_bar4 = BitwiseOr(BitwiseOr(b0, LeftShift(b1, 8)), BitwiseOr(LeftShift(b2, 16), LeftShift(b3, 24)))
    PrintMessage("BAR4: 0x")
    PrintHex(v_bar4)
    IfCondition EqualTo(v_bar4, bar4_val) ThenBlock: { PrintMessage(" OK\n") }
    ElseBlock: { PrintMessage(" FAIL\n") }

    c0 = GetByte(buf, 4)
    c1 = GetByte(buf, 5)
    v_cmd = BitwiseOr(c0, LeftShift(c1, 8))
    PrintMessage("CMD:  0x")
    PrintHex(v_cmd)
    PrintMessage("\n")

    Deallocate(buf, 64)

    // =========================================================================
    // Step 5: Test MMIO access via mmap of resource2
    // =========================================================================
    PrintMessage("\n=== MMIO Access Test ===\n")

    res2_path = "/sys/bus/pci/devices/0000:02:00.0/resource2"
    // O_RDWR | O_SYNC = 2 | 0x101000 = 0x101002
    r2fd = SystemCall(2, res2_path, 1052674, 0)
    IfCondition LessThan(r2fd, 0) ThenBlock: {
        PrintMessage("Cannot open resource2: ")
        PrintNumber(r2fd)
        PrintMessage("\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }

    // mmap(NULL, 0x40000, PROT_READ|PROT_WRITE, MAP_SHARED, fd, 0)
    // PROT_READ|PROT_WRITE = 3, MAP_SHARED = 1
    mmio = SystemCall(9, 0, 262144, 3, 1, r2fd, 0)
    IfCondition EqualTo(mmio, 0) ThenBlock: {
        PrintMessage("mmap failed\n")
        SystemCall(3, r2fd)
        SystemCall(60, 1, 0, 0, 0, 0)
    }
    // Check MAP_FAILED (-1 as unsigned) — top bit set means error
    IfCondition GreaterThan(mmio, 0) ThenBlock: {
        PrintMessage("MMIO mapped at 0x")
        PrintHex(mmio)
        PrintMessage("\n")
    }

    // Read GRBM_STATUS (0x8010) — should NOT be 0xFFFFFFFF if GPU is alive
    grbm = Dereference(Add(mmio, 32784), "dword")
    PrintMessage("GRBM_STATUS (0x8010): 0x")
    PrintHex(grbm)
    IfCondition EqualTo(grbm, 4294967295) ThenBlock: {
        PrintMessage(" *** DEAD (0xFFFFFFFF) ***\n")
    }
    ElseBlock: {
        PrintMessage(" ALIVE!\n")
    }

    // Read CONFIG_MEMSIZE (0x5428) — should show VRAM size
    memsize = Dereference(Add(mmio, 21544), "dword")
    PrintMessage("CONFIG_MEMSIZE (0x5428): 0x")
    PrintHex(memsize)
    PrintMessage(" (")
    PrintNumber(Divide(memsize, 1048576))
    PrintMessage(" MB)\n")

    // Read SCRATCH_REG0 (0x8500)
    scratch = Dereference(Add(mmio, 34048), "dword")
    PrintMessage("SCRATCH_REG0 (0x8500): 0x")
    PrintHex(scratch)
    PrintMessage("\n")

    // Cleanup
    SystemCall(11, mmio, 262144)
    SystemCall(3, r2fd)

    PrintMessage("\n=== BAR Restore Complete ===\n")
    SystemCall(60, 0, 0, 0, 0, 0)
}

RunTask(Main)
