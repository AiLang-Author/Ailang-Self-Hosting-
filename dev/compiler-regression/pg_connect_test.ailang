// pg_stress_test.ailang
// Comprehensive PostgreSQL library stress test
// ALL STRING LITERALS UNDER 255 CHARACTERS
//
// Build & Run:
//   ./build.sh dev/compiler-regression/pg_stress_test.ailang && ./pg_stress_test.x

LibraryImport.Arena
LibraryImport.Socket
LibraryImport.Hash
LibraryImport.Arrays
LibraryImport.StringUtils
LibraryImport.PostgreSQL_Complete

SubRoutine.Main {
    Arena_Init()

    pass_count = 0
    fail_count = 0

    PrintMessage("============================================\n")
    PrintMessage("  PostgreSQL Stress Test Suite\n")
    PrintMessage("============================================\n\n")

    // =========================================================================
    // CONNECT
    // =========================================================================
    conn = PG_Connect("127.0.0.1", 5432, "ailang_system", "sean", "")
    IfCondition EqualTo(conn, 0) ThenBlock: {
        PrintMessage("[FATAL] Cannot connect to PostgreSQL\n")
        HaltProgram
    }
    PrintMessage("[OK] Connected to ailang_system\n\n")

    // =========================================================================
    // TEST 1: Rapid-fire DDL — CREATE, DROP, CREATE cycle
    // =========================================================================
    PrintMessage("[TEST 1] Rapid-fire DDL (CREATE/DROP x3)...\n")

    r = PG_Query(conn, "DROP TABLE IF EXISTS stress_a")
    IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

    r = PG_Query(conn, "CREATE TABLE stress_a (id SERIAL)")
    IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

    r = PG_Query(conn, "DROP TABLE stress_a")
    IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

    r = PG_Query(conn, "CREATE TABLE stress_a (id SERIAL, val TEXT)")
    IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

    r = PG_Query(conn, "DROP TABLE stress_a")
    IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

    r = PG_Query(conn, "CREATE TABLE stress_a (id SERIAL PRIMARY KEY, name TEXT, value INTEGER)")
    IfCondition EqualTo(r, 0) ThenBlock: {
        PrintMessage("[FAIL] Test 1\n")
        fail_count = Add(fail_count, 1)
    } ElseBlock: {
        PG_DestroyResult(r)
        PrintMessage("[PASS] Test 1 — 6 DDL statements in sequence\n")
        pass_count = Add(pass_count, 1)
    }

    // =========================================================================
    // TEST 2: System-table-like schema (built with ALTER TABLE)
    // =========================================================================
    PrintMessage("\n[TEST 2] System-table schema via ALTER TABLE...\n")

    r = PG_Query(conn, "DROP TABLE IF EXISTS test_services")
    IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

    t2_ok = 1

    r = PG_Query(conn, "CREATE TABLE test_services (id SERIAL PRIMARY KEY, name TEXT NOT NULL)")
    IfCondition EqualTo(r, 0) ThenBlock: { t2_ok = 0 }
    IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

    r = PG_Query(conn, "ALTER TABLE test_services ADD COLUMN binary_path TEXT")
    IfCondition EqualTo(r, 0) ThenBlock: { t2_ok = 0 }
    IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

    r = PG_Query(conn, "ALTER TABLE test_services ADD COLUMN args TEXT")
    IfCondition EqualTo(r, 0) ThenBlock: { t2_ok = 0 }
    IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

    r = PG_Query(conn, "ALTER TABLE test_services ADD COLUMN autostart BOOLEAN DEFAULT false")
    IfCondition EqualTo(r, 0) ThenBlock: { t2_ok = 0 }
    IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

    r = PG_Query(conn, "ALTER TABLE test_services ADD COLUMN restart_policy TEXT DEFAULT 'never'")
    IfCondition EqualTo(r, 0) ThenBlock: { t2_ok = 0 }
    IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

    r = PG_Query(conn, "ALTER TABLE test_services ADD COLUMN depends_on TEXT")
    IfCondition EqualTo(r, 0) ThenBlock: { t2_ok = 0 }
    IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

    r = PG_Query(conn, "ALTER TABLE test_services ADD COLUMN run_as TEXT DEFAULT 'nobody'")
    IfCondition EqualTo(r, 0) ThenBlock: { t2_ok = 0 }
    IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

    r = PG_Query(conn, "ALTER TABLE test_services ADD COLUMN priority INTEGER DEFAULT 50")
    IfCondition EqualTo(r, 0) ThenBlock: { t2_ok = 0 }
    IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

    r = PG_Query(conn, "ALTER TABLE test_services ADD COLUMN enabled BOOLEAN DEFAULT true")
    IfCondition EqualTo(r, 0) ThenBlock: { t2_ok = 0 }
    IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

    IfCondition EqualTo(t2_ok, 1) ThenBlock: {
        PrintMessage("[PASS] Test 2 — 10-column table via ALTER TABLE\n")
        pass_count = Add(pass_count, 1)
    } ElseBlock: {
        PrintMessage("[FAIL] Test 2\n")
        fail_count = Add(fail_count, 1)
    }

    // =========================================================================
    // TEST 3: INSERT with various data patterns
    // =========================================================================
    PrintMessage("\n[TEST 3] INSERT various data patterns...\n")

    t3_ok = 1

    r = PG_Query(conn, "INSERT INTO test_services (name, binary_path, args, autostart, run_as, priority, enabled) VALUES ('display_server', '/usr/local/bin/sysdisplay', '--fb /dev/fb0', true, 'root', 10, true)")
    IfCondition EqualTo(r, 0) ThenBlock: { t3_ok = 0 }
    IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

    r = PG_Query(conn, "INSERT INTO test_services (name, binary_path, args, autostart, priority, enabled) VALUES ('file_browser', '/usr/local/bin/filebrowser', '', false, 50, true)")
    IfCondition EqualTo(r, 0) ThenBlock: { t3_ok = 0 }
    IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

    r = PG_Query(conn, "INSERT INTO test_services (name, binary_path, autostart, priority, enabled) VALUES ('calculator', '/usr/local/bin/calc', false, 99, true)")
    IfCondition EqualTo(r, 0) ThenBlock: { t3_ok = 0 }
    IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

    r = PG_Query(conn, "INSERT INTO test_services (name, binary_path, autostart, restart_policy, run_as, priority, enabled) VALUES ('network_mgr', '/usr/local/bin/netmgr', true, 'on-failure', 'root', 5, true)")
    IfCondition EqualTo(r, 0) ThenBlock: { t3_ok = 0 }
    IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

    r = PG_Query(conn, "INSERT INTO test_services (name, binary_path, autostart, priority, enabled) VALUES ('media_player', '/usr/local/bin/mediaplayer', false, 80, false)")
    IfCondition EqualTo(r, 0) ThenBlock: { t3_ok = 0 }
    IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

    IfCondition EqualTo(t3_ok, 1) ThenBlock: {
        PrintMessage("[PASS] Test 3 — 5 INSERTs (full, partial, empty str, NULLs)\n")
        pass_count = Add(pass_count, 1)
    } ElseBlock: {
        PrintMessage("[FAIL] Test 3\n")
        fail_count = Add(fail_count, 1)
    }

    // =========================================================================
    // TEST 4: SELECT all columns, verify row count + NULL handling
    // =========================================================================
    PrintMessage("\n[TEST 4] SELECT all columns, check NULLs...\n")

    r = PG_Query(conn, "SELECT id, name, binary_path, args, depends_on, priority, enabled FROM test_services ORDER BY id")
    IfCondition EqualTo(r, 0) ThenBlock: {
        PrintMessage("[FAIL] Test 4 — SELECT failed\n")
        fail_count = Add(fail_count, 1)
    } ElseBlock: {
        rc = Array.Size(r)
        PrintMessage("[INFO] Rows: ")
        PrintNumber(rc)
        PrintMessage("\n")

        ri = 0
        WhileLoop LessThan(ri, rc) {
            row = Array.Get(r, ri)
            PrintMessage("  row ")
            PrintNumber(ri)
            PrintMessage(": name=")
            v = Hash.Get(row, "name")
            IfCondition NotEqual(v, 0) ThenBlock: { PrintString(v) }
            IfCondition EqualTo(v, 0) ThenBlock: { PrintMessage("NULL") }

            PrintMessage(" args=")
            v = Hash.Get(row, "args")
            IfCondition NotEqual(v, 0) ThenBlock: { PrintString(v) }
            IfCondition EqualTo(v, 0) ThenBlock: { PrintMessage("NULL") }

            PrintMessage(" depends=")
            v = Hash.Get(row, "depends_on")
            IfCondition NotEqual(v, 0) ThenBlock: { PrintString(v) }
            IfCondition EqualTo(v, 0) ThenBlock: { PrintMessage("NULL") }

            PrintMessage(" pri=")
            v = Hash.Get(row, "priority")
            IfCondition NotEqual(v, 0) ThenBlock: { PrintString(v) }

            PrintMessage("\n")
            ri = Add(ri, 1)
        }

        IfCondition EqualTo(rc, 5) ThenBlock: {
            PrintMessage("[PASS] Test 4 — 7-column SELECT, 5 rows, NULLs\n")
            pass_count = Add(pass_count, 1)
        } ElseBlock: {
            PrintMessage("[FAIL] Test 4 — expected 5 rows\n")
            fail_count = Add(fail_count, 1)
        }
        PG_DestroyResult(r)
    }

    // =========================================================================
    // TEST 5: UPDATE + verify
    // =========================================================================
    PrintMessage("\n[TEST 5] UPDATE + verify...\n")

    r = PG_Query(conn, "UPDATE test_services SET priority = 1, restart_policy = 'always' WHERE name = 'network_mgr'")
    IfCondition EqualTo(r, 0) ThenBlock: {
        PrintMessage("[FAIL] Test 5 — UPDATE failed\n")
        fail_count = Add(fail_count, 1)
    } ElseBlock: {
        PG_DestroyResult(r)

        r2 = PG_Query(conn, "SELECT priority, restart_policy FROM test_services WHERE name = 'network_mgr'")
        IfCondition EqualTo(r2, 0) ThenBlock: {
            PrintMessage("[FAIL] Test 5 — verify SELECT failed\n")
            fail_count = Add(fail_count, 1)
        } ElseBlock: {
            rc2 = Array.Size(r2)
            IfCondition EqualTo(rc2, 1) ThenBlock: {
                vrow = Array.Get(r2, 0)
                vp = Hash.Get(vrow, "priority")
                vr = Hash.Get(vrow, "restart_policy")
                PrintMessage("  priority=")
                IfCondition NotEqual(vp, 0) ThenBlock: { PrintString(vp) }
                PrintMessage(" restart_policy=")
                IfCondition NotEqual(vr, 0) ThenBlock: { PrintString(vr) }
                PrintMessage("\n[PASS] Test 5 — UPDATE + verify\n")
                pass_count = Add(pass_count, 1)
            } ElseBlock: {
                PrintMessage("[FAIL] Test 5 — wrong row count\n")
                fail_count = Add(fail_count, 1)
            }
            PG_DestroyResult(r2)
        }
    }

    // =========================================================================
    // TEST 6: DELETE + verify count
    // =========================================================================
    PrintMessage("\n[TEST 6] DELETE + verify count...\n")

    r = PG_Query(conn, "DELETE FROM test_services WHERE enabled = false")
    IfCondition EqualTo(r, 0) ThenBlock: {
        PrintMessage("[FAIL] Test 6 — DELETE failed\n")
        fail_count = Add(fail_count, 1)
    } ElseBlock: {
        PG_DestroyResult(r)

        r2 = PG_Query(conn, "SELECT COUNT(*) AS cnt FROM test_services")
        IfCondition EqualTo(r2, 0) ThenBlock: {
            PrintMessage("[FAIL] Test 6 — COUNT failed\n")
            fail_count = Add(fail_count, 1)
        } ElseBlock: {
            crow = Array.Get(r2, 0)
            cv = Hash.Get(crow, "cnt")
            PrintMessage("  remaining rows: ")
            IfCondition NotEqual(cv, 0) ThenBlock: { PrintString(cv) }
            PrintMessage("\n[PASS] Test 6 — DELETE + COUNT verify\n")
            pass_count = Add(pass_count, 1)
            PG_DestroyResult(r2)
        }
    }

    // =========================================================================
    // TEST 7: File tree table (self-referential parent_id)
    // =========================================================================
    PrintMessage("\n[TEST 7] File tree (parent_id)...\n")

    r = PG_Query(conn, "DROP TABLE IF EXISTS test_files")
    IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

    t7_ok = 1

    r = PG_Query(conn, "CREATE TABLE test_files (id SERIAL PRIMARY KEY, parent_id INTEGER, name TEXT NOT NULL, type TEXT DEFAULT 'file')")
    IfCondition EqualTo(r, 0) ThenBlock: { t7_ok = 0 }
    IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

    r = PG_Query(conn, "ALTER TABLE test_files ADD COLUMN blob_path TEXT")
    IfCondition EqualTo(r, 0) ThenBlock: { t7_ok = 0 }
    IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

    r = PG_Query(conn, "ALTER TABLE test_files ADD COLUMN permissions TEXT DEFAULT 'rw-r--r--'")
    IfCondition EqualTo(r, 0) ThenBlock: { t7_ok = 0 }
    IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

    r = PG_Query(conn, "ALTER TABLE test_files ADD COLUMN owner TEXT DEFAULT 'bob'")
    IfCondition EqualTo(r, 0) ThenBlock: { t7_ok = 0 }
    IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

    r = PG_Query(conn, "ALTER TABLE test_files ADD COLUMN size INTEGER DEFAULT 0")
    IfCondition EqualTo(r, 0) ThenBlock: { t7_ok = 0 }
    IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

    IfCondition EqualTo(t7_ok, 0) ThenBlock: {
        PrintMessage("[FAIL] Test 7 — table creation failed\n")
        fail_count = Add(fail_count, 1)
    } ElseBlock: {
        // Build directory tree
        r = PG_Query(conn, "INSERT INTO test_files (parent_id, name, type) VALUES (NULL, '/', 'dir')")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "INSERT INTO test_files (parent_id, name, type) VALUES (1, 'home', 'dir')")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "INSERT INTO test_files (parent_id, name, type) VALUES (2, 'bob', 'dir')")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "INSERT INTO test_files (parent_id, name, type, size) VALUES (3, 'readme.txt', 'file', 1024)")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "INSERT INTO test_files (parent_id, name, type, size) VALUES (3, 'notes.md', 'file', 512)")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "INSERT INTO test_files (parent_id, name, type) VALUES (3, 'src', 'dir')")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "INSERT INTO test_files (parent_id, name, type, size, blob_path) VALUES (6, 'main.ailang', 'file', 4096, '/blobs/abc123')")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        // Query children of /home/bob
        r = PG_Query(conn, "SELECT id, name, type, size, blob_path FROM test_files WHERE parent_id = 3 ORDER BY type DESC, name")
        IfCondition EqualTo(r, 0) ThenBlock: {
            PrintMessage("[FAIL] Test 7 — tree query failed\n")
            fail_count = Add(fail_count, 1)
        } ElseBlock: {
            rc = Array.Size(r)
            PrintMessage("  /home/bob/ contents (")
            PrintNumber(rc)
            PrintMessage(" entries):\n")

            ri = 0
            WhileLoop LessThan(ri, rc) {
                row = Array.Get(r, ri)
                PrintMessage("    ")
                vt = Hash.Get(row, "type")
                IfCondition NotEqual(vt, 0) ThenBlock: { PrintString(vt) }
                PrintMessage("  ")
                vn = Hash.Get(row, "name")
                IfCondition NotEqual(vn, 0) ThenBlock: { PrintString(vn) }
                PrintMessage("  size=")
                vs = Hash.Get(row, "size")
                IfCondition NotEqual(vs, 0) ThenBlock: { PrintString(vs) }
                IfCondition EqualTo(vs, 0) ThenBlock: { PrintMessage("NULL") }
                PrintMessage("  blob=")
                vb = Hash.Get(row, "blob_path")
                IfCondition NotEqual(vb, 0) ThenBlock: { PrintString(vb) }
                IfCondition EqualTo(vb, 0) ThenBlock: { PrintMessage("NULL") }
                PrintMessage("\n")
                ri = Add(ri, 1)
            }

            IfCondition EqualTo(rc, 3) ThenBlock: {
                PrintMessage("[PASS] Test 7 — file tree with NULLs, parent_id\n")
                pass_count = Add(pass_count, 1)
            } ElseBlock: {
                PrintMessage("[FAIL] Test 7 — expected 3 children\n")
                fail_count = Add(fail_count, 1)
            }
            PG_DestroyResult(r)
        }
    }

    // =========================================================================
    // TEST 8: Settings key/value (10 rapid INSERTs + SELECT)
    // =========================================================================
    PrintMessage("\n[TEST 8] Settings table (10 INSERTs)...\n")

    r = PG_Query(conn, "DROP TABLE IF EXISTS test_settings")
    IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

    r = PG_Query(conn, "CREATE TABLE test_settings (app_id TEXT, key TEXT, value TEXT)")
    IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

    // Add composite PK separately to stay under 255
    r = PG_Query(conn, "ALTER TABLE test_settings ADD PRIMARY KEY (app_id, key)")
    IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

    t8_ok = 1

    r = PG_Query(conn, "INSERT INTO test_settings VALUES ('system', 'theme', 'dark')")
    IfCondition EqualTo(r, 0) ThenBlock: { t8_ok = 0 }
    IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

    r = PG_Query(conn, "INSERT INTO test_settings VALUES ('system', 'font_size', '14')")
    IfCondition EqualTo(r, 0) ThenBlock: { t8_ok = 0 }
    IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

    r = PG_Query(conn, "INSERT INTO test_settings VALUES ('system', 'wallpaper', '/blobs/wall001.png')")
    IfCondition EqualTo(r, 0) ThenBlock: { t8_ok = 0 }
    IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

    r = PG_Query(conn, "INSERT INTO test_settings VALUES ('terminal', 'shell', '/bin/bash')")
    IfCondition EqualTo(r, 0) ThenBlock: { t8_ok = 0 }
    IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

    r = PG_Query(conn, "INSERT INTO test_settings VALUES ('terminal', 'columns', '120')")
    IfCondition EqualTo(r, 0) ThenBlock: { t8_ok = 0 }
    IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

    r = PG_Query(conn, "INSERT INTO test_settings VALUES ('terminal', 'rows', '40')")
    IfCondition EqualTo(r, 0) ThenBlock: { t8_ok = 0 }
    IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

    r = PG_Query(conn, "INSERT INTO test_settings VALUES ('browser', 'homepage', 'about:blank')")
    IfCondition EqualTo(r, 0) ThenBlock: { t8_ok = 0 }
    IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

    r = PG_Query(conn, "INSERT INTO test_settings VALUES ('browser', 'cache_size', '256')")
    IfCondition EqualTo(r, 0) ThenBlock: { t8_ok = 0 }
    IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

    r = PG_Query(conn, "INSERT INTO test_settings VALUES ('editor', 'tab_width', '4')")
    IfCondition EqualTo(r, 0) ThenBlock: { t8_ok = 0 }
    IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

    r = PG_Query(conn, "INSERT INTO test_settings VALUES ('editor', 'line_numbers', 'true')")
    IfCondition EqualTo(r, 0) ThenBlock: { t8_ok = 0 }
    IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

    r = PG_Query(conn, "SELECT key, value FROM test_settings WHERE app_id = 'terminal' ORDER BY key")
    IfCondition EqualTo(r, 0) ThenBlock: {
        PrintMessage("[FAIL] Test 8 — settings SELECT failed\n")
        fail_count = Add(fail_count, 1)
    } ElseBlock: {
        rc = Array.Size(r)
        PrintMessage("  terminal settings (")
        PrintNumber(rc)
        PrintMessage(" entries):\n")
        ri = 0
        WhileLoop LessThan(ri, rc) {
            row = Array.Get(r, ri)
            PrintMessage("    ")
            vk = Hash.Get(row, "key")
            IfCondition NotEqual(vk, 0) ThenBlock: { PrintString(vk) }
            PrintMessage(" = ")
            vv = Hash.Get(row, "value")
            IfCondition NotEqual(vv, 0) ThenBlock: { PrintString(vv) }
            PrintMessage("\n")
            ri = Add(ri, 1)
        }

        IfCondition EqualTo(t8_ok, 1) ThenBlock: {
            PrintMessage("[PASS] Test 8 — 10 INSERTs + filtered SELECT\n")
            pass_count = Add(pass_count, 1)
        } ElseBlock: {
            PrintMessage("[FAIL] Test 8 — some INSERTs failed\n")
            fail_count = Add(fail_count, 1)
        }
        PG_DestroyResult(r)
    }

    // =========================================================================
    // TEST 9: JOIN across tables
    // =========================================================================
    PrintMessage("\n[TEST 9] JOIN across tables...\n")

    r = PG_Query(conn, "SELECT s.name, t.key, t.value FROM test_services s LEFT JOIN test_settings t ON s.name = t.app_id ORDER BY s.name, t.key")
    IfCondition EqualTo(r, 0) ThenBlock: {
        PrintMessage("[FAIL] Test 9 — JOIN failed\n")
        fail_count = Add(fail_count, 1)
    } ElseBlock: {
        rc = Array.Size(r)
        PrintMessage("  JOIN results (")
        PrintNumber(rc)
        PrintMessage(" rows):\n")

        ri = 0
        WhileLoop LessThan(ri, rc) {
            row = Array.Get(r, ri)
            PrintMessage("    svc=")
            v = Hash.Get(row, "name")
            IfCondition NotEqual(v, 0) ThenBlock: { PrintString(v) }
            PrintMessage(" key=")
            v = Hash.Get(row, "key")
            IfCondition NotEqual(v, 0) ThenBlock: { PrintString(v) }
            IfCondition EqualTo(v, 0) ThenBlock: { PrintMessage("NULL") }
            PrintMessage(" val=")
            v = Hash.Get(row, "value")
            IfCondition NotEqual(v, 0) ThenBlock: { PrintString(v) }
            IfCondition EqualTo(v, 0) ThenBlock: { PrintMessage("NULL") }
            PrintMessage("\n")
            ri = Add(ri, 1)
        }

        PrintMessage("[PASS] Test 9 — LEFT JOIN with NULLs\n")
        pass_count = Add(pass_count, 1)
        PG_DestroyResult(r)
    }

    // =========================================================================
    // TEST 10: Aggregates — COUNT, GROUP BY
    // =========================================================================
    PrintMessage("\n[TEST 10] Aggregates (COUNT, GROUP BY)...\n")

    r = PG_Query(conn, "SELECT app_id, COUNT(*) AS cnt FROM test_settings GROUP BY app_id ORDER BY cnt DESC")
    IfCondition EqualTo(r, 0) ThenBlock: {
        PrintMessage("[FAIL] Test 10 — aggregate failed\n")
        fail_count = Add(fail_count, 1)
    } ElseBlock: {
        rc = Array.Size(r)
        PrintMessage("  settings per app (")
        PrintNumber(rc)
        PrintMessage(" groups):\n")

        ri = 0
        WhileLoop LessThan(ri, rc) {
            row = Array.Get(r, ri)
            PrintMessage("    ")
            v = Hash.Get(row, "app_id")
            IfCondition NotEqual(v, 0) ThenBlock: { PrintString(v) }
            PrintMessage(": ")
            v = Hash.Get(row, "cnt")
            IfCondition NotEqual(v, 0) ThenBlock: { PrintString(v) }
            PrintMessage("\n")
            ri = Add(ri, 1)
        }

        PrintMessage("[PASS] Test 10 — COUNT + GROUP BY + ORDER BY\n")
        pass_count = Add(pass_count, 1)
        PG_DestroyResult(r)
    }

    // =========================================================================
    // TEST 11: Moderate-length text (under 255 char limit)
    // =========================================================================
    PrintMessage("\n[TEST 11] Moderate text values...\n")

    r = PG_Query(conn, "DROP TABLE IF EXISTS test_notes")
    IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

    r = PG_Query(conn, "CREATE TABLE test_notes (id SERIAL, title TEXT, body TEXT)")
    IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

    r = PG_Query(conn, "INSERT INTO test_notes (title, body) VALUES ('Build Notes', 'The compiler generates x86-64 directly. Memory is manual via Allocate and Deallocate.')")
    IfCondition EqualTo(r, 0) ThenBlock: {
        PrintMessage("[FAIL] Test 11 — text INSERT failed\n")
        fail_count = Add(fail_count, 1)
    } ElseBlock: {
        PG_DestroyResult(r)

        r2 = PG_Query(conn, "SELECT title, LENGTH(body) AS body_len FROM test_notes")
        IfCondition EqualTo(r2, 0) ThenBlock: {
            PrintMessage("[FAIL] Test 11 — text SELECT failed\n")
            fail_count = Add(fail_count, 1)
        } ElseBlock: {
            row = Array.Get(r2, 0)
            vt = Hash.Get(row, "title")
            vl = Hash.Get(row, "body_len")
            PrintMessage("  title=")
            IfCondition NotEqual(vt, 0) ThenBlock: { PrintString(vt) }
            PrintMessage(" body_length=")
            IfCondition NotEqual(vl, 0) ThenBlock: { PrintString(vl) }
            PrintMessage("\n[PASS] Test 11 — text round-trip\n")
            pass_count = Add(pass_count, 1)
            PG_DestroyResult(r2)
        }
    }

    // =========================================================================
    // TEST 12: Empty result set
    // =========================================================================
    PrintMessage("\n[TEST 12] Empty result set...\n")

    r = PG_Query(conn, "SELECT * FROM test_services WHERE name = 'nonexistent'")
    IfCondition EqualTo(r, 0) ThenBlock: {
        PrintMessage("[FAIL] Test 12 — returned null not empty XArray\n")
        fail_count = Add(fail_count, 1)
    } ElseBlock: {
        rc = Array.Size(r)
        IfCondition EqualTo(rc, 0) ThenBlock: {
            PrintMessage("[PASS] Test 12 — empty result (0 rows, valid XArray)\n")
            pass_count = Add(pass_count, 1)
        } ElseBlock: {
            PrintMessage("[FAIL] Test 12 — expected 0 rows\n")
            fail_count = Add(fail_count, 1)
        }
        PG_DestroyResult(r)
    }

    // =========================================================================
    // TEST 13: Subquery
    // =========================================================================
    PrintMessage("\n[TEST 13] Subquery...\n")

    r = PG_Query(conn, "SELECT name, priority FROM test_services WHERE priority < (SELECT AVG(priority) FROM test_services) ORDER BY priority")
    IfCondition EqualTo(r, 0) ThenBlock: {
        PrintMessage("[FAIL] Test 13 — subquery failed\n")
        fail_count = Add(fail_count, 1)
    } ElseBlock: {
        rc = Array.Size(r)
        PrintMessage("  below avg priority (")
        PrintNumber(rc)
        PrintMessage(" rows):\n")

        ri = 0
        WhileLoop LessThan(ri, rc) {
            row = Array.Get(r, ri)
            PrintMessage("    ")
            v = Hash.Get(row, "name")
            IfCondition NotEqual(v, 0) ThenBlock: { PrintString(v) }
            PrintMessage(" pri=")
            v = Hash.Get(row, "priority")
            IfCondition NotEqual(v, 0) ThenBlock: { PrintString(v) }
            PrintMessage("\n")
            ri = Add(ri, 1)
        }

        PrintMessage("[PASS] Test 13 — subquery with AVG\n")
        pass_count = Add(pass_count, 1)
        PG_DestroyResult(r)
    }

    // =========================================================================
    // CLEANUP
    // =========================================================================
    PrintMessage("\n--- Cleanup ---\n")

    r = PG_Query(conn, "DROP TABLE IF EXISTS stress_a")
    IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

    r = PG_Query(conn, "DROP TABLE IF EXISTS test_services")
    IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

    r = PG_Query(conn, "DROP TABLE IF EXISTS test_files")
    IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

    r = PG_Query(conn, "DROP TABLE IF EXISTS test_settings")
    IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

    r = PG_Query(conn, "DROP TABLE IF EXISTS test_notes")
    IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

    PrintMessage("[OK] All test tables dropped\n")

    // =========================================================================
    // SUMMARY
    // =========================================================================
    PG_Disconnect(conn)
    PrintMessage("[OK] Disconnected\n\n")

    PrintMessage("============================================\n")
    PrintMessage("  RESULTS: ")
    PrintNumber(pass_count)
    PrintMessage(" passed, ")
    PrintNumber(fail_count)
    PrintMessage(" failed (")
    PrintNumber(Add(pass_count, fail_count))
    PrintMessage(" total)\n")
    PrintMessage("============================================\n")
}

RunTask(Main)