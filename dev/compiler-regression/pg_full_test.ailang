LibraryImport.Arena
LibraryImport.Socket
LibraryImport.Hash
LibraryImport.Arrays
LibraryImport.StringUtils
LibraryImport.PostgreSQL_Complete

SubRoutine.Main {
    Arena_Init()
    pass_count = 0
    fail_count = 0

    PrintMessage("============================================\n")
    PrintMessage("  PostgreSQL Library Full Test Suite\n")
    PrintMessage("============================================\n\n")

    // =========================================================================
    // TEST 0: TCP Connect (trust auth on this host)
    // =========================================================================
    PrintMessage("[TEST 0] TCP Connect...\n")
    conn = PG_Connect("127.0.0.1", 5432, "ailang_system", "bob", "")
    IfCondition EqualTo(conn, 0) ThenBlock: {
        PrintMessage("[FATAL] Cannot connect to PostgreSQL\n")
        HaltProgram
    }
    PrintMessage("[PASS] Connected via TCP\n")
    pass_count = Add(pass_count, 1)

    // =========================================================================
    // TEST 1: Basic DDL and DML
    // =========================================================================
    PrintMessage("\n[TEST 1] DDL and DML...\n")

    r = PG_Query(conn, "DROP TABLE IF EXISTS pg_test_suite")
    IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

    r = PG_Query(conn, "CREATE TABLE pg_test_suite (id SERIAL PRIMARY KEY, name TEXT, val INTEGER)")
    IfCondition EqualTo(r, 0) ThenBlock: {
        PrintMessage("[FAIL] CREATE TABLE\n")
        fail_count = Add(fail_count, 1)
    } ElseBlock: {
        PG_DestroyResult(r)
        PrintMessage("[PASS] CREATE TABLE\n")
        pass_count = Add(pass_count, 1)
    }

    r = PG_Query(conn, "INSERT INTO pg_test_suite (name, val) VALUES ('alpha', 10)")
    IfCondition EqualTo(r, 0) ThenBlock: {
        PrintMessage("[FAIL] INSERT 1\n")
        fail_count = Add(fail_count, 1)
    } ElseBlock: {
        PG_DestroyResult(r)
        PrintMessage("[PASS] INSERT 1\n")
        pass_count = Add(pass_count, 1)
    }

    r = PG_Query(conn, "INSERT INTO pg_test_suite (name, val) VALUES ('beta', 20)")
    IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

    r = PG_Query(conn, "INSERT INTO pg_test_suite (name, val) VALUES ('gamma', 30)")
    IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

    // =========================================================================
    // TEST 2: SELECT and row/column access
    // =========================================================================
    PrintMessage("\n[TEST 2] SELECT row/column access...\n")
    r = PG_Query(conn, "SELECT id, name, val FROM pg_test_suite ORDER BY id")
    IfCondition EqualTo(r, 0) ThenBlock: {
        PrintMessage("[FAIL] SELECT query returned 0\n")
        fail_count = Add(fail_count, 1)
    } ElseBlock: {
        rc = Array.Size(r)
        IfCondition EqualTo(rc, 3) ThenBlock: {
            PrintMessage("[PASS] SELECT returned 3 rows\n")
            pass_count = Add(pass_count, 1)

            row0 = Array.Get(r, 0)
            n0 = Hash.Get(row0, "name")
            IfCondition NotEqual(n0, 0) ThenBlock: {
                PrintMessage("[INFO] row 0 name = ")
                PrintString(n0)
                PrintMessage("\n")
            }
        } ElseBlock: {
            PrintMessage("[FAIL] Expected 3 rows, got ")
            PrintNumber(rc)
            PrintMessage("\n")
            fail_count = Add(fail_count, 1)
        }
        PG_DestroyResult(r)
    }

    // =========================================================================
    // TEST 3: Error recovery — query after SQL error (drain-to-ready test)
    // =========================================================================
    PrintMessage("\n[TEST 3] Error recovery (drain-to-ready)...\n")

    // This should produce an SQL error (table does not exist)
    r = PG_Query(conn, "SELECT * FROM nonexistent_table_12345")
    IfCondition NotEqual(r, 0) ThenBlock: {
        PrintMessage("[WARN] Error query unexpectedly succeeded\n")
        PG_DestroyResult(r)
    } ElseBlock: {
        PrintMessage("[INFO] Error query correctly returned 0\n")
    }

    // This query MUST succeed — if drain-to-ready works, connection is still good
    r = PG_Query(conn, "SELECT 42 AS answer")
    IfCondition EqualTo(r, 0) ThenBlock: {
        PrintMessage("[FAIL] Query after error returned 0 - connection out of sync!\n")
        fail_count = Add(fail_count, 1)
    } ElseBlock: {
        rc = Array.Size(r)
        IfCondition EqualTo(rc, 1) ThenBlock: {
            row0 = Array.Get(r, 0)
            v = Hash.Get(row0, "answer")
            IfCondition NotEqual(v, 0) ThenBlock: {
                PrintMessage("[PASS] Query after error works, answer=")
                PrintString(v)
                PrintMessage("\n")
                pass_count = Add(pass_count, 1)
            } ElseBlock: {
                PrintMessage("[FAIL] answer column is null\n")
                fail_count = Add(fail_count, 1)
            }
        } ElseBlock: {
            PrintMessage("[FAIL] Expected 1 row, got ")
            PrintNumber(rc)
            PrintMessage("\n")
            fail_count = Add(fail_count, 1)
        }
        PG_DestroyResult(r)
    }

    // =========================================================================
    // TEST 4: Multiple errors in a row (repeated drain-to-ready)
    // =========================================================================
    PrintMessage("\n[TEST 4] Multiple consecutive errors...\n")
    err_i = 0
    WhileLoop LessThan(err_i, 5) {
        r = PG_Query(conn, "INSERT INTO nonexistent_xyz VALUES (1)")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        err_i = Add(err_i, 1)
    }

    r = PG_Query(conn, "SELECT 99 AS check_val")
    IfCondition EqualTo(r, 0) ThenBlock: {
        PrintMessage("[FAIL] Query after 5 errors failed\n")
        fail_count = Add(fail_count, 1)
    } ElseBlock: {
        rc = Array.Size(r)
        IfCondition EqualTo(rc, 1) ThenBlock: {
            PrintMessage("[PASS] Connection survived 5 consecutive errors\n")
            pass_count = Add(pass_count, 1)
        } ElseBlock: {
            PrintMessage("[FAIL] Wrong row count after errors\n")
            fail_count = Add(fail_count, 1)
        }
        PG_DestroyResult(r)
    }

    // =========================================================================
    // TEST 5: Constraint violation error recovery
    // =========================================================================
    PrintMessage("\n[TEST 5] Constraint violation recovery...\n")
    r = PG_Query(conn, "DROP TABLE IF EXISTS pg_test_unique")
    IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

    r = PG_Query(conn, "CREATE TABLE pg_test_unique (id INTEGER UNIQUE)")
    IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

    r = PG_Query(conn, "INSERT INTO pg_test_unique VALUES (1)")
    IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

    // This should fail (duplicate key)
    r = PG_Query(conn, "INSERT INTO pg_test_unique VALUES (1)")
    IfCondition NotEqual(r, 0) ThenBlock: {
        PrintMessage("[WARN] Duplicate insert unexpectedly succeeded\n")
        PG_DestroyResult(r)
    }

    // Connection must still work
    r = PG_Query(conn, "SELECT COUNT(*) AS cnt FROM pg_test_unique")
    IfCondition EqualTo(r, 0) ThenBlock: {
        PrintMessage("[FAIL] Query after constraint violation failed\n")
        fail_count = Add(fail_count, 1)
    } ElseBlock: {
        rc = Array.Size(r)
        IfCondition EqualTo(rc, 1) ThenBlock: {
            PrintMessage("[PASS] Constraint violation recovery\n")
            pass_count = Add(pass_count, 1)
        } ElseBlock: {
            PrintMessage("[FAIL] Wrong row count\n")
            fail_count = Add(fail_count, 1)
        }
        PG_DestroyResult(r)
    }

    // =========================================================================
    // TEST 6: Empty result set
    // =========================================================================
    PrintMessage("\n[TEST 6] Empty result set...\n")
    r = PG_Query(conn, "SELECT * FROM pg_test_suite WHERE val > 9999")
    IfCondition EqualTo(r, 0) ThenBlock: {
        PrintMessage("[FAIL] Empty result query returned 0\n")
        fail_count = Add(fail_count, 1)
    } ElseBlock: {
        rc = Array.Size(r)
        IfCondition EqualTo(rc, 0) ThenBlock: {
            PrintMessage("[PASS] Empty result: 0 rows\n")
            pass_count = Add(pass_count, 1)
        } ElseBlock: {
            PrintMessage("[FAIL] Expected 0 rows, got ")
            PrintNumber(rc)
            PrintMessage("\n")
            fail_count = Add(fail_count, 1)
        }
        PG_DestroyResult(r)
    }

    // =========================================================================
    // TEST 7: Large result set (>1000 rows, tests raised iteration cap)
    // =========================================================================
    PrintMessage("\n[TEST 7] Large result set (2000 rows)...\n")
    r = PG_Query(conn, "SELECT generate_series(1, 2000) AS n")
    IfCondition EqualTo(r, 0) ThenBlock: {
        PrintMessage("[FAIL] Large query returned 0\n")
        fail_count = Add(fail_count, 1)
    } ElseBlock: {
        rc = Array.Size(r)
        IfCondition EqualTo(rc, 2000) ThenBlock: {
            PrintMessage("[PASS] Got all 2000 rows\n")
            pass_count = Add(pass_count, 1)
        } ElseBlock: {
            PrintMessage("[FAIL] Expected 2000 rows, got ")
            PrintNumber(rc)
            PrintMessage("\n")
            fail_count = Add(fail_count, 1)
        }
        PG_DestroyResult(r)
    }

    // Verify connection still works after large result
    r = PG_Query(conn, "SELECT 1 AS alive")
    IfCondition EqualTo(r, 0) ThenBlock: {
        PrintMessage("[FAIL] Connection dead after large result\n")
        fail_count = Add(fail_count, 1)
    } ElseBlock: {
        PrintMessage("[PASS] Connection alive after large result\n")
        pass_count = Add(pass_count, 1)
        PG_DestroyResult(r)
    }

    // =========================================================================
    // TEST 8: Multiple result destroy (memory leak test)
    // =========================================================================
    PrintMessage("\n[TEST 8] Rapid query + destroy cycle (100x)...\n")
    leak_i = 0
    leak_ok = 1
    WhileLoop LessThan(leak_i, 100) {
        r = PG_Query(conn, "SELECT 'hello' AS msg, 'world' AS target")
        IfCondition EqualTo(r, 0) ThenBlock: {
            leak_ok = 0
            PrintMessage("[FAIL] Query failed at iteration ")
            PrintNumber(leak_i)
            PrintMessage("\n")
            leak_i = 100
        } ElseBlock: {
            PG_DestroyResult(r)
        }
        leak_i = Add(leak_i, 1)
    }
    IfCondition EqualTo(leak_ok, 1) ThenBlock: {
        PrintMessage("[PASS] 100 query/destroy cycles completed\n")
        pass_count = Add(pass_count, 1)
    } ElseBlock: {
        fail_count = Add(fail_count, 1)
    }

    // =========================================================================
    // TEST 9: NULL value handling
    // =========================================================================
    PrintMessage("\n[TEST 9] NULL value handling...\n")
    r = PG_Query(conn, "SELECT NULL AS empty_col, 'notnull' AS full_col")
    IfCondition EqualTo(r, 0) ThenBlock: {
        PrintMessage("[FAIL] NULL test query returned 0\n")
        fail_count = Add(fail_count, 1)
    } ElseBlock: {
        rc = Array.Size(r)
        IfCondition EqualTo(rc, 1) ThenBlock: {
            row0 = Array.Get(r, 0)
            nv = Hash.Get(row0, "empty_col")
            fv = Hash.Get(row0, "full_col")
            IfCondition EqualTo(nv, 0) ThenBlock: {
                PrintMessage("[PASS] NULL column returned 0\n")
                pass_count = Add(pass_count, 1)
            } ElseBlock: {
                PrintMessage("[FAIL] NULL column was not 0\n")
                fail_count = Add(fail_count, 1)
            }
            IfCondition NotEqual(fv, 0) ThenBlock: {
                PrintMessage("[PASS] Non-null column has value: ")
                PrintString(fv)
                PrintMessage("\n")
                pass_count = Add(pass_count, 1)
            } ElseBlock: {
                PrintMessage("[FAIL] Non-null column is 0\n")
                fail_count = Add(fail_count, 1)
            }
        } ElseBlock: {
            PrintMessage("[FAIL] Wrong row count\n")
            fail_count = Add(fail_count, 1)
        }
        PG_DestroyResult(r)
    }

    // =========================================================================
    // TEST 10: Unix socket connect
    // =========================================================================
    PrintMessage("\n[TEST 10] Unix socket connect...\n")
    uconn = PG_ConnectUnix("/var/run/postgresql", 5432, "ailang_system", "bob", "")
    IfCondition EqualTo(uconn, 0) ThenBlock: {
        PrintMessage("[FAIL] Unix socket connect failed\n")
        fail_count = Add(fail_count, 1)
    } ElseBlock: {
        r = PG_Query(uconn, "SELECT 'unix_ok' AS status")
        IfCondition EqualTo(r, 0) ThenBlock: {
            PrintMessage("[FAIL] Unix socket query failed\n")
            fail_count = Add(fail_count, 1)
        } ElseBlock: {
            rc = Array.Size(r)
            IfCondition EqualTo(rc, 1) ThenBlock: {
                PrintMessage("[PASS] Unix socket query works\n")
                pass_count = Add(pass_count, 1)
            } ElseBlock: {
                PrintMessage("[FAIL] Unix socket wrong row count\n")
                fail_count = Add(fail_count, 1)
            }
            PG_DestroyResult(r)
        }

        // Test error recovery on unix socket too
        r = PG_Query(uconn, "SELECT * FROM no_such_table_abc")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(uconn, "SELECT 'still_ok' AS status")
        IfCondition EqualTo(r, 0) ThenBlock: {
            PrintMessage("[FAIL] Unix: query after error failed\n")
            fail_count = Add(fail_count, 1)
        } ElseBlock: {
            PrintMessage("[PASS] Unix: error recovery works\n")
            pass_count = Add(pass_count, 1)
            PG_DestroyResult(r)
        }

        PG_Disconnect(uconn)
    }

    // =========================================================================
    // TEST 11: Multiple columns, many data types
    // =========================================================================
    PrintMessage("\n[TEST 11] Multiple data types...\n")
    r = PG_Query(conn, "SELECT 42 AS int_val, 3.14::TEXT AS float_val, 'hello world' AS text_val, TRUE::TEXT AS bool_val")
    IfCondition EqualTo(r, 0) ThenBlock: {
        PrintMessage("[FAIL] Multi-type query returned 0\n")
        fail_count = Add(fail_count, 1)
    } ElseBlock: {
        rc = Array.Size(r)
        IfCondition EqualTo(rc, 1) ThenBlock: {
            row0 = Array.Get(r, 0)
            iv = Hash.Get(row0, "int_val")
            tv = Hash.Get(row0, "text_val")
            IfCondition And(NotEqual(iv, 0), NotEqual(tv, 0)) ThenBlock: {
                PrintMessage("[PASS] Multi-type: int=")
                PrintString(iv)
                PrintMessage(", text=")
                PrintString(tv)
                PrintMessage("\n")
                pass_count = Add(pass_count, 1)
            } ElseBlock: {
                PrintMessage("[FAIL] Multi-type columns missing\n")
                fail_count = Add(fail_count, 1)
            }
        } ElseBlock: {
            PrintMessage("[FAIL] Wrong row count\n")
            fail_count = Add(fail_count, 1)
        }
        PG_DestroyResult(r)
    }

    // =========================================================================
    // TEST 12: UPDATE and DELETE
    // =========================================================================
    PrintMessage("\n[TEST 12] UPDATE and DELETE...\n")
    r = PG_Query(conn, "UPDATE pg_test_suite SET val = 999 WHERE name = 'alpha'")
    IfCondition EqualTo(r, 0) ThenBlock: {
        PrintMessage("[FAIL] UPDATE failed\n")
        fail_count = Add(fail_count, 1)
    } ElseBlock: {
        PG_DestroyResult(r)
    }

    r = PG_Query(conn, "SELECT val FROM pg_test_suite WHERE name = 'alpha'")
    IfCondition EqualTo(r, 0) ThenBlock: {
        PrintMessage("[FAIL] SELECT after UPDATE\n")
        fail_count = Add(fail_count, 1)
    } ElseBlock: {
        rc = Array.Size(r)
        IfCondition EqualTo(rc, 1) ThenBlock: {
            row0 = Array.Get(r, 0)
            v = Hash.Get(row0, "val")
            IfCondition NotEqual(v, 0) ThenBlock: {
                PrintMessage("[PASS] UPDATE verified: val=")
                PrintString(v)
                PrintMessage("\n")
                pass_count = Add(pass_count, 1)
            } ElseBlock: {
                PrintMessage("[FAIL] val is null after UPDATE\n")
                fail_count = Add(fail_count, 1)
            }
        } ElseBlock: {
            PrintMessage("[FAIL] Wrong row count after UPDATE\n")
            fail_count = Add(fail_count, 1)
        }
        PG_DestroyResult(r)
    }

    r = PG_Query(conn, "DELETE FROM pg_test_suite WHERE name = 'gamma'")
    IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

    r = PG_Query(conn, "SELECT COUNT(*) AS cnt FROM pg_test_suite")
    IfCondition EqualTo(r, 0) ThenBlock: {
        PrintMessage("[FAIL] COUNT after DELETE\n")
        fail_count = Add(fail_count, 1)
    } ElseBlock: {
        rc = Array.Size(r)
        IfCondition EqualTo(rc, 1) ThenBlock: {
            row0 = Array.Get(r, 0)
            v = Hash.Get(row0, "cnt")
            IfCondition NotEqual(v, 0) ThenBlock: {
                PrintMessage("[PASS] DELETE verified: remaining=")
                PrintString(v)
                PrintMessage("\n")
                pass_count = Add(pass_count, 1)
            } ElseBlock: {
                PrintMessage("[FAIL] cnt is null\n")
                fail_count = Add(fail_count, 1)
            }
        } ElseBlock: {
            PrintMessage("[FAIL] Wrong row count\n")
            fail_count = Add(fail_count, 1)
        }
        PG_DestroyResult(r)
    }

    // =========================================================================
    // CLEANUP
    // =========================================================================
    r = PG_Query(conn, "DROP TABLE IF EXISTS pg_test_suite")
    IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

    r = PG_Query(conn, "DROP TABLE IF EXISTS pg_test_unique")
    IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

    PG_Disconnect(conn)

    // =========================================================================
    // RESULTS
    // =========================================================================
    PrintMessage("\n============================================\n")
    PrintMessage("  Results: ")
    PrintNumber(pass_count)
    PrintMessage(" passed, ")
    PrintNumber(fail_count)
    PrintMessage(" failed\n")
    PrintMessage("============================================\n")

    IfCondition GreaterThan(fail_count, 0) ThenBlock: {
        HaltProgram
    }
}

RunTask(Main)
