LibraryImport.Arena
LibraryImport.Socket
LibraryImport.Hash
LibraryImport.Arrays
LibraryImport.StringUtils
LibraryImport.PostgreSQL_Complete
LibraryImport.Crypto

SubRoutine.Main {
    Arena_Init()
    pass_count = 0
    fail_count = 0

    PrintMessage("============================================\n")
    PrintMessage("  SCRAM Helpers Unit Tests\n")
    PrintMessage("============================================\n\n")

    // =========================================================================
    // TEST 1: Base64 encode "n,,"  ->  "biws"
    // =========================================================================
    PrintMessage("[TEST 1] Base64 encode 'n,,' -> 'biws'...\n")
    gs2 = "n,,"
    enc = PG_Base64Encode(gs2, 3)
    enc_len = StringLength(enc)
    // "biws" is base64 of "n,,"
    IfCondition EqualTo(enc_len, 4) ThenBlock: {
        b0 = GetByte(enc, 0)
        b1 = GetByte(enc, 1)
        b2 = GetByte(enc, 2)
        b3 = GetByte(enc, 3)
        // b=98 i=105 w=119 s=115
        c0 = EqualTo(b0, 98)
        c1 = EqualTo(b1, 105)
        c2 = EqualTo(b2, 119)
        c3 = EqualTo(b3, 115)
        IfCondition And(And(c0, c1), And(c2, c3)) ThenBlock: {
            PrintMessage("[PASS] Encoded: ")
            PrintString(enc)
            PrintMessage("\n")
            pass_count = Add(pass_count, 1)
        } ElseBlock: {
            PrintMessage("[FAIL] Got: ")
            PrintString(enc)
            PrintMessage("\n")
            fail_count = Add(fail_count, 1)
        }
    } ElseBlock: {
        PrintMessage("[FAIL] Wrong length: ")
        PrintNumber(enc_len)
        PrintMessage("\n")
        fail_count = Add(fail_count, 1)
    }
    Deallocate(enc, Add(enc_len, 1))

    // =========================================================================
    // TEST 2: Base64 decode "biws" -> "n,,"
    // =========================================================================
    PrintMessage("\n[TEST 2] Base64 decode 'biws' -> 'n,,'...\n")
    src = "biws"
    dec = PG_Base64Decode(src, 4)
    dec_len = PG_Base64DecodeLen(src, 4)
    IfCondition EqualTo(dec_len, 3) ThenBlock: {
        d0 = GetByte(dec, 0)
        d1 = GetByte(dec, 1)
        d2 = GetByte(dec, 2)
        // n=110 ,=44 ,=44
        e0 = EqualTo(d0, 110)
        e1 = EqualTo(d1, 44)
        e2 = EqualTo(d2, 44)
        IfCondition And(e0, And(e1, e2)) ThenBlock: {
            PrintMessage("[PASS] Decoded correctly\n")
            pass_count = Add(pass_count, 1)
        } ElseBlock: {
            PrintMessage("[FAIL] Wrong bytes: ")
            PrintNumber(d0)
            PrintMessage(" ")
            PrintNumber(d1)
            PrintMessage(" ")
            PrintNumber(d2)
            PrintMessage("\n")
            fail_count = Add(fail_count, 1)
        }
    } ElseBlock: {
        PrintMessage("[FAIL] Wrong decoded length: ")
        PrintNumber(dec_len)
        PrintMessage("\n")
        fail_count = Add(fail_count, 1)
    }
    Deallocate(dec, Add(Divide(Multiply(4, 3), 4), 2))

    // =========================================================================
    // TEST 3: Base64 round-trip with padding
    // =========================================================================
    PrintMessage("\n[TEST 3] Base64 round-trip (32 bytes)...\n")
    // Create a known 32-byte buffer
    test_buf = Allocate(32)
    ti = 0
    WhileLoop LessThan(ti, 32) {
        SetByte(test_buf, ti, Add(ti, 65))
        ti = Add(ti, 1)
    }
    // Encode
    rt_enc = PG_Base64Encode(test_buf, 32)
    rt_enc_len = StringLength(rt_enc)
    // Decode
    rt_dec = PG_Base64Decode(rt_enc, rt_enc_len)
    rt_dec_len = PG_Base64DecodeLen(rt_enc, rt_enc_len)

    IfCondition EqualTo(rt_dec_len, 32) ThenBlock: {
        rt_match = 1
        ri = 0
        WhileLoop LessThan(ri, 32) {
            IfCondition NotEqual(GetByte(rt_dec, ri), GetByte(test_buf, ri)) ThenBlock: {
                rt_match = 0
            }
            ri = Add(ri, 1)
        }
        IfCondition EqualTo(rt_match, 1) ThenBlock: {
            PrintMessage("[PASS] Round-trip matches (32 bytes)\n")
            pass_count = Add(pass_count, 1)
        } ElseBlock: {
            PrintMessage("[FAIL] Round-trip mismatch\n")
            fail_count = Add(fail_count, 1)
        }
    } ElseBlock: {
        PrintMessage("[FAIL] Decoded length ")
        PrintNumber(rt_dec_len)
        PrintMessage(" != 32\n")
        fail_count = Add(fail_count, 1)
    }
    Deallocate(test_buf, 32)
    Deallocate(rt_enc, Add(rt_enc_len, 1))
    Deallocate(rt_dec, Add(Divide(Multiply(rt_enc_len, 3), 4), 2))

    // =========================================================================
    // TEST 4: HMAC-SHA256 known vector
    // =========================================================================
    PrintMessage("\n[TEST 4] HMAC-SHA256 basic...\n")
    // HMAC-SHA256("key", "The quick brown fox jumps over the lazy dog")
    // Known result starts with: f7bc83f4...
    hkey = "key"
    hmsg = "The quick brown fox jumps over the lazy dog"
    hout = Crypto.HMAC_SHA256(hkey, 3, hmsg, 43)
    hex = Crypto.DigestHex(hout)
    PrintMessage("[INFO] HMAC = ")
    PrintString(hex)
    PrintMessage("\n")
    // Check first byte: 0xf7 = 247
    hb0 = GetByte(hout, 0)
    IfCondition EqualTo(hb0, 247) ThenBlock: {
        PrintMessage("[PASS] HMAC first byte matches (0xf7)\n")
        pass_count = Add(pass_count, 1)
    } ElseBlock: {
        PrintMessage("[FAIL] HMAC first byte: ")
        PrintNumber(hb0)
        PrintMessage(" expected 247\n")
        fail_count = Add(fail_count, 1)
    }
    Deallocate(hex, 65)
    Deallocate(hout, 33)

    // =========================================================================
    // TEST 5: PBKDF2 runs without crash
    // =========================================================================
    PrintMessage("\n[TEST 5] PBKDF2-SHA256 (10 iterations)...\n")
    ppass = "password"
    psalt = "salt1234"
    dk = PG_PBKDF2_SHA256(ppass, 8, psalt, 8, 10)
    IfCondition NotEqual(dk, 0) ThenBlock: {
        dk_hex = Crypto.DigestHex(dk)
        PrintMessage("[PASS] PBKDF2 produced key: ")
        PrintString(dk_hex)
        PrintMessage("\n")
        pass_count = Add(pass_count, 1)
        Deallocate(dk_hex, 65)
        Deallocate(dk, 32)
    } ElseBlock: {
        PrintMessage("[FAIL] PBKDF2 returned 0\n")
        fail_count = Add(fail_count, 1)
    }

    // =========================================================================
    // TEST 6: PBKDF2 with 4096 iterations (typical SCRAM)
    // =========================================================================
    PrintMessage("\n[TEST 6] PBKDF2-SHA256 (4096 iterations)...\n")
    dk2 = PG_PBKDF2_SHA256("pencil", 6, "saltsalt", 8, 4096)
    IfCondition NotEqual(dk2, 0) ThenBlock: {
        dk2_hex = Crypto.DigestHex(dk2)
        PrintMessage("[PASS] PBKDF2 4096 iters: ")
        PrintString(dk2_hex)
        PrintMessage("\n")
        pass_count = Add(pass_count, 1)
        Deallocate(dk2_hex, 65)
        Deallocate(dk2, 32)
    } ElseBlock: {
        PrintMessage("[FAIL] PBKDF2 4096 returned 0\n")
        fail_count = Add(fail_count, 1)
    }

    // =========================================================================
    // TEST 7: XOR bytes
    // =========================================================================
    PrintMessage("\n[TEST 7] XOR bytes...\n")
    xa = Allocate(4)
    xb = Allocate(4)
    xd = Allocate(4)
    SetByte(xa, 0, 255)
    SetByte(xa, 1, 0)
    SetByte(xa, 2, 170)
    SetByte(xa, 3, 85)
    SetByte(xb, 0, 255)
    SetByte(xb, 1, 255)
    SetByte(xb, 2, 85)
    SetByte(xb, 3, 170)
    PG_XorBytes(xd, xa, xb, 4)
    // 255^255=0, 0^255=255, 170^85=255, 85^170=255
    x0 = GetByte(xd, 0)
    x1 = GetByte(xd, 1)
    x2 = GetByte(xd, 2)
    x3 = GetByte(xd, 3)
    xp0 = EqualTo(x0, 0)
    xp1 = EqualTo(x1, 255)
    xp2 = EqualTo(x2, 255)
    xp3 = EqualTo(x3, 255)
    IfCondition And(And(xp0, xp1), And(xp2, xp3)) ThenBlock: {
        PrintMessage("[PASS] XOR bytes correct\n")
        pass_count = Add(pass_count, 1)
    } ElseBlock: {
        PrintMessage("[FAIL] XOR: ")
        PrintNumber(x0)
        PrintMessage(" ")
        PrintNumber(x1)
        PrintMessage(" ")
        PrintNumber(x2)
        PrintMessage(" ")
        PrintNumber(x3)
        PrintMessage("\n")
        fail_count = Add(fail_count, 1)
    }
    Deallocate(xa, 4)
    Deallocate(xb, 4)
    Deallocate(xd, 4)

    // =========================================================================
    // RESULTS
    // =========================================================================
    PrintMessage("\n============================================\n")
    PrintMessage("  Results: ")
    PrintNumber(pass_count)
    PrintMessage(" passed, ")
    PrintNumber(fail_count)
    PrintMessage(" failed\n")
    PrintMessage("============================================\n")

    IfCondition GreaterThan(fail_count, 0) ThenBlock: {
        HaltProgram
    }
}

RunTask(Main)
