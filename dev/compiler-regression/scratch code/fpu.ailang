// test_fpu_emit.ailang
// Standalone test for FPU/SSE2 emit functions
// Location: Tests/FPU/test_fpu_emit.ailang
//
// Tests byte emission without involving the compiler
// Run with: ./ailang_console_exec then load/run this file
//
// Each test:
//   1. Records starting code_size
//   2. Calls emit function(s)
//   3. Verifies bytes emitted match expected
//   4. Reports PASS/FAIL

LibraryImport.Compiler.CodeEmit.CEmitCore
LibraryImport.Compiler.CodeEmit.CEmitTypes
LibraryImport.Compiler.Compile.FPU.FPUTypes
LibraryImport.Compiler.Compile.FPU.X86.FPUEmitX86SSE
LibraryImport.Compiler.Compile.FPU.X86.FPUEmitX86MemOps

// =============================================================================
// TEST UTILITIES
// =============================================================================

// Global test counters
FixedPool.Test {
    "passed": Initialize=0, CanChange=True
    "failed": Initialize=0, CanChange=True
    "total": Initialize=0, CanChange=True
}

// Check if byte at offset matches expected
Function.CheckByte {
    Input: offset: Integer
    Input: expected: Integer
    Output: Integer
    Body: {
        addr = Add(Emit.code, offset)
        actual = Dereference(addr, "byte")
        IfCondition EqualTo(actual, expected) ThenBlock: {
            ReturnValue(1)
        }
        
        PrintMessage("    MISMATCH at offset ")
        PrintNumber(offset)
        PrintMessage(": expected ")
        PrintNumber(expected)
        PrintMessage(" got ")
        PrintNumber(actual)
        PrintMessage("\n")
        ReturnValue(0)
    }
}

// Verify a sequence of bytes starting at offset
Function.VerifyBytes {
    Input: start_offset: Integer
    Input: byte0: Integer
    Input: byte1: Integer
    Input: byte2: Integer
    Input: byte3: Integer
    Input: count: Integer
    Output: Integer
    Body: {
        ok = 1
        
        IfCondition GreaterEqual(count, 1) ThenBlock: {
            result = CheckByte(start_offset, byte0)
            IfCondition EqualTo(result, 0) ThenBlock: { ok = 0 }
        }
        
        IfCondition GreaterEqual(count, 2) ThenBlock: {
            result = CheckByte(Add(start_offset, 1), byte1)
            IfCondition EqualTo(result, 0) ThenBlock: { ok = 0 }
        }
        
        IfCondition GreaterEqual(count, 3) ThenBlock: {
            result = CheckByte(Add(start_offset, 2), byte2)
            IfCondition EqualTo(result, 0) ThenBlock: { ok = 0 }
        }
        
        IfCondition GreaterEqual(count, 4) ThenBlock: {
            result = CheckByte(Add(start_offset, 3), byte3)
            IfCondition EqualTo(result, 0) ThenBlock: { ok = 0 }
        }
        
        ReturnValue(ok)
    }
}

// Report test result
Function.ReportTest {
    Input: name: Address
    Input: passed: Integer
    Body: {
        Test.total = Add(Test.total, 1)
        
        IfCondition EqualTo(passed, 1) ThenBlock: {
            Test.passed = Add(Test.passed, 1)
            PrintMessage("[PASS] ")
        } ElseBlock: {
            Test.failed = Add(Test.failed, 1)
            PrintMessage("[FAIL] ")
        }
        
        PrintMessage(name)
        PrintMessage("\n")
    }
}

// =============================================================================
// SSE SCALAR DOUBLE TESTS
// =============================================================================

Function.Test_ADDSD {
    Body: {
        start = Emit.code_size
        
        X86_ADDSD_XMM0_XMM1()
        
        // Expected: F2 0F 58 C1 (4 bytes)
        bytes_emitted = Subtract(Emit.code_size, start)
        
        ok = 1
        IfCondition NotEqual(bytes_emitted, 4) ThenBlock: {
            PrintMessage("    Wrong byte count: ")
            PrintNumber(bytes_emitted)
            PrintMessage("\n")
            ok = 0
        }
        
        IfCondition EqualTo(ok, 1) ThenBlock: {
            ok = VerifyBytes(start, 242, 15, 88, 193, 4)  // F2 0F 58 C1
        }
        
        ReportTest("ADDSD XMM0, XMM1", ok)
    }
}

Function.Test_SUBSD {
    Body: {
        start = Emit.code_size
        X86_SUBSD_XMM0_XMM1()
        
        ok = VerifyBytes(start, 242, 15, 92, 193, 4)  // F2 0F 5C C1
        ReportTest("SUBSD XMM0, XMM1", ok)
    }
}

Function.Test_MULSD {
    Body: {
        start = Emit.code_size
        X86_MULSD_XMM0_XMM1()
        
        ok = VerifyBytes(start, 242, 15, 89, 193, 4)  // F2 0F 59 C1
        ReportTest("MULSD XMM0, XMM1", ok)
    }
}

Function.Test_DIVSD {
    Body: {
        start = Emit.code_size
        X86_DIVSD_XMM0_XMM1()
        
        ok = VerifyBytes(start, 242, 15, 94, 193, 4)  // F2 0F 5E C1
        ReportTest("DIVSD XMM0, XMM1", ok)
    }
}

Function.Test_SQRTSD {
    Body: {
        start = Emit.code_size
        X86_SQRTSD_XMM0()
        
        ok = VerifyBytes(start, 242, 15, 81, 192, 4)  // F2 0F 51 C0
        ReportTest("SQRTSD XMM0, XMM0", ok)
    }
}

// =============================================================================
// CONVERSION TESTS
// =============================================================================

Function.Test_CVTSI2SD {
    Body: {
        start = Emit.code_size
        X86_CVTSI2SD_XMM0_RAX()
        
        // Expected: F2 48 0F 2A C0 (5 bytes)
        bytes_emitted = Subtract(Emit.code_size, start)
        
        ok = 1
        IfCondition NotEqual(bytes_emitted, 5) ThenBlock: {
            PrintMessage("    Wrong byte count: ")
            PrintNumber(bytes_emitted)
            PrintMessage(" expected 5\n")
            ok = 0
        }
        
        IfCondition EqualTo(ok, 1) ThenBlock: {
            ok = VerifyBytes(start, 242, 72, 15, 42, 4)  // F2 48 0F 2A
            // Check 5th byte separately
            IfCondition EqualTo(ok, 1) ThenBlock: {
                ok = CheckByte(Add(start, 4), 192)  // C0
            }
        }
        
        ReportTest("CVTSI2SD XMM0, RAX", ok)
    }
}

Function.Test_CVTTSD2SI {
    Body: {
        start = Emit.code_size
        X86_CVTTSD2SI_RAX_XMM0()
        
        // Expected: F2 48 0F 2C C0 (5 bytes)
        ok = VerifyBytes(start, 242, 72, 15, 44, 4)  // F2 48 0F 2C
        IfCondition EqualTo(ok, 1) ThenBlock: {
            ok = CheckByte(Add(start, 4), 192)  // C0
        }
        
        ReportTest("CVTTSD2SI RAX, XMM0", ok)
    }
}

// =============================================================================
// PACKED DOUBLE TESTS
// =============================================================================

Function.Test_ADDPD {
    Body: {
        start = Emit.code_size
        X86_ADDPD_XMM0_XMM1()
        
        ok = VerifyBytes(start, 102, 15, 88, 193, 4)  // 66 0F 58 C1
        ReportTest("ADDPD XMM0, XMM1", ok)
    }
}

Function.Test_MULPD {
    Body: {
        start = Emit.code_size
        X86_MULPD_XMM0_XMM1()
        
        ok = VerifyBytes(start, 102, 15, 89, 193, 4)  // 66 0F 59 C1
        ReportTest("MULPD XMM0, XMM1", ok)
    }
}

// =============================================================================
// XMM MOVE TESTS
// =============================================================================

Function.Test_MOVSD_Regs {
    Body: {
        start = Emit.code_size
        X86_MOVSD_XMM0_XMM1()
        
        ok = VerifyBytes(start, 242, 15, 16, 193, 4)  // F2 0F 10 C1
        ReportTest("MOVSD XMM0, XMM1", ok)
    }
}

Function.Test_PXOR {
    Body: {
        start = Emit.code_size
        X86_PXOR_XMM0_XMM0()
        
        ok = VerifyBytes(start, 102, 15, 239, 192, 4)  // 66 0F EF C0
        ReportTest("PXOR XMM0, XMM0 (zero)", ok)
    }
}

// =============================================================================
// MEMORY OPERATION TESTS
// =============================================================================

Function.Test_MOVDQU_Load {
    Body: {
        start = Emit.code_size
        X86_MOVDQU_XMM0_DerefRSI()
        
        ok = VerifyBytes(start, 243, 15, 111, 6, 4)  // F3 0F 6F 06
        ReportTest("MOVDQU XMM0, [RSI]", ok)
    }
}

Function.Test_MOVDQU_Store {
    Body: {
        start = Emit.code_size
        X86_MOVDQU_DerefRDI_XMM0()
        
        ok = VerifyBytes(start, 243, 15, 127, 7, 4)  // F3 0F 7F 07
        ReportTest("MOVDQU [RDI], XMM0", ok)
    }
}

Function.Test_PCMPEQB {
    Body: {
        start = Emit.code_size
        X86_PCMPEQB_XMM0_XMM1()
        
        ok = VerifyBytes(start, 102, 15, 116, 193, 4)  // 66 0F 74 C1
        ReportTest("PCMPEQB XMM0, XMM1", ok)
    }
}

Function.Test_PMOVMSKB {
    Body: {
        start = Emit.code_size
        X86_PMOVMSKB_EAX_XMM0()
        
        ok = VerifyBytes(start, 102, 15, 215, 192, 4)  // 66 0F D7 C0
        ReportTest("PMOVMSKB EAX, XMM0", ok)
    }
}

Function.Test_BSF {
    Body: {
        start = Emit.code_size
        X86_BSF_EDX_EAX()
        
        ok = VerifyBytes(start, 15, 188, 208, 0, 3)  // 0F BC D0
        ReportTest("BSF EDX, EAX", ok)
    }
}

// =============================================================================
// BROADCAST TEST (composite)
// =============================================================================

Function.Test_Broadcast {
    Body: {
        start = Emit.code_size
        X86_BroadcastAL_XMM0()
        
        // This is a sequence: MOVD + PUNPCKLBW + PSHUFLW + PSHUFD
        // Total should be 4 + 4 + 5 + 5 = 18 bytes
        bytes_emitted = Subtract(Emit.code_size, start)
        
        ok = 1
        IfCondition NotEqual(bytes_emitted, 18) ThenBlock: {
            PrintMessage("    Wrong byte count: ")
            PrintNumber(bytes_emitted)
            PrintMessage(" expected 18\n")
            ok = 0
        }
        
        // Just check first instruction (MOVD XMM0, EAX = 66 0F 6E C0)
        IfCondition EqualTo(ok, 1) ThenBlock: {
            ok = VerifyBytes(start, 102, 15, 110, 192, 4)
        }
        
        ReportTest("BroadcastAL_XMM0 (composite)", ok)
    }
}

// =============================================================================
// POINTER ARITHMETIC TESTS
// =============================================================================

Function.Test_AddRSI16 {
    Body: {
        start = Emit.code_size
        X86_AddRSI_16()
        
        ok = VerifyBytes(start, 72, 131, 198, 16, 4)  // 48 83 C6 10
        ReportTest("ADD RSI, 16", ok)
    }
}

Function.Test_SubRCX16 {
    Body: {
        start = Emit.code_size
        X86_SubRCX_16()
        
        ok = VerifyBytes(start, 72, 131, 233, 16, 4)  // 48 83 E9 10
        ReportTest("SUB RCX, 16", ok)
    }
}

// =============================================================================
// XMM STACK TESTS
// =============================================================================

Function.Test_PushPopXMM0 {
    Body: {
        start = Emit.code_size
        X86_PushXMM0()
        
        // SUB RSP, 8 (4 bytes) + MOVSD [RSP], XMM0 (5 bytes) = 9 bytes
        bytes_after_push = Subtract(Emit.code_size, start)
        
        X86_PopXMM0()
        
        // MOVSD XMM0, [RSP] (5 bytes) + ADD RSP, 8 (4 bytes) = 9 more bytes
        total_bytes = Subtract(Emit.code_size, start)
        
        ok = 1
        IfCondition NotEqual(total_bytes, 18) ThenBlock: {
            PrintMessage("    Wrong total bytes: ")
            PrintNumber(total_bytes)
            PrintMessage(" expected 18\n")
            ok = 0
        }
        
        ReportTest("Push/Pop XMM0", ok)
    }
}

// =============================================================================
// MAIN TEST RUNNER
// =============================================================================

SubRoutine.Main {
    PrintMessage("==============================================\n")
    PrintMessage("FPU/SSE2 Emit Layer Test Suite\n")
    PrintMessage("==============================================\n\n")
    
    // Initialize emit buffer
    Emit_Init()
    
    PrintMessage("--- Scalar Double Arithmetic ---\n")
    Test_ADDSD()
    Test_SUBSD()
    Test_MULSD()
    Test_DIVSD()
    Test_SQRTSD()
    
    PrintMessage("\n--- Conversions ---\n")
    Test_CVTSI2SD()
    Test_CVTTSD2SI()
    
    PrintMessage("\n--- Packed Double ---\n")
    Test_ADDPD()
    Test_MULPD()
    
    PrintMessage("\n--- XMM Moves ---\n")
    Test_MOVSD_Regs()
    Test_PXOR()
    
    PrintMessage("\n--- Memory Operations ---\n")
    Test_MOVDQU_Load()
    Test_MOVDQU_Store()
    Test_PCMPEQB()
    Test_PMOVMSKB()
    Test_BSF()
    
    PrintMessage("\n--- Composite Operations ---\n")
    Test_Broadcast()
    
    PrintMessage("\n--- Pointer Arithmetic ---\n")
    Test_AddRSI16()
    Test_SubRCX16()
    
    PrintMessage("\n--- Stack Operations ---\n")
    Test_PushPopXMM0()
    
    // Summary
    PrintMessage("\n==============================================\n")
    PrintMessage("Results: ")
    PrintNumber(Test.passed)
    PrintMessage(" passed, ")
    PrintNumber(Test.failed)
    PrintMessage(" failed, ")
    PrintNumber(Test.total)
    PrintMessage(" total\n")
    PrintMessage("==============================================\n")
    
    PrintMessage("\nTotal bytes emitted: ")
    PrintNumber(Emit.code_size)
    PrintMessage("\n")
    
    // Cleanup
    Emit_Free()
    
    IfCondition EqualTo(Test.failed, 0) ThenBlock: {
        PrintMessage("\nAll tests PASSED!\n")
    } ElseBlock: {
        PrintMessage("\nSome tests FAILED!\n")
    }
}

RunTask(Main)