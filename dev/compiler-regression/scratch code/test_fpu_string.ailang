// test_fpu_string.ailang
// Test SSE2-accelerated string operations
// Location: Tests/String/test_fpu_string.ailang

SubRoutine.TestStringLength {
    PrintMessage("=== StringLength (SSE2) Tests ===\n")
    
    result = StringLength("Hello")
    PrintMessage("StringLength(\"Hello\") = ")
    PrintNumber(result)
    IfCondition EqualTo(result, 5) ThenBlock: {
        PrintMessage(" [OK]\n")
    } ElseBlock: {
        PrintMessage(" [FAIL]\n")
    }
    
    result = StringLength("")
    PrintMessage("StringLength(\"\") = ")
    PrintNumber(result)
    IfCondition EqualTo(result, 0) ThenBlock: {
        PrintMessage(" [OK]\n")
    } ElseBlock: {
        PrintMessage(" [FAIL]\n")
    }
    
    result = StringLength("This is a longer string for SSE2 testing!")
    PrintMessage("StringLength(\"This is a longer string for SSE2 testing!\") = ")
    PrintNumber(result)
    IfCondition EqualTo(result, 41) ThenBlock: {
        PrintMessage(" [OK]\n")
    } ElseBlock: {
        PrintMessage(" [FAIL]\n")
    }
    
    // Test Strlen alias
    result = Strlen("AILang")
    PrintMessage("Strlen(\"AILang\") = ")
    PrintNumber(result)
    IfCondition EqualTo(result, 6) ThenBlock: {
        PrintMessage(" [OK]\n")
    } ElseBlock: {
        PrintMessage(" [FAIL]\n")
    }
}

SubRoutine.TestStringCompare {
    PrintMessage("\n=== StringCompare (SSE2) Tests ===\n")
    
    result = StringCompare("Hello", "Hello")
    PrintMessage("StringCompare(\"Hello\", \"Hello\") = ")
    PrintNumber(result)
    IfCondition EqualTo(result, 0) ThenBlock: {
        PrintMessage(" [OK] (equal)\n")
    } ElseBlock: {
        PrintMessage(" [FAIL]\n")
    }
    
    result = StringCompare("Apple", "Banana")
    PrintMessage("StringCompare(\"Apple\", \"Banana\") = ")
    PrintNumber(result)
    IfCondition LessThan(result, 0) ThenBlock: {
        PrintMessage(" [OK] (Apple < Banana)\n")
    } ElseBlock: {
        PrintMessage(" [FAIL]\n")
    }
    
    result = StringCompare("Zebra", "Apple")
    PrintMessage("StringCompare(\"Zebra\", \"Apple\") = ")
    PrintNumber(result)
    IfCondition GreaterThan(result, 0) ThenBlock: {
        PrintMessage(" [OK] (Zebra > Apple)\n")
    } ElseBlock: {
        PrintMessage(" [FAIL]\n")
    }
    
    result = StringCompare("Test", "Testing")
    PrintMessage("StringCompare(\"Test\", \"Testing\") = ")
    PrintNumber(result)
    IfCondition LessThan(result, 0) ThenBlock: {
        PrintMessage(" [OK] (shorter < longer)\n")
    } ElseBlock: {
        PrintMessage(" [FAIL]\n")
    }
    
    // Long string comparison (tests SSE2 path)
    result = StringCompare("AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA")
    PrintMessage("StringCompare(34 A's, 34 A's) = ")
    PrintNumber(result)
    IfCondition EqualTo(result, 0) ThenBlock: {
        PrintMessage(" [OK]\n")
    } ElseBlock: {
        PrintMessage(" [FAIL]\n")
    }
}

SubRoutine.TestStringEquals {
    PrintMessage("\n=== StringEquals (SSE2) Tests ===\n")
    
    result = StringEquals("Hello", "Hello")
    PrintMessage("StringEquals(\"Hello\", \"Hello\") = ")
    PrintNumber(result)
    IfCondition EqualTo(result, 1) ThenBlock: {
        PrintMessage(" [OK]\n")
    } ElseBlock: {
        PrintMessage(" [FAIL]\n")
    }
    
    result = StringEquals("Hello", "World")
    PrintMessage("StringEquals(\"Hello\", \"World\") = ")
    PrintNumber(result)
    IfCondition EqualTo(result, 0) ThenBlock: {
        PrintMessage(" [OK]\n")
    } ElseBlock: {
        PrintMessage(" [FAIL]\n")
    }
    
    result = StringEquals("", "")
    PrintMessage("StringEquals(\"\", \"\") = ")
    PrintNumber(result)
    IfCondition EqualTo(result, 1) ThenBlock: {
        PrintMessage(" [OK]\n")
    } ElseBlock: {
        PrintMessage(" [FAIL]\n")
    }
    
    result = StringEquals("Short", "Shorter")
    PrintMessage("StringEquals(\"Short\", \"Shorter\") = ")
    PrintNumber(result)
    IfCondition EqualTo(result, 0) ThenBlock: {
        PrintMessage(" [OK]\n")
    } ElseBlock: {
        PrintMessage(" [FAIL]\n")
    }
}

SubRoutine.TestStringCopy {
    PrintMessage("\n=== StringCopy (SSE2) Tests ===\n")
    
    dest = Allocate(256)
    
    result = StringCopy(dest, "Hello World")
    PrintMessage("StringCopy(dest, \"Hello World\") -> ")
    PrintMessage(dest)
    cmp = StringEquals(dest, "Hello World")
    IfCondition EqualTo(cmp, 1) ThenBlock: {
        PrintMessage(" [OK]\n")
    } ElseBlock: {
        PrintMessage(" [FAIL]\n")
    }
    
    // Long string copy (tests SSE2 path)
    longstr = "This is a much longer string that will definitely use the SSE2 loop path!"
    result = StringCopy(dest, longstr)
    PrintMessage("StringCopy(dest, 73-char string) -> len=")
    len = StringLength(dest)
    PrintNumber(len)
    IfCondition EqualTo(len, 73) ThenBlock: {
        PrintMessage(" [OK]\n")
    } ElseBlock: {
        PrintMessage(" [FAIL]\n")
    }
    
    // Test Strcpy alias
    result = Strcpy(dest, "Alias")
    PrintMessage("Strcpy(dest, \"Alias\") -> ")
    PrintMessage(dest)
    PrintMessage("\n")
    
    Deallocate(dest, 256)
}

SubRoutine.TestStringIndexOf {
    PrintMessage("\n=== StringIndexOf (SSE2) Tests ===\n")
    
    result = StringIndexOf("Hello World", 87)  // 'W' = 87
    PrintMessage("StringIndexOf(\"Hello World\", 'W') = ")
    PrintNumber(result)
    IfCondition EqualTo(result, 6) ThenBlock: {
        PrintMessage(" [OK]\n")
    } ElseBlock: {
        PrintMessage(" [FAIL]\n")
    }
    
    result = StringIndexOf("Hello World", 111)  // 'o' = 111
    PrintMessage("StringIndexOf(\"Hello World\", 'o') = ")
    PrintNumber(result)
    IfCondition EqualTo(result, 4) ThenBlock: {
        PrintMessage(" [OK] (first occurrence)\n")
    } ElseBlock: {
        PrintMessage(" [FAIL]\n")
    }
    
    result = StringIndexOf("Hello World", 122)  // 'z' = 122 (not found)
    PrintMessage("StringIndexOf(\"Hello World\", 'z') = ")
    PrintNumber(result)
    IfCondition EqualTo(result, -1) ThenBlock: {
        PrintMessage(" [OK] (not found)\n")
    } ElseBlock: {
        PrintMessage(" [FAIL]\n")
    }
    
    result = StringIndexOf("Hello", 72)  // 'H' at position 0
    PrintMessage("StringIndexOf(\"Hello\", 'H') = ")
    PrintNumber(result)
    IfCondition EqualTo(result, 0) ThenBlock: {
        PrintMessage(" [OK]\n")
    } ElseBlock: {
        PrintMessage(" [FAIL]\n")
    }
    
    // Test Strchr alias
    result = Strchr("Testing", 105)  // 'i' = 105
    PrintMessage("Strchr(\"Testing\", 'i') = ")
    PrintNumber(result)
    IfCondition EqualTo(result, 4) ThenBlock: {
        PrintMessage(" [OK]\n")
    } ElseBlock: {
        PrintMessage(" [FAIL]\n")
    }
}

SubRoutine.TestStringContains {
    PrintMessage("\n=== StringContains (SSE2) Tests ===\n")
    
    result = StringContains("Hello World", 87)  // 'W'
    PrintMessage("StringContains(\"Hello World\", 'W') = ")
    PrintNumber(result)
    IfCondition EqualTo(result, 1) ThenBlock: {
        PrintMessage(" [OK]\n")
    } ElseBlock: {
        PrintMessage(" [FAIL]\n")
    }
    
    result = StringContains("Hello World", 122)  // 'z'
    PrintMessage("StringContains(\"Hello World\", 'z') = ")
    PrintNumber(result)
    IfCondition EqualTo(result, 0) ThenBlock: {
        PrintMessage(" [OK]\n")
    } ElseBlock: {
        PrintMessage(" [FAIL]\n")
    }
    
    result = StringContains("ABC", 65)  // 'A'
    PrintMessage("StringContains(\"ABC\", 'A') = ")
    PrintNumber(result)
    IfCondition EqualTo(result, 1) ThenBlock: {
        PrintMessage(" [OK]\n")
    } ElseBlock: {
        PrintMessage(" [FAIL]\n")
    }
}

SubRoutine.Main {
    PrintMessage("==============================================\n")
    PrintMessage("FPU SSE2 String Operations Test\n")
    PrintMessage("==============================================\n\n")
    
    TestStringLength()
    TestStringCompare()
    TestStringEquals()
    TestStringCopy()
    TestStringIndexOf()
    TestStringContains()
    
    PrintMessage("\n==============================================\n")
    PrintMessage("FPU String Test Complete!\n")
    PrintMessage("==============================================\n")
}

RunTask(Main)