// test_string_core.ailang
// Test StringCore operations for Python compiler equivalence
// Location: Tests/String/test_string_core.ailang

SubRoutine.TestStringConcat {
    PrintMessage("=== StringConcat Tests ===\n")
    
    result = StringConcat("Hello", "World")
    PrintMessage("StringConcat(\"Hello\", \"World\") = ")
    PrintMessage(result)
    PrintMessage("\n")
    
    result = StringConcat("Foo", "Bar")
    PrintMessage("StringConcat(\"Foo\", \"Bar\") = ")
    PrintMessage(result)
    PrintMessage("\n")
    
    result = StringConcat("", "Empty")
    PrintMessage("StringConcat(\"\", \"Empty\") = ")
    PrintMessage(result)
    PrintMessage("\n")
}

SubRoutine.TestNumberToString {
    PrintMessage("\n=== NumberToString Tests ===\n")
    
    result = NumberToString(42)
    PrintMessage("NumberToString(42) = ")
    PrintMessage(result)
    PrintMessage("\n")
    
    result = NumberToString(0)
    PrintMessage("NumberToString(0) = ")
    PrintMessage(result)
    PrintMessage("\n")
    
    result = NumberToString(-123)
    PrintMessage("NumberToString(-123) = ")
    PrintMessage(result)
    PrintMessage("\n")
    
    result = NumberToString(9876543)
    PrintMessage("NumberToString(9876543) = ")
    PrintMessage(result)
    PrintMessage("\n")
}

SubRoutine.TestStringToNumber {
    PrintMessage("\n=== StringToNumber Tests ===\n")
    
    result = StringToNumber("42")
    PrintMessage("StringToNumber(\"42\") = ")
    PrintNumber(result)
    IfCondition EqualTo(result, 42) ThenBlock: {
        PrintMessage(" [OK]\n")
    } ElseBlock: {
        PrintMessage(" [FAIL]\n")
    }
    
    result = StringToNumber("-99")
    PrintMessage("StringToNumber(\"-99\") = ")
    PrintNumber(result)
    IfCondition EqualTo(result, -99) ThenBlock: {
        PrintMessage(" [OK]\n")
    } ElseBlock: {
        PrintMessage(" [FAIL]\n")
    }
    
    result = StringToNumber("  123")
    PrintMessage("StringToNumber(\"  123\") = ")
    PrintNumber(result)
    IfCondition EqualTo(result, 123) ThenBlock: {
        PrintMessage(" [OK]\n")
    } ElseBlock: {
        PrintMessage(" [FAIL]\n")
    }
    
    result = StringToNumber("0")
    PrintMessage("StringToNumber(\"0\") = ")
    PrintNumber(result)
    IfCondition EqualTo(result, 0) ThenBlock: {
        PrintMessage(" [OK]\n")
    } ElseBlock: {
        PrintMessage(" [FAIL]\n")
    }
}

SubRoutine.TestStringSubstring {
    PrintMessage("\n=== StringSubstring Tests ===\n")
    
    result = StringSubstring("HelloWorld", 0, 5)
    PrintMessage("StringSubstring(\"HelloWorld\", 0, 5) = ")
    PrintMessage(result)
    PrintMessage("\n")
    
    result = StringSubstring("HelloWorld", 5, 10)
    PrintMessage("StringSubstring(\"HelloWorld\", 5, 10) = ")
    PrintMessage(result)
    PrintMessage("\n")
    
    result = StringSubstring("ABCDEF", 2, 4)
    PrintMessage("StringSubstring(\"ABCDEF\", 2, 4) = ")
    PrintMessage(result)
    PrintMessage("\n")
    
    // Test StringExtract alias
    result = StringExtract("Testing", 0, 4)
    PrintMessage("StringExtract(\"Testing\", 0, 4) = ")
    PrintMessage(result)
    PrintMessage("\n")
}

SubRoutine.TestStringCharAt {
    PrintMessage("\n=== StringCharAt Tests ===\n")
    
    result = StringCharAt("Hello", 0)
    PrintMessage("StringCharAt(\"Hello\", 0) = ")
    PrintNumber(result)
    IfCondition EqualTo(result, 72) ThenBlock: {
        PrintMessage(" [OK] ('H'=72)\n")
    } ElseBlock: {
        PrintMessage(" [FAIL] expected 72\n")
    }
    
    result = StringCharAt("Hello", 4)
    PrintMessage("StringCharAt(\"Hello\", 4) = ")
    PrintNumber(result)
    IfCondition EqualTo(result, 111) ThenBlock: {
        PrintMessage(" [OK] ('o'=111)\n")
    } ElseBlock: {
        PrintMessage(" [FAIL] expected 111\n")
    }
    
    result = StringCharAt("ABC", 1)
    PrintMessage("StringCharAt(\"ABC\", 1) = ")
    PrintNumber(result)
    IfCondition EqualTo(result, 66) ThenBlock: {
        PrintMessage(" [OK] ('B'=66)\n")
    } ElseBlock: {
        PrintMessage(" [FAIL] expected 66\n")
    }
}

SubRoutine.TestStringFromChar {
    PrintMessage("\n=== StringFromChar Tests ===\n")
    
    result = StringFromChar(65)
    PrintMessage("StringFromChar(65) = ")
    PrintMessage(result)
    PrintMessage(" [expect 'A']\n")
    
    result = StringFromChar(90)
    PrintMessage("StringFromChar(90) = ")
    PrintMessage(result)
    PrintMessage(" [expect 'Z']\n")
    
    result = StringFromChar(48)
    PrintMessage("StringFromChar(48) = ")
    PrintMessage(result)
    PrintMessage(" [expect '0']\n")
}

SubRoutine.TestStringToUpper {
    PrintMessage("\n=== StringToUpper Tests ===\n")
    
    result = StringToUpper("hello")
    PrintMessage("StringToUpper(\"hello\") = ")
    PrintMessage(result)
    PrintMessage("\n")
    
    result = StringToUpper("Hello World")
    PrintMessage("StringToUpper(\"Hello World\") = ")
    PrintMessage(result)
    PrintMessage("\n")
    
    result = StringToUpper("ABC123")
    PrintMessage("StringToUpper(\"ABC123\") = ")
    PrintMessage(result)
    PrintMessage("\n")
}

SubRoutine.TestStringToLower {
    PrintMessage("\n=== StringToLower Tests ===\n")
    
    result = StringToLower("HELLO")
    PrintMessage("StringToLower(\"HELLO\") = ")
    PrintMessage(result)
    PrintMessage("\n")
    
    result = StringToLower("Hello World")
    PrintMessage("StringToLower(\"Hello World\") = ")
    PrintMessage(result)
    PrintMessage("\n")
    
    result = StringToLower("abc123")
    PrintMessage("StringToLower(\"abc123\") = ")
    PrintMessage(result)
    PrintMessage("\n")
}

SubRoutine.TestStringTrim {
    PrintMessage("\n=== StringTrim Tests ===\n")
    
    result = StringTrim("  hello  ")
    PrintMessage("StringTrim(\"  hello  \") = [")
    PrintMessage(result)
    PrintMessage("]\n")
    
    result = StringTrim("   spaces   ")
    PrintMessage("StringTrim(\"   spaces   \") = [")
    PrintMessage(result)
    PrintMessage("]\n")
    
    result = StringTrim("nochange")
    PrintMessage("StringTrim(\"nochange\") = [")
    PrintMessage(result)
    PrintMessage("]\n")
}

SubRoutine.Main {
    PrintMessage("==============================================\n")
    PrintMessage("StringCore Library Test\n")
    PrintMessage("==============================================\n\n")
    
    TestStringConcat()
    TestNumberToString()
    TestStringToNumber()
    TestStringSubstring()
    TestStringCharAt()
    TestStringFromChar()
    TestStringToUpper()
    TestStringToLower()
    TestStringTrim()
    
    PrintMessage("\n==============================================\n")
    PrintMessage("StringCore Test Complete!\n")
    PrintMessage("==============================================\n")
}

RunTask(Main)