// xarray_minimal.ailang
// Absolute minimum test - isolate crash point

LibraryImport.Arrays
LibraryImport.Arena

PrintMessage("Step 1: About to call Arena_Init\n")
Arena_Init()
PrintMessage("Step 2: Arena_Init complete\n")

PrintMessage("Step 3: About to call Array.Create(8)\n")
arr = Array.Create(8)
PrintMessage("Step 4: XCreate returned: ")
PrintNumber(arr)
PrintMessage("\n")

PrintMessage("Step 5: About to call Array.Size\n")
sz = Array.Size(arr)
PrintMessage("Step 6: Size = ")
PrintNumber(sz)
PrintMessage("\n")

PrintMessage("Step 7: About to call Array.Push\n")
Array.Push(arr, 42)
PrintMessage("Step 8: Push complete\n")

PrintMessage("Step 9: About to call Array.Get(0)\n")
val = Array.Get(arr, 0)
PrintMessage("Step 10: Got value = ")
PrintNumber(val)
PrintMessage("\n")

PrintMessage("Step 11: About to destroy\n")
Array.Destroy(arr)
PrintMessage("Step 12: Destroy complete\n")

PrintMessage("\n=== ALL STEPS PASSED ===\n")
Arena_Report()