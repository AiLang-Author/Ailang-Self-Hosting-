LibraryImport.Arena
LibraryImport.Media.Sample
LibraryImport.Media.SF2
LibraryImport.Media.Synth

SubRoutine.Main {
    Arena_Init()
    PrintMessage("load GU\n")
    bank = SF2_Load("/home/bob/Downloads/GeneralUser-GS.sf2")
    PrintMessage("bank=")
    PrintNumber(bank)
    PrintMessage("\n")
    SF2_SetNth(0)
    smp = SF2_LookupP(bank, 67, 100, 96, 0)
    PrintMessage("smp=")
    PrintNumber(smp)
    PrintMessage(" root=")
    PrintNumber(SF2_LastRoot())
    PrintMessage(" fc=")
    PrintNumber(SF2_LastFc())
    PrintMessage(" e2f=")
    PrintNumber(SF2_LastE2f())
    PrintMessage(" at=")
    PrintNumber(SF2_LastAtten())
    PrintMessage("\n")
    IfCondition EqualTo(smp, 0) ThenBlock: { ReturnValue(0) }
    nfr = Dereference(Add(smp, 16))
    rate = Dereference(Add(smp, 24))
    PrintMessage("n=")
    PrintNumber(nfr)
    PrintMessage(" srate=")
    PrintNumber(rate)
    PrintMessage(" mode=")
    PrintNumber(Dereference(Add(smp, 56)))
    PrintMessage(" ls=")
    PrintNumber(Dereference(Add(smp, 40)))
    PrintMessage(" le=")
    PrintNumber(Dereference(Add(smp, 48)))
    PrintMessage("\n")
    syn = Synth_New(4, 48000)
    Synth_SetMixGain(syn, 128)
    Synth_VoiceOnSample(syn, 0, smp, 67, 100)
    playfc = Add(SF2_LastFc(), SF2_LastE2f())
    Synth_SetFilterCents(syn, 0, playfc, SF2_LastQ())
    v = Synth_Voice(syn, 0)
    PrintMessage("STEP=")
    PrintNumber(Dereference(Add(v, 8)))
    PrintMessage(" CUTOFF=")
    PrintNumber(Dereference(Add(v, 96), "dword"))
    PrintMessage(" RES=")
    PrintNumber(Dereference(Add(v, 104), "dword"))
    PrintMessage(" WAVE=")
    PrintNumber(GetByte(v, 16))
    PrintMessage("\n")
    frames = 24000
    buf = Allocate(Multiply(frames, 2))
    MemorySet(buf, 0, Multiply(frames, 2))
    Synth_RenderS16(syn, buf, frames)
    zc = Synth_ZeroCross(buf, frames)
    PrintMessage("zcr_halfsec=")
    PrintNumber(zc)
    uq = Synth_UniqueLevels(buf, frames)
    PrintMessage(" uniq=")
    PrintNumber(uq)
    PrintMessage("\n")
    Synth_WriteWav16("/tmp/ice_engine.wav", buf, frames, 48000)
    PrintMessage("wrote /tmp/ice_engine.wav\n")
    Synth_Free(syn)
}

RunTask(Main)
