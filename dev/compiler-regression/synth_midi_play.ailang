// synth_midi_play.ailang
// Load a SMF, drive the sine bank, write wav + try AudioEngine.
// Build: ./ailang.x dev/compiler-regression/synth_midi_play.ailang /tmp/synth_midi_play.x
// Run:   /tmp/synth_midi_play.x

LibraryImport.Arena
LibraryImport.Media.MIDI
LibraryImport.Media.Synth
LibraryImport.Display.Render.AudioEngine

FixedPool.Play {
    "rate": Initialize=48000
}

Function.Play_TickFrames {
    Input: song: Address
    Input: tick: Integer
    Output: Integer
    Body: {
        us = MIDI_TickToUS(song, tick)
        ReturnValue(Divide(Multiply(us, Play.rate), 1000000))
    }
}

Function.Play_Apply {
    Input: syn: Address
    Input: ev: Address
    Body: {
        kind = MIDI_EvKind(ev)
        IfCondition NotEqual(kind, 1) ThenBlock: { ReturnValue(0) }
        st = MIDI_EvStatus(ev)
        hi = BitwiseAnd(st, 240)
        d1 = MIDI_EvD1(ev)
        d2 = MIDI_EvD2(ev)
        IfCondition EqualTo(hi, 144) ThenBlock: {
            ch = MIDI_EvCh(ev)
            IfCondition EqualTo(d2, 0) ThenBlock: {
                Synth_NoteOff(syn, d1, ch)
            } ElseBlock: {
                vi = Synth_AllocVoice(syn, d1, ch)
                Synth_VoiceOnNote(syn, vi, 0, d1, d2)
            }
        }
        IfCondition EqualTo(hi, 128) ThenBlock: {
            ch = MIDI_EvCh(ev)
            Synth_NoteOff(syn, d1, ch)
        }
    }
}

SubRoutine.Main {
    Arena_Init()
    PrintMessage("MIDI → synth: tests/midi/cmaj_song.mid\n")

    song = MIDI_SongLoadPath("tests/midi/cmaj_song.mid")
    IfCondition EqualTo(song, 0) ThenBlock: {
        PrintMessage("failed to load MIDI\n")
        ReturnValue(0)
    }
    PrintMessage("  format=")
    PrintNumber(MIDI_SongFormat(song))
    PrintMessage(" tracks=")
    PrintNumber(MIDI_SongTracks(song))
    PrintMessage(" events=")
    PrintNumber(MIDI_SongCount(song))
    PrintMessage(" tempo=")
    PrintNumber(MIDI_SongTempo(song))
    PrintMessage("\n")

    cnt = MIDI_SongCount(song)
    last_tick = 0
    i = 0
    WhileLoop LessThan(i, cnt) {
        ev = MIDI_SongEvent(song, i)
        tk = MIDI_EvTick(ev)
        IfCondition GreaterThan(tk, last_tick) ThenBlock: { last_tick = tk }
        i = Add(i, 1)
    }
    tail = Play_TickFrames(song, last_tick)
    total = Add(tail, 72000)
    PrintMessage("  last tick=")
    PrintNumber(last_tick)
    PrintMessage(" frames=")
    PrintNumber(total)
    PrintMessage("\n")

    syn = Synth_New(32, Play.rate)
    vi = 0
    WhileLoop LessThan(vi, 8) {
        Synth_SetADSR(syn, vi, 12, 120, 160, 250)
        Synth_SetFilter(syn, vi, 96, 48)
        vi = Add(vi, 1)
    }
    Synth_SetDelay(syn, 280, 90, 70)
    Synth_SetMixGain(syn, 180)
    stereo = Allocate(Multiply(total, 4))
    MemorySet(stereo, 0, Multiply(total, 4))

    ev_i = 0
    cur = 0
    WhileLoop LessThan(cur, total) {
        WhileLoop LessThan(ev_i, cnt) {
            ev = MIDI_SongEvent(song, ev_i)
            ef = Play_TickFrames(song, MIDI_EvTick(ev))
            IfCondition GreaterThan(ef, cur) ThenBlock: {
                ev_i = Add(ev_i, 100000)
            } ElseBlock: {
                Play_Apply(syn, ev)
                ev_i = Add(ev_i, 1)
            }
        }
        IfCondition GreaterEqual(ev_i, 100000) ThenBlock: {
            ev_i = Subtract(ev_i, 100000)
        }
        nxt = total
        IfCondition LessThan(ev_i, cnt) ThenBlock: {
            ev = MIDI_SongEvent(song, ev_i)
            nxt = Play_TickFrames(song, MIDI_EvTick(ev))
            IfCondition GreaterThan(nxt, total) ThenBlock: { nxt = total }
        }
        n = Subtract(nxt, cur)
        IfCondition GreaterThan(n, 0) ThenBlock: {
            dst = Add(stereo, Multiply(cur, 4))
            Synth_RenderS16Stereo(syn, dst, n)
        }
        cur = nxt
        IfCondition EqualTo(n, 0) ThenBlock: {
            IfCondition GreaterEqual(ev_i, cnt) ThenBlock: {
                cur = total
            }
        }
    }

    mono = Allocate(Multiply(total, 2))
    f = 0
    WhileLoop LessThan(f, total) {
        SetByte(mono, Multiply(f, 2), GetByte(stereo, Multiply(f, 4)))
        SetByte(mono, Add(Multiply(f, 2), 1), GetByte(stereo, Add(Multiply(f, 4), 1)))
        f = Add(f, 1)
    }
    nw = Synth_WriteWav16("/tmp/synth_midi.wav", mono, total, Play.rate)
    PrintMessage("wrote /tmp/synth_midi.wav bytes=")
    PrintNumber(nw)
    PrintMessage("\n")

    r = Audio_Init()
    IfCondition NotEqual(r, 0) ThenBlock: {
        PrintMessage("ALSA busy; paplay the wav\n")
    } ElseBlock: {
        Mixer_SetMasterVol(320)
        Mixer_SetAppVol(320)
        bytes = Multiply(total, 4)
        off = 0
        period_bytes = Multiply(AudioState.period_size, AudioState.frame_bytes)
        IfCondition LessThan(period_bytes, 1) ThenBlock: { period_bytes = 4096 }
        WhileLoop LessThan(off, bytes) {
            n = Subtract(bytes, off)
            IfCondition GreaterThan(n, period_bytes) ThenBlock: { n = period_bytes }
            Mixer_AppWrite(Add(stereo, off), n)
            Mixer_DrainTick()
            off = Add(off, n)
        }
        Audio_Drain()
        Audio_Shutdown()
        PrintMessage("played through AudioEngine\n")
    }

    Deallocate(mono, Multiply(total, 2))
    Deallocate(stereo, Multiply(total, 4))
    Synth_Free(syn)
    MIDI_SongFree(song)
}

RunTask(Main)
