// synth_smoke.ailang
// 5s sine smoke: chromatic C4→B4 then C major chord, through AudioEngine.
// Build: ./ailang.x dev/compiler-regression/synth_smoke.ailang /tmp/synth_smoke.x
// Run:   /tmp/synth_smoke.x

LibraryImport.Arena
LibraryImport.Media.Synth
LibraryImport.Display.Render.AudioEngine

FixedPool.Smoke {
    "rate":   Initialize=48000
    "played": Initialize=0, CanChange=True
}

Function.Smoke_HzAt {
    Input: i: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(i, 0) ThenBlock: { ReturnValue(262) }
        IfCondition EqualTo(i, 1) ThenBlock: { ReturnValue(277) }
        IfCondition EqualTo(i, 2) ThenBlock: { ReturnValue(294) }
        IfCondition EqualTo(i, 3) ThenBlock: { ReturnValue(311) }
        IfCondition EqualTo(i, 4) ThenBlock: { ReturnValue(330) }
        IfCondition EqualTo(i, 5) ThenBlock: { ReturnValue(349) }
        IfCondition EqualTo(i, 6) ThenBlock: { ReturnValue(370) }
        IfCondition EqualTo(i, 7) ThenBlock: { ReturnValue(392) }
        IfCondition EqualTo(i, 8) ThenBlock: { ReturnValue(415) }
        IfCondition EqualTo(i, 9) ThenBlock: { ReturnValue(440) }
        IfCondition EqualTo(i, 10) ThenBlock: { ReturnValue(466) }
        ReturnValue(494)
    }
}

Function.Smoke_Pump {
    Input: stereo: Address
    Input: bytes: Integer
    Output: Integer
    Body: {
        r = Audio_Init()
        IfCondition NotEqual(r, 0) ThenBlock: {
            PrintMessage("[smoke] ALSA exclusive open failed — PipeWire likely holds pcmC0D0p\n")
            ReturnValue(0)
        }
        Mixer_SetMasterVol(320)
        Mixer_SetAppVol(320)
        off = 0
        period_bytes = Multiply(AudioState.period_size, AudioState.frame_bytes)
        IfCondition LessThan(period_bytes, 1) ThenBlock: { period_bytes = 4096 }
        WhileLoop LessThan(off, bytes) {
            n = Subtract(bytes, off)
            IfCondition GreaterThan(n, period_bytes) ThenBlock: { n = period_bytes }
            Mixer_AppWrite(Add(stereo, off), n)
            Mixer_DrainTick()
            off = Add(off, n)
        }
        Audio_Drain()
        Audio_Shutdown()
        ReturnValue(1)
    }
}

SubRoutine.Main {
    Arena_Init()
    PrintMessage("synth smoke: 12 chromatic notes + C major, 5s sine\n")

    syn = Synth_New(3, Smoke.rate)
    IfCondition EqualTo(syn, 0) ThenBlock: {
        PrintMessage("synth alloc failed\n")
        ReturnValue(0)
    }

    note_frames = 16000
    chord_frames = 48000
    walk_frames = Multiply(note_frames, 12)
    total = Add(walk_frames, chord_frames)
    stereo = Allocate(Multiply(total, 4))
    MemorySet(stereo, 0, Multiply(total, 4))

    i = 0
    WhileLoop LessThan(i, 12) {
        hz = Smoke_HzAt(i)
        Synth_VoiceOff(syn, 1)
        Synth_VoiceOff(syn, 2)
        Synth_VoiceOn(syn, 0, 0, hz, 96)
        dst = Add(stereo, Multiply(Multiply(i, note_frames), 4))
        Synth_RenderS16Stereo(syn, dst, note_frames)
        PrintMessage("  note ")
        PrintNumber(i)
        PrintMessage(" hz=")
        PrintNumber(hz)
        PrintMessage("\n")
        i = Add(i, 1)
    }

    PrintMessage("  chord C4 E4 G4\n")
    Synth_VoiceOn(syn, 0, 0, 262, 40)
    Synth_VoiceOn(syn, 1, 0, 330, 40)
    Synth_VoiceOn(syn, 2, 0, 392, 40)
    cdst = Add(stereo, Multiply(walk_frames, 4))
    Synth_RenderS16Stereo(syn, cdst, chord_frames)

    mono_frames = total
    mono = Allocate(Multiply(mono_frames, 2))
    f = 0
    WhileLoop LessThan(f, mono_frames) {
        SetByte(mono, Multiply(f, 2), GetByte(stereo, Multiply(f, 4)))
        SetByte(mono, Add(Multiply(f, 2), 1), GetByte(stereo, Add(Multiply(f, 4), 1)))
        f = Add(f, 1)
    }
    nw = Synth_WriteWav16("/tmp/synth_smoke.wav", mono, mono_frames, Smoke.rate)
    PrintMessage("wrote /tmp/synth_smoke.wav bytes=")
    PrintNumber(nw)
    PrintMessage("\n")

    Smoke.played = Smoke_Pump(stereo, Multiply(total, 4))
    IfCondition EqualTo(Smoke.played, 1) ThenBlock: {
        PrintMessage("played through AudioEngine / ALSA mixer\n")
    } ElseBlock: {
        PrintMessage("mixer not exclusive; play the wav via paplay\n")
    }

    Deallocate(mono, Multiply(mono_frames, 2))
    Deallocate(stereo, Multiply(total, 4))
    Synth_Free(syn)
}

RunTask(Main)
