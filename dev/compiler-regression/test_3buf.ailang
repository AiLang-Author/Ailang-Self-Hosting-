// test_3buf.ailang — minimal 3-buffer test with large offsets
// Kernel: y[gid] = x[gid]  (simple copy, verifies buffer offset addressing)
// Layout matches GEMV: A at 0, x at 131072, y at 131328
// Build: ./ailang.x dev/compiler-regression/test_3buf.ailang -o test_3buf.x
// Run:   sudo ./test_3buf.x

LibraryImport.Arena
LibraryImport.Drivers.AMDGPU.AMDGPUFamily
LibraryImport.Drivers.AMDGPU.AMDGPUDiscover
LibraryImport.Drivers.AMDGPU.AMDGPUBAR
LibraryImport.Drivers.AMDGPU.AMDGPUPM4
LibraryImport.Drivers.AMDGPU.GCNEnc
LibraryImport.Accel.ComputeIR
LibraryImport.Accel.ComputeIR_GCN
LibraryImport.Accel.HAL
LibraryImport.Accel.AccelGCN

SubRoutine.Main {
    PrintMessage("=== 3-Buffer Offset Test ===\n\n")

    // Same layout as GEMV
    A_bytes = 131072
    x_off = 131072
    x_bytes = 256
    y_off = 131328
    y_bytes = 256

    // --- Init ---
    rc = AccelGCN_Init()
    IfCondition LessThan(rc, 0) ThenBlock: {
        PrintMessage("FATAL: init failed\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }
    PrintMessage("Init OK\n\n")

    // --- Build kernel: y[gid] = x[gid] ---
    rc = CIR_Begin()
    rc = CIR_SetGroupSize(64, 1, 1)
    rc = CIR_SetGrid(1, 1, 1)

    // 3 buffers with same offsets as GEMV
    rc = CIR_BindBuffer(0, 0, A_bytes, 4, 1)        // A (unused by kernel)
    rc = CIR_BindBuffer(1, x_off, x_bytes, 4, 1)    // x: read
    rc = CIR_BindBuffer(2, y_off, y_bytes, 4, 2)    // y: write

    v_gid = CIR_AllocVReg()
    v_val = CIR_AllocVReg()

    rc = CIR_Op_GlobalIdX(v_gid)
    rc = CIR_Op_LoadBuf(v_val, 1, v_gid)    // v_val = x[gid]
    rc = CIR_Op_WaitCnt(0, 0, 0)
    rc = CIR_Op_StoreBuf(v_val, 2, v_gid)   // y[gid] = v_val
    rc = CIR_Op_WaitCnt(0, 0, 0)
    rc = CIR_Op_EndPgm()

    n_insns = CIR_End()
    PrintMessage("CIR: ")
    PrintNumber(n_insns)
    PrintMessage(" insns\n")

    mc_bytes = CIR_Lower_GCN()
    PrintMessage("GCN: ")
    PrintNumber(mc_bytes)
    PrintMessage(" bytes\n\n")

    // --- Write test data ---
    // Fill A with 0xAA pattern (padding)
    host_A = Allocate(A_bytes)
    MemorySet(host_A, 170, A_bytes)
    discard = AccelGCN_VramWrite(0, host_A, A_bytes)

    // Fill x with i+100 (distinguishable values)
    host_x = Allocate(x_bytes)
    i = 0
    WhileLoop LessThan(i, 64) {
        off = Multiply(i, 4)
        val = Add(i, 100)
        SetByte(host_x, off, BitwiseAnd(val, 255))
        SetByte(host_x, Add(off, 1), BitwiseAnd(RightShift(val, 8), 255))
        SetByte(host_x, Add(off, 2), 0)
        SetByte(host_x, Add(off, 3), 0)
        i = Add(i, 1)
    }
    discard = AccelGCN_VramWrite(x_off, host_x, x_bytes)
    PrintMessage("x written (x[i] = i+100)\n")

    // Zero y
    host_y = Allocate(y_bytes)
    MemorySet(host_y, 0, y_bytes)
    discard = AccelGCN_VramWrite(y_off, host_y, y_bytes)
    PrintMessage("y zeroed\n\n")

    // --- Dispatch ---
    PrintMessage("--- Dispatch ---\n")
    rc = AccelGCN_Dispatch()
    PrintMessage("rc=")
    PrintNumber(rc)
    PrintMessage("\n\n")

    // --- Verify ---
    discard = AccelGCN_VramRead(y_off, host_y, y_bytes)
    errors = 0
    i = 0
    WhileLoop LessThan(i, 64) {
        off = Multiply(i, 4)
        b0 = GetByte(host_y, off)
        b1 = GetByte(host_y, Add(off, 1))
        b2 = GetByte(host_y, Add(off, 2))
        b3 = GetByte(host_y, Add(off, 3))
        got = BitwiseOr(b0, BitwiseOr(LeftShift(b1, 8), BitwiseOr(LeftShift(b2, 16), LeftShift(b3, 24))))
        expected = Add(i, 100)
        IfCondition LessThan(i, 8) ThenBlock: {
            PrintMessage("  y[")
            PrintNumber(i)
            PrintMessage("] = ")
            PrintNumber(got)
            PrintMessage(" (expect ")
            PrintNumber(expected)
            PrintMessage(")")
            IfCondition EqualTo(got, expected) ThenBlock: { PrintMessage(" OK") }
            IfCondition NotEqual(got, expected) ThenBlock: { PrintMessage(" FAIL") }
            PrintMessage("\n")
        }
        IfCondition NotEqual(got, expected) ThenBlock: {
            errors = Add(errors, 1)
        }
        i = Add(i, 1)
    }

    PrintMessage("\nResults: ")
    PrintNumber(Subtract(64, errors))
    PrintMessage("/64 correct, ")
    PrintNumber(errors)
    PrintMessage(" errors\n")

    IfCondition EqualTo(errors, 0) ThenBlock: { PrintMessage("\n*** ALL PASS ***\n") }
    IfCondition GreaterThan(errors, 0) ThenBlock: { PrintMessage("\n*** FAIL ***\n") }

    Deallocate(host_A, A_bytes)
    Deallocate(host_x, x_bytes)
    Deallocate(host_y, y_bytes)
    discard = AccelGCN_Shutdown()
    PrintMessage("=== Done ===\n")
    SystemCall(60, 0, 0, 0, 0, 0)
}

RunTask(Main)
