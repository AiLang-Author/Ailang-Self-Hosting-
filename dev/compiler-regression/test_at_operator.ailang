// test_at_operator.ailang
// Test the @ pointer field access operator for LinkagePool
// Date: January 26, 2026

LibraryImport.Arena

LinkagePool.SimplePool {
    "x": Initialize=0
    "y": Initialize=100
}

SubRoutine.Main {
    Arena_Init()
    
    PrintMessage("=== @ Operator Test ===\n\n")
    
    // Allocate
    PrintMessage("Allocating SimplePool...\n")
    ptr = AllocateLinkage(LinkagePool.SimplePool)
    PrintMessage("Pointer: ")
    PrintNumber(ptr)
    PrintMessage("\n\n")
    
    // Test 1: Read initial values
    PrintMessage("Test 1: Read initial values\n")
    PrintMessage("  ptr@x = ")
    val_x = ptr@x
    PrintNumber(val_x)
    PrintMessage(" (expected: 0)\n")
    
    PrintMessage("  ptr@y = ")
    val_y = ptr@y
    PrintNumber(val_y)
    PrintMessage(" (expected: 100)\n\n")
    
    // Test 2: Write values
    PrintMessage("Test 2: Write values\n")
    ptr@x = 42
    ptr@y = 200
    PrintMessage("  Wrote ptr@x = 42\n")
    PrintMessage("  Wrote ptr@y = 200\n\n")
    
    // Test 3: Read back written values
    PrintMessage("Test 3: Read back written values\n")
    PrintMessage("  ptr@x = ")
    val_x = ptr@x
    PrintNumber(val_x)
    PrintMessage(" (expected: 42)\n")
    
    PrintMessage("  ptr@y = ")
    val_y = ptr@y
    PrintNumber(val_y)
    PrintMessage(" (expected: 200)\n\n")
    
    // Test 4: Use in expression
    PrintMessage("Test 4: Use in expression\n")
    sum = Add(ptr@x, ptr@y)
    PrintMessage("  Add(ptr@x, ptr@y) = ")
    PrintNumber(sum)
    PrintMessage(" (expected: 242)\n\n")
    
    // Cleanup
    FreeLinkage(ptr, LinkagePool.SimplePool)
    
    PrintMessage("=== All Tests Complete ===\n")
    Exit(0)
}

RunTask(Main)