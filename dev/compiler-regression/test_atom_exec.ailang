// test_atom_exec.ailang — Test ATOM BIOS bytecode interpreter
//
// 1. Discover GPUs, map MMIO
// 2. Load + parse AtomBIOS ROM
// 3. Initialize AtomExec interpreter
// 4. Dump pre-init SPLL state
// 5. Run AtomExec_AsicInit (ATOM_CMD_INIT table 0)
// 6. Dump post-init SPLL state — expect SPLL_STATUS transition
// 7. Optionally run AtomExec_SetEngineClock at 300 MHz (30000 10kHz)
// 8. Cleanup
//
// Build: ./ailang.x dev/compiler-regression/test_atom_exec.ailang test_atom_exec.x
// Run:   sg video -c "./test_atom_exec.x"

LibraryImport.Drivers.AMDGPU.AMDGPUFamily
LibraryImport.Drivers.AMDGPU.AMDGPUDiscover
LibraryImport.Drivers.AMDGPU.AMDGPUBAR
LibraryImport.Drivers.AMDGPU.AMDGPUAtomBIOS
LibraryImport.Drivers.AMDGPU.AMDGPUPM4Regs
LibraryImport.Drivers.AMDGPU.AMDGPUAtomExec
LibraryImport.Drivers.AMDGPU.AMDGPUAtomExecIO
LibraryImport.Drivers.AMDGPU.AMDGPUAtomExecDecode
LibraryImport.Drivers.AMDGPU.AMDGPUAtomExecOps
LibraryImport.Drivers.AMDGPU.AMDGPUAtomExecRun

Function.DumpSPLL {
    Input: gpu: Integer
    Input: label: Address
    Body: {
        PrintMessage(label)
        PrintMessage("  CG_SPLL_FUNC_CNTL   (0x600): 0x")
        PrintHex(GPU_Rd32(gpu, SIReg.CG_SPLL_FUNC_CNTL))
        PrintMessage("\n  CG_SPLL_FUNC_CNTL_2 (0x604): 0x")
        PrintHex(GPU_Rd32(gpu, SIReg.CG_SPLL_FUNC_CNTL_2))
        PrintMessage("\n  CG_SPLL_FUNC_CNTL_3 (0x608): 0x")
        PrintHex(GPU_Rd32(gpu, SIReg.CG_SPLL_FUNC_CNTL_3))
        PrintMessage("\n  CG_SPLL_FUNC_CNTL_4 (0x60C): 0x")
        PrintHex(GPU_Rd32(gpu, SIReg.CG_SPLL_FUNC_CNTL_4))
        PrintMessage("\n  SPLL_STATUS          (0x614): 0x")
        PrintHex(GPU_Rd32(gpu, SIReg.SPLL_STATUS))
        PrintMessage("\n")
    }
}

SubRoutine.Main {
    PrintMessage("=== ATOM BIOS Interpreter Test ===\n\n")

    // Discover GPUs
    count = GPU_Discover()
    GPU_BAR_Init()

    // Select compute GPU by PCI bus number (bus 2 = 02:00.0).
    // Display GPU is bus 1 = 01:00.0 — DO NOT MAP OR TOUCH IT.
    gpu = -1
    gi = 0
    WhileLoop LessThan(gi, count) {
        bus = GPU_GetDeviceField(gi, GPUDevField.PCI_BUS)
        IfCondition EqualTo(bus, 2) ThenBlock: {
            gpu = gi
        }
        gi = Add(gi, 1)
    }
    IfCondition LessThan(gpu, 0) ThenBlock: {
        PrintMessage("FAIL: no GPU on PCI bus 02.\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }

    GPU_BAR_MapMMIO(gpu)
    PrintMessage("Using GPU ")
    PrintNumber(gpu)
    PrintMessage(" (PCI bus 02)\n\n")

    // Load and parse AtomBIOS ROM
    PrintMessage("--- Loading AtomBIOS ROM ---\n")
    rom = AtomBIOS_LoadROM(gpu)
    IfCondition EqualTo(rom, 0) ThenBlock: {
        PrintMessage("FATAL: Failed to load ROM for GPU ")
        PrintNumber(gpu)
        PrintMessage("\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }
    AtomBIOS_Parse(gpu)
    PrintMessage("ROM loaded and parsed OK\n\n")

    // Initialize AtomExec interpreter
    PrintMessage("--- Initializing AtomExec ---\n")
    AtomExec_InitTables()
    ret = AtomExec_Init(gpu)
    IfCondition NotEqual(ret, 0) ThenBlock: {
        PrintMessage("FATAL: AtomExec_Init failed\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }
    PrintMessage("AtomExec initialized OK\n\n")

    // Dump SPLL state before ASIC init
    DumpSPLL(gpu, "--- SPLL State BEFORE AsicInit ---\n")
    PrintMessage("\n")

    // Run ATOM ASIC Init
    PrintMessage("--- Running AtomExec_AsicInit ---\n")
    ret = AtomExec_AsicInit(gpu)
    IfCondition NotEqual(ret, 0) ThenBlock: {
        PrintMessage("WARNING: AtomExec_AsicInit returned ")
        PrintNumber(ret)
        PrintMessage("\n")
    }
    ElseBlock: {
        PrintMessage("AtomExec_AsicInit returned OK\n")
    }
    PrintMessage("\n")

    // Dump SPLL state after ASIC init
    DumpSPLL(gpu, "--- SPLL State AFTER AsicInit ---\n")
    PrintMessage("\n")

    // Check SPLL_STATUS
    spll_st = GPU_Rd32(gpu, SIReg.SPLL_STATUS)
    // Bit 1 (SPLL_CHG_STATUS) should be set when PLL is locked
    spll_locked = BitwiseAnd(spll_st, 2)
    IfCondition NotEqual(spll_locked, 0) ThenBlock: {
        PrintMessage("SPLL appears LOCKED (CHG_STATUS set)\n\n")
    }
    ElseBlock: {
        PrintMessage("SPLL NOT locked (CHG_STATUS clear)\n\n")
    }

    // Try SetEngineClock at 300 MHz = 30000 in 10kHz units
    PrintMessage("--- Running AtomExec_SetEngineClock(30000) = 300 MHz ---\n")
    ret = AtomExec_SetEngineClock(gpu, 30000)
    IfCondition NotEqual(ret, 0) ThenBlock: {
        PrintMessage("WARNING: SetEngineClock returned ")
        PrintNumber(ret)
        PrintMessage("\n")
    }
    ElseBlock: {
        PrintMessage("SetEngineClock returned OK\n")
    }
    PrintMessage("\n")

    // Dump SPLL state after SetEngineClock
    DumpSPLL(gpu, "--- SPLL State AFTER SetEngineClock ---\n")
    PrintMessage("\n")

    // Verify FBDIV in CG_SPLL_FUNC_CNTL_3
    cntl3 = GPU_Rd32(gpu, SIReg.CG_SPLL_FUNC_CNTL_3)
    fbdiv = BitwiseAnd(cntl3, 67108863)
    PrintMessage("CG_SPLL_FUNC_CNTL_3 FBDIV = ")
    PrintNumber(fbdiv)
    PrintMessage(" (0x")
    PrintHex(fbdiv)
    PrintMessage(")\n\n")

    // Try 400 MHz = 40000 in 10kHz
    PrintMessage("--- Running AtomExec_SetEngineClock(40000) = 400 MHz ---\n")
    ret = AtomExec_SetEngineClock(gpu, 40000)
    PrintMessage("SetEngineClock(400) result: ")
    PrintNumber(ret)
    PrintMessage("\n")
    DumpSPLL(gpu, "--- SPLL State AFTER 400 MHz ---\n")
    cntl3 = GPU_Rd32(gpu, SIReg.CG_SPLL_FUNC_CNTL_3)
    fbdiv = BitwiseAnd(cntl3, 67108863)
    PrintMessage("FBDIV = ")
    PrintNumber(fbdiv)
    PrintMessage(" (0x")
    PrintHex(fbdiv)
    PrintMessage(")\n\n")

    // Try 500 MHz = 50000 in 10kHz
    PrintMessage("--- Running AtomExec_SetEngineClock(50000) = 500 MHz ---\n")
    ret = AtomExec_SetEngineClock(gpu, 50000)
    PrintMessage("SetEngineClock(500) result: ")
    PrintNumber(ret)
    PrintMessage("\n")
    DumpSPLL(gpu, "--- SPLL State AFTER 500 MHz ---\n")
    cntl3 = GPU_Rd32(gpu, SIReg.CG_SPLL_FUNC_CNTL_3)
    fbdiv = BitwiseAnd(cntl3, 67108863)
    PrintMessage("FBDIV = ")
    PrintNumber(fbdiv)
    PrintMessage(" (0x")
    PrintHex(fbdiv)
    PrintMessage(")\n\n")

    // Go back to 300 MHz to leave card in known state
    PrintMessage("--- Reverting to 300 MHz ---\n")
    ret = AtomExec_SetEngineClock(gpu, 30000)
    PrintMessage("SetEngineClock(300) result: ")
    PrintNumber(ret)
    PrintMessage("\n")
    DumpSPLL(gpu, "--- SPLL State AFTER revert to 300 MHz ---\n")
    PrintMessage("\n")

    // Cleanup
    PrintMessage("--- Cleanup ---\n")
    AtomExec_Shutdown(gpu)
    GPU_BAR_Unmap(gpu)
    PrintMessage("Done.\n")
    SystemCall(60, 0, 0, 0, 0, 0)
}

RunTask(Main)
