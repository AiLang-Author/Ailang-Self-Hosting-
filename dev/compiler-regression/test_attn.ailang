// test_attn.ailang — AccelGCN_Submit stress test suite
// Exercises the EXACT code path ATTN uses:
//   HALOp fields → AccelGCN_Submit → CIR build/cache → VRAM upload → dispatch → readback
// with controlled data at increasing scales to find where it breaks.
//
// Each stage only runs if the previous passed. When something fails,
// you know the LAST working stage and the FIRST broken one.
//
// Original stages (1-8):
//   1. MatVecMul  16×16,   64-bit, 100 iters — baseline
//   2. MatVecMul  64×64,   64-bit, 100 iters — KCache exercised
//   3. MatVecMul  128×128, 64-bit,  50 iters — DModel scale
//   4. MatTVecMul 128×128, 64-bit,  50 iters — second op type
//   5. OuterAccum 128×128, 64-bit,  50 iters — third op type (4 buffers)
//   6. Mixed ops  128×128, 64-bit,  50 cycles — MVM+MTV+OA per cycle
//   7. MatVecMul  512×128, 64-bit,  50 iters — DFF scale
//   8. MatTVecMul 512×128, 64-bit,  50 iters — backward-pass scale
//
// Stress stages (9-15):
//   9.  Non-power-of-2 dims 200×100 MVM — alignment/padding edge cases
//  10.  Non-uniform data MVM 128×128 — mat[i,j]=i+j+1, catches addressing bugs
//  11.  256×256 full mixed MVM+MTV+OA — next JEPA DModel scale
//  12.  1024×256 MVM + MTV — JEPA DFF scale, 2MB upload, big shaders
//  13.  KCache thrash — alternating dimensions to force evictions
//  14.  Endurance — 500 dispatches at 128×128 = 16 compute resets
//  15.  Large 64-bit values — tests carry propagation in 64-bit multiply/accumulate
//
// Build: ./ailang.x dev/compiler-regression/test_attn.ailang -o test_attn.x
// Run:   sudo ./test_attn.x 2>&1 | tee attn_test_log.txt

LibraryImport.Arena
LibraryImport.Drivers.AMDGPU.AMDGPUFamily
LibraryImport.Drivers.AMDGPU.AMDGPUDiscover
LibraryImport.Drivers.AMDGPU.AMDGPUBAR
LibraryImport.Drivers.AMDGPU.AMDGPUPM4
LibraryImport.Drivers.AMDGPU.GCNEnc
LibraryImport.Accel.ComputeIR
LibraryImport.Accel.ComputeIR_GCN
LibraryImport.Accel.HAL
LibraryImport.Accel.AccelGCN

// =============================================================================
// CRASH-SAFE LOG — globals
// Writes breadcrumb tags directly to attn_test_crash.txt with fdatasync
// after every critical GPU operation.  If the display driver crashes,
// the last completed tag survives on disk.
// =============================================================================
FixedPool.LogState {
    "fd": Initialize=0
}

FixedPool.OFlags {
    "O_WRONLY":  Initialize=1
    "O_CREAT":   Initialize=64
    "O_TRUNC":   Initialize=512
}

// =============================================================================
// LogOpen — open crash log for direct-to-disk breadcrumb logging
// =============================================================================
Function.LogOpen {
    Body: {
        flags = Add(OFlags.O_WRONLY, Add(OFlags.O_CREAT, OFlags.O_TRUNC))
        LogState.fd = SystemCall(2, "attn_test_crash.txt", flags, 420, 0, 0)
        IfCondition LessThan(LogState.fd, 0) ThenBlock: {
            PrintMessage("[LOG] WARNING: could not open attn_test_crash.txt (fd=")
            PrintNumber(LogState.fd)
            PrintMessage("), breadcrumbs disabled\n")
            LogState.fd = 0
        }
        IfCondition GreaterThan(LogState.fd, 0) ThenBlock: {
            PrintMessage("[LOG] Breadcrumb log: attn_test_crash.txt (fd=")
            PrintNumber(LogState.fd)
            PrintMessage(")\n")
        }
    }
}

// =============================================================================
// LogSync — write a breadcrumb tag + newline, then fdatasync to force to disk
// =============================================================================
Function.LogSync {
    Input: tag: Address
    Body: {
        IfCondition GreaterThan(LogState.fd, 0) ThenBlock: {
            tag_len = StringLength(tag)
            SystemCall(1, LogState.fd, tag, tag_len, 0, 0)
            nl = "\n"
            SystemCall(1, LogState.fd, nl, 1, 0, 0)
            SystemCall(75, LogState.fd, 0, 0, 0, 0)
        }
    }
}

// =============================================================================
// LogSyncNum — write tag + decimal number + newline, then fdatasync
// =============================================================================
Function.LogSyncNum {
    Input: tag: Address
    Input: val: Integer
    Body: {
        IfCondition GreaterThan(LogState.fd, 0) ThenBlock: {
            tag_len = StringLength(tag)
            SystemCall(1, LogState.fd, tag, tag_len, 0, 0)
            // Convert val to decimal string
            num_buf = Allocate(24)
            ni = 0
            tmp_val = val
            IfCondition LessThan(tmp_val, 0) ThenBlock: {
                SetByte(num_buf, 0, 45)
                ni = 1
                tmp_val = Subtract(0, tmp_val)
            }
            IfCondition EqualTo(tmp_val, 0) ThenBlock: {
                SetByte(num_buf, ni, 48)
                ni = Add(ni, 1)
            }
            IfCondition GreaterThan(tmp_val, 0) ThenBlock: {
                // Write digits in reverse, then flip
                start_ni = ni
                WhileLoop GreaterThan(tmp_val, 0) {
                    digit = Modulo(tmp_val, 10)
                    SetByte(num_buf, ni, Add(48, digit))
                    ni = Add(ni, 1)
                    tmp_val = Divide(tmp_val, 10)
                }
                // Reverse the digit portion
                lo = start_ni
                hi = Subtract(ni, 1)
                WhileLoop LessThan(lo, hi) {
                    tmp_c = GetByte(num_buf, lo)
                    SetByte(num_buf, lo, GetByte(num_buf, hi))
                    SetByte(num_buf, hi, tmp_c)
                    lo = Add(lo, 1)
                    hi = Subtract(hi, 1)
                }
            }
            SetByte(num_buf, ni, 10)
            ni = Add(ni, 1)
            SystemCall(1, LogState.fd, num_buf, ni, 0, 0)
            Deallocate(num_buf, 24)
            SystemCall(75, LogState.fd, 0, 0, 0, 0)
        }
    }
}

// =============================================================================
// LogClose — close the log file
// =============================================================================
Function.LogClose {
    Body: {
        IfCondition GreaterThan(LogState.fd, 0) ThenBlock: {
            SystemCall(75, LogState.fd, 0, 0, 0, 0)
            SystemCall(3, LogState.fd, 0, 0, 0, 0)
            LogState.fd = 0
        }
    }
}

// =============================================================================
// RunMVMTest — MatVecMul: dst[i] = sum_j( mat[i,j] * vec[j] )
//   mat[i,j] = 1 for all entries, vec[j] = j+1
//   Expected: dst[i] = cols*(cols+1)/2  for all i
// Returns: number of PASS iterations (== t_iters means all passed)
// =============================================================================
Function.RunMVMTest {
    Input: t_rows: Integer
    Input: t_cols: Integer
    Input: t_iters: Integer
    Output: Integer
    Body: {
        mat_elems = Multiply(t_rows, t_cols)
        mat_bytes = Multiply(mat_elems, 8)
        vec_bytes = Multiply(t_cols, 8)
        dst_bytes = Multiply(t_rows, 8)

        host_mat = Allocate(mat_bytes)
        host_vec = Allocate(vec_bytes)
        host_dst = Allocate(dst_bytes)

        // Fill mat[i,j] = 1
        idx = 0
        WhileLoop LessThan(idx, mat_elems) {
            StoreValue(Add(host_mat, Multiply(idx, 8)), 1)
            idx = Add(idx, 1)
        }

        // Fill vec[j] = j + 1
        j = 0
        WhileLoop LessThan(j, t_cols) {
            StoreValue(Add(host_vec, Multiply(j, 8)), Add(j, 1))
            j = Add(j, 1)
        }

        expected = Divide(Multiply(t_cols, Add(t_cols, 1)), 2)
        total_pass = 0

        iter = 0
        WhileLoop LessThan(iter, t_iters) {
            MemorySet(host_dst, 0, dst_bytes)

            HALOp.op   = 1
            HALOp.dst  = host_dst
            HALOp.mat  = host_mat
            HALOp.vec  = host_vec
            HALOp.rows = t_rows
            HALOp.cols = t_cols

            rc = AccelGCN_Submit()
            IfCondition LessThan(rc, 0) ThenBlock: {
                PrintMessage("  FATAL: submit failed iter=")
                PrintNumber(iter)
                PrintMessage(" rc=")
                PrintNumber(rc)
                PrintMessage("\n")
                Deallocate(host_mat, mat_bytes)
                Deallocate(host_vec, vec_bytes)
                Deallocate(host_dst, dst_bytes)
                ReturnValue(total_pass)
            }

            // Verify all rows
            errors = 0
            first_bad_idx = 0
            first_bad_got = 0
            i = 0
            WhileLoop LessThan(i, t_rows) {
                got = Dereference(Add(host_dst, Multiply(i, 8)))
                IfCondition NotEqual(got, expected) ThenBlock: {
                    IfCondition EqualTo(errors, 0) ThenBlock: {
                        first_bad_idx = i
                        first_bad_got = got
                    }
                    errors = Add(errors, 1)
                }
                i = Add(i, 1)
            }

            print_this = 0
            IfCondition EqualTo(Modulo(iter, 10), 0) ThenBlock: { print_this = 1 }
            IfCondition GreaterThan(errors, 0) ThenBlock: { print_this = 1 }

            IfCondition EqualTo(print_this, 1) ThenBlock: {
                PrintMessage("  iter ")
                PrintNumber(iter)
                IfCondition EqualTo(errors, 0) ThenBlock: {
                    PrintMessage(": PASS\n")
                }
                IfCondition GreaterThan(errors, 0) ThenBlock: {
                    PrintMessage(": FAIL ")
                    PrintNumber(errors)
                    PrintMessage("/")
                    PrintNumber(t_rows)
                    PrintMessage("  [")
                    PrintNumber(first_bad_idx)
                    PrintMessage("] got=")
                    PrintNumber(first_bad_got)
                    PrintMessage(" exp=")
                    PrintNumber(expected)
                    PrintMessage("\n")
                }
            }

            IfCondition EqualTo(errors, 0) ThenBlock: {
                total_pass = Add(total_pass, 1)
            }

            iter = Add(iter, 1)
        }

        Deallocate(host_mat, mat_bytes)
        Deallocate(host_vec, vec_bytes)
        Deallocate(host_dst, dst_bytes)
        ReturnValue(total_pass)
    }
}

// =============================================================================
// RunMTVTest — MatTVecMul: dst[j] = sum_i( mat[i,j] * vec[i] )
//   mat[i,j] = 1 for all entries, vec[i] = i+1
//   Expected: dst[j] = rows*(rows+1)/2  for all j
// =============================================================================
Function.RunMTVTest {
    Input: t_rows: Integer
    Input: t_cols: Integer
    Input: t_iters: Integer
    Output: Integer
    Body: {
        mat_elems = Multiply(t_rows, t_cols)
        mat_bytes = Multiply(mat_elems, 8)
        vec_bytes = Multiply(t_rows, 8)
        dst_bytes = Multiply(t_cols, 8)

        host_mat = Allocate(mat_bytes)
        host_vec = Allocate(vec_bytes)
        host_dst = Allocate(dst_bytes)

        // Fill mat[i,j] = 1
        idx = 0
        WhileLoop LessThan(idx, mat_elems) {
            StoreValue(Add(host_mat, Multiply(idx, 8)), 1)
            idx = Add(idx, 1)
        }

        // Fill vec[i] = i + 1
        i = 0
        WhileLoop LessThan(i, t_rows) {
            StoreValue(Add(host_vec, Multiply(i, 8)), Add(i, 1))
            i = Add(i, 1)
        }

        expected = Divide(Multiply(t_rows, Add(t_rows, 1)), 2)
        total_pass = 0

        iter = 0
        WhileLoop LessThan(iter, t_iters) {
            MemorySet(host_dst, 0, dst_bytes)

            HALOp.op   = 2
            HALOp.dst  = host_dst
            HALOp.mat  = host_mat
            HALOp.vec  = host_vec
            HALOp.rows = t_rows
            HALOp.cols = t_cols

            rc = AccelGCN_Submit()
            IfCondition LessThan(rc, 0) ThenBlock: {
                PrintMessage("  FATAL: submit failed iter=")
                PrintNumber(iter)
                PrintMessage(" rc=")
                PrintNumber(rc)
                PrintMessage("\n")
                Deallocate(host_mat, mat_bytes)
                Deallocate(host_vec, vec_bytes)
                Deallocate(host_dst, dst_bytes)
                ReturnValue(total_pass)
            }

            errors = 0
            first_bad_idx = 0
            first_bad_got = 0
            j = 0
            WhileLoop LessThan(j, t_cols) {
                got = Dereference(Add(host_dst, Multiply(j, 8)))
                IfCondition NotEqual(got, expected) ThenBlock: {
                    IfCondition EqualTo(errors, 0) ThenBlock: {
                        first_bad_idx = j
                        first_bad_got = got
                    }
                    errors = Add(errors, 1)
                }
                j = Add(j, 1)
            }

            print_this = 0
            IfCondition EqualTo(Modulo(iter, 10), 0) ThenBlock: { print_this = 1 }
            IfCondition GreaterThan(errors, 0) ThenBlock: { print_this = 1 }

            IfCondition EqualTo(print_this, 1) ThenBlock: {
                PrintMessage("  iter ")
                PrintNumber(iter)
                IfCondition EqualTo(errors, 0) ThenBlock: {
                    PrintMessage(": PASS\n")
                }
                IfCondition GreaterThan(errors, 0) ThenBlock: {
                    PrintMessage(": FAIL ")
                    PrintNumber(errors)
                    PrintMessage("/")
                    PrintNumber(t_cols)
                    PrintMessage("  [")
                    PrintNumber(first_bad_idx)
                    PrintMessage("] got=")
                    PrintNumber(first_bad_got)
                    PrintMessage(" exp=")
                    PrintNumber(expected)
                    PrintMessage("\n")
                }
            }

            IfCondition EqualTo(errors, 0) ThenBlock: {
                total_pass = Add(total_pass, 1)
            }

            iter = Add(iter, 1)
        }

        Deallocate(host_mat, mat_bytes)
        Deallocate(host_vec, vec_bytes)
        Deallocate(host_dst, dst_bytes)
        ReturnValue(total_pass)
    }
}

// =============================================================================
// RunOATest — OuterAccum: mat[i,j] += avec[i] * bvec[j]
//   mat = all zeros, avec[i] = i+1, bvec[j] = j+1
//   Expected: mat[i,j] = (i+1)*(j+1)
// =============================================================================
Function.RunOATest {
    Input: t_rows: Integer
    Input: t_cols: Integer
    Input: t_iters: Integer
    Output: Integer
    Body: {
        mat_elems  = Multiply(t_rows, t_cols)
        mat_bytes  = Multiply(mat_elems, 8)
        avec_bytes = Multiply(t_rows, 8)
        bvec_bytes = Multiply(t_cols, 8)

        host_mat  = Allocate(mat_bytes)
        host_avec = Allocate(avec_bytes)
        host_bvec = Allocate(bvec_bytes)

        // Fill avec[i] = i + 1
        i = 0
        WhileLoop LessThan(i, t_rows) {
            StoreValue(Add(host_avec, Multiply(i, 8)), Add(i, 1))
            i = Add(i, 1)
        }

        // Fill bvec[j] = j + 1
        j = 0
        WhileLoop LessThan(j, t_cols) {
            StoreValue(Add(host_bvec, Multiply(j, 8)), Add(j, 1))
            j = Add(j, 1)
        }

        total_pass = 0

        iter = 0
        WhileLoop LessThan(iter, t_iters) {
            // Zero mat (fresh each iter — result = avec ⊗ bvec, not accumulated)
            MemorySet(host_mat, 0, mat_bytes)

            HALOp.op   = 3
            HALOp.dst  = host_mat
            HALOp.mat  = host_mat
            HALOp.vec  = host_avec
            HALOp.vec2 = host_bvec
            HALOp.rows = t_rows
            HALOp.cols = t_cols

            rc = AccelGCN_Submit()
            IfCondition LessThan(rc, 0) ThenBlock: {
                PrintMessage("  FATAL: submit failed iter=")
                PrintNumber(iter)
                PrintMessage(" rc=")
                PrintNumber(rc)
                PrintMessage("\n")
                Deallocate(host_mat, mat_bytes)
                Deallocate(host_avec, avec_bytes)
                Deallocate(host_bvec, bvec_bytes)
                ReturnValue(total_pass)
            }

            // Verify every element: mat[i,j] == (i+1)*(j+1)
            errors = 0
            first_bad_r   = 0
            first_bad_c   = 0
            first_bad_got = 0
            first_bad_exp = 0
            i = 0
            WhileLoop LessThan(i, t_rows) {
                j = 0
                WhileLoop LessThan(j, t_cols) {
                    flat = Add(Multiply(i, t_cols), j)
                    got  = Dereference(Add(host_mat, Multiply(flat, 8)))
                    exp  = Multiply(Add(i, 1), Add(j, 1))
                    IfCondition NotEqual(got, exp) ThenBlock: {
                        IfCondition EqualTo(errors, 0) ThenBlock: {
                            first_bad_r   = i
                            first_bad_c   = j
                            first_bad_got = got
                            first_bad_exp = exp
                        }
                        errors = Add(errors, 1)
                    }
                    j = Add(j, 1)
                }
                i = Add(i, 1)
            }

            print_this = 0
            IfCondition EqualTo(Modulo(iter, 10), 0) ThenBlock: { print_this = 1 }
            IfCondition GreaterThan(errors, 0) ThenBlock: { print_this = 1 }

            IfCondition EqualTo(print_this, 1) ThenBlock: {
                PrintMessage("  iter ")
                PrintNumber(iter)
                IfCondition EqualTo(errors, 0) ThenBlock: {
                    PrintMessage(": PASS\n")
                }
                IfCondition GreaterThan(errors, 0) ThenBlock: {
                    PrintMessage(": FAIL ")
                    PrintNumber(errors)
                    PrintMessage("/")
                    PrintNumber(mat_elems)
                    PrintMessage("  [")
                    PrintNumber(first_bad_r)
                    PrintMessage(",")
                    PrintNumber(first_bad_c)
                    PrintMessage("] got=")
                    PrintNumber(first_bad_got)
                    PrintMessage(" exp=")
                    PrintNumber(first_bad_exp)
                    PrintMessage("\n")
                }
            }

            IfCondition EqualTo(errors, 0) ThenBlock: {
                total_pass = Add(total_pass, 1)
            }

            iter = Add(iter, 1)
        }

        Deallocate(host_mat, mat_bytes)
        Deallocate(host_avec, avec_bytes)
        Deallocate(host_bvec, bvec_bytes)
        ReturnValue(total_pass)
    }
}

// =============================================================================
// RunMVMTestIJ — MatVecMul with non-uniform data
//   mat[i,j] = i + j + 1, vec[j] = j + 1
//   dst[i] = sum_j( (i+j+1) * (j+1) )
//        = sum_j( i*(j+1) + (j+1)^2 )
//        = i * cols*(cols+1)/2  +  cols*(cols+1)*(2*cols+1)/6
// This tests per-element addressing — if any index is wrong, the row fails.
// =============================================================================
Function.RunMVMTestIJ {
    Input: t_rows: Integer
    Input: t_cols: Integer
    Input: t_iters: Integer
    Output: Integer
    Body: {
        mat_elems = Multiply(t_rows, t_cols)
        mat_bytes = Multiply(mat_elems, 8)
        vec_bytes = Multiply(t_cols, 8)
        dst_bytes = Multiply(t_rows, 8)

        host_mat = Allocate(mat_bytes)
        host_vec = Allocate(vec_bytes)
        host_dst = Allocate(dst_bytes)

        // Fill mat[i,j] = i + j + 1
        i = 0
        WhileLoop LessThan(i, t_rows) {
            j = 0
            WhileLoop LessThan(j, t_cols) {
                flat = Add(Multiply(i, t_cols), j)
                StoreValue(Add(host_mat, Multiply(flat, 8)), Add(Add(i, j), 1))
                j = Add(j, 1)
            }
            i = Add(i, 1)
        }

        // Fill vec[j] = j + 1
        j = 0
        WhileLoop LessThan(j, t_cols) {
            StoreValue(Add(host_vec, Multiply(j, 8)), Add(j, 1))
            j = Add(j, 1)
        }

        // Precompute: S1 = cols*(cols+1)/2, S2 = cols*(cols+1)*(2*cols+1)/6
        s1 = Divide(Multiply(t_cols, Add(t_cols, 1)), 2)
        s2 = Divide(Multiply(Multiply(t_cols, Add(t_cols, 1)), Add(Multiply(2, t_cols), 1)), 6)

        total_pass = 0
        iter = 0
        WhileLoop LessThan(iter, t_iters) {
            MemorySet(host_dst, 0, dst_bytes)

            HALOp.op   = 1
            HALOp.dst  = host_dst
            HALOp.mat  = host_mat
            HALOp.vec  = host_vec
            HALOp.rows = t_rows
            HALOp.cols = t_cols

            rc = AccelGCN_Submit()
            IfCondition LessThan(rc, 0) ThenBlock: {
                PrintMessage("  FATAL: submit failed iter=")
                PrintNumber(iter)
                PrintMessage("\n")
                Deallocate(host_mat, mat_bytes)
                Deallocate(host_vec, vec_bytes)
                Deallocate(host_dst, dst_bytes)
                ReturnValue(total_pass)
            }

            errors = 0
            first_bad_idx = 0
            first_bad_got = 0
            first_bad_exp = 0
            i = 0
            WhileLoop LessThan(i, t_rows) {
                got = Dereference(Add(host_dst, Multiply(i, 8)))
                // expected = i*S1 + S2
                exp = Add(Multiply(i, s1), s2)
                IfCondition NotEqual(got, exp) ThenBlock: {
                    IfCondition EqualTo(errors, 0) ThenBlock: {
                        first_bad_idx = i
                        first_bad_got = got
                        first_bad_exp = exp
                    }
                    errors = Add(errors, 1)
                }
                i = Add(i, 1)
            }

            print_this = 0
            IfCondition EqualTo(Modulo(iter, 10), 0) ThenBlock: { print_this = 1 }
            IfCondition GreaterThan(errors, 0) ThenBlock: { print_this = 1 }

            IfCondition EqualTo(print_this, 1) ThenBlock: {
                PrintMessage("  iter ")
                PrintNumber(iter)
                IfCondition EqualTo(errors, 0) ThenBlock: {
                    PrintMessage(": PASS\n")
                }
                IfCondition GreaterThan(errors, 0) ThenBlock: {
                    PrintMessage(": FAIL ")
                    PrintNumber(errors)
                    PrintMessage("/")
                    PrintNumber(t_rows)
                    PrintMessage("  [")
                    PrintNumber(first_bad_idx)
                    PrintMessage("] got=")
                    PrintNumber(first_bad_got)
                    PrintMessage(" exp=")
                    PrintNumber(first_bad_exp)
                    PrintMessage("\n")
                }
            }

            IfCondition EqualTo(errors, 0) ThenBlock: {
                total_pass = Add(total_pass, 1)
            }

            iter = Add(iter, 1)
        }

        Deallocate(host_mat, mat_bytes)
        Deallocate(host_vec, vec_bytes)
        Deallocate(host_dst, dst_bytes)
        ReturnValue(total_pass)
    }
}

// =============================================================================
// RunMVMTestBigVal — MatVecMul with large 64-bit values
//   mat[i,j] = 100000, vec[j] = 100000
//   dst[i] = cols * 100000 * 100000 = cols * 10^10
// Tests 64-bit multiply carry propagation: 10^10 = 0x2_540B_E400
// which needs the hi DWORD. Accumulation across cols pushes higher.
// =============================================================================
Function.RunMVMTestBigVal {
    Input: t_rows: Integer
    Input: t_cols: Integer
    Input: t_iters: Integer
    Output: Integer
    Body: {
        mat_elems = Multiply(t_rows, t_cols)
        mat_bytes = Multiply(mat_elems, 8)
        vec_bytes = Multiply(t_cols, 8)
        dst_bytes = Multiply(t_rows, 8)

        host_mat = Allocate(mat_bytes)
        host_vec = Allocate(vec_bytes)
        host_dst = Allocate(dst_bytes)

        bigval = 100000

        // Fill mat[i,j] = bigval
        idx = 0
        WhileLoop LessThan(idx, mat_elems) {
            StoreValue(Add(host_mat, Multiply(idx, 8)), bigval)
            idx = Add(idx, 1)
        }

        // Fill vec[j] = bigval
        j = 0
        WhileLoop LessThan(j, t_cols) {
            StoreValue(Add(host_vec, Multiply(j, 8)), bigval)
            j = Add(j, 1)
        }

        // expected = cols * bigval * bigval
        expected = Multiply(t_cols, Multiply(bigval, bigval))

        total_pass = 0
        iter = 0
        WhileLoop LessThan(iter, t_iters) {
            MemorySet(host_dst, 0, dst_bytes)

            HALOp.op   = 1
            HALOp.dst  = host_dst
            HALOp.mat  = host_mat
            HALOp.vec  = host_vec
            HALOp.rows = t_rows
            HALOp.cols = t_cols

            rc = AccelGCN_Submit()
            IfCondition LessThan(rc, 0) ThenBlock: {
                PrintMessage("  FATAL: submit failed iter=")
                PrintNumber(iter)
                PrintMessage("\n")
                Deallocate(host_mat, mat_bytes)
                Deallocate(host_vec, vec_bytes)
                Deallocate(host_dst, dst_bytes)
                ReturnValue(total_pass)
            }

            errors = 0
            first_bad_idx = 0
            first_bad_got = 0
            i = 0
            WhileLoop LessThan(i, t_rows) {
                got = Dereference(Add(host_dst, Multiply(i, 8)))
                IfCondition NotEqual(got, expected) ThenBlock: {
                    IfCondition EqualTo(errors, 0) ThenBlock: {
                        first_bad_idx = i
                        first_bad_got = got
                    }
                    errors = Add(errors, 1)
                }
                i = Add(i, 1)
            }

            print_this = 0
            IfCondition EqualTo(Modulo(iter, 10), 0) ThenBlock: { print_this = 1 }
            IfCondition GreaterThan(errors, 0) ThenBlock: { print_this = 1 }

            IfCondition EqualTo(print_this, 1) ThenBlock: {
                PrintMessage("  iter ")
                PrintNumber(iter)
                IfCondition EqualTo(errors, 0) ThenBlock: {
                    PrintMessage(": PASS\n")
                }
                IfCondition GreaterThan(errors, 0) ThenBlock: {
                    PrintMessage(": FAIL ")
                    PrintNumber(errors)
                    PrintMessage("/")
                    PrintNumber(t_rows)
                    PrintMessage("  [")
                    PrintNumber(first_bad_idx)
                    PrintMessage("] got=")
                    PrintNumber(first_bad_got)
                    PrintMessage(" exp=")
                    PrintNumber(expected)
                    PrintMessage("\n")
                }
            }

            IfCondition EqualTo(errors, 0) ThenBlock: {
                total_pass = Add(total_pass, 1)
            }

            iter = Add(iter, 1)
        }

        Deallocate(host_mat, mat_bytes)
        Deallocate(host_vec, vec_bytes)
        Deallocate(host_dst, dst_bytes)
        ReturnValue(total_pass)
    }
}

// =============================================================================
// MAIN
// =============================================================================
SubRoutine.Main {
    LogOpen()
    LogSync("TEST_ATTN_START")

    PrintMessage("=== test_attn: AccelGCN_Submit path test ===\n")
    PrintMessage("Tests the EXACT code path ATTN uses:\n")
    PrintMessage("  HALOp -> AccelGCN_Submit -> CIR/KCache -> VRAM upload -> dispatch -> readback\n")
    PrintMessage("64-bit elements, per-dispatch data upload, KCache, 30-dispatch compute reset\n\n")

    // --- Init GPU ---
    LogSync("GPU_INIT_PRE")
    rc = AccelGCN_Init()
    IfCondition LessThan(rc, 0) ThenBlock: {
        LogSyncNum("GPU_INIT_FAIL_RC=", rc)
        PrintMessage("FATAL: AccelGCN_Init failed rc=")
        PrintNumber(rc)
        PrintMessage("\n")
        LogClose()
        SystemCall(60, 1, 0, 0, 0, 0)
    }
    LogSync("GPU_INIT_OK")
    PrintMessage("GPU init OK\n\n")

    all_ok = 1

    // =====================================================================
    // STAGE 1: MatVecMul 16×16, 100 iterations
    // Baseline. Tiny data (2KB mat), tiny kernel (16 unrolled iters).
    // If THIS fails, AccelGCN_Submit itself is broken.
    // Crosses the 30-dispatch compute reset 3 times.
    // =====================================================================
    LogSync("STAGE1_MVM_16x16_PRE")
    PrintMessage("--- Stage 1: MatVecMul 16x16, 100 iters ---\n")
    PrintMessage("  (tiny data, tiny kernel — baseline)\n")
    s1_pass = RunMVMTest(16, 16, 100)
    LogSyncNum("STAGE1_PASS=", s1_pass)
    PrintMessage("Stage 1: ")
    PrintNumber(s1_pass)
    PrintMessage("/100")
    IfCondition EqualTo(s1_pass, 100) ThenBlock: { PrintMessage(" PASS\n\n") }
    IfCondition LessThan(s1_pass, 100) ThenBlock: {
        PrintMessage(" *** FAIL ***\n\n")
        all_ok = 0
    }

    // =====================================================================
    // STAGE 2: MatVecMul 64×64, 100 iterations
    // Grows unrolled kernel to 64 iterations (~10KB machine code).
    // Tests KCache hit path (first dispatch = miss, rest = hits).
    // 32KB data upload per dispatch.
    // =====================================================================
    IfCondition EqualTo(all_ok, 1) ThenBlock: {
        LogSync("STAGE2_MVM_64x64_PRE")
        PrintMessage("--- Stage 2: MatVecMul 64x64, 100 iters ---\n")
        PrintMessage("  (64 unrolled iters, 32KB data, KCache exercised)\n")
        s2_pass = RunMVMTest(64, 64, 100)
        LogSyncNum("STAGE2_PASS=", s2_pass)
        PrintMessage("Stage 2: ")
        PrintNumber(s2_pass)
        PrintMessage("/100")
        IfCondition EqualTo(s2_pass, 100) ThenBlock: { PrintMessage(" PASS\n\n") }
        IfCondition LessThan(s2_pass, 100) ThenBlock: {
            PrintMessage(" *** FAIL ***\n\n")
            all_ok = 0
        }
    }

    // =====================================================================
    // STAGE 3: MatVecMul 128×128, 50 iterations
    // DModel scale. 128 unrolled iters (~30KB machine code).
    // 128KB+ data upload per dispatch.
    // =====================================================================
    IfCondition EqualTo(all_ok, 1) ThenBlock: {
        LogSync("STAGE3_MVM_128x128_PRE")
        PrintMessage("--- Stage 3: MatVecMul 128x128, 50 iters ---\n")
        PrintMessage("  (DModel scale: 128 unrolled, 131KB data upload)\n")
        s3_pass = RunMVMTest(128, 128, 50)
        LogSyncNum("STAGE3_PASS=", s3_pass)
        PrintMessage("Stage 3: ")
        PrintNumber(s3_pass)
        PrintMessage("/50")
        IfCondition EqualTo(s3_pass, 50) ThenBlock: { PrintMessage(" PASS\n\n") }
        IfCondition LessThan(s3_pass, 50) ThenBlock: {
            PrintMessage(" *** FAIL ***\n\n")
            all_ok = 0
        }
    }

    // =====================================================================
    // STAGE 4: MatTVecMul 128×128, 50 iterations
    // Second op type — transposed matrix-vector multiply.
    // Uses KCache slot 1 (op=2). Same data scale as Stage 3.
    // =====================================================================
    IfCondition EqualTo(all_ok, 1) ThenBlock: {
        LogSync("STAGE4_MTV_128x128_PRE")
        PrintMessage("--- Stage 4: MatTVecMul 128x128, 50 iters ---\n")
        PrintMessage("  (transposed multiply, KCache slot 1)\n")
        s4_pass = RunMTVTest(128, 128, 50)
        LogSyncNum("STAGE4_PASS=", s4_pass)
        PrintMessage("Stage 4: ")
        PrintNumber(s4_pass)
        PrintMessage("/50")
        IfCondition EqualTo(s4_pass, 50) ThenBlock: { PrintMessage(" PASS\n\n") }
        IfCondition LessThan(s4_pass, 50) ThenBlock: {
            PrintMessage(" *** FAIL ***\n\n")
            all_ok = 0
        }
    }

    // =====================================================================
    // STAGE 5: OuterAccum 128×128, 50 iterations
    // Third op type — outer product accumulate. 4 CIR buffers instead of 3.
    // =====================================================================
    IfCondition EqualTo(all_ok, 1) ThenBlock: {
        LogSync("STAGE5_OA_128x128_PRE")
        PrintMessage("--- Stage 5: OuterAccum 128x128, 50 iters ---\n")
        PrintMessage("  (outer product, 4 buffers, KCache slot 2)\n")
        s5_pass = RunOATest(128, 128, 50)
        LogSyncNum("STAGE5_PASS=", s5_pass)
        PrintMessage("Stage 5: ")
        PrintNumber(s5_pass)
        PrintMessage("/50")
        IfCondition EqualTo(s5_pass, 50) ThenBlock: { PrintMessage(" PASS\n\n") }
        IfCondition LessThan(s5_pass, 50) ThenBlock: {
            PrintMessage(" *** FAIL ***\n\n")
            all_ok = 0
        }
    }

    // =====================================================================
    // STAGE 6: Mixed ops 128×128, 50 cycles
    // Each cycle: MatVecMul + MatTVecMul + OuterAccum
    // This is what ATTN does every training step — all 3 KCache slots active,
    // CIR state swapping between ops, data sizes changing.
    // 150 total dispatches = 5 compute resets.
    // =====================================================================
    IfCondition EqualTo(all_ok, 1) ThenBlock: {
        LogSync("STAGE6_MIXED_128x128_PRE")
        PrintMessage("--- Stage 6: Mixed ops 128x128, 50 cycles ---\n")
        PrintMessage("  (MVM+MTV+OA per cycle — the ATTN pattern)\n")

        s6_n     = 128
        s6_iters = 50
        s6_pass  = 0

        // Shared buffers
        s6_mat_elems = Multiply(s6_n, s6_n)
        s6_mat_bytes = Multiply(s6_mat_elems, 8)
        s6_vec_bytes = Multiply(s6_n, 8)

        s6_mat   = Allocate(s6_mat_bytes)
        s6_vec   = Allocate(s6_vec_bytes)
        s6_dst   = Allocate(s6_vec_bytes)
        s6_avec  = Allocate(s6_vec_bytes)
        s6_bvec  = Allocate(s6_vec_bytes)
        s6_omat  = Allocate(s6_mat_bytes)

        // Fill: mat=1, vec=j+1, avec=i+1, bvec=j+1
        s6_idx = 0
        WhileLoop LessThan(s6_idx, s6_mat_elems) {
            StoreValue(Add(s6_mat, Multiply(s6_idx, 8)), 1)
            s6_idx = Add(s6_idx, 1)
        }
        s6_j = 0
        WhileLoop LessThan(s6_j, s6_n) {
            StoreValue(Add(s6_vec,  Multiply(s6_j, 8)), Add(s6_j, 1))
            StoreValue(Add(s6_avec, Multiply(s6_j, 8)), Add(s6_j, 1))
            StoreValue(Add(s6_bvec, Multiply(s6_j, 8)), Add(s6_j, 1))
            s6_j = Add(s6_j, 1)
        }

        s6_mvm_exp = Divide(Multiply(s6_n, Add(s6_n, 1)), 2)

        s6_iter = 0
        WhileLoop LessThan(s6_iter, s6_iters) {
            s6_err = 0

            // --- MVM: dst[i] = sum_j(mat[i,j] * vec[j]) ---
            MemorySet(s6_dst, 0, s6_vec_bytes)
            HALOp.op   = 1
            HALOp.dst  = s6_dst
            HALOp.mat  = s6_mat
            HALOp.vec  = s6_vec
            HALOp.rows = s6_n
            HALOp.cols = s6_n
            rc = AccelGCN_Submit()
            IfCondition LessThan(rc, 0) ThenBlock: { s6_err = 1 }

            // Spot check MVM: dst[0] should be 8256
            IfCondition EqualTo(s6_err, 0) ThenBlock: {
                s6_got = Dereference(s6_dst)
                IfCondition NotEqual(s6_got, s6_mvm_exp) ThenBlock: {
                    PrintMessage("  MVM verify fail: got=")
                    PrintNumber(s6_got)
                    PrintMessage(" exp=")
                    PrintNumber(s6_mvm_exp)
                    PrintMessage("\n")
                    s6_err = 2
                }
            }

            // --- MTV: dst[j] = sum_i(mat[i,j] * vec[i]) ---
            IfCondition EqualTo(s6_err, 0) ThenBlock: {
                MemorySet(s6_dst, 0, s6_vec_bytes)
                HALOp.op   = 2
                HALOp.dst  = s6_dst
                HALOp.mat  = s6_mat
                HALOp.vec  = s6_vec
                HALOp.rows = s6_n
                HALOp.cols = s6_n
                rc = AccelGCN_Submit()
                IfCondition LessThan(rc, 0) ThenBlock: { s6_err = 3 }

                IfCondition EqualTo(s6_err, 0) ThenBlock: {
                    s6_got = Dereference(s6_dst)
                    IfCondition NotEqual(s6_got, s6_mvm_exp) ThenBlock: {
                        PrintMessage("  MTV verify fail: got=")
                        PrintNumber(s6_got)
                        PrintMessage(" exp=")
                        PrintNumber(s6_mvm_exp)
                        PrintMessage("\n")
                        s6_err = 4
                    }
                }
            }

            // --- OA: omat[i,j] = 0 + avec[i]*bvec[j] = (i+1)*(j+1) ---
            IfCondition EqualTo(s6_err, 0) ThenBlock: {
                MemorySet(s6_omat, 0, s6_mat_bytes)
                HALOp.op   = 3
                HALOp.dst  = s6_omat
                HALOp.mat  = s6_omat
                HALOp.vec  = s6_avec
                HALOp.vec2 = s6_bvec
                HALOp.rows = s6_n
                HALOp.cols = s6_n
                rc = AccelGCN_Submit()
                IfCondition LessThan(rc, 0) ThenBlock: { s6_err = 5 }

                // Spot check: mat[0,0]=1*1=1, mat[1,0]=2*1=2, mat[0,1]=1*2=2
                IfCondition EqualTo(s6_err, 0) ThenBlock: {
                    s6_got = Dereference(s6_omat)
                    IfCondition NotEqual(s6_got, 1) ThenBlock: {
                        PrintMessage("  OA verify fail [0,0]: got=")
                        PrintNumber(s6_got)
                        PrintMessage(" exp=1\n")
                        s6_err = 6
                    }
                }
                IfCondition EqualTo(s6_err, 0) ThenBlock: {
                    // mat[1,0] at flat index 1*128+0 = 128
                    s6_got = Dereference(Add(s6_omat, Multiply(s6_n, 8)))
                    IfCondition NotEqual(s6_got, 2) ThenBlock: {
                        PrintMessage("  OA verify fail [1,0]: got=")
                        PrintNumber(s6_got)
                        PrintMessage(" exp=2\n")
                        s6_err = 7
                    }
                }
            }

            // Print progress
            s6_print = 0
            IfCondition EqualTo(Modulo(s6_iter, 10), 0) ThenBlock: { s6_print = 1 }
            IfCondition GreaterThan(s6_err, 0) ThenBlock: { s6_print = 1 }

            IfCondition EqualTo(s6_print, 1) ThenBlock: {
                PrintMessage("  cycle ")
                PrintNumber(s6_iter)
                IfCondition EqualTo(s6_err, 0) ThenBlock: {
                    PrintMessage(": PASS (MVM+MTV+OA)\n")
                }
                IfCondition GreaterThan(s6_err, 0) ThenBlock: {
                    PrintMessage(": FAIL err=")
                    PrintNumber(s6_err)
                    PrintMessage(" (1=mvm_sub 2=mvm_ver 3=mtv_sub 4=mtv_ver 5=oa_sub 6/7=oa_ver)\n")
                }
            }

            IfCondition EqualTo(s6_err, 0) ThenBlock: {
                s6_pass = Add(s6_pass, 1)
            }

            // If submit itself failed, GPU may be wedged — stop immediately
            IfCondition EqualTo(s6_err, 1) ThenBlock: { s6_iter = s6_iters }
            IfCondition EqualTo(s6_err, 3) ThenBlock: { s6_iter = s6_iters }
            IfCondition EqualTo(s6_err, 5) ThenBlock: { s6_iter = s6_iters }

            s6_iter = Add(s6_iter, 1)
        }

        LogSyncNum("STAGE6_PASS=", s6_pass)
        PrintMessage("Stage 6: ")
        PrintNumber(s6_pass)
        PrintMessage("/")
        PrintNumber(s6_iters)
        IfCondition EqualTo(s6_pass, s6_iters) ThenBlock: { PrintMessage(" PASS\n\n") }
        IfCondition LessThan(s6_pass, s6_iters) ThenBlock: {
            PrintMessage(" *** FAIL ***\n\n")
            all_ok = 0
        }

        Deallocate(s6_mat,  s6_mat_bytes)
        Deallocate(s6_vec,  s6_vec_bytes)
        Deallocate(s6_dst,  s6_vec_bytes)
        Deallocate(s6_avec, s6_vec_bytes)
        Deallocate(s6_bvec, s6_vec_bytes)
        Deallocate(s6_omat, s6_mat_bytes)
    }

    // =====================================================================
    // STAGE 7: MatVecMul 512×128, 50 iterations
    // DFF scale — this is the W1 multiply size ATTN actually uses.
    // 512KB matrix upload, 128 unrolled iters, 8 workgroups.
    // If earlier stages pass but THIS fails → data size / WC flush problem.
    // =====================================================================
    IfCondition EqualTo(all_ok, 1) ThenBlock: {
        LogSync("STAGE7_MVM_512x128_PRE")
        PrintMessage("--- Stage 7: MatVecMul 512x128, 50 iters ---\n")
        PrintMessage("  (DFF scale: 512KB mat upload, 128 unrolled)\n")
        s7_pass = RunMVMTest(512, 128, 50)
        LogSyncNum("STAGE7_PASS=", s7_pass)
        PrintMessage("Stage 7: ")
        PrintNumber(s7_pass)
        PrintMessage("/50")
        IfCondition EqualTo(s7_pass, 50) ThenBlock: { PrintMessage(" PASS\n\n") }
        IfCondition LessThan(s7_pass, 50) ThenBlock: {
            PrintMessage(" *** FAIL ***\n\n")
            all_ok = 0
        }
    }

    // =====================================================================
    // STAGE 8: MatTVecMul 512×128, 50 iterations
    // Backward-pass scale — the transposed W1 multiply.
    // 512 unrolled iters → ~120KB machine code. I-cache killer.
    // If Stage 7 passes but THIS fails → kernel size is the problem.
    // =====================================================================
    IfCondition EqualTo(all_ok, 1) ThenBlock: {
        LogSync("STAGE8_MTV_512x128_PRE")
        PrintMessage("--- Stage 8: MatTVecMul 512x128, 50 iters ---\n")
        PrintMessage("  (backward scale: 512 unrolled iters, ~120KB shader)\n")
        s8_pass = RunMTVTest(512, 128, 50)
        LogSyncNum("STAGE8_PASS=", s8_pass)
        PrintMessage("Stage 8: ")
        PrintNumber(s8_pass)
        PrintMessage("/50")
        IfCondition EqualTo(s8_pass, 50) ThenBlock: { PrintMessage(" PASS\n\n") }
        IfCondition LessThan(s8_pass, 50) ThenBlock: {
            PrintMessage(" *** FAIL ***\n\n")
            all_ok = 0
        }
    }

    // =====================================================================
    // STAGE 9: Non-power-of-2 dimensions — MVM 200×100, 50 iters
    // Catches alignment/padding bugs. 200 rows = 4 WGs (3 full + 1 partial
    // with 8 active threads out of 64). 100 cols = odd unroll count.
    // =====================================================================
    IfCondition EqualTo(all_ok, 1) ThenBlock: {
        LogSync("STAGE9_MVM_200x100_PRE")
        PrintMessage("--- Stage 9: MatVecMul 200x100, 50 iters ---\n")
        PrintMessage("  (non-power-of-2 dims, partial WG, odd unroll)\n")
        s9_pass = RunMVMTest(200, 100, 50)
        LogSyncNum("STAGE9_PASS=", s9_pass)
        PrintMessage("Stage 9: ")
        PrintNumber(s9_pass)
        PrintMessage("/50")
        IfCondition EqualTo(s9_pass, 50) ThenBlock: { PrintMessage(" PASS\n\n") }
        IfCondition LessThan(s9_pass, 50) ThenBlock: {
            PrintMessage(" *** FAIL ***\n\n")
            all_ok = 0
        }
    }

    // =====================================================================
    // STAGE 10: Non-uniform data — MVM 128×128, 50 iters
    // mat[i,j] = i+j+1, vec[j] = j+1. Every element is unique per-row,
    // so any addressing bug (wrong row, wrong col, swapped indices)
    // produces a wrong answer for that specific row.
    // =====================================================================
    IfCondition EqualTo(all_ok, 1) ThenBlock: {
        LogSync("STAGE10_MVMIJ_128x128_PRE")
        PrintMessage("--- Stage 10: MatVecMul 128x128, non-uniform data, 50 iters ---\n")
        PrintMessage("  (mat[i,j]=i+j+1, catches addressing bugs)\n")
        s10_pass = RunMVMTestIJ(128, 128, 50)
        LogSyncNum("STAGE10_PASS=", s10_pass)
        PrintMessage("Stage 10: ")
        PrintNumber(s10_pass)
        PrintMessage("/50")
        IfCondition EqualTo(s10_pass, 50) ThenBlock: { PrintMessage(" PASS\n\n") }
        IfCondition LessThan(s10_pass, 50) ThenBlock: {
            PrintMessage(" *** FAIL ***\n\n")
            all_ok = 0
        }
    }

    // =====================================================================
    // STAGE 11: 256×256 full mixed MVM+MTV+OA, 30 cycles
    // Next JEPA DModel scale. 512KB matrix, 90 dispatches = 3 resets.
    // KCache slots sized for 256-col unroll (~60KB shader).
    // =====================================================================
    IfCondition EqualTo(all_ok, 1) ThenBlock: {
        LogSync("STAGE11_MIXED_256x256_PRE")
        PrintMessage("--- Stage 11: Mixed ops 256x256, 30 cycles ---\n")
        PrintMessage("  (JEPA DModel=256: MVM+MTV+OA per cycle, 512KB mat)\n")

        s11_n     = 256
        s11_iters = 30
        s11_pass  = 0

        s11_mat_elems = Multiply(s11_n, s11_n)
        s11_mat_bytes = Multiply(s11_mat_elems, 8)
        s11_vec_bytes = Multiply(s11_n, 8)

        s11_mat   = Allocate(s11_mat_bytes)
        s11_vec   = Allocate(s11_vec_bytes)
        s11_dst   = Allocate(s11_vec_bytes)
        s11_avec  = Allocate(s11_vec_bytes)
        s11_bvec  = Allocate(s11_vec_bytes)
        s11_omat  = Allocate(s11_mat_bytes)

        s11_idx = 0
        WhileLoop LessThan(s11_idx, s11_mat_elems) {
            StoreValue(Add(s11_mat, Multiply(s11_idx, 8)), 1)
            s11_idx = Add(s11_idx, 1)
        }
        s11_j = 0
        WhileLoop LessThan(s11_j, s11_n) {
            StoreValue(Add(s11_vec,  Multiply(s11_j, 8)), Add(s11_j, 1))
            StoreValue(Add(s11_avec, Multiply(s11_j, 8)), Add(s11_j, 1))
            StoreValue(Add(s11_bvec, Multiply(s11_j, 8)), Add(s11_j, 1))
            s11_j = Add(s11_j, 1)
        }

        s11_mvm_exp = Divide(Multiply(s11_n, Add(s11_n, 1)), 2)

        s11_iter = 0
        WhileLoop LessThan(s11_iter, s11_iters) {
            s11_err = 0

            // MVM
            MemorySet(s11_dst, 0, s11_vec_bytes)
            HALOp.op = 1
            HALOp.dst = s11_dst
            HALOp.mat = s11_mat
            HALOp.vec = s11_vec
            HALOp.rows = s11_n
            HALOp.cols = s11_n
            rc = AccelGCN_Submit()
            IfCondition LessThan(rc, 0) ThenBlock: { s11_err = 1 }
            IfCondition EqualTo(s11_err, 0) ThenBlock: {
                s11_got = Dereference(s11_dst)
                IfCondition NotEqual(s11_got, s11_mvm_exp) ThenBlock: { s11_err = 2 }
            }

            // MTV
            IfCondition EqualTo(s11_err, 0) ThenBlock: {
                MemorySet(s11_dst, 0, s11_vec_bytes)
                HALOp.op = 2
                HALOp.dst = s11_dst
                HALOp.mat = s11_mat
                HALOp.vec = s11_vec
                HALOp.rows = s11_n
                HALOp.cols = s11_n
                rc = AccelGCN_Submit()
                IfCondition LessThan(rc, 0) ThenBlock: { s11_err = 3 }
                IfCondition EqualTo(s11_err, 0) ThenBlock: {
                    s11_got = Dereference(s11_dst)
                    IfCondition NotEqual(s11_got, s11_mvm_exp) ThenBlock: { s11_err = 4 }
                }
            }

            // OA
            IfCondition EqualTo(s11_err, 0) ThenBlock: {
                MemorySet(s11_omat, 0, s11_mat_bytes)
                HALOp.op = 3
                HALOp.dst = s11_omat
                HALOp.mat = s11_omat
                HALOp.vec = s11_avec
                HALOp.vec2 = s11_bvec
                HALOp.rows = s11_n
                HALOp.cols = s11_n
                rc = AccelGCN_Submit()
                IfCondition LessThan(rc, 0) ThenBlock: { s11_err = 5 }
                IfCondition EqualTo(s11_err, 0) ThenBlock: {
                    s11_got = Dereference(s11_omat)
                    IfCondition NotEqual(s11_got, 1) ThenBlock: { s11_err = 6 }
                }
            }

            s11_print = 0
            IfCondition EqualTo(Modulo(s11_iter, 10), 0) ThenBlock: { s11_print = 1 }
            IfCondition GreaterThan(s11_err, 0) ThenBlock: { s11_print = 1 }
            IfCondition EqualTo(s11_print, 1) ThenBlock: {
                PrintMessage("  cycle ")
                PrintNumber(s11_iter)
                IfCondition EqualTo(s11_err, 0) ThenBlock: { PrintMessage(": PASS\n") }
                IfCondition GreaterThan(s11_err, 0) ThenBlock: {
                    PrintMessage(": FAIL err=")
                    PrintNumber(s11_err)
                    PrintMessage("\n")
                }
            }
            IfCondition EqualTo(s11_err, 0) ThenBlock: { s11_pass = Add(s11_pass, 1) }
            IfCondition EqualTo(s11_err, 1) ThenBlock: { s11_iter = s11_iters }
            IfCondition EqualTo(s11_err, 3) ThenBlock: { s11_iter = s11_iters }
            IfCondition EqualTo(s11_err, 5) ThenBlock: { s11_iter = s11_iters }
            s11_iter = Add(s11_iter, 1)
        }

        LogSyncNum("STAGE11_PASS=", s11_pass)
        PrintMessage("Stage 11: ")
        PrintNumber(s11_pass)
        PrintMessage("/")
        PrintNumber(s11_iters)
        IfCondition EqualTo(s11_pass, s11_iters) ThenBlock: { PrintMessage(" PASS\n\n") }
        IfCondition LessThan(s11_pass, s11_iters) ThenBlock: {
            PrintMessage(" *** FAIL ***\n\n")
            all_ok = 0
        }

        Deallocate(s11_mat,  s11_mat_bytes)
        Deallocate(s11_vec,  s11_vec_bytes)
        Deallocate(s11_dst,  s11_vec_bytes)
        Deallocate(s11_avec, s11_vec_bytes)
        Deallocate(s11_bvec, s11_vec_bytes)
        Deallocate(s11_omat, s11_mat_bytes)
    }

    // =====================================================================
    // STAGE 12: 1024×256 MVM + MTV — JEPA DFF scale
    // 2MB matrix upload. MVM has 256 unrolled iters (~60KB shader).
    // MTV has 1024 unrolled iters (~240KB shader, near 256KB limit!).
    // 20 iters each = 40 dispatches.
    // =====================================================================
    IfCondition EqualTo(all_ok, 1) ThenBlock: {
        LogSync("STAGE12_MVMMTV_1024x256_PRE")
        PrintMessage("--- Stage 12: MVM+MTV 1024x256, 20 iters each ---\n")
        PrintMessage("  (JEPA DFF=1024: 2MB mat, ~240KB MTV shader)\n")

        s12_pass = 0
        s12_iters = 20

        s12_mvm_pass = RunMVMTest(1024, 256, s12_iters)
        PrintMessage("  MVM 1024x256: ")
        PrintNumber(s12_mvm_pass)
        PrintMessage("/")
        PrintNumber(s12_iters)
        IfCondition EqualTo(s12_mvm_pass, s12_iters) ThenBlock: { PrintMessage(" PASS\n") }
        IfCondition LessThan(s12_mvm_pass, s12_iters) ThenBlock: { PrintMessage(" FAIL\n") }

        s12_mtv_pass = RunMTVTest(1024, 256, s12_iters)
        PrintMessage("  MTV 1024x256: ")
        PrintNumber(s12_mtv_pass)
        PrintMessage("/")
        PrintNumber(s12_iters)
        IfCondition EqualTo(s12_mtv_pass, s12_iters) ThenBlock: { PrintMessage(" PASS\n") }
        IfCondition LessThan(s12_mtv_pass, s12_iters) ThenBlock: { PrintMessage(" FAIL\n") }

        s12_total = Add(s12_mvm_pass, s12_mtv_pass)
        s12_expect = Multiply(s12_iters, 2)
        LogSyncNum("STAGE12_TOTAL=", s12_total)
        PrintMessage("Stage 12: ")
        PrintNumber(s12_total)
        PrintMessage("/")
        PrintNumber(s12_expect)
        IfCondition EqualTo(s12_total, s12_expect) ThenBlock: { PrintMessage(" PASS\n\n") }
        IfCondition LessThan(s12_total, s12_expect) ThenBlock: {
            PrintMessage(" *** FAIL ***\n\n")
            all_ok = 0
        }
    }

    // =====================================================================
    // STAGE 13: KCache thrash — alternating dimensions
    // Alternates between 64×64 and 128×128 MVM every iteration.
    // Forces KCache slot 0 to be overwritten constantly.
    // 40 iters = 20 of each size, all via same KCache slot (op=1).
    // =====================================================================
    IfCondition EqualTo(all_ok, 1) ThenBlock: {
        LogSync("STAGE13_KCACHE_THRASH_PRE")
        PrintMessage("--- Stage 13: KCache thrash 64/128 alternating, 40 iters ---\n")
        PrintMessage("  (alternating dims force KCache eviction every dispatch)\n")

        s13_pass  = 0
        s13_iters = 40

        // Allocate for the larger size (128×128)
        s13_mat_bytes_lg = Multiply(Multiply(128, 128), 8)
        s13_vec_bytes_lg = Multiply(128, 8)
        s13_dst_bytes_lg = Multiply(128, 8)

        s13_mat = Allocate(s13_mat_bytes_lg)
        s13_vec = Allocate(s13_vec_bytes_lg)
        s13_dst = Allocate(s13_dst_bytes_lg)

        // Fill mat = 1 for all elements (works for both sizes since 128×128 > 64×64)
        s13_fill = 0
        WhileLoop LessThan(s13_fill, Multiply(128, 128)) {
            StoreValue(Add(s13_mat, Multiply(s13_fill, 8)), 1)
            s13_fill = Add(s13_fill, 1)
        }
        // Fill vec[j] = j+1 for 128 elements
        s13_fj = 0
        WhileLoop LessThan(s13_fj, 128) {
            StoreValue(Add(s13_vec, Multiply(s13_fj, 8)), Add(s13_fj, 1))
            s13_fj = Add(s13_fj, 1)
        }

        s13_iter = 0
        WhileLoop LessThan(s13_iter, s13_iters) {
            // Alternate: even=64×64, odd=128×128
            s13_is_big = Modulo(s13_iter, 2)

            IfCondition EqualTo(s13_is_big, 0) ThenBlock: {
                s13_n = 64
            }
            IfCondition EqualTo(s13_is_big, 1) ThenBlock: {
                s13_n = 128
            }

            s13_dst_bytes = Multiply(s13_n, 8)
            MemorySet(s13_dst, 0, s13_dst_bytes)

            HALOp.op   = 1
            HALOp.dst  = s13_dst
            HALOp.mat  = s13_mat
            HALOp.vec  = s13_vec
            HALOp.rows = s13_n
            HALOp.cols = s13_n

            rc = AccelGCN_Submit()
            s13_err = 0
            IfCondition LessThan(rc, 0) ThenBlock: { s13_err = 1 }

            IfCondition EqualTo(s13_err, 0) ThenBlock: {
                s13_exp = Divide(Multiply(s13_n, Add(s13_n, 1)), 2)
                // Check first and last element
                s13_got0 = Dereference(s13_dst)
                IfCondition NotEqual(s13_got0, s13_exp) ThenBlock: { s13_err = 2 }
            }
            IfCondition EqualTo(s13_err, 0) ThenBlock: {
                s13_gotN = Dereference(Add(s13_dst, Multiply(Subtract(s13_n, 1), 8)))
                IfCondition NotEqual(s13_gotN, s13_exp) ThenBlock: { s13_err = 3 }
            }

            s13_print = 0
            IfCondition EqualTo(Modulo(s13_iter, 10), 0) ThenBlock: { s13_print = 1 }
            IfCondition GreaterThan(s13_err, 0) ThenBlock: { s13_print = 1 }
            IfCondition EqualTo(s13_print, 1) ThenBlock: {
                PrintMessage("  iter ")
                PrintNumber(s13_iter)
                PrintMessage(" (")
                PrintNumber(s13_n)
                PrintMessage("x")
                PrintNumber(s13_n)
                PrintMessage(")")
                IfCondition EqualTo(s13_err, 0) ThenBlock: { PrintMessage(": PASS\n") }
                IfCondition GreaterThan(s13_err, 0) ThenBlock: {
                    PrintMessage(": FAIL err=")
                    PrintNumber(s13_err)
                    PrintMessage("\n")
                }
            }

            IfCondition EqualTo(s13_err, 0) ThenBlock: { s13_pass = Add(s13_pass, 1) }
            IfCondition EqualTo(s13_err, 1) ThenBlock: { s13_iter = s13_iters }

            s13_iter = Add(s13_iter, 1)
        }

        LogSyncNum("STAGE13_PASS=", s13_pass)
        PrintMessage("Stage 13: ")
        PrintNumber(s13_pass)
        PrintMessage("/")
        PrintNumber(s13_iters)
        IfCondition EqualTo(s13_pass, s13_iters) ThenBlock: { PrintMessage(" PASS\n\n") }
        IfCondition LessThan(s13_pass, s13_iters) ThenBlock: {
            PrintMessage(" *** FAIL ***\n\n")
            all_ok = 0
        }

        Deallocate(s13_mat, s13_mat_bytes_lg)
        Deallocate(s13_vec, s13_vec_bytes_lg)
        Deallocate(s13_dst, s13_dst_bytes_lg)
    }

    // =====================================================================
    // STAGE 14: Endurance — 500 MVM dispatches at 128×128
    // 500 dispatches = 16 full compute resets + 20 leftover.
    // Exercises firmware reload path heavily.  If there's any state leak
    // or resource exhaustion, it shows up here.
    // =====================================================================
    IfCondition EqualTo(all_ok, 1) ThenBlock: {
        LogSync("STAGE14_ENDURANCE_128x128_PRE")
        PrintMessage("--- Stage 14: Endurance MVM 128x128, 500 iters ---\n")
        PrintMessage("  (500 dispatches = 16 compute resets)\n")
        s14_pass = RunMVMTest(128, 128, 500)
        LogSyncNum("STAGE14_PASS=", s14_pass)
        PrintMessage("Stage 14: ")
        PrintNumber(s14_pass)
        PrintMessage("/500")
        IfCondition EqualTo(s14_pass, 500) ThenBlock: { PrintMessage(" PASS\n\n") }
        IfCondition LessThan(s14_pass, 500) ThenBlock: {
            PrintMessage(" *** FAIL ***\n\n")
            all_ok = 0
        }
    }

    // =====================================================================
    // STAGE 15: Large 64-bit values — MVM 64×64, 50 iters
    // mat[i,j] = 100000, vec[j] = 100000.
    // Each product = 10^10 = 0x2_540B_E400 (needs hi DWORD).
    // Accumulated: 64 * 10^10 = 6.4 * 10^11 = 0x94_F209_0000.
    // Tests carry propagation in MulHiU32 + AddcU32 paths.
    // =====================================================================
    IfCondition EqualTo(all_ok, 1) ThenBlock: {
        LogSync("STAGE15_BIGVAL_64x64_PRE")
        PrintMessage("--- Stage 15: Large 64-bit values MVM 64x64, 50 iters ---\n")
        PrintMessage("  (val=100000, product=10^10, tests hi DWORD carry)\n")
        s15_pass = RunMVMTestBigVal(64, 64, 50)
        LogSyncNum("STAGE15_PASS=", s15_pass)
        PrintMessage("Stage 15: ")
        PrintNumber(s15_pass)
        PrintMessage("/50")
        IfCondition EqualTo(s15_pass, 50) ThenBlock: { PrintMessage(" PASS\n\n") }
        IfCondition LessThan(s15_pass, 50) ThenBlock: {
            PrintMessage(" *** FAIL ***\n\n")
            all_ok = 0
        }
    }

    // =====================================================================
    // FINAL SUMMARY
    // =====================================================================
    num_stages = 15
    PrintMessage("\n========================================\n")
    PrintMessage("=          FINAL RESULT                =\n")
    PrintMessage("========================================\n")
    IfCondition EqualTo(all_ok, 1) ThenBlock: {
        LogSync("ALL_15_STAGES_PASS")
        PrintMessage("*** ALL 15 STAGES PASS ***\n")
        PrintMessage("AccelGCN_Submit path solid through JEPA-scale stress.\n")
    }
    IfCondition EqualTo(all_ok, 0) ThenBlock: {
        LogSync("FAILURES_DETECTED")
        PrintMessage("*** FAILURES DETECTED ***\n")
        PrintMessage("Check output above for the first failing stage.\n")
    }
    PrintMessage("========================================\n")

    LogSync("SHUTDOWN_PRE")
    discard = AccelGCN_Shutdown()
    LogSync("SHUTDOWN_OK")
    PrintMessage("=== Done ===\n")
    LogSync("COMPLETE_SUCCESS")
    LogClose()
    SystemCall(60, 0, 0, 0, 0, 0)
}

RunTask(Main)
