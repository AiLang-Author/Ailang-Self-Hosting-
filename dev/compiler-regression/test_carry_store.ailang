// A store that is reloaded on the next statement still has to reach the
// next trip. The fused reload does not count as the only reader.

LibraryImport.Arena

FixedPool.CarryCheck {
    "fails": Initialize=0, CanChange=True
}

Function.Expect {
    Input: got: Integer
    Input: want: Integer
    Body: {
        IfCondition NotEqual(got, want) ThenBlock: {
            PrintMessage("FAIL got ")
            PrintNumber(got)
            PrintMessage(" want ")
            PrintNumber(want)
            PrintMessage("\n")
            CarryCheck.fails = Add(CarryCheck.fails, 1)
        }
    }
}

SubRoutine.Main {
    seed = 42
    i = 0
    s0 = 0
    s1 = 0
    s2 = 0
    s3 = 0
    s4 = 0
    s5 = 0
    x0 = 0
    x1 = 0
    x2 = 0
    x3 = 0
    x4 = 0
    x5 = 0
    WhileLoop LessThan(i, 6) {
        seed = Modulo(Add(Multiply(seed, 3877), 29573), 139968)
        idx = Modulo(seed, 16)
        IfCondition EqualTo(i, 0) ThenBlock: {
            s0 = seed
            x0 = idx
        }
        IfCondition EqualTo(i, 1) ThenBlock: {
            s1 = seed
            x1 = idx
        }
        IfCondition EqualTo(i, 2) ThenBlock: {
            s2 = seed
            x2 = idx
        }
        IfCondition EqualTo(i, 3) ThenBlock: {
            s3 = seed
            x3 = idx
        }
        IfCondition EqualTo(i, 4) ThenBlock: {
            s4 = seed
            x4 = idx
        }
        IfCondition EqualTo(i, 5) ThenBlock: {
            s5 = seed
            x5 = idx
        }
        i = Add(i, 1)
    }
    Expect(s0, 52439)
    Expect(x0, 7)
    Expect(s1, 102040)
    Expect(x1, 8)
    Expect(s2, 89085)
    Expect(x2, 13)
    Expect(s3, 111062)
    Expect(x3, 6)
    Expect(s4, 75379)
    Expect(x4, 3)
    Expect(s5, 20772)
    Expect(x5, 4)

    bit_num = 0
    i = 0
    acc = 0
    WhileLoop LessThan(i, 20) {
        bit_num = Add(bit_num, 1)
        IfCondition EqualTo(bit_num, 8) ThenBlock: {
            acc = Add(acc, 1)
            bit_num = 0
        }
        i = Add(i, 1)
    }
    Expect(acc, 2)
    Expect(bit_num, 4)

    one = Float_FromInt(1)
    zr = 0
    tr = 0
    i = 0
    WhileLoop LessThan(i, 3) {
        zr = Float_Add(zr, one)
        tr = Float_Mul(zr, zr)
        i = Add(i, 1)
    }
    Expect(Float_ToInt(tr), 9)

    buf = Allocate(8)
    n = 8
    i = 0
    WhileLoop LessThan(i, n) {
        SetByte(buf, i, Add(i, 1))
        i = Add(i, 1)
    }
    sum = 0
    i = 0
    WhileLoop LessThan(i, n) {
        b = GetByte(buf, i)
        sum = Add(sum, b)
        i = Add(i, 1)
    }
    Expect(sum, 36)

    four = Float_FromInt(4)
    x = 0
    i = 0
    limit = 10
    WhileLoop And(LessThan(i, limit), Float_Le(x, four)) {
        x = Float_Add(x, one)
        i = Add(i, 1)
    }
    Expect(i, 5)
    Expect(Float_ToInt(x), 5)

    PrintMessage("fails ")
    PrintNumber(CarryCheck.fails)
    PrintMessage("\n")
    ProcessExit(CarryCheck.fails)
}

RunTask(Main)
