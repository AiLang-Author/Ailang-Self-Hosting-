// CopyLinkage allocates and copies. CompareLinkage is 1 when the bytes match.

LibraryImport.Arena

LinkagePool.Gate {
    "seen": Initialize=0
}

FixedPool.CopyCheck {
    "fails": Initialize=0, CanChange=True
}

Function.Expect {
    Input: got: Integer
    Input: want: Integer
    Body: {
        IfCondition NotEqual(got, want) ThenBlock: {
            PrintMessage("FAIL got ")
            PrintNumber(got)
            PrintMessage(" want ")
            PrintNumber(want)
            PrintMessage("\n")
            CopyCheck.fails = Add(CopyCheck.fails, 1)
        }
    }
}

SubRoutine.Main {
    Arena_Init()
    src = AllocateLinkage(LinkagePool.Gate)
    src@seen = 7
    dst = CopyLinkage(src, LinkagePool.Gate)
    Expect(dst@seen, 7)
    src@seen = 9
    CopyLinkageInto(dst, src, LinkagePool.Gate)
    Expect(dst@seen, 9)
    Expect(CompareLinkage(dst, src, LinkagePool.Gate), 1)
    src@seen = 3
    Expect(CompareLinkage(dst, src, LinkagePool.Gate), 0)
    PrintMessage("fails ")
    PrintNumber(CopyCheck.fails)
    PrintMessage("\n")
    ProcessExit(CopyCheck.fails)
}

RunTask(Main)
