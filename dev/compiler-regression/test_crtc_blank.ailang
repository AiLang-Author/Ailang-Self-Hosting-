// test_crtc_blank.ailang — CRTC blank/unblank safety test
//
// Proves we can blank and unblank the display safely.
// Your screen WILL go black briefly (~100ms) then restore.
// If it doesn't restore, the GPU is still running — just power-cycle the monitor
// or switch VT (Ctrl+Alt+F2 then F1).
//
// Since the radeon/amdgpu driver is unbound and we're on VESA, CRTC 0 is
// the BIOS-configured pipe driving the framebuffer.
//
// Build: ./ailang.x dev/compiler-regression/test_crtc_blank.ailang -o test_crtc_blank.x
// Run:   ./test_crtc_blank.x 2>&1 | tee crtc_blank_log.txt

LibraryImport.Drivers.AMDGPU.AMDGPUFamily
LibraryImport.Drivers.AMDGPU.AMDGPUDiscover
LibraryImport.Drivers.AMDGPU.AMDGPUBAR
LibraryImport.Drivers.AMDGPU.AMDGPUPM4Regs
LibraryImport.Drivers.AMDGPU.AMDGPUDisplay

// =============================================================================
// BusyWait — spin delay via MMIO reads (each read ~100ns on PCIe)
// count=1000 ~ 0.1ms, count=10000 ~ 1ms, count=1000000 ~ 100ms
// =============================================================================
Function.BusyWait {
    Input: gpu: Integer
    Input: count: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, count) {
            // Read a harmless register to burn time
            fence = GPU_Rd32(gpu, SIReg.VGA_RENDER_CONTROL)
            i = Add(i, 1)
        }
    }
}

// =============================================================================
// MAIN
// =============================================================================
Function.Main {
    Body: {
        PrintMessage("=== CRTC Blank/Unblank Test ===\n")
        PrintMessage("Screen will go BLACK briefly then restore.\n")
        PrintMessage("If stuck black: Ctrl+Alt+F2 then F1, or power-cycle monitor.\n\n")

        // GPU discovery + BAR mapping
        n_gpus = GPU_Discover()
        IfCondition EqualTo(n_gpus, 0) ThenBlock: {
            PrintMessage("FAIL: no AMD GPU found\n")
            ReturnValue(1)
        }

        gpu = 0
        GPU_BAR_Init()
        rc = GPU_BAR_MapMMIO(gpu)
        IfCondition EqualTo(rc, 0) ThenBlock: {
            PrintMessage("FAIL: MMIO map failed\n")
            ReturnValue(1)
        }
        PrintMessage("[INIT] MMIO mapped\n")

        // Scan which CRTCs are active
        PrintMessage("\n--- Pre-blank CRTC state ---\n")
        active_count = 0
        pipe = 0
        WhileLoop LessThan(pipe, 6) {
            active = DCE6_IsCRTCActive(gpu, pipe)
            IfCondition EqualTo(active, 1) ThenBlock: {
                crtc_base = DCE6_GetCRTCBase(pipe)
                blank_ctl = GPU_Rd32(gpu, Add(crtc_base, DCE6Reg.CRTC_BLANK_CONTROL_OFF))
                PrintMessage("  CRTC ")
                PrintNumber(pipe)
                PrintMessage(": ACTIVE  BLANK_CONTROL=0x")
                PrintHex(blank_ctl)
                PrintMessage("\n")
                active_count = Add(active_count, 1)
            }
            pipe = Add(pipe, 1)
        }
        PrintMessage("  Active CRTCs: ")
        PrintNumber(active_count)
        PrintMessage("\n")

        IfCondition EqualTo(active_count, 0) ThenBlock: {
            PrintMessage("\nNo active CRTCs — nothing to blank. Test skipped.\n")
            PrintMessage("=== test_crtc_blank complete ===\n")
            SystemCall(60, 0, 0, 0, 0, 0)
        }

        // ========= BLANK =========
        PrintMessage("\n--- Blanking all active CRTCs ---\n")
        blanked = DCE6_BlankAllActive(gpu)
        PrintMessage("  Blanked: ")
        PrintNumber(blanked)
        PrintMessage(" CRTCs\n")

        // Verify blank took effect
        pipe = 0
        WhileLoop LessThan(pipe, 6) {
            active = DCE6_IsCRTCActive(gpu, pipe)
            IfCondition EqualTo(active, 1) ThenBlock: {
                crtc_base = DCE6_GetCRTCBase(pipe)
                blank_ctl = GPU_Rd32(gpu, Add(crtc_base, DCE6Reg.CRTC_BLANK_CONTROL_OFF))
                blank_on = BitwiseAnd(blank_ctl, CRTCBits.CRTC_BLANK_DATA_EN)
                PrintMessage("  CRTC ")
                PrintNumber(pipe)
                PrintMessage(": BLANK_CONTROL=0x")
                PrintHex(blank_ctl)
                IfCondition NotEqual(blank_on, 0) ThenBlock: { PrintMessage("  [BLANKED]") }
                IfCondition EqualTo(blank_on, 0) ThenBlock: { PrintMessage("  [NOT BLANKED — FAIL]") }
                PrintMessage("\n")
            }
            pipe = Add(pipe, 1)
        }

        // Brief delay — ~100ms of black screen
        // 1,000,000 MMIO reads at ~100ns each ≈ 100ms
        BusyWait(gpu, 1000000)

        // ========= UNBLANK =========
        PrintMessage("\n--- Unblanking all active CRTCs ---\n")
        unblanked = DCE6_UnblankAllActive(gpu)
        PrintMessage("  Unblanked: ")
        PrintNumber(unblanked)
        PrintMessage(" CRTCs\n")

        // Verify unblank took effect
        pipe = 0
        WhileLoop LessThan(pipe, 6) {
            active = DCE6_IsCRTCActive(gpu, pipe)
            IfCondition EqualTo(active, 1) ThenBlock: {
                crtc_base = DCE6_GetCRTCBase(pipe)
                blank_ctl = GPU_Rd32(gpu, Add(crtc_base, DCE6Reg.CRTC_BLANK_CONTROL_OFF))
                blank_on = BitwiseAnd(blank_ctl, CRTCBits.CRTC_BLANK_DATA_EN)
                PrintMessage("  CRTC ")
                PrintNumber(pipe)
                PrintMessage(": BLANK_CONTROL=0x")
                PrintHex(blank_ctl)
                IfCondition NotEqual(blank_on, 0) ThenBlock: { PrintMessage("  [STILL BLANKED — FAIL]") }
                IfCondition EqualTo(blank_on, 0) ThenBlock: { PrintMessage("  [RESTORED]") }
                PrintMessage("\n")
            }
            pipe = Add(pipe, 1)
        }

        // Final verification
        PrintMessage("\n--- Verification ---\n")
        IfCondition GreaterThan(blanked, 0) ThenBlock: {
            IfCondition EqualTo(blanked, unblanked) ThenBlock: {
                PrintMessage("  [CHK1] Blank/unblank round-trip: PASS (")
                PrintNumber(blanked)
                PrintMessage(" blanked, ")
                PrintNumber(unblanked)
                PrintMessage(" restored)\n")
            }
            IfCondition NotEqual(blanked, unblanked) ThenBlock: {
                PrintMessage("  [CHK1] Blank/unblank round-trip: FAIL (")
                PrintNumber(blanked)
                PrintMessage(" blanked, ")
                PrintNumber(unblanked)
                PrintMessage(" restored)\n")
            }
        }
        PrintMessage("  [CHK2] Display restored: check your screen!\n")

        PrintMessage("\n=== test_crtc_blank complete ===\n")
        SystemCall(60, 0, 0, 0, 0, 0)
    }
}

RunTask(Main)
