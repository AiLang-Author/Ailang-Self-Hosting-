// Fence for Library.Crypto: SHA256, HMAC, Base64URL, JWT HS256.
LibraryImport.Arena
LibraryImport.Crypto

SubRoutine.Main {
    bad = 0

    d0 = Crypto.SHA256("", 0)
    h0 = Crypto.DigestHex(d0)
    IfCondition NotEqual(StringCompare(h0, "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"), 0) ThenBlock: {
        PrintMessage("FAIL sha256 empty got ")
        PrintMessage(h0)
        PrintMessage("\n")
        bad = Add(bad, 1)
    }

    d1 = Crypto.SHA256("abc", 3)
    h1 = Crypto.DigestHex(d1)
    IfCondition NotEqual(StringCompare(h1, "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"), 0) ThenBlock: {
        PrintMessage("FAIL sha256 abc got ")
        PrintMessage(h1)
        PrintMessage("\n")
        bad = Add(bad, 1)
    }

    msg = "The quick brown fox jumps over the lazy dog"
    d2 = Crypto.HMAC_SHA256("key", 3, msg, StringLength(msg))
    h2 = Crypto.DigestHex(d2)
    IfCondition NotEqual(StringCompare(h2, "f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd8"), 0) ThenBlock: {
        PrintMessage("FAIL hmac got ")
        PrintMessage(h2)
        PrintMessage("\n")
        bad = Add(bad, 1)
    }

    enc = Crypto.Base64UrlEncode("abc", 3)
    IfCondition NotEqual(StringCompare(enc, "YWJj"), 0) ThenBlock: {
        PrintMessage("FAIL b64 encode got ")
        PrintMessage(enc)
        PrintMessage("\n")
        bad = Add(bad, 1)
    }
    dec = Crypto.Base64UrlDecode("YWJj", 4)
    IfCondition NotEqual(StringCompare(dec, "abc"), 0) ThenBlock: {
        PrintMessage("FAIL b64 decode got ")
        PrintMessage(dec)
        PrintMessage("\n")
        bad = Add(bad, 1)
    }

    tok = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxIiwidXNlcm5hbWUiOiJnb2xkZW5fZW1iZXJfMSIsImlhdCI6MTcwMDAwMDAwMCwiZXhwIjoyMDAwMDAwMDAwfQ.eY9aaLG5NFg6gwKM9JNh4sBrJp5rmWUFTt3npF892hU"
    r = Crypto.JWT_HS256(tok, "twelve-dollar-challenge", 1700000000)
    IfCondition NotEqual(r, 1) ThenBlock: {
        PrintMessage("FAIL jwt good rc=")
        PrintNumber(r)
        PrintMessage("\n")
        bad = Add(bad, 1)
    }
    IfCondition NotEqual(Crypto.JWT_Uid(), 1) ThenBlock: {
        PrintMessage("FAIL jwt uid\n")
        bad = Add(bad, 1)
    }
    uname = Crypto.JWT_Username()
    uname_ok = StringCompare(uname, "golden_ember_1")
    IfCondition NotEqual(uname_ok, 0) ThenBlock: {
        PrintMessage("FAIL jwt name\n")
        bad = Add(bad, 1)
    }

    badsub = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJhYmMiLCJ1c2VybmFtZSI6ImdvbGRlbl9lbWJlcl8xIiwiaWF0IjoxNzAwMDAwMDAwLCJleHAiOjIwMDAwMDAwMDB9.XXud6TOQSvmyu3NIPOjV3lgwM9JZ-KFjLGlY9PDdKT0"
    r2 = Crypto.JWT_HS256(badsub, "twelve-dollar-challenge", 1700000000)
    IfCondition NotEqual(r2, 2) ThenBlock: {
        PrintMessage("FAIL jwt bad sub rc=")
        PrintNumber(r2)
        PrintMessage("\n")
        bad = Add(bad, 1)
    }

    expired = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxIiwidXNlcm5hbWUiOiJnb2xkZW5fZW1iZXJfMSIsImlhdCI6MTAwMCwiZXhwIjoyMDAwfQ.rX-tUKjaYu9iHDrxme6b93Qy4CICf_eAhSe5keggEvM"
    r3 = Crypto.JWT_HS256(expired, "twelve-dollar-challenge", 1700000000)
    IfCondition NotEqual(r3, 0) ThenBlock: {
        PrintMessage("FAIL jwt expired rc=")
        PrintNumber(r3)
        PrintMessage("\n")
        bad = Add(bad, 1)
    }

    r4 = Crypto.JWT_HS256("abc", "twelve-dollar-challenge", 1700000000)
    IfCondition NotEqual(r4, 0) ThenBlock: {
        PrintMessage("FAIL jwt garbage rc=")
        PrintNumber(r4)
        PrintMessage("\n")
        bad = Add(bad, 1)
    }

    IfCondition EqualTo(bad, 0) ThenBlock: {
        PrintMessage("PASS\n")
    }
    Exit(bad)
}
RunTask(Main)
