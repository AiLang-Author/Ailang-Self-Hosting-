// Probe: does referencing an undefined "DebugPerf.Start(...)" call
// compile and run, or does it segfault like wc does?
LibraryImport.Arena

SubRoutine.Main {
    SystemCall(1, 1, "before\n", 7)
    DebugPerf.Start("Test")
    SystemCall(1, 1, "after start\n", 12)
    DebugPerf.End("Test")
    SystemCall(1, 1, "after end\n", 10)
    SystemCall(60, 0)
}
RunTask(Main)
