// test_deskbar_blit.ailang
// Exact replica of Deskbar_Draw MemoryCopy loop to isolate hang.
// Tests the EXACT expression nesting pattern from the real code.
//
// Build:
//   ./ailang.x dev/compiler-regression/test_deskbar_blit.ailang test_deskbar_blit.x
//   ./test_deskbar_blit.x

LibraryImport.Arena
LibraryImport.Display.Render.DSurfaceTypes
LibraryImport.Display.Render.DSurface

// Stub DebugLog_Push
Function.DebugLog_Push {
    Input: tag: Address
    Input: len: Integer
    Body: { ReturnValue(0) }
}

// =============================================================================
// TEST A: Exact Deskbar_Draw code path
// Uses the EXACT variable names and expressions from Library.Deskbar.ailang:680
// =============================================================================
Function.Test_ExactDeskbar {
    Body: {
        PrintMessage("=== TEST A: Exact Deskbar_Draw pattern ===\n")

        // Simulate DeskbarState values
        sw = 640
        sh = 480
        db_h = 32
        hzh = 2
        pb = 4

        // Create real surface
        surf = Surface_Create(SurfaceFormat.PIXEL_32, sw, db_h)
        IfCondition EqualTo(surf, 0) ThenBlock: {
            PrintMessage("[FAIL] Surface_Create\n")
            ReturnValue(0)
        }

        // Fill surface with known pattern
        src_data = Surface_GetData(surf)
        src_pitch = Surface_GetPitch(surf)
        fill_size = Multiply(db_h, src_pitch)
        i = 0
        WhileLoop LessThan(i, fill_size) {
            SetByte(src_data, i, BitwiseAnd(i, 255))
            i = Add(i, 1)
        }

        // Allocate fake framebuffer
        pit = Multiply(sw, pb)
        buf_size = Multiply(sh, pit)
        buf = Allocate(buf_size)
        // Clear
        ci = 0
        WhileLoop LessThan(ci, buf_size) {
            SetByte(buf, ci, 0)
            ci = Add(ci, 1)
        }

        // dst_y calculation from Deskbar_Draw
        dst_y = Subtract(sh, Add(db_h, hzh))

        PrintMessage("  dst_y=")
        PrintNumber(dst_y)
        PrintMessage(" db_h=")
        PrintNumber(db_h)
        PrintMessage(" sw=")
        PrintNumber(sw)
        PrintMessage("\n")

        // EXACT loop from Deskbar_Draw lines 675-682
        row_bytes = Multiply(sw, pb)
        y = 0
        WhileLoop LessThan(y, db_h) {
            src_row = Add(src_data, Multiply(y, src_pitch))
            dst_ptr = Add(buf, Multiply(Add(dst_y, y), pit))
            MemoryCopy(dst_ptr, src_row, row_bytes)
            y = Add(y, 1)
        }

        PrintMessage("  Loop complete, verifying...\n")

        // Verify
        fail = 0
        y = 0
        WhileLoop LessThan(y, db_h) {
            i = 0
            WhileLoop LessThan(i, row_bytes) {
                src_off = Add(Multiply(y, src_pitch), i)
                dst_off = Add(Multiply(Add(dst_y, y), pit), i)
                expected = GetByte(src_data, src_off)
                actual = GetByte(buf, dst_off)
                IfCondition NotEqual(actual, expected) ThenBlock: {
                    IfCondition EqualTo(fail, 0) ThenBlock: {
                        PrintMessage("  [FAIL] y=")
                        PrintNumber(y)
                        PrintMessage(" i=")
                        PrintNumber(i)
                        PrintMessage(" exp=")
                        PrintNumber(expected)
                        PrintMessage(" got=")
                        PrintNumber(actual)
                        PrintMessage("\n")
                    }
                    fail = Add(fail, 1)
                }
                i = Add(i, 1)
            }
            y = Add(y, 1)
        }

        IfCondition EqualTo(fail, 0) ThenBlock: {
            PrintMessage("  [PASS] Test A\n")
        } ElseBlock: {
            PrintMessage("  [FAIL] Test A — ")
            PrintNumber(fail)
            PrintMessage(" mismatches\n")
        }

        Surface_Destroy(surf)
        Deallocate(buf, buf_size)
    }
}

// =============================================================================
// TEST B: Win_BlitAll simulation with real surfaces
// Desktop blit (byte-by-byte) + Deskbar_Draw (MemoryCopy) + FB_FlipFast
// =============================================================================
Function.Test_WinBlitAll_Sim {
    Body: {
        PrintMessage("\n=== TEST B: Win_BlitAll simulation (real surfaces) ===\n")

        pb = 4
        fb_w = 640
        fb_h = 480
        fb_pitch = Multiply(fb_w, pb)
        fb_size = Multiply(fb_h, fb_pitch)

        // "Back buffer" + "front buffer"
        back_buf = Allocate(fb_size)
        front_buf = Allocate(fb_size)

        // Desktop surface (full screen)
        desk_surf = Surface_Create(SurfaceFormat.PIXEL_32, fb_w, fb_h)
        desk_data = Surface_GetData(desk_surf)
        desk_pitch = Surface_GetPitch(desk_surf)
        // Fill with 0x1A
        desk_fill = Multiply(fb_h, desk_pitch)
        di = 0
        WhileLoop LessThan(di, desk_fill) {
            SetByte(desk_data, di, 0x1A)
            di = Add(di, 1)
        }

        // Deskbar surface (640 x 32)
        db_h = 32
        db_surf = Surface_Create(SurfaceFormat.PIXEL_32, fb_w, db_h)
        db_data = Surface_GetData(db_surf)
        db_pitch = Surface_GetPitch(db_surf)
        db_fill = Multiply(db_h, db_pitch)
        di = 0
        WhileLoop LessThan(di, db_fill) {
            SetByte(db_data, di, 0xAA)
            di = Add(di, 1)
        }

        PrintMessage("  Running 20 frames...\n")

        frame = 0
        WhileLoop LessThan(frame, 20) {
            // === Win_BlitOne for desktop (byte-by-byte, matching working tree) ===
            row_bytes_d = Multiply(fb_w, pb)
            by = 0
            WhileLoop LessThan(by, fb_h) {
                src_row = Add(desk_data, Multiply(by, desk_pitch))
                dst_row = Add(back_buf, Multiply(by, fb_pitch))
                bi = 0
                WhileLoop LessThan(bi, row_bytes_d) {
                    SetByte(dst_row, bi, GetByte(src_row, bi))
                    bi = Add(bi, 1)
                }
                by = Add(by, 1)
            }

            // === Deskbar_Draw (MemoryCopy, matching committed code) ===
            dst_y = Subtract(fb_h, db_h)
            row_bytes_db = Multiply(fb_w, pb)
            dy = 0
            WhileLoop LessThan(dy, db_h) {
                src_row2 = Add(db_data, Multiply(dy, db_pitch))
                dst_ptr2 = Add(back_buf, Multiply(Add(dst_y, dy), fb_pitch))
                MemoryCopy(dst_ptr2, src_row2, row_bytes_db)
                dy = Add(dy, 1)
            }

            // === FB_FlipFast (single MemoryCopy) ===
            MemoryCopy(front_buf, back_buf, fb_size)

            // Quick sanity check each frame
            db_start = Multiply(Subtract(fb_h, db_h), fb_pitch)
            v1 = GetByte(front_buf, db_start)
            IfCondition NotEqual(v1, 0xAA) ThenBlock: {
                PrintMessage("  [FAIL] frame=")
                PrintNumber(frame)
                PrintMessage(" deskbar byte mismatch: ")
                PrintNumber(v1)
                PrintMessage("\n")
                ReturnValue(0)
            }

            v2 = GetByte(front_buf, 0)
            IfCondition NotEqual(v2, 0x1A) ThenBlock: {
                PrintMessage("  [FAIL] frame=")
                PrintNumber(frame)
                PrintMessage(" desktop byte mismatch: ")
                PrintNumber(v2)
                PrintMessage("\n")
                ReturnValue(0)
            }

            frame = Add(frame, 1)
        }
        PrintMessage("  [PASS] Test B — 20 frames OK\n")

        Surface_Destroy(desk_surf)
        Surface_Destroy(db_surf)
        Deallocate(back_buf, fb_size)
        Deallocate(front_buf, fb_size)
    }
}

// =============================================================================
// TEST C: Win_BlitOne with MemoryCopy (the pattern that was reverted)
// Tests the flattened addressing from commit 4142a01
// =============================================================================
Function.Test_WinBlitOne_MemCopy {
    Body: {
        PrintMessage("\n=== TEST C: Win_BlitOne with MemoryCopy (flattened) ===\n")

        pb = 4
        // Create source surface
        sw = 320
        sh = 240
        surf = Surface_Create(SurfaceFormat.PIXEL_32, sw, sh)
        src_data = Surface_GetData(surf)
        src_pitch = Surface_GetPitch(surf)
        fill_s = Multiply(sh, src_pitch)
        si = 0
        WhileLoop LessThan(si, fill_s) {
            SetByte(src_data, si, BitwiseAnd(si, 255))
            si = Add(si, 1)
        }

        // Framebuffer
        fb_w = 640
        fb_h = 480
        dst_pitch = Multiply(fb_w, pb)
        fb_size = Multiply(fb_h, dst_pitch)
        dst_buf = Allocate(fb_size)
        ci = 0
        WhileLoop LessThan(ci, fb_size) {
            SetByte(dst_buf, ci, 0)
            ci = Add(ci, 1)
        }

        // Blit at (100, 50)
        dst_x = 100
        dst_y = 50
        draw_w = sw
        draw_h = sh
        src_x0 = 0
        src_y0 = 0

        row_bytes = Multiply(draw_w, pb)
        PrintMessage("  Blitting ")
        PrintNumber(draw_w)
        PrintMessage("x")
        PrintNumber(draw_h)
        PrintMessage(" at (")
        PrintNumber(dst_x)
        PrintMessage(",")
        PrintNumber(dst_y)
        PrintMessage(") with MemoryCopy...\n")

        // EXACT flattened pattern from commit 4142a01
        y = 0
        WhileLoop LessThan(y, draw_h) {
            sry = Add(y, src_y0)
            dry = Add(y, dst_y)
            sr_off = Add(Multiply(sry, src_pitch), Multiply(src_x0, pb))
            src_row = Add(src_data, sr_off)
            dr_off = Add(Multiply(dry, dst_pitch), Multiply(dst_x, pb))
            dst_row = Add(dst_buf, dr_off)
            MemoryCopy(dst_row, src_row, row_bytes)
            y = Add(y, 1)
        }

        PrintMessage("  Verifying...\n")

        fail = 0
        y = 0
        WhileLoop LessThan(y, draw_h) {
            i = 0
            WhileLoop LessThan(i, row_bytes) {
                sry = Add(y, src_y0)
                dry = Add(y, dst_y)
                src_off = Add(Multiply(sry, src_pitch), Add(Multiply(src_x0, pb), i))
                dst_off = Add(Multiply(dry, dst_pitch), Add(Multiply(dst_x, pb), i))
                expected = GetByte(src_data, src_off)
                actual = GetByte(dst_buf, dst_off)
                IfCondition NotEqual(actual, expected) ThenBlock: {
                    IfCondition EqualTo(fail, 0) ThenBlock: {
                        PrintMessage("  [FAIL] y=")
                        PrintNumber(y)
                        PrintMessage(" i=")
                        PrintNumber(i)
                        PrintMessage(" exp=")
                        PrintNumber(expected)
                        PrintMessage(" got=")
                        PrintNumber(actual)
                        PrintMessage("\n")
                    }
                    fail = Add(fail, 1)
                }
                i = Add(i, 1)
            }
            y = Add(y, 1)
        }

        IfCondition EqualTo(fail, 0) ThenBlock: {
            PrintMessage("  [PASS] Test C\n")
        } ElseBlock: {
            PrintMessage("  [FAIL] Test C — ")
            PrintNumber(fail)
            PrintMessage(" mismatches\n")
        }

        Surface_Destroy(surf)
        Deallocate(dst_buf, fb_size)
    }
}

// =============================================================================
// TEST D: Stress — rapid alternating MemoryCopy sizes
// Mixed large + small copies in tight loop (catches alignment/remainder bugs)
// =============================================================================
Function.Test_Stress {
    Body: {
        PrintMessage("\n=== TEST D: Stress — mixed copy sizes ===\n")
        big_size = 307200   // 640*480
        src = Allocate(big_size)
        dst = Allocate(big_size)

        pass = 1
        iter = 0
        WhileLoop LessThan(iter, 200) {
            // Vary copy size: 1, 15, 16, 17, 31, 32, 33, 100, 1000, etc.
            size = Add(Multiply(iter, 37), 1)
            IfCondition GreaterThan(size, big_size) ThenBlock: {
                size = big_size
            }

            // Fill src
            fi = 0
            WhileLoop LessThan(fi, size) {
                SetByte(src, fi, BitwiseAnd(Add(fi, iter), 255))
                fi = Add(fi, 1)
            }

            // Clear dst
            ci = 0
            WhileLoop LessThan(ci, size) {
                SetByte(dst, ci, 0)
                ci = Add(ci, 1)
            }

            MemoryCopy(dst, src, size)

            // Verify
            vi = 0
            WhileLoop LessThan(vi, size) {
                IfCondition NotEqual(GetByte(dst, vi), GetByte(src, vi)) ThenBlock: {
                    PrintMessage("  [FAIL] iter=")
                    PrintNumber(iter)
                    PrintMessage(" size=")
                    PrintNumber(size)
                    PrintMessage(" offset=")
                    PrintNumber(vi)
                    PrintMessage("\n")
                    pass = 0
                    vi = size  // break
                }
                vi = Add(vi, 1)
            }

            iter = Add(iter, 1)
        }

        IfCondition EqualTo(pass, 1) ThenBlock: {
            PrintMessage("  [PASS] Test D — 200 iterations OK\n")
        }

        Deallocate(src, big_size)
        Deallocate(dst, big_size)
    }
}

// =============================================================================
// TEST E: Multi-window Win_BlitAll with MemoryCopy everywhere
// This is the endgame: if this passes, MemoryCopy can be rolled back in
// =============================================================================
Function.Test_MultiWindow {
    Body: {
        PrintMessage("\n=== TEST E: Multi-window pipeline with MemoryCopy ===\n")

        pb = 4
        fb_w = 640
        fb_h = 480
        fb_pitch = Multiply(fb_w, pb)
        fb_size = Multiply(fb_h, fb_pitch)

        back_buf = Allocate(fb_size)
        front_buf = Allocate(fb_size)

        // Desktop
        desk_w = fb_w
        desk_h = fb_h
        desk_pitch = Multiply(desk_w, pb)
        desk_data = Allocate(Multiply(desk_h, desk_pitch))
        di = 0
        WhileLoop LessThan(di, fb_size) {
            SetByte(desk_data, di, 0x11)
            di = Add(di, 1)
        }

        // 3 windows at different positions
        win1_w = 200
        win1_h = 100
        win1_pitch = Multiply(win1_w, pb)
        win1_data = Allocate(Multiply(win1_h, win1_pitch))
        wi = 0
        WhileLoop LessThan(wi, Multiply(win1_h, win1_pitch)) {
            SetByte(win1_data, wi, 0x22)
            wi = Add(wi, 1)
        }

        win2_w = 150
        win2_h = 80
        win2_pitch = Multiply(win2_w, pb)
        win2_data = Allocate(Multiply(win2_h, win2_pitch))
        wi = 0
        WhileLoop LessThan(wi, Multiply(win2_h, win2_pitch)) {
            SetByte(win2_data, wi, 0x33)
            wi = Add(wi, 1)
        }

        win3_w = 300
        win3_h = 200
        win3_pitch = Multiply(win3_w, pb)
        win3_data = Allocate(Multiply(win3_h, win3_pitch))
        wi = 0
        WhileLoop LessThan(wi, Multiply(win3_h, win3_pitch)) {
            SetByte(win3_data, wi, 0x44)
            wi = Add(wi, 1)
        }

        // Deskbar
        db_h = 32
        db_pitch = Multiply(fb_w, pb)
        db_data = Allocate(Multiply(db_h, db_pitch))
        di = 0
        WhileLoop LessThan(di, Multiply(db_h, db_pitch)) {
            SetByte(db_data, di, 0xBB)
            di = Add(di, 1)
        }

        PrintMessage("  Running 10 frames with 3 windows + deskbar...\n")

        frame = 0
        WhileLoop LessThan(frame, 10) {
            // Desktop blit (MemoryCopy, full screen)
            dy = 0
            WhileLoop LessThan(dy, fb_h) {
                src_row = Add(desk_data, Multiply(dy, desk_pitch))
                dst_row = Add(back_buf, Multiply(dy, fb_pitch))
                MemoryCopy(dst_row, src_row, Multiply(fb_w, pb))
                dy = Add(dy, 1)
            }

            // Window 1 at (50, 30)
            w1x = 50
            w1y = 30
            w1rb = Multiply(win1_w, pb)
            wy = 0
            WhileLoop LessThan(wy, win1_h) {
                sry = wy
                dry = Add(w1y, wy)
                src_row = Add(win1_data, Multiply(sry, win1_pitch))
                dr_off = Add(Multiply(dry, fb_pitch), Multiply(w1x, pb))
                dst_row = Add(back_buf, dr_off)
                MemoryCopy(dst_row, src_row, w1rb)
                wy = Add(wy, 1)
            }

            // Window 2 at (300, 200)
            w2x = 300
            w2y = 200
            w2rb = Multiply(win2_w, pb)
            wy = 0
            WhileLoop LessThan(wy, win2_h) {
                sry = wy
                dry = Add(w2y, wy)
                src_row = Add(win2_data, Multiply(sry, win2_pitch))
                dr_off = Add(Multiply(dry, fb_pitch), Multiply(w2x, pb))
                dst_row = Add(back_buf, dr_off)
                MemoryCopy(dst_row, src_row, w2rb)
                wy = Add(wy, 1)
            }

            // Window 3 at (100, 100) — largest
            w3x = 100
            w3y = 100
            w3rb = Multiply(win3_w, pb)
            wy = 0
            WhileLoop LessThan(wy, win3_h) {
                sry = wy
                dry = Add(w3y, wy)
                src_row = Add(win3_data, Multiply(sry, win3_pitch))
                dr_off = Add(Multiply(dry, fb_pitch), Multiply(w3x, pb))
                dst_row = Add(back_buf, dr_off)
                MemoryCopy(dst_row, src_row, w3rb)
                wy = Add(wy, 1)
            }

            // Deskbar at bottom
            dst_y = Subtract(fb_h, db_h)
            dbrb = Multiply(fb_w, pb)
            dy = 0
            WhileLoop LessThan(dy, db_h) {
                src_row = Add(db_data, Multiply(dy, db_pitch))
                dst_ptr = Add(back_buf, Multiply(Add(dst_y, dy), fb_pitch))
                MemoryCopy(dst_ptr, src_row, dbrb)
                dy = Add(dy, 1)
            }

            // FB flip
            MemoryCopy(front_buf, back_buf, fb_size)

            frame = Add(frame, 1)
        }

        // Verify deskbar region
        db_off = Multiply(Subtract(fb_h, db_h), fb_pitch)
        v1 = GetByte(front_buf, db_off)
        // Verify desktop region (top-left, not covered by any window)
        v2 = GetByte(front_buf, 0)
        // Verify window 1 area
        w1_off = Add(Multiply(30, fb_pitch), Multiply(50, pb))
        v3 = GetByte(front_buf, w1_off)

        pass = 1
        IfCondition NotEqual(v1, 0xBB) ThenBlock: {
            PrintMessage("  [FAIL] deskbar ")
            PrintNumber(v1)
            PrintMessage("\n")
            pass = 0
        }
        IfCondition NotEqual(v2, 0x11) ThenBlock: {
            PrintMessage("  [FAIL] desktop ")
            PrintNumber(v2)
            PrintMessage("\n")
            pass = 0
        }
        IfCondition NotEqual(v3, 0x22) ThenBlock: {
            PrintMessage("  [FAIL] win1 ")
            PrintNumber(v3)
            PrintMessage("\n")
            pass = 0
        }

        IfCondition EqualTo(pass, 1) ThenBlock: {
            PrintMessage("  [PASS] Test E — 10 multi-window frames OK\n")
        }

        Deallocate(back_buf, fb_size)
        Deallocate(front_buf, fb_size)
        Deallocate(desk_data, fb_size)
        Deallocate(win1_data, Multiply(win1_h, win1_pitch))
        Deallocate(win2_data, Multiply(win2_h, win2_pitch))
        Deallocate(win3_data, Multiply(win3_h, win3_pitch))
        Deallocate(db_data, Multiply(db_h, db_pitch))
    }
}

// =============================================================================
// ENTRY
// =============================================================================
SubRoutine.Main {
    Arena_Init()
    PrintMessage("=== Deskbar + WinBlit MemoryCopy Hang Test ===\n")
    PrintMessage("Testing exact code patterns from display pipeline\n\n")

    Test_ExactDeskbar()
    Test_WinBlitAll_Sim()
    Test_WinBlitOne_MemCopy()
    Test_Stress()
    Test_MultiWindow()

    PrintMessage("\n=== ALL TESTS COMPLETE ===\n")
}

RunTask(Main)
