// Drive the problematic regex through DFA on a subset of corpus to
// see how many DFA states it produces before overflow.

LibraryImport.Arena
LibraryImport.Regex_Thompson

SubRoutine.Main {
    r = Regex_Compile("(F[a-z]+|[A-Z][a-z]+)\.([A-Z][a-z]+)+", 0)
    IfCondition EqualTo(r, 0) ThenBlock: {
        PrintMessage("COMPILE_FAIL\n")
        SystemCall(60, 1)
    }

    ok = Regex_DFAInit(r)
    PrintMessage("DFA_INIT_OK=") PrintNumber(ok) PrintMessage("\n")
    PrintMessage("num_states=") PrintNumber(RegexState.num_states) PrintMessage("\n")

    // Read first ~100KB of the stress corpus.
    fd = SystemCall(2, "/tmp/grep_stress.txt", 0, 0)
    IfCondition LessThan(fd, 0) ThenBlock: {
        PrintMessage("OPEN_FAIL\n")
        SystemCall(60, 1)
    }
    buf = Allocate(102400)
    n = SystemCall(0, fd, buf, 102400)
    SystemCall(3, fd)
    PrintMessage("read=") PrintNumber(n) PrintMessage("\n")

    // Walk line-by-line, count matches via DFA, track DFA state growth.
    line_start = 0
    line_count = 0
    match_count = 0
    dfa_ret_neg = 0
    i = 0
    WhileLoop LessThan(i, n) {
        IfCondition EqualTo(GetByte(buf, i), 10) ThenBlock: {
            line_count = Add(line_count, 1)
            line_len = Subtract(i, line_start)
            m = Regex_DFASearch(Add(buf, line_start), line_len)
            IfCondition EqualTo(m, 1) ThenBlock: { match_count = Add(match_count, 1) }
            IfCondition LessThan(m, 0) ThenBlock: { dfa_ret_neg = Add(dfa_ret_neg, 1) }
            line_start = Add(i, 1)
        }
        i = Add(i, 1)
    }

    PrintMessage("lines=")    PrintNumber(line_count) PrintMessage("\n")
    PrintMessage("matches=")  PrintNumber(match_count) PrintMessage("\n")
    PrintMessage("dfa_neg=")  PrintNumber(dfa_ret_neg) PrintMessage("\n")
    PrintMessage("dfa_count=") PrintNumber(DFA.count) PrintMessage("\n")
    PrintMessage("dfa_cap=")   PrintNumber(DFA.cap) PrintMessage("\n")
    PrintMessage("overflow=")  PrintNumber(DFA.overflow) PrintMessage("\n")

    SystemCall(60, 0)
}
RunTask(Main)
