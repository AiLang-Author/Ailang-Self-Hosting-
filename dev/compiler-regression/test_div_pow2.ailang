// Toward-zero Divide by a positive power of two.
// SAR rounds toward -infinity. The cases below catch that.

LibraryImport.Arena

FixedPool.DivCheck {
    "fails": Initialize=0, CanChange=True
}

Function.Expect {
    Input: got: Integer
    Input: want: Integer
    Body: {
        IfCondition NotEqual(got, want) ThenBlock: {
            PrintMessage("FAIL got ")
            PrintNumber(got)
            PrintMessage(" want ")
            PrintNumber(want)
            PrintMessage("\n")
            DivCheck.fails = Add(DivCheck.fails, 1)
        }
    }
}

SubRoutine.Main {
    Expect(Divide(5, 2), 2)
    Expect(Divide(5, 4), 1)
    Expect(Divide(5, 8), 0)
    Expect(Divide(7, 2), 3)
    Expect(Divide(7, 4), 1)
    Expect(Divide(8, 2), 4)
    Expect(Divide(8, 4), 2)
    Expect(Divide(8, 8), 1)
    Expect(Divide(9, 8), 1)
    Expect(Divide(1, 1), 1)
    Expect(Divide(0, 2), 0)
    Expect(Divide(0, 8), 0)
    Expect(Divide(6, 2), 3)
    Expect(Divide(100, 4), 25)
    Expect(Divide(15, 8), 1)
    Expect(Divide(Negate(1), 2), 0)
    Expect(Divide(Negate(1), 4), 0)
    Expect(Divide(Negate(1), 8), 0)
    Expect(Divide(Negate(2), 2), Negate(1))
    Expect(Divide(Negate(3), 2), Negate(1))
    Expect(Divide(Negate(4), 2), Negate(2))
    Expect(Divide(Negate(5), 2), Negate(2))
    Expect(Divide(Negate(5), 4), Negate(1))
    Expect(Divide(Negate(7), 4), Negate(1))
    Expect(Divide(Negate(8), 4), Negate(2))
    Expect(Divide(Negate(9), 8), Negate(1))
    Expect(Divide(Negate(9), 2), Negate(4))
    Expect(Divide(Negate(100), 4), Negate(25))
    Expect(Divide(Negate(15), 8), Negate(1))
    PrintMessage("fails ")
    PrintNumber(DivCheck.fails)
    PrintMessage("\n")
    ProcessExit(DivCheck.fails)
}

RunTask(Main)
