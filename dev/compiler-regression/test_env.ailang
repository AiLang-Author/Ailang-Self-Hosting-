// Fence for Library.Env: PATH exists, missing key is 0, FOO_AILANG_TEST if set.
LibraryImport.Arena
LibraryImport.Env

SubRoutine.Main {
    bad = 0
    path = Env.Get("PATH")
    IfCondition EqualTo(path, 0) ThenBlock: {
        PrintMessage("FAIL PATH missing\n")
        bad = Add(bad, 1)
    }
    miss = Env.Get("THIS_ENV_KEY_DOES_NOT_EXIST_AILANG")
    IfCondition NotEqual(miss, 0) ThenBlock: {
        PrintMessage("FAIL missing key returned non-zero\n")
        bad = Add(bad, 1)
    }
    foo = Env.Get("FOO_AILANG_TEST")
    IfCondition NotEqual(foo, 0) ThenBlock: {
        IfCondition NotEqual(StringCompare(foo, "hello"), 0) ThenBlock: {
            PrintMessage("FAIL FOO_AILANG_TEST want hello got ")
            PrintMessage(foo)
            PrintMessage("\n")
            bad = Add(bad, 1)
        }
    }
    IfCondition EqualTo(bad, 0) ThenBlock: {
        PrintMessage("PASS\n")
    }
    Exit(bad)
}
RunTask(Main)
