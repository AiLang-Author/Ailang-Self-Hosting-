// Fence: listen + epoll accept + echo one request.
LibraryImport.Arena
LibraryImport.Socket

SubRoutine.Main {
    bad = 0
    listen_fd = Socket.Create(2, 1)
    IfCondition LessThan(listen_fd, 0) ThenBlock: {
        PrintMessage("FAIL create listen\n")
        Exit(1)
    }
    ru = Socket.SetReuseAddr(listen_fd)
    bn = Socket.BindInet(listen_fd, "127.0.0.1", 18765)
    IfCondition LessThan(bn, 0) ThenBlock: {
        PrintMessage("FAIL bind\n")
        Exit(1)
    }
    ln = Socket.Listen(listen_fd, 32)
    IfCondition LessThan(ln, 0) ThenBlock: {
        PrintMessage("FAIL listen\n")
        Exit(1)
    }
    nb = Socket.SetNonBlock(listen_fd)
    epfd = Epoll.Create()
    IfCondition LessThan(epfd, 0) ThenBlock: {
        PrintMessage("FAIL epoll_create\n")
        Exit(1)
    }
    ad = Epoll.Add(epfd, listen_fd, 1, listen_fd)
    IfCondition LessThan(ad, 0) ThenBlock: {
        PrintMessage("FAIL epoll add listen\n")
        Exit(1)
    }

    cli = Socket.Create(2, 1)
    caddr = Socket.CreateAddr("127.0.0.1", 18765)
    cr = Socket.Connect(cli, caddr)
    IfCondition LessThan(cr, 0) ThenBlock: {
        PrintMessage("FAIL connect\n")
        Exit(1)
    }

    evbuf = Allocate(192)
    n = Epoll.Wait(epfd, evbuf, 16, 2000)
    IfCondition LessEqual(n, 0) ThenBlock: {
        PrintMessage("FAIL wait accept n=")
        PrintNumber(n)
        PrintMessage("\n")
        Exit(1)
    }
    slot = Epoll.Slot(evbuf, 0)
    data = Epoll.DataAt(slot)
    IfCondition NotEqual(data, listen_fd) ThenBlock: {
        PrintMessage("FAIL listen data\n")
        bad = Add(bad, 1)
    }
    srv = Socket.Accept4(listen_fd)
    IfCondition LessThan(srv, 0) ThenBlock: {
        PrintMessage("FAIL accept4\n")
        Exit(1)
    }
    Socket.SetTcpNoDelay(srv)
    ad2 = Epoll.Add(epfd, srv, 1, srv)
    IfCondition LessThan(ad2, 0) ThenBlock: {
        PrintMessage("FAIL epoll add srv\n")
        bad = Add(bad, 1)
    }

    sent = Socket.Send(cli, "ping", 4)
    n2 = Epoll.Wait(epfd, evbuf, 16, 2000)
    IfCondition LessEqual(n2, 0) ThenBlock: {
        PrintMessage("FAIL wait recv\n")
        Exit(1)
    }
    buf = Allocate(16)
    got = Socket.RecvNB(srv, buf, 16)
    IfCondition NotEqual(got, 4) ThenBlock: {
        PrintMessage("FAIL recvn=")
        PrintNumber(got)
        PrintMessage("\n")
        bad = Add(bad, 1)
    }
    IfCondition NotEqual(GetByte(buf, 0), 112) ThenBlock: {
        PrintMessage("FAIL ping bytes\n")
        bad = Add(bad, 1)
    }
    Socket.SendNB(srv, "pong", 4)
    rbuf = Allocate(16)
    rg = Socket.Recv(cli, rbuf, 16)
    IfCondition NotEqual(rg, 4) ThenBlock: {
        PrintMessage("FAIL client recvn=")
        PrintNumber(rg)
        PrintMessage("\n")
        bad = Add(bad, 1)
    }
    IfCondition NotEqual(GetByte(rbuf, 1), 111) ThenBlock: {
        PrintMessage("FAIL pong bytes\n")
        bad = Add(bad, 1)
    }

    Socket.Close(cli)
    Socket.Close(srv)
    Socket.Close(listen_fd)
    IfCondition EqualTo(bad, 0) ThenBlock: {
        PrintMessage("PASS\n")
    }
    Exit(bad)
}
RunTask(Main)
