// test_filedialog.ailang
// Standalone terminal test for file dialog tree traversal + PostgreSQL
// Exercises the same PG queries and Auckland tree building that
// FileDialog_Open / FD_PopulateFiles do, WITHOUT any display/surface code.
//
// Build & Run:
//   cd /home/bob/Ailang-Self-Hosting-
//   ./ailang.x dev/compiler-regression/test_filedialog.ailang test_filedialog.x
//   ./test_filedialog.x
//
// Requires: PostgreSQL running, database ailang_system, user bob

LibraryImport.Arena
LibraryImport.Socket
LibraryImport.Hash
LibraryImport.Arrays
LibraryImport.StringUtils
LibraryImport.PostgreSQL_Complete
LibraryImport.Display.UI.Auckland
LibraryImport.Display.UI.AucklandEvent

// Stub for DebugLog_Push — normally in SysDisplay, but we don't want
// to pull in the entire display stack for a terminal test.
// Auckland and AucklandEvent call this internally.
Function.DebugLog_Push {
    Input: tag: Address
    Input: len: Integer
    Body: {
        ReturnValue(0)
    }
}

FixedPool.TestState {
    "pass": Initialize=0, CanChange=True
    "fail": Initialize=0, CanChange=True
}

// =========================================================================
// HELPERS
// =========================================================================
Function.Test_Pass {
    Input: label: Address
    Body: {
        PrintMessage("  [PASS] ")
        PrintString(label)
        PrintMessage("\n")
        TestState.pass = Add(TestState.pass, 1)
    }
}

Function.Test_Fail {
    Input: label: Address
    Body: {
        PrintMessage("  [FAIL] ")
        PrintString(label)
        PrintMessage("\n")
        TestState.fail = Add(TestState.fail, 1)
    }
}

// =========================================================================
// TEST 1: Connect to database
// =========================================================================
Function.Test_Connect {
    Output: Integer
    Body: {
        PrintMessage("\n=== TEST 1: PostgreSQL Connect ===\n")
        conn = PG_Connect("127.0.0.1", 5432, "ailang_system", "bob", "")
        IfCondition EqualTo(conn, 0) ThenBlock: {
            Test_Fail("PG_Connect returned 0")
            ReturnValue(0)
        }
        Test_Pass("Connected to ailang_system")
        ReturnValue(conn)
    }
}

// =========================================================================
// TEST 2: Verify files table exists and has seed data
// =========================================================================
Function.Test_FilesTable {
    Input: conn: Integer
    Body: {
        PrintMessage("\n=== TEST 2: Files table seed data ===\n")

        r = PG_Query(conn, "SELECT COUNT(*) AS cnt FROM files")
        IfCondition EqualTo(r, 0) ThenBlock: {
            Test_Fail("SELECT COUNT(*) query failed")
            ReturnValue(0)
        }

        row = Array.Get(r, 0)
        cv = Hash.Get(row, "cnt")
        IfCondition EqualTo(cv, 0) ThenBlock: {
            PG_DestroyResult(r)
            Test_Fail("cnt column returned null")
            ReturnValue(0)
        }

        PrintMessage("  files count = ")
        PrintString(cv)
        PrintMessage("\n")

        cnt = StringToNumber(cv)
        PG_DestroyResult(r)

        IfCondition GreaterThan(cnt, 0) ThenBlock: {
            Test_Pass("files table has rows")
        } ElseBlock: {
            Test_Fail("files table is EMPTY")
        }
    }
}

// =========================================================================
// TEST 3: Root listing query (same as FD_PopulateFiles with parent_id=NULL)
// =========================================================================
Function.Test_RootListing {
    Input: conn: Integer
    Body: {
        PrintMessage("\n=== TEST 3: Root dir listing (parent_id IS NULL) ===\n")

        r = PG_Query(conn, "SELECT id, name, type, size FROM files WHERE parent_id IS NULL ORDER BY type DESC, name")
        IfCondition EqualTo(r, 0) ThenBlock: {
            Test_Fail("Root listing query failed")
            ReturnValue(0)
        }

        rc = Array.Size(r)
        PrintMessage("  Root listing: ")
        PrintNumber(rc)
        PrintMessage(" rows\n")

        IfCondition EqualTo(rc, 0) ThenBlock: {
            PG_DestroyResult(r)
            Test_Fail("Root listing returned 0 rows")
            ReturnValue(0)
        }

        // Walk each row - print and validate pointers
        ri = 0
        all_ok = 1
        WhileLoop LessThan(ri, rc) {
            row = Array.Get(r, ri)
            IfCondition EqualTo(row, 0) ThenBlock: {
                PrintMessage("  [ERR] XGet returned 0 at row ")
                PrintNumber(ri)
                PrintMessage("\n")
                all_ok = 0
            } ElseBlock: {
                v_id   = Hash.Get(row, "id")
                v_name = Hash.Get(row, "name")
                v_type = Hash.Get(row, "type")

                PrintMessage("    row ")
                PrintNumber(ri)
                PrintMessage(": id=")
                IfCondition NotEqual(v_id, 0) ThenBlock: {
                    PrintString(v_id)
                } ElseBlock: {
                    PrintMessage("(null)")
                    all_ok = 0
                }
                PrintMessage(" name=")
                IfCondition NotEqual(v_name, 0) ThenBlock: {
                    PrintString(v_name)
                } ElseBlock: {
                    PrintMessage("(null)")
                    all_ok = 0
                }
                PrintMessage(" type=")
                IfCondition NotEqual(v_type, 0) ThenBlock: {
                    PrintString(v_type)
                } ElseBlock: {
                    PrintMessage("(null)")
                }
                PrintMessage("\n")
            }
            ri = Add(ri, 1)
        }

        PG_DestroyResult(r)

        IfCondition EqualTo(all_ok, 1) ThenBlock: {
            Test_Pass("Root listing all rows valid")
        } ElseBlock: {
            Test_Fail("Root listing had null/bad rows")
        }
    }
}

// =========================================================================
// TEST 4: Child listing query (same as FD_PopulateFiles with parent_id=1)
// =========================================================================
Function.Test_ChildListing {
    Input: conn: Integer
    Input: parent_id: Integer
    Body: {
        PrintMessage("\n=== TEST 4: Child listing (parent_id=")
        PrintNumber(parent_id)
        PrintMessage(") ===\n")

        q1 = "SELECT id, name, type, size FROM files WHERE parent_id = "
        id_str = NumberToString(parent_id)
        q2 = StringConcat(q1, id_str)
        q3 = StringConcat(q2, " ORDER BY type DESC, name")

        PrintMessage("  Query: ")
        PrintString(q3)
        PrintMessage("\n")

        r = PG_Query(conn, q3)
        IfCondition EqualTo(r, 0) ThenBlock: {
            Test_Fail("Child listing query failed")
            ReturnValue(0)
        }

        rc = Array.Size(r)
        PrintMessage("  Child listing: ")
        PrintNumber(rc)
        PrintMessage(" rows\n")

        ri = 0
        all_ok = 1
        WhileLoop LessThan(ri, rc) {
            row = Array.Get(r, ri)
            IfCondition EqualTo(row, 0) ThenBlock: {
                PrintMessage("  [ERR] XGet returned 0 at row ")
                PrintNumber(ri)
                PrintMessage("\n")
                all_ok = 0
            } ElseBlock: {
                v_id   = Hash.Get(row, "id")
                v_name = Hash.Get(row, "name")
                v_type = Hash.Get(row, "type")

                PrintMessage("    row ")
                PrintNumber(ri)
                PrintMessage(": id=")
                IfCondition NotEqual(v_id, 0) ThenBlock: {
                    PrintString(v_id)
                } ElseBlock: {
                    PrintMessage("(null)")
                    all_ok = 0
                }
                PrintMessage(" name=")
                IfCondition NotEqual(v_name, 0) ThenBlock: {
                    PrintString(v_name)
                } ElseBlock: {
                    PrintMessage("(null)")
                    all_ok = 0
                }
                PrintMessage(" type=")
                IfCondition NotEqual(v_type, 0) ThenBlock: {
                    PrintString(v_type)
                } ElseBlock: {
                    PrintMessage("(null)")
                }
                PrintMessage("\n")

                // Test string compare on type (same as FileDialog does)
                IfCondition NotEqual(v_type, 0) ThenBlock: {
                    cmp = StringCompare(v_type, "dir")
                    IfCondition EqualTo(cmp, 0) ThenBlock: {
                        PrintMessage("      ^ is_dir=1\n")
                    }
                }
            }
            ri = Add(ri, 1)
        }

        PG_DestroyResult(r)

        IfCondition EqualTo(all_ok, 1) ThenBlock: {
            Test_Pass("Child listing all rows valid")
        } ElseBlock: {
            Test_Fail("Child listing had null/bad rows")
        }
    }
}

// =========================================================================
// TEST 5: StringConcat chain (same as FD_PopulateFiles action string build)
// =========================================================================
Function.Test_StringConcat {
    Body: {
        PrintMessage("\n=== TEST 5: StringConcat action string build ===\n")

        // Simulate what FileDialog does: "fd.nav:" + id_string
        action_prefix = "fd.nav:"
        id_str = NumberToString(42)
        action_str = StringConcat(action_prefix, id_str)
        action_len = StringLength(action_str)

        PrintMessage("  action_str = '")
        PrintString(action_str)
        PrintMessage("' len=")
        PrintNumber(action_len)
        PrintMessage("\n")

        // Validate prefix bytes (same check as FD_HandleAction)
        f0 = GetByte(action_str, 0)
        f1 = GetByte(action_str, 1)
        f2 = GetByte(action_str, 2)
        f3 = GetByte(action_str, 3)
        f4 = GetByte(action_str, 4)
        f5 = GetByte(action_str, 5)
        f6 = GetByte(action_str, 6)

        ok = 1
        // "fd.nav:" = 102 100 46 110 97 118 58
        IfCondition NotEqual(f0, 102) ThenBlock: { ok = 0 }
        IfCondition NotEqual(f1, 100) ThenBlock: { ok = 0 }
        IfCondition NotEqual(f2, 46)  ThenBlock: { ok = 0 }
        IfCondition NotEqual(f3, 110) ThenBlock: { ok = 0 }
        IfCondition NotEqual(f4, 97)  ThenBlock: { ok = 0 }
        IfCondition NotEqual(f5, 118) ThenBlock: { ok = 0 }
        IfCondition NotEqual(f6, 58)  ThenBlock: { ok = 0 }

        IfCondition EqualTo(ok, 1) ThenBlock: {
            // Parse back the number
            num_ptr = Add(action_str, 7)
            parsed = StringToNumber(num_ptr)
            PrintMessage("  parsed id = ")
            PrintNumber(parsed)
            PrintMessage("\n")
            IfCondition EqualTo(parsed, 42) ThenBlock: {
                Test_Pass("StringConcat + parse roundtrip")
            } ElseBlock: {
                Test_Fail("Parsed id != 42")
            }
        } ElseBlock: {
            Test_Fail("Prefix byte mismatch")
        }
    }
}

// =========================================================================
// TEST 6: Auckland tree build (same pattern as FD_BuildTree + FD_PopulateFiles)
// =========================================================================
Function.Test_AKTreeBuild {
    Input: conn: Integer
    Body: {
        PrintMessage("\n=== TEST 6: Auckland tree build from PG data ===\n")

        // Create AK context (same as Dialog_Create does)
        ctx = AK_CreateContext()
        IfCondition EqualTo(ctx, 0) ThenBlock: {
            Test_Fail("AK_CreateContext returned 0")
            ReturnValue(0)
        }
        PrintMessage("  AK context created\n")

        // Build root node (WINDOW, VBOX) like FD_BuildTree
        root = AK_CreateNode(ctx, AKTag.WINDOW)
        AK_Set(ctx, root, AKF.LAYOUT_MODE, AKLayout.VBOX)
        AK_Set(ctx, root, AKF.PAD_T, 4)
        AK_Set(ctx, root, AKF.PAD_R, 4)
        AK_Set(ctx, root, AKF.PAD_B, 4)
        AK_Set(ctx, root, AKF.PAD_L, 4)
        AK_Set(ctx, root, AKF.GAP, 2)
        AK_SetRoot(ctx, root)
        PrintMessage("  Root node created (idx=0)\n")

        // Create file list container (PANEL, VBOX) like FD_BuildTree
        file_list = AK_CreateNode(ctx, AKTag.PANEL)
        AK_Set(ctx, file_list, AKF.LAYOUT_MODE, AKLayout.VBOX)
        AK_Set(ctx, file_list, AKF.GROW, 1)
        AK_Set(ctx, file_list, AKF.GAP, 2)
        AK_AddChild(ctx, root, file_list)
        PrintMessage("  File list container created (idx=1)\n")

        // Query root directory (same query as FD_PopulateFiles)
        r = PG_Query(conn, "SELECT id, name, type, size FROM files WHERE parent_id IS NULL ORDER BY type DESC, name")
        IfCondition EqualTo(r, 0) ThenBlock: {
            Test_Fail("PG_Query for root listing failed")
            AK_DestroyContext(ctx)
            ReturnValue(0)
        }

        rc = Array.Size(r)
        PrintMessage("  Query returned ")
        PrintNumber(rc)
        PrintMessage(" rows, building AK nodes...\n")

        // Build buttons from query results (same as FD_PopulateFiles loop)
        ri = 0
        build_ok = 1
        WhileLoop LessThan(ri, rc) {
            row = Array.Get(r, ri)
            IfCondition EqualTo(row, 0) ThenBlock: {
                PrintMessage("  [ERR] null row at ")
                PrintNumber(ri)
                PrintMessage("\n")
                build_ok = 0
                ri = Add(ri, 1)
            } ElseBlock: {
                v_id   = Hash.Get(row, "id")
                v_name = Hash.Get(row, "name")
                v_type = Hash.Get(row, "type")

                is_dir = 0
                IfCondition NotEqual(v_type, 0) ThenBlock: {
                    cmp = StringCompare(v_type, "dir")
                    IfCondition EqualTo(cmp, 0) ThenBlock: { is_dir = 1 }
                }

                display = v_name
                display_len = StringLength(v_name)
                IfCondition EqualTo(is_dir, 1) ThenBlock: {
                    display = StringConcat(v_name, "/")
                    display_len = Add(display_len, 1)
                }

                action_prefix = "fd.select:"
                IfCondition EqualTo(is_dir, 1) ThenBlock: {
                    action_prefix = "fd.nav:"
                }
                action_str = StringConcat(action_prefix, v_id)
                action_len = StringLength(action_str)

                // Create BUTTON node
                row_node = AK_CreateNode(ctx, AKTag.BUTTON)
                IfCondition LessThan(row_node, 0) ThenBlock: {
                    PrintMessage("  [ERR] AK_CreateNode failed at row ")
                    PrintNumber(ri)
                    PrintMessage("\n")
                    build_ok = 0
                } ElseBlock: {
                    AK_Set(ctx, row_node, AKF.HEIGHT, 20)
                    AK_ExtraSet(ctx, row_node, AKExtra.STR_PTR, display)
                    AK_ExtraSet(ctx, row_node, AKExtra.STR_LEN, display_len)
                    AK_ExtraSet(ctx, row_node, AKExtra.ACTION_PTR, action_str)
                    AK_ExtraSet(ctx, row_node, AKExtra.ACTION_LEN, action_len)
                    AK_ExtraSet(ctx, row_node, AKExtra.TEXT_ALIGN, 0)
                    AK_AddChild(ctx, file_list, row_node)

                    PrintMessage("    node ")
                    PrintNumber(row_node)
                    PrintMessage(": '")
                    PrintString(display)
                    PrintMessage("' action='")
                    PrintString(action_str)
                    PrintMessage("'\n")
                }

                ri = Add(ri, 1)
            }
        }

        PG_DestroyResult(r)

        // Verify tree integrity: walk children of file_list
        PrintMessage("\n  Tree walk (file_list children):\n")
        child = AK_Get(ctx, file_list, AKF.FIRST_CHILD)
        walk_count = 0
        guard = 0
        WhileLoop NotEqual(child, -1) {
            guard = Add(guard, 1)
            IfCondition GreaterThan(guard, 100) ThenBlock: {
                PrintMessage("  [ERR] INFINITE LOOP in sibling walk!\n")
                build_ok = 0
                BreakLoop
            }

            tag = AK_Get(ctx, child, AKF.TAG)
            parent = AK_Get(ctx, child, AKF.PARENT)
            ns = AK_Get(ctx, child, AKF.NEXT_SIBLING)

            PrintMessage("    child ")
            PrintNumber(child)
            PrintMessage(": tag=")
            PrintNumber(tag)
            PrintMessage(" parent=")
            PrintNumber(parent)
            PrintMessage(" next=")
            PrintNumber(ns)

            // Check parent pointer
            IfCondition NotEqual(parent, file_list) ThenBlock: {
                PrintMessage(" [BAD PARENT!]")
                build_ok = 0
            }

            // Check for self-referencing next_sibling
            IfCondition EqualTo(ns, child) ThenBlock: {
                PrintMessage(" [SELF-LOOP!]")
                build_ok = 0
            }

            PrintMessage("\n")
            walk_count = Add(walk_count, 1)
            child = ns
        }

        PrintMessage("  Walked ")
        PrintNumber(walk_count)
        PrintMessage(" children, expected ")
        PrintNumber(rc)
        PrintMessage("\n")

        child_count = AK_Get(ctx, file_list, AKF.CHILD_COUNT)
        PrintMessage("  CHILD_COUNT = ")
        PrintNumber(child_count)
        PrintMessage("\n")

        IfCondition NotEqual(walk_count, rc) ThenBlock: {
            PrintMessage("  [ERR] Walk count mismatch!\n")
            build_ok = 0
        }

        IfCondition NotEqual(child_count, rc) ThenBlock: {
            PrintMessage("  [ERR] CHILD_COUNT mismatch!\n")
            build_ok = 0
        }

        // Verify tree_count
        tree_count = AK_GetTreeCount(ctx)
        // Expected: root(1) + file_list(1) + rc buttons
        expected_nodes = Add(2, rc)
        PrintMessage("  tree_count = ")
        PrintNumber(tree_count)
        PrintMessage(" expected = ")
        PrintNumber(expected_nodes)
        PrintMessage("\n")

        IfCondition NotEqual(tree_count, expected_nodes) ThenBlock: {
            PrintMessage("  [ERR] tree_count mismatch!\n")
            build_ok = 0
        }

        AK_DestroyContext(ctx)

        IfCondition EqualTo(build_ok, 1) ThenBlock: {
            Test_Pass("AK tree built and walked cleanly")
        } ElseBlock: {
            Test_Fail("AK tree build or walk had errors")
        }
    }
}

// =========================================================================
// TEST 7: Recursive directory traversal (walk the whole tree from PG)
// =========================================================================
Function.Test_RecursiveTraversal {
    Input: conn: Integer
    Body: {
        PrintMessage("\n=== TEST 7: Recursive directory traversal ===\n")
        total = Test_WalkDir(conn, 0, 0)
        PrintMessage("  Total entries walked: ")
        PrintNumber(total)
        PrintMessage("\n")
        IfCondition GreaterThan(total, 0) ThenBlock: {
            Test_Pass("Recursive traversal completed")
        } ElseBlock: {
            Test_Fail("Recursive traversal found nothing")
        }
    }
}

Function.Test_WalkDir {
    Input: conn: Integer
    Input: parent_id: Integer
    Input: depth: Integer
    Output: Integer
    Body: {
        // Guard against infinite recursion (circular parent_id)
        IfCondition GreaterThan(depth, 10) ThenBlock: {
            PrintMessage("[ERR] DEPTH > 10 — possible cycle!\n")
            ReturnValue(0)
        }

        r = 0
        IfCondition EqualTo(parent_id, 0) ThenBlock: {
            r = PG_Query(conn, "SELECT id, name, type FROM files WHERE parent_id IS NULL ORDER BY type DESC, name")
        } ElseBlock: {
            q1 = "SELECT id, name, type FROM files WHERE parent_id = "
            id_str = NumberToString(parent_id)
            q2 = StringConcat(q1, id_str)
            q3 = StringConcat(q2, " ORDER BY type DESC, name")
            r = PG_Query(conn, q3)
        }

        IfCondition EqualTo(r, 0) ThenBlock: {
            ReturnValue(0)
        }

        rc = Array.Size(r)
        total = rc

        ri = 0
        WhileLoop LessThan(ri, rc) {
            row = Array.Get(r, ri)
            IfCondition NotEqual(row, 0) ThenBlock: {
                v_id   = Hash.Get(row, "id")
                v_name = Hash.Get(row, "name")
                v_type = Hash.Get(row, "type")

                // Indent by depth
                di = 0
                WhileLoop LessThan(di, depth) {
                    PrintMessage("  ")
                    di = Add(di, 1)
                }

                is_dir = 0
                IfCondition NotEqual(v_type, 0) ThenBlock: {
                    cmp = StringCompare(v_type, "dir")
                    IfCondition EqualTo(cmp, 0) ThenBlock: { is_dir = 1 }
                }

                IfCondition EqualTo(is_dir, 1) ThenBlock: {
                    PrintMessage("  [DIR]  ")
                } ElseBlock: {
                    PrintMessage("  [FILE] ")
                }

                IfCondition NotEqual(v_name, 0) ThenBlock: {
                    PrintString(v_name)
                } ElseBlock: {
                    PrintMessage("(null name!)")
                }

                PrintMessage(" (id=")
                IfCondition NotEqual(v_id, 0) ThenBlock: {
                    PrintString(v_id)
                } ElseBlock: {
                    PrintMessage("null")
                }
                PrintMessage(")\n")

                // Recurse into directories
                IfCondition EqualTo(is_dir, 1) ThenBlock: {
                    IfCondition NotEqual(v_id, 0) ThenBlock: {
                        child_id = StringToNumber(v_id)
                        sub = Test_WalkDir(conn, child_id, Add(depth, 1))
                        total = Add(total, sub)
                    }
                }
            }
            ri = Add(ri, 1)
        }

        PG_DestroyResult(r)
        ReturnValue(total)
    }
}

// =========================================================================
// TEST 8: AK_DrawDirtyWalk on the built tree (no canvas - just walk)
// =========================================================================
Function.Test_DrawDirtyWalk {
    Input: conn: Integer
    Body: {
        PrintMessage("\n=== TEST 8: AK_DrawDirtyWalk (no render, walk only) ===\n")

        ctx = AK_CreateContext()
        IfCondition EqualTo(ctx, 0) ThenBlock: {
            Test_Fail("AK_CreateContext failed")
            ReturnValue(0)
        }

        // Build a tree like the file dialog
        root = AK_CreateNode(ctx, AKTag.WINDOW)
        AK_Set(ctx, root, AKF.LAYOUT_MODE, AKLayout.VBOX)
        AK_SetRoot(ctx, root)

        fl = AK_CreateNode(ctx, AKTag.PANEL)
        AK_Set(ctx, fl, AKF.LAYOUT_MODE, AKLayout.VBOX)
        AK_Set(ctx, fl, AKF.GROW, 1)
        AK_AddChild(ctx, root, fl)

        // Add some buttons
        r = PG_Query(conn, "SELECT id, name, type FROM files WHERE parent_id IS NULL ORDER BY type DESC, name")
        IfCondition NotEqual(r, 0) ThenBlock: {
            rc = Array.Size(r)
            ri = 0
            WhileLoop LessThan(ri, rc) {
                row = Array.Get(r, ri)
                IfCondition NotEqual(row, 0) ThenBlock: {
                    v_name = Hash.Get(row, "name")
                    btn = AK_CreateNode(ctx, AKTag.BUTTON)
                    AK_Set(ctx, btn, AKF.HEIGHT, 20)
                    IfCondition NotEqual(v_name, 0) ThenBlock: {
                        AK_ExtraSet(ctx, btn, AKExtra.STR_PTR, v_name)
                        AK_ExtraSet(ctx, btn, AKExtra.STR_LEN, StringLength(v_name))
                    }
                    AK_AddChild(ctx, fl, btn)
                }
                ri = Add(ri, 1)
            }
            PG_DestroyResult(r)
        }

        PrintMessage("  Tree built: ")
        PrintNumber(AK_GetTreeCount(ctx))
        PrintMessage(" nodes\n")

        // Mark all dirty
        node_count = AK_GetTreeCount(ctx)
        ni = 0
        WhileLoop LessThan(ni, node_count) {
            AK_Set(ctx, ni, AKF.DIRTY, 1)
            ni = Add(ni, 1)
        }

        // Now walk dirty — WITHOUT a canvas (canvas=0 causes AK_DrawNode to early-out)
        // This tests the WALK itself for infinite loops
        PrintMessage("  Walking dirty tree (canvas=0, draw will be skipped)...\n")

        // Manual walk to check for cycles
        walk_ok = 1
        stack_idx = 0
        check_node = AK_Get(ctx, root, AKF.FIRST_CHILD)
        walk_total = 0
        WhileLoop NotEqual(check_node, -1) {
            walk_total = Add(walk_total, 1)
            IfCondition GreaterThan(walk_total, 1000) ThenBlock: {
                PrintMessage("  [ERR] Walk exceeded 1000 nodes - LOOP!\n")
                walk_ok = 0
                BreakLoop
            }

            // Check children
            sub = AK_Get(ctx, check_node, AKF.FIRST_CHILD)
            sub_guard = 0
            WhileLoop NotEqual(sub, -1) {
                sub_guard = Add(sub_guard, 1)
                IfCondition GreaterThan(sub_guard, 1000) ThenBlock: {
                    PrintMessage("  [ERR] Child walk exceeded 1000!\n")
                    walk_ok = 0
                    BreakLoop
                }
                walk_total = Add(walk_total, 1)
                sub = AK_Get(ctx, sub, AKF.NEXT_SIBLING)
            }

            check_node = AK_Get(ctx, check_node, AKF.NEXT_SIBLING)
        }

        PrintMessage("  Walk visited ")
        PrintNumber(walk_total)
        PrintMessage(" nodes\n")

        AK_DestroyContext(ctx)

        IfCondition EqualTo(walk_ok, 1) ThenBlock: {
            Test_Pass("Dirty walk completed without loops")
        } ElseBlock: {
            Test_Fail("Dirty walk detected cycle")
        }
    }
}

// =========================================================================
// TEST 9: Menu tree build (same as Menu_Show)
// =========================================================================
Function.Test_MenuTreeBuild {
    Body: {
        PrintMessage("\n=== TEST 9: Menu tree build (File menu) ===\n")

        ctx = AK_CreateContext()
        IfCondition EqualTo(ctx, 0) ThenBlock: {
            Test_Fail("AK_CreateContext failed")
            ReturnValue(0)
        }

        // Build root panel
        root = AK_CreateNode(ctx, AKTag.PANEL)
        AK_Set(ctx, root, AKF.LAYOUT_MODE, AKLayout.VBOX)
        AK_Set(ctx, root, AKF.GAP, 0)
        AK_Set(ctx, root, AKF.PAD_T, 4)
        AK_Set(ctx, root, AKF.PAD_R, 4)
        AK_Set(ctx, root, AKF.PAD_B, 4)
        AK_Set(ctx, root, AKF.PAD_L, 4)
        AK_SetRoot(ctx, root)

        // Add items (same as Menu_BuildFile)
        b1 = AK_CreateNode(ctx, AKTag.BUTTON)
        AK_Set(ctx, b1, AKF.WIDTH, 160)
        AK_Set(ctx, b1, AKF.HEIGHT, 26)
        AK_ExtraSet(ctx, b1, AKExtra.STR_PTR, "New Window")
        AK_ExtraSet(ctx, b1, AKExtra.STR_LEN, 10)
        AK_ExtraSet(ctx, b1, AKExtra.ACTION_PTR, "win.new")
        AK_ExtraSet(ctx, b1, AKExtra.ACTION_LEN, 7)
        AK_AddChild(ctx, root, b1)

        sep = AK_CreateNode(ctx, AKTag.SEPARATOR)
        AK_Set(ctx, sep, AKF.HEIGHT, 1)
        AK_Set(ctx, sep, AKF.WIDTH, 160)
        AK_AddChild(ctx, root, sep)

        b2 = AK_CreateNode(ctx, AKTag.BUTTON)
        AK_Set(ctx, b2, AKF.WIDTH, 160)
        AK_Set(ctx, b2, AKF.HEIGHT, 26)
        AK_ExtraSet(ctx, b2, AKExtra.STR_PTR, "Close")
        AK_ExtraSet(ctx, b2, AKExtra.STR_LEN, 5)
        AK_ExtraSet(ctx, b2, AKExtra.ACTION_PTR, "win.close")
        AK_ExtraSet(ctx, b2, AKExtra.ACTION_LEN, 9)
        AK_AddChild(ctx, root, b2)

        b3 = AK_CreateNode(ctx, AKTag.BUTTON)
        AK_Set(ctx, b3, AKF.WIDTH, 160)
        AK_Set(ctx, b3, AKF.HEIGHT, 26)
        AK_ExtraSet(ctx, b3, AKExtra.STR_PTR, "Quit")
        AK_ExtraSet(ctx, b3, AKExtra.STR_LEN, 4)
        AK_ExtraSet(ctx, b3, AKExtra.ACTION_PTR, "app.quit")
        AK_ExtraSet(ctx, b3, AKExtra.ACTION_LEN, 8)
        AK_AddChild(ctx, root, b3)

        tree_cnt = AK_GetTreeCount(ctx)
        PrintMessage("  Menu tree: ")
        PrintNumber(tree_cnt)
        PrintMessage(" nodes (expected 5)\n")

        // Walk sibling chain
        child = AK_Get(ctx, root, AKF.FIRST_CHILD)
        walk = 0
        guard = 0
        walk_ok = 1
        WhileLoop NotEqual(child, -1) {
            guard = Add(guard, 1)
            IfCondition GreaterThan(guard, 50) ThenBlock: {
                PrintMessage("  [ERR] INFINITE LOOP!\n")
                walk_ok = 0
                BreakLoop
            }

            tag = AK_Get(ctx, child, AKF.TAG)
            ns = AK_Get(ctx, child, AKF.NEXT_SIBLING)
            PrintMessage("    node ")
            PrintNumber(child)
            PrintMessage(": tag=")
            PrintNumber(tag)
            PrintMessage(" next=")
            PrintNumber(ns)
            PrintMessage("\n")

            IfCondition EqualTo(ns, child) ThenBlock: {
                PrintMessage("  [ERR] SELF-LOOP!\n")
                walk_ok = 0
                BreakLoop
            }

            walk = Add(walk, 1)
            child = ns
        }

        cc = AK_Get(ctx, root, AKF.CHILD_COUNT)
        PrintMessage("  Walked ")
        PrintNumber(walk)
        PrintMessage(" children, CHILD_COUNT=")
        PrintNumber(cc)
        PrintMessage("\n")

        AK_DestroyContext(ctx)

        IfCondition And(EqualTo(walk_ok, 1), EqualTo(walk, 4)) ThenBlock: {
            Test_Pass("Menu tree built and walked correctly")
        } ElseBlock: {
            Test_Fail("Menu tree walk failed")
        }
    }
}

// =========================================================================
// MAIN
// =========================================================================
SubRoutine.Main {
    Arena_Init()

    PrintMessage("============================================\n")
    PrintMessage("  File Dialog + Tree Traversal Test Suite\n")
    PrintMessage("============================================\n")

    conn = Test_Connect()
    IfCondition EqualTo(conn, 0) ThenBlock: {
        PrintMessage("\n[FATAL] Cannot proceed without database\n")
        HaltProgram
    }

    Test_FilesTable(conn)
    Test_RootListing(conn)
    Test_ChildListing(conn, 1)
    Test_StringConcat()
    Test_AKTreeBuild(conn)
    Test_RecursiveTraversal(conn)
    Test_DrawDirtyWalk(conn)
    Test_MenuTreeBuild()

    PG_Disconnect(conn)

    PrintMessage("\n============================================\n")
    PrintMessage("  RESULTS: ")
    PrintNumber(TestState.pass)
    PrintMessage(" passed, ")
    PrintNumber(TestState.fail)
    PrintMessage(" failed\n")
    PrintMessage("============================================\n")
}

RunTask(Main)
