// test_fillet_plex.ailang — Unit & regression test for Plex Fillet Graph & Classification.

LibraryImport.Arena
LibraryImport.Plex
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_Err
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Topo

SubRoutine.Main {
    Arena_Init()
    Plex.Init()

    PrintMessage("=== Plex Fillet Architecture Regression Tests ===\n\n")

    // TEST 1: Ring Alloc and Data Slot Mapping
    PrintMessage("TEST 1: Node allocation & slot layout\n")
    e1 = Plex.Alloc(1) // LINE
    e2 = Plex.Alloc(2) // CIRCLE
    e3 = Plex.Alloc(1) // LINE

    Plex.Set(e1, 0, 101) // Edge handle 101
    Plex.Set(e1, 1, 10)  // Face A
    Plex.Set(e1, 2, 20)  // Face B
    Plex.Set(e1, 3, 1)   // v0
    Plex.Set(e1, 4, 2)   // v1

    Plex.Set(e2, 0, 102)
    Plex.Set(e2, 1, 10)
    Plex.Set(e2, 2, 30)
    Plex.Set(e2, 3, 2)
    Plex.Set(e2, 4, 3)

    Plex.Set(e3, 0, 103)
    Plex.Set(e3, 1, 10)
    Plex.Set(e3, 2, 40)
    Plex.Set(e3, 3, 3)
    Plex.Set(e3, 4, 1)

    PrintMessage("  e1 edge_h=")
    PrintNumber(Plex.Get(e1, 0))
    PrintMessage(" type=")
    PrintNumber(Plex.Type(e1))
    PrintMessage("\n")
    PrintMessage("  e2 edge_h=")
    PrintNumber(Plex.Get(e2, 0))
    PrintMessage(" type=")
    PrintNumber(Plex.Type(e2))
    PrintMessage("\n")

    // TEST 2: Ring 0 (Chain Loop) Construction
    PrintMessage("\nTEST 2: Ring 0 (Coedge Loop) construction\n")
    Plex.RingSingleton(e1, 0)
    Plex.RingInsertAfter(e1, e2, 0)
    Plex.RingInsertAfter(e2, e3, 0)

    count_r0 = Plex.RingCount(e1, 0)
    PrintMessage("  Ring 0 count=")
    PrintNumber(count_r0)
    PrintMessage(" (expected 3)\n")

    Plex.DumpRing(e1, 0)

    // TEST 3: Ring 1 (Vertex Star) Construction
    PrintMessage("\nTEST 3: Ring 1 (Vertex Star) construction\n")
    Plex.RingSingleton(e1, 1)
    Plex.RingInsertAfter(e1, e2, 1)

    count_vstar = Plex.RingCount(e1, 1)
    PrintMessage("  e1 vertex star count=")
    PrintNumber(count_vstar)
    PrintMessage(" (expected 2 — shares v2 with e2)\n")

    // TEST 4: Classification Ring Queries
    PrintMessage("\nTEST 4: Classification ring queries\n")
    n_line = Plex.RingCountType(e1, 0, 1)
    n_circ = Plex.RingCountType(e1, 0, 2)
    all_line = Plex.RingAllSameType(e1, 0)

    PrintMessage("  LINE count=")
    PrintNumber(n_line)
    PrintMessage(" CIRCLE count=")
    PrintNumber(n_circ)
    PrintMessage(" All-LINE? ")
    PrintNumber(all_line)
    PrintMessage("\n")

    IfCondition EqualTo(n_line, 2) ThenBlock: {
        IfCondition EqualTo(n_circ, 1) ThenBlock: {
            IfCondition EqualTo(all_line, 0) ThenBlock: {
                PrintMessage("  PASS: Ring classification correctly identified mixed LINE-CIRCLE loop\n")
            }
        }
    }

    PrintMessage("\n=== All Plex Fillet Tests Complete ===\n")
    Exit(0)
}

RunTask(Main)
