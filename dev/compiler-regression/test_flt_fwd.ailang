// A one-use float temp is computed in the consumer's register. The multiply
// and the add stay separate roundings. A float used only by a compare is
// read from its register. Subtract keeps a temp off the right-hand side.

LibraryImport.Arena

FixedPool.FwdCheck {
    "fails": Initialize=0, CanChange=True
}

Function.Expect {
    Input: got: Integer
    Input: want: Integer
    Body: {
        IfCondition NotEqual(got, want) ThenBlock: {
            PrintMessage("FAIL got ")
            PrintNumber(got)
            PrintMessage(" want ")
            PrintNumber(want)
            PrintMessage("\n")
            FwdCheck.fails = Add(FwdCheck.fails, 1)
        }
    }
}

SubRoutine.Main {
    two = Float_FromInt(2)
    four = Float_FromInt(100)
    zr = Float_FromInt(1)
    zi = Float_FromInt(1)
    tr = Float_FromInt(1)
    ti = Float_FromInt(1)
    ci = Float_FromInt(1)
    cr = Float_FromInt(1)
    i = 0
    WhileLoop And(LessThan(i, 2), Float_Le(Float_Add(tr, ti), four)) {
        two_zr = Float_Mul(two, zr)
        zi_m = Float_Mul(two_zr, zi)
        zi = Float_Add(zi_m, ci)
        diff = Float_Sub(tr, ti)
        zr = Float_Add(diff, cr)
        tr = Float_Mul(zr, zr)
        ti = Float_Mul(zi, zi)
        i = Add(i, 1)
    }
    Expect(i, 2)
    Expect(Float_ToInt(zi), 7)
    Expect(Float_ToInt(zr), -7)
    Expect(Float_ToInt(tr), 49)
    Expect(Float_ToInt(ti), 49)
    mag = Float_Add(tr, ti)
    inside = Float_Le(mag, four)
    Expect(inside, 1)

    zr = Float_FromInt(3)
    tr = Float_FromInt(9)
    ti = Float_FromInt(4)
    cr = Float_FromInt(1)
    i = 0
    WhileLoop LessThan(i, 1) {
        diff = Float_Sub(tr, ti)
        saved = zr
        zr = Float_Add(diff, cr)
        i = Add(i, 1)
    }
    Expect(Float_ToInt(saved), 3)
    Expect(Float_ToInt(zr), 6)

    ten = Float_FromInt(8)
    tr = Float_FromInt(9)
    ti = Float_FromInt(4)
    i = 0
    WhileLoop LessThan(i, 1) {
        gap = Float_Sub(tr, ti)
        z = Float_Sub(ten, gap)
        i = Add(i, 1)
    }
    Expect(Float_ToInt(z), 3)

    s = Float_FromInt(10)
    two = Float_FromInt(2)
    i = 0
    WhileLoop LessThan(i, 1) {
        prod = Float_Mul(two, two)
        s = Float_Add(s, prod)
        i = Add(i, 1)
    }
    Expect(Float_ToInt(s), 14)

    a = Float_FromInt(20)
    b = Float_FromInt(4)
    c = Float_FromInt(2)
    i = 0
    WhileLoop LessThan(i, 1) {
        q = Float_Div(a, b)
        r = Float_Add(q, c)
        i = Add(i, 1)
    }
    Expect(Float_ToInt(r), 7)

    PrintMessage("fails ")
    PrintNumber(FwdCheck.fails)
    PrintMessage("\n")
    ProcessExit(FwdCheck.fails)
}

RunTask(Main)
