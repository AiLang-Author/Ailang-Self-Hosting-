// A nested Float_Add or Float_Sub of a Float_Mul fuses into the float home.
// A separate multiply plus add keeps both roundings. An FMA must not
// clobber a different live accumulator.

LibraryImport.Arena

FixedPool.FmaCheck {
    "fails": Initialize=0, CanChange=True
}

Function.Expect {
    Input: got: Integer
    Input: want: Integer
    Body: {
        IfCondition NotEqual(got, want) ThenBlock: {
            PrintMessage("FAIL got ")
            PrintNumber(got)
            PrintMessage(" want ")
            PrintNumber(want)
            PrintMessage("\n")
            FmaCheck.fails = Add(FmaCheck.fails, 1)
        }
    }
}

Function.NestAdd {
    Output: Integer
    Body: {
        tenth = Float_Div(Float_FromInt(1), Float_FromInt(10))
        neg_h = Float_Neg(Float_Div(Float_FromInt(1), Float_FromInt(100)))
        s = neg_h
        i = 0
        WhileLoop LessThan(i, 2) {
            s = Float_Add(s, Float_Mul(tenth, tenth))
            i = Add(i, 1)
        }
        ReturnValue(s)
    }
}

Function.SwapAdd {
    Output: Integer
    Body: {
        tenth = Float_Div(Float_FromInt(1), Float_FromInt(10))
        neg_h = Float_Neg(Float_Div(Float_FromInt(1), Float_FromInt(100)))
        s = neg_h
        i = 0
        WhileLoop LessThan(i, 2) {
            s = Float_Add(Float_Mul(tenth, tenth), s)
            i = Add(i, 1)
        }
        ReturnValue(s)
    }
}

Function.SplitAdd {
    Output: Integer
    Body: {
        tenth = Float_Div(Float_FromInt(1), Float_FromInt(10))
        neg_h = Float_Neg(Float_Div(Float_FromInt(1), Float_FromInt(100)))
        s = neg_h
        i = 0
        WhileLoop LessThan(i, 2) {
            prod = Float_Mul(tenth, tenth)
            s = Float_Add(s, prod)
            i = Add(i, 1)
        }
        ReturnValue(s)
    }
}

Function.SelfMul {
    Output: Integer
    Body: {
        tenth = Float_Div(Float_FromInt(1), Float_FromInt(10))
        h = tenth
        i = 0
        WhileLoop LessThan(i, 1) {
            h = Float_Add(h, Float_Mul(h, tenth))
            i = Add(i, 1)
        }
        ReturnValue(h)
    }
}

Function.NestSub {
    Output: Integer
    Body: {
        third = Float_Div(Float_FromInt(1), Float_FromInt(3))
        three = Float_FromInt(3)
        s = Float_FromInt(1)
        i = 0
        WhileLoop LessThan(i, 1) {
            s = Float_Sub(s, Float_Mul(third, three))
            i = Add(i, 1)
        }
        ReturnValue(s)
    }
}

Function.SplitSub {
    Output: Integer
    Body: {
        third = Float_Div(Float_FromInt(1), Float_FromInt(3))
        three = Float_FromInt(3)
        s = Float_FromInt(1)
        i = 0
        WhileLoop LessThan(i, 1) {
            prod = Float_Mul(third, three)
            s = Float_Sub(s, prod)
            i = Add(i, 1)
        }
        ReturnValue(s)
    }
}

Function.ExprSub {
    Output: Integer
    Body: {
        third = Float_Div(Float_FromInt(1), Float_FromInt(3))
        three = Float_FromInt(3)
        one = Float_FromInt(1)
        e = Float_Sub(Float_Mul(third, three), one)
        ReturnValue(e)
    }
}

Function.LiveAcc {
    Output: Integer
    Body: {
        tenth = Float_Div(Float_FromInt(1), Float_FromInt(10))
        neg_h = Float_Neg(Float_Div(Float_FromInt(1), Float_FromInt(100)))
        third = Float_Div(Float_FromInt(1), Float_FromInt(3))
        three = Float_FromInt(3)
        step = Float_FromInt(1)
        acc = Float_FromInt(10)
        s = Float_FromInt(1)
        i = 0
        WhileLoop LessThan(i, 1) {
            t = Float_Add(Float_Mul(tenth, tenth), neg_h)
            s = Float_Sub(s, Float_Mul(third, three))
            acc = Float_Add(acc, step)
            i = Add(i, 1)
        }
        Expect(t, 4337146585142882468)
        Expect(s, 4363988038922010624)
        ReturnValue(acc)
    }
}

SubRoutine.Main {
    Expect(NestAdd(), 4576918229304087676)
    Expect(SwapAdd(), 4576918229304087676)
    Expect(SplitAdd(), 4576918229304087677)
    Expect(SelfMul(), 4592590756007337001)
    Expect(NestSub(), 4363988038922010624)
    Expect(SplitSub(), 0)
    Expect(ExprSub(), -4859383997932765184)
    Expect(LiveAcc(), Float_FromInt(11))

    PrintMessage("fails ")
    PrintNumber(FmaCheck.fails)
    PrintMessage("\n")
    ProcessExit(FmaCheck.fails)
}

RunTask(Main)
