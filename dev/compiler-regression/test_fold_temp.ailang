// Single-use temps inside a loop are copied into their one read.
// The stepped form and the direct form must agree, including a write
// that lands between a temporary and a later read.

LibraryImport.Arena

FixedPool.FoldCheck {
    "fails": Initialize=0, CanChange=True
}

Function.Expect {
    Input: got: Integer
    Input: want: Integer
    Body: {
        IfCondition NotEqual(got, want) ThenBlock: {
            PrintMessage("FAIL got ")
            PrintNumber(got)
            PrintMessage(" want ")
            PrintNumber(want)
            PrintMessage("\n")
            FoldCheck.fails = Add(FoldCheck.fails, 1)
        }
    }
}

SubRoutine.Main {
    sum = 0
    i = 0
    WhileLoop LessThan(i, 5) {
        a = Add(i, 1)
        b = Multiply(a, 2)
        sum = Add(sum, b)
        i = Add(i, 1)
    }
    Expect(sum, 30)

    k = 0
    u = 0
    i = 0
    WhileLoop LessThan(k, 1) {
        i = 1
        t = Add(i, 1)
        i = Add(i, 10)
        u = Add(t, 1)
        k = Add(k, 1)
    }
    Expect(u, 3)
    Expect(i, 11)

    k = 0
    den_out = 0
    WhileLoop LessThan(k, 1) {
        i = 3
        j = 5
        ij = Add(i, j)
        ij1 = Add(ij, 1)
        tri = Divide(Multiply(ij, ij1), 2)
        ip1 = Add(i, 1)
        den = Add(tri, ip1)
        den_out = den
        k = Add(k, 1)
    }
    Expect(den_out, 40)

    k = 0
    q_out = 0
    WhileLoop LessThan(k, 1) {
        n = Negate(5)
        q = Divide(n, 4)
        q_out = q
        k = Add(k, 1)
    }
    Expect(q_out, Negate(1))
    Expect(q_out, Divide(Negate(5), 4))

    k = 0
    bits = 0
    direct = Float_Div(Float_FromInt(1), Float_FromInt(2))
    WhileLoop LessThan(k, 1) {
        den_i = 2
        den = Float_FromInt(den_i)
        one = Float_FromInt(1)
        qf = Float_Div(one, den)
        bits = qf
        k = Add(k, 1)
    }
    Expect(bits, direct)

    PrintMessage("fails ")
    PrintNumber(FoldCheck.fails)
    PrintMessage("\n")
    ProcessExit(FoldCheck.fails)
}

RunTask(Main)
