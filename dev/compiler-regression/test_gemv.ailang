// test_gemv.ailang — GPU Matrix-Vector Multiply (GEMV) stress test
// Build: ./ailang.x dev/compiler-regression/test_gemv.ailang -o test_gemv.x
// Run:   sudo ./test_gemv.x   (needs GPU access, radeon must be unbound)
//
// Kernel: y[i] = sum_j( A[i,j] * x[j] )  for i=0..511, j=0..63
//
// Parameters:
//   M = 512 rows (output elements, one thread per row)
//   K = 64  columns (inner dimension, fully unrolled)
//   8 workgroups x 64 threads = 512 total threads
//   32,768 FMA ops, 65,536 memory loads
//
// Test data: A[i][j] = 1.0f, x[j] = 1.0f
// Expected:  y[i] = 64.0f for all i

LibraryImport.Arena
LibraryImport.Drivers.AMDGPU.AMDGPUFamily
LibraryImport.Drivers.AMDGPU.AMDGPUDiscover
LibraryImport.Drivers.AMDGPU.AMDGPUBAR
LibraryImport.Drivers.AMDGPU.AMDGPUPM4
LibraryImport.Drivers.AMDGPU.GCNEnc
LibraryImport.Accel.ComputeIR
LibraryImport.Accel.ComputeIR_GCN
LibraryImport.Accel.HAL
LibraryImport.Accel.AccelGCN

SubRoutine.Main {
    PrintMessage("=== GEMV Stress Test (512x64, float32) ===\n\n")

    // IEEE 754 constants
    float_1_0 = 1065353216     // 0x3F800000 = 1.0f
    float_64_0 = 1115684864   // 0x42800000 = 64.0f

    // Dimensions
    M = 512
    K = 64
    num_groups = 8
    group_sz = 64

    // Buffer sizes (bytes)
    A_elems = Multiply(M, K)          // 32768
    A_bytes = Multiply(A_elems, 4)    // 131072
    x_bytes = Multiply(K, 4)          // 256
    y_bytes = Multiply(M, 4)          // 2048

    // Data area offsets
    A_off = 0
    x_off = A_bytes                   // 131072
    y_off = Add(x_off, x_bytes)       // 131328

    // --- Step 1: Initialize AccelGCN ---
    PrintMessage("--- Step 1: AccelGCN Init ---\n")
    rc = AccelGCN_Init()
    PrintMessage("AccelGCN_Init: ")
    PrintNumber(rc)
    PrintMessage("\n\n")
    IfCondition LessThan(rc, 0) ThenBlock: {
        PrintMessage("FATAL: AccelGCN init failed, aborting\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }

    // --- Step 2: Build CIR kernel ---
    PrintMessage("--- Step 2: Build CIR Kernel (GEMV) ---\n")
    rc = CIR_Begin()

    rc = CIR_SetGroupSize(group_sz, 1, 1)
    rc = CIR_SetGrid(num_groups, 1, 1)

    // Bind buffers:
    //   Slot 0 = A (read):  32768 elements * 4 bytes at data offset 0
    //   Slot 1 = x (read):  64 elements * 4 bytes at data offset 131072
    //   Slot 2 = y (write): 512 elements * 4 bytes at data offset 131328
    rc = CIR_BindBuffer(0, A_off, A_bytes, 4, 1)
    rc = CIR_BindBuffer(1, x_off, x_bytes, 4, 1)
    rc = CIR_BindBuffer(2, y_off, y_bytes, 4, 2)

    // Allocate virtual registers
    v_gid   = CIR_AllocVReg()    // global thread ID (0..511)
    v_k     = CIR_AllocVReg()    // constant K=64
    v_row   = CIR_AllocVReg()    // row_base = gid * K
    v_acc   = CIR_AllocVReg()    // float accumulator
    v_j     = CIR_AllocVReg()    // column index j
    v_a_idx = CIR_AllocVReg()    // A element index = row_base + j
    v_a     = CIR_AllocVReg()    // loaded A[i][j]
    v_x     = CIR_AllocVReg()    // loaded x[j]

    // --- Emit kernel IR ---
    // Setup: compute row base
    rc = CIR_Op_GlobalIdX(v_gid)
    rc = CIR_Op_LoadConst(v_k, K)
    rc = CIR_Op_MulLoU32(v_row, v_gid, v_k)
    rc = CIR_Op_LoadConst(v_acc, 0)          // 0x00000000 = 0.0f

    // Unrolled inner loop: j = 0..63
    // Each iteration: load A[i][j], load x[j], acc += A*x via FMA
    j = 0
    WhileLoop LessThan(j, 64) {
        rc = CIR_Op_LoadConst(v_j, j)
        rc = CIR_Op_AddU32(v_a_idx, v_row, v_j)
        rc = CIR_Op_LoadBuf(v_a, 0, v_a_idx)
        rc = CIR_Op_WaitCnt(0, 0, 0)
        rc = CIR_Op_LoadBuf(v_x, 1, v_j)
        rc = CIR_Op_WaitCnt(0, 0, 0)
        rc = CIR_Op_FmaF32(v_acc, v_a, v_x, v_acc)
        j = Add(j, 1)
    }

    // Store result and terminate
    rc = CIR_Op_StoreBuf(v_acc, 2, v_gid)
    rc = CIR_Op_WaitCnt(0, 0, 0)
    rc = CIR_Op_EndPgm()

    n_insns = CIR_End()
    PrintMessage("CIR instructions: ")
    PrintNumber(n_insns)
    PrintMessage("\n")

    // --- Step 3: Lower to GCN ---
    PrintMessage("--- Step 3: Lower to GCN ---\n")
    mc_bytes = CIR_Lower_GCN()
    PrintMessage("Machine code: ")
    PrintNumber(mc_bytes)
    PrintMessage(" bytes\n\n")

    // --- Step 4: Write test data to VRAM ---
    PrintMessage("--- Step 4: Write test data ---\n")

    // Fill matrix A with 1.0f (32768 elements)
    host_A = Allocate(A_bytes)
    i = 0
    WhileLoop LessThan(i, A_elems) {
        off = Multiply(i, 4)
        SetByte(host_A, off, BitwiseAnd(float_1_0, 255))
        SetByte(host_A, Add(off, 1), BitwiseAnd(RightShift(float_1_0, 8), 255))
        SetByte(host_A, Add(off, 2), BitwiseAnd(RightShift(float_1_0, 16), 255))
        SetByte(host_A, Add(off, 3), BitwiseAnd(RightShift(float_1_0, 24), 255))
        i = Add(i, 1)
    }
    discard = AccelGCN_VramWrite(A_off, host_A, A_bytes)
    PrintMessage("Wrote matrix A: ")
    PrintNumber(A_elems)
    PrintMessage(" floats (")
    PrintNumber(A_bytes)
    PrintMessage(" bytes) all 1.0f\n")

    // Fill vector x with 1.0f (64 elements)
    host_x = Allocate(x_bytes)
    i = 0
    WhileLoop LessThan(i, K) {
        off = Multiply(i, 4)
        SetByte(host_x, off, BitwiseAnd(float_1_0, 255))
        SetByte(host_x, Add(off, 1), BitwiseAnd(RightShift(float_1_0, 8), 255))
        SetByte(host_x, Add(off, 2), BitwiseAnd(RightShift(float_1_0, 16), 255))
        SetByte(host_x, Add(off, 3), BitwiseAnd(RightShift(float_1_0, 24), 255))
        i = Add(i, 1)
    }
    discard = AccelGCN_VramWrite(x_off, host_x, x_bytes)
    PrintMessage("Wrote vector x: ")
    PrintNumber(K)
    PrintMessage(" floats all 1.0f\n")

    // Zero output y
    host_y = Allocate(y_bytes)
    MemorySet(host_y, 0, y_bytes)
    discard = AccelGCN_VramWrite(y_off, host_y, y_bytes)
    PrintMessage("Zeroed output y: ")
    PrintNumber(M)
    PrintMessage(" floats\n\n")

    // --- Step 5: Dispatch ---
    PrintMessage("--- Step 5: Dispatch ---\n")
    rc = AccelGCN_Dispatch()
    PrintMessage("AccelGCN_Dispatch: ")
    PrintNumber(rc)
    PrintMessage("\n\n")

    // --- Step 6: Read back and verify ---
    PrintMessage("--- Step 6: Read back + verify ---\n")
    discard = AccelGCN_VramRead(y_off, host_y, y_bytes)

    errors = 0
    i = 0
    WhileLoop LessThan(i, M) {
        off = Multiply(i, 4)
        b0 = GetByte(host_y, off)
        b1 = GetByte(host_y, Add(off, 1))
        b2 = GetByte(host_y, Add(off, 2))
        b3 = GetByte(host_y, Add(off, 3))
        got = BitwiseOr(b0, BitwiseOr(LeftShift(b1, 8), BitwiseOr(LeftShift(b2, 16), LeftShift(b3, 24))))

        // Print first 8 and last 4 for spot-check
        IfCondition LessThan(i, 8) ThenBlock: {
            PrintMessage("  y[")
            PrintNumber(i)
            PrintMessage("] = 0x")
            PrintHex(got)
            PrintMessage(" (expect 0x")
            PrintHex(float_64_0)
            PrintMessage(")")
            IfCondition EqualTo(got, float_64_0) ThenBlock: {
                PrintMessage(" OK")
            }
            IfCondition NotEqual(got, float_64_0) ThenBlock: {
                PrintMessage(" FAIL")
            }
            PrintMessage("\n")
        }
        IfCondition GreaterThan(i, 507) ThenBlock: {
            PrintMessage("  y[")
            PrintNumber(i)
            PrintMessage("] = 0x")
            PrintHex(got)
            PrintMessage(" (expect 0x")
            PrintHex(float_64_0)
            PrintMessage(")")
            IfCondition EqualTo(got, float_64_0) ThenBlock: {
                PrintMessage(" OK")
            }
            IfCondition NotEqual(got, float_64_0) ThenBlock: {
                PrintMessage(" FAIL")
            }
            PrintMessage("\n")
        }

        IfCondition NotEqual(got, float_64_0) ThenBlock: {
            errors = Add(errors, 1)
        }
        i = Add(i, 1)
    }

    PrintMessage("\nResults: ")
    PrintNumber(Subtract(M, errors))
    PrintMessage("/")
    PrintNumber(M)
    PrintMessage(" correct, ")
    PrintNumber(errors)
    PrintMessage(" errors\n")
    PrintMessage("FMAs executed: ")
    PrintNumber(Multiply(M, K))
    PrintMessage("  Memory loads: ")
    PrintNumber(Multiply(Multiply(M, K), 2))
    PrintMessage("\n")

    IfCondition EqualTo(errors, 0) ThenBlock: {
        PrintMessage("\n*** ALL PASS ***\n")
    }
    IfCondition GreaterThan(errors, 0) ThenBlock: {
        PrintMessage("\n*** FAILURES DETECTED ***\n")
    }

    // --- Cleanup ---
    PrintMessage("\n--- Cleanup ---\n")
    Deallocate(host_A, A_bytes)
    Deallocate(host_x, x_bytes)
    Deallocate(host_y, y_bytes)
    discard = AccelGCN_Shutdown()

    PrintMessage("\n=== GEMV Test Complete ===\n")
    SystemCall(60, 0, 0, 0, 0, 0)
}

RunTask(Main)
