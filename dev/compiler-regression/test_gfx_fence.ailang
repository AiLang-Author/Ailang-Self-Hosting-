// test_gfx_fence.ailang — GFX ring EVENT_WRITE_EOP fence loop test
// Tests whether the 36-dispatch wall is specific to compute or affects
// the GFX event engine too.  Uses ring 0 (GFX) with only NOP + EOP fence
// packets — no shaders, no dispatch, no compute pipeline.
// Build: ./ailang.x dev/compiler-regression/test_gfx_fence.ailang -o test_gfx_fence.x
// Run:   sudo ./test_gfx_fence.x 2>&1 | tee gfx_fence_log.txt

LibraryImport.Arena
LibraryImport.Drivers.AMDGPU.AMDGPUFamily
LibraryImport.Drivers.AMDGPU.AMDGPUDiscover
LibraryImport.Drivers.AMDGPU.AMDGPUBAR
LibraryImport.Drivers.AMDGPU.AMDGPUPM4
LibraryImport.Drivers.AMDGPU.GCNEnc
LibraryImport.Accel.ComputeIR
LibraryImport.Accel.ComputeIR_GCN
LibraryImport.Accel.HAL
LibraryImport.Accel.AccelGCN

SubRoutine.Main {
    PrintMessage("=== GFX Ring Fence Loop Test (HD 7770) ===\n")
    PrintMessage("Ring 0 (GFX), 100 iterations, NOP + EVENT_WRITE_EOP only\n")
    PrintMessage("No compute dispatch — pure event engine test\n\n")

    max_iters = 100
    ring = 0     // GFX ring

    // --- Init GPU using AccelGCN (sets up ring 0 + ring 1 + firmware) ---
    rc = AccelGCN_Init()
    IfCondition LessThan(rc, 0) ThenBlock: {
        PrintMessage("FATAL: init failed rc=")
        PrintNumber(rc)
        PrintMessage("\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }
    PrintMessage("Init OK\n\n")

    gpu = AccelGCNCfg.gpu_idx

    // Get ring 0 state for fence tracking
    ring_ptr = PM4_GetRing(ring)
    fence_off = Dereference(Add(ring_ptr, RingField.FENCE_WB_OFF))

    PrintMessage("Ring 0 fence VRAM offset: 0x")
    PrintHex(fence_off)
    PrintMessage("\n\n")

    total_pass = 0
    total_fail = 0

    iter = 0
    WhileLoop LessThan(iter, max_iters) {
        // Get current fence value and compute next
        ring_ptr = PM4_GetRing(ring)
        fence_val = Add(Dereference(Add(ring_ptr, RingField.FENCE_VAL)), 1)
        StoreValue(Add(ring_ptr, RingField.FENCE_VAL), fence_val)
        fence_off = Dereference(Add(ring_ptr, RingField.FENCE_WB_OFF))

        // Emit a NOP to give the ring something to chew on
        PM4_EmitNOP(ring, 4)

        // Emit SURFACE_SYNC (light — just I$/K$ invalidate, no TC flush)
        // coher_cntl = SH_ICACHE_ACTION_ENA + SH_KCACHE_ACTION_ENA = 0x28000000
        PM4_EmitSurfaceSync(ring, 671088640, 4294967295, 0, 10)

        // Emit EVENT_WRITE_EOP — fence write + L2 flush
        fence_gpu = PM4_VramToGPU(fence_off)
        fence_addr_lo = BitwiseAnd(fence_gpu, 4294967295)
        fence_addr_hi = Divide(fence_gpu, 4294967296)
        PM4_EmitEventWriteEOP(ring, fence_addr_lo, fence_addr_hi, fence_val)

        // Commit — bump WPTR
        PM4_Commit(ring)

        // Wait for fence
        rc = PM4_WaitFenceVRAM(ring, fence_val)

        // Drain IH ring
        PM4_DrainIH(gpu)

        // Report
        PrintMessage("iter ")
        PrintNumber(iter)
        PrintMessage(": fence_val=")
        PrintNumber(fence_val)

        IfCondition EqualTo(rc, 1) ThenBlock: {
            PrintMessage(" PASS\n")
            total_pass = Add(total_pass, 1)
        }
        IfCondition EqualTo(rc, 0) ThenBlock: {
            PrintMessage(" FAIL (fence timeout)\n")
            PrintMessage("  GRBM_STATUS=0x")
            PrintHex(GPU_Rd32(gpu, SIReg.GRBM_STATUS))
            PrintMessage(" SRBM_STATUS=0x")
            PrintHex(GPU_Rd32(gpu, SIReg.SRBM_STATUS))
            PrintMessage("\n  CP_STALL1=0x")
            PrintHex(GPU_Rd32(gpu, SIReg.CP_STALLED_STAT1))
            PrintMessage(" STALL2=0x")
            PrintHex(GPU_Rd32(gpu, SIReg.CP_STALLED_STAT2))
            PrintMessage(" STALL3=0x")
            PrintHex(GPU_Rd32(gpu, SIReg.CP_STALLED_STAT3))
            PrintMessage("\n  RPTR(mmio)=")
            PrintNumber(PM4_ReadRPTR_MMIO(ring))
            PrintMessage(" WPTR=")
            PrintNumber(Dereference(Add(PM4_GetRing(ring), RingField.WPTR)))
            PrintMessage("\n")
            total_fail = Add(total_fail, 1)
        }

        iter = Add(iter, 1)
    }

    PrintMessage("\n=== Summary ===\n")
    PrintMessage("Iterations: ")
    PrintNumber(max_iters)
    PrintMessage("  PASS: ")
    PrintNumber(total_pass)
    PrintMessage("  FAIL: ")
    PrintNumber(total_fail)
    PrintMessage("\n")

    IfCondition EqualTo(total_fail, 0) ThenBlock: { PrintMessage("*** ALL PASS ***\n") }
    IfCondition GreaterThan(total_fail, 0) ThenBlock: { PrintMessage("*** FAILURES DETECTED ***\n") }

    discard = AccelGCN_Shutdown()
    PrintMessage("=== Done ===\n")
    SystemCall(60, 0, 0, 0, 0, 0)
}

RunTask(Main)
