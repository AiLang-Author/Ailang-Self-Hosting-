// test_gpu_atombios.ailang — test AtomBIOS ROM parsing
// Build: ./ailang.x dev/compiler-regression/test_gpu_atombios.ailang test_gpu_atombios.x
// Run:   sg video -c "./test_gpu_atombios.x"

LibraryImport.Arena
LibraryImport.Drivers.AMDGPU.AMDGPUFamily
LibraryImport.Drivers.AMDGPU.AMDGPUDiscover
LibraryImport.Drivers.AMDGPU.AMDGPUBAR
LibraryImport.Drivers.AMDGPU.AMDGPUAtomBIOS

SubRoutine.Main {
    PrintMessage("=== AMD GPU AtomBIOS Test ===\n\n")

    count = GPU_Discover()

    IfCondition EqualTo(count, 0) ThenBlock: {
        PrintMessage("No AMD GPUs found.\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }

    GPU_PrintAll()
    PrintMessage("\n")

    // Load and parse AtomBIOS for GPU 0
    PrintMessage("--- Loading VBIOS ROM ---\n")
    rom = AtomBIOS_LoadROM(0)
    IfCondition EqualTo(rom, 0) ThenBlock: {
        PrintMessage("Failed to load VBIOS ROM!\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }

    PrintMessage("--- Parsing AtomBIOS ---\n")
    rc = AtomBIOS_Parse(0)
    IfCondition EqualTo(rc, 0) ThenBlock: {
        PrintMessage("Failed to parse AtomBIOS!\n")
        AtomBIOS_FreeROM(0)
        SystemCall(60, 1, 0, 0, 0, 0)
    }

    PrintMessage("\n")
    AtomBIOS_PrintInfo(0)

    // Test individual field access
    PrintMessage("\n--- Field Access ---\n")

    ref_clk = AtomBIOS_GetField(0, AtomField.CORE_REF_CLK)
    PrintMessage("Reference Clock: ")
    PrintNumber(ref_clk)
    PrintMessage(" kHz\n")

    def_eng = AtomBIOS_GetField(0, AtomField.DEF_ENGINE_CLK)
    PrintMessage("Default Engine:  ")
    PrintNumber(def_eng)
    PrintMessage(" kHz\n")

    vddc = AtomBIOS_GetField(0, AtomField.BOOT_VDDC)
    PrintMessage("Boot VDDC:       ")
    PrintNumber(vddc)
    PrintMessage(" mV\n")

    // Cleanup
    PrintMessage("\n--- Cleanup ---\n")
    AtomBIOS_FreeROM(0)
    PrintMessage("ROM freed.\n")

    PrintMessage("\n=== Test Complete ===\n")
    SystemCall(60, 0, 0, 0, 0, 0)
}

RunTask(Main)
