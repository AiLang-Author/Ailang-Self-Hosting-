// test_gpu_bar.ailang — test MMIO BAR mapping and register reads
// Build: ./ailang.x dev/compiler-regression/test_gpu_bar.ailang test_gpu_bar.x
// Run:   sg video -c "./test_gpu_bar.x"

LibraryImport.Arena
LibraryImport.Drivers.AMDGPU.AMDGPUFamily
LibraryImport.Drivers.AMDGPU.AMDGPUDiscover
LibraryImport.Drivers.AMDGPU.AMDGPUBAR

SubRoutine.Main {
    PrintMessage("=== AMD GPU BAR Test ===\n\n")

    count = GPU_Discover()

    IfCondition EqualTo(count, 0) ThenBlock: {
        PrintMessage("No AMD GPUs found.\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }

    GPU_PrintAll()
    PrintMessage("\n")

    // Map MMIO for GPU 0
    PrintMessage("--- Mapping MMIO BAR2 ---\n")
    rc = GPU_BAR_MapMMIO(0)
    IfCondition EqualTo(rc, 0) ThenBlock: {
        PrintMessage("MMIO map failed!\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }

    // Read some known SI registers
    PrintMessage("\n--- Register Reads ---\n")

    // GB_ADDR_CONFIG (0x98F8) — memory/pipe config
    val = GPU_Rd32(0, 39160)   // 0x98F8
    PrintMessage("GB_ADDR_CONFIG (0x98F8):  ")
    PrintNumber(val)
    PrintMessage("\n")

    // GRBM_STATUS (0x8010) — GPU idle/busy
    val = GPU_Rd32(0, 32784)   // 0x8010
    PrintMessage("GRBM_STATUS (0x8010):     ")
    PrintNumber(val)
    PrintMessage("\n")

    // GC_SHADER_ARRAY_CONFIG (0x89BC) — CU active mask
    val = GPU_Rd32(0, 35260)   // 0x89BC
    PrintMessage("GC_SHADER_ARRAY (0x89BC): ")
    PrintNumber(val)
    PrintMessage("\n")

    // SCRATCH_REG0 (0x8500) — fence counter
    val = GPU_Rd32(0, 34048)   // 0x8500
    PrintMessage("SCRATCH_REG0 (0x8500):    ")
    PrintNumber(val)
    PrintMessage("\n")

    // SCRATCH_REG3 (0x850C) — should be 0xDEADBEEF if unused
    val = GPU_Rd32(0, 34060)   // 0x850C
    PrintMessage("SCRATCH_REG3 (0x850C):    ")
    PrintNumber(val)
    PrintMessage("\n")

    // RLC_CNTL (0xC300) — run list controller
    val = GPU_Rd32(0, 49920)   // 0xC300
    PrintMessage("RLC_CNTL (0xC300):        ")
    PrintNumber(val)
    PrintMessage("\n")

    // CP ring 0 RPTR/WPTR
    val = GPU_Rd32(0, 34560)   // 0x8700 — CP_RB0_RPTR
    PrintMessage("CP_RB0_RPTR (0x8700):     ")
    PrintNumber(val)
    PrintMessage("\n")
    val = GPU_Rd32(0, 34564)   // 0x8704 — CP_RB0_WPTR
    PrintMessage("CP_RB0_WPTR (0x8704):     ")
    PrintNumber(val)
    PrintMessage("\n")

    // Unmap
    PrintMessage("\n--- Cleanup ---\n")
    GPU_BAR_Unmap(0)
    PrintMessage("BARs unmapped.\n")

    PrintMessage("\n=== Test Complete ===\n")
    SystemCall(60, 0, 0, 0, 0, 0)
}

RunTask(Main)
