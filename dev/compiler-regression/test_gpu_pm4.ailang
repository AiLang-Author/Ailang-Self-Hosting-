// test_gpu_pm4.ailang — test PM4 ring buffer setup and status readout
// Build: ./ailang.x dev/compiler-regression/test_gpu_pm4.ailang test_gpu_pm4.x
// Run:   sg video -c "./test_gpu_pm4.x"
//
// NOTE: This test reads register state and sets up the ring buffer data
// structures. It does NOT unbind the radeon driver or reprogram CP registers
// while the kernel driver is active — that would crash the system.
// It exercises:
//   1. Ring state allocation and initialization
//   2. VRAM zeroing and ring memory layout
//   3. MMIO register readback (GRBM_STATUS, CP_RB0_RPTR, etc.)
//   4. Packet building (to pkt_buf, not submitted)
//   5. Status printing

LibraryImport.Arena
LibraryImport.Drivers.AMDGPU.AMDGPUFamily
LibraryImport.Drivers.AMDGPU.AMDGPUDiscover
LibraryImport.Drivers.AMDGPU.AMDGPUBAR
LibraryImport.Drivers.AMDGPU.AMDGPUPM4

SubRoutine.Main {
    PrintMessage("=== AMD GPU PM4 Ring Buffer Test ===\n\n")

    // --- Discover GPUs ---
    count = GPU_Discover()
    IfCondition EqualTo(count, 0) ThenBlock: {
        PrintMessage("No AMD GPUs found.\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }
    GPU_PrintAll()
    PrintMessage("\n")

    // --- Map BARs ---
    PrintMessage("--- Mapping BARs ---\n")
    rc = GPU_BAR_MapMMIO(0)
    PrintMessage("MMIO map: ")
    PrintNumber(rc)
    PrintMessage("\n")

    rc = GPU_BAR_MapVRAM(0)
    PrintMessage("VRAM map: ")
    PrintNumber(rc)
    PrintMessage("\n\n")

    // --- Read some key registers (safe, read-only) ---
    PrintMessage("--- Register Readback (read-only) ---\n")

    grbm = GPU_Rd32(0, SIReg.GRBM_STATUS)
    PrintMessage("GRBM_STATUS:     ")
    PrintHex(grbm)
    PrintMessage("\n")

    me_cntl = GPU_Rd32(0, SIReg.CP_ME_CNTL)
    PrintMessage("CP_ME_CNTL:      ")
    PrintHex(me_cntl)
    PrintMessage("\n")

    rb0_cntl = GPU_Rd32(0, SIReg.CP_RB0_CNTL)
    PrintMessage("CP_RB0_CNTL:     ")
    PrintHex(rb0_cntl)
    PrintMessage("\n")

    rb0_base = GPU_Rd32(0, SIReg.CP_RB0_BASE)
    PrintMessage("CP_RB0_BASE:     ")
    PrintHex(rb0_base)
    PrintMessage("\n")

    rb0_rptr = GPU_Rd32(0, SIReg.CP_RB0_RPTR)
    PrintMessage("CP_RB0_RPTR:     ")
    PrintHex(rb0_rptr)
    PrintMessage("\n")

    rb0_wptr = GPU_Rd32(0, SIReg.CP_RB0_WPTR)
    PrintMessage("CP_RB0_WPTR:     ")
    PrintHex(rb0_wptr)
    PrintMessage("\n")

    scratch0 = GPU_Rd32(0, SIReg.SCRATCH_REG0)
    PrintMessage("SCRATCH_REG0:    ")
    PrintHex(scratch0)
    PrintMessage("\n")

    scratch1 = GPU_Rd32(0, SIReg.SCRATCH_REG1)
    PrintMessage("SCRATCH_REG1:    ")
    PrintHex(scratch1)
    PrintMessage("\n\n")

    // --- Decode GRBM_STATUS ---
    PrintMessage("--- GRBM_STATUS Decode ---\n")
    // bit 17: GUI_ACTIVE
    gui_active = BitwiseAnd(Divide(grbm, 131072), 1)
    PrintMessage("  GUI_ACTIVE:    ")
    PrintNumber(gui_active)
    PrintMessage("\n")

    // bit 29: CP_BUSY
    cp_busy = BitwiseAnd(Divide(grbm, 536870912), 1)
    PrintMessage("  CP_BUSY:       ")
    PrintNumber(cp_busy)
    PrintMessage("\n")

    // bit 30: CP_COHERENCY_BUSY
    cp_coh = BitwiseAnd(Divide(grbm, 1073741824), 1)
    PrintMessage("  CP_COH_BUSY:   ")
    PrintNumber(cp_coh)
    PrintMessage("\n\n")

    // --- Decode CP_RB0_CNTL ---
    PrintMessage("--- CP_RB0_CNTL Decode ---\n")
    // bits [5:0]: RB_BUFSZ (log2 of ring size in DWORDs)
    bufsz = BitwiseAnd(rb0_cntl, 63)
    PrintMessage("  RB_BUFSZ:      ")
    PrintNumber(bufsz)
    PrintMessage(" (log2 DWORDs)\n")

    // bits [13:8]: RB_BLKSZ
    blksz = BitwiseAnd(Divide(rb0_cntl, 256), 63)
    PrintMessage("  RB_BLKSZ:      ")
    PrintNumber(blksz)
    PrintMessage("\n\n")

    // --- Test PM4 state initialization ---
    PrintMessage("--- PM4 State Init ---\n")
    PM4_Init()
    PrintMessage("PM4 state initialized\n\n")

    // --- Test ring allocation (data structures only, NO HW programming) ---
    // We allocate the ring at VRAM offset 0x100000 (1MB in) to avoid
    // conflicts with the radeon driver's framebuffer at the start of VRAM.
    PrintMessage("--- Ring Data Structure Setup ---\n")
    PrintMessage("(Data structures only — NOT programming CP registers)\n")
    PrintMessage("(Radeon driver is still active)\n\n")

    ring = PM4_GetRing(0)
    StoreValue(Add(ring, RingField.GPU_INDEX), 0)
    StoreValue(Add(ring, RingField.RING_ID), 0)
    StoreValue(Add(ring, RingField.VRAM_BASE), 1048576)  // 0x100000
    StoreValue(Add(ring, RingField.RING_SIZE), RingConf.RING_SIZE_DWORDS)
    StoreValue(Add(ring, RingField.WPTR), 0)
    StoreValue(Add(ring, RingField.RPTR_WB_ADDR), Add(1048576, RingConf.RPTR_WB_OFFSET))
    StoreValue(Add(ring, RingField.FENCE_VAL), 0)
    StoreValue(Add(ring, RingField.FENCE_WB_OFF), Add(1048576, Add(RingConf.RPTR_WB_OFFSET, 8)))
    StoreValue(Add(ring, RingField.HALTED), 0)
    StoreValue(Add(ring, RingField.INITIALIZED), 1)

    pkt_buf = Allocate(1024)
    MemorySet(pkt_buf, 0, 1024)
    StoreValue(Add(ring, RingField.PKT_BUF), pkt_buf)
    StoreValue(Add(ring, RingField.PKT_POS), 0)

    PrintMessage("Ring 0 data structures ready\n\n")

    // --- Test packet header building ---
    PrintMessage("--- PM4 Packet Header Test ---\n")

    // NOP header: type3, op=0x10, count=1
    nop_hdr = PM4_BuildHeader(PM4.OP_NOP, 1, 0)
    PrintMessage("NOP header:          ")
    PrintHex(nop_hdr)
    PrintMessage("\n")

    // SET_SH_REG header: type3, op=0x76, count=2, compute
    sh_hdr = PM4_BuildHeader(PM4.OP_SET_SH_REG, 2, PM4.SHADER_TYPE_COMPUTE)
    PrintMessage("SET_SH_REG header:   ")
    PrintHex(sh_hdr)
    PrintMessage("\n")

    // DISPATCH_DIRECT header: type3, op=0x15, count=4, compute
    disp_hdr = PM4_BuildHeader(PM4.OP_DISPATCH_DIRECT, 4, PM4.SHADER_TYPE_COMPUTE)
    PrintMessage("DISPATCH_DIRECT hdr: ")
    PrintHex(disp_hdr)
    PrintMessage("\n")

    // EVENT_WRITE_EOP header: type3, op=0x47, count=5, compute
    eop_hdr = PM4_BuildHeader(PM4.OP_EVENT_WRITE_EOP, 5, PM4.SHADER_TYPE_COMPUTE)
    PrintMessage("EVENT_WRITE_EOP hdr: ")
    PrintHex(eop_hdr)
    PrintMessage("\n\n")

    // --- Verify expected values ---
    PrintMessage("--- Verify Packet Headers ---\n")
    // NOP: 0xC0001000 = (3<<30) | (0<<16) | (0x10<<8) = 0xC0000000 | 0x1000
    PrintMessage("NOP expected:        0xC0001000\n")

    // SET_SH_REG: 0xC0017602 = (3<<30) | (1<<16) | (0x76<<8) | 2
    PrintMessage("SET_SH_REG expected: 0xC0017602\n")

    // DISPATCH_DIRECT: 0xC0031502 = (3<<30) | (3<<16) | (0x15<<8) | 2
    PrintMessage("DISPATCH expected:   0xC0031502\n")

    // EVENT_WRITE_EOP: 0xC0044702 = (3<<30) | (4<<16) | (0x47<<8) | 2
    PrintMessage("EOP expected:        0xC0044702\n\n")

    // --- Read VRAM at ring location (show what radeon has there) ---
    PrintMessage("--- VRAM Read at ring offset (peek) ---\n")
    i = 0
    WhileLoop LessThan(i, 8) {
        off = Add(1048576, Multiply(i, 4))
        val = GPU_VramRd32(0, off)
        PrintMessage("  VRAM[0x100000+")
        PrintHex(Multiply(i, 4))
        PrintMessage("]: ")
        PrintHex(val)
        PrintMessage("\n")
        i = Add(i, 1)
    }
    PrintMessage("\n")

    // --- Print ring status ---
    PrintMessage("--- Ring Status ---\n")
    PM4_PrintStatus(0)

    // --- Cleanup ---
    PrintMessage("\n--- Cleanup ---\n")
    Deallocate(pkt_buf, 1024)
    GPU_BAR_Unmap(0)
    PrintMessage("Done.\n\n")

    PrintMessage("=== PM4 Test Complete ===\n")
    PrintMessage("(To test actual command submission, unbind radeon first)\n")
    SystemCall(60, 0, 0, 0, 0, 0)
}

RunTask(Main)
