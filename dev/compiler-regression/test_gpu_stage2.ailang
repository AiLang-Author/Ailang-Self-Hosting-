// test_gpu_stage2.ailang — ISOLATION TEST: CP halt + soft reset + firmware load
// Build: ./ailang.x dev/compiler-regression/test_gpu_stage2.ailang test_gpu_stage2.x
// Run:   sudo ./test_gpu_stage2.x
//
// Tests (adds to Stage 1):
//   0. SPLL init via AtomBIOS — engine clocks must be running first
//   1. GPU_Discover + BAR map (same as stage 1)
//   2. PM4_HaltCP — first MMIO register WRITE (CP_ME_CNTL)
//   3. PM4_InitMCBase — reads MC_VM_FB_LOCATION
//   4. PM4_SoftResetCP — toggles GRBM_SOFT_RESET
//   5. PM4_LoadCPFirmware — bulk MMIO writes (PFP/ME/CE microcode)
//   6. PM4_LoadRLCFirmware — bulk MMIO writes (RLC microcode)
//   7. PM4_SetupIHRing — IH ring config registers
//   8. CP misc registers (CP_SEM_WAIT_TIMER, CP_RB_WPTR_DELAY, CP_DEBUG)
//
// NO ring setup, NO CP unhalt, NO command submission.
// SPLL init is REQUIRED — GRBM-domain registers need engine clocks.

LibraryImport.Drivers.AMDGPU.AMDGPUFamily
LibraryImport.Drivers.AMDGPU.AMDGPUDiscover
LibraryImport.Drivers.AMDGPU.AMDGPUBAR
LibraryImport.Drivers.AMDGPU.AMDGPUAtomBIOS
LibraryImport.Drivers.AMDGPU.AMDGPUAtomExec
LibraryImport.Drivers.AMDGPU.AMDGPUAtomExecIO
LibraryImport.Drivers.AMDGPU.AMDGPUAtomExecDecode
LibraryImport.Drivers.AMDGPU.AMDGPUAtomExecOps
LibraryImport.Drivers.AMDGPU.AMDGPUAtomExecRun
LibraryImport.Drivers.AMDGPU.AMDGPUPowerPlay
LibraryImport.Drivers.AMDGPU.AMDGPUVoltage
LibraryImport.Drivers.AMDGPU.AMDGPUSMCRegs
LibraryImport.Drivers.AMDGPU.AMDGPUSMC_SI
LibraryImport.Drivers.AMDGPU.AMDGPUSMC
LibraryImport.Drivers.AMDGPU.AMDGPUDPM_SI
LibraryImport.Drivers.AMDGPU.AMDGPUPM4
LibraryImport.Drivers.AMDGPU.AMDGPUPM4Regs

SubRoutine.Main {
    PrintMessage("=== GPU STAGE 2: CP Halt + Reset + FW Load ===\n\n")

    // --- Discover + BAR map (same as stage 1) ---
    PrintMessage("[S2] Discovering AMD GPUs...\n")
    n_gpus = GPU_Discover()
    IfCondition EqualTo(n_gpus, 0) ThenBlock: {
        PrintMessage("[S2] FAIL: No AMD GPUs found\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }
    PrintMessage("[S2] Found GPUs: ")
    PrintNumber(n_gpus)
    PrintMessage("\n")

    // Select compute GPU (PCI bus 2) — never touch display GPU (bus 1)
    gpu = -1
    gi = 0
    WhileLoop LessThan(gi, n_gpus) {
        bus = GPU_GetDeviceField(gi, GPUDevField.PCI_BUS)
        IfCondition EqualTo(bus, 2) ThenBlock: {
            gpu = gi
        }
        gi = Add(gi, 1)
    }
    IfCondition LessThan(gpu, 0) ThenBlock: {
        PrintMessage("[S2] FAIL: no GPU on PCI bus 02\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }

    GPU_BAR_Init()
    rc = GPU_BAR_MapMMIO(gpu)
    IfCondition EqualTo(rc, 0) ThenBlock: {
        PrintMessage("[S2] FAIL: MMIO map failed\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }
    rc = GPU_BAR_MapVRAM(gpu)
    IfCondition EqualTo(rc, 0) ThenBlock: {
        PrintMessage("[S2] FAIL: VRAM map failed\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }
    PrintMessage("[S2] BARs mapped OK\n\n")

    // --- Step 1: Initialize SPLL (engine clocks) ---
    // GRBM-routed registers (CP_ME_CNTL, GRBM_SOFT_RESET, firmware load
    // regs) require engine clocks to complete PCI transactions.  On fresh
    // boot with radeon unbound, SPLL is in reset/bypass — writing GRBM
    // regs stalls the PCI bus and hard-locks the shared RD990 root complex.
    PrintMessage("[S2] Loading AtomBIOS + initializing SPLL...\n")
    rom = AtomBIOS_LoadROM(gpu)
    IfCondition EqualTo(rom, 0) ThenBlock: {
        PrintMessage("[S2] FAIL: AtomBIOS ROM load failed\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }
    AtomBIOS_Parse(gpu)
    PP_Parse(gpu)
    Volt_Parse(gpu)
    spll_rc = DPM_SI_InitSPLL(gpu)
    IfCondition EqualTo(spll_rc, 0) ThenBlock: {
        PrintMessage("[S2] FAIL: SPLL init failed\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }
    PrintMessage("[S2] SPLL initialized, engine clocks running\n\n")

    // --- Step 2: Halt CP (first register WRITE) ---
    PrintMessage("[S2] Halting CP (first MMIO write)...\n")
    PM4_HaltCP(gpu)
    PrintMessage("[S2] CP halted OK\n")

    // --- Step 3: Read MC base ---
    PrintMessage("[S2] Reading MC base...\n")
    PM4_InitMCBase(gpu)
    PrintMessage("[S2] MC base initialized OK\n")

    // --- Step 4: Soft reset CP ---
    PrintMessage("[S2] Soft resetting CP...\n")
    PM4_SoftResetCP(gpu)
    PrintMessage("[S2] Soft reset OK\n")

    // --- Step 5: Re-halt after reset ---
    PrintMessage("[S2] Re-halting CP after reset...\n")
    PM4_HaltCP(gpu)
    PrintMessage("[S2] Re-halted OK\n")

    // --- Step 6: Load CP firmware ---
    PrintMessage("[S2] Loading CP firmware (PFP/ME/CE)...\n")
    rc = PM4_LoadCPFirmware(gpu)
    PrintMessage("[S2] CP firmware result: ")
    PrintNumber(rc)
    PrintMessage("\n")
    IfCondition LessThan(rc, 0) ThenBlock: {
        PrintMessage("[S2] FAIL: CP firmware load failed\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }

    // --- Step 7: Load RLC firmware ---
    PrintMessage("[S2] Loading RLC firmware...\n")
    rc = PM4_LoadRLCFirmware(gpu)
    PrintMessage("[S2] RLC firmware result: ")
    PrintNumber(rc)
    PrintMessage("\n")
    IfCondition LessThan(rc, 0) ThenBlock: {
        PrintMessage("[S2] FAIL: RLC firmware load failed\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }

    // --- Step 8: Setup IH ring ---
    PrintMessage("[S2] Setting up IH ring...\n")
    rc = PM4_SetupIHRing(gpu)
    PrintMessage("[S2] IH ring result: ")
    PrintNumber(rc)
    PrintMessage("\n")
    IfCondition LessThan(rc, 0) ThenBlock: {
        PrintMessage("[S2] FAIL: IH ring setup failed\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }

    // --- Step 9: CP misc registers ---
    PrintMessage("[S2] Writing CP misc registers...\n")
    GPU_Wr32(gpu, SIReg.CP_SEM_WAIT_TIMER, 0)
    GPU_Wr32(gpu, SIReg.CP_SEM_INCOMPLETE_TIMER, 0)
    GPU_Wr32(gpu, SIReg.CP_RB_WPTR_DELAY, 0)
    GPU_Wr32(gpu, SIReg.CP_DEBUG, 0)
    PrintMessage("[S2] CP misc registers OK\n")

    // --- Readback sanity ---
    PrintMessage("\n[S2] GRBM_STATUS = 0x")
    PrintHex(GPU_Rd32(gpu, SIReg.GRBM_STATUS))
    PrintMessage("\n")
    PrintMessage("[S2] CP_ME_CNTL  = 0x")
    PrintHex(GPU_Rd32(gpu, SIReg.CP_ME_CNTL))
    PrintMessage("\n")

    // --- Cleanup ---
    PrintMessage("\n[S2] Unmapping BARs...\n")
    GPU_BAR_Unmap(gpu)

    PrintMessage("\n=== STAGE 2 PASS ===\n")
    SystemCall(60, 0, 0, 0, 0, 0)
}

RunTask(Main)
