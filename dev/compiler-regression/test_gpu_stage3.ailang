// test_gpu_stage3.ailang — ISOLATION TEST: Ring setup + ring test (first command submission)
// Build: ./ailang.x dev/compiler-regression/test_gpu_stage3.ailang test_gpu_stage3.x
// Run:   sudo ./test_gpu_stage3.x
//
// Tests (adds to Stage 2):
//   1. Everything from stage 2 (discover, BAR, halt, reset, FW load)
//   2. PM4_SetupRing(ring 0) — writes ring base/size regs, WPTR=0
//   3. PM4_CPStart — ME_INITIALIZE + CLEAR_STATE, UNHALTS CP
//   4. PM4_RingTest(ring 0) — submits NOP, polls RPTR==WPTR
//      ^^^^ THIS IS THE FIRST TIME THE CP ACTUALLY EXECUTES A COMMAND ^^^^
//   5. PM4_SetupRing(ring 1) + PM4_RingTest(ring 1)
//   6. PM4_SetupRing(ring 2) + PM4_RingTest(ring 2)
//   7. SCRATCH_UMSK + MMIO roundtrip check
//
// NO DPM, NO shader upload, NO compute dispatch.
// If this locks up: CP command execution is the problem (ring buffer / NOP / CLEAR_STATE).
// If this works: CP + rings are fine, proceed to stage 4.

LibraryImport.Drivers.AMDGPU.AMDGPUFamily
LibraryImport.Drivers.AMDGPU.AMDGPUDiscover
LibraryImport.Drivers.AMDGPU.AMDGPUBAR
LibraryImport.Drivers.AMDGPU.AMDGPUAtomBIOS
LibraryImport.Drivers.AMDGPU.AMDGPUAtomExec
LibraryImport.Drivers.AMDGPU.AMDGPUAtomExecIO
LibraryImport.Drivers.AMDGPU.AMDGPUAtomExecDecode
LibraryImport.Drivers.AMDGPU.AMDGPUAtomExecOps
LibraryImport.Drivers.AMDGPU.AMDGPUAtomExecRun
LibraryImport.Drivers.AMDGPU.AMDGPUPowerPlay
LibraryImport.Drivers.AMDGPU.AMDGPUVoltage
LibraryImport.Drivers.AMDGPU.AMDGPUSMCRegs
LibraryImport.Drivers.AMDGPU.AMDGPUSMC_SI
LibraryImport.Drivers.AMDGPU.AMDGPUSMC
LibraryImport.Drivers.AMDGPU.AMDGPUDPM_SI
LibraryImport.Drivers.AMDGPU.AMDGPUPM4
LibraryImport.Drivers.AMDGPU.AMDGPUPM4Regs
LibraryImport.Accel.HAL
LibraryImport.Accel.AccelGCN

SubRoutine.Main {
    PrintMessage("=== GPU STAGE 3: Ring Setup + Ring Test ===\n\n")

    // --- Discover + BAR map ---
    PrintMessage("[S3] Discovering AMD GPUs...\n")
    n_gpus = GPU_Discover()
    IfCondition EqualTo(n_gpus, 0) ThenBlock: {
        PrintMessage("[S3] FAIL: No AMD GPUs found\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }

    // Select compute GPU (PCI bus 2) — never touch display GPU (bus 1)
    gpu = -1
    gi = 0
    WhileLoop LessThan(gi, n_gpus) {
        bus = GPU_GetDeviceField(gi, GPUDevField.PCI_BUS)
        IfCondition EqualTo(bus, 2) ThenBlock: {
            gpu = gi
        }
        gi = Add(gi, 1)
    }
    IfCondition LessThan(gpu, 0) ThenBlock: {
        PrintMessage("[S3] FAIL: no GPU on PCI bus 02\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }

    GPU_BAR_Init()
    rc = GPU_BAR_MapMMIO(gpu)
    IfCondition EqualTo(rc, 0) ThenBlock: {
        PrintMessage("[S3] FAIL: MMIO map failed\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }
    rc = GPU_BAR_MapVRAM(gpu)
    IfCondition EqualTo(rc, 0) ThenBlock: {
        PrintMessage("[S3] FAIL: VRAM map failed\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }
    PrintMessage("[S3] BARs mapped OK\n")

    // --- SPLL init (engine clocks must run before GRBM-domain writes) ---
    PrintMessage("[S3] Initializing SPLL...\n")
    rom = AtomBIOS_LoadROM(gpu)
    IfCondition EqualTo(rom, 0) ThenBlock: {
        PrintMessage("[S3] FAIL: AtomBIOS ROM load failed\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }
    AtomBIOS_Parse(gpu)
    PP_Parse(gpu)
    Volt_Parse(gpu)
    spll_rc = DPM_SI_InitSPLL(gpu)
    IfCondition EqualTo(spll_rc, 0) ThenBlock: {
        PrintMessage("[S3] FAIL: SPLL init failed\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }
    PrintMessage("[S3] SPLL initialized\n")

    // --- CP halt + reset + FW load (same as stage 2) ---
    PrintMessage("[S3] Halting CP...\n")
    PM4_HaltCP(gpu)
    PM4_InitMCBase(gpu)
    PrintMessage("[S3] Soft resetting CP...\n")
    PM4_SoftResetCP(gpu)
    PM4_HaltCP(gpu)
    PrintMessage("[S3] Loading CP firmware...\n")
    rc = PM4_LoadCPFirmware(gpu)
    IfCondition LessThan(rc, 0) ThenBlock: {
        PrintMessage("[S3] FAIL: CP firmware load failed\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }
    PrintMessage("[S3] Loading RLC firmware...\n")
    rc = PM4_LoadRLCFirmware(gpu)
    IfCondition LessThan(rc, 0) ThenBlock: {
        PrintMessage("[S3] FAIL: RLC firmware load failed\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }
    PrintMessage("[S3] Setting up IH ring...\n")
    rc = PM4_SetupIHRing(gpu)
    IfCondition LessThan(rc, 0) ThenBlock: {
        PrintMessage("[S3] FAIL: IH ring setup failed\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }
    GPU_Wr32(gpu, SIReg.CP_SEM_WAIT_TIMER, 0)
    GPU_Wr32(gpu, SIReg.CP_SEM_INCOMPLETE_TIMER, 0)
    GPU_Wr32(gpu, SIReg.CP_RB_WPTR_DELAY, 0)
    GPU_Wr32(gpu, SIReg.CP_DEBUG, 0)
    PrintMessage("[S3] FW loaded, CP misc set\n\n")

    // === NEW IN STAGE 3 ===

    // --- Ring 0 setup ---
    PrintMessage("[S3] Setting up ring 0...\n")
    rc = PM4_SetupRing(gpu, 0, RingConf.VRAM_RING_OFFSET)
    IfCondition EqualTo(rc, 0) ThenBlock: {
        PrintMessage("[S3] FAIL: ring 0 setup failed\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }
    PrintMessage("[S3] Ring 0 setup OK\n")

    // --- CP control registers ---
    GPU_Wr32(gpu, SIReg.CP_MAX_CONTEXT, 7)
    GPU_Wr32(gpu, SIReg.CP_ENDIAN_SWAP, 0)
    GPU_Wr32(gpu, SIReg.CP_DEVICE_ID, 1)

    // --- CP Start (ME_INITIALIZE + CLEAR_STATE + unhalt) ---
    PrintMessage("[S3] Starting CP (ME_INITIALIZE + CLEAR_STATE)...\n")
    PrintMessage("[S3] >>> THIS UNHALTS THE CP — FIRST COMMAND EXECUTION <<<\n")
    rc = PM4_CPStart(gpu, 0)
    IfCondition EqualTo(rc, 0) ThenBlock: {
        PrintMessage("[S3] FAIL: CP start failed\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }
    PrintMessage("[S3] CP started OK\n")

    // --- Ring 0 test (first actual NOP submission) ---
    PrintMessage("[S3] Ring 0 test (NOP submission)...\n")
    rc = PM4_RingTest(0)
    IfCondition EqualTo(rc, 0) ThenBlock: {
        PrintMessage("[S3] FAIL: ring 0 test failed\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }
    PrintMessage("[S3] Ring 0 test PASS\n")

    // --- Ring 1 setup + test ---
    PrintMessage("[S3] Setting up ring 1...\n")
    rc = PM4_SetupRing(gpu, 1, AccelGCNLayout.RING1_OFFSET)
    IfCondition EqualTo(rc, 0) ThenBlock: {
        PrintMessage("[S3] FAIL: ring 1 setup failed\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }
    PrintMessage("[S3] Ring 1 test...\n")
    rc = PM4_RingTest(1)
    IfCondition EqualTo(rc, 0) ThenBlock: {
        PrintMessage("[S3] FAIL: ring 1 test failed\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }
    PrintMessage("[S3] Ring 1 test PASS\n")

    // --- Ring 2 setup + test ---
    PrintMessage("[S3] Setting up ring 2...\n")
    rc = PM4_SetupRing(gpu, 2, AccelGCNLayout.RING2_OFFSET)
    IfCondition EqualTo(rc, 0) ThenBlock: {
        PrintMessage("[S3] FAIL: ring 2 setup failed\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }
    PrintMessage("[S3] Ring 2 test...\n")
    rc = PM4_RingTest(2)
    IfCondition EqualTo(rc, 0) ThenBlock: {
        PrintMessage("[S3] FAIL: ring 2 test failed\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }
    PrintMessage("[S3] Ring 2 test PASS\n")

    // --- SCRATCH_UMSK + roundtrip ---
    GPU_Wr32(gpu, SIReg.SCRATCH_UMSK, 255)
    GPU_Wr32(gpu, SIReg.SCRATCH_REG0, 3405691582)
    scratch_rb = GPU_Rd32(gpu, SIReg.SCRATCH_REG0)
    PrintMessage("[S3] SCRATCH roundtrip: wrote 0xCAFEBABE read=0x")
    PrintHex(scratch_rb)
    PrintMessage("\n")
    GPU_Wr32(gpu, SIReg.SCRATCH_REG0, 0)

    // --- Cleanup ---
    PrintMessage("\n[S3] Halting CP for cleanup...\n")
    PM4_HaltCP(gpu)
    GPU_BAR_Unmap(gpu)

    PrintMessage("\n=== STAGE 3 PASS ===\n")
    SystemCall(60, 0, 0, 0, 0, 0)
}

RunTask(Main)
