// A key copied by Hash.Set and a literal of the same characters must hash
// equal. Splicing Hash.CRC32Step left its asm reading edi, so the hash
// followed the pointer and Hash.Get of the literal missed.
LibraryImport.Arena
LibraryImport.Hash

SubRoutine.Main {
    plain = Hash.Create(16)
    Hash.Set(plain, "A", 11)
    Hash.Set(plain, "B", 22)

    t = Hash.Create(16)
    i = 0
    WhileLoop LessThan(i, 8) {
        k = NumberToString(i)
        Hash.Set(t, k, Add(i, 1))
        i = Add(i, 1)
    }

    bad = 0
    IfCondition NotEqual(Hash.Get(plain, "A"), 11) ThenBlock: { bad = Add(bad, 1) }
    IfCondition NotEqual(Hash.Get(plain, "B"), 22) ThenBlock: { bad = Add(bad, 1) }
    IfCondition NotEqual(Hash.Size(t), 8) ThenBlock: { bad = Add(bad, 1) }
    IfCondition NotEqual(Hash.Get(t, "0"), 1) ThenBlock: { bad = Add(bad, 1) }
    IfCondition NotEqual(Hash.Get(t, "1"), 2) ThenBlock: { bad = Add(bad, 1) }
    IfCondition NotEqual(Hash.Get(t, "7"), 8) ThenBlock: { bad = Add(bad, 1) }

    keys = Hash.Keys(t)
    j = 0
    kn = Array.Size(keys)
    found = 0
    WhileLoop LessThan(j, kn) {
        key = Array.Get(keys, j)
        IfCondition EqualTo(StringCompare(key, "0"), 0) ThenBlock: {
            found = 1
            IfCondition NotEqual(Hash.HashString(key), Hash.HashString("0")) ThenBlock: {
                bad = Add(bad, 1)
            }
            IfCondition NotEqual(Hash.Get(t, key), 1) ThenBlock: {
                bad = Add(bad, 1)
            }
        }
        j = Add(j, 1)
    }
    IfCondition EqualTo(found, 0) ThenBlock: { bad = Add(bad, 1) }

    IfCondition EqualTo(bad, 0) ThenBlock: {
        PrintMessage("PASS\n")
    }
    IfCondition NotEqual(bad, 0) ThenBlock: {
        PrintMessage("FAIL ")
        PrintNumber(bad)
        PrintMessage("\n")
    }
    Exit(bad)
}

RunTask(Main)
