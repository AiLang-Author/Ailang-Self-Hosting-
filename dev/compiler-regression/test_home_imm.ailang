// Homed cursor compared with, and incremented by, an immediate above
// 2^31-1. The general compare path refuses that immediate. The home
// path emits CMP r13 / ADD r13 with no fit check.

LibraryImport.Arena

FixedPool.HomeCheck {
    "fails": Initialize=0, CanChange=True
}

Function.Expect {
    Input: got: Integer
    Input: want: Integer
    Body: {
        IfCondition NotEqual(got, want) ThenBlock: {
            PrintMessage("FAIL got ")
            PrintNumber(got)
            PrintMessage(" want ")
            PrintNumber(want)
            PrintMessage("\n")
            HomeCheck.fails = Add(HomeCheck.fails, 1)
        }
    }
}

Function.HomeCmp {
    Output: Integer
    Body: {
        i = 0
        n = 0
        WhileLoop LessThan(i, 3000000000) {
            n = Add(n, 1)
            i = Add(i, 1)
            IfCondition GreaterThan(n, 2) ThenBlock: {
                BreakLoop
            }
        }
        ReturnValue(i)
    }
}

Function.HomeAdd {
    Output: Integer
    Body: {
        i = 0
        g = 0
        WhileLoop LessThan(g, 1) {
            i = Add(i, 3000000000)
            g = Add(g, 1)
        }
        ReturnValue(i)
    }
}

Function.SmallCmp {
    Output: Integer
    Body: {
        i = 0
        n = 0
        WhileLoop LessThan(i, 10) {
            n = Add(n, 1)
            i = Add(i, 1)
            IfCondition GreaterThan(n, 2) ThenBlock: {
                BreakLoop
            }
        }
        ReturnValue(i)
    }
}

Function.SmallAdd {
    Output: Integer
    Body: {
        i = 0
        g = 0
        WhileLoop LessThan(g, 1) {
            i = Add(i, 9)
            g = Add(g, 1)
        }
        ReturnValue(i)
    }
}

SubRoutine.Main {
    Expect(HomeCmp(), 3)
    Expect(HomeAdd(), 3000000000)
    Expect(SmallCmp(), 3)
    Expect(SmallAdd(), 9)
    PrintMessage("literal ")
    PrintNumber(3000000000)
    PrintMessage("\n")
    PrintMessage("fails ")
    PrintNumber(HomeCheck.fails)
    PrintMessage("\n")
    ProcessExit(HomeCheck.fails)
}

RunTask(Main)
