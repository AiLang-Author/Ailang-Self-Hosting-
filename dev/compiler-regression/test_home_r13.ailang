// The integer home itself, not the r12 accumulator.

LibraryImport.Arena

FixedPool.Guard {
    "n": Initialize=0, CanChange=True
    "m": Initialize=0, CanChange=True
}

Function.AddR13 {
    Output: Integer
    Body: {
        i = 0
        Guard.n = 0
        WhileLoop LessThan(i, 5) {
            i = Add(i, 3000000000)
            Guard.n = Add(Guard.n, 1)
            IfCondition GreaterThan(Guard.n, 0) ThenBlock: {
                BreakLoop
            }
        }
        ReturnValue(i)
    }
}

Function.SubR13 {
    Output: Integer
    Body: {
        j = 4000000000
        Guard.m = 0
        WhileLoop GreaterThan(j, 0) {
            j = Subtract(j, 3000000000)
            Guard.m = Add(Guard.m, 1)
            IfCondition GreaterThan(Guard.m, 0) ThenBlock: {
                BreakLoop
            }
        }
        ReturnValue(j)
    }
}

SubRoutine.Main {
    PrintNumber(AddR13())
    PrintMessage("\n")
    PrintNumber(SubR13())
    PrintMessage("\n")
    ProcessExit(0)
}

RunTask(Main)
