// Keep-alive HTTP/1.1 fence server on 127.0.0.1:18766
LibraryImport.Arena
LibraryImport.HTTP1

Function.HealthHandler {
    Input: conn: Address
    Body: {
        path = HTTP1.Path(conn)
        cmp = StringCompare(path, "/health")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            body = "{\"status\":\"ok\"}"
            HTTP1.Reply(conn, 200, body, 15)
        } ElseBlock: {
            body = "{\"error\":\"not found\"}"
            HTTP1.Reply(conn, 404, body, 21)
        }
    }
}

SubRoutine.Main {
    fd = HTTP1.Listen("127.0.0.1", 18766)
    IfCondition LessThan(fd, 0) ThenBlock: {
        PrintMessage("FAIL listen\n")
        Exit(1)
    }
    PrintMessage("listening\n")
    HTTP1.Serve(AddressOf(HealthHandler))
    Exit(0)
}
RunTask(Main)
