// x = Scale(x) must keep the original x. Inlining that renames both
// the unread parameter and the return variable to x computes 1.

LibraryImport.Arena

FixedPool.InCheck {
    "fails": Initialize=0, CanChange=True
}

Function.Expect {
    Input: got: Integer
    Input: want: Integer
    Body: {
        IfCondition NotEqual(got, want) ThenBlock: {
            PrintMessage("FAIL got ")
            PrintNumber(got)
            PrintMessage(" want ")
            PrintNumber(want)
            PrintMessage("\n")
            InCheck.fails = Add(InCheck.fails, 1)
        }
    }
}

Function.Scale {
    Input: p: Integer
    Output: Integer
    Body: {
        r = 1
        r = Multiply(r, p)
        ReturnValue(r)
    }
}

Function.AliasCase {
    Output: Integer
    Body: {
        x = 7
        x = Scale(x)
        ReturnValue(x)
    }
}

Function.FreshCase {
    Output: Integer
    Body: {
        x = 7
        y = Scale(x)
        ReturnValue(y)
    }
}

Function.Copy {
    Input: p: Integer
    Output: Integer
    Body: {
        r = p
        ReturnValue(r)
    }
}

Function.CopyCase {
    Output: Integer
    Body: {
        x = 7
        x = Copy(x)
        ReturnValue(x)
    }
}

SubRoutine.Main {
    Expect(AliasCase(), 7)
    Expect(FreshCase(), 7)
    Expect(CopyCase(), 7)
    PrintMessage("fails ")
    PrintNumber(InCheck.fails)
    PrintMessage("\n")
    ProcessExit(InCheck.fails)
}

RunTask(Main)
