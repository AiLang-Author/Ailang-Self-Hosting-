// An add or subtract of a name and a number is built in RBX after the
// other operand is already in RAX. The stepped form and the nested form
// must agree, including subtraction and divide order, negative dividends,
// and an addend that does not fit in a signed 32-bit immediate.

LibraryImport.Arena

FixedPool.IntLeaf {
    "fails": Initialize=0, CanChange=True
}

Function.Expect {
    Input: got: Integer
    Input: want: Integer
    Body: {
        IfCondition NotEqual(got, want) ThenBlock: {
            PrintMessage("FAIL got ")
            PrintNumber(got)
            PrintMessage(" want ")
            PrintNumber(want)
            PrintMessage("\n")
            IntLeaf.fails = Add(IntLeaf.fails, 1)
        }
    }
}

SubRoutine.Main {
    v = 0
    i = 0
    t = 0
    WhileLoop LessThan(t, 5) {
        v = Add(v, 1)
        IfCondition LessThan(t, 3) ThenBlock: {
            i = Add(i, 1)
        }
        t = Add(t, 1)
    }
    n = 0
    t = 0
    WhileLoop LessThan(t, 5) {
        n = Subtract(n, 1)
        t = Add(t, 1)
    }

    // v is 5, i is 3, n is -5. Loop-carried names stay variables.

    sacc = 0
    j = 0
    WhileLoop LessThan(j, v) {
        ij1 = Add(j, 1)
        prod = Multiply(j, ij1)
        extra = Multiply(j, ij1)
        tri = Divide(prod, 2)
        extra = Add(extra, tri)
        ip1 = Add(i, 1)
        sden = Add(tri, ip1)
        extra = Add(extra, ip1)
        sacc = Add(sacc, sden)
        extra = Add(extra, sden)
        j = Add(j, 1)
    }
    nacc = 0
    j = 0
    WhileLoop LessThan(j, v) {
        nden = Add(Divide(Multiply(j, Add(j, 1)), 2), Add(i, 1))
        nacc = Add(nacc, nden)
        j = Add(j, 1)
    }
    Expect(nacc, sacc)

    sacc4 = 0
    j = 0
    WhileLoop LessThan(j, 5) {
        base = Add(n, j)
        extra = Add(n, j)
        q = Divide(base, 4)
        extra = Add(extra, q)
        ip1 = Add(i, 1)
        sden = Add(q, ip1)
        extra = Add(extra, ip1)
        sacc4 = Add(sacc4, sden)
        extra = Add(extra, sden)
        j = Add(j, 1)
    }
    nacc4 = 0
    j = 0
    WhileLoop LessThan(j, 5) {
        nden = Add(Divide(Add(n, j), 4), Add(i, 1))
        nacc4 = Add(nacc4, nden)
        j = Add(j, 1)
    }
    Expect(nacc4, sacc4)

    ij1 = Add(v, 1)
    prod = Multiply(v, ij1)
    extra = Multiply(v, ij1)
    right = Multiply(v, Add(v, 1))
    Expect(right, prod)
    left = Multiply(Add(v, 1), v)
    Expect(left, prod)
    extra = Add(extra, left)

    down = Subtract(v, Add(v, 1))
    Expect(down, Negate(1))
    back = Subtract(v, Subtract(v, 1))
    Expect(back, 1)
    ord = Subtract(Add(v, 1), v)
    Expect(ord, 1)

    gap = Subtract(Multiply(v, Add(v, 1)), Add(i, 1))
    ip1 = Add(i, 1)
    extra = Add(i, 1)
    sgap = Subtract(prod, ip1)
    Expect(gap, sgap)
    extra = Add(extra, sgap)

    den = Add(Divide(Multiply(v, Add(v, 1)), 2), Add(i, 1))
    tri = Divide(prod, 2)
    extra = Divide(prod, 2)
    sden = Add(tri, ip1)
    Expect(den, sden)

    den4 = Add(Divide(Negate(9), 8), Add(i, 1))
    q4 = Divide(Negate(9), 8)
    extra = Divide(Negate(9), 8)
    sden4 = Add(q4, ip1)
    Expect(den4, sden4)
    Expect(q4, Negate(1))

    den2 = Add(Divide(n, 2), Add(i, 1))
    q2 = Divide(n, 2)
    extra = Divide(n, 2)
    sden2 = Add(q2, ip1)
    Expect(den2, sden2)
    Expect(q2, Negate(2))

    jq = 0
    j = 0
    WhileLoop LessThan(j, v) {
        qn = Divide(Add(j, Add(i, 1)), Add(j, 1))
        leftj = Add(j, ip1)
        extra = Add(j, ip1)
        rightj = Add(j, 1)
        extra = Add(extra, rightj)
        qs = Divide(leftj, rightj)
        Expect(qn, qs)
        jq = Add(jq, qn)
        j = Add(j, 1)
    }
    Expect(jq, 10)

    wide = Multiply(v, Add(v, 3000000000))
    wsum = Add(v, 3000000000)
    extra = Add(v, 3000000000)
    swide = Multiply(v, wsum)
    Expect(wide, swide)

    wsub = Add(1, Subtract(v, 3000000000))
    piece = Subtract(v, 3000000000)
    extra = Subtract(v, 3000000000)
    swsub = Add(1, piece)
    Expect(wsub, swsub)

    wdiff = Add(1, Subtract(3000000000, v))
    piece2 = Subtract(3000000000, v)
    extra = Subtract(3000000000, v)
    swdiff = Add(1, piece2)
    Expect(wdiff, swdiff)

    negimm = Multiply(v, Add(v, -3))
    nsum = Add(v, -3)
    extra = Add(v, -3)
    sneg = Multiply(v, nsum)
    Expect(negimm, sneg)

    sh = LeftShift(Add(v, 1), 2)
    base = Add(v, 1)
    extra = Add(v, 1)
    ssh = LeftShift(base, 2)
    Expect(sh, ssh)

    sc = Multiply(Add(v, 1), 8)
    ssc = Multiply(base, 8)
    extra = Multiply(base, 8)
    Expect(sc, ssc)

    band = BitwiseAnd(v, Add(v, 2))
    bsum = Add(v, 2)
    extra = Add(v, 2)
    sband = BitwiseAnd(v, bsum)
    Expect(band, sband)

    cmp = LessThan(Add(v, 1), Add(i, 1))
    cl = Add(v, 1)
    cr = Add(i, 1)
    extra = Add(cr, cl)
    scmp = LessThan(cl, cr)
    Expect(cmp, scmp)
    Expect(cmp, 0)

    one = Modulo(Add(v, 3), 4)
    mbase = Add(v, 3)
    extra = Add(v, 3)
    sone = Modulo(mbase, 4)
    Expect(one, sone)

    PrintMessage("fails ")
    PrintNumber(IntLeaf.fails)
    PrintMessage("\n")
    ProcessExit(IntLeaf.fails)
}

RunTask(Main)
