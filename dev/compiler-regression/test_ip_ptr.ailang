// Induction pointers. A cursor-affine load used by a home fma stays in a
// register and is read with movsd. A second load a constant away from the
// first is a displacement. A separate multiply keeps both roundings.
// The cursor does not have to start at 0. Stride 24 is not a power of two.

LibraryImport.Arena

FixedPool.IpCheck {
    "fails": Initialize=0, CanChange=True
}

Function.Expect {
    Input: got: Integer
    Input: want: Integer
    Body: {
        IfCondition NotEqual(got, want) ThenBlock: {
            PrintMessage("FAIL got ")
            PrintNumber(got)
            PrintMessage(" want ")
            PrintNumber(want)
            PrintMessage("\n")
            IpCheck.fails = Add(IpCheck.fails, 1)
        }
    }
}

Function.FillTenths {
    Input: buf: Integer
    Input: n: Integer
    Body: {
        k = 0
        WhileLoop LessThan(k, n) {
            v = Float_Div(Float_FromInt(Add(k, 1)), Float_FromInt(10))
            StoreValue(Add(buf, Multiply(k, 8)), v)
            k = Add(k, 1)
        }
    }
}

// table[k] = (k+1)/10. Sum k=1,2,3 of table[k] * 1.0.
Function.Slice {
    Input: buf: Integer
    Output: Integer
    Body: {
        one = Float_FromInt(1)
        s = 0
        k = 1
        WhileLoop LessThan(k, 4) {
            s = Float_Add(s, Float_Mul(Dereference(Add(buf, Multiply(k, 8))), one))
            k = Add(k, 1)
        }
        ReturnValue(s)
    }
}

// Index k*3, so the byte step is 24. k starts at 1. Elements 3 and 6.
Function.Stride3 {
    Input: buf: Integer
    Output: Integer
    Body: {
        one = Float_FromInt(1)
        s = 0
        k = 1
        WhileLoop LessThan(k, 3) {
            s = Float_Add(s, Float_Mul(Dereference(Add(buf, Multiply(Multiply(k, 3), 8))), one))
            k = Add(k, 1)
        }
        ReturnValue(s)
    }
}

// home = home - mem * 1. One trip. buf[0] is 1/4. Result is 0.75.
Function.SubOne {
    Input: buf: Integer
    Output: Integer
    Body: {
        one = Float_FromInt(1)
        s = Float_FromInt(1)
        k = 0
        WhileLoop LessThan(k, 1) {
            s = Float_Sub(s, Float_Mul(Dereference(Add(buf, Multiply(k, 8))), one))
            k = Add(k, 1)
        }
        ReturnValue(s)
    }
}

// Two loads of 0.1 multiplied apart from the add. Index 2 is 9, so a
// pointer that steps too far cannot still print the unfused product.
Function.SplitPtr {
    Input: buf: Integer
    Output: Integer
    Body: {
        neg = Float_Neg(Float_Div(Float_FromInt(1), Float_FromInt(100)))
        s = neg
        k = 0
        WhileLoop LessThan(k, 2) {
            uj = Dereference(Add(buf, Multiply(k, 8)))
            prod = Float_Mul(uj, uj)
            s = Float_Add(s, prod)
            k = Add(k, 1)
        }
        ReturnValue(s)
    }
}

Function.FillTile {
    Input: ma: Integer
    Input: mb: Integer
    Body: {
        r = 0
        WhileLoop LessThan(r, 4) {
            c = 0
            WhileLoop LessThan(c, 4) {
                av = Float_FromInt(Add(Add(r, c), 1))
                bv = Float_FromInt(Add(Subtract(Multiply(r, 3), c), 4))
                off = Multiply(Add(Multiply(r, 4), c), 8)
                StoreValue(Add(ma, off), av)
                StoreValue(Add(mb, off), bv)
                c = Add(c, 1)
            }
            r = Add(r, 1)
        }
    }
}

// N=4 tile at i=1, j=0. Two row pointers, column pair is a displacement.
Function.Tile {
    Input: ma: Integer
    Input: mb: Integer
    Body: {
        i = 1
        WhileLoop LessThan(i, 2) {
            j = 0
            WhileLoop LessThan(j, 2) {
                s00 = 0
                s01 = 0
                s10 = 0
                s11 = 0
                k = 0
                WhileLoop LessThan(k, 4) {
                    ak = Add(Multiply(i, 4), k)
                    a0 = Dereference(Add(ma, Multiply(ak, 8)))
                    ak1 = Add(Multiply(Add(i, 1), 4), k)
                    a1 = Dereference(Add(ma, Multiply(ak1, 8)))
                    bk = Add(Multiply(k, 4), j)
                    b0 = Dereference(Add(mb, Multiply(bk, 8)))
                    bk1 = Add(bk, 1)
                    b1 = Dereference(Add(mb, Multiply(bk1, 8)))
                    s00 = Float_Add(s00, Float_Mul(a0, b0))
                    s01 = Float_Add(s01, Float_Mul(a0, b1))
                    s10 = Float_Add(s10, Float_Mul(a1, b0))
                    s11 = Float_Add(s11, Float_Mul(a1, b1))
                    k = Add(k, 1)
                }
                Expect(s00, 4638918722424143872)
                Expect(s01, 4638144666238189568)
                Expect(s10, 4640114991075164160)
                Expect(s11, 4639481672377565184)
                j = Add(j, 2)
            }
            i = Add(i, 2)
        }
    }
}

// Slot i holds i+1. bk = k*4+j is the address of a0 and also a factor,
// so the store has to stay. s is 1*0 + 5*4 + 9*8 + 13*12. s2 adds the
// same four elements.
Function.FillIndex {
    Input: buf: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, 16) {
            v = Float_FromInt(Add(i, 1))
            StoreValue(Add(buf, Multiply(i, 8)), v)
            i = Add(i, 1)
        }
    }
}

Function.LiveIndex {
    Input: ma: Integer
    Body: {
        one = Float_FromInt(1)
        s = 0
        s2 = 0
        j = 0
        k = 0
        WhileLoop LessThan(k, 4) {
            bk = Add(Multiply(k, 4), j)
            a0 = Dereference(Add(ma, Multiply(bk, 8)))
            s = Float_Add(s, Float_Mul(a0, Float_FromInt(bk)))
            s2 = Float_Add(s2, Float_Mul(a0, one))
            k = Add(k, 1)
        }
        Expect(s, Float_FromInt(248))
        Expect(s2, Float_FromInt(28))
    }
}

SubRoutine.Main {
    buf = Allocate(128)
    FillTenths(buf, 9)
    Expect(Slice(buf), 4606281698874543309)
    Expect(Stride3(buf), 4607632778762754458)
    quarter = Float_Div(Float_FromInt(1), Float_FromInt(4))
    StoreValue(buf, quarter)
    Expect(SubOne(buf), 4604930618986332160)
    tenth = Float_Div(Float_FromInt(1), Float_FromInt(10))
    StoreValue(buf, tenth)
    StoreValue(Add(buf, 8), tenth)
    nine = Float_FromInt(9)
    StoreValue(Add(buf, 16), nine)
    Expect(SplitPtr(buf), 4576918229304087677)
    ma = Allocate(128)
    mb = Allocate(128)
    FillTile(ma, mb)
    Tile(ma, mb)
    ix = Allocate(128)
    FillIndex(ix)
    LiveIndex(ix)
    PrintMessage("fails ")
    PrintNumber(IpCheck.fails)
    PrintMessage("\n")
    ProcessExit(IpCheck.fails)
}

RunTask(Main)
