// Induction sum in a register, and SAR versus toward-zero divide.
// x*(x+1) is always even, so divide by 2 matches SAR. Divide by 4 does not.

LibraryImport.Arena

FixedPool.IvCheck {
    "fails": Initialize=0, CanChange=True
}

Function.Expect {
    Input: got: Integer
    Input: want: Integer
    Body: {
        IfCondition NotEqual(got, want) ThenBlock: {
            PrintMessage("FAIL got ")
            PrintNumber(got)
            PrintMessage(" want ")
            PrintNumber(want)
            PrintMessage("\n")
            IvCheck.fails = Add(IvCheck.fails, 1)
        }
    }
}

Function.DivSum {
    Input: n: Integer
    Output: Integer
    Body: {
        s = 0
        j = 0
        WhileLoop LessThan(j, n) {
            s = Add(s, Divide(j, 2))
            j = Add(j, 1)
        }
        ReturnValue(s)
    }
}

Function.Tri {
    Input: n: Integer
    Output: Integer
    Body: {
        s = 0
        j = 0
        WhileLoop LessThan(j, n) {
            den = Divide(Multiply(j, Add(j, 1)), 2)
            s = Add(s, den)
            j = Add(j, 1)
        }
        ReturnValue(s)
    }
}

Function.TriAt {
    Input: n: Integer
    Input: i: Integer
    Output: Integer
    Body: {
        s = 0
        j = 0
        WhileLoop LessThan(j, n) {
            ij = Add(i, j)
            den = Divide(Multiply(ij, Add(ij, 1)), 2)
            s = Add(s, den)
            j = Add(j, 1)
        }
        ReturnValue(s)
    }
}

Function.From2 {
    Output: Integer
    Body: {
        i = 10
        s = 0
        j = 2
        WhileLoop LessThan(j, 6) {
            ij = Add(i, j)
            s = Add(s, ij)
            j = Add(j, 1)
        }
        ReturnValue(s)
    }
}

Function.Late {
    Output: Integer
    Body: {
        i = 1
        s = 0
        ij = 99
        j = 0
        WhileLoop LessThan(j, 4) {
            j = Add(j, 1)
            s = Add(s, ij)
            ij = Add(i, j)
        }
        ReturnValue(s)
    }
}

Function.NegWalk {
    Output: Integer
    Body: {
        s = 0
        k = Negate(8)
        WhileLoop LessThan(k, 4) {
            s = Add(s, Divide(k, 2))
            k = Add(k, 1)
        }
        ReturnValue(s)
    }
}

Function.Grid {
    Input: n: Integer
    Output: Integer
    Body: {
        i = 0
        s = 0
        WhileLoop LessThan(i, n) {
            j = 0
            WhileLoop LessThan(j, n) {
                ij = Add(i, j)
                s = Add(s, ij)
                j = Add(j, 1)
            }
            i = Add(i, 1)
        }
        ReturnValue(s)
    }
}

Function.Grid2 {
    Output: Integer
    Body: {
        i = 2
        s = 0
        WhileLoop LessThan(i, 5) {
            j = 3
            WhileLoop LessThan(j, 6) {
                ij = Add(j, i)
                s = Add(s, ij)
                j = Add(j, 1)
            }
            i = Add(i, 1)
        }
        ReturnValue(s)
    }
}

SubRoutine.Main {
    Expect(Divide(5, 2), 2)
    Expect(Divide(5, 4), 1)
    Expect(Divide(0, 2), 0)
    Expect(Divide(Negate(1), 2), 0)
    Expect(Divide(Negate(5), 2), Negate(2))
    Expect(Divide(Negate(6), 2), Negate(3))
    Expect(Divide(Negate(6), 4), Negate(1))
    Expect(Divide(Multiply(5, Add(5, 1)), 2), 15)
    Expect(Divide(Multiply(3037000501, Add(3037000501, 1)), 2), Negate(4611686013799150057))
    Expect(Divide(Multiply(3037000501, Add(3037000501, 1)), 4), Negate(2305843006899575028))
    Expect(DivSum(10), 20)
    Expect(Tri(5), 20)
    Expect(TriAt(5, 3), 80)
    Expect(From2(), 54)
    Expect(Late(), 108)
    Expect(NegWalk(), Negate(14))
    Expect(Grid(4), 48)
    Expect(Grid(5), 100)
    Expect(Grid2(), 63)
    PrintMessage("fails ")
    PrintNumber(IvCheck.fails)
    PrintMessage("\n")
    ProcessExit(IvCheck.fails)
}

RunTask(Main)
