// Add of a value and (register home + constant) is LEA. The stepped form
// and the nested form must agree. Subtract keeps its order. A displacement
// that does not fit in 32 bits stays on the old add.

LibraryImport.Arena

FixedPool.LeaCheck {
    "fails": Initialize=0, CanChange=True
}

Function.Expect {
    Input: got: Integer
    Input: want: Integer
    Body: {
        IfCondition NotEqual(got, want) ThenBlock: {
            PrintMessage("FAIL got ")
            PrintNumber(got)
            PrintMessage(" want ")
            PrintNumber(want)
            PrintMessage("\n")
            LeaCheck.fails = Add(LeaCheck.fails, 1)
        }
    }
}

SubRoutine.Main {
    i = 0
    t = 0
    WhileLoop LessThan(t, 3) {
        i = Add(i, 1)
        t = Add(t, 1)
    }
    // i is 3. The later loops read it and do not write it.

    // Read-only i can sit in r12. The divide uses rcx, then the add.
    s = 0
    j = 0
    WhileLoop LessThan(j, 4) {
        tri = Divide(Add(j, 5), 2)
        extra = Divide(Add(j, 5), 2)
        ip1 = Add(i, 1)
        extra = Add(extra, ip1)
        den = Add(tri, ip1)
        extra = Add(extra, den)
        s = Add(s, den)
        j = Add(j, 1)
    }
    n = 0
    j = 0
    WhileLoop LessThan(j, 4) {
        den = Add(Divide(Add(j, 5), 2), Add(i, 1))
        n = Add(n, den)
        j = Add(j, 1)
    }
    Expect(n, s)

    // The home sits on the left. Add is commutative.
    s = 0
    j = 0
    WhileLoop LessThan(j, 4) {
        tri = Divide(Add(j, 5), 2)
        extra = tri
        ip1 = Add(i, 1)
        extra = Add(extra, ip1)
        den = Add(ip1, tri)
        extra = Add(extra, den)
        s = Add(s, den)
        j = Add(j, 1)
    }
    n = 0
    j = 0
    WhileLoop LessThan(j, 4) {
        den = Add(Add(1, i), Divide(Add(j, 5), 2))
        n = Add(n, den)
        j = Add(j, 1)
    }
    Expect(n, s)

    // home - 1, and a negative constant.
    s = 0
    j = 0
    WhileLoop LessThan(j, 4) {
        tri = Divide(Add(j, 5), 2)
        extra = tri
        im1 = Subtract(i, 1)
        extra = Add(extra, im1)
        den = Add(tri, im1)
        extra = Add(extra, den)
        den2 = Add(tri, Add(i, -3))
        extra = Add(extra, den2)
        s = Add(s, Add(den, den2))
        j = Add(j, 1)
    }
    n = 0
    j = 0
    WhileLoop LessThan(j, 4) {
        tri = Divide(Add(j, 5), 2)
        den = Add(tri, Subtract(i, 1))
        den2 = Add(tri, Add(-3, i))
        n = Add(n, Add(den, den2))
        j = Add(j, 1)
    }
    Expect(n, s)

    // Subtract does not commute. tri - (i+1) stays tri - i - 1.
    s = 0
    j = 0
    WhileLoop LessThan(j, 4) {
        tri = Divide(Add(j, 5), 2)
        extra = tri
        ip1 = Add(i, 1)
        extra = Add(extra, ip1)
        den = Subtract(tri, ip1)
        extra = Add(extra, den)
        s = Add(s, den)
        j = Add(j, 1)
    }
    n = 0
    j = 0
    WhileLoop LessThan(j, 4) {
        den = Subtract(Divide(Add(j, 5), 2), Add(i, 1))
        n = Add(n, den)
        j = Add(j, 1)
    }
    Expect(n, s)

    // number - home is not home + constant.
    s = 0
    j = 0
    WhileLoop LessThan(j, 4) {
        piece = Subtract(5, i)
        extra = piece
        den = Add(j, piece)
        extra = Add(extra, den)
        s = Add(s, den)
        j = Add(j, 1)
    }
    n = 0
    j = 0
    WhileLoop LessThan(j, 4) {
        den = Add(j, Subtract(5, i))
        n = Add(n, den)
        j = Add(j, 1)
    }
    Expect(n, s)

    // The cursor is the home, so the LEA base is r13. An integer sum takes r12.
    s = 0
    j = 0
    WhileLoop LessThan(j, 4) {
        jp1 = Add(j, 1)
        extra = jp1
        den = Add(i, jp1)
        extra = Add(extra, den)
        s = Add(s, den)
        j = Add(j, 1)
    }
    n = 0
    j = 0
    WhileLoop LessThan(j, 4) {
        den = Add(i, Add(j, 1))
        n = Add(n, den)
        j = Add(j, 1)
    }
    Expect(n, s)

    // Same name on both sides: i + (i+1) = 2*i+1.
    s = 0
    j = 0
    WhileLoop LessThan(j, 2) {
        ip1 = Add(i, 1)
        extra = ip1
        den = Add(i, ip1)
        extra = Add(extra, den)
        s = Add(s, den)
        j = Add(j, 1)
    }
    n = 0
    j = 0
    WhileLoop LessThan(j, 2) {
        den = Add(i, Add(i, 1))
        n = Add(n, den)
        j = Add(j, 1)
    }
    Expect(n, s)

    // Displacement needs 32 bits. 1000 is past disp8. 3000000000 does not fit.
    s = 0
    j = 0
    WhileLoop LessThan(j, 3) {
        wide = Add(i, 1000)
        extra = wide
        huge = Add(i, 3000000000)
        extra = Add(extra, huge)
        den = Add(j, wide)
        den2 = Add(j, huge)
        extra = Add(extra, Add(den, den2))
        s = Add(s, Add(den, den2))
        j = Add(j, 1)
    }
    n = 0
    j = 0
    WhileLoop LessThan(j, 3) {
        den = Add(j, Add(i, 1000))
        den2 = Add(j, Add(i, 3000000000))
        n = Add(n, Add(den, den2))
        j = Add(j, 1)
    }
    Expect(n, s)

    // Cursor minus one, as the right-hand side of an add.
    s = 0
    j = 0
    WhileLoop LessThan(j, 4) {
        jm1 = Subtract(j, 1)
        extra = jm1
        den = Add(i, jm1)
        extra = Add(extra, den)
        s = Add(s, den)
        j = Add(j, 1)
    }
    n = 0
    j = 0
    WhileLoop LessThan(j, 4) {
        den = Add(i, Subtract(j, 1))
        n = Add(n, den)
        j = Add(j, 1)
    }
    Expect(n, s)

    PrintMessage("fails ")
    PrintNumber(LeaCheck.fails)
    PrintMessage("\n")
    ProcessExit(LeaCheck.fails)
}

RunTask(Main)
