// Leaf vs call. Add is a CALL node, so AddOnly must take a frame.
// Pick's Case value is an identifier, so Branch takes the push path.
// A leaf keeps RSP == RBP, and that push writes [RBP-8] (param 1).
// Pick(99, 1) should return 2. A clobber makes the case compare the tag to itself and return 1.
// PickLit uses numeric cases (no push) and must still return the first argument.

LibraryImport.Arena

FixedPool.LeafCheck {
    "fails": Initialize=0, CanChange=True
}

Function.Expect {
    Input: got: Integer
    Input: want: Integer
    Body: {
        IfCondition NotEqual(got, want) ThenBlock: {
            PrintMessage("FAIL got ")
            PrintNumber(got)
            PrintMessage(" want ")
            PrintNumber(want)
            PrintMessage("\n")
            LeafCheck.fails = Add(LeafCheck.fails, 1)
        }
    }
}

Function.AddOnly {
    Input: a: Integer
    Input: b: Integer
    Body: {
        ReturnValue(Add(a, b))
    }
}

Function.Ident {
    Input: x: Integer
    Body: {
        ReturnValue(x)
    }
}

Function.Pick {
    Input: x: Integer
    Input: tag: Integer
    Body: {
        Branch tag {
            Case x: {
                ReturnValue(1)
            }
            Default: {
                ReturnValue(2)
            }
        }
    }
}

Function.PickLit {
    Input: x: Integer
    Input: tag: Integer
    Body: {
        Branch tag {
            Case 1: {
                ReturnValue(x)
            }
            Default: {
                ReturnValue(2)
            }
        }
    }
}

SubRoutine.Main {
    Expect(AddOnly(3, 4), 7)
    Expect(Ident(5), 5)
    Expect(Pick(99, 1), 2)
    Expect(Pick(5, 7), 2)
    Expect(Pick(99, 99), 1)
    Expect(PickLit(99, 1), 99)
    PrintMessage("fails ")
    PrintNumber(LeafCheck.fails)
    PrintMessage("\n")
    ProcessExit(LeafCheck.fails)
}

RunTask(Main)
