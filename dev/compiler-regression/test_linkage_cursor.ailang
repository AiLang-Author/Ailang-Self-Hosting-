// Cursor-homed LinkagePool fields must see each record, and a null
// pointer outside a home still reads as 0.
LibraryImport.Arena

LinkagePool.Shape {
    "kind": Initialize=0
    "w": Initialize=0
    "h": Initialize=0
}

FixedPool.Tally {
    "bad": Initialize=0, CanChange=True
}

Function.Expect {
    Input: got: Integer
    Input: want: Integer
    Input: tag: Integer
    Body: {
        IfCondition NotEqual(got, want) ThenBlock: {
            PrintMessage("FAIL ")
            PrintNumber(tag)
            PrintMessage(" got ")
            PrintNumber(got)
            PrintMessage(" want ")
            PrintNumber(want)
            PrintMessage("\n")
            Tally.bad = Add(Tally.bad, 1)
        }
    }
}

Function.Inner {
    Input: x: Integer
    Output: Integer
    Body: {
        ReturnValue(x)
    }
}

Function.Identity {
    Input: x: Integer
    Output: Integer
    Body: {
        ReturnValue(Inner(x))
    }
}

Function.Fill {
    Output: Integer
    Body: {
        i = 0
        first = 0
        WhileLoop LessThan(i, 4) {
            rec = AllocateLinkage(LinkagePool.Shape)
            IfCondition EqualTo(i, 0) ThenBlock: {
                first = rec
            }
            rec@kind = Add(i, 1)
            rec@w = Add(i, 10)
            rec@h = Add(i, 20)
            i = Add(i, 1)
        }
        ReturnValue(first)
    }
}

Function.SumCursor {
    Input: base: Integer
    Output: Integer
    Body: {
        cursor = AllocateLinkage(LinkagePool.Shape)
        acc = 0
        cursor = base
        limit = Add(base, 96)
        WhileLoop LessThan(cursor, limit) {
            acc = Add(acc, cursor@kind)
            cursor = Add(cursor, 24)
        }
        ReturnValue(acc)
    }
}

Function.SumRec {
    Input: base: Integer
    Output: Integer
    Body: {
        rec = AllocateLinkage(LinkagePool.Shape)
        acc = 0
        cursor = base
        limit = Add(base, 96)
        WhileLoop LessThan(cursor, limit) {
            rec = cursor
            acc = Add(acc, rec@kind)
            acc = Add(acc, rec@w)
            cursor = Add(cursor, 24)
        }
        ReturnValue(acc)
    }
}

Function.SumAfterCall {
    Input: base: Integer
    Output: Integer
    Body: {
        rec = AllocateLinkage(LinkagePool.Shape)
        acc = 0
        cursor = base
        limit = Add(base, 96)
        WhileLoop LessThan(cursor, limit) {
            rec = cursor
            k1 = rec@kind
            k2 = Identity(k1)
            k3 = rec@kind
            acc = Add(acc, k2)
            acc = Add(acc, k3)
            cursor = Add(cursor, 24)
        }
        ReturnValue(acc)
    }
}

Function.OldAfterStep {
    Input: base: Integer
    Output: Integer
    Body: {
        rec = AllocateLinkage(LinkagePool.Shape)
        cursor = base
        rec = cursor
        cursor = Add(cursor, 24)
        ReturnValue(rec@kind)
    }
}

Function.WriteBack {
    Input: base: Integer
    Output: Integer
    Body: {
        rec = AllocateLinkage(LinkagePool.Shape)
        cursor = base
        rec = cursor
        rec@kind = 99
        ReturnValue(Dereference(cursor))
    }
}

SubRoutine.Main {
    Arena_Init()
    base = Fill()
    Expect(SumCursor(base), 10, 1)
    Expect(SumRec(base), 56, 2)
    Expect(SumAfterCall(base), 20, 3)
    Expect(OldAfterStep(base), 1, 4)
    Expect(WriteBack(base), 99, 5)
    z = AllocateLinkage(LinkagePool.Shape)
    z = 0
    Expect(z@kind, 0, 6)
    IfCondition EqualTo(Tally.bad, 0) ThenBlock: {
        PrintMessage("PASS\n")
    }
    Exit(Tally.bad)
}

RunTask(Main)
