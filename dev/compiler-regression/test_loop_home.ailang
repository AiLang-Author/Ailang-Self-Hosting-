// Witness for compare-and-branch and, later, loop register homes.
// One checksum line from Main. No prints inside the loops.

Function.SumInts {
    Output: Integer
    Body: {
        acc = 0
        i = 0
        WhileLoop LessThan(i, 1000) {
            acc = Add(acc, i)
            i = Add(i, 1)
        }
        ReturnValue(acc)
    }
}

Function.SumSigned {
    Output: Integer
    Body: {
        acc = 0
        i = 0
        i = Subtract(i, 2)
        WhileLoop LessThan(i, 2) {
            acc = Add(acc, i)
            i = Add(i, 1)
        }
        ReturnValue(acc)
    }
}

Function.SumFloat {
    Output: Integer
    Body: {
        acc = 0
        one = Float_FromInt(1)
        i = 0
        WhileLoop LessThan(i, 100) {
            acc = Float_Add(acc, one)
            i = Add(i, 1)
        }
        ReturnValue(acc)
    }
}

Function.Bump {
    Input: n: Integer
    Output: Integer
    Body: {
        ReturnValue(Add(n, 1))
    }
}

Function.SumCall {
    Output: Integer
    Body: {
        acc = 0
        i = 0
        WhileLoop LessThan(i, 5) {
            acc = Bump(acc)
            i = Add(i, 1)
        }
        ReturnValue(acc)
    }
}

Function.SumAddr {
    Output: Integer
    Body: {
        x = 1
        i = 0
        WhileLoop LessThan(i, 3) {
            p = AddressOf(x)
            x = Add(Dereference(p), 1)
            i = Add(i, 1)
        }
        ReturnValue(x)
    }
}

SubRoutine.Main {
    PrintNumber(SumInts())
    PrintMessage(" ")
    PrintNumber(SumSigned())
    PrintMessage(" ")
    PrintNumber(SumFloat())
    PrintMessage(" ")
    PrintNumber(SumCall())
    PrintMessage(" ")
    PrintNumber(SumAddr())
    PrintMessage("\n")
    ProcessExit(0)
}

RunTask(Main)
