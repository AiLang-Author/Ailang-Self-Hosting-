// =============================================================================
// test_math_heavy.ailang
// Heavy math benchmark to measure optimizer impact
// =============================================================================

FixedPool.Bench {
    "iterations": Initialize=0, CanChange=True
    "result": Initialize=0, CanChange=True
}

// =============================================================================
// TEST 1: Lots of simple Add(var, var) in a loop
// This is where optimizer should shine
// =============================================================================
Function.BenchAddVars {
    Input: count: Integer
    Output: Integer
    Body: {
        total = 0
        a = 7
        b = 13
        i = 0
        WhileLoop LessThan(i, count) {
            total = Add(total, a)
            total = Add(total, b)
            total = Add(a, b)
            total = Add(total, Add(a, b))
            i = Add(i, 1)
        }
        ReturnValue(total)
    }
}

// =============================================================================
// TEST 2: Lots of simple Multiply(var, var)
// =============================================================================
Function.BenchMulVars {
    Input: count: Integer
    Output: Integer
    Body: {
        total = 1
        a = 2
        b = 3
        i = 0
        WhileLoop LessThan(i, count) {
            x = Multiply(a, b)
            y = Multiply(a, a)
            z = Multiply(b, b)
            total = Add(total, x)
            total = Add(total, y)
            total = Add(total, z)
            i = Add(i, 1)
        }
        ReturnValue(total)
    }
}

// =============================================================================
// TEST 3: Mixed operations
// =============================================================================
Function.BenchMixed {
    Input: count: Integer
    Output: Integer
    Body: {
        total = 0
        a = 10
        b = 3
        c = 7
        i = 0
        WhileLoop LessThan(i, count) {
            x = Add(a, b)
            y = Subtract(a, b)
            z = Multiply(a, b)
            total = Add(total, x)
            total = Add(total, y)
            total = Subtract(total, c)
            total = Add(total, z)
            i = Add(i, 1)
        }
        ReturnValue(total)
    }
}

// =============================================================================
// TEST 4: Simulated primes-like pattern (Modulo not optimized yet)
// =============================================================================
Function.BenchPrimesLike {
    Input: limit: Integer
    Output: Integer
    Body: {
        count = 0
        n = 2
        WhileLoop LessThan(n, limit) {
            is_prime = 1
            i = 2
            WhileLoop LessThan(Multiply(i, i), Add(n, 1)) {
                remainder = Modulo(n, i)
                IfCondition EqualTo(remainder, 0) ThenBlock: {
                    is_prime = 0
                }
                i = Add(i, 1)
            }
            IfCondition EqualTo(is_prime, 1) ThenBlock: {
                count = Add(count, 1)
            }
            n = Add(n, 1)
        }
        ReturnValue(count)
    }
}

// =============================================================================
// TEST 5: Deep expression (currently falls back - future optimization)
// Add(Multiply(a, b), Multiply(c, d))
// =============================================================================
Function.BenchDeepExpr {
    Input: count: Integer
    Output: Integer
    Body: {
        total = 0
        a = 2
        b = 3
        c = 4
        d = 5
        i = 0
        WhileLoop LessThan(i, count) {
            // These nested expressions currently fall back
            result = Add(Multiply(a, b), Multiply(c, d))
            total = Add(total, result)
            i = Add(i, 1)
        }
        ReturnValue(total)
    }
}

// =============================================================================
// MAIN
// =============================================================================
SubRoutine.Main {
    PrintMessage("==============================================\n")
    PrintMessage("MATH HEAVY BENCHMARK\n")
    PrintMessage("==============================================\n\n")
    
    iterations = 10000000
    
    PrintMessage("Running ")
    PrintNumber(iterations)
    PrintMessage(" iterations per test...\n\n")
    
    // Test 1: Add vars
    PrintMessage("Test 1: Add(var, var) loop... ")
    result1 = BenchAddVars(iterations)
    PrintMessage("result=")
    PrintNumber(result1)
    PrintMessage("\n")
    
    // Test 2: Multiply vars
    PrintMessage("Test 2: Multiply(var, var) loop... ")
    result2 = BenchMulVars(iterations)
    PrintMessage("result=")
    PrintNumber(result2)
    PrintMessage("\n")
    
    // Test 3: Mixed
    PrintMessage("Test 3: Mixed operations loop... ")
    result3 = BenchMixed(iterations)
    PrintMessage("result=")
    PrintNumber(result3)
    PrintMessage("\n")
    
    // Test 4: Primes-like (smaller iteration)
    PrintMessage("Test 4: Primes-like (n<500)... ")
    result4 = BenchPrimesLike(500)
    PrintMessage("found ")
    PrintNumber(result4)
    PrintMessage(" primes\n")
    
    // Test 5: Deep expressions
    PrintMessage("Test 5: Deep nested expressions... ")
    result5 = BenchDeepExpr(iterations)
    PrintMessage("result=")
    PrintNumber(result5)
    PrintMessage("\n")
    
    PrintMessage("\n==============================================\n")
    PrintMessage("BENCHMARK COMPLETE\n")
    PrintMessage("==============================================\n")
}

RunTask(Main)