// test_matmul.ailang — 32×32 integer matrix multiply endurance test
// C[i,j] = Σ_k A[i,k] * B[k,j],  N=32, 1024 threads, 10000 iterations
// Tests address math, MUL_LO_U32, ADD_U32, multi-buffer, 16 workgroups,
// and exercises the full compute reset cycle (~333 resets over 10K dispatches).
// Build: ./ailang.x dev/compiler-regression/test_matmul.ailang -o test_matmul.x
// Run:   sudo ./test_matmul.x 2>&1 | tee matmul_log.txt

LibraryImport.Arena
LibraryImport.Drivers.AMDGPU.AMDGPUFamily
LibraryImport.Drivers.AMDGPU.AMDGPUDiscover
LibraryImport.Drivers.AMDGPU.AMDGPUBAR
LibraryImport.Drivers.AMDGPU.AMDGPUPM4
LibraryImport.Drivers.AMDGPU.GCNEnc
LibraryImport.Accel.ComputeIR
LibraryImport.Accel.ComputeIR_GCN
LibraryImport.Accel.HAL
LibraryImport.Accel.AccelGCN

SubRoutine.Main {
    PrintMessage("=== 32x32 Integer Matrix Multiply Endurance Test ===\n")
    PrintMessage("C = A * B,  N=32,  1024 threads (16 WGs x 64),  10000 iterations\n")
    PrintMessage("B = identity => expect C = A each iteration\n\n")

    n = 32
    n2 = 1024
    buf_bytes = 4096          // 1024 elements * 4 bytes
    a_off = 0                 // A at data area offset 0
    b_off = 4096              // B at offset 4096
    c_off = 8192              // C at offset 8192
    max_iters = 10000

    // --- Init GPU ---
    rc = AccelGCN_Init()
    IfCondition LessThan(rc, 0) ThenBlock: {
        PrintMessage("FATAL: init failed rc=")
        PrintNumber(rc)
        PrintMessage("\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }
    PrintMessage("Init OK\n\n")

    // =====================================================================
    // Build kernel once:
    //   gid = GlobalIdX()        // 0..1023
    //   row = gid >> 5           // gid / 32
    //   col = gid & 0x1F        // gid % 32
    //   acc = 0
    //   for k = 0..31 (unrolled):
    //       a_idx = row * 32 + k
    //       b_idx = k * 32 + col
    //       a_val = LoadBuf(0, a_idx)
    //       b_val = LoadBuf(1, b_idx)
    //       acc += a_val * b_val
    //   c_idx = row * 32 + col
    //   StoreBuf(acc, 2, c_idx)
    // =====================================================================

    rc = CIR_Begin()
    rc = CIR_SetGroupSize(64, 1, 1)
    rc = CIR_SetGrid(16, 1, 1)        // 16 WGs x 64 = 1024 threads
    rc = CIR_BindBuffer(0, a_off, buf_bytes, 4, 1)   // A read
    rc = CIR_BindBuffer(1, b_off, buf_bytes, 4, 1)   // B read
    rc = CIR_BindBuffer(2, c_off, buf_bytes, 4, 2)   // C write

    // Allocate VRegs
    v_gid   = CIR_AllocVReg()
    v_row   = CIR_AllocVReg()
    v_col   = CIR_AllocVReg()
    v_acc   = CIR_AllocVReg()
    v_n     = CIR_AllocVReg()
    v_mask  = CIR_AllocVReg()
    v_shift = CIR_AllocVReg()
    v_k     = CIR_AllocVReg()
    v_a_idx = CIR_AllocVReg()
    v_b_idx = CIR_AllocVReg()
    v_a_val = CIR_AllocVReg()
    v_b_val = CIR_AllocVReg()
    v_tmp   = CIR_AllocVReg()
    v_c_idx = CIR_AllocVReg()

    // gid = GlobalIdX()
    rc = CIR_Op_GlobalIdX(v_gid)

    // Constants
    rc = CIR_Op_LoadConst(v_n, 32)
    rc = CIR_Op_LoadConst(v_mask, 31)
    rc = CIR_Op_LoadConst(v_shift, 5)

    // row = gid >> 5   (divide by 32)
    rc = CIR_Op_ShrU32(v_row, v_gid, v_shift)

    // col = gid & 0x1F
    rc = CIR_Op_AndB32(v_col, v_gid, v_mask)

    // acc = 0
    rc = CIR_Op_LoadConst(v_acc, 0)

    // ---- Unrolled k = 0..31 ----
    // k=0
    rc = CIR_Op_LoadConst(v_k, 0)
    rc = CIR_Op_MulLoU32(v_a_idx, v_row, v_n)
    rc = CIR_Op_AddU32(v_a_idx, v_a_idx, v_k)
    rc = CIR_Op_MulLoU32(v_b_idx, v_k, v_n)
    rc = CIR_Op_AddU32(v_b_idx, v_b_idx, v_col)
    rc = CIR_Op_LoadBuf(v_a_val, 0, v_a_idx)
    rc = CIR_Op_LoadBuf(v_b_val, 1, v_b_idx)
    rc = CIR_Op_WaitCnt(0, 0, 0)
    rc = CIR_Op_MulLoU32(v_tmp, v_a_val, v_b_val)
    rc = CIR_Op_AddU32(v_acc, v_acc, v_tmp)

    // k=1
    rc = CIR_Op_LoadConst(v_k, 1)
    rc = CIR_Op_MulLoU32(v_a_idx, v_row, v_n)
    rc = CIR_Op_AddU32(v_a_idx, v_a_idx, v_k)
    rc = CIR_Op_MulLoU32(v_b_idx, v_k, v_n)
    rc = CIR_Op_AddU32(v_b_idx, v_b_idx, v_col)
    rc = CIR_Op_LoadBuf(v_a_val, 0, v_a_idx)
    rc = CIR_Op_LoadBuf(v_b_val, 1, v_b_idx)
    rc = CIR_Op_WaitCnt(0, 0, 0)
    rc = CIR_Op_MulLoU32(v_tmp, v_a_val, v_b_val)
    rc = CIR_Op_AddU32(v_acc, v_acc, v_tmp)

    // k=2
    rc = CIR_Op_LoadConst(v_k, 2)
    rc = CIR_Op_MulLoU32(v_a_idx, v_row, v_n)
    rc = CIR_Op_AddU32(v_a_idx, v_a_idx, v_k)
    rc = CIR_Op_MulLoU32(v_b_idx, v_k, v_n)
    rc = CIR_Op_AddU32(v_b_idx, v_b_idx, v_col)
    rc = CIR_Op_LoadBuf(v_a_val, 0, v_a_idx)
    rc = CIR_Op_LoadBuf(v_b_val, 1, v_b_idx)
    rc = CIR_Op_WaitCnt(0, 0, 0)
    rc = CIR_Op_MulLoU32(v_tmp, v_a_val, v_b_val)
    rc = CIR_Op_AddU32(v_acc, v_acc, v_tmp)

    // k=3
    rc = CIR_Op_LoadConst(v_k, 3)
    rc = CIR_Op_MulLoU32(v_a_idx, v_row, v_n)
    rc = CIR_Op_AddU32(v_a_idx, v_a_idx, v_k)
    rc = CIR_Op_MulLoU32(v_b_idx, v_k, v_n)
    rc = CIR_Op_AddU32(v_b_idx, v_b_idx, v_col)
    rc = CIR_Op_LoadBuf(v_a_val, 0, v_a_idx)
    rc = CIR_Op_LoadBuf(v_b_val, 1, v_b_idx)
    rc = CIR_Op_WaitCnt(0, 0, 0)
    rc = CIR_Op_MulLoU32(v_tmp, v_a_val, v_b_val)
    rc = CIR_Op_AddU32(v_acc, v_acc, v_tmp)

    // k=4
    rc = CIR_Op_LoadConst(v_k, 4)
    rc = CIR_Op_MulLoU32(v_a_idx, v_row, v_n)
    rc = CIR_Op_AddU32(v_a_idx, v_a_idx, v_k)
    rc = CIR_Op_MulLoU32(v_b_idx, v_k, v_n)
    rc = CIR_Op_AddU32(v_b_idx, v_b_idx, v_col)
    rc = CIR_Op_LoadBuf(v_a_val, 0, v_a_idx)
    rc = CIR_Op_LoadBuf(v_b_val, 1, v_b_idx)
    rc = CIR_Op_WaitCnt(0, 0, 0)
    rc = CIR_Op_MulLoU32(v_tmp, v_a_val, v_b_val)
    rc = CIR_Op_AddU32(v_acc, v_acc, v_tmp)

    // k=5
    rc = CIR_Op_LoadConst(v_k, 5)
    rc = CIR_Op_MulLoU32(v_a_idx, v_row, v_n)
    rc = CIR_Op_AddU32(v_a_idx, v_a_idx, v_k)
    rc = CIR_Op_MulLoU32(v_b_idx, v_k, v_n)
    rc = CIR_Op_AddU32(v_b_idx, v_b_idx, v_col)
    rc = CIR_Op_LoadBuf(v_a_val, 0, v_a_idx)
    rc = CIR_Op_LoadBuf(v_b_val, 1, v_b_idx)
    rc = CIR_Op_WaitCnt(0, 0, 0)
    rc = CIR_Op_MulLoU32(v_tmp, v_a_val, v_b_val)
    rc = CIR_Op_AddU32(v_acc, v_acc, v_tmp)

    // k=6
    rc = CIR_Op_LoadConst(v_k, 6)
    rc = CIR_Op_MulLoU32(v_a_idx, v_row, v_n)
    rc = CIR_Op_AddU32(v_a_idx, v_a_idx, v_k)
    rc = CIR_Op_MulLoU32(v_b_idx, v_k, v_n)
    rc = CIR_Op_AddU32(v_b_idx, v_b_idx, v_col)
    rc = CIR_Op_LoadBuf(v_a_val, 0, v_a_idx)
    rc = CIR_Op_LoadBuf(v_b_val, 1, v_b_idx)
    rc = CIR_Op_WaitCnt(0, 0, 0)
    rc = CIR_Op_MulLoU32(v_tmp, v_a_val, v_b_val)
    rc = CIR_Op_AddU32(v_acc, v_acc, v_tmp)

    // k=7
    rc = CIR_Op_LoadConst(v_k, 7)
    rc = CIR_Op_MulLoU32(v_a_idx, v_row, v_n)
    rc = CIR_Op_AddU32(v_a_idx, v_a_idx, v_k)
    rc = CIR_Op_MulLoU32(v_b_idx, v_k, v_n)
    rc = CIR_Op_AddU32(v_b_idx, v_b_idx, v_col)
    rc = CIR_Op_LoadBuf(v_a_val, 0, v_a_idx)
    rc = CIR_Op_LoadBuf(v_b_val, 1, v_b_idx)
    rc = CIR_Op_WaitCnt(0, 0, 0)
    rc = CIR_Op_MulLoU32(v_tmp, v_a_val, v_b_val)
    rc = CIR_Op_AddU32(v_acc, v_acc, v_tmp)

    // k=8
    rc = CIR_Op_LoadConst(v_k, 8)
    rc = CIR_Op_MulLoU32(v_a_idx, v_row, v_n)
    rc = CIR_Op_AddU32(v_a_idx, v_a_idx, v_k)
    rc = CIR_Op_MulLoU32(v_b_idx, v_k, v_n)
    rc = CIR_Op_AddU32(v_b_idx, v_b_idx, v_col)
