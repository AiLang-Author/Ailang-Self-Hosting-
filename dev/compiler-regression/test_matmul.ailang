    rc = CIR_Op_AddU32(v_b_idx, v_b_idx, v_col)
    rc = CIR_Op_LoadBuf(v_a_val, 0, v_a_idx)
    rc = CIR_Op_LoadBuf(v_b_val, 1, v_b_idx)
    rc = CIR_Op_WaitCnt(0, 0, 0)
    rc = CIR_Op_MulLoU32(v_tmp, v_a_val, v_b_val)
    rc = CIR_Op_AddU32(v_acc, v_acc, v_tmp)

    // k=26
    rc = CIR_Op_LoadConst(v_k, 26)
    rc = CIR_Op_MulLoU32(v_a_idx, v_row, v_n)
    rc = CIR_Op_AddU32(v_a_idx, v_a_idx, v_k)
    rc = CIR_Op_MulLoU32(v_b_idx, v_k, v_n)
    rc = CIR_Op_AddU32(v_b_idx, v_b_idx, v_col)
    rc = CIR_Op_LoadBuf(v_a_val, 0, v_a_idx)
    rc = CIR_Op_LoadBuf(v_b_val, 1, v_b_idx)
    rc = CIR_Op_WaitCnt(0, 0, 0)
    rc = CIR_Op_MulLoU32(v_tmp, v_a_val, v_b_val)
    rc = CIR_Op_AddU32(v_acc, v_acc, v_tmp)

    // k=27
    rc = CIR_Op_LoadConst(v_k, 27)
    rc = CIR_Op_MulLoU32(v_a_idx, v_row, v_n)
    rc = CIR_Op_AddU32(v_a_idx, v_a_idx, v_k)
    rc = CIR_Op_MulLoU32(v_b_idx, v_k, v_n)
    rc = CIR_Op_AddU32(v_b_idx, v_b_idx, v_col)
    rc = CIR_Op_LoadBuf(v_a_val, 0, v_a_idx)
    rc = CIR_Op_LoadBuf(v_b_val, 1, v_b_idx)
    rc = CIR_Op_WaitCnt(0, 0, 0)
    rc = CIR_Op_MulLoU32(v_tmp, v_a_val, v_b_val)
    rc = CIR_Op_AddU32(v_acc, v_acc, v_tmp)

    // k=28
    rc = CIR_Op_LoadConst(v_k, 28)
    rc = CIR_Op_MulLoU32(v_a_idx, v_row, v_n)
    rc = CIR_Op_AddU32(v_a_idx, v_a_idx, v_k)
    rc = CIR_Op_MulLoU32(v_b_idx, v_k, v_n)
    rc = CIR_Op_AddU32(v_b_idx, v_b_idx, v_col)
    rc = CIR_Op_LoadBuf(v_a_val, 0, v_a_idx)
    rc = CIR_Op_LoadBuf(v_b_val, 1, v_b_idx)
    rc = CIR_Op_WaitCnt(0, 0, 0)
    rc = CIR_Op_MulLoU32(v_tmp, v_a_val, v_b_val)
    rc = CIR_Op_AddU32(v_acc, v_acc, v_tmp)

    // k=29
    rc = CIR_Op_LoadConst(v_k, 29)
    rc = CIR_Op_MulLoU32(v_a_idx, v_row, v_n)
    rc = CIR_Op_AddU32(v_a_idx, v_a_idx, v_k)
    rc = CIR_Op_MulLoU32(v_b_idx, v_k, v_n)
    rc = CIR_Op_AddU32(v_b_idx, v_b_idx, v_col)
    rc = CIR_Op_LoadBuf(v_a_val, 0, v_a_idx)
    rc = CIR_Op_LoadBuf(v_b_val, 1, v_b_idx)
    rc = CIR_Op_WaitCnt(0, 0, 0)
    rc = CIR_Op_MulLoU32(v_tmp, v_a_val, v_b_val)
    rc = CIR_Op_AddU32(v_acc, v_acc, v_tmp)

    // k=30
    rc = CIR_Op_LoadConst(v_k, 30)
    rc = CIR_Op_MulLoU32(v_a_idx, v_row, v_n)
    rc = CIR_Op_AddU32(v_a_idx, v_a_idx, v_k)
    rc = CIR_Op_MulLoU32(v_b_idx, v_k, v_n)
    rc = CIR_Op_AddU32(v_b_idx, v_b_idx, v_col)
    rc = CIR_Op_LoadBuf(v_a_val, 0, v_a_idx)
    rc = CIR_Op_LoadBuf(v_b_val, 1, v_b_idx)
    rc = CIR_Op_WaitCnt(0, 0, 0)
    rc = CIR_Op_MulLoU32(v_tmp, v_a_val, v_b_val)
    rc = CIR_Op_AddU32(v_acc, v_acc, v_tmp)

    // k=31
    rc = CIR_Op_LoadConst(v_k, 31)
    rc = CIR_Op_MulLoU32(v_a_idx, v_row, v_n)
    rc = CIR_Op_AddU32(v_a_idx, v_a_idx, v_k)
    rc = CIR_Op_MulLoU32(v_b_idx, v_k, v_n)
    rc = CIR_Op_AddU32(v_b_idx, v_b_idx, v_col)
    rc = CIR_Op_LoadBuf(v_a_val, 0, v_a_idx)
    rc = CIR_Op_LoadBuf(v_b_val, 1, v_b_idx)
    rc = CIR_Op_WaitCnt(0, 0, 0)
    rc = CIR_Op_MulLoU32(v_tmp, v_a_val, v_b_val)
    rc = CIR_Op_AddU32(v_acc, v_acc, v_tmp)

    // Store result: C[row*32 + col] = acc
    rc = CIR_Op_MulLoU32(v_c_idx, v_row, v_n)
    rc = CIR_Op_AddU32(v_c_idx, v_c_idx, v_col)
    rc = CIR_Op_StoreBuf(v_acc, 2, v_c_idx)
    rc = CIR_Op_WaitCnt(0, 0, 0)
    rc = CIR_Op_EndPgm()

    n_insns = CIR_End()
    mc_bytes = CIR_Lower_GCN()
    PrintMessage("Kernel: ")
    PrintNumber(n_insns)
    PrintMessage(" CIR insns, ")
    PrintNumber(mc_bytes)
    PrintMessage(" bytes GCN machine code\n\n")

    // Allocate host buffers (3 x 4096 bytes)
    host_a = Allocate(buf_bytes)
    host_b = Allocate(buf_bytes)
    host_c = Allocate(buf_bytes)

    // =====================================================================
    // Fill A once: A[i,j] = i*32 + j + 1  (values 1..1024)
    // Fill B once: identity matrix
    // =====================================================================
    i = 0
    WhileLoop LessThan(i, n) {
        j = 0
        WhileLoop LessThan(j, n) {
            idx = Add(Multiply(i, n), j)
            val = Add(idx, 1)
            off = Multiply(idx, 4)
            SetByte(host_a, off, BitwiseAnd(val, 255))
            SetByte(host_a, Add(off, 1), BitwiseAnd(RightShift(val, 8), 255))
            SetByte(host_a, Add(off, 2), BitwiseAnd(RightShift(val, 16), 255))
            SetByte(host_a, Add(off, 3), BitwiseAnd(RightShift(val, 24), 255))
            j = Add(j, 1)
        }
        i = Add(i, 1)
    }

    // B = identity: B[i,j] = (i==j) ? 1 : 0
    MemorySet(host_b, 0, buf_bytes)
    i = 0
    WhileLoop LessThan(i, n) {
        off = Multiply(Add(Multiply(i, n), i), 4)
        SetByte(host_b, off, 1)
        SetByte(host_b, Add(off, 1), 0)
        SetByte(host_b, Add(off, 2), 0)
        SetByte(host_b, Add(off, 3), 0)
        i = Add(i, 1)
    }

    // Upload A, B once (they don't change across iterations)
    discard = AccelGCN_VramWrite(a_off, host_a, buf_bytes)
    discard = AccelGCN_VramWrite(b_off, host_b, buf_bytes)

    PrintMessage("A and B uploaded. Starting 10000-iteration endurance loop...\n\n")

    // =====================================================================
    // 10K iteration loop: dispatch, read C, verify C == A
    // =====================================================================
    total_pass = 0
    total_fail = 0

    iter = 0
    WhileLoop LessThan(iter, max_iters) {
        // Zero C in VRAM
        MemorySet(host_c, 0, buf_bytes)
        discard = AccelGCN_VramWrite(c_off, host_c, buf_bytes)

        // Dispatch
        rc = AccelGCN_Dispatch()
        IfCondition LessThan(rc, 0) ThenBlock: {
            PrintMessage("FATAL: dispatch failed at iter ")
            PrintNumber(iter)
            PrintMessage(" rc=")
            PrintNumber(rc)
            PrintMessage("\n")
            SystemCall(60, 1, 0, 0, 0, 0)
        }

        // Read back C
        discard = AccelGCN_VramRead(c_off, host_c, buf_bytes)

        // Verify: C should equal A (C = A * I = A)
        errors = 0
        first_bad_idx = 0
        first_bad_got = 0
        first_bad_exp = 0
        i = 0
        WhileLoop LessThan(i, n2) {
            off = Multiply(i, 4)
            b0 = GetByte(host_c, off)
            b1 = GetByte(host_c, Add(off, 1))
            b2 = GetByte(host_c, Add(off, 2))
            b3 = GetByte(host_c, Add(off, 3))
            got = BitwiseOr(b0, BitwiseOr(LeftShift(b1, 8), BitwiseOr(LeftShift(b2, 16), LeftShift(b3, 24))))
            expected = Add(i, 1)
            IfCondition NotEqual(got, expected) ThenBlock: {
                IfCondition EqualTo(errors, 0) ThenBlock: {
                    first_bad_idx = i
                    first_bad_got = got
                    first_bad_exp = expected
                }
                errors = Add(errors, 1)
            }
            i = Add(i, 1)
        }

        // Print progress every 100 iterations, or on failure
        print_this = 0
        IfCondition EqualTo(Modulo(iter, 100), 0) ThenBlock: { print_this = 1 }
        IfCondition GreaterThan(errors, 0) ThenBlock: { print_this = 1 }

        IfCondition EqualTo(print_this, 1) ThenBlock: {
            PrintMessage("iter ")
            PrintNumber(iter)
            PrintMessage(": ")
            IfCondition EqualTo(errors, 0) ThenBlock: {
                PrintMessage("PASS 1024/1024\n")
            }
            IfCondition GreaterThan(errors, 0) ThenBlock: {
                PrintMessage("FAIL ")
                PrintNumber(Subtract(n2, errors))
                PrintMessage("/1024  first_bad=[")
                PrintNumber(first_bad_idx)
                PrintMessage("] got=")
                PrintNumber(first_bad_got)
                PrintMessage(" exp=")
                PrintNumber(first_bad_exp)
                PrintMessage("\n")
            }
        }

        IfCondition EqualTo(errors, 0) ThenBlock: {
            total_pass = Add(total_pass, 1)
        }
        IfCondition GreaterThan(errors, 0) ThenBlock: {
            total_fail = Add(total_fail, 1)
        }

        iter = Add(iter, 1)
    }

    // =====================================================================
    // Summary
    // =====================================================================
    PrintMessage("\n=== Summary ===\n")
    PrintMessage("Matrix: 32x32 integer multiply (C = A * I)\n")
    PrintMessage("Threads: 1024 (16 WGs x 64)\n")
    PrintMessage("Iterations: ")
    PrintNumber(max_iters)
    PrintMessage("  PASS: ")
    PrintNumber(total_pass)
    PrintMessage("  FAIL: ")
    PrintNumber(total_fail)
    PrintMessage("\n")

    IfCondition EqualTo(total_fail, 0) ThenBlock: { PrintMessage("*** ALL PASS ***\n") }
    IfCondition GreaterThan(total_fail, 0) ThenBlock: { PrintMessage("*** FAILURES DETECTED ***\n") }

    Deallocate(host_a, buf_bytes)
    Deallocate(host_b, buf_bytes)
    Deallocate(host_c, buf_bytes)
    discard = AccelGCN_Shutdown()
    PrintMessage("=== Done ===\n")
    SystemCall(60, 0, 0, 0, 0, 0)
}

RunTask(Main)
