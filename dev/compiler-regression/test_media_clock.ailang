// test_media_clock.ailang
// Validates MediaClock, CodecRing create/write/read round-trip.
// No display server, no ALSA required — runs anywhere.
//
// Tests:
//   1. MediaClock_Init + MediaClock_NowNS advances monotonically
//   2. MediaClock_PTStoNS converts correctly (90000 timebase)
//   3. MediaClock_DriftNS with simulated samples_out
//   4. CodecRing create, write packet, read packet back
//   5. CodecRing write/read with wrap-around
//   6. MediaSession slot allocation + free
//
// Build: ./ailang.x dev/compiler-regression/test_media_clock.ailang test_media_clock.x
// Run:   ./test_media_clock.x

LibraryImport.Arena
LibraryImport.Media.MediaClock
LibraryImport.Media.CodecRing
LibraryImport.Media.MediaSession
LibraryImport.Display.Render.AudioEngine
LibraryImport.StringUtils

FixedPool.TestSys {
    "SYS_NANOSLEEP": Initialize=35
}

FixedPool.TestState {
    "passed": Initialize=0
    "failed": Initialize=0
}

// =============================================================================
// ASSERT HELPERS
// =============================================================================
Function.Test_Pass {
    Input: name: Address
    Body: {
        PrintMessage("  [PASS] ")
        PrintString(name)
        PrintMessage("\n")
        TestState.passed = Add(TestState.passed, 1)
    }
}

Function.Test_Fail {
    Input: name: Address
    Input: got:  Integer
    Input: want: Integer
    Body: {
        PrintMessage("  [FAIL] ")
        PrintString(name)
        PrintMessage(" got=")
        PrintNumber(got)
        PrintMessage(" want=")
        PrintNumber(want)
        PrintMessage("\n")
        TestState.failed = Add(TestState.failed, 1)
    }
}

Function.Test_Assert {
    Input: name: Address
    Input: cond: Integer
    Input: got:  Integer
    Input: want: Integer
    Body: {
        IfCondition NotEqual(cond, 0) ThenBlock: {
            Test_Pass(name)
        } ElseBlock: {
            Test_Fail(name, got, want)
        }
    }
}

// =============================================================================
// SLEEP NS — tiny helper for timing tests
// =============================================================================
Function.SleepNS {
    Input: ns: Integer
    Body: {
        ts = Allocate(16)
        StoreValue(ts, 0)
        StoreValue(Add(ts, 8), ns)
        SystemCall(TestSys.SYS_NANOSLEEP, ts, 0)
        Deallocate(ts, 16)
    }
}

// =============================================================================
// TEST 1: Clock advances monotonically
// =============================================================================
Function.Test_ClockMonotonic {
    Body: {
        PrintMessage("\n[Test 1] Clock monotonicity\n")

        t0 = MediaClock_NowNS()
        SleepNS(5000000)
        t1 = MediaClock_NowNS()
        SleepNS(5000000)
        t2 = MediaClock_NowNS()

        Test_Assert("t1 > t0", GreaterThan(t1, t0), t1, t0)
        Test_Assert("t2 > t1", GreaterThan(t2, t1), t2, t1)

        // After 10ms sleep, elapsed should be >= 8ms (give WSL2 scheduler slack)
        elapsed = Subtract(t2, t0)
        Test_Assert("elapsed >= 8ms", GreaterEqual(elapsed, 8000000), elapsed, 8000000)

        PrintMessage("  elapsed_ns=")
        PrintNumber(elapsed)
        PrintMessage(" (~10ms expected)\n")
    }
}

// =============================================================================
// TEST 2: PTS conversion — 90000 timebase (MPEG)
// =============================================================================
Function.Test_PTSConvert {
    Body: {
        PrintMessage("\n[Test 2] PTS → NS conversion\n")

        start_ns = 0

        // 90000 ticks = 1 second = 1_000_000_000 ns
        ns = MediaClock_PTStoNS(start_ns, 90000, 90000)
        Test_Assert("1s in 90k timebase", EqualTo(ns, 1000000000), ns, 1000000000)

        // 45000 ticks = 0.5s = 500_000_000 ns
        ns2 = MediaClock_PTStoNS(start_ns, 45000, 90000)
        Test_Assert("0.5s in 90k timebase", EqualTo(ns2, 500000000), ns2, 500000000)

        // 48000 ticks in 48000 timebase = 1s
        ns3 = MediaClock_PTStoNS(start_ns, 48000, 48000)
        Test_Assert("1s in 48k timebase", EqualTo(ns3, 1000000000), ns3, 1000000000)

        // Non-zero session start
        ns4 = MediaClock_PTStoNS(1000000000, 90000, 90000)
        Test_Assert("1s + 1s start offset", EqualTo(ns4, 2000000000), ns4, 2000000000)
    }
}

// =============================================================================
// TEST 3: Audio drift detection
// =============================================================================
Function.Test_Drift {
    Body: {
        PrintMessage("\n[Test 3] Audio drift detection\n")

        // Simulate 1 second of audio written at 48kHz
        MediaClock_SetSamplesOut(48000)
        audio_ns = MediaClock_AudioNS()
        Test_Assert("48000 samples = 1s", EqualTo(audio_ns, 1000000000), audio_ns, 1000000000)

        // Simulate 0.5s
        MediaClock_SetSamplesOut(24000)
        audio_ns2 = MediaClock_AudioNS()
        Test_Assert("24000 samples = 0.5s", EqualTo(audio_ns2, 500000000), audio_ns2, 500000000)

        // Drift: set samples_out to represent 100ms of audio
        // then check drift_ns is negative (audio behind wall by ~100ms at worst)
        MediaClock_SetSamplesOut(4800)   // 100ms worth
        drift = MediaClock_DriftNS()
        PrintMessage("  drift_ns=")
        PrintNumber(drift)
        PrintMessage(" (audio behind wall, expected negative)\n")
        // We can't assert exact value since wall clock is live, just check it's reasonable
        Test_Assert("drift within +-1s", LessThan(drift, 1000000000), drift, 0)

        MediaClock_SetSamplesOut(0)
    }
}

// =============================================================================
// TEST 4: CodecRing create, write packet, read back
// =============================================================================
Function.Test_RingBasic {
    Body: {
        PrintMessage("\n[Test 4] CodecRing basic write/read\n")

        // Create rings for session 0
        r = CodecRing_Create(0)
        Test_Assert("ring create ok", EqualTo(r, 0), r, 0)

        pkt_ring = CodecRing_PktRing(0)
        Test_Assert("pkt ring ptr non-zero", NotEqual(pkt_ring, 0), pkt_ring, 0)

        // Write a fake MP3 packet: 16 bytes of 0xAA
        payload = Allocate(16)
        i = 0
        WhileLoop LessThan(i, 16) {
            SetByte(payload, i, 170)
            i = Add(i, 1)
        }

        wr = CodecRing_WriteRecord(pkt_ring, payload, 16, 1, 0, 123456789)
        Test_Assert("write record ok", EqualTo(wr, 0), wr, 0)
        Deallocate(payload, 16)

        // Peek header
        out_len   = Allocate(4)
        out_type  = Allocate(4)
        out_flags = Allocate(4)
        out_pts   = Allocate(8)
        total = CodecRing_PeekHeader(pkt_ring, out_len, out_type, out_flags, out_pts)

        Test_Assert("peek returns total > 0", GreaterThan(total, 0), total, 0)

        len   = Dereference(out_len, "dword")
        rtype = Dereference(out_type, "dword")
        pts   = Dereference(out_pts)

        Test_Assert("peek len = 16", EqualTo(len, 16), len, 16)
        Test_Assert("peek type = PACKET", EqualTo(rtype, 1), rtype, 1)
        Test_Assert("peek pts = 123456789", EqualTo(pts, 123456789), pts, 123456789)

        // Consume and verify payload
        read_buf = Allocate(16)
        CodecRing_Consume(pkt_ring, read_buf, 16, total)
        first_byte = GetByte(read_buf, 0)
        last_byte  = GetByte(read_buf, 15)
        Test_Assert("payload byte[0] = 0xAA", EqualTo(first_byte, 170), first_byte, 170)
        Test_Assert("payload byte[15] = 0xAA", EqualTo(last_byte, 170), last_byte, 170)

        Deallocate(read_buf, 16)
        Deallocate(out_len, 4)
        Deallocate(out_type, 4)
        Deallocate(out_flags, 4)
        Deallocate(out_pts, 8)

        // Ring should now be empty
        total2 = CodecRing_PeekHeader(pkt_ring, out_len, out_type, out_flags, out_pts)
        Deallocate(out_len, 4)
        Deallocate(out_type, 4)
        Deallocate(out_flags, 4)
        Deallocate(out_pts, 8)
        Test_Assert("ring empty after consume", EqualTo(total2, 0), total2, 0)

        CodecRing_Destroy(0)
        PrintMessage("  ring destroyed\n")
    }
}

// =============================================================================
// TEST 5: Ring write multiple records, read all back in order
// =============================================================================
Function.Test_RingMulti {
    Body: {
        PrintMessage("\n[Test 5] CodecRing multiple records, PTS ordering\n")

        CodecRing_Create(1)
        pkt_ring = CodecRing_PktRing(1)

        // Write 4 packets with different PTS values
        payload = Allocate(8)
        pts_vals = Allocate(32)
        StoreValue(Add(pts_vals, 0),  100000000)
        StoreValue(Add(pts_vals, 8),  200000000)
        StoreValue(Add(pts_vals, 16), 300000000)
        StoreValue(Add(pts_vals, 24), 400000000)

        i = 0
        WhileLoop LessThan(i, 4) {
            pts = Dereference(Add(pts_vals, Multiply(i, 8)))
            SetByte(payload, 0, Add(65, i))
            CodecRing_WriteRecord(pkt_ring, payload, 8, 1, 0, pts)
            i = Add(i, 1)
        }
        Deallocate(payload, 8)

        // Read all 4 back and verify order
        out_len   = Allocate(4)
        out_type  = Allocate(4)
        out_flags = Allocate(4)
        out_pts   = Allocate(8)
        read_buf  = Allocate(8)
        all_ok = 1

        i = 0
        WhileLoop LessThan(i, 4) {
            total = CodecRing_PeekHeader(pkt_ring, out_len, out_type, out_flags, out_pts)
            pts_got  = Dereference(out_pts)
            pts_want = Dereference(Add(pts_vals, Multiply(i, 8)))
            IfCondition NotEqual(pts_got, pts_want) ThenBlock: {
                all_ok = 0
            }
            len = Dereference(out_len, "dword")
            CodecRing_Consume(pkt_ring, read_buf, len, total)
            i = Add(i, 1)
        }

        Test_Assert("4 records PTS order preserved", EqualTo(all_ok, 1), all_ok, 1)

        Deallocate(out_len, 4)
        Deallocate(out_type, 4)
        Deallocate(out_flags, 4)
        Deallocate(out_pts, 8)
        Deallocate(read_buf, 8)
        Deallocate(pts_vals, 32)
        CodecRing_Destroy(1)
    }
}

// =============================================================================
// TEST 6: MediaSession slot allocation
// =============================================================================
Function.Test_SessionAlloc {
    Body: {
        PrintMessage("\n[Test 6] MediaSession slot allocation\n")

        // AllocSlot should find slot 0
        s0 = MediaSession_AllocSlot()
        Test_Assert("first free slot = 0", EqualTo(s0, 0), s0, 0)

        // Manually mark slot 0 as ACTIVE to test next-slot logic
        entry0 = MediaSession_EntryPtr(0)
        StoreValue(Add(entry0, MSOff.STATE), MSConst.STATE_ACTIVE)

        s1 = MediaSession_AllocSlot()
        Test_Assert("next free slot = 1", EqualTo(s1, 1), s1, 1)

        // Restore
        StoreValue(Add(entry0, MSOff.STATE), MSConst.STATE_IDLE)

        s2 = MediaSession_AllocSlot()
        Test_Assert("slot 0 free again", EqualTo(s2, 0), s2, 0)
    }
}

// =============================================================================
// MAIN
// =============================================================================
SubRoutine.Main {
    Arena_Init()

    PrintMessage("============================================\n")
    PrintMessage("  MediaCenter Clock + Ring Test Suite\n")
    PrintMessage("============================================\n")

    MediaClock_Init()
    MediaSession_Init()

    Test_ClockMonotonic()
    Test_PTSConvert()
    Test_Drift()
    Test_RingBasic()
    Test_RingMulti()
    Test_SessionAlloc()

    MediaClock_Shutdown()

    PrintMessage("\n============================================\n")
    PrintMessage("  Results: ")
    PrintNumber(TestState.passed)
    PrintMessage(" passed, ")
    PrintNumber(TestState.failed)
    PrintMessage(" failed\n")
    PrintMessage("============================================\n")

    IfCondition GreaterThan(TestState.failed, 0) ThenBlock: {
        PrintMessage("  FAIL\n")
    } ElseBlock: {
        PrintMessage("  ALL PASS\n")
    }
}

RunTask(Main)
