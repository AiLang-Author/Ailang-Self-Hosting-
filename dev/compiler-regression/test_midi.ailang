// test_midi.ailang
// MIDI 1.0 + SMF + GM names + patch bay. No ALSA.
//
// Build: ./ailang.x dev/compiler-regression/test_midi.ailang test_midi.x
// Run:   ./test_midi.x

LibraryImport.Arena
LibraryImport.Media.MIDI
LibraryImport.Media.MIDIGM
LibraryImport.Media.MIDIPatch
LibraryImport.Media.MIDIUMP
LibraryImport.Media.MIDIBank
LibraryImport.StringUtils

FixedPool.TestState {
    "passed": Initialize=0, CanChange=True
    "failed": Initialize=0, CanChange=True
}

Function.Test_Pass {
    Input: name: Address
    Body: {
        PrintMessage("  [PASS] ")
        PrintString(name)
        PrintMessage("\n")
        TestState.passed = Add(TestState.passed, 1)
    }
}

Function.Test_Fail {
    Input: name: Address
    Input: got: Integer
    Input: want: Integer
    Body: {
        PrintMessage("  [FAIL] ")
        PrintString(name)
        PrintMessage(" got=")
        PrintNumber(got)
        PrintMessage(" want=")
        PrintNumber(want)
        PrintMessage("\n")
        TestState.failed = Add(TestState.failed, 1)
    }
}

Function.Test_Assert {
    Input: name: Address
    Input: cond: Integer
    Input: got: Integer
    Input: want: Integer
    Body: {
        IfCondition NotEqual(cond, 0) ThenBlock: {
            Test_Pass(name)
        } ElseBlock: {
            Test_Fail(name, got, want)
        }
    }
}

Function.Test_AssertStr {
    Input: name: Address
    Input: got: Address
    Input: want: Address
    Body: {
        IfCondition EqualTo(got, 0) ThenBlock: {
            Test_Fail(name, 0, 1)
            ReturnValue(0)
        }
        n = StringLength(want)
        ok = 1
        i = 0
        WhileLoop LessThan(i, n) {
            a = GetByte(got, i)
            b = GetByte(want, i)
            IfCondition NotEqual(a, b) ThenBlock: { ok = 0 }
            i = Add(i, 1)
        }
        z = GetByte(got, n)
        IfCondition NotEqual(z, 0) ThenBlock: { ok = 0 }
        Test_Assert(name, ok, ok, 1)
        IfCondition EqualTo(ok, 0) ThenBlock: {
            PrintMessage("         gotstr=")
            PrintString(got)
            PrintMessage(" wantstr=")
            PrintString(want)
            PrintMessage("\n")
        }
    }
}

Function.MIDITest_BE16 {
    Input: buf: Address
    Input: off: Integer
    Input: v: Integer
    Body: {
        SetByte(buf, off, Divide(v, 256))
        SetByte(buf, Add(off, 1), Modulo(v, 256))
    }
}

Function.MIDITest_BE32 {
    Input: buf: Address
    Input: off: Integer
    Input: v: Integer
    Body: {
        SetByte(buf, off, Divide(v, 16777216))
        SetByte(buf, Add(off, 1), Modulo(Divide(v, 65536), 256))
        SetByte(buf, Add(off, 2), Modulo(Divide(v, 256), 256))
        SetByte(buf, Add(off, 3), Modulo(v, 256))
    }
}

Function.MIDITest_Hdr {
    Input: buf: Address
    Input: fmt: Integer
    Input: ntrks: Integer
    Input: div: Integer
    Body: {
        SetByte(buf, 0, 77)
        SetByte(buf, 1, 84)
        SetByte(buf, 2, 104)
        SetByte(buf, 3, 100)
        MIDITest_BE32(buf, 4, 6)
        MIDITest_BE16(buf, 8, fmt)
        MIDITest_BE16(buf, 10, ntrks)
        MIDITest_BE16(buf, 12, div)
    }
}

Function.MIDITest_TrkHdr {
    Input: buf: Address
    Input: off: Integer
    Input: clen: Integer
    Body: {
        SetByte(buf, off, 77)
        SetByte(buf, Add(off, 1), 84)
        SetByte(buf, Add(off, 2), 114)
        SetByte(buf, Add(off, 3), 107)
        MIDITest_BE32(buf, Add(off, 4), clen)
    }
}

Function.Test_VLQ {
    Body: {
        PrintMessage("\n[Test] VLQ encode\n")
        buf = Allocate(8)
        n0 = MIDI_WriteVLQ(buf, 0, 0)
        Test_Assert("vlq0 len", EqualTo(n0, 1), n0, 1)
        Test_Assert("vlq0 byte", EqualTo(GetByte(buf, 0), 0), GetByte(buf, 0), 0)
        n1 = MIDI_WriteVLQ(buf, 0, 127)
        Test_Assert("vlq127 len", EqualTo(n1, 1), n1, 1)
        Test_Assert("vlq127 byte", EqualTo(GetByte(buf, 0), 127), GetByte(buf, 0), 127)
        n2 = MIDI_WriteVLQ(buf, 0, 128)
        Test_Assert("vlq128 len", EqualTo(n2, 2), n2, 2)
        Test_Assert("vlq128 b0", EqualTo(GetByte(buf, 0), 129), GetByte(buf, 0), 129)
        Test_Assert("vlq128 b1", EqualTo(GetByte(buf, 1), 0), GetByte(buf, 1), 0)
        n3 = MIDI_WriteVLQ(buf, 0, 240)
        Test_Assert("vlq240 len", EqualTo(n3, 2), n3, 2)
        Test_Assert("vlq240 b0", EqualTo(GetByte(buf, 0), 129), GetByte(buf, 0), 129)
        Test_Assert("vlq240 b1", EqualTo(GetByte(buf, 1), 112), GetByte(buf, 1), 112)
        Deallocate(buf, 8)
    }
}

Function.Test_DataBytes {
    Body: {
        PrintMessage("\n[Test] Channel data lengths\n")
        n = MIDI_DataBytes(144)
        Test_Assert("note on 2", EqualTo(n, 2), n, 2)
        n = MIDI_DataBytes(128)
        Test_Assert("note off 2", EqualTo(n, 2), n, 2)
        n = MIDI_DataBytes(192)
        Test_Assert("program 1", EqualTo(n, 1), n, 1)
        n = MIDI_DataBytes(208)
        Test_Assert("pressure 1", EqualTo(n, 1), n, 1)
        n = MIDI_DataBytes(176)
        Test_Assert("cc 2", EqualTo(n, 2), n, 2)
        n = MIDI_DataBytes(224)
        Test_Assert("bend 2", EqualTo(n, 2), n, 2)
        n = MIDI_DataBytes(248)
        Test_Assert("clock 0", EqualTo(n, 0), n, 0)
        n = MIDI_IsChannelMode(123)
        Test_Assert("all notes off is mode", EqualTo(n, 1), n, 1)
        n = MIDI_IsChannelMode(7)
        Test_Assert("volume not mode", EqualTo(n, 0), n, 0)
    }
}

Function.Test_CmdNames {
    Body: {
        PrintMessage("\n[Test] Status / meta names\n")
        Test_AssertStr("note on name", MIDI_CmdName(144), "Note On")
        Test_AssertStr("cc name", MIDI_CmdName(176), "Control Change")
        Test_AssertStr("clock name", MIDI_CmdName(248), "Clock")
        Test_AssertStr("meta tempo", MIDI_MetaName(81), "Tempo")
        Test_AssertStr("meta eot", MIDI_MetaName(47), "End of Track")
        Test_AssertStr("meta lyric", MIDI_MetaName(5), "Lyric")
        Test_AssertStr("kind channel", MIDI_KindName(1), "channel")
    }
}

Function.Test_BuildSong0 {
    Output: Address
    Body: {
        buf = Allocate(128)
        MemorySet(buf, 0, 128)
        MIDITest_Hdr(buf, 0, 1, 480)
        MIDITest_TrkHdr(buf, 14, 38)
        p = 22
        SetByte(buf, p, 0)
        SetByte(buf, Add(p, 1), 255)
        SetByte(buf, Add(p, 2), 81)
        SetByte(buf, Add(p, 3), 3)
        SetByte(buf, Add(p, 4), 7)
        SetByte(buf, Add(p, 5), 161)
        SetByte(buf, Add(p, 6), 32)
        p = Add(p, 7)
        SetByte(buf, p, 0)
        SetByte(buf, Add(p, 1), 255)
        SetByte(buf, Add(p, 2), 3)
        SetByte(buf, Add(p, 3), 4)
        SetByte(buf, Add(p, 4), 84)
        SetByte(buf, Add(p, 5), 101)
        SetByte(buf, Add(p, 6), 115)
        SetByte(buf, Add(p, 7), 116)
        p = Add(p, 8)
        SetByte(buf, p, 0)
        SetByte(buf, Add(p, 1), 192)
        SetByte(buf, Add(p, 2), 0)
        p = Add(p, 3)
        SetByte(buf, p, 0)
        SetByte(buf, Add(p, 1), 144)
        SetByte(buf, Add(p, 2), 60)
        SetByte(buf, Add(p, 3), 64)
        p = Add(p, 4)
        SetByte(buf, p, 0)
        SetByte(buf, Add(p, 1), 64)
        SetByte(buf, Add(p, 2), 64)
        p = Add(p, 3)
        SetByte(buf, p, 129)
        SetByte(buf, Add(p, 1), 112)
        SetByte(buf, Add(p, 2), 128)
        SetByte(buf, Add(p, 3), 60)
        SetByte(buf, Add(p, 4), 0)
        p = Add(p, 5)
        SetByte(buf, p, 0)
        SetByte(buf, Add(p, 1), 128)
        SetByte(buf, Add(p, 2), 64)
        SetByte(buf, Add(p, 3), 0)
        p = Add(p, 4)
        SetByte(buf, p, 0)
        SetByte(buf, Add(p, 1), 255)
        SetByte(buf, Add(p, 2), 47)
        SetByte(buf, Add(p, 3), 0)
        song = MIDI_SongLoadMem(buf, 60)
        ReturnValue(song)
    }
}

Function.Test_SMF {
    Body: {
        PrintMessage("\n[Test] SMF Type 0 parse\n")
        song = Test_BuildSong0()
        Test_Assert("song non-null", NotEqual(song, 0), song, 1)
        IfCondition EqualTo(song, 0) ThenBlock: { ReturnValue(0) }
        ok = MIDI_SongOk(song)
        Test_Assert("magic ok", EqualTo(ok, 1), ok, 1)
        err = MIDI_SongErr(song)
        Test_Assert("err 0", EqualTo(err, 0), err, 0)
        fmt = MIDI_SongFormat(song)
        Test_Assert("format 0", EqualTo(fmt, 0), fmt, 0)
        ntr = MIDI_SongTracks(song)
        Test_Assert("1 track", EqualTo(ntr, 1), ntr, 1)
        div = MIDI_SongDivision(song)
        Test_Assert("division 480", EqualTo(div, 480), div, 480)
        tempo = MIDI_SongTempo(song)
        Test_Assert("tempo 500000", EqualTo(tempo, 500000), tempo, 500000)
        cnt = MIDI_SongCount(song)
        Test_Assert("event count 8", EqualTo(cnt, 8), cnt, 8)

        ev = MIDI_FindMeta(song, 3, -1)
        Test_Assert("track name present", NotEqual(ev, 0), ev, 1)
        IfCondition NotEqual(ev, 0) ThenBlock: {
            ptr = MIDI_EvPtr(ev)
            Test_AssertStr("track name Test", ptr, "Test")
        }

        ev = MIDI_SongEvent(song, 2)
        Test_Assert("ev2 exists", NotEqual(ev, 0), ev, 1)
        kind = MIDI_EvKind(ev)
        Test_Assert("ev2 channel", EqualTo(kind, 1), kind, 1)
        st = MIDI_EvStatus(ev)
        Test_Assert("ev2 program", EqualTo(st, 192), st, 192)
        d1 = MIDI_EvD1(ev)
        Test_Assert("program 0", EqualTo(d1, 0), d1, 0)

        ev = MIDI_SongEvent(song, 3)
        st = MIDI_EvStatus(ev)
        Test_Assert("ev3 note on", EqualTo(st, 144), st, 144)
        d1 = MIDI_EvD1(ev)
        Test_Assert("note 60", EqualTo(d1, 60), d1, 60)
        d2 = MIDI_EvD2(ev)
        Test_Assert("vel 64", EqualTo(d2, 64), d2, 64)
        tk = MIDI_EvTick(ev)
        Test_Assert("note tick 0", EqualTo(tk, 0), tk, 0)

        ev = MIDI_SongEvent(song, 4)
        st = MIDI_EvStatus(ev)
        Test_Assert("running status note on", EqualTo(st, 144), st, 144)
        d1 = MIDI_EvD1(ev)
        Test_Assert("running note 64", EqualTo(d1, 64), d1, 64)

        ev = MIDI_SongEvent(song, 5)
        st = MIDI_EvStatus(ev)
        Test_Assert("note off status", EqualTo(st, 128), st, 128)
        tk = MIDI_EvTick(ev)
        Test_Assert("note off tick 240", EqualTo(tk, 240), tk, 240)

        us = MIDI_TickToUS(song, 480)
        Test_Assert("480 ticks = 1 beat = 500000us", EqualTo(us, 500000), us, 500000)

        MIDI_SongFree(song)
    }
}

Function.Test_Type1 {
    Body: {
        PrintMessage("\n[Test] SMF Type 1 two tracks\n")
        buf = Allocate(128)
        MemorySet(buf, 0, 128)
        MIDITest_Hdr(buf, 1, 2, 480)
        MIDITest_TrkHdr(buf, 14, 11)
        p = 22
        SetByte(buf, p, 0)
        SetByte(buf, Add(p, 1), 255)
        SetByte(buf, Add(p, 2), 81)
        SetByte(buf, Add(p, 3), 3)
        SetByte(buf, Add(p, 4), 7)
        SetByte(buf, Add(p, 5), 161)
        SetByte(buf, Add(p, 6), 32)
        SetByte(buf, Add(p, 7), 0)
        SetByte(buf, Add(p, 8), 255)
        SetByte(buf, Add(p, 9), 47)
        SetByte(buf, Add(p, 10), 0)
        MIDITest_TrkHdr(buf, 33, 12)
        p = 41
        SetByte(buf, p, 0)
        SetByte(buf, Add(p, 1), 145)
        SetByte(buf, Add(p, 2), 72)
        SetByte(buf, Add(p, 3), 100)
        SetByte(buf, Add(p, 4), 0)
        SetByte(buf, Add(p, 5), 129)
        SetByte(buf, Add(p, 6), 72)
        SetByte(buf, Add(p, 7), 0)
        SetByte(buf, Add(p, 8), 0)
        SetByte(buf, Add(p, 9), 255)
        SetByte(buf, Add(p, 10), 47)
        SetByte(buf, Add(p, 11), 0)
        song = MIDI_SongLoadMem(buf, 53)
        Test_Assert("type1 song", NotEqual(song, 0), song, 1)
        IfCondition EqualTo(song, 0) ThenBlock: { ReturnValue(0) }
        fmt = MIDI_SongFormat(song)
        Test_Assert("format 1", EqualTo(fmt, 1), fmt, 1)
        ntr = MIDI_SongTracks(song)
        Test_Assert("2 tracks seen", EqualTo(ntr, 2), ntr, 2)
        ev = MIDI_SongEvent(song, 2)
        ch = MIDI_EvCh(ev)
        Test_Assert("note on ch 1", EqualTo(ch, 1), ch, 1)
        tr = MIDI_EvTrack(ev)
        Test_Assert("note on track 1", EqualTo(tr, 1), tr, 1)
        prevt = 0
        ord_ok = 1
        zi = 0
        zc = MIDI_SongCount(song)
        WhileLoop LessThan(zi, zc) {
            zev = MIDI_SongEvent(song, zi)
            ztk = MIDI_EvTick(zev)
            IfCondition LessThan(ztk, prevt) ThenBlock: { ord_ok = 0 }
            prevt = ztk
            zi = Add(zi, 1)
        }
        Test_Assert("in-mem type1 sorted", EqualTo(ord_ok, 1), ord_ok, 1)
        MIDI_SongFree(song)
    }
}

Function.Test_Stream {
    Body: {
        PrintMessage("\n[Test] Live stream running status\n")
        MIDI_StreamInit()
        r = MIDI_StreamFeed(144)
        Test_Assert("status incomplete", EqualTo(r, 0), r, 0)
        r = MIDI_StreamFeed(60)
        Test_Assert("note incomplete", EqualTo(r, 0), r, 0)
        r = MIDI_StreamFeed(64)
        Test_Assert("note on complete", EqualTo(r, 1), r, 1)
        Test_Assert("stream kind ch", EqualTo(MIDI_StreamLastKind(), 1), MIDI_StreamLastKind(), 1)
        Test_Assert("stream note 60", EqualTo(MIDI_StreamLastD1(), 60), MIDI_StreamLastD1(), 60)
        Test_Assert("stream vel 64", EqualTo(MIDI_StreamLastD2(), 64), MIDI_StreamLastD2(), 64)
        Test_Assert("stream ch 0", EqualTo(MIDI_StreamLastCh(), 0), MIDI_StreamLastCh(), 0)
        r = MIDI_StreamFeed(64)
        Test_Assert("run d1 incomplete", EqualTo(r, 0), r, 0)
        r = MIDI_StreamFeed(80)
        Test_Assert("run note on", EqualTo(r, 1), r, 1)
        Test_Assert("run note 64", EqualTo(MIDI_StreamLastD1(), 64), MIDI_StreamLastD1(), 64)
        r = MIDI_StreamFeed(248)
        Test_Assert("clock realtime", EqualTo(r, 1), r, 1)
        Test_Assert("clock kind", EqualTo(MIDI_StreamLastKind(), 5), MIDI_StreamLastKind(), 5)
        r = MIDI_StreamFeed(192)
        Test_Assert("pc status", EqualTo(r, 0), r, 0)
        r = MIDI_StreamFeed(56)
        Test_Assert("pc complete", EqualTo(r, 1), r, 1)
        Test_Assert("pc 56", EqualTo(MIDI_StreamLastD1(), 56), MIDI_StreamLastD1(), 56)
        r = MIDI_StreamFeed(240)
        Test_Assert("sysex start", EqualTo(r, 0), r, 0)
        r = MIDI_StreamFeed(67)
        Test_Assert("sysex data", EqualTo(r, 0), r, 0)
        r = MIDI_StreamFeed(247)
        Test_Assert("sysex end", EqualTo(r, 1), r, 1)
        Test_Assert("sysex kind", EqualTo(MIDI_StreamLastKind(), 3), MIDI_StreamLastKind(), 3)
        Test_Assert("sysex len 1", EqualTo(MIDI_StreamLastLen(), 1), MIDI_StreamLastLen(), 1)
    }
}

Function.Test_GM {
    Body: {
        PrintMessage("\n[Test] GM names / CC / drums\n")
        MIDI_GM_Init()
        Test_AssertStr("prog 0 piano", MIDI_GM_ProgramName(0), "Acoustic Grand Piano")
        Test_AssertStr("prog 56 trumpet", MIDI_GM_ProgramName(56), "Trumpet")
        Test_AssertStr("prog 127 gunshot", MIDI_GM_ProgramName(127), "Gunshot")
        Test_AssertStr("family piano", MIDI_GM_FamilyName(0), "Piano")
        Test_AssertStr("family brass", MIDI_GM_FamilyName(56), "Brass")
        Test_AssertStr("cc7 volume", MIDI_GM_CCName(7), "Channel Volume")
        Test_AssertStr("cc64 sustain", MIDI_GM_CCName(64), "Damper Pedal (Sustain)")
        Test_AssertStr("cc123 ano", MIDI_GM_CCName(123), "All Notes Off")
        Test_AssertStr("drum 38 snare", MIDI_GM_DrumName(38), "Acoustic Snare")
        Test_AssertStr("drum 36 kick", MIDI_GM_DrumName(36), "Bass Drum 1")
        Test_AssertStr("rpn bend", MIDI_GM_RPNName(0, 0), "Pitch Bend Sensitivity")
        Test_Assert("ch9 drums", EqualTo(MIDI_GM_IsDrumChannel(9), 1), MIDI_GM_IsDrumChannel(9), 1)
        Test_Assert("ch0 not drums", EqualTo(MIDI_GM_IsDrumChannel(0), 0), MIDI_GM_IsDrumChannel(0), 0)
        empty = MIDI_GM_DrumName(0)
        Test_Assert("unused drum empty", EqualTo(GetByte(empty, 0), 0), GetByte(empty, 0), 0)
    }
}

Function.Test_Bay {
    Body: {
        PrintMessage("\n[Test] Patch bay route / transpose / program\n")
        MIDI_Bay_Init()
        a = MIDI_Bay_AddPort("Player", 3)
        b = MIDI_Bay_AddPort("Synth", 2)
        Test_Assert("port A 0", EqualTo(a, 0), a, 0)
        Test_Assert("port B 1", EqualTo(b, 1), b, 1)
        Test_Assert("2 ports", EqualTo(MIDI_Bay_PortCount(), 2), MIDI_Bay_PortCount(), 2)
        cab = MIDI_Bay_Connect(0, 16, 1, 16)
        Test_Assert("cable 0", EqualTo(cab, 0), cab, 0)
        MIDI_Bay_SetCable(cab, 1, 12, 0)

        song = Test_BuildSong0()
        ev = MIDI_SongEvent(song, 3)
        n = MIDI_Bay_Route(0, ev)
        Test_Assert("routed 1", EqualTo(n, 1), n, 1)
        out = MIDI_Bay_RoutedEvent(0)
        Test_Assert("out exists", NotEqual(out, 0), out, 1)
        note = MIDI_EvD1(out)
        Test_Assert("transpose +12", EqualTo(note, 72), note, 72)
        ch = MIDI_EvCh(out)
        Test_Assert("keep ch 0", EqualTo(ch, 0), ch, 0)

        evpc = MIDI_SongEvent(song, 2)
        MIDI_Bay_Route(0, evpc)
        prog = MIDI_Bay_Program(1, 0)
        Test_Assert("dest program 0", EqualTo(prog, 0), prog, 0)
        Test_AssertStr("dest patch piano", MIDI_Bay_PatchName(1, 0), "Acoustic Grand Piano")
        MIDI_SongFree(song)
    }
}

Function.Test_MetaSysex {
    Body: {
        PrintMessage("\n[Test] Time signature, key, SMF SysEx\n")
        buf = Allocate(64)
        MemorySet(buf, 0, 64)
        MIDITest_Hdr(buf, 0, 1, 480)
        MIDITest_TrkHdr(buf, 14, 24)
        p = 22
        SetByte(buf, p, 0)
        SetByte(buf, Add(p, 1), 255)
        SetByte(buf, Add(p, 2), 88)
        SetByte(buf, Add(p, 3), 4)
        SetByte(buf, Add(p, 4), 4)
        SetByte(buf, Add(p, 5), 2)
        SetByte(buf, Add(p, 6), 24)
        SetByte(buf, Add(p, 7), 8)
        p = Add(p, 8)
        SetByte(buf, p, 0)
        SetByte(buf, Add(p, 1), 255)
        SetByte(buf, Add(p, 2), 89)
        SetByte(buf, Add(p, 3), 2)
        SetByte(buf, Add(p, 4), 0)
        SetByte(buf, Add(p, 5), 0)
        p = Add(p, 6)
        SetByte(buf, p, 0)
        SetByte(buf, Add(p, 1), 240)
        SetByte(buf, Add(p, 2), 3)
        SetByte(buf, Add(p, 3), 67)
        SetByte(buf, Add(p, 4), 0)
        SetByte(buf, Add(p, 5), 247)
        p = Add(p, 6)
        SetByte(buf, p, 0)
        SetByte(buf, Add(p, 1), 255)
        SetByte(buf, Add(p, 2), 47)
        SetByte(buf, Add(p, 3), 0)
        song = MIDI_SongLoadMem(buf, 46)
        Test_Assert("meta song", NotEqual(song, 0), song, 1)
        IfCondition EqualTo(song, 0) ThenBlock: { ReturnValue(0) }
        ev = MIDI_FindMeta(song, 88, -1)
        Test_Assert("timesig present", NotEqual(ev, 0), ev, 1)
        IfCondition NotEqual(ev, 0) ThenBlock: {
            ptr = MIDI_EvPtr(ev)
            Test_Assert("timesig nn=4", EqualTo(GetByte(ptr, 0), 4), GetByte(ptr, 0), 4)
            Test_Assert("timesig dd=2", EqualTo(GetByte(ptr, 1), 2), GetByte(ptr, 1), 2)
        }
        ev = MIDI_FindMeta(song, 89, -1)
        Test_Assert("keysig present", NotEqual(ev, 0), ev, 1)
        ev = MIDI_SongEvent(song, 2)
        Test_Assert("sysex kind", EqualTo(MIDI_EvKind(ev), 3), MIDI_EvKind(ev), 3)
        Test_Assert("sysex len 3", EqualTo(MIDI_EvLen(ev), 3), MIDI_EvLen(ev), 3)
        MIDI_SongFree(song)
    }
}

Function.Test_BankSelect {
    Body: {
        PrintMessage("\n[Test] Bank select + all notes off\n")
        MIDI_Bay_Init()
        IfCondition EqualTo(MIDI_Bay_PortCount(), 0) ThenBlock: {
            MIDI_Bay_AddPort("In", 3)
            MIDI_Bay_AddPort("Out", 2)
            MIDI_Bay_Connect(0, 16, 1, 16)
        }
        ev = Allocate(MIDIEv.SIZE)
        MemorySet(ev, 0, MIDIEv.SIZE)
        SetByte(ev, MIDIEv.KIND, 1)
        SetByte(ev, MIDIEv.STATUS, 176)
        SetByte(ev, MIDIEv.D1, 0)
        SetByte(ev, MIDIEv.D2, 1)
        SetByte(ev, MIDIEv.CH, 0)
        MIDI_Bay_Consume(0, ev)
        Test_Assert("bank msb 1", EqualTo(MIDI_Bay_BankMSB(0, 0), 1), MIDI_Bay_BankMSB(0, 0), 1)
        SetByte(ev, MIDIEv.D1, 32)
        SetByte(ev, MIDIEv.D2, 2)
        MIDI_Bay_Consume(0, ev)
        Test_Assert("bank lsb 2", EqualTo(MIDI_Bay_BankLSB(0, 0), 2), MIDI_Bay_BankLSB(0, 0), 2)
        SetByte(ev, MIDIEv.STATUS, 144)
        SetByte(ev, MIDIEv.D1, 60)
        SetByte(ev, MIDIEv.D2, 100)
        MIDI_Bay_Consume(0, ev)
        SetByte(ev, MIDIEv.STATUS, 176)
        SetByte(ev, MIDIEv.D1, 123)
        SetByte(ev, MIDIEv.D2, 0)
        MIDI_Bay_Consume(0, ev)
        np = MIDI_Bay_NotesPtr(0, 0)
        acc = 0
        i = 0
        WhileLoop LessThan(i, 16) {
            acc = Add(acc, GetByte(np, i))
            i = Add(i, 1)
        }
        Test_Assert("notes cleared", EqualTo(acc, 0), acc, 0)
        Deallocate(ev, MIDIEv.SIZE)
    }
}

Function.Test_WriterRoundtrip {
    Body: {
        PrintMessage("\n[Test] SMF writer round trip\n")
        song = Test_BuildSong0()
        buf = MIDI_SongSaveMem(song)
        n = MIDI_SongSaveLen()
        Test_Assert("save non-null", NotEqual(buf, 0), buf, 1)
        Test_Assert("save len > 20", GreaterThan(n, 20), n, 20)
        IfCondition NotEqual(buf, 0) ThenBlock: {
            mag0 = GetByte(buf, 0)
            Test_Assert("saved MThd M", EqualTo(mag0, 77), mag0, 77)
            loaded = MIDI_SongLoadMem(buf, n)
            Test_Assert("reload song", NotEqual(loaded, 0), loaded, 1)
            IfCondition NotEqual(loaded, 0) ThenBlock: {
                Test_Assert("reload format 0", EqualTo(MIDI_SongFormat(loaded), 0), MIDI_SongFormat(loaded), 0)
                Test_Assert("reload div 480", EqualTo(MIDI_SongDivision(loaded), 480), MIDI_SongDivision(loaded), 480)
                c0 = MIDI_SongCount(song)
                c1 = MIDI_SongCount(loaded)
                Test_Assert("reload count >= orig", GreaterEqual(c1, c0), c1, c0)
                ev = MIDI_SongEvent(loaded, 3)
                Test_Assert("reload note 60", EqualTo(MIDI_EvD1(ev), 60), MIDI_EvD1(ev), 60)
                MIDI_SongFree(loaded)
            }
            nw = MIDI_SongSavePath(song, "/tmp/ailang_midi_saved.mid")
            Test_Assert("savepath bytes", GreaterThan(nw, 20), nw, 20)
            p2 = MIDI_SongLoadPath("/tmp/ailang_midi_saved.mid")
            Test_Assert("savepath reload", NotEqual(p2, 0), p2, 1)
            IfCondition NotEqual(p2, 0) ThenBlock: {
                MIDI_SongFree(p2)
            }
        }
        MIDI_SongFree(song)
    }
}

Function.Test_WriterBuild {
    Body: {
        PrintMessage("\n[Test] Build song + Type 1 save\n")
        song = MIDI_SongNew()
        MIDI_SongSetFormat(song, 1)
        MIDI_SongSetDivision(song, 480)
        tdat = Allocate(3)
        SetByte(tdat, 0, 7)
        SetByte(tdat, 1, 161)
        SetByte(tdat, 2, 32)
        MIDI_SongAddMeta(song, 0, 0, 81, tdat, 3)
        MIDI_SongAddChan(song, 0, 1, 192, 0, 0)
        MIDI_SongAddChan(song, 0, 1, 144, 60, 80)
        MIDI_SongAddChan(song, 480, 1, 128, 60, 0)
        Test_Assert("built tracks 2", EqualTo(MIDI_SongTracks(song), 2), MIDI_SongTracks(song), 2)
        buf = MIDI_SongSaveMem(song)
        n = MIDI_SongSaveLen()
        loaded = MIDI_SongLoadMem(buf, n)
        Test_Assert("type1 reload", NotEqual(loaded, 0), loaded, 1)
        IfCondition NotEqual(loaded, 0) ThenBlock: {
            Test_Assert("type1 format", EqualTo(MIDI_SongFormat(loaded), 1), MIDI_SongFormat(loaded), 1)
            Test_Assert("type1 ntrks 2", EqualTo(MIDI_SongTracks(loaded), 2), MIDI_SongTracks(loaded), 2)
            MIDI_SongFree(loaded)
        }
        Deallocate(tdat, 3)
        MIDI_SongFree(song)
    }
}

Function.Test_UMP {
    Body: {
        PrintMessage("\n[Test] MIDI 2.0 UMP\n")
        Test_Assert("mt2 words 1", EqualTo(MIDI_UMP_WordCount(2), 1), MIDI_UMP_WordCount(2), 1)
        Test_Assert("mt4 words 2", EqualTo(MIDI_UMP_WordCount(4), 2), MIDI_UMP_WordCount(4), 2)
        Test_Assert("mt5 words 4", EqualTo(MIDI_UMP_WordCount(5), 4), MIDI_UMP_WordCount(5), 4)
        Test_Assert("mt D words 4", EqualTo(MIDI_UMP_WordCount(13), 4), MIDI_UMP_WordCount(13), 4)
        w = MIDI_UMP_PackMIDI1(0, 144, 60, 64)
        Test_Assert("ump midi1 note", EqualTo(w, 546323520), w, 546323520)
        MIDI_UMP_DecodeWord0(w)
        Test_Assert("dec mt 2", EqualTo(MIDI_UMP_MT(), 2), MIDI_UMP_MT(), 2)
        Test_Assert("dec st 0x90", EqualTo(MIDI_UMP_Status(), 144), MIDI_UMP_Status(), 144)
        Test_Assert("dec d1 60", EqualTo(MIDI_UMP_D1(), 60), MIDI_UMP_D1(), 60)
        Test_Assert("dec d2 64", EqualTo(MIDI_UMP_D2(), 64), MIDI_UMP_D2(), 64)
        s = MIDI_UMP_Scale7to16(64)
        Test_Assert("scale 64 -> 33026", EqualTo(s, 33026), s, 33026)
        s7 = MIDI_UMP_Scale16to7(33026)
        Test_Assert("scale back 64", EqualTo(s7, 64), s7, 64)
        MIDI_UMP_PackMIDI2Note(0, 1, 0, 60, 64)
        Test_Assert("m2 nwords 2", EqualTo(MIDI_UMP_NWords(), 2), MIDI_UMP_NWords(), 2)
        Test_Assert("m2 mt 4", EqualTo(MIDI_UMP_MT(), 4), MIDI_UMP_MT(), 4)
        Test_Assert("m2 vel16", EqualTo(MIDI_UMP_Vel16(), 33026), MIDI_UMP_Vel16(), 33026)
        MIDI_UMP_ToMIDI1()
        Test_Assert("m2 down vel7", EqualTo(MIDI_UMP_D2(), 64), MIDI_UMP_D2(), 64)
        MIDI_UMP_StreamInit()
        r = MIDI_UMP_StreamFeed(w)
        Test_Assert("stream 1word complete", EqualTo(r, 1), r, 1)
        MIDI_UMP_PackMIDI2Note(1, 1, 3, 72, 100)
        r = MIDI_UMP_StreamFeed(MIDI_UMP_W0())
        Test_Assert("stream m2 first", EqualTo(r, 0), r, 0)
        r = MIDI_UMP_StreamFeed(MIDI_UMP_W1())
        Test_Assert("stream m2 complete", EqualTo(r, 1), r, 1)
        Test_Assert("stream m2 mt4", EqualTo(MIDI_UMP_MT(), 4), MIDI_UMP_MT(), 4)
        syx = Allocate(3)
        SetByte(syx, 0, 126)
        SetByte(syx, 1, 127)
        SetByte(syx, 2, 9)
        MIDI_UMP_PackSysex7(0, 0, syx, 3)
        Test_Assert("syx7 mt 3", EqualTo(MIDI_UMP_MT(), 3), MIDI_UMP_MT(), 3)
        Test_Assert("syx7 words 2", EqualTo(MIDI_UMP_NWords(), 2), MIDI_UMP_NWords(), 2)
        Deallocate(syx, 3)
        clk = MIDI_UMP_PackSystem(0, 248, 0, 0)
        MIDI_UMP_DecodeWord0(clk)
        Test_Assert("clock mt 1", EqualTo(MIDI_UMP_MT(), 1), MIDI_UMP_MT(), 1)
        Test_Assert("clock st F8", EqualTo(MIDI_UMP_Status(), 248), MIDI_UMP_Status(), 248)
    }
}

Function.Test_Banks {
    Body: {
        PrintMessage("\n[Test] GS / XG bank names\n")
        MIDI_Bank_Init()
        Test_AssertStr("GM piano via bank", MIDI_Bank_PatchName(0, 0, 0), "Acoustic Grand Piano")
        Test_AssertStr("GS Piano 1w", MIDI_Bank_GSName(8, 0), "Piano 1w")
        Test_AssertStr("GS 12-str", MIDI_Bank_GSName(8, 25), "12-str. Gt")
        Test_AssertStr("GS kit ROOM", MIDI_Bank_GSKitName(8), "ROOM")
        Test_AssertStr("XG mellow grand", MIDI_Bank_XGName(0, 18, 0), "Mellow Grand Piano")
        Test_AssertStr("XG DX Legend", MIDI_Bank_XGName(0, 34, 5), "DX Legend")
        Test_AssertStr("XG SFX Door", MIDI_Bank_PatchName(64, 0, 113), "Door")
        Test_AssertStr("XG Rock Kit", MIDI_Bank_XGKitName(127, 16), "Rock Kit")
        Test_AssertStr("patch GS via msb", MIDI_Bank_PatchName(8, 0, 0), "Piano 1w")
        Test_AssertStr("patch XG via lsb", MIDI_Bank_PatchName(0, 18, 0), "Mellow Grand Piano")
    }
}

Function.Test_Fixtures {
    Body: {
        PrintMessage("\n[Test] Fixture files in tests/midi\n")
        s = MIDI_SongLoadPath("tests/midi/type0_cmaj.mid")
        Test_Assert("fix type0", NotEqual(s, 0), s, 1)
        IfCondition NotEqual(s, 0) ThenBlock: {
            Test_Assert("fix type0 fmt", EqualTo(MIDI_SongFormat(s), 0), MIDI_SongFormat(s), 0)
            nm = MIDI_FindMeta(s, 3, -1)
            Test_Assert("fix C Major name", NotEqual(nm, 0), nm, 1)
            IfCondition NotEqual(nm, 0) ThenBlock: {
                Test_AssertStr("fix name C Major", MIDI_EvPtr(nm), "C Major")
            }
            MIDI_SongFree(s)
        }
        s = MIDI_SongLoadPath("tests/midi/type1_piano_bass.mid")
        Test_Assert("fix type1", NotEqual(s, 0), s, 1)
        IfCondition NotEqual(s, 0) ThenBlock: {
            Test_Assert("fix type1 fmt", EqualTo(MIDI_SongFormat(s), 1), MIDI_SongFormat(s), 1)
            Test_Assert("fix type1 3 trk", EqualTo(MIDI_SongTracks(s), 3), MIDI_SongTracks(s), 3)
            prev = 0
            ok_ord = 1
            ii = 0
            n1 = MIDI_SongCount(s)
            WhileLoop LessThan(ii, n1) {
                ev1 = MIDI_SongEvent(s, ii)
                tk1 = MIDI_EvTick(ev1)
                IfCondition LessThan(tk1, prev) ThenBlock: { ok_ord = 0 }
                prev = tk1
                ii = Add(ii, 1)
            }
            Test_Assert("type1 ticks sorted", EqualTo(ok_ord, 1), ok_ord, 1)
            MIDI_SongFree(s)
        }
        s = MIDI_SongLoadPath("tests/midi/running_status.mid")
        Test_Assert("fix running", NotEqual(s, 0), s, 1)
        IfCondition NotEqual(s, 0) ThenBlock: {
            Test_Assert("fix run notes >=3", GreaterEqual(MIDI_SongCount(s), 3), MIDI_SongCount(s), 3)
            MIDI_SongFree(s)
        }
        s = MIDI_SongLoadPath("tests/midi/all_meta.mid")
        Test_Assert("fix meta", NotEqual(s, 0), s, 1)
        IfCondition NotEqual(s, 0) ThenBlock: {
            Test_Assert("fix lyric", NotEqual(MIDI_FindMeta(s, 5, -1), 0), 1, 1)
            Test_Assert("fix timesig", NotEqual(MIDI_FindMeta(s, 88, -1), 0), 1, 1)
            Test_Assert("fix keysig", NotEqual(MIDI_FindMeta(s, 89, -1), 0), 1, 1)
            MIDI_SongFree(s)
        }
        s = MIDI_SongLoadPath("tests/midi/gs_piano1w.mid")
        Test_Assert("fix gs", NotEqual(s, 0), s, 1)
        IfCondition NotEqual(s, 0) ThenBlock: {
            MIDI_SongFree(s)
        }
        s = MIDI_SongLoadPath("tests/midi/xg_mellow_grand.mid")
        Test_Assert("fix xg", NotEqual(s, 0), s, 1)
        IfCondition NotEqual(s, 0) ThenBlock: {
            MIDI_SongFree(s)
        }
        s = MIDI_SongLoadPath("tests/midi/sysex_gm_on.mid")
        Test_Assert("fix sysex", NotEqual(s, 0), s, 1)
        IfCondition NotEqual(s, 0) ThenBlock: {
            ev = MIDI_SongEvent(s, 0)
            Test_Assert("fix sysex kind", EqualTo(MIDI_EvKind(ev), 3), MIDI_EvKind(ev), 3)
            MIDI_SongFree(s)
        }
        s = MIDI_SongLoadPath("tests/midi/smpte_division.mid")
        Test_Assert("fix smpte", NotEqual(s, 0), s, 1)
        IfCondition NotEqual(s, 0) ThenBlock: {
            Test_Assert("fix smpte flag", EqualTo(MIDI_SongIsSMPTE(s), 1), MIDI_SongIsSMPTE(s), 1)
            MIDI_SongFree(s)
        }
        s = MIDI_SongLoadPath("tests/midi/tempo_only.mid")
        Test_Assert("fix tempo file", NotEqual(s, 0), s, 1)
        IfCondition NotEqual(s, 0) ThenBlock: {
            MIDI_SongFree(s)
        }
    }
}

Function.Test_LoadPath {
    Body: {
        PrintMessage("\n[Test] LoadPath round trip\n")
        song = Test_BuildSong0()
        IfCondition EqualTo(song, 0) ThenBlock: { ReturnValue(0) }
        src = Dereference(Add(song, MIDIOff.SRC))
        slen = Dereference(Add(song, MIDIOff.SRCLEN))
        fd = SystemCall(2, "/tmp/ailang_midi_test.mid", 577, 420)
        Test_Assert("open tmp", GreaterEqual(fd, 0), fd, 0)
        IfCondition GreaterEqual(fd, 0) ThenBlock: {
            SystemCall(1, fd, src, slen)
            SystemCall(3, fd)
            loaded = MIDI_SongLoadPath("/tmp/ailang_midi_test.mid")
            Test_Assert("loadpath song", NotEqual(loaded, 0), loaded, 1)
            IfCondition NotEqual(loaded, 0) ThenBlock: {
                Test_Assert("loadpath count", EqualTo(MIDI_SongCount(loaded), MIDI_SongCount(song)), MIDI_SongCount(loaded), MIDI_SongCount(song))
                MIDI_SongFree(loaded)
            }
        }
        MIDI_SongFree(song)
    }
}

SubRoutine.Main {
    Arena_Init()
    PrintMessage("============================================\n")
    PrintMessage("  AILANG MIDI library test\n")
    PrintMessage("============================================\n")
    Test_VLQ()
    Test_DataBytes()
    Test_CmdNames()
    Test_SMF()
    Test_Type1()
    Test_Stream()
    Test_GM()
    Test_Bay()
    Test_MetaSysex()
    Test_BankSelect()
    Test_WriterRoundtrip()
    Test_WriterBuild()
    Test_UMP()
    Test_Banks()
    Test_Fixtures()
    Test_LoadPath()
    PrintMessage("\n============================================\n")
    PrintMessage("  Results: ")
    PrintNumber(TestState.passed)
    PrintMessage(" passed, ")
    PrintNumber(TestState.failed)
    PrintMessage(" failed\n")
    PrintMessage("============================================\n")
    IfCondition GreaterThan(TestState.failed, 0) ThenBlock: {
        PrintMessage("  FAIL\n")
    } ElseBlock: {
        PrintMessage("  ALL PASS\n")
    }
}

RunTask(Main)
