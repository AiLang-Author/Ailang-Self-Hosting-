// Load a Type-1 song and prove events are tick-sorted.
// Build: ./ailang.x dev/compiler-regression/test_midi_large.ailang /tmp/test_midi_large.x

LibraryImport.Arena
LibraryImport.Media.MIDI

SubRoutine.Main {
    Arena_Init()
    path = "/home/bob/Downloads/1943BossWin.mid"
    PrintMessage("load ")
    PrintString(path)
    PrintMessage("\n")
    song = MIDI_SongLoadPath(path)
    IfCondition EqualTo(song, 0) ThenBlock: {
        PrintMessage("FAIL load\n")
        ReturnValue(0)
    }
    cnt = MIDI_SongCount(song)
    fmt = MIDI_SongFormat(song)
    ntr = MIDI_SongTracks(song)
    err = MIDI_SongErr(song)
    PrintMessage("format=")
    PrintNumber(fmt)
    PrintMessage(" tracks=")
    PrintNumber(ntr)
    PrintMessage(" events=")
    PrintNumber(cnt)
    PrintMessage(" err=")
    PrintNumber(err)
    PrintMessage("\n")
    prev = 0
    drops = 0
    last = 0
    i = 0
    WhileLoop LessThan(i, cnt) {
        ev = MIDI_SongEvent(song, i)
        tk = MIDI_EvTick(ev)
        IfCondition LessThan(tk, prev) ThenBlock: { drops = Add(drops, 1) }
        prev = tk
        last = tk
        i = Add(i, 1)
    }
    us = MIDI_TickToUS(song, last)
    PrintMessage("last_tick=")
    PrintNumber(last)
    PrintMessage(" us=")
    PrintNumber(us)
    PrintMessage(" drops=")
    PrintNumber(drops)
    PrintMessage("\n")
    IfCondition EqualTo(drops, 0) ThenBlock: {
        PrintMessage("SORTED OK\n")
    } ElseBlock: {
        PrintMessage("FAIL unsorted\n")
    }
    MIDI_SongFree(song)
}

RunTask(Main)
