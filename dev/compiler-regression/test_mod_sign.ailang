// Power-of-two Modulo. IDIV remainder of -5 / 4 is -1.
// AND with 3 yields 3.

LibraryImport.Arena

FixedPool.ModCheck {
    "fails": Initialize=0, CanChange=True
}

Function.Expect {
    Input: got: Integer
    Input: want: Integer
    Body: {
        IfCondition NotEqual(got, want) ThenBlock: {
            PrintMessage("FAIL got ")
            PrintNumber(got)
            PrintMessage(" want ")
            PrintNumber(want)
            PrintMessage("\n")
            ModCheck.fails = Add(ModCheck.fails, 1)
        }
    }
}

Function.Mod4 {
    Input: n: Integer
    Output: Integer
    Body: {
        ReturnValue(Modulo(n, 4))
    }
}

Function.Mod3 {
    Input: n: Integer
    Output: Integer
    Body: {
        ReturnValue(Modulo(n, 3))
    }
}

Function.Mod2p32 {
    Input: n: Integer
    Output: Integer
    Body: {
        ReturnValue(Modulo(n, 4294967296))
    }
}

Function.Mod2p33 {
    Input: n: Integer
    Output: Integer
    Body: {
        ReturnValue(Modulo(n, 8589934592))
    }
}

Function.Mod2p31 {
    Input: n: Integer
    Output: Integer
    Body: {
        ReturnValue(Modulo(n, 2147483648))
    }
}

SubRoutine.Main {
    Expect(Mod4(5), 1)
    Expect(Mod4(Negate(5)), Negate(1))
    Expect(Mod4(Negate(4)), 0)
    Expect(Mod4(Negate(1)), Negate(1))
    Expect(Mod3(Negate(5)), Negate(2))
    Expect(Mod2p31(2147483651), 3)
    Expect(Mod2p32(4294967301), 5)
    Expect(Mod2p32(5), 5)
    Expect(Mod2p33(12884901895), 4294967303)
    PrintMessage("fails ")
    PrintNumber(ModCheck.fails)
    PrintMessage("\n")
    ProcessExit(ModCheck.fails)
}

RunTask(Main)
