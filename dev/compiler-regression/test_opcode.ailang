LibraryImport.Arena
LibraryImport.Media.Opcode

SubRoutine.Main {
    Arena_Init()
    n = Opcode_LoadJson("/home/bob/Ailang-Self-Hosting-/Librarys/Media/opcode16.json")
    PrintMessage("loaded=")
    PrintNumber(n)
    PrintMessage("\n")
    fl = Opcode_Find("flute")
    PrintMessage("flute=")
    PrintNumber(fl)
    PrintMessage("\n")
    IfCondition NotEqual(fl, 32896) ThenBlock: {
        PrintMessage("FAIL flute id want 0x8080\n")
        ReturnValue(1)
    }
    oc = Opcode_FromGM(79)
    PrintMessage("gm79=")
    PrintNumber(oc)
    PrintMessage("\n")
    IfCondition NotEqual(oc, fl) ThenBlock: {
        IfCondition NotEqual(oc, Opcode_Find("ocarina")) ThenBlock: {
            PrintMessage("FAIL gm 79 ocarina\n")
            ReturnValue(1)
        }
    }
    ca = Opcode_FromGM(82)
    PrintMessage("gm82 calliope=")
    PrintNumber(ca)
    PrintMessage("\n")
    IfCondition EqualTo(ca, 0) ThenBlock: {
        PrintMessage("FAIL calliope unmapped\n")
        ReturnValue(1)
    }
    miss = Opcode_FromGM(4)
    PrintMessage("gm4 (unmapped)=")
    PrintNumber(miss)
    PrintMessage("\n")
    IfCondition NotEqual(miss, 0) ThenBlock: {
        PrintMessage("FAIL unmapped gm should be 0\n")
        ReturnValue(1)
    }
    kit = Opcode_Find("kit_standard")
    PrintMessage("kit_standard=")
    PrintNumber(kit)
    PrintMessage("\n")
    IfCondition EqualTo(kit, 0) ThenBlock: {
        PrintMessage("FAIL kit_standard\n")
        ReturnValue(1)
    }
    PrintMessage("PASS opcode16 json\n")
}

RunTask(Main)
