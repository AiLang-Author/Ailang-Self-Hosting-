// test_plex.ailang
// Exercise Library.Plex: alloc, data slots, ring ops, traversal, classification.

LibraryImport.Arena
LibraryImport.Plex

SubRoutine.Main {
    Arena_Init()
    Plex.Init()

    PrintMessage("=== Plex Library Tests ===\n\n")

    // ---------------------------------------------------------------
    // TEST 1: Alloc + type + data slots
    // ---------------------------------------------------------------
    PrintMessage("TEST 1: Alloc / Type / Data Slots\n")
    a = Plex.Alloc(10)
    b = Plex.Alloc(20)
    c = Plex.Alloc(10)
    PrintMessage("  a=")
    PrintNumber(a)
    PrintMessage(" b=")
    PrintNumber(b)
    PrintMessage(" c=")
    PrintNumber(c)
    PrintMessage("\n")
    PrintMessage("  type(a)=")
    PrintNumber(Plex.Type(a))
    PrintMessage(" type(b)=")
    PrintNumber(Plex.Type(b))
    PrintMessage("\n")

    Plex.Set(a, 0, 100)
    Plex.Set(a, 1, 200)
    Plex.Set(b, 0, 300)
    PrintMessage("  a[0]=")
    PrintNumber(Plex.Get(a, 0))
    PrintMessage(" a[1]=")
    PrintNumber(Plex.Get(a, 1))
    PrintMessage(" b[0]=")
    PrintNumber(Plex.Get(b, 0))
    PrintMessage("\n")

    IfCondition EqualTo(Plex.Get(a, 0), 100) ThenBlock: { PrintMessage("  PASS: data read/write\n") }

    // ---------------------------------------------------------------
    // TEST 2: Ring singleton + insert
    // ---------------------------------------------------------------
    PrintMessage("\nTEST 2: Ring Insert\n")
    Plex.RingSingleton(a, 0)
    PrintMessage("  a alone in ring 0? ")
    PrintNumber(Plex.RingAlone(a, 0))
    PrintMessage(" (expected 1)\n")

    Plex.RingInsertAfter(a, b, 0)
    PrintMessage("  after insert b after a:\n")
    PrintMessage("    a->next=")
    PrintNumber(Plex.RingNext(a, 0))
    PrintMessage(" (expected ")
    PrintNumber(b)
    PrintMessage(")\n")
    PrintMessage("    b->next=")
    PrintNumber(Plex.RingNext(b, 0))
    PrintMessage(" (expected ")
    PrintNumber(a)
    PrintMessage(")\n")

    Plex.RingInsertAfter(b, c, 0)
    PrintMessage("  after insert c after b: a->b->c->a\n")
    PrintMessage("    ring count=")
    PrintNumber(Plex.RingCount(a, 0))
    PrintMessage(" (expected 3)\n")
    Plex.DumpRing(a, 0)

    // ---------------------------------------------------------------
    // TEST 3: Ring unlink
    // ---------------------------------------------------------------
    PrintMessage("\nTEST 3: Ring Unlink\n")
    Plex.RingUnlink(b, 0)
    PrintMessage("  after unlink b: ring count=")
    PrintNumber(Plex.RingCount(a, 0))
    PrintMessage(" (expected 2)\n")
    PrintMessage("  b in ring 0? ")
    PrintNumber(Plex.RingIn(b, 0))
    PrintMessage(" (expected 0)\n")
    Plex.DumpRing(a, 0)

    Plex.RingInsertAfter(a, b, 0)
    PrintMessage("  re-inserted b: count=")
    PrintNumber(Plex.RingCount(a, 0))
    PrintMessage(" (expected 3)\n")

    // ---------------------------------------------------------------
    // TEST 4: Multiple rings simultaneously
    // ---------------------------------------------------------------
    PrintMessage("\nTEST 4: Multiple Rings\n")
    Plex.RingSingleton(a, 1)
    Plex.RingInsertAfter(a, c, 1)
    PrintMessage("  ring 0 count=")
    PrintNumber(Plex.RingCount(a, 0))
    PrintMessage(" (expected 3)\n")
    PrintMessage("  ring 1 count=")
    PrintNumber(Plex.RingCount(a, 1))
    PrintMessage(" (expected 2, a+c only)\n")
    PrintMessage("  b in ring 1? ")
    PrintNumber(Plex.RingIn(b, 1))
    PrintMessage(" (expected 0)\n")

    // ---------------------------------------------------------------
    // TEST 5: RingCollect
    // ---------------------------------------------------------------
    PrintMessage("\nTEST 5: RingCollect\n")
    buf = Allocate(64)
    n = Plex.RingCollect(a, 0, buf, 64)
    PrintMessage("  collected ")
    PrintNumber(n)
    PrintMessage(" nodes from ring 0:")
    i = 0
    WhileLoop LessThan(i, n) {
        PrintMessage(" ")
        PrintNumber(ArrayGet(buf, i))
        i = Add(i, 1)
    }
    PrintMessage("\n")

    // ---------------------------------------------------------------
    // TEST 6: Classification predicates
    // ---------------------------------------------------------------
    PrintMessage("\nTEST 6: Classification Predicates\n")
    PrintMessage("  all same type in ring 0? ")
    PrintNumber(Plex.RingAllSameType(a, 0))
    PrintMessage(" (expected 0, a=10 b=20 c=10)\n")

    PrintMessage("  all same type in ring 1? ")
    PrintNumber(Plex.RingAllSameType(a, 1))
    PrintMessage(" (expected 1, a=10 c=10)\n")

    Plex.Set(a, 3, 42)
    Plex.Set(b, 3, 42)
    Plex.Set(c, 3, 42)
    PrintMessage("  all slot[3]==42 in ring 0? ")
    PrintNumber(Plex.RingAllSlotEqual(a, 0, 3, 42))
    PrintMessage(" (expected 1)\n")

    Plex.Set(b, 3, 99)
    PrintMessage("  all slot[3]==42 after b=99? ")
    PrintNumber(Plex.RingAllSlotEqual(a, 0, 3, 42))
    PrintMessage(" (expected 0)\n")

    PrintMessage("  any slot[3]==99 in ring 0? ")
    PrintNumber(Plex.RingAnySlotEqual(a, 0, 3, 99))
    PrintMessage(" (expected 1)\n")

    PrintMessage("  count type=10 in ring 0: ")
    PrintNumber(Plex.RingCountType(a, 0, 10))
    PrintMessage(" (expected 2)\n")

    PrintMessage("  count type=20 in ring 0: ")
    PrintNumber(Plex.RingCountType(a, 0, 20))
    PrintMessage(" (expected 1)\n")

    // ---------------------------------------------------------------
    // TEST 7: Find
    // ---------------------------------------------------------------
    PrintMessage("\nTEST 7: RingFindType / RingFindSlot\n")
    found = Plex.RingFindType(a, 0, 20)
    PrintMessage("  find type=20: node=")
    PrintNumber(found)
    PrintMessage(" (expected ")
    PrintNumber(b)
    PrintMessage(")\n")

    found2 = Plex.RingFindSlot(a, 0, 3, 99)
    PrintMessage("  find slot[3]==99: node=")
    PrintNumber(found2)
    PrintMessage(" (expected ")
    PrintNumber(b)
    PrintMessage(")\n")

    // ---------------------------------------------------------------
    // TEST 8: InsertBefore
    // ---------------------------------------------------------------
    PrintMessage("\nTEST 8: InsertBefore\n")
    d = Plex.Alloc(30)
    Plex.RingInsertBefore(a, d, 0)
    PrintMessage("  insert d before a: prev(a)=")
    PrintNumber(Plex.RingPrev(a, 0))
    PrintMessage(" (expected ")
    PrintNumber(d)
    PrintMessage(")\n")
    PrintMessage("  ring 0 count=")
    PrintNumber(Plex.RingCount(a, 0))
    PrintMessage(" (expected 4)\n")
    Plex.DumpRing(a, 0)

    // ---------------------------------------------------------------
    // TEST 9: Free + re-alloc
    // ---------------------------------------------------------------
    PrintMessage("\nTEST 9: Free and Re-alloc\n")
    Plex.Free(d)
    PrintMessage("  freed d, ring 0 count=")
    PrintNumber(Plex.RingCount(a, 0))
    PrintMessage(" (expected 3)\n")
    PrintMessage("  d live? ")
    PrintNumber(Plex.IsLive(d))
    PrintMessage(" (expected 0)\n")

    e = Plex.Alloc(50)
    PrintMessage("  re-alloc e=")
    PrintNumber(e)
    PrintMessage(" type=")
    PrintNumber(Plex.Type(e))
    PrintMessage(" (expected 50, should reuse slot)\n")

    // ---------------------------------------------------------------
    // TEST 10: Larger ring — simulate edge classification
    // ---------------------------------------------------------------
    PrintMessage("\nTEST 10: Edge Classification Simulation\n")
    PrintMessage("  Building 6-edge ring (4 LINE=1, 2 CIRC=2)...\n")

    e0 = Plex.Alloc(1)
    e1 = Plex.Alloc(1)
    e2 = Plex.Alloc(2)
    e3 = Plex.Alloc(1)
    e4 = Plex.Alloc(1)
    e5 = Plex.Alloc(2)

    Plex.Set(e0, 0, 100)
    Plex.Set(e1, 0, 101)
    Plex.Set(e2, 0, 102)
    Plex.Set(e3, 0, 103)
    Plex.Set(e4, 0, 104)
    Plex.Set(e5, 0, 105)

    Plex.RingSingleton(e0, 0)
    Plex.RingInsertAfter(e0, e1, 0)
    Plex.RingInsertAfter(e1, e2, 0)
    Plex.RingInsertAfter(e2, e3, 0)
    Plex.RingInsertAfter(e3, e4, 0)
    Plex.RingInsertAfter(e4, e5, 0)

    PrintMessage("  ring count=")
    PrintNumber(Plex.RingCount(e0, 0))
    PrintMessage(" (expected 6)\n")

    nLine = Plex.RingCountType(e0, 0, 1)
    nCirc = Plex.RingCountType(e0, 0, 2)
    PrintMessage("  LINE=")
    PrintNumber(nLine)
    PrintMessage(" CIRC=")
    PrintNumber(nCirc)
    PrintMessage("\n")

    allLine = Plex.RingAllSameType(e0, 0)
    PrintMessage("  all same type? ")
    PrintNumber(allLine)
    PrintMessage(" (expected 0 — mixed)\n")

    IfCondition EqualTo(allLine, 0) ThenBlock: {
        IfCondition GreaterThan(nCirc, 0) ThenBlock: {
            PrintMessage("  -> classify: MIXED coplanar, use EmitChain\n")
        }
    }
    IfCondition EqualTo(allLine, 1) ThenBlock: {
        PrintMessage("  -> classify: ALL-LINE coplanar, use Sequential\n")
    }

    Plex.DumpRing(e0, 0)

    // ---------------------------------------------------------------
    // DONE
    // ---------------------------------------------------------------
    PrintMessage("\n=== Plex Tests Complete ===\n")
    Plex.Stats()
    Exit(0)
}

RunTask(Main)
