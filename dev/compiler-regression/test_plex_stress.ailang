// test_plex_stress.ailang
// Brutal stress test for Library.Plex — alloc/free churn, large rings,
// cross-ring membership, ring surgery under load, leak detection.

LibraryImport.Arena
LibraryImport.Plex

Function.StressAllocFree {
    Input: rounds: Integer
    Output: Integer
    Body: {
        PrintMessage("STRESS 1: Alloc/Free churn (")
        PrintNumber(rounds)
        PrintMessage(" rounds x 100 nodes)\n")
        buf = Allocate(128)
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        r = 0
        leaked = 0
        WhileLoop LessThan(r, rounds) {
            i = 0
            WhileLoop LessThan(i, 100) {
                n = Plex.Alloc(Add(1, Modulo(i, 10)))
                IfCondition EqualTo(n, 0) ThenBlock: {
                    PrintMessage("  FAIL: alloc returned 0 at round=")
                    PrintNumber(r)
                    PrintMessage(" i=")
                    PrintNumber(i)
                    PrintMessage("\n")
                    ReturnValue(0)
                }
                Plex.Set(n, 0, r)
                Plex.Set(n, 1, i)
                Plex.Set(n, 15, 0xDEAD)
                ArraySet(buf, i, n)
                i = Add(i, 1)
            }
            i = 0
            WhileLoop LessThan(i, 100) {
                n = ArrayGet(buf, i)
                IfCondition NotEqual(Plex.Get(n, 15), 0xDEAD) ThenBlock: {
                    PrintMessage("  FAIL: data corruption at round=")
                    PrintNumber(r)
                    PrintMessage(" i=")
                    PrintNumber(i)
                    PrintMessage("\n")
                    leaked = Add(leaked, 1)
                }
                Plex.Free(n)
                i = Add(i, 1)
            }
            r = Add(r, 1)
        }
        PrintMessage("  done. leaked=")
        PrintNumber(leaked)
        PrintMessage("\n")
        Plex.Stats()
        ReturnValue(1)
    }
}

Function.StressLargeRing {
    Input: size: Integer
    Output: Integer
    Body: {
        PrintMessage("STRESS 2: Large ring (")
        PrintNumber(size)
        PrintMessage(" nodes)\n")
        head = Plex.Alloc(1)
        Plex.RingSingleton(head, 0)
        Plex.Set(head, 0, 0)
        prev = head
        i = 1
        WhileLoop LessThan(i, size) {
            n = Plex.Alloc(Add(1, Modulo(i, 5)))
            IfCondition EqualTo(n, 0) ThenBlock: {
                PrintMessage("  FAIL: alloc at i=")
                PrintNumber(i)
                PrintMessage("\n")
                ReturnValue(0)
            }
            Plex.Set(n, 0, i)
            Plex.RingInsertAfter(prev, n, 0)
            prev = n
            i = Add(i, 1)
        }
        cnt = Plex.RingCount(head, 0)
        PrintMessage("  built ring count=")
        PrintNumber(cnt)
        IfCondition EqualTo(cnt, size) ThenBlock: { PrintMessage(" OK\n") }
        IfCondition NotEqual(cnt, size) ThenBlock: {
            PrintMessage(" FAIL expected=")
            PrintNumber(size)
            PrintMessage("\n")
        }

        t1 = Plex.RingCountType(head, 0, 1)
        t2 = Plex.RingCountType(head, 0, 2)
        t3 = Plex.RingCountType(head, 0, 3)
        PrintMessage("  type1=")
        PrintNumber(t1)
        PrintMessage(" type2=")
        PrintNumber(t2)
        PrintMessage(" type3=")
        PrintNumber(t3)
        PrintMessage("\n")

        PrintMessage("  walking full ring to verify integrity...")
        cur = Plex.RingNext(head, 0)
        steps = 1
        ok = 1
        WhileLoop NotEqual(cur, head) {
            IfCondition EqualTo(cur, 0) ThenBlock: {
                PrintMessage(" BROKEN at step=")
                PrintNumber(steps)
                PrintMessage("\n")
                ok = 0
                cur = head
            }
            IfCondition NotEqual(cur, 0) ThenBlock: {
                IfCondition NotEqual(cur, head) ThenBlock: {
                    steps = Add(steps, 1)
                    cur = Plex.RingNext(cur, 0)
                }
            }
        }
        IfCondition EqualTo(ok, 1) ThenBlock: {
            PrintMessage(" OK steps=")
            PrintNumber(steps)
            PrintMessage("\n")
        }

        PrintMessage("  reverse walk...")
        cur = Plex.RingPrev(head, 0)
        steps = 1
        ok = 1
        WhileLoop NotEqual(cur, head) {
            IfCondition EqualTo(cur, 0) ThenBlock: {
                ok = 0
                cur = head
            }
            IfCondition NotEqual(cur, 0) ThenBlock: {
                IfCondition NotEqual(cur, head) ThenBlock: {
                    steps = Add(steps, 1)
                    cur = Plex.RingPrev(cur, 0)
                }
            }
        }
        IfCondition EqualTo(ok, 1) ThenBlock: {
            PrintMessage(" OK steps=")
            PrintNumber(steps)
            PrintMessage("\n")
        }
        IfCondition EqualTo(ok, 0) ThenBlock: {
            PrintMessage(" BROKEN\n")
        }

        PrintMessage("  unlink every other node...")
        cur = head
        removed = 0
        i = 0
        kills = Allocate(Multiply(2, size))
        WhileLoop LessThan(i, size) {
            nx = Plex.RingNext(cur, 0)
            IfCondition EqualTo(Modulo(i, 2), 1) ThenBlock: {
                ArraySet(kills, removed, cur)
                removed = Add(removed, 1)
            }
            cur = nx
            IfCondition EqualTo(cur, head) ThenBlock: { i = size }
            IfCondition NotEqual(cur, head) ThenBlock: { i = Add(i, 1) }
        }
        i = 0
        WhileLoop LessThan(i, removed) {
            Plex.RingUnlink(ArrayGet(kills, i), 0)
            i = Add(i, 1)
        }
        cnt2 = Plex.RingCount(head, 0)
        PrintMessage("  after unlink ")
        PrintNumber(removed)
        PrintMessage(" nodes: ring count=")
        PrintNumber(cnt2)
        PrintMessage("\n")

        PrintMessage("  freeing all remaining ring nodes...")
        buf2 = Allocate(Multiply(2, size))
        n2 = Plex.RingCollect(head, 0, buf2, Multiply(2, size))
        i = 0
        WhileLoop LessThan(i, n2) {
            Plex.Free(ArrayGet(buf2, i))
            i = Add(i, 1)
        }
        i = 0
        WhileLoop LessThan(i, removed) {
            Plex.Free(ArrayGet(kills, i))
            i = Add(i, 1)
        }
        PrintMessage(" done\n")
        Plex.Stats()
        ReturnValue(1)
    }
}

Function.StressMultiRing {
    Input: size: Integer
    Output: Integer
    Body: {
        PrintMessage("STRESS 3: Multi-ring membership (")
        PrintNumber(size)
        PrintMessage(" nodes, 4 rings)\n")
        nodes = Allocate(Multiply(size, 2))
        i = 0
        WhileLoop LessThan(i, size) {
            n = Plex.Alloc(Add(1, Modulo(i, 8)))
            Plex.Set(n, 0, i)
            ArraySet(nodes, i, n)
            i = Add(i, 1)
        }

        first = ArrayGet(nodes, 0)
        Plex.RingSingleton(first, 0)
        Plex.RingSingleton(first, 1)
        Plex.RingSingleton(first, 2)
        Plex.RingSingleton(first, 3)

        i = 1
        WhileLoop LessThan(i, size) {
            n = ArrayGet(nodes, i)
            Plex.RingInsertAfter(ArrayGet(nodes, Subtract(i, 1)), n, 0)
            IfCondition EqualTo(Modulo(i, 2), 0) ThenBlock: {
                Plex.RingInsertAfter(first, n, 1)
            }
            IfCondition EqualTo(Modulo(i, 3), 0) ThenBlock: {
                Plex.RingInsertAfter(first, n, 2)
            }
            IfCondition EqualTo(Modulo(i, 5), 0) ThenBlock: {
                Plex.RingInsertAfter(first, n, 3)
            }
            i = Add(i, 1)
        }

        c0 = Plex.RingCount(first, 0)
        c1 = Plex.RingCount(first, 1)
        c2 = Plex.RingCount(first, 2)
        c3 = Plex.RingCount(first, 3)
        PrintMessage("  ring0=")
        PrintNumber(c0)
        PrintMessage(" ring1=")
        PrintNumber(c1)
        PrintMessage(" ring2=")
        PrintNumber(c2)
        PrintMessage(" ring3=")
        PrintNumber(c3)
        PrintMessage("\n")

        PrintMessage("  cross-ring integrity: node0 in all 4? ")
        ok = 1
        IfCondition EqualTo(Plex.RingIn(first, 0), 0) ThenBlock: { ok = 0 }
        IfCondition EqualTo(Plex.RingIn(first, 1), 0) ThenBlock: { ok = 0 }
        IfCondition EqualTo(Plex.RingIn(first, 2), 0) ThenBlock: { ok = 0 }
        IfCondition EqualTo(Plex.RingIn(first, 3), 0) ThenBlock: { ok = 0 }
        IfCondition EqualTo(ok, 1) ThenBlock: { PrintMessage("OK\n") }
        IfCondition EqualTo(ok, 0) ThenBlock: { PrintMessage("FAIL\n") }

        PrintMessage("  unlink node0 from ring2, verify others intact...")
        Plex.RingUnlink(first, 2)
        IfCondition EqualTo(Plex.RingIn(first, 0), 1) ThenBlock: {
            IfCondition EqualTo(Plex.RingIn(first, 1), 1) ThenBlock: {
                IfCondition EqualTo(Plex.RingIn(first, 2), 0) ThenBlock: {
                    IfCondition EqualTo(Plex.RingIn(first, 3), 1) ThenBlock: {
                        PrintMessage(" OK\n")
                    }
                }
            }
        }

        PrintMessage("  free all via ring0 walk...")
        buf3 = Allocate(Multiply(size, 2))
        nn = Plex.RingCollect(first, 0, buf3, Multiply(size, 2))
        i = 0
        WhileLoop LessThan(i, nn) {
            Plex.Free(ArrayGet(buf3, i))
            i = Add(i, 1)
        }
        PrintMessage(" freed ")
        PrintNumber(nn)
        PrintMessage("\n")
        Plex.Stats()
        ReturnValue(1)
    }
}

Function.StressChurn {
    Input: rounds: Integer
    Input: batch: Integer
    Output: Integer
    Body: {
        PrintMessage("STRESS 4: Ring churn (")
        PrintNumber(rounds)
        PrintMessage(" rounds, batch=")
        PrintNumber(batch)
        PrintMessage(")\n")
        buf4 = Allocate(Multiply(batch, 2))
        r = 0
        WhileLoop LessThan(r, rounds) {
            i = 0
            WhileLoop LessThan(i, batch) {
                n = Plex.Alloc(Add(1, Modulo(Add(r, i), 6)))
                Plex.Set(n, 0, r)
                Plex.Set(n, 1, i)
                ArraySet(buf4, i, n)
                i = Add(i, 1)
            }
            head4 = ArrayGet(buf4, 0)
            Plex.RingSingleton(head4, 0)
            Plex.RingSingleton(head4, 1)
            i = 1
            WhileLoop LessThan(i, batch) {
                n = ArrayGet(buf4, i)
                Plex.RingInsertAfter(ArrayGet(buf4, Subtract(i, 1)), n, 0)
                IfCondition EqualTo(Modulo(i, 2), 0) ThenBlock: {
                    Plex.RingInsertAfter(head4, n, 1)
                }
                i = Add(i, 1)
            }
            c0 = Plex.RingCount(head4, 0)
            IfCondition NotEqual(c0, batch) ThenBlock: {
                PrintMessage("  FAIL ring0 count=")
                PrintNumber(c0)
                PrintMessage(" expected=")
                PrintNumber(batch)
                PrintMessage(" round=")
                PrintNumber(r)
                PrintMessage("\n")
                ReturnValue(0)
            }

            t1 = Plex.RingCountType(head4, 0, 1)
            t2 = Plex.RingCountType(head4, 0, 2)
            t3 = Plex.RingCountType(head4, 0, 3)

            allSame = Plex.RingAllSameType(head4, 0)

            i = 0
            WhileLoop LessThan(i, batch) {
                Plex.Free(ArrayGet(buf4, i))
                i = Add(i, 1)
            }
            r = Add(r, 1)
        }
        PrintMessage("  done ")
        PrintNumber(rounds)
        PrintMessage(" rounds OK\n")
        Plex.Stats()
        ReturnValue(1)
    }
}

Function.StressInsertRemoveMiddle {
    Input: size: Integer
    Input: rounds: Integer
    Output: Integer
    Body: {
        PrintMessage("STRESS 5: Insert/remove middle (ring=")
        PrintNumber(size)
        PrintMessage(", ")
        PrintNumber(rounds)
        PrintMessage(" splice rounds)\n")

        ringbuf = Allocate(Multiply(size, 2))
        i = 0
        WhileLoop LessThan(i, size) {
            n = Plex.Alloc(1)
            Plex.Set(n, 0, i)
            ArraySet(ringbuf, i, n)
            i = Add(i, 1)
        }
        head5 = ArrayGet(ringbuf, 0)
        Plex.RingSingleton(head5, 0)
        i = 1
        WhileLoop LessThan(i, size) {
            Plex.RingInsertAfter(ArrayGet(ringbuf, Subtract(i, 1)), ArrayGet(ringbuf, i), 0)
            i = Add(i, 1)
        }

        r = 0
        WhileLoop LessThan(r, rounds) {
            mid = Subtract(size, 1)
            target = ArrayGet(ringbuf, mid)
            Plex.RingUnlink(target, 0)
            spot = Modulo(r, Subtract(size, 1))
            anchor = ArrayGet(ringbuf, spot)
            IfCondition EqualTo(Plex.RingIn(anchor, 0), 0) ThenBlock: {
                anchor = head5
            }
            Plex.RingInsertAfter(anchor, target, 0)
            cnt = Plex.RingCount(head5, 0)
            IfCondition NotEqual(cnt, size) ThenBlock: {
                PrintMessage("  FAIL count=")
                PrintNumber(cnt)
                PrintMessage(" at round=")
                PrintNumber(r)
                PrintMessage("\n")
                ReturnValue(0)
            }
            r = Add(r, 1)
        }
        PrintMessage("  ring integrity held across ")
        PrintNumber(rounds)
        PrintMessage(" splices, count=")
        PrintNumber(Plex.RingCount(head5, 0))
        PrintMessage("\n")

        i = 0
        WhileLoop LessThan(i, size) {
            Plex.Free(ArrayGet(ringbuf, i))
            i = Add(i, 1)
        }
        Plex.Stats()
        ReturnValue(1)
    }
}

SubRoutine.Main {
    Arena_Init()
    Plex.Init()

    PrintMessage("=== Plex Stress Test ===\n\n")

    Plex.Stats()
    PrintMessage("\n")

    StressAllocFree(1000)
    PrintMessage("\n")

    StressLargeRing(500)
    PrintMessage("\n")

    StressMultiRing(200)
    PrintMessage("\n")

    StressChurn(500, 50)
    PrintMessage("\n")

    StressInsertRemoveMiddle(100, 2000)
    PrintMessage("\n")

    PrintMessage("=== Final State ===\n")
    Plex.Stats()
    PrintMessage("\n=== Plex Stress Test Complete ===\n")
    Exit(0)
}

RunTask(Main)
