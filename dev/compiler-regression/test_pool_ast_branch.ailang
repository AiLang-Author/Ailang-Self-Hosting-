// Minimal Branch repro to isolate the pool-AST bug.
LibraryImport.Arena

SubRoutine.Main {
    x = 5
    Branch x {
        Case 1: { SystemCall(1, 1, "one\n",   4) }
        Case 2: { SystemCall(1, 1, "two\n",   4) }
        Case 5: { SystemCall(1, 1, "five\n",  5) }
        Default: { SystemCall(1, 1, "other\n", 6) }
    }
    SystemCall(60, 0)
}
RunTask(Main)
