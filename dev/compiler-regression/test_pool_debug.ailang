// test_pool_debug.ailang
// Test: spawn multiple persistent spin-workers and check they all stay alive.
// Build: ./ailang.x test_pool_debug.ailang /tmp/test_pool_debug.x

LibraryImport.ThreadTrampoline

FixedPool.TestSync {
    "p_shutdown": Initialize=0
    "p_epoch":    Initialize=0
    "p_done":     Initialize=0
}

FixedPool.TestTids {
    "t0": Initialize=0
    "t1": Initialize=0
    "t2": Initialize=0
}

// Worker that spins on epoch, like ThrPool_WorkerEntry
Function.SpinWorker {
    Input: worker_id: Integer
    Output: Integer
    Body: {
        PrintMessage("[Worker ")
        PrintNumber(worker_id)
        PrintMessage("] started\n")

        sw_shut_ptr  = TestSync.p_shutdown
        sw_epoch_ptr = TestSync.p_epoch
        sw_done_ptr  = Add(TestSync.p_done, Multiply(worker_id, 8))
        sw_last_epoch = 0

        WhileLoop EqualTo(1, 1) {
            // Check shutdown
            IfCondition NotEqual(Dereference(sw_shut_ptr), 0) ThenBlock: {
                PrintMessage("[Worker ")
                PrintNumber(worker_id)
                PrintMessage("] exiting\n")
                ReturnValue(0)
            }

            // Check epoch
            sw_cur_epoch = Dereference(sw_epoch_ptr)
            IfCondition EqualTo(sw_cur_epoch, sw_last_epoch) ThenBlock: {
                SystemCall(SysNr.SCHED_YIELD, 0, 0, 0, 0, 0, 0)
            } ElseBlock: {
                sw_last_epoch = sw_cur_epoch
                // Signal done
                StoreValue(sw_done_ptr, 1)
            }
        }
        ReturnValue(0)
    }
}

SubRoutine.Main {
    PrintMessage("=== MULTI-WORKER SPIN TEST ===\n")
    Thread_Init()

    // Allocate sync buffers
    TestSync.p_shutdown = ThrHeap_Alloc(8)
    TestSync.p_epoch    = ThrHeap_Alloc(8)
    TestSync.p_done     = ThrHeap_Alloc(64)
    StoreValue(TestSync.p_shutdown, 0)
    StoreValue(TestSync.p_epoch, 0)

    // Spawn 3 workers
    TestTids.t0 = Thread_Spawn(AddressOf(SpinWorker), 0)
    TestTids.t1 = Thread_Spawn(AddressOf(SpinWorker), 1)
    TestTids.t2 = Thread_Spawn(AddressOf(SpinWorker), 2)

    Thread_Sleep(200)
    PrintMessage("Main: spawned 3 workers\n")

    // Check all alive
    a0 = Thread_IsAlive(TestTids.t0)
    a1 = Thread_IsAlive(TestTids.t1)
    a2 = Thread_IsAlive(TestTids.t2)
    PrintMessage("Alive: w0=")
    PrintNumber(a0)
    PrintMessage(" w1=")
    PrintNumber(a1)
    PrintMessage(" w2=")
    PrintNumber(a2)
    PrintMessage("\n")

    all_alive = Multiply(Multiply(a0, a1), a2)
    IfCondition EqualTo(all_alive, 0) ThenBlock: {
        PrintMessage("FAIL: Some workers died!\n")
    } ElseBlock: {
        PrintMessage("PASS: All 3 workers alive after 200ms\n")

        // Dispatch epoch 1
        StoreValue(TestSync.p_done, 0)
        StoreValue(Add(TestSync.p_done, 8), 0)
        StoreValue(Add(TestSync.p_done, 16), 0)
        StoreValue(TestSync.p_epoch, 1)

        // Wait for all done
        wt = 0
        WhileLoop EqualTo(1, 1) {
            d0 = Dereference(TestSync.p_done)
            d1 = Dereference(Add(TestSync.p_done, 8))
            d2 = Dereference(Add(TestSync.p_done, 16))
            IfCondition NotEqual(Multiply(Multiply(d0, d1), d2), 0) ThenBlock: {
                PrintMessage("PASS: All 3 workers completed epoch 1\n")
                // break via goto-equivalent
                wt = 10000000
            }
            wt = Add(wt, 1)
            IfCondition GreaterThan(wt, 5000000) ThenBlock: {
                PrintMessage("TIMEOUT d0=")
                PrintNumber(d0)
                PrintMessage(" d1=")
                PrintNumber(d1)
                PrintMessage(" d2=")
                PrintNumber(d2)
                PrintMessage("\n")
                wt = 10000000
            }
            IfCondition LessThan(wt, 10000000) ThenBlock: {
                SystemCall(SysNr.SCHED_YIELD, 0, 0, 0, 0, 0, 0)
            }
        }
    }

    // Shutdown
    StoreValue(TestSync.p_shutdown, 1)
    StoreValue(TestSync.p_epoch, 99)
    Thread_Sleep(200)

    Thread_Join(TestTids.t0)
    Thread_Join(TestTids.t1)
    Thread_Join(TestTids.t2)

    PrintMessage("=== TEST DONE ===\n")
}

RunTask(Main)
