LibraryImport.Arena

LinkagePool.SimplePool {
    "x": Initialize=42
    "y": Initialize=100
}

SubRoutine.Main {
    Arena_Init()
    
    PrintMessage("Read Test\n")
    ptr = AllocateLinkage(LinkagePool.SimplePool)
    
    val_x = ptr@x
    PrintMessage("x = ")
    PrintNumber(val_x)
    PrintMessage("\n")
    
    val_y = ptr@y
    PrintMessage("y = ")
    PrintNumber(val_y)
    PrintMessage("\n")
    
    Exit(0)
}

RunTask(Main)