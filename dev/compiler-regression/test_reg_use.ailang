// A value already in a register is the operand. The byte, the multiplier,
// and the float compare must agree with the scalar results below.

LibraryImport.Arena

FixedPool.RegUse {
    "fails": Initialize=0, CanChange=True
}

Function.Expect {
    Input: got: Integer
    Input: want: Integer
    Body: {
        IfCondition NotEqual(got, want) ThenBlock: {
            PrintMessage("FAIL got ")
            PrintNumber(got)
            PrintMessage(" want ")
            PrintNumber(want)
            PrintMessage("\n")
            RegUse.fails = Add(RegUse.fails, 1)
        }
    }
}

SubRoutine.Main {
    buf = Allocate(16)
    SetByte(buf, 0, 102)
    SetByte(buf, 1, 111)
    SetByte(buf, 2, 111)
    SetByte(buf, 3, 98)
    SetByte(buf, 4, 97)
    SetByte(buf, 5, 114)
    h = 0xCBF29CE484222325
    prime = 0x100000001B3
    i = 0
    n = 6
    WhileLoop LessThan(i, n) {
        b = GetByte(buf, i)
        h = BitwiseXor(h, b)
        h = Multiply(h, prime)
        i = Add(i, 1)
    }
    Expect(h, -8821353812377114648)

    tbl = Allocate(16)
    i = 0
    WhileLoop LessThan(i, 4) {
        SetByte(tbl, i, i)
        SetByte(buf, i, i)
        i = Add(i, 1)
    }
    left = 0
    right = 3
    WhileLoop LessEqual(left, right) {
        bleft = GetByte(buf, left)
        bright = GetByte(buf, right)
        c = GetByte(tbl, bleft)
        nleft = GetByte(tbl, bright)
        SetByte(buf, left, nleft)
        SetByte(buf, right, c)
        left = Add(left, 1)
        right = Subtract(right, 1)
    }
    Expect(GetByte(buf, 0), 3)
    Expect(GetByte(buf, 1), 2)
    Expect(GetByte(buf, 2), 1)
    Expect(GetByte(buf, 3), 0)
    sum = 0
    i = 0
    WhileLoop LessThan(i, 4) {
        b = GetByte(buf, i)
        sum = Add(sum, b)
        i = Add(i, 1)
    }
    Expect(sum, 6)

    four = Float_FromInt(4)
    two = Float_FromInt(2)
    x = Float_FromInt(1)
    le = Float_Le(Float_Add(x, x), four)
    Expect(le, 1)
    x = Float_FromInt(3)
    le = Float_Le(Float_Add(x, x), four)
    Expect(le, 0)

    x = 0
    i = 0
    WhileLoop And(LessThan(i, 10), Float_Le(Float_Add(x, x), four)) {
        x = Float_Add(x, two)
        i = Add(i, 1)
    }
    Expect(i, 2)
    Expect(Float_ToInt(x), 4)

    i = -200
    count = 0
    WhileLoop LessThan(i, 200) {
        IfCondition And(GreaterEqual(i, -128), LessThan(i, 128)) ThenBlock: {
            count = Add(count, 1)
        }
        i = Add(i, 1)
    }
    Expect(count, 256)

    nan = Float_Div(Float_FromInt(0), Float_FromInt(0))
    le = Float_Le(nan, four)
    Expect(le, 0)
    lt = Float_Lt(nan, four)
    Expect(lt, 0)
    gt = Float_Gt(nan, four)
    Expect(gt, 0)
    ge = Float_Ge(nan, four)
    Expect(ge, 0)
    eq = Float_Eq(nan, four)
    Expect(eq, 0)
    ne = Float_Ne(nan, four)
    Expect(ne, 1)

    entered = 0
    IfCondition Float_Le(nan, four) ThenBlock: { entered = 1 }
    Expect(entered, 0)
    IfCondition Float_Lt(nan, four) ThenBlock: { entered = 1 }
    Expect(entered, 0)
    IfCondition Float_Gt(nan, four) ThenBlock: { entered = 1 }
    Expect(entered, 0)
    IfCondition Float_Ge(nan, four) ThenBlock: { entered = 1 }
    Expect(entered, 0)
    IfCondition Float_Eq(nan, four) ThenBlock: { entered = 1 }
    Expect(entered, 0)
    entered = 0
    IfCondition Float_Ne(nan, four) ThenBlock: { entered = 1 }
    Expect(entered, 1)

    PrintMessage("fails ")
    PrintNumber(RegUse.fails)
    PrintMessage("\n")
    ProcessExit(RegUse.fails)
}

RunTask(Main)
