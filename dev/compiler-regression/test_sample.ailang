// test_sample.ailang — WAV + SF2 sample voice
LibraryImport.Arena
LibraryImport.Media.Sample
LibraryImport.Media.SF2
LibraryImport.Media.Synth

FixedPool.TestState {
    "passed": Initialize=0, CanChange=True
    "failed": Initialize=0, CanChange=True
}

Function.Test_Pass {
    Input: name: Address
    Body: {
        PrintMessage("  [PASS] ")
        PrintString(name)
        PrintMessage("\n")
        TestState.passed = Add(TestState.passed, 1)
    }
}

Function.Test_Fail {
    Input: name: Address
    Input: got: Integer
    Input: want: Integer
    Body: {
        PrintMessage("  [FAIL] ")
        PrintString(name)
        PrintMessage(" got=")
        PrintNumber(got)
        PrintMessage(" want=")
        PrintNumber(want)
        PrintMessage("\n")
        TestState.failed = Add(TestState.failed, 1)
    }
}

Function.Test_Assert {
    Input: name: Address
    Input: cond: Integer
    Input: got: Integer
    Input: want: Integer
    Body: {
        IfCondition NotEqual(cond, 0) ThenBlock: { Test_Pass(name) }
        ElseBlock: { Test_Fail(name, got, want) }
    }
}

SubRoutine.Main {
    Arena_Init()
    PrintMessage("============================================\n")
    PrintMessage("  sample / SF2 test\n")
    PrintMessage("============================================\n")

    wav = Smp_LoadWav("tests/sample/sine_c4.wav")
    Test_Assert("wav load", NotEqual(wav, 0), wav, 1)
    IfCondition NotEqual(wav, 0) ThenBlock: {
        n = Dereference(Add(wav, 16))
        Test_Assert("wav frames 2048", EqualTo(n, 2048), n, 2048)
        Smp_SetLoop(wav, 0, 2048, 1)
        syn = Synth_New(1, 48000)
        Synth_VoiceOnSample(syn, 0, wav, 60, 100)
        frames = 2400
        buf = Allocate(Multiply(frames, 2))
        MemorySet(buf, 0, Multiply(frames, 2))
        Synth_RenderS16(syn, buf, frames)
        acc = 0
        i = 0
        WhileLoop LessThan(i, frames) {
            lo = GetByte(buf, Multiply(i, 2))
            hi = GetByte(buf, Add(Multiply(i, 2), 1))
            acc = Add(acc, Add(lo, hi))
            i = Add(i, 1)
        }
        Test_Assert("sample render not silent", GreaterThan(acc, 0), acc, 1)
        Deallocate(buf, Multiply(frames, 2))
        Synth_Free(syn)
        Smp_Free(wav)
    }

    bank = SF2_Load("tests/sample/sine_c4.sf2")
    Test_Assert("sf2 load", NotEqual(bank, 0), bank, 1)
    IfCondition NotEqual(bank, 0) ThenBlock: {
        ns = SF2_Count(bank)
        Test_Assert("sf2 samples >=1", GreaterEqual(ns, 1), ns, 1)
        np = SF2_PresetCount(bank)
        Test_Assert("sf2 presets >=1", GreaterEqual(np, 1), np, 1)
        smp = SF2_Lookup(bank, 60, 64)
        Test_Assert("sf2 lookup C4", NotEqual(smp, 0), smp, 1)
        smp0 = SF2_LookupP(bank, 60, 64, 0, 0)
        Test_Assert("sf2 lookupP 0/0", NotEqual(smp0, 0), smp0, 1)
        smp2 = SF2_Lookup(bank, 72, 100)
        Test_Assert("sf2 lookup C5", NotEqual(smp2, 0), smp2, 1)
        syn = Synth_New(1, 48000)
        Synth_VoiceOnSample(syn, 0, smp, 60, 90)
        frames = 1200
        buf = Allocate(Multiply(frames, 2))
        MemorySet(buf, 0, Multiply(frames, 2))
        Synth_RenderS16(syn, buf, frames)
        acc = 0
        i = 0
        WhileLoop LessThan(i, 100) {
            acc = Add(acc, GetByte(buf, i))
            i = Add(i, 1)
        }
        Test_Assert("sf2 play not silent", GreaterThan(acc, 0), acc, 1)
        Deallocate(buf, Multiply(frames, 2))
        Synth_Free(syn)
        hasr = Smp_HasRight(smp)
        Test_Assert("fixture may be mono", GreaterEqual(hasr, 0), hasr, 0)
    }

    ptq = SF2_Load("/home/bob/Downloads/PTQ.sf2")
    IfCondition NotEqual(ptq, 0) ThenBlock: {
        Test_Assert("PTQ presets 4", EqualTo(SF2_PresetCount(ptq), 4), SF2_PresetCount(ptq), 4)
        ps = SF2_LookupP(ptq, 60, 100, 2, 0)
        Test_Assert("PTQ square piano", NotEqual(ps, 0), ps, 1)
        IfCondition NotEqual(ps, 0) ThenBlock: {
            Test_Assert("PTQ stereo pair", EqualTo(Smp_HasRight(ps), 1), Smp_HasRight(ps), 1)
        }
        flute = SF2_LookupP(ptq, 72, 100, 3, 0)
        Test_Assert("PTQ panflute", NotEqual(flute, 0), flute, 1)
        IfCondition And(NotEqual(ps, 0), NotEqual(flute, 0)) ThenBlock: {
            Test_Assert("piano != flute", NotEqual(ps, flute), ps, flute)
        }
    } ElseBlock: {
        Test_Pass("PTQ.sf2 not present")
    }

    gu = SF2_Load("/home/bob/Downloads/GeneralUser-GS.sf2")
    IfCondition NotEqual(gu, 0) ThenBlock: {
        Test_Assert("GU presets > 128", GreaterThan(SF2_PresetCount(gu), 128), SF2_PresetCount(gu), 128)
        piano = SF2_LookupP(gu, 60, 100, 0, 0)
        clar = SF2_LookupP(gu, 60, 100, 71, 0)
        choir = SF2_LookupP(gu, 60, 100, 52, 0)
        drum = SF2_LookupP(gu, 38, 100, 0, 128)
        Test_Assert("GU piano", NotEqual(piano, 0), piano, 1)
        Test_Assert("GU clarinet", NotEqual(clar, 0), clar, 1)
        Test_Assert("GU choir", NotEqual(choir, 0), choir, 1)
        Test_Assert("GU drum kit", NotEqual(drum, 0), drum, 1)
        Test_Assert("GU piano != clarinet", NotEqual(piano, clar), piano, clar)
        croot = SF2_LastRoot()
        cco = SF2_LastCoarse()
        Test_Assert("clarinet root ~58", GreaterThan(croot, 50), croot, 58)
        Test_Assert("GU piano != choir", NotEqual(piano, choir), piano, choir)
        Test_Assert("GU piano != snare", NotEqual(piano, drum), piano, drum)
        SF2_SetNth(0)
        l0 = SF2_LookupP(gu, 72, 100, 82, 0)
        Test_Assert("calliope zone0", NotEqual(l0, 0), l0, 1)
        croot2 = SF2_LastRoot()
        cco2 = SF2_LastCoarse()
        eff = Add(croot2, cco2)
        Test_Assert("calliope z0 concert 58", EqualTo(eff, 58), eff, 58)
        SF2_SetNth(1)
        l1 = SF2_LookupP(gu, 72, 100, 82, 0)
        SF2_SetNth(0)
        Test_Assert("calliope zone1 layer", NotEqual(l1, 0), l1, 1)
        IfCondition NotEqual(l1, 0) ThenBlock: {
            r1 = SF2_LastRoot()
            k1 = SF2_LastCoarse()
            e1 = Add(r1, k1)
            Test_Assert("calliope z1 concert 58", EqualTo(e1, 58), e1, 58)
        }
    } ElseBlock: {
        Test_Pass("GeneralUser-GS.sf2 not present")
    }

    PrintMessage("\n  Results: ")
    PrintNumber(TestState.passed)
    PrintMessage(" passed, ")
    PrintNumber(TestState.failed)
    PrintMessage(" failed\n")
}

RunTask(Main)
