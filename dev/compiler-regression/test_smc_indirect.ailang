// test_smc_indirect.ailang — Minimal test for SMC indirect register access
// Build: ./ailang.x dev/compiler-regression/test_smc_indirect.ailang test_smc_indirect.x
// Run:   sg video -c "./test_smc_indirect.x"
//
// Tests each piece in isolation:
//  1. MMIO read of a known register (GRBM_STATUS) — proves MMIO works
//  2. Raw MMIO write/read of IND_INDEX_0 (offset 0x200) — proves the register is writable
//  3. Raw MMIO write/read of IND_ACCESS_CNTL (offset 0x228)
//  4. SRAM read via IND_INDEX_0/IND_DATA_0 at various addresses
//  5. SMC syscon register reads (RESET_CNTL, CLOCK_CNTL_0) via indirect
//  6. Try PCI config space SMC-related bits

LibraryImport.Arena
LibraryImport.Drivers.AMDGPU.AMDGPUFamily
LibraryImport.Drivers.AMDGPU.AMDGPUDiscover
LibraryImport.Drivers.AMDGPU.AMDGPUBAR
LibraryImport.Drivers.AMDGPU.AMDGPUPM4Regs
LibraryImport.Drivers.AMDGPU.AMDGPUSMCRegs

SubRoutine.Main {
    PrintMessage("=== SMC Indirect Access Diagnostic ===\n\n")

    count = GPU_Discover()
    IfCondition EqualTo(count, 0) ThenBlock: {
        PrintMessage("No AMD GPUs found.\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }
    GPU_PrintAll()
    PrintMessage("\n")

    GPU_BAR_Init()
    GPU_BAR_MapMMIO(0)
    gpu = 0
    PrintMessage("Using GPU 0\n\n")

    // ============================================================
    // TEST 1: Basic MMIO read
    // ============================================================
    PrintMessage("--- TEST 1: Basic MMIO reads ---\n")
    grbm = GPU_Rd32(gpu, SIReg.GRBM_STATUS)
    PrintMessage("GRBM_STATUS = 0x")
    PrintHex(grbm)
    IfCondition EqualTo(grbm, 0) ThenBlock: {
        PrintMessage("  ** ZERO — MMIO may be dead\n")
    }
    ElseBlock: {
        PrintMessage("  OK\n")
    }

    srbm = GPU_Rd32(gpu, SIReg.SRBM_STATUS)
    PrintMessage("SRBM_STATUS = 0x")
    PrintHex(srbm)
    IfCondition EqualTo(srbm, 0) ThenBlock: {
        PrintMessage("  ** ZERO\n")
    }
    ElseBlock: {
        PrintMessage("  OK\n")
    }

    spll3 = GPU_Rd32(gpu, SIReg.CG_SPLL_FUNC_CNTL_3)
    PrintMessage("CG_SPLL_FUNC_CNTL_3 = 0x")
    PrintHex(spll3)
    PrintMessage("\n")

    // ============================================================
    // TEST 2: IND_INDEX_0 register write/readback
    // ============================================================
    PrintMessage("\n--- TEST 2: IND_INDEX_0 write/readback ---\n")

    // Read current value
    idx_cur = GPU_Rd32(gpu, SMCReg.IND_INDEX_0)
    PrintMessage("IND_INDEX_0 current = 0x")
    PrintHex(idx_cur)
    PrintMessage("\n")

    // Write a known value
    GPU_Wr32(gpu, SMCReg.IND_INDEX_0, 65536)
    idx_rb = GPU_Rd32(gpu, SMCReg.IND_INDEX_0)
    PrintMessage("IND_INDEX_0 after write 0x10000 = 0x")
    PrintHex(idx_rb)
    IfCondition EqualTo(idx_rb, 65536) ThenBlock: {
        PrintMessage("  PASS\n")
    }
    ElseBlock: {
        PrintMessage("  FAIL (expected 0x10000)\n")
    }

    // Write another value
    GPU_Wr32(gpu, SMCReg.IND_INDEX_0, 256)
    idx_rb2 = GPU_Rd32(gpu, SMCReg.IND_INDEX_0)
    PrintMessage("IND_INDEX_0 after write 0x100 = 0x")
    PrintHex(idx_rb2)
    IfCondition EqualTo(idx_rb2, 256) ThenBlock: {
        PrintMessage("  PASS\n")
    }
    ElseBlock: {
        PrintMessage("  FAIL (expected 0x100)\n")
    }

    // ============================================================
    // TEST 3: IND_ACCESS_CNTL register
    // ============================================================
    PrintMessage("\n--- TEST 3: IND_ACCESS_CNTL ---\n")
    acc = GPU_Rd32(gpu, SMCReg.IND_ACCESS_CNTL)
    PrintMessage("IND_ACCESS_CNTL = 0x")
    PrintHex(acc)
    PrintMessage("\n")

    // Try setting AUTO_INCREMENT
    GPU_Wr32(gpu, SMCReg.IND_ACCESS_CNTL, 1)
    acc2 = GPU_Rd32(gpu, SMCReg.IND_ACCESS_CNTL)
    PrintMessage("After set AUTO_INC = 0x")
    PrintHex(acc2)
    PrintMessage("\n")

    // Clear it
    GPU_Wr32(gpu, SMCReg.IND_ACCESS_CNTL, 0)
    acc3 = GPU_Rd32(gpu, SMCReg.IND_ACCESS_CNTL)
    PrintMessage("After clear = 0x")
    PrintHex(acc3)
    PrintMessage("\n")

    // ============================================================
    // TEST 4: IND_DATA_0 read at various SRAM addresses
    // ============================================================
    PrintMessage("\n--- TEST 4: SRAM reads via IND_INDEX_0/IND_DATA_0 ---\n")

    // Disable auto-increment for single reads
    GPU_Wr32(gpu, SMCReg.IND_ACCESS_CNTL, 0)

    // Read SRAM address 0 (bootstrap instruction, should be 0x0E004040 if FW loaded)
    GPU_Wr32(gpu, SMCReg.IND_INDEX_0, 0)
    d0 = GPU_Rd32(gpu, SMCReg.IND_DATA_0)
    PrintMessage("SRAM[0x00000] = 0x")
    PrintHex(d0)
    PrintMessage("\n")

    // Read SRAM 0x100
    GPU_Wr32(gpu, SMCReg.IND_INDEX_0, 256)
    d1 = GPU_Rd32(gpu, SMCReg.IND_DATA_0)
    PrintMessage("SRAM[0x00100] = 0x")
    PrintHex(d1)
    PrintMessage("\n")

    // Read FW header at 0x10000
    GPU_Wr32(gpu, SMCReg.IND_INDEX_0, 65536)
    d2 = GPU_Rd32(gpu, SMCReg.IND_DATA_0)
    PrintMessage("SRAM[0x10000] = 0x")
    PrintHex(d2)
    PrintMessage("  (expect FW version if loaded)\n")

    // ============================================================
    // TEST 5: SRAM write/readback test
    // ============================================================
    PrintMessage("\n--- TEST 5: SRAM write/readback ---\n")

    // Write 0xDEADBEEF to SRAM 0x100
    GPU_Wr32(gpu, SMCReg.IND_ACCESS_CNTL, 0)
    GPU_Wr32(gpu, SMCReg.IND_INDEX_0, 256)
    GPU_Wr32(gpu, SMCReg.IND_DATA_0, 3735928559)

    // Read it back (must re-set index)
    GPU_Wr32(gpu, SMCReg.IND_INDEX_0, 256)
    rb = GPU_Rd32(gpu, SMCReg.IND_DATA_0)
    PrintMessage("Write 0xDEADBEEF to 0x100, read back: 0x")
    PrintHex(rb)
    IfCondition EqualTo(rb, 3735928559) ThenBlock: {
        PrintMessage("  PASS\n")
    }
    ElseBlock: {
        PrintMessage("  FAIL\n")
    }

    // ============================================================
    // TEST 6: SMC syscon registers via indirect (addresses >= 0x80000000)
    // ============================================================
    PrintMessage("\n--- TEST 6: SMC syscon indirect registers ---\n")

    // SMCSyscon.RESET_CNTL = 0x80000000
    GPU_Wr32(gpu, SMCReg.IND_INDEX_0, 2147483648)
    rst = GPU_Rd32(gpu, SMCReg.IND_DATA_0)
    PrintMessage("RESET_CNTL (0x80000000) = 0x")
    PrintHex(rst)
    PrintMessage("\n")

    // SMCSyscon.CLOCK_CNTL_0 = 0x80000004
    GPU_Wr32(gpu, SMCReg.IND_INDEX_0, 2147483652)
    clk = GPU_Rd32(gpu, SMCReg.IND_DATA_0)
    PrintMessage("CLOCK_CNTL_0 (0x80000004) = 0x")
    PrintHex(clk)
    PrintMessage("\n")

    // SMCSyscon.MISC_CNTL = 0x80000010
    GPU_Wr32(gpu, SMCReg.IND_INDEX_0, 2147483664)
    misc = GPU_Rd32(gpu, SMCReg.IND_DATA_0)
    PrintMessage("MISC_CNTL (0x80000010) = 0x")
    PrintHex(misc)
    PrintMessage("\n")

    // ============================================================
    // TEST 7: Check SMC_IND_INDEX_1/DATA_1 (alternate indirect pair)
    // ============================================================
    PrintMessage("\n--- TEST 7: IND_INDEX_1/DATA_1 (alternate pair) ---\n")

    // IND_INDEX_1 = 0x208, IND_DATA_1 = 0x20C
    GPU_Wr32(gpu, SMCReg.IND_INDEX_1, 65536)
    idx1_rb = GPU_Rd32(gpu, SMCReg.IND_INDEX_1)
    PrintMessage("IND_INDEX_1 write 0x10000 readback = 0x")
    PrintHex(idx1_rb)
    PrintMessage("\n")

    d1_1 = GPU_Rd32(gpu, SMCReg.IND_DATA_1)
    PrintMessage("IND_DATA_1 at 0x10000 = 0x")
    PrintHex(d1_1)
    PrintMessage("\n")

    // ============================================================
    // TEST 8: Direct MMIO at offsets 0x200-0x22C raw dump
    // ============================================================
    PrintMessage("\n--- TEST 8: Raw MMIO dump of SMC indirect registers ---\n")

    state = GPU_BAR_GetState(gpu)
    mmio = Dereference(Add(state, GPUBarField.MMIO_PTR))

    off = 512
    WhileLoop LessEqual(off, 556) {
        val = Dereference(Add(mmio, off), "dword")
        PrintMessage("  MMIO[0x")
        PrintHex(off)
        PrintMessage("] = 0x")
        PrintHex(val)
        PrintMessage("\n")
        off = Add(off, 4)
    }

    // ============================================================
    // TEST 9: Check if RCU_UC_EVENTS shows anything about SMC state
    // ============================================================
    PrintMessage("\n--- TEST 9: SMC-related direct MMIO registers ---\n")

    // RESP_0 = 0x230
    resp = GPU_Rd32(gpu, SMCReg.RESP_0)
    PrintMessage("RESP_0 (0x230) = 0x")
    PrintHex(resp)
    PrintMessage("\n")

    // MESSAGE_0 = 0x22C
    msg = GPU_Rd32(gpu, SMCReg.MESSAGE_0)
    PrintMessage("MESSAGE_0 (0x22C) = 0x")
    PrintHex(msg)
    PrintMessage("\n")

    // SCRATCH0 = 0x884
    scr = GPU_Rd32(gpu, SMCReg.SCRATCH0)
    PrintMessage("SCRATCH0 (0x884) = 0x")
    PrintHex(scr)
    PrintMessage("\n")

    GPU_BAR_Unmap(gpu)
    PrintMessage("\n=== Done ===\n")
    SystemCall(60, 0, 0, 0, 0, 0)
}

RunTask(Main)
