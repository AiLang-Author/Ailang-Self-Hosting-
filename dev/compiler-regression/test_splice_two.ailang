// Two splice levels must still return the call's value, including when the
// caller and both callees use the same temporary name. An InlineAsm body
// stays a real call, so its edi read is the argument, not the caller's.
LibraryImport.Arena

FixedPool.Tally {
    "bad": Initialize=0, CanChange=True
}

Function.Expect {
    Input: got: Integer
    Input: want: Integer
    Input: tag: Integer
    Body: {
        IfCondition NotEqual(got, want) ThenBlock: {
            PrintMessage("FAIL ")
            PrintNumber(tag)
            PrintMessage(" got ")
            PrintNumber(got)
            PrintMessage(" want ")
            PrintNumber(want)
            PrintMessage("\n")
            Tally.bad = Add(Tally.bad, 1)
        }
    }
}

Function.Leaf {
    Input: n: Integer
    Output: Integer
    Body: {
        t = Add(n, 1)
        ReturnValue(t)
    }
}

Function.Mid {
    Input: n: Integer
    Output: Integer
    Body: {
        t = Leaf(n)
        t = Add(t, 2)
        ReturnValue(t)
    }
}

Function.Top {
    Output: Integer
    Body: {
        t = Mid(10)
        ReturnValue(t)
    }
}

Function.AsmId {
    Input: n: Integer
    Output: Integer
    Body: {
        InlineAsm["MOV eax, edi"]
        r = InlineAsm["MOV eax, eax"]
        ReturnValue(r)
    }
}

Function.UseAsm {
    Input: base: Integer
    Output: Integer
    Body: {
        k = 5
        v = AsmId(k)
        ReturnValue(Add(v, base))
    }
}

SubRoutine.Main {
    Expect(Top(), 13, 1)
    Expect(UseAsm(10), 15, 2)
    IfCondition EqualTo(Tally.bad, 0) ThenBlock: {
        PrintMessage("PASS\n")
    }
    Exit(Tally.bad)
}

RunTask(Main)
