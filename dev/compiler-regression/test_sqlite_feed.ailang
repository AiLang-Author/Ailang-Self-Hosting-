// Fence: interior table/index pages + Feed20 against /tmp/split.db
LibraryImport.Arena
LibraryImport.SQLite

SubRoutine.Main {
    bad = 0
    ok = SQLite.Open("/tmp/split.db")
    IfCondition EqualTo(ok, 0) ThenBlock: {
        PrintMessage("FAIL open\n")
        Exit(1)
    }
    pf = SQLite.PageFlags(SQLiteDB.posts_root)
    IfCondition NotEqual(pf, 5) ThenBlock: {
        PrintMessage("FAIL posts flags=")
        PrintNumber(pf)
        PrintMessage("\n")
        bad = Add(bad, 1)
    }
    iff = SQLite.PageFlags(SQLiteDB.feed_idx)
    IfCondition NotEqual(iff, 2) ThenBlock: {
        PrintMessage("FAIL feed flags=")
        PrintNumber(iff)
        PrintMessage("\n")
        bad = Add(bad, 1)
    }
    gp = SQLite.GetPost(300)
    IfCondition EqualTo(gp, 0) ThenBlock: {
        PrintMessage("FAIL get 300 missing\n")
        bad = Add(bad, 1)
    }
    IfCondition NotEqual(SQLitePost.id, 300) ThenBlock: {
        PrintMessage("FAIL 300 id\n")
        bad = Add(bad, 1)
    }
    IfCondition NotEqual(StringCompare(SQLitePost.body, "body_300"), 0) ThenBlock: {
        PrintMessage("FAIL 300 body=")
        PrintMessage(SQLitePost.body)
        PrintMessage("\n")
        bad = Add(bad, 1)
    }
    IfCondition NotEqual(StringCompare(SQLitePost.created, "2026-12-31T23:59:59.999Z"), 0) ThenBlock: {
        PrintMessage("FAIL 300 created=")
        PrintMessage(SQLitePost.created)
        PrintMessage("\n")
        bad = Add(bad, 1)
    }
    IfCondition NotEqual(StringCompare(SQLitePost.author, "user_2"), 0) ThenBlock: {
        PrintMessage("FAIL 300 author=")
        PrintMessage(SQLitePost.author)
        PrintMessage("\n")
        bad = Add(bad, 1)
    }
    IfCondition NotEqual(SQLitePost.likes, 20) ThenBlock: {
        PrintMessage("FAIL 300 likes=")
        PrintNumber(SQLitePost.likes)
        PrintMessage("\n")
        bad = Add(bad, 1)
    }
    g1 = SQLite.GetPost(1)
    IfCondition EqualTo(g1, 0) ThenBlock: {
        PrintMessage("FAIL get 1 missing\n")
        bad = Add(bad, 1)
    }
    IfCondition NotEqual(StringCompare(SQLitePost.body, "body_1"), 0) ThenBlock: {
        PrintMessage("FAIL 1 body=")
        PrintMessage(SQLitePost.body)
        PrintMessage("\n")
        bad = Add(bad, 1)
    }
    IfCondition NotEqual(StringCompare(SQLitePost.author, "user_1"), 0) ThenBlock: {
        PrintMessage("FAIL 1 author=")
        PrintMessage(SQLitePost.author)
        PrintMessage("\n")
        bad = Add(bad, 1)
    }
    IfCondition NotEqual(SQLitePost.likes, 0) ThenBlock: {
        PrintMessage("FAIL 1 likes=")
        PrintNumber(SQLitePost.likes)
        PrintMessage("\n")
        bad = Add(bad, 1)
    }
    miss = SQLite.GetPost(999)
    IfCondition NotEqual(miss, 0) ThenBlock: {
        PrintMessage("FAIL missing 999\n")
        bad = Add(bad, 1)
    }
    nfeed = SQLite.Feed20()
    IfCondition NotEqual(nfeed, 20) ThenBlock: {
        PrintMessage("FAIL feed n=")
        PrintNumber(nfeed)
        PrintMessage("\n")
        bad = Add(bad, 1)
    }
    expect = 300
    i = 0
    WhileLoop LessThan(i, 20) {
        got = SQLite.FeedId(i)
        IfCondition NotEqual(got, expect) ThenBlock: {
            PrintMessage("FAIL feed[")
            PrintNumber(i)
            PrintMessage("]=")
            PrintNumber(got)
            PrintMessage(" want=")
            PrintNumber(expect)
            PrintMessage("\n")
            bad = Add(bad, 1)
        }
        expect = Subtract(expect, 1)
        i = Add(i, 1)
    }
    b0 = SQLite.FeedBody(0)
    IfCondition NotEqual(StringCompare(b0, "body_300"), 0) ThenBlock: {
        PrintMessage("FAIL feed body0=")
        PrintMessage(b0)
        PrintMessage("\n")
        bad = Add(bad, 1)
    }
    a0 = SQLite.FeedAuthor(0)
    IfCondition NotEqual(StringCompare(a0, "user_2"), 0) ThenBlock: {
        PrintMessage("FAIL feed author0=")
        PrintMessage(a0)
        PrintMessage("\n")
        bad = Add(bad, 1)
    }
    c0 = SQLite.FeedCreated(0)
    IfCondition NotEqual(StringCompare(c0, "2026-12-31T23:59:59.999Z"), 0) ThenBlock: {
        PrintMessage("FAIL feed created0=")
        PrintMessage(c0)
        PrintMessage("\n")
        bad = Add(bad, 1)
    }
    c1 = SQLite.FeedCreated(1)
    IfCondition NotEqual(StringCompare(c1, "2026-12-31T23:59:59.999Z"), 0) ThenBlock: {
        PrintMessage("FAIL feed created1=")
        PrintMessage(c1)
        PrintMessage("\n")
        bad = Add(bad, 1)
    }
    lk0 = SQLite.FeedLikes(0)
    IfCondition NotEqual(lk0, 20) ThenBlock: {
        PrintMessage("FAIL feed likes0=")
        PrintNumber(lk0)
        PrintMessage("\n")
        bad = Add(bad, 1)
    }
    IfCondition EqualTo(bad, 0) ThenBlock: {
        PrintMessage("PASS\n")
    }
    Exit(bad)
}
RunTask(Main)
