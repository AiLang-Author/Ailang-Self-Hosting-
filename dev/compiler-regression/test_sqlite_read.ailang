// Fence: native SQLite reader against /tmp/tiny.db
LibraryImport.Arena
LibraryImport.SQLite

SubRoutine.Main {
    bad = 0
    ok = SQLite.Open("/tmp/tiny.db")
    IfCondition EqualTo(ok, 0) ThenBlock: {
        PrintMessage("FAIL open\n")
        Exit(1)
    }
    IfCondition NotEqual(SQLiteDB.users_root, 2) ThenBlock: {
        PrintMessage("FAIL users_root=")
        PrintNumber(SQLiteDB.users_root)
        PrintMessage("\n")
        bad = Add(bad, 1)
    }
    IfCondition NotEqual(SQLiteDB.posts_root, 4) ThenBlock: {
        PrintMessage("FAIL posts_root=")
        PrintNumber(SQLiteDB.posts_root)
        PrintMessage("\n")
        bad = Add(bad, 1)
    }
    IfCondition NotEqual(SQLiteDB.likes_root, 5) ThenBlock: {
        PrintMessage("FAIL likes_root=")
        PrintNumber(SQLiteDB.likes_root)
        PrintMessage("\n")
        bad = Add(bad, 1)
    }
    gp = SQLite.GetPost(1)
    IfCondition EqualTo(gp, 0) ThenBlock: {
        PrintMessage("FAIL getpost missing\n")
        bad = Add(bad, 1)
    }
    IfCondition NotEqual(SQLitePost.id, 1) ThenBlock: {
        PrintMessage("FAIL post id\n")
        bad = Add(bad, 1)
    }
    IfCondition NotEqual(SQLite.EqLit(SQLitePost.body, SQLitePost.body_n, "hello world"), 0) ThenBlock: {
        PrintMessage("FAIL body n=")
        PrintNumber(SQLitePost.body_n)
        PrintMessage("\n")
        bad = Add(bad, 1)
    }
    IfCondition NotEqual(SQLite.EqLit(SQLitePost.created, SQLitePost.created_n, "2025-12-31T23:59:19.409Z"), 0) ThenBlock: {
        PrintMessage("FAIL created n=")
        PrintNumber(SQLitePost.created_n)
        PrintMessage("\n")
        bad = Add(bad, 1)
    }
    IfCondition NotEqual(SQLite.EqLit(SQLitePost.author, SQLitePost.author_n, "golden_ember_1"), 0) ThenBlock: {
        PrintMessage("FAIL author n=")
        PrintNumber(SQLitePost.author_n)
        PrintMessage("\n")
        bad = Add(bad, 1)
    }
    IfCondition NotEqual(SQLitePost.likes, 1) ThenBlock: {
        PrintMessage("FAIL likes=")
        PrintNumber(SQLitePost.likes)
        PrintMessage("\n")
        bad = Add(bad, 1)
    }
    miss = SQLite.GetPost(99)
    IfCondition NotEqual(miss, 0) ThenBlock: {
        PrintMessage("FAIL missing post\n")
        bad = Add(bad, 1)
    }
    nfeed = SQLite.Feed20()
    IfCondition NotEqual(nfeed, 1) ThenBlock: {
        PrintMessage("FAIL feed n=")
        PrintNumber(nfeed)
        PrintMessage("\n")
        bad = Add(bad, 1)
    }
    fid = SQLite.FeedId(0)
    IfCondition NotEqual(fid, 1) ThenBlock: {
        PrintMessage("FAIL feed id=")
        PrintNumber(fid)
        PrintMessage("\n")
        bad = Add(bad, 1)
    }
    IfCondition EqualTo(bad, 0) ThenBlock: {
        PrintMessage("PASS\n")
    }
    Exit(bad)
}
RunTask(Main)
