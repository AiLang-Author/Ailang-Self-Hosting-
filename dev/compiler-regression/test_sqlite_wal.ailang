// Fence: reopen /tmp/split_w.db after InsertPost and read via WAL overlay
LibraryImport.Arena
LibraryImport.SQLite

SubRoutine.Main {
    bad = 0
    ok = SQLite.Open("/tmp/split_w.db")
    IfCondition EqualTo(ok, 0) ThenBlock: {
        PrintMessage("FAIL open\n")
        Exit(1)
    }
    gp = SQLite.GetPost(301)
    IfCondition EqualTo(gp, 0) ThenBlock: {
        PrintMessage("FAIL missing 301 after reopen\n")
        bad = Add(bad, 1)
    }
    IfCondition NotEqual(StringCompare(SQLitePost.body, "hello write"), 0) ThenBlock: {
        PrintMessage("FAIL body=")
        PrintMessage(SQLitePost.body)
        PrintMessage("\n")
        bad = Add(bad, 1)
    }
    IfCondition NotEqual(SQLitePost.likes, 1) ThenBlock: {
        PrintMessage("FAIL likes=")
        PrintNumber(SQLitePost.likes)
        PrintMessage("\n")
        bad = Add(bad, 1)
    }
    nfeed = SQLite.Feed20()
    f0 = SQLite.FeedId(0)
    IfCondition NotEqual(f0, 301) ThenBlock: {
        PrintMessage("FAIL feed0=")
        PrintNumber(f0)
        PrintMessage("\n")
        bad = Add(bad, 1)
    }
    IfCondition EqualTo(bad, 0) ThenBlock: {
        PrintMessage("PASS\n")
    }
    Exit(bad)
}
RunTask(Main)
