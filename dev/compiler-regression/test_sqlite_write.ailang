// Fence: WAL overlay via Hash + btree insert against /tmp/split_w.db
LibraryImport.Arena
LibraryImport.SQLite

SubRoutine.Main {
    bad = 0
    ok = SQLite.Open("/tmp/split_w.db")
    IfCondition EqualTo(ok, 0) ThenBlock: {
        PrintMessage("FAIL open\n")
        Exit(1)
    }
    nid = SQLite.InsertPost(1, "hello write", "2027-01-01T00:00:00.000Z")
    IfCondition NotEqual(nid, 301) ThenBlock: {
        PrintMessage("FAIL new id=")
        PrintNumber(nid)
        PrintMessage("\n")
        bad = Add(bad, 1)
    }
    gp = SQLite.GetPost(301)
    IfCondition EqualTo(gp, 0) ThenBlock: {
        PrintMessage("FAIL get 301\n")
        bad = Add(bad, 1)
    }
    IfCondition NotEqual(SQLite.EqLit(SQLitePost.body, SQLitePost.body_n, "hello write"), 0) ThenBlock: {
        PrintMessage("FAIL body n=")
        PrintNumber(SQLitePost.body_n)
        PrintMessage("\n")
        bad = Add(bad, 1)
    }
    IfCondition NotEqual(SQLite.EqLit(SQLitePost.created, SQLitePost.created_n, "2027-01-01T00:00:00.000Z"), 0) ThenBlock: {
        PrintMessage("FAIL created n=")
        PrintNumber(SQLitePost.created_n)
        PrintMessage("\n")
        bad = Add(bad, 1)
    }
    IfCondition NotEqual(SQLite.EqLit(SQLitePost.author, SQLitePost.author_n, "user_1"), 0) ThenBlock: {
        PrintMessage("FAIL author n=")
        PrintNumber(SQLitePost.author_n)
        PrintMessage("\n")
        bad = Add(bad, 1)
    }
    IfCondition NotEqual(SQLitePost.likes, 0) ThenBlock: {
        PrintMessage("FAIL likes0=")
        PrintNumber(SQLitePost.likes)
        PrintMessage("\n")
        bad = Add(bad, 1)
    }
    nfeed = SQLite.Feed20()
    IfCondition NotEqual(nfeed, 20) ThenBlock: {
        PrintMessage("FAIL feed n=")
        PrintNumber(nfeed)
        PrintMessage("\n")
        bad = Add(bad, 1)
    }
    f0 = SQLite.FeedId(0)
    IfCondition NotEqual(f0, 301) ThenBlock: {
        PrintMessage("FAIL feed0=")
        PrintNumber(f0)
        PrintMessage("\n")
        bad = Add(bad, 1)
    }
    f1 = SQLite.FeedId(1)
    IfCondition NotEqual(f1, 300) ThenBlock: {
        PrintMessage("FAIL feed1=")
        PrintNumber(f1)
        PrintMessage("\n")
        bad = Add(bad, 1)
    }
    lk = SQLite.LikePost(1, 301, "2027-01-01T00:00:00.001Z")
    IfCondition NotEqual(lk, 1) ThenBlock: {
        PrintMessage("FAIL like first=")
        PrintNumber(lk)
        PrintMessage("\n")
        bad = Add(bad, 1)
    }
    SQLite.GetPost(301)
    IfCondition NotEqual(SQLitePost.likes, 1) ThenBlock: {
        PrintMessage("FAIL likes1=")
        PrintNumber(SQLitePost.likes)
        PrintMessage("\n")
        bad = Add(bad, 1)
    }
    lk2 = SQLite.LikePost(1, 301, "2027-01-01T00:00:00.002Z")
    IfCondition NotEqual(lk2, 2) ThenBlock: {
        PrintMessage("FAIL like again=")
        PrintNumber(lk2)
        PrintMessage("\n")
        bad = Add(bad, 1)
    }
    miss = SQLite.LikePost(1, 9999, "2027-01-01T00:00:00.003Z")
    IfCondition NotEqual(miss, 0) ThenBlock: {
        PrintMessage("FAIL like miss=")
        PrintNumber(miss)
        PrintMessage("\n")
        bad = Add(bad, 1)
    }
    g1 = SQLite.GetPost(1)
    IfCondition EqualTo(g1, 0) ThenBlock: {
        PrintMessage("FAIL get 1 after write\n")
        bad = Add(bad, 1)
    }
    IfCondition EqualTo(bad, 0) ThenBlock: {
        PrintMessage("PASS\n")
    }
    Exit(bad)
}
RunTask(Main)
