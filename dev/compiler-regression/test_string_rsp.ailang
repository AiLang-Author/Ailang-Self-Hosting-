LibraryImport.Arena

SubRoutine.Main {
    Arena_Init()
    n = NumberToString(42)
    PrintMessage(n)
    PrintMessage("\n")
    s = StringSubstring("abcdef", 1, 3)
    PrintMessage(s)
    PrintMessage("\n")
    u = StringToUpper("ab")
    PrintMessage(u)
    PrintMessage("\n")
    t = StringTrim(" x ")
    PrintMessage(t)
    PrintMessage("\n")
    c = StringFromChar(65)
    PrintMessage(c)
    PrintMessage("\n")
}

RunTask(Main)
