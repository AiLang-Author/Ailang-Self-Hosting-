// test_struct_verify.ailang — Verify actual SMC state table struct layout
// Reads the firmware's pre-populated state table and checks where
// the initialState, ACPIState, ULVState, and driverState actually live.
//
// Build: ./ailang.x dev/compiler-regression/test_struct_verify.ailang test_struct_verify.x
// Run:   sg video -c "./test_struct_verify.x"

LibraryImport.Arena
LibraryImport.Drivers.AMDGPU.AMDGPUFamily
LibraryImport.Drivers.AMDGPU.AMDGPUDiscover
LibraryImport.Drivers.AMDGPU.AMDGPUBAR
LibraryImport.Drivers.AMDGPU.AMDGPUAtomBIOS
LibraryImport.Drivers.AMDGPU.AMDGPUSMCRegs
LibraryImport.Drivers.AMDGPU.AMDGPUSMC_SI
LibraryImport.Drivers.AMDGPU.AMDGPUSMC
LibraryImport.Drivers.AMDGPU.AMDGPUDisplay

SubRoutine.Main {
    PrintMessage("=== Struct Layout Verification ===\n\n")

    count = GPU_Discover()
    GPU_BAR_Init()
    gi = 0
    WhileLoop LessThan(gi, count) {
        GPU_BAR_MapMMIO(gi)
        gi = Add(gi, 1)
    }

    // Select compute GPU
    gpu = 0
    gi = 0
    WhileLoop LessThan(gi, count) {
        crtc_count = 0
        pipe = 0
        WhileLoop LessThan(pipe, 6) {
            IfCondition EqualTo(DCE6_IsCRTCActive(gi, pipe), 1) ThenBlock: {
                crtc_count = Add(crtc_count, 1)
            }
            pipe = Add(pipe, 1)
        }
        IfCondition EqualTo(crtc_count, 0) ThenBlock: { gpu = gi }
        gi = Add(gi, 1)
    }
    PrintMessage("Using GPU ")
    PrintNumber(gpu)
    PrintMessage("\n\n")

    // Load AtomBIOS
    rom = AtomBIOS_LoadROM(gpu)
    AtomBIOS_Parse(gpu)

    // Load SMC firmware
    smc_rc = SMC_LoadFirmware(gpu)
    PrintMessage("SMC loaded: ")
    PrintNumber(smc_rc)
    PrintMessage("\n")

    // Read firmware header
    state_tbl_addr = SMC_ReadSRAM(gpu, Add(65536, SMCFWHdr.STATE_TABLE))
    PrintMessage("State table SRAM addr: 0x")
    PrintHex(state_tbl_addr)
    PrintMessage("\n\n")

    // Dump the ENTIRE state table area to understand the layout
    // The kernel says the table is 3012 bytes = 753 DWORDs
    // Let's dump 200 DWORDs (800 bytes) which covers header through driverState
    PrintMessage("=== Full state table dump (first 800 bytes) ===\n")
    ri = 0
    WhileLoop LessThan(ri, 200) {
        off = Multiply(ri, 4)
        addr = Add(state_tbl_addr, off)
        val = SMC_ReadSRAM(gpu, addr)
        // Only print non-zero values and key offsets
        IfCondition NotEqual(val, 0) ThenBlock: {
            PrintMessage("  +0x")
            PrintHex(off)
            PrintMessage(" [0x")
            PrintHex(addr)
            PrintMessage("] = 0x")
            PrintHex(val)
            PrintMessage("\n")
        }
        ri = Add(ri, 1)
    }
    PrintMessage("\n")

    // Now let's check specific offsets where states SHOULD be
    // Kernel says:
    //   initialState at +0xB8 (184)   — header should have flags|levelCount
    //   ACPIState at +0x150 (336)
    //   ULVState at +0x1E8 (488)
    //   driverState at +0x280 (640)
    //
    // Our code says:
    //   initialState at +0xB8 (184)   — same
    //   ACPIState at +0x15C (348)     — +12 different
    //   ULVState at +0x200 (512)      — +24 different
    //   driverState at +0x2A4 (676)   — +36 different

    PrintMessage("=== Key offset checks ===\n")
    PrintMessage("\ninitialState (both agree: +0xB8=184):\n")
    PrintMessage("  header: 0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(state_tbl_addr, 184)))
    PrintMessage("\n")

    PrintMessage("\nACPIState (kernel: +0x150=336, ours: +0x15C=348):\n")
    PrintMessage("  kernel(+336): 0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(state_tbl_addr, 336)))
    PrintMessage("\n  ours(+348):   0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(state_tbl_addr, 348)))
    PrintMessage("\n")

    PrintMessage("\nULVState (kernel: +0x1E8=488, ours: +0x200=512):\n")
    PrintMessage("  kernel(+488): 0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(state_tbl_addr, 488)))
    PrintMessage("\n  ours(+512):   0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(state_tbl_addr, 512)))
    PrintMessage("\n")

    PrintMessage("\ndriverState (kernel: +0x280=640, ours: +0x2A4=676):\n")
    PrintMessage("  kernel(+640): 0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(state_tbl_addr, 640)))
    PrintMessage("\n  ours(+676):   0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(state_tbl_addr, 676)))
    PrintMessage("\n")

    // Check what looks like a SWSTATE header
    // A valid SWSTATE header has flags in byte 0 and levelCount in byte 1
    // When read as a BE DWORD: (flags<<24) | (levelCount<<16) | (pad2<<8) | pad3
    // Typical values: flags=0x01(DC) or 0x02(UVD), levelCount=0-25

    // Let's check the HW_PERFORMANCE_LEVEL size by finding adjacent states
    // initialState header at +184 — its level starts at +188
    // If level is 148 bytes: next state at 184 + 4 + 148 = 336 (kernel's ACPIState)
    // If level is 160 bytes: next state at 184 + 4 + 160 = 348 (our ACPIState)

    // We can tell by seeing what's at +336 vs +348
    // If +336 has a valid SWSTATE header and +348 doesn't, then level=148 bytes
    // If +348 has a valid SWSTATE header and +336 doesn't, then level=160 bytes

    PrintMessage("\n=== Level size determination ===\n")
    PrintMessage("If level=148 bytes:\n")
    PrintMessage("  ACPIState header at +336: 0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(state_tbl_addr, 336)))
    PrintMessage("\n  Next DWORD at +340:      0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(state_tbl_addr, 340)))
    PrintMessage("\n")

    PrintMessage("If level=160 bytes:\n")
    PrintMessage("  ACPIState header at +348: 0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(state_tbl_addr, 348)))
    PrintMessage("\n  Next DWORD at +352:      0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(state_tbl_addr, 352)))
    PrintMessage("\n")

    // Cleanup
    gi = 0
    WhileLoop LessThan(gi, count) {
        GPU_BAR_Unmap(gi)
        gi = Add(gi, 1)
    }

    PrintMessage("\n=== Struct Layout Verification Complete ===\n")
    SystemCall(60, 0, 0, 0, 0, 0)
}

RunTask(Main)
