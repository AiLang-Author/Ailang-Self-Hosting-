// test_synth.ailang
// Oscillator bank: waveforms, bit crush, instance handle.
// Build: ./ailang.x dev/compiler-regression/test_synth.ailang /tmp/test_synth.x
// Run:   /tmp/test_synth.x

LibraryImport.Arena
LibraryImport.Media.Synth

FixedPool.TestState {
    "passed": Initialize=0, CanChange=True
    "failed": Initialize=0, CanChange=True
}

Function.Test_Pass {
    Input: name: Address
    Body: {
        PrintMessage("  [PASS] ")
        PrintString(name)
        PrintMessage("\n")
        TestState.passed = Add(TestState.passed, 1)
    }
}

Function.Test_Fail {
    Input: name: Address
    Input: got: Integer
    Input: want: Integer
    Body: {
        PrintMessage("  [FAIL] ")
        PrintString(name)
        PrintMessage(" got=")
        PrintNumber(got)
        PrintMessage(" want=")
        PrintNumber(want)
        PrintMessage("\n")
        TestState.failed = Add(TestState.failed, 1)
    }
}

Function.Test_Assert {
    Input: name: Address
    Input: cond: Integer
    Input: got: Integer
    Input: want: Integer
    Body: {
        IfCondition NotEqual(cond, 0) ThenBlock: {
            Test_Pass(name)
        } ElseBlock: {
            Test_Fail(name, got, want)
        }
    }
}

Function.Test_SineTable {
    Body: {
        PrintMessage("\n[Test] Sine table\n")
        Synth_TabInit()
        z = Synth_SineQ(0)
        Test_Assert("sin 0 = 0", EqualTo(z, 0), z, 0)
        p = Synth_SineQ(64)
        Test_Assert("sin pi/2 = 32767", EqualTo(p, 32767), p, 32767)
        s90 = Synth_Sine8(64)
        Test_Assert("idx 64 +full", EqualTo(s90, 32767), s90, 32767)
        s180 = Synth_Sine8(128)
        Test_Assert("idx 128 ~0", EqualTo(s180, 0), s180, 0)
        s270 = Synth_Sine8(192)
        Test_Assert("idx 192 -full", EqualTo(s270, -32767), s270, -32767)
    }
}

Function.Test_Quant {
    Body: {
        PrintMessage("\n[Test] Bit crush\n")
        q16 = Synth_Quantize(12345, 16)
        Test_Assert("16-bit passthrough", EqualTo(q16, 12345), q16, 12345)
        q8 = Synth_Quantize(12345, 8)
        Test_Assert("8-bit multiple of 256", EqualTo(Modulo(q8, 256), 0), Modulo(q8, 256), 0)
        q4 = Synth_Quantize(12345, 4)
        Test_Assert("4-bit multiple of 4096", EqualTo(Modulo(q4, 4096), 0), Modulo(q4, 4096), 0)
        n4 = Synth_Quantize(-20000, 4)
        Test_Assert("4-bit neg step", EqualTo(Modulo(n4, 4096), 0), Modulo(n4, 4096), 0)
    }
}

Function.Test_Sine440 {
    Body: {
        PrintMessage("\n[Test] 440 Hz sine, 0.1s\n")
        syn = Synth_New(1, 48000)
        Test_Assert("synth handle", NotEqual(syn, 0), syn, 1)
        Synth_VoiceOn(syn, 0, 0, 440, 127)
        frames = 4800
        buf = Allocate(Multiply(frames, 2))
        MemorySet(buf, 0, Multiply(frames, 2))
        Synth_RenderS16(syn, buf, frames)
        zc = Synth_ZeroCross(buf, frames)
        PrintMessage("  zero-crossings=")
        PrintNumber(zc)
        PrintMessage(" (expect ~88)\n")
        Test_Assert("zc >= 70", GreaterEqual(zc, 70), zc, 70)
        Test_Assert("zc <= 110", LessEqual(zc, 110), zc, 110)
        lv = Synth_UniqueLevels(buf, frames)
        PrintMessage("  unique 16-bit levels=")
        PrintNumber(lv)
        PrintMessage("\n")
        Test_Assert("sine many levels", GreaterThan(lv, 40), lv, 40)
        nw = Synth_WriteWav16("/tmp/synth_sine440.wav", buf, frames, 48000)
        Test_Assert("wrote sine wav", GreaterThan(nw, 44), nw, 44)
        Deallocate(buf, Multiply(frames, 2))
        Synth_Free(syn)
    }
}

Function.Test_WavesAndBits {
    Body: {
        PrintMessage("\n[Test] Square / pulse / 4-bit / noise\n")
        syn = Synth_New(1, 48000)
        frames = 2400
        buf = Allocate(Multiply(frames, 2))

        Synth_SetBits(syn, 16)
        Synth_VoiceOn(syn, 0, 1, 220, 127)
        MemorySet(buf, 0, Multiply(frames, 2))
        Synth_RenderS16(syn, buf, frames)
        zc = Synth_ZeroCross(buf, frames)
        PrintMessage("  square zc=")
        PrintNumber(zc)
        PrintMessage("\n")
        Test_Assert("square zc >= 18", GreaterEqual(zc, 18), zc, 18)
        lv16 = Synth_UniqueLevels(buf, frames)
        Test_Assert("square few levels", LessEqual(lv16, 80), lv16, 80)

        Synth_SetBits(syn, 4)
        Synth_VoiceOn(syn, 0, 0, 220, 127)
        MemorySet(buf, 0, Multiply(frames, 2))
        Synth_RenderS16(syn, buf, frames)
        lv4 = Synth_UniqueLevels(buf, frames)
        PrintMessage("  4-bit sine unique=")
        PrintNumber(lv4)
        PrintMessage("\n")
        Test_Assert("4-bit few levels", LessEqual(lv4, 20), lv4, 20)
        Test_Assert("4-bit more than 1", GreaterThan(lv4, 1), lv4, 1)
        Synth_WriteWav16("/tmp/synth_4bit.wav", buf, frames, 48000)

        Synth_SetBits(syn, 16)
        Synth_VoiceOn(syn, 0, 2, 220, 127)
        Synth_SetPulse(syn, 0, 32)
        MemorySet(buf, 0, Multiply(frames, 2))
        Synth_RenderS16(syn, buf, frames)
        zcp = Synth_ZeroCross(buf, frames)
        PrintMessage("  pulse12% zc=")
        PrintNumber(zcp)
        PrintMessage("\n")
        Test_Assert("pulse has edges", GreaterThan(zcp, 10), zcp, 10)
        Synth_WriteWav16("/tmp/synth_pulse.wav", buf, frames, 48000)

        Synth_VoiceOn(syn, 0, 5, 0, 80)
        MemorySet(buf, 0, Multiply(frames, 2))
        Synth_RenderS16(syn, buf, frames)
        lvn = Synth_UniqueLevels(buf, frames)
        Test_Assert("noise not silent", GreaterThan(lvn, 0), lvn, 0)
        Synth_WriteWav16("/tmp/synth_noise.wav", buf, frames, 48000)

        Deallocate(buf, Multiply(frames, 2))
        Synth_Free(syn)
    }
}

Function.Test_Poly {
    Body: {
        PrintMessage("\n[Test] Two voices, one instance\n")
        syn = Synth_New(2, 48000)
        Synth_VoiceOn(syn, 0, 0, 440, 60)
        Synth_VoiceOn(syn, 1, 0, 550, 60)
        frames = 2400
        buf = Allocate(Multiply(frames, 2))
        MemorySet(buf, 0, Multiply(frames, 2))
        Synth_RenderS16(syn, buf, frames)
        zc = Synth_ZeroCross(buf, frames)
        PrintMessage("  dyad zc=")
        PrintNumber(zc)
        PrintMessage("\n")
        Test_Assert("poly not silent", GreaterThan(zc, 20), zc, 20)
        Synth_WriteWav16("/tmp/synth_dyad.wav", buf, frames, 48000)
        Deallocate(buf, Multiply(frames, 2))
        Synth_Free(syn)
    }
}

Function.Test_VoicePool {
    Body: {
        PrintMessage("\n[Test] Voice pool alloc / channel\n")
        syn = Synth_New(32, 48000)
        nv = Synth_VoiceCount(syn)
        Test_Assert("pool 32", EqualTo(nv, 32), nv, 32)
        a = Synth_AllocVoice(syn, 60, 0)
        Synth_VoiceOnNote(syn, a, 0, 60, 80)
        b = Synth_AllocVoice(syn, 64, 0)
        Synth_VoiceOnNote(syn, b, 0, 64, 80)
        c = Synth_AllocVoice(syn, 60, 1)
        Synth_VoiceOnNote(syn, c, 0, 60, 80)
        Test_Assert("idle not always 0", NotEqual(b, a), b, a)
        Test_Assert("same note other ch new", NotEqual(c, a), c, a)
        r = Synth_AllocVoice(syn, 60, 0)
        Test_Assert("retrigger same ch", EqualTo(r, a), r, a)
        chb = Synth_VoiceCh(syn, b)
        Test_Assert("voice b ch 0", EqualTo(chb, 0), chb, 0)
        chc = Synth_VoiceCh(syn, c)
        Test_Assert("voice c ch 1", EqualTo(chc, 1), chc, 1)
        Synth_NoteOff(syn, 60, 0)
        Synth_NoteOff(syn, 64, 0)
        Synth_NoteOff(syn, 60, 1)
        Synth_Free(syn)
    }
}

Function.Test_Osc2 {
    Body: {
        PrintMessage("\n[Test] Dual osc mix / octave\n")
        syn = Synth_New(1, 48000)
        Synth_VoiceOn(syn, 0, 3, 220, 100)
        Synth_SetOsc2(syn, 0, 1, 0, 3)
        v = Synth_Voice(syn, 0)
        st_off = Add(v, 8)
        st = Dereference(st_off)
        st2_off = Add(v, 120)
        st2 = Dereference(st2_off)
        Test_Assert("osc2 octave step higher", GreaterThan(st2, st), st2, st)
        w2 = GetByte(v, 36)
        Test_Assert("wave2 square", EqualTo(w2, 1), w2, 1)
        Synth_SetOsc2(syn, 0, 4, 200, 2)
        mix_off = Add(v, 232)
        mix = Dereference(mix_off, "dword")
        Test_Assert("osc mix 200", EqualTo(mix, 200), mix, 200)
        Synth_SetLFOTaps(syn, 0, 90, 40)
        lf_off = Add(v, 248)
        lf = Dereference(lf_off, "dword")
        Test_Assert("lfo filt 90", EqualTo(lf, 90), lf, 90)
        la_off = Add(v, 256)
        la = Dereference(la_off, "dword")
        Test_Assert("lfo amp 40", EqualTo(la, 40), la, 40)
        Synth_SetADSR(syn, 0, 10, 80, 128, 200)
        sus_off = Add(v, 64)
        sus = Dereference(sus_off, "dword")
        Test_Assert("sustain half", EqualTo(sus, 32768), sus, 32768)
        Synth_Free(syn)
    }
}

Function.Test_NesTri {
    Body: {
        PrintMessage("\n[Test] NES triangle\n")
        syn = Synth_New(1, 48000)
        Synth_VoiceOn(syn, 0, 6, 220, 127)
        frames = 2400
        buf = Allocate(Multiply(frames, 2))
        MemorySet(buf, 0, Multiply(frames, 2))
        Synth_RenderS16(syn, buf, frames)
        lv = Synth_UniqueLevels(buf, frames)
        PrintMessage("  nes-tri unique=")
        PrintNumber(lv)
        PrintMessage("\n")
        Test_Assert("nes-tri stepped", LessEqual(lv, 20), lv, 20)
        Test_Assert("nes-tri living", GreaterThan(lv, 4), lv, 4)
        Synth_WriteWav16("/tmp/synth_nestri.wav", buf, frames, 48000)
        Deallocate(buf, Multiply(frames, 2))
        Synth_Free(syn)
    }
}

SubRoutine.Main {
    Arena_Init()
    PrintMessage("============================================\n")
    PrintMessage("  AILANG synth oscillator test\n")
    PrintMessage("============================================\n")
    Test_SineTable()
    Test_Quant()
    Test_Sine440()
    Test_WavesAndBits()
    Test_Poly()
    Test_VoicePool()
    Test_Osc2()
    Test_NesTri()
    PrintMessage("\n============================================\n")
    PrintMessage("  Results: ")
    PrintNumber(TestState.passed)
    PrintMessage(" passed, ")
    PrintNumber(TestState.failed)
    PrintMessage(" failed\n")
    PrintMessage("============================================\n")
    IfCondition GreaterThan(TestState.failed, 0) ThenBlock: {
        PrintMessage("  FAIL\n")
    } ElseBlock: {
        PrintMessage("  ALL PASS\n")
    }
}

RunTask(Main)
