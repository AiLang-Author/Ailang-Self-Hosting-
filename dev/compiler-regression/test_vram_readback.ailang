// test_vram_readback.ailang — §35 post-run VRAM content check (READ-ONLY)
// Build: ./ailang.x dev/compiler-regression/test_vram_readback.ailang test_vram_readback
// Run:   sudo ./test_vram_readback          (from repo root, SAME BOOT as the
//                                            §35 replay run — do NOT reboot first)
//
// Question it answers: did the §34/§35 CPU→FB-BAR content writes actually land
// in VRAM now that HDP_HOST_PATH_CNTL/HDP_MISC_CNTL are configured (seq 130/131)?
// The replay harness prints "content loaded" but never reads back. This test
// re-reads VRAM 0x201000 (RLC SR, 218 dw) and 0x202000 (RLC CSB, 972 dw) and
// diffs them against the same .bin files the harness wrote from.
//
// ZERO writes to the card: MMIO reads + FB-BAR reads only. No cold guard —
// it REQUIRES the posted, post-replay state (CONFIG_MEMSIZE must be 0x400).
//
// Interpretation:
//   mismatches=0 on both  → content landed intact. CPU→VRAM path works with
//                           HDP configured; "RLC halts on garbage CSB" is dead.
//   garbage/partial       → ambiguous (write path vs readback path) but HDP
//                           alone did not fix CPU→VRAM; note Known Issue 2
//                           readback caveats.

LibraryImport.Drivers.AMDGPU.AMDGPUFamily
LibraryImport.Drivers.AMDGPU.AMDGPUDiscover
LibraryImport.Drivers.AMDGPU.AMDGPUBAR

// Load a .bin of LE dwords and diff it against VRAM at vram_off.
// Prints first 8 dwords (want vs got) + first 4 mismatch offsets.
// Returns mismatch count, -1 on file error.
Function.ReadbackCompare {
    Input: gpu: Integer
    Input: path: Integer
    Input: vram_off: Integer
    Output: Integer
    Body: {
        rb_fd = SystemCall(2, path, 0, 0)
        IfCondition LessThan(rb_fd, 0) ThenBlock: { ReturnValue(-1) }
        rb_size = SystemCall(8, rb_fd, 0, 2)
        SystemCall(8, rb_fd, 0, 0)
        rb_buf = Allocate(rb_size)
        IfCondition EqualTo(rb_buf, 0) ThenBlock: {
            SystemCall(3, rb_fd)
            ReturnValue(-1)
        }
        rb_got = SystemCall(0, rb_fd, rb_buf, rb_size)
        SystemCall(3, rb_fd)
        IfCondition NotEqual(rb_got, rb_size) ThenBlock: {
            Deallocate(rb_buf, rb_size)
            ReturnValue(-1)
        }
        rb_n = Divide(rb_size, 4)
        rb_mis = 0
        rb_shown = 0
        rb_i = 0
        WhileLoop LessThan(rb_i, rb_n) {
            rb_want = Dereference(Add(rb_buf, Multiply(rb_i, 4)), "dword")
            rb_have = GPU_VramRd32(gpu, Add(vram_off, Multiply(rb_i, 4)))
            IfCondition LessThan(rb_i, 8) ThenBlock: {
                PrintMessage("[RB]   dw ")
                PrintNumber(rb_i)
                PrintMessage(": want=0x")
                PrintHex(rb_want)
                PrintMessage(" got=0x")
                PrintHex(rb_have)
                PrintMessage("\n")
            }
            IfCondition NotEqual(rb_want, rb_have) ThenBlock: {
                rb_mis = Add(rb_mis, 1)
                IfCondition LessThan(rb_shown, 4) ThenBlock: {
                    IfCondition GreaterEqual(rb_i, 8) ThenBlock: {
                        PrintMessage("[RB]   MIS dw ")
                        PrintNumber(rb_i)
                        PrintMessage(": want=0x")
                        PrintHex(rb_want)
                        PrintMessage(" got=0x")
                        PrintHex(rb_have)
                        PrintMessage("\n")
                        rb_shown = Add(rb_shown, 1)
                    }
                }
            }
            rb_i = Add(rb_i, 1)
        }
        Deallocate(rb_buf, rb_size)
        PrintMessage("[RB] total dw=")
        PrintNumber(rb_n)
        PrintMessage(" mismatches=")
        PrintNumber(rb_mis)
        PrintMessage("\n")
        ReturnValue(rb_mis)
    }
}

SubRoutine.Main {
    PrintMessage("=== §35 VRAM CONTENT READBACK (read-only, bus 2 only) ===\n")

    n_gpus = GPU_Discover()
    IfCondition EqualTo(n_gpus, 0) ThenBlock: {
        PrintMessage("[RB] no AMD GPU found\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }
    gpu = -1
    gi = 0
    WhileLoop LessThan(gi, n_gpus) {
        bus = GPU_GetDeviceField(gi, GPUDevField.PCI_BUS)
        IfCondition EqualTo(bus, 2) ThenBlock: { gpu = gi }
        gi = Add(gi, 1)
    }
    IfCondition LessThan(gpu, 0) ThenBlock: {
        PrintMessage("[RB] ABORT: bus 2 not found — refusing any other GPU\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }
    PrintMessage("[RB] using GPU ")
    PrintNumber(gpu)
    PrintMessage(" (bus 2)\n")

    GPU_BAR_Init()
    rc = GPU_BAR_MapMMIO(gpu)
    IfCondition EqualTo(rc, 0) ThenBlock: {
        PrintMessage("[RB] MMIO map failed\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }
    rc = GPU_BAR_MapVRAM(gpu)
    IfCondition EqualTo(rc, 0) ThenBlock: {
        PrintMessage("[RB] VRAM map failed\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }

    // Must be the SAME boot the replay ran on: card posted, MC trained.
    cm = GPU_Rd32(gpu, 0x5428)
    PrintMessage("[RB] CONFIG_MEMSIZE=0x")
    PrintHex(cm)
    PrintMessage("\n")
    IfCondition EqualTo(cm, 0) ThenBlock: {
        PrintMessage("[RB] ABORT: card is UNPOSTED — this is a fresh boot, the replay's\n")
        PrintMessage("[RB] VRAM content is gone. Run this immediately after the replay, no reboot.\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }

    rlc = GPU_Rd32(gpu, 0xC34C)
    PrintMessage("[RB] RLC_STAT=0x")
    PrintHex(rlc)
    PrintMessage(" (still-parked baseline from the replay run)\n")

    // GART table quality signal: PTE[0..3] at VRAM 0 (dummy-page entries from
    // GART_Init's fill — garbage/0xFFFFFFFF here = readback or write path bad).
    PrintMessage("[RB] --- VRAM 0x0 PTE dump (GART table head) ---\n")
    pi = 0
    WhileLoop LessThan(pi, 8) {
        pv = GPU_VramRd32(gpu, Multiply(pi, 4))
        PrintMessage("[RB]   +0x")
        PrintHex(Multiply(pi, 4))
        PrintMessage(" = 0x")
        PrintHex(pv)
        PrintMessage("\n")
        pi = Add(pi, 1)
    }

    PrintMessage("[RB] --- RLC SR content @ VRAM 0x201000 ---\n")
    sr_mis = ReadbackCompare(gpu, "fw_trace/RLC_SR_CONTENT.bin", 0x201000)
    PrintMessage("[RB] --- RLC CSB content @ VRAM 0x202000 ---\n")
    csb_mis = ReadbackCompare(gpu, "fw_trace/RLC_CSB_CONTENT.bin", 0x202000)

    PrintMessage("\n[RB] ============ VERDICT ============\n")
    IfCondition EqualTo(sr_mis, 0) ThenBlock: {
        IfCondition EqualTo(csb_mis, 0) ThenBlock: {
            PrintMessage("[RB] SR+CSB INTACT: CPU->VRAM path works with HDP configured.\n")
            PrintMessage("[RB] Thread (b) content DID land; RLC is dead for another reason.\n")
        } ElseBlock: {
            PrintMessage("[RB] SR intact, CSB corrupt: partial landing — see MIS lines.\n")
        }
    } ElseBlock: {
        PrintMessage("[RB] CONTENT DID NOT SURVIVE (or readback path still bad).\n")
        PrintMessage("[RB] HDP alone did not fix CPU->VRAM; Known Issue 2 caveats apply.\n")
    }
    PrintMessage("[RB] =================================\n")

    SystemCall(60, 0, 0, 0, 0, 0)
}

RunTask(Main)
