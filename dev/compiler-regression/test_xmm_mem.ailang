// A scaled qword dereference used by a float operation stays a memory
// operand. The stepped value and the direct load must agree, including
// subtract and divide order, a left-hand load of a commutative op, an
// index that is not a bare name, and a second table beside the homed one.

LibraryImport.Arena

FixedPool.XmmMem {
    "fails": Initialize=0, CanChange=True
}

Function.Expect {
    Input: got: Integer
    Input: want: Integer
    Body: {
        IfCondition NotEqual(got, want) ThenBlock: {
            PrintMessage("FAIL got ")
            PrintNumber(got)
            PrintMessage(" want ")
            PrintNumber(want)
            PrintMessage("\n")
            XmmMem.fails = Add(XmmMem.fails, 1)
        }
    }
}

SubRoutine.Main {
    one = Float_FromInt(1)
    two = Float_FromInt(2)
    three = Float_FromInt(3)
    four = Float_FromInt(4)
    eight = Float_FromInt(8)
    buf = Allocate(64)
    other = Allocate(64)
    StoreValue(buf, one)
    StoreValue(Add(buf, 8), two)
    StoreValue(Add(buf, 16), four)
    StoreValue(Add(buf, 24), eight)
    StoreValue(other, three)
    StoreValue(Add(other, 8), four)
    StoreValue(Add(other, 16), one)
    StoreValue(Add(other, 24), two)

    // Straight line. No loop home, so the base is reloaded.
    z = 0
    off8 = 8
    got = Float_Mul(two, Dereference(Add(buf, Multiply(z, 8))))
    Expect(got, two)
    got = Float_Mul(Dereference(Add(buf, Multiply(z, 8))), four)
    Expect(got, four)
    got = Float_Add(Dereference(Add(buf, Multiply(off8, 1))), one)
    Expect(got, three)
    got = Float_Sub(Dereference(Add(buf, Multiply(z, 8))), three)
    Expect(got, Float_Neg(two))
    got = Float_Sub(three, Dereference(Add(buf, Multiply(z, 8))))
    Expect(got, two)
    got = Float_Div(Dereference(Add(buf, Multiply(z, 8))), two)
    Expect(got, Float_Div(one, two))
    got = Float_Div(four, Dereference(Add(buf, Multiply(off8, 1))))
    Expect(got, two)
    got = Float_Min(Dereference(Add(buf, Multiply(z, 8))), three)
    Expect(got, one)
    got = Float_Max(three, Dereference(Add(buf, Multiply(off8, 1))))
    Expect(got, three)

    // Scale 4 steps four bytes. Index 2 lands on the second qword.
    two_i = 2
    got = Float_Mul(one, Dereference(Add(buf, Multiply(two_i, 4))))
    Expect(got, two)

    // Index is an add, not a bare name. j is counted up so it is not folded.
    j = 0
    t = 0
    WhileLoop LessThan(t, 1) {
        j = Add(j, 0)
        t = Add(t, 1)
    }
    got = Float_Mul(four, Dereference(Add(buf, Multiply(Add(j, 1), 8))))
    Expect(got, eight)

    // Homed table plus a second table. The second load must not steal the
    // first table's register for the next iteration.
    sum = Float_FromInt(0)
    j = 0
    WhileLoop LessThan(j, 4) {
        coef = Float_FromInt(Add(j, 1))
        item = Float_Mul(coef, Dereference(Add(buf, Multiply(j, 8))))
        sum = Float_Add(sum, item)
        extra = Float_Mul(one, Dereference(Add(other, Multiply(j, 8))))
        sum = Float_Add(sum, extra)
        j = Add(j, 1)
    }
    // buf: 1*1 + 2*2 + 3*4 + 4*8 = 1+4+12+32 = 49
    // other: 3+4+1+2 = 10
    Expect(sum, Float_FromInt(59))

    // Same loop with subtract on the right and divide on the right.
    diff = Float_FromInt(0)
    j = 0
    WhileLoop LessThan(j, 2) {
        piece = Float_Sub(eight, Dereference(Add(buf, Multiply(j, 8))))
        diff = Float_Add(diff, piece)
        j = Add(j, 1)
    }
    // (8-1) + (8-2) = 13
    Expect(diff, Float_FromInt(13))

    quot = Float_FromInt(0)
    j = 0
    WhileLoop LessThan(j, 2) {
        piece = Float_Div(eight, Dereference(Add(buf, Multiply(j, 8))))
        quot = Float_Add(quot, piece)
        j = Add(j, 1)
    }
    // 8/1 + 8/2 = 12
    Expect(quot, Float_FromInt(12))

    // Left-hand subtract must stay load-minus-value, not the swap.
    neg = Float_FromInt(0)
    j = 0
    WhileLoop LessThan(j, 1) {
        neg = Float_Sub(Dereference(Add(buf, Multiply(j, 8))), eight)
        j = Add(j, 1)
    }
    Expect(neg, Float_Neg(Float_FromInt(7)))

    PrintMessage("fails ")
    PrintNumber(XmmMem.fails)
    PrintMessage("\n")
    ProcessExit(XmmMem.fails)
}

RunTask(Main)
