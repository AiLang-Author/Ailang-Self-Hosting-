// A float operation keeps a leaf, a float home, or an integer-only
// operand in xmm. The stepped form and the nested form must agree,
// including subtraction order and a held value used on the right.

LibraryImport.Arena

FixedPool.XmmCheck {
    "fails": Initialize=0, CanChange=True
}

Function.Expect {
    Input: got: Integer
    Input: want: Integer
    Body: {
        IfCondition NotEqual(got, want) ThenBlock: {
            PrintMessage("FAIL got ")
            PrintNumber(got)
            PrintMessage(" want ")
            PrintNumber(want)
            PrintMessage("\n")
            XmmCheck.fails = Add(XmmCheck.fails, 1)
        }
    }
}

SubRoutine.Main {
    one = Float_FromInt(1)
    three = Float_FromInt(3)
    two = Float_FromInt(2)
    five = Float_FromInt(5)
    buf = Allocate(16)
    StoreValue(buf, three)
    StoreValue(Add(buf, 8), five)

    left = Float_Sub(five, two)
    Expect(left, three)
    swapped = Float_Sub(two, five)
    Expect(swapped, Float_Neg(three))

    step = Float_Div(three, two)
    nested = Float_Div(Dereference(buf), Float_FromInt(2))
    Expect(nested, step)

    prod = Float_Mul(Float_Div(one, two), Dereference(buf))
    Expect(prod, step)

    both = Float_Add(Float_Div(one, two), Float_Div(one, two))
    Expect(both, one)

    root = Float_Sqrt(Float_FromInt(4))
    Expect(root, two)
    absn = Float_Abs(Float_Neg(three))
    Expect(absn, three)

    held = Float_Mul(three, Float_FromInt(4))
    right = Float_Mul(two, held)
    Expect(right, Float_FromInt(24))

    sum = Float_FromInt(0)
    i = 0
    WhileLoop LessThan(i, 4) {
        den = Float_FromInt(2)
        a = Float_Div(one, den)
        uj = Dereference(Add(buf, Multiply(i, 0)))
        item = Float_Mul(a, uj)
        sum = Float_Add(sum, item)
        i = Add(i, 1)
    }
    Expect(sum, Float_FromInt(6))

    q = 0
    k = 0
    WhileLoop LessThan(k, 1) {
        n = Negate(5)
        q = Divide(n, 4)
        k = Add(k, 1)
    }
    Expect(q, Negate(1))

    PrintMessage("fails ")
    PrintNumber(XmmCheck.fails)
    PrintMessage("\n")
    ProcessExit(XmmCheck.fails)
}

RunTask(Main)
