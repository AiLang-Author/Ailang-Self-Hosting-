// Read one Markdown file and print CommonMark HTML.
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Markdown.MD

Function.ArgAt {
    Input: buf: Address
    Input: n: Integer
    Input: which: Integer
    Output: Address
    Body: {
        pos = 0
        seen = 0
        WhileLoop LessThan(pos, n) {
            b = RDMEM_8(Add(buf, pos))
            IfCondition EqualTo(b, 0) ThenBlock: {
                pos = Add(pos, 1)
                seen = Add(seen, 1)
            } ElseBlock: {
                IfCondition EqualTo(seen, which) ThenBlock: {
                    ReturnValue(Add(buf, pos))
                }
                moving = 1
                WhileLoop EqualTo(moving, 1) {
                    b2 = RDMEM_8(Add(buf, pos))
                    IfCondition EqualTo(b2, 0) ThenBlock: {
                        moving = 0
                    } ElseBlock: {
                        pos = Add(pos, 1)
                    }
                }
            }
        }
        ReturnValue(0)
    }
}

SubRoutine.Main {
    cmd = "/proc/self/cmdline"
    fd = SystemCall(257, -100, cmd, 0, 0)
    IfCondition LessThan(fd, 0) ThenBlock: {
        ProcessExit(1)
    }
    cbuf = Allocate(8192)
    cn = SystemCall(0, fd, cbuf, 8192)
    SystemCall(3, fd)
    IfCondition LessEqual(cn, 0) ThenBlock: {
        ProcessExit(1)
    }
    path = ArgAt(cbuf, cn, 1)
    IfCondition EqualTo(path, 0) ThenBlock: {
        ProcessExit(1)
    }
    ffd = SystemCall(257, -100, path, 0, 0)
    IfCondition LessThan(ffd, 0) ThenBlock: {
        ProcessExit(1)
    }
    cap = 4194304
    buf = Allocate(cap)
    n = SystemCall(0, ffd, buf, cap)
    SystemCall(3, ffd)
    IfCondition LessThan(n, 0) ThenBlock: {
        ProcessExit(1)
    }
    out = MD.ToHTML(buf, n)
    IfCondition EqualTo(out, 0) ThenBlock: {
        PrintMessage("")
        ProcessExit(0)
    }
    PrintMessage(out)
    ProcessExit(0)
}

RunTask(Main)
