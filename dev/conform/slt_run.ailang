// Verify-mode sqllogictest runner. Engine name is "sqlite".
// One script per process. Results are formatted, sorted, and hashed
// the way src/sqllogictest.c compares them.
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.SQLiteSQL.SQLEngine
LibraryImport.SQLiteSQL.SQLMD5

FixedPool.SLTS {
    "buf": Initialize=0, CanChange=True
    "iend": Initialize=0, CanChange=True
    "icur": Initialize=0, CanChange=True
    "inext": Initialize=0, CanChange=True
    "nline": Initialize=0, CanChange=True
    "zline": Initialize=0, CanChange=True
    "len": Initialize=0, CanChange=True
    "t0": Initialize=0, CanChange=True
    "t1": Initialize=0, CanChange=True
    "t2": Initialize=0, CanChange=True
    "t3": Initialize=0, CanChange=True
    "ht": Initialize=8, CanChange=True
    "nerr": Initialize=0, CanChange=True
    "ncmd": Initialize=0, CanChange=True
    "nskip": Initialize=0, CanChange=True
    "labels": Initialize=0, CanChange=True
    "path": Initialize=0, CanChange=True
    "start": Initialize=0, CanChange=True
    "sql": Initialize=0, CanChange=True
    "sqn": Initialize=0, CanChange=True
    "sqcap": Initialize=0, CanChange=True
    "empty": Initialize=0, CanChange=True
    "stop": Initialize=0, CanChange=True
    "mflat": Initialize=0, CanChange=True
    "mncol": Initialize=0, CanChange=True
    "msrc": Initialize=0, CanChange=True
    "mdst": Initialize=0, CanChange=True
}

Function.SLT.ArgAt {
    Input: buf: Address
    Input: n: Integer
    Input: which: Integer
    Output: Address
    Body: {
        pos = 0
        seen = 0
        WhileLoop LessThan(pos, n) {
            b = RDMEM_8(Add(buf, pos))
            IfCondition EqualTo(b, 0) ThenBlock: {
                pos = Add(pos, 1)
                seen = Add(seen, 1)
            } ElseBlock: {
                IfCondition EqualTo(seen, which) ThenBlock: {
                    ReturnValue(Add(buf, pos))
                }
                moving = 1
                WhileLoop EqualTo(moving, 1) {
                    b2 = RDMEM_8(Add(buf, pos))
                    IfCondition EqualTo(b2, 0) ThenBlock: {
                        moving = 0
                    } ElseBlock: {
                        pos = Add(pos, 1)
                    }
                }
            }
        }
        ReturnValue(0)
    }
}

Function.SLT.Begin {
    Body: {
        SLTS.t0 = Allocate(200)
        SLTS.t1 = Allocate(200)
        SLTS.t2 = Allocate(200)
        SLTS.t3 = Allocate(200)
        WRMEM_8(SLTS.t0, 0, 0)
        WRMEM_8(SLTS.t1, 0, 0)
        WRMEM_8(SLTS.t2, 0, 0)
        WRMEM_8(SLTS.t3, 0, 0)
        SLTS.empty = Allocate(1)
        WRMEM_8(SLTS.empty, 0, 0)
        SLTS.zline = SLTS.empty
        SLTS.ht = 8
        SLTS.nerr = 0
        SLTS.ncmd = 0
        SLTS.nskip = 0
        SLTS.stop = 0
        SLTS.start = 0
        SLTS.icur = 0
        SLTS.inext = 0
        SLTS.labels = Hash.New()
    }
}

Function.SLT.Load {
    Input: path: Address
    Output: Integer
    Body: {
        SLTS.path = path
        fd = SystemCall(257, -100, path, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("ERROR open ")
            PrintMessage(path)
            PrintMessage("\n")
            ReturnValue(0)
        }
        st = Allocate(256)
        MemorySet(st, 0, 256)
        rc = SystemCall(5, fd, st)
        IfCondition LessThan(rc, 0) ThenBlock: {
            SystemCall(3, fd)
            Deallocate(st, 256)
            PrintMessage("ERROR stat\n")
            ReturnValue(0)
        }
        sz = RDMEM_64(st, 48)
        Deallocate(st, 256)
        buf = Allocate(Add(sz, 1))
        IfCondition EqualTo(buf, 0) ThenBlock: {
            SystemCall(3, fd)
            PrintMessage("ERROR memory\n")
            ReturnValue(0)
        }
        got = 0
        bad = 0
        WhileLoop And(LessThan(got, sz), EqualTo(bad, 0)) {
            n = SystemCall(0, fd, Add(buf, got), Subtract(sz, got))
            IfCondition LessEqual(n, 0) ThenBlock: { bad = 1 }
            IfCondition GreaterThan(n, 0) ThenBlock: { got = Add(got, n) }
        }
        SystemCall(3, fd)
        IfCondition EqualTo(bad, 1) ThenBlock: {
            PrintMessage("ERROR read\n")
            ReturnValue(0)
        }
        WRMEM_8(buf, got, 0)
        SLTS.buf = buf
        SLTS.iend = got
        SLTS.icur = 0
        SLTS.inext = 0
        SLTS.nline = 0
        SLTS.len = 0
        SLTS.zline = SLTS.empty
        ReturnValue(1)
    }
}

Function.SLT.Space {
    Input: c: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(c, 32) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(c, 9) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(c, 10) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(c, 11) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(c, 12) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(c, 13) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.SLT.Eq {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(StringCompare(a, b), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.SLT.EqFold {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        i = 0
        WhileLoop EqualTo(1, 1) {
            ca = RDMEM_8(a, i)
            cb = RDMEM_8(b, i)
            IfCondition And(GreaterEqual(ca, 65), LessEqual(ca, 90)) ThenBlock: { ca = Add(ca, 32) }
            IfCondition And(GreaterEqual(cb, 65), LessEqual(cb, 90)) ThenBlock: { cb = Add(cb, 32) }
            IfCondition NotEqual(ca, cb) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(ca, 0) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.SLT.IntText {
    Input: i: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(i, 0) ThenBlock: { ReturnValue("0") }
        neg = 0
        n = i
        IfCondition LessThan(n, 0) ThenBlock: {
            neg = 1
            n = Negate(n)
        }
        buf = Allocate(32)
        k = 31
        WRMEM_8(buf, 31, 0)
        WhileLoop GreaterThan(n, 0) {
            k = Subtract(k, 1)
            WRMEM_8(buf, k, Add(48, Modulo(n, 10)))
            n = Divide(n, 10)
        }
        IfCondition EqualTo(neg, 1) ThenBlock: {
            k = Subtract(k, 1)
            WRMEM_8(buf, k, 45)
        }
        ReturnValue(Add(buf, k))
    }
}

Function.SLT.Atoi {
    Input: s: Address
    Output: Integer
    Body: {
        i = 0
        n = 0
        WhileLoop And(GreaterEqual(RDMEM_8(s, i), 48), LessEqual(RDMEM_8(s, i), 57)) {
            n = Add(Multiply(n, 10), Subtract(RDMEM_8(s, i), 48))
            i = Add(i, 1)
        }
        back = Add(n, 0)
        ReturnValue(back)
    }
}

Function.SLT.Copy {
    Input: s: Address
    Output: Address
    Body: {
        n = StringLength(s)
        p = Allocate(Add(n, 1))
        MemoryCopy(p, s, Add(n, 1))
        ReturnValue(p)
    }
}

Function.SLT.FailAt {
    Input: line: Integer
    Input: msg: Address
    Body: {
        PrintMessage(SLTS.path)
        PrintMessage(":")
        PrintMessage(SLT.IntText(line))
        PrintMessage(": ")
        PrintMessage(msg)
        SLTS.nerr = Add(SLTS.nerr, 1)
    }
}

Function.SLT.Fail {
    Input: msg: Address
    Body: {
        SLT.FailAt(SLTS.start, msg)
    }
}

Function.SLT.NextLine {
    Output: Integer
    Body: {
        WhileLoop EqualTo(1, 1) {
            IfCondition GreaterEqual(SLTS.inext, SLTS.iend) ThenBlock: {
                SLTS.icur = SLTS.iend
                SLTS.zline = Add(SLTS.buf, SLTS.iend)
                SLTS.len = 0
                ReturnValue(0)
            }
            SLTS.icur = SLTS.inext
            SLTS.nline = Add(SLTS.nline, 1)
            SLTS.zline = Add(SLTS.buf, SLTS.icur)
            i = SLTS.icur
            WhileLoop And(LessThan(i, SLTS.iend), NotEqual(RDMEM_8(SLTS.buf, i), 10)) {
                i = Add(i, 1)
            }
            WRMEM_8(SLTS.buf, i, 0)
            SLTS.len = Subtract(i, SLTS.icur)
            SLTS.inext = Add(i, 1)
            IfCondition GreaterThan(SLTS.len, 0) ThenBlock: {
                last = Subtract(Add(SLTS.icur, SLTS.len), 1)
                IfCondition EqualTo(RDMEM_8(SLTS.buf, last), 13) ThenBlock: {
                    WRMEM_8(SLTS.buf, last, 0)
                    SLTS.len = Subtract(SLTS.len, 1)
                }
            }
            blank = 1
            IfCondition GreaterThan(SLTS.len, 0) ThenBlock: {
                j = Subtract(Add(SLTS.icur, SLTS.len), 1)
                WhileLoop And(GreaterEqual(j, SLTS.icur), EqualTo(blank, 1)) {
                    IfCondition EqualTo(SLT.Space(RDMEM_8(SLTS.buf, j)), 0) ThenBlock: { blank = 0 }
                    j = Subtract(j, 1)
                }
            }
            IfCondition EqualTo(blank, 1) ThenBlock: {
                WRMEM_8(SLTS.zline, 0, 0)
                SLTS.len = 0
            }
            IfCondition NotEqual(RDMEM_8(SLTS.zline, 0), 35) ThenBlock: {
                ReturnValue(1)
            }
        }
        ReturnValue(0)
    }
}

Function.SLT.NextBlank {
    Output: Integer
    Body: {
        i = SLTS.inext
        IfCondition GreaterEqual(i, SLTS.iend) ThenBlock: { ReturnValue(1) }
        WhileLoop LessThan(i, SLTS.iend) {
            c = RDMEM_8(SLTS.buf, i)
            IfCondition EqualTo(SLT.Space(c), 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(c, 10) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.SLT.Find {
    Output: Integer
    Body: {
        IfCondition GreaterThan(SLTS.icur, 0) ThenBlock: {
            WhileLoop And(NotEqual(RDMEM_8(SLTS.zline, 0), 0), LessThan(SLTS.icur, SLTS.iend)) {
                SLT.NextLine()
            }
        } ElseBlock: {
            SLT.NextLine()
        }
        WhileLoop And(EqualTo(RDMEM_8(SLTS.zline, 0), 0), LessThan(SLTS.icur, SLTS.iend)) {
            SLT.NextLine()
        }
        out = 0
        IfCondition LessThan(SLTS.icur, SLTS.iend) ThenBlock: { out = 1 }
        back = Add(out, 0)
        ReturnValue(back)
    }
}

Function.SLT.TokPtr {
    Input: i: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(i, 0) ThenBlock: { ReturnValue(SLTS.t0) }
        IfCondition EqualTo(i, 1) ThenBlock: { ReturnValue(SLTS.t1) }
        IfCondition EqualTo(i, 2) ThenBlock: { ReturnValue(SLTS.t2) }
        ReturnValue(SLTS.t3)
    }
}

Function.SLT.Tokenize {
    Body: {
        WRMEM_8(SLTS.t0, 0, 0)
        WRMEM_8(SLTS.t1, 0, 0)
        WRMEM_8(SLTS.t2, 0, 0)
        WRMEM_8(SLTS.t3, 0, 0)
        SLTS.start = SLTS.nline
        j = 0
        slot = 0
        WhileLoop And(LessThan(j, SLTS.len), LessThan(slot, 4)) {
            k = 0
            WhileLoop EqualTo(SLT.Space(RDMEM_8(SLTS.zline, Add(j, k))), 1) {
                k = Add(k, 1)
            }
            j = Add(j, k)
            n = 0
            WhileLoop And(NotEqual(RDMEM_8(SLTS.zline, Add(j, n)), 0), EqualTo(SLT.Space(RDMEM_8(SLTS.zline, Add(j, n))), 0)) {
                n = Add(n, 1)
            }
            copy = n
            IfCondition GreaterEqual(copy, 199) ThenBlock: { copy = 199 }
            dest = SLT.TokPtr(slot)
            c = 0
            WhileLoop LessThan(c, copy) {
                WRMEM_8(dest, c, RDMEM_8(SLTS.zline, Add(j, c)))
                c = Add(c, 1)
            }
            WRMEM_8(dest, copy, 0)
            j = Add(j, Add(n, 1))
            slot = Add(slot, 1)
        }
    }
}

Function.SLT.Modifiers {
    Output: Integer
    Body: {
        skip = 0
        WhileLoop Or(EqualTo(SLT.Eq(SLTS.t0, "skipif"), 1), EqualTo(SLT.Eq(SLTS.t0, "onlyif"), 1)) {
            match = SLT.EqFold(SLTS.t1, "sqlite")
            IfCondition EqualTo(RDMEM_8(SLTS.t0, 0), 115) ThenBlock: {
                IfCondition EqualTo(match, 1) ThenBlock: { skip = 1 }
            } ElseBlock: {
                IfCondition EqualTo(match, 0) ThenBlock: { skip = 1 }
            }
            IfCondition EqualTo(SLT.NextLine(), 0) ThenBlock: { BreakLoop }
            SLT.Tokenize()
        }
        back = Add(skip, 0)
        ReturnValue(back)
    }
}

Function.SLT.SqlReset {
    Body: {
        SLTS.sqcap = 256
        SLTS.sql = Allocate(256)
        SLTS.sqn = 0
        WRMEM_8(SLTS.sql, 0, 0)
    }
}

Function.SLT.SqlAdd {
    Input: line: Address
    Input: ln: Integer
    Body: {
        extra = ln
        IfCondition GreaterThan(SLTS.sqn, 0) ThenBlock: { extra = Add(extra, 1) }
        need = Add(Add(SLTS.sqn, extra), 1)
        IfCondition GreaterThan(need, SLTS.sqcap) ThenBlock: {
            cap = SLTS.sqcap
            WhileLoop LessThan(cap, need) {
                cap = Multiply(cap, 2)
            }
            nb = Allocate(cap)
            MemoryCopy(nb, SLTS.sql, SLTS.sqn)
            Deallocate(SLTS.sql, SLTS.sqcap)
            SLTS.sql = nb
            SLTS.sqcap = cap
        }
        IfCondition GreaterThan(SLTS.sqn, 0) ThenBlock: {
            WRMEM_8(SLTS.sql, SLTS.sqn, 10)
            SLTS.sqn = Add(SLTS.sqn, 1)
        }
        IfCondition GreaterThan(ln, 0) ThenBlock: {
            MemoryCopy(Add(SLTS.sql, SLTS.sqn), line, ln)
            SLTS.sqn = Add(SLTS.sqn, ln)
        }
        WRMEM_8(SLTS.sql, SLTS.sqn, 0)
    }
}

Function.SLT.ReadStmt {
    Body: {
        SLT.SqlReset()
        WhileLoop EqualTo(SLT.NextLine(), 1) {
            IfCondition EqualTo(RDMEM_8(SLTS.zline, 0), 0) ThenBlock: { BreakLoop }
            SLT.SqlAdd(SLTS.zline, SLTS.len)
        }
    }
}

Function.SLT.ReadQuery {
    Body: {
        SLT.SqlReset()
        WhileLoop EqualTo(SLT.NextBlank(), 0) {
            ok = SLT.NextLine()
            IfCondition EqualTo(ok, 0) ThenBlock: { BreakLoop }
            IfCondition EqualTo(RDMEM_8(SLTS.zline, 0), 0) ThenBlock: { BreakLoop }
            IfCondition EqualTo(SLT.Eq(SLTS.zline, "----"), 1) ThenBlock: { BreakLoop }
            SLT.SqlAdd(SLTS.zline, SLTS.len)
        }
    }
}

Function.SLT.TypeOk {
    Output: Integer
    Body: {
        k = 0
        bad = 0
        WhileLoop NotEqual(RDMEM_8(SLTS.t1, k), 0) {
            c = RDMEM_8(SLTS.t1, k)
            IfCondition And(NotEqual(c, 73), And(NotEqual(c, 84), NotEqual(c, 82))) ThenBlock: {
                bad = 1
                BreakLoop
            }
            k = Add(k, 1)
        }
        IfCondition EqualTo(bad, 1) ThenBlock: {
            SLT.Fail("unknown type character\n")
            ReturnValue(0)
        }
        IfCondition LessEqual(k, 0) ThenBlock: {
            SLT.Fail("missing type string\n")
            SLTS.stop = 1
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

Function.SLT.DoStatement {
    Body: {
        SLT.ReadStmt()
        bad = 0
        IfCondition EqualTo(SQL.Exec(SLTS.sql), 0) ThenBlock: { bad = 1 }
        SLTS.ncmd = Add(SLTS.ncmd, 1)
        IfCondition EqualTo(SLT.Eq(SLTS.t1, "error"), 1) ThenBlock: {
            IfCondition EqualTo(bad, 1) ThenBlock: { bad = 0 } ElseBlock: { bad = 1 }
        }
        IfCondition EqualTo(SLT.Eq(SLTS.t1, "ok"), 0) ThenBlock: {
            IfCondition EqualTo(SLT.Eq(SLTS.t1, "error"), 0) ThenBlock: {
                SLT.Fail("statement argument should be ok or error\n")
                bad = 0
            }
        }
        IfCondition EqualTo(bad, 1) ThenBlock: {
            SLT.Fail("statement error\n")
            PrintMessage(" msg [")
            PrintMessage(SQLS.errmsg)
            PrintMessage("] sql [")
            PrintMessage(SLTS.sql)
            PrintMessage("]\n")
        }
    }
}

Function.SLT.Cmp {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(a, 0) ThenBlock: { a = SLTS.empty }
        IfCondition EqualTo(b, 0) ThenBlock: { b = SLTS.empty }
        i = 0
        WhileLoop EqualTo(1, 1) {
            ca = RDMEM_8(a, i)
            cb = RDMEM_8(b, i)
            IfCondition NotEqual(ca, cb) ThenBlock: { ReturnValue(Subtract(ca, cb)) }
            IfCondition EqualTo(ca, 0) ThenBlock: { ReturnValue(0) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.SLT.RowCmp {
    Input: flat: Address
    Input: ncol: Integer
    Input: ia: Integer
    Input: ib: Integer
    Output: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, ncol) {
            ca = SLT.Cmp(Array.Get(flat, Add(Multiply(ia, ncol), i)), Array.Get(flat, Add(Multiply(ib, ncol), i)))
            IfCondition NotEqual(ca, 0) ThenBlock: { ReturnValue(ca) }
            i = Add(i, 1)
        }
        z = Add(0, 0)
        ReturnValue(z)
    }
}

Function.SLT.Merge {
    Input: left: Integer
    Input: mid: Integer
    Input: right: Integer
    Body: {
        i = left
        j = mid
        k = left
        WhileLoop LessThan(k, right) {
            takeL = 0
            IfCondition GreaterEqual(j, right) ThenBlock: { takeL = 1 }
            IfCondition And(LessThan(i, mid), LessThan(j, right)) ThenBlock: {
                a = Array.Get(SLTS.msrc, i)
                b = Array.Get(SLTS.msrc, j)
                IfCondition LessEqual(SLT.RowCmp(SLTS.mflat, SLTS.mncol, a, b), 0) ThenBlock: { takeL = 1 }
            }
            IfCondition EqualTo(takeL, 1) ThenBlock: {
                Array.Set(SLTS.mdst, k, Array.Get(SLTS.msrc, i))
                i = Add(i, 1)
            } ElseBlock: {
                Array.Set(SLTS.mdst, k, Array.Get(SLTS.msrc, j))
                j = Add(j, 1)
            }
            k = Add(k, 1)
        }
    }
}

Function.SLT.Sort {
    Input: flat: Address
    Input: nval: Integer
    Input: ncol: Integer
    Output: Address
    Body: {
        IfCondition LessEqual(ncol, 0) ThenBlock: { ReturnValue(flat) }
        nrow = Divide(nval, ncol)
        IfCondition LessEqual(nrow, 1) ThenBlock: { ReturnValue(flat) }
        idx = Array.Create(nrow)
        aux = Array.Create(nrow)
        i = 0
        WhileLoop LessThan(i, nrow) {
            Array.Push(idx, i)
            Array.Push(aux, 0)
            i = Add(i, 1)
        }
        src = idx
        dst = aux
        SLTS.mflat = flat
        SLTS.mncol = ncol
        width = 1
        WhileLoop LessThan(width, nrow) {
            SLTS.msrc = src
            SLTS.mdst = dst
            at = 0
            WhileLoop LessThan(at, nrow) {
                left = at
                mid = Add(at, width)
                IfCondition GreaterThan(mid, nrow) ThenBlock: { mid = nrow }
                right = Add(mid, width)
                IfCondition GreaterThan(right, nrow) ThenBlock: { right = nrow }
                SLT.Merge(left, mid, right)
                at = Add(at, Multiply(width, 2))
            }
            tmp = src
            src = dst
            dst = tmp
            width = Multiply(width, 2)
        }
        out = Array.Create(nval)
        r = 0
        WhileLoop LessThan(r, nrow) {
            at2 = Array.Get(src, r)
            c = 0
            WhileLoop LessThan(c, ncol) {
                Array.Push(out, Array.Get(flat, Add(Multiply(at2, ncol), c)))
                c = Add(c, 1)
            }
            r = Add(r, 1)
        }
        back = Add(out, 0)
        ReturnValue(back)
    }
}

Function.SLT.Render {
    Input: rows: Address
    Input: types: Address
    Output: Address
    Body: {
        ncol = StringLength(types)
        flat = Array.Create(8)
        r = 0
        nr = Array.Size(rows)
        WhileLoop LessThan(r, nr) {
            row = Array.Get(rows, r)
            c = 0
            WhileLoop LessThan(c, ncol) {
                v = 0
                IfCondition LessThan(c, Array.Size(row)) ThenBlock: { v = Array.Get(row, c) }
                tc = RDMEM_8(types, c)
                Array.Push(flat, SQL.FormatAs(v, tc))
                c = Add(c, 1)
            }
            r = Add(r, 1)
        }
        back = Add(flat, 0)
        ReturnValue(back)
    }
}

Function.SLT.HashLine {
    Input: n: Integer
    Input: hex: Address
    Output: Address
    Body: {
        ReturnValue(StringConcat(StringConcat(SLT.IntText(n), " values hashing to "), hex))
    }
}

Function.SLT.CheckLabel {
    Input: hex: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(RDMEM_8(SLTS.t3, 0), 0) ThenBlock: { ReturnValue(0) }
        WRMEM_8(SLTS.t3, 20, 0)
        prev = Hash.Get(SLTS.labels, SLTS.t3)
        IfCondition EqualTo(prev, 0) ThenBlock: {
            Hash.Set(SLTS.labels, SLTS.t3, SLT.Copy(hex))
            ReturnValue(0)
        }
        IfCondition NotEqual(StringCompare(prev, hex), 0) ThenBlock: {
            SLT.Fail("labeled result does not agree\n")
        }
        ReturnValue(0)
    }
}

Function.SLT.WordAt {
    Input: s: Address
    Input: at: Integer
    Output: Address
    Body: {
        n = 0
        WhileLoop LessThan(n, 32) {
            c = RDMEM_8(s, Add(at, n))
            IfCondition Or(EqualTo(c, 0), EqualTo(SLT.Space(c), 1)) ThenBlock: { BreakLoop }
            n = Add(n, 1)
        }
        p = Allocate(33)
        i = 0
        WhileLoop LessThan(i, n) {
            WRMEM_8(p, i, RDMEM_8(s, Add(at, i)))
            i = Add(i, 1)
        }
        WRMEM_8(p, n, 0)
        back = Add(p, 0)
        ReturnValue(back)
    }
}

Function.SLT.ParseHashLine {
    Input: s: Address
    Output: Address
    Body: {
        i = 0
        IfCondition Or(LessThan(RDMEM_8(s, 0), 48), GreaterThan(RDMEM_8(s, 0), 57)) ThenBlock: {
            ReturnValue(0)
        }
        WhileLoop And(GreaterEqual(RDMEM_8(s, i), 48), LessEqual(RDMEM_8(s, i), 57)) {
            i = Add(i, 1)
        }
        key = " values hashing to "
        j = 0
        ok = 1
        WhileLoop LessThan(j, 19) {
            IfCondition NotEqual(RDMEM_8(s, Add(i, j)), RDMEM_8(key, j)) ThenBlock: { ok = 0 }
            j = Add(j, 1)
        }
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(SLT.WordAt(s, Add(i, 19)))
    }
}

Function.SLT.SkipHash {
    Output: Integer
    Body: {
        WhileLoop EqualTo(SLT.NextBlank(), 0) {
            IfCondition EqualTo(SLT.NextLine(), 0) ThenBlock: { BreakLoop }
            IfCondition EqualTo(RDMEM_8(SLTS.zline, 0), 0) ThenBlock: { BreakLoop }
            IfCondition EqualTo(SLT.Eq(SLTS.zline, "----"), 1) ThenBlock: { BreakLoop }
        }
        IfCondition EqualTo(SLT.Eq(SLTS.zline, "----"), 1) ThenBlock: { SLT.NextLine() }
        IfCondition EqualTo(RDMEM_8(SLTS.zline, 0), 0) ThenBlock: { ReturnValue(0) }
        hex = SLT.ParseHashLine(SLTS.zline)
        IfCondition EqualTo(hex, 0) ThenBlock: {
            MD5.Start()
            MD5.Absorb(SLTS.zline)
            MD5.Absorb("\n")
            WhileLoop EqualTo(SLT.NextBlank(), 0) {
                IfCondition EqualTo(SLT.NextLine(), 0) ThenBlock: { BreakLoop }
                MD5.Absorb(SLTS.zline)
                MD5.Absorb("\n")
            }
            hex = MD5.Finish()
        }
        SLT.CheckLabel(hex)
        ReturnValue(0)
    }
}

Function.SLT.Verify {
    Input: flat: Address
    Input: nval: Integer
    Input: useHash: Integer
    Input: zhash: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(SLT.Eq(SLTS.zline, "----"), 1) ThenBlock: { SLT.NextLine() }
        IfCondition EqualTo(useHash, 1) ThenBlock: {
            IfCondition NotEqual(StringCompare(SLTS.zline, zhash), 0) ThenBlock: {
                SLT.FailAt(SLTS.nline, "wrong result hash\n")
                PrintMessage(" expected [")
                PrintMessage(SLTS.zline)
                PrintMessage("] got [")
                PrintMessage(zhash)
                PrintMessage("]\n")
            }
            ReturnValue(0)
        }
        i = 0
        WhileLoop And(LessThan(i, nval), NotEqual(RDMEM_8(SLTS.zline, 0), 0)) {
            got = Array.Get(flat, i)
            IfCondition NotEqual(StringCompare(SLTS.zline, got), 0) ThenBlock: {
                SLT.FailAt(SLTS.nline, "wrong result\n")
                PrintMessage(" expected [")
                PrintMessage(SLTS.zline)
                PrintMessage("] got [")
                PrintMessage(got)
                PrintMessage("]\n")
            }
            SLT.NextLine()
            i = Add(i, 1)
        }
        IfCondition LessThan(i, nval) ThenBlock: {
            SLT.FailAt(SLTS.nline, "too many result rows\n")
            PrintMessage(" expected ")
            PrintMessage(SLT.IntText(i))
            PrintMessage(" got ")
            PrintMessage(SLT.IntText(nval))
            PrintMessage("\n")
        } ElseBlock: {
            IfCondition NotEqual(RDMEM_8(SLTS.zline, 0), 0) ThenBlock: {
                WhileLoop NotEqual(RDMEM_8(SLTS.zline, 0), 0) {
                    SLT.NextLine()
                    i = Add(i, 1)
                }
                SLT.FailAt(SLTS.nline, "too few result rows\n")
                PrintMessage(" expected ")
                PrintMessage(SLT.IntText(i))
                PrintMessage(" got ")
                PrintMessage(SLT.IntText(nval))
                PrintMessage("\n")
            }
        }
    }
}

Function.SLT.DoQuery {
    Output: Integer
    Body: {
        IfCondition EqualTo(SLT.TypeOk(), 0) ThenBlock: { ReturnValue(0) }
        SLT.ReadQuery()
        ok = SQL.Exec(SLTS.sql)
        SLTS.ncmd = Add(SLTS.ncmd, 1)
        ncol = StringLength(SLTS.t1)
        gotc = 0
        IfCondition NotEqual(SQLS.onames, 0) ThenBlock: { gotc = Array.Size(SQLS.onames) }
        // sqlite3_step errors still return the rows already produced.
        // sum() integer overflow yields no row, which this suite expects.
        IfCondition NotEqual(gotc, ncol) ThenBlock: {
            SLT.Fail("query failed\n")
            IfCondition EqualTo(ok, 0) ThenBlock: {
                PrintMessage(" msg [")
                PrintMessage(SQLS.errmsg)
                PrintMessage("] sql [")
                PrintMessage(SLTS.sql)
                PrintMessage("]\n")
            } ElseBlock: {
                PrintMessage(" wrong number of result columns\n")
            }
            ReturnValue(0)
        }
        flat = SLT.Render(SQLS.rows, SLTS.t1)
        nval = Multiply(Array.Size(SQLS.rows), ncol)
        sortn = 0
        IfCondition EqualTo(SLT.Eq(SLTS.t2, "rowsort"), 1) ThenBlock: { sortn = ncol }
        IfCondition EqualTo(SLT.Eq(SLTS.t2, "valuesort"), 1) ThenBlock: { sortn = 1 }
        IfCondition NotEqual(RDMEM_8(SLTS.t2, 0), 0) ThenBlock: {
            known = 0
            IfCondition EqualTo(SLT.Eq(SLTS.t2, "nosort"), 1) ThenBlock: { known = 1 }
            IfCondition EqualTo(SLT.Eq(SLTS.t2, "rowsort"), 1) ThenBlock: { known = 1 }
            IfCondition EqualTo(SLT.Eq(SLTS.t2, "valuesort"), 1) ThenBlock: { known = 1 }
            IfCondition EqualTo(known, 0) ThenBlock: {
                SLT.Fail("unknown sort method\n")
            }
        }
        IfCondition GreaterThan(sortn, 0) ThenBlock: {
            flat = SLT.Sort(flat, nval, sortn)
        }
        useHash = 0
        IfCondition And(GreaterThan(SLTS.ht, 0), GreaterThan(nval, SLTS.ht)) ThenBlock: { useHash = 1 }
        need = useHash
        IfCondition NotEqual(RDMEM_8(SLTS.t3, 0), 0) ThenBlock: { need = 1 }
        zhash = SLTS.empty
        IfCondition EqualTo(need, 1) ThenBlock: {
            MD5.Start()
            hi = 0
            WhileLoop LessThan(hi, nval) {
                MD5.Absorb(Array.Get(flat, hi))
                MD5.Absorb("\n")
                hi = Add(hi, 1)
            }
            hex = MD5.Finish()
            SLT.CheckLabel(hex)
            zhash = SLT.HashLine(nval, hex)
        }
        SLT.Verify(flat, nval, useHash, zhash)
        ReturnValue(0)
    }
}

Function.SLT.Summary {
    Body: {
        PrintMessage(SLT.IntText(SLTS.nerr))
        PrintMessage(" errors out of ")
        PrintMessage(SLT.IntText(SLTS.ncmd))
        PrintMessage(" tests in ")
        PrintMessage(SLTS.path)
        PrintMessage(" - ")
        PrintMessage(SLT.IntText(SLTS.nskip))
        PrintMessage(" skipped.\n")
    }
}

Function.SLT.Run {
    Body: {
        WhileLoop And(EqualTo(SLTS.stop, 0), EqualTo(SLT.Find(), 1)) {
            SLT.Tokenize()
            skip = SLT.Modifiers()
            IfCondition EqualTo(skip, 1) ThenBlock: {
                SLTS.nskip = Add(SLTS.nskip, 1)
                IfCondition And(EqualTo(SLT.Eq(SLTS.t0, "query"), 1), NotEqual(RDMEM_8(SLTS.t3, 0), 0)) ThenBlock: {
                    SLT.SkipHash()
                }
            } ElseBlock: {
                known = 0
                IfCondition EqualTo(SLT.Eq(SLTS.t0, "statement"), 1) ThenBlock: {
                    known = 1
                    SLT.DoStatement()
                }
                IfCondition EqualTo(SLT.Eq(SLTS.t0, "query"), 1) ThenBlock: {
                    known = 1
                    SLT.DoQuery()
                }
                IfCondition EqualTo(SLT.Eq(SLTS.t0, "hash-threshold"), 1) ThenBlock: {
                    known = 1
                    SLTS.ht = SLT.Atoi(SLTS.t1)
                }
                IfCondition EqualTo(SLT.Eq(SLTS.t0, "halt"), 1) ThenBlock: {
                    known = 1
                    PrintMessage(SLTS.path)
                    PrintMessage(":")
                    PrintMessage(SLT.IntText(SLTS.start))
                    PrintMessage(": halt\n")
                    SLTS.stop = 1
                }
                IfCondition EqualTo(known, 0) ThenBlock: {
                    SLT.Fail("unknown record type\n")
                    SLTS.stop = 1
                }
            }
        }
        SLT.Summary()
    }
}

SubRoutine.Main {
    cmd = "/proc/self/cmdline"
    fd = SystemCall(257, -100, cmd, 0, 0)
    IfCondition LessThan(fd, 0) ThenBlock: { ProcessExit(1) }
    cbuf = Allocate(8192)
    cn = SystemCall(0, fd, cbuf, 8192)
    SystemCall(3, fd)
    path = SLT.ArgAt(cbuf, cn, 1)
    IfCondition EqualTo(path, 0) ThenBlock: {
        PrintMessage("usage: slt_run file.test\n")
        ProcessExit(1)
    }
    IfCondition EqualTo(SQL.Boot(), 0) ThenBlock: { ProcessExit(1) }
    SLT.Begin()
    IfCondition EqualTo(SLT.Load(path), 0) ThenBlock: { ProcessExit(1) }
    SLT.Run()
    IfCondition GreaterThan(SLTS.nerr, 0) ThenBlock: { ProcessExit(1) }
    ProcessExit(0)
}

RunTask(Main)
