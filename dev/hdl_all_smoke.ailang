// Full orthogonal dogfood: prims, Min/Max, multi itoa jobs, ROM table
// ./ailang_hdl.x -hdl -period 20 dev/hdl_all_smoke.ailang dev/hdl_all_out
// yosys -s dev/hdl_all_out.ys
// yosys -s dev/hdl_all_out.synth_ice40.ys   # optional vendor pack

FixedPool.App {
    "n":    Initialize=42
    "m":    Initialize=7
    "pick": Initialize=0
    "flag": Initialize=0
    "lo":   Initialize=0
    "hi":   Initialize=0
    // deeper table → ram_style block hint for Yosys/vendor
    "rom":  ElementType-Byte, MaximumLength-32, Initialize=0
}

Function.Twiddle {
    Input: x: Integer
    Output: Integer
    Body: {
        ReturnValue(BitwiseXor(Add(x, 1), ShiftLeft(x, 1)))
    }
}

SubRoutine.Main {
    // Static print ROM queue
    PrintMessage("n=")
    PrintNumber(42)
    PrintMessage("\n")

    App.n = Twiddle(App.n)
    App.m = Add(App.m, 1)
    App.lo = Min(App.n, App.m)
    App.hi = Max(App.n, App.m)

    // Multi-job runtime itoa (order preserved after ROM)
    PrintNumber(App.n)
    PrintNumber(App.lo)
    PrintNumber(App.hi)

    // ROM fabric write + read
    App.rom[0] = 11
    App.flag = App.rom[0]

    // Expr If → mux
    IfCondition GreaterThan(App.n, 0) ThenBlock: {
        App.pick = AbsoluteValue(App.n)
    } ElseBlock: {
        App.pick = Add(App.n, 1)
    }

    // Const If → LUT
    IfCondition EqualTo(App.pick, 0) ThenBlock: {
        App.flag = 1
    } ElseBlock: {
        App.flag = 2
    }
}

RunTask(Main)
