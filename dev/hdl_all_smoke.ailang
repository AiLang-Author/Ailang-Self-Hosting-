// Full orthogonal dogfood: prims, If→mux/LUT, print queue + runtime itoa
// ./ailang_hdl.x -hdl -period 20 dev/hdl_all_smoke.ailang dev/hdl_all_out
// yosys -s dev/hdl_all_out.ys

FixedPool.App {
    "n":    Initialize=42
    "pick": Initialize=0
    "flag": Initialize=0
}

Function.Twiddle {
    Input: x: Integer
    Output: Integer
    Body: {
        ReturnValue(BitwiseXor(Add(x, 1), ShiftLeft(x, 1)))
    }
}

SubRoutine.Main {
    // Static print queue (append order)
    PrintMessage("n=")
    PrintNumber(42)
    PrintMessage("\n")

    App.n = Twiddle(App.n)

    // Runtime itoa after ROM drains
    PrintNumber(App.n)

    // Expr If → mux
    IfCondition GreaterThan(App.n, 0) ThenBlock: {
        App.pick = AbsoluteValue(App.n)
    } ElseBlock: {
        App.pick = Add(App.n, 1)
    }

    // Const If → LUT
    IfCondition EqualTo(App.pick, 0) ThenBlock: {
        App.flag = 1
    } ElseBlock: {
        App.flag = 2
    }
}

RunTask(Main)
