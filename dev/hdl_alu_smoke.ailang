// =============================================================================
// Mini ALU + 4-reg file soft-IP — pure AILang datapath
// opcode: 0 add, 1 sub, 2 and, 3 or, 4 xor, 5 shl1, 6 sat-add, 7 popcnt
// =============================================================================

FixedPool.Alu {
    "regs":     ElementType-Integer, MaximumLength-4, Initialize=0
    "ra":       Initialize=0
    "rb":       Initialize=1
    "rd":       Initialize=2
    "op":       Initialize=0
    "a":        Initialize=0
    "b":        Initialize=0
    "y":        Initialize=0
    "flags_z":  Initialize=0
    "flags_n":  Initialize=0
    "mode":     Initialize=0
    "pc":       Initialize=0
}

// ALU combinational core
Function.AluExec {
    Input: op: Integer
    Input: a: Integer
    Input: b: Integer
    Output: Integer
    Body: {
        // decode via nested Select / Mux4 trees (no if-soup)
        addv = Add(a, b)
        subv = Subtract(a, b)
        andv = BitwiseAnd(a, b)
        orv = BitwiseOr(a, b)
        xorv = BitwiseXor(a, b)
        shlv = ShiftLeft(a, 1)
        satv = AddSatU8(a, b)
        popv = PopCount8(a)
        // low 2 bits of op → first mux bank; bit2 picks high bank
        lo = Mux4(LowBits(op, 2), addv, subv, andv, orv)
        hi = Mux4(LowBits(op, 2), xorv, shlv, satv, popv)
        ReturnValue(Select(IsNonZero(BitTest(op, 2)), hi, lo))
    }
}

SubRoutine.Main {
    Branch Alu.mode {
        Case 0: {
            // seed regfile
            Alu.regs[0] = 10
            Alu.regs[1] = 3
            Alu.regs[2] = 0
            Alu.regs[3] = 0xA5
            Alu.op = 0
            Alu.mode = 1
        }
        Case 1: {
            // fetch operands
            Alu.a = Alu.regs[Alu.ra]
            Alu.b = Alu.regs[Alu.rb]
            Alu.y = AluExec(Alu.op, Alu.a, Alu.b)
            Alu.regs[Alu.rd] = Alu.y
            Alu.flags_z = IsZero(Alu.y)
            Alu.flags_n = BitTest(Alu.y, 7)
            Alu.pc = Increment(Alu.pc)
            // walk opcodes
            Alu.op = LowBits(Increment(Alu.op), 3)
            IfCondition GreaterEqual(Alu.pc, 16) ThenBlock: {
                Alu.mode = 2
            } ElseBlock: {
                // rotate register indices lightly
                Alu.ra = LowBits(Add(Alu.ra, 1), 2)
                Alu.rb = LowBits(Add(Alu.rb, 1), 2)
                Alu.rd = LowBits(Add(Alu.rd, 1), 2)
                Alu.mode = 1
            }
        }
        Case 2: {
            Alu.mode = 2
        }
        Default: {
            Alu.mode = 0
        }
    }
}

RunTask(Main)
