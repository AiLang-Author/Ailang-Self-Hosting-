// =============================================================================
// Round-robin arbiter soft-IP — pure AILang
// 4 requesters, last-grant fairness, one-hot grant
// =============================================================================

FixedPool.Arb {
    "req":      Initialize=0x0B
    "grant":    Initialize=0
    "last":     Initialize=0
    "goh":      Initialize=0
    "mode":     Initialize=0
    "tick":     Initialize=0
}

// RR pick among bits 0..3 starting after `last` (const BitTest only)
Function.RrPick {
    Input: req: Integer
    Input: last: Integer
    Output: Integer
    Body: {
        b0 = BitTest(req, 0)
        b1 = BitTest(req, 1)
        b2 = BitTest(req, 2)
        b3 = BitTest(req, 3)
        // order depends on last: after N → N+1,N+2,N+3,N
        // last==0 → 1,2,3,0
        p01 = Select(IsNonZero(b1), 1, Select(IsNonZero(b2), 2, Select(IsNonZero(b3), 3, Select(IsNonZero(b0), 0, 0))))
        // last==1 → 2,3,0,1
        p12 = Select(IsNonZero(b2), 2, Select(IsNonZero(b3), 3, Select(IsNonZero(b0), 0, Select(IsNonZero(b1), 1, 0))))
        // last==2 → 3,0,1,2
        p23 = Select(IsNonZero(b3), 3, Select(IsNonZero(b0), 0, Select(IsNonZero(b1), 1, Select(IsNonZero(b2), 2, 0))))
        // last==3 → 0,1,2,3
        p30 = Select(IsNonZero(b0), 0, Select(IsNonZero(b1), 1, Select(IsNonZero(b2), 2, Select(IsNonZero(b3), 3, 0))))
        // mux by last (2-bit)
        ReturnValue(Mux4(last, p01, p12, p23, p30))
    }
}

SubRoutine.Main {
    Branch Arb.mode {
        Case 0: {
            Arb.grant = RrPick(Arb.req, Arb.last)
            Arb.goh = OneHot(Arb.grant, 4)
            Arb.last = Arb.grant
            Arb.mode = 1
        }
        Case 1: {
            // rotate request stimulus (const rotate distance)
            Arb.req = LowBits(RotateLeft(Arb.req, 1), 4)
            Arb.tick = Increment(Arb.tick)
            IfCondition GreaterEqual(Arb.tick, 8) ThenBlock: {
                Arb.mode = 2
            } ElseBlock: {
                Arb.mode = 0
            }
        }
        Case 2: {
            Arb.mode = 2
        }
        Default: {
            Arb.mode = 0
        }
    }
}

RunTask(Main)
