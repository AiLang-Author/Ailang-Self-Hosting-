// =============================================================================
// Barrel-ish rotate/shift soft-IP + nibble helpers — pure AILang
// =============================================================================

FixedPool.Bar {
    "x":        Initialize=0x3C
    "amt":      Initialize=0
    "rol":      Initialize=0
    "ror":      Initialize=0
    "shl":      Initialize=0
    "shr":      Initialize=0
    "nib_hi":   Initialize=0
    "nib_lo":   Initialize=0
    "swapn":    Initialize=0
    "mode":     Initialize=0
}

// Nibble swap on low byte
Function.NibbleSwap8 {
    Input: v: Integer
    Output: Integer
    Body: {
        lo = LowBits(v, 4)
        hi = LowBits(ShiftRight(v, 4), 4)
        ReturnValue(LowBits(BitwiseOr(ShiftLeft(lo, 4), hi), 8))
    }
}

SubRoutine.Main {
    Branch Bar.mode {
        Case 0: {
            // const-distance rotates (HDL requires const dist for Rotate*)
            Bar.rol = LowBits(RotateLeft(Bar.x, 1), 8)
            Bar.ror = LowBits(RotateRight(Bar.x, 1), 8)
            Bar.shl = LowBits(ShiftLeft(Bar.x, 1), 8)
            Bar.shr = LowBits(ShiftRight(Bar.x, 1), 8)
            Bar.nib_lo = LowBits(Bar.x, 4)
            Bar.nib_hi = LowBits(ShiftRight(Bar.x, 4), 4)
            Bar.swapn = NibbleSwap8(Bar.x)
            Bar.amt = LowBits(Increment(Bar.amt), 3)
            Bar.x = Bar.rol
            Bar.mode = 1
        }
        Case 1: {
            // second pass with different const distances
            Bar.rol = LowBits(RotateLeft(Bar.x, 3), 8)
            Bar.ror = LowBits(RotateRight(Bar.x, 2), 8)
            Bar.x = LowBits(BitwiseXor(Bar.x, Bar.swapn), 8)
            Bar.mode = 0
        }
        Default: {
            Bar.mode = 0
        }
    }
}

RunTask(Main)
