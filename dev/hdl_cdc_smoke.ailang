// =============================================================================
// CDC soft-IP — pure AILang (same clock model; structure of async path)
// 2FF synchronizer + pulse stretcher / toggle→pulse handshake
// =============================================================================

FixedPool.Cdc {
    // "async" input (driven by stim FSM; in real silicon from other domain)
    "async_in": Initialize=0
    // 2FF sync chain
    "ff1":      Initialize=0
    "ff2":      Initialize=0
    "sync":     Initialize=0
    // edge detect on synced signal
    "prev":     Initialize=0
    "rise":     Initialize=0
    "fall":     Initialize=0
    // toggle-handshake: src toggles req; dst sees level change
    "src_tog":  Initialize=0
    "dst_ff1":  Initialize=0
    "dst_ff2":  Initialize=0
    "dst_prev": Initialize=0
    "pulse":    Initialize=0
    "mode":     Initialize=0
    "tick":     Initialize=0
}

SubRoutine.Main {
    // stimulus for async_in + src toggle
    Branch Cdc.mode {
        Case 0: {
            Cdc.async_in = 0
            Cdc.tick = Increment(Cdc.tick)
            IfCondition GreaterEqual(Cdc.tick, 2) ThenBlock: {
                Cdc.mode = 1
                Cdc.tick = 0
            } ElseBlock: {
                Cdc.mode = 0
            }
        }
        Case 1: {
            Cdc.async_in = 1
            Cdc.src_tog = BitwiseXor(Cdc.src_tog, 1)
            Cdc.tick = Increment(Cdc.tick)
            IfCondition GreaterEqual(Cdc.tick, 3) ThenBlock: {
                Cdc.mode = 2
                Cdc.tick = 0
            } ElseBlock: {
                Cdc.mode = 1
            }
        }
        Case 2: {
            Cdc.async_in = 0
            Cdc.tick = Increment(Cdc.tick)
            IfCondition GreaterEqual(Cdc.tick, 4) ThenBlock: {
                Cdc.mode = 0
                Cdc.tick = 0
            } ElseBlock: {
                Cdc.mode = 2
            }
        }
        Default: {
            Cdc.mode = 0
        }
    }

    // 2FF synchronizer (structural CDC — same clk in this dogfood)
    Cdc.ff1 = Cdc.async_in
    Cdc.ff2 = Cdc.ff1
    Cdc.sync = Cdc.ff2

    // edges on synchronized line
    Cdc.rise = And(IsNonZero(Cdc.sync), IsZero(Cdc.prev))
    Cdc.fall = And(IsZero(Cdc.sync), IsNonZero(Cdc.prev))
    Cdc.prev = Cdc.sync

    // toggle → pulse (req/ack level-change handshake pattern)
    Cdc.dst_ff1 = Cdc.src_tog
    Cdc.dst_ff2 = Cdc.dst_ff1
    Cdc.pulse = NotEqual(Cdc.dst_ff2, Cdc.dst_prev)
    Cdc.dst_prev = Cdc.dst_ff2
}

RunTask(Main)
