// Constructions dogfood: index write, Increment, Clamp, Until, Min
// ./ailang_hdl.x -hdl dev/hdl_constructs_smoke.ailang dev/hdl_constructs_out
// yosys -s dev/hdl_constructs_out.ys

FixedPool.App {
    "i":    Initialize=0
    "acc":  Initialize=0
    "buf":  ElementType-Byte, MaximumLength-8, Initialize=0
}

SubRoutine.Main {
    // Increment as expression value
    App.i = Increment(App.i)

    // Clamp + Min
    App.acc = Clamp(App.i, 0, 7)
    App.acc = Min(App.acc, 5)

    // Array write (const index)
    App.buf[0] = App.acc
    App.buf[1] = Add(App.acc, 1)

    // Until: one body step per clock while condition false
    UntilCondition GreaterEqual(App.i, 3) {
        App.i = Increment(App.i)
    }

    // Read back
    App.acc = App.buf[0]
}

RunTask(Main)
