// Core useful HDL syntax — practical subset dogfood
// ./ailang_hdl.x -hdl dev/hdl_core_syntax.ailang dev/hdl_core_out
// ./dev/hdl_test_yosys.sh core

FixedPool.App {
    "x":     Initialize=7
    "y":     Initialize=3
    "flags": Initialize=0
    "acc":   Initialize=0
    "tmp":   Initialize=0
    "rom":   ElementType-Byte, MaximumLength-4, Initialize=0
}

Function.Square {
    Input: v: Integer
    Output: Integer
    Body: {
        ReturnValue(Power(v, 2))
    }
}

Function.Nibble {
    Input: w: Integer
    Output: Integer
    Body: {
        ReturnValue(LowBits(w, 4))
    }
}

SubRoutine.Main {
    // Arith + power + rotate + bits
    App.x = Square(App.y)
    App.tmp = RotateLeft(App.x, 4)
    App.tmp = RotateRight(App.tmp, 2)
    App.flags = BitSet(App.flags, 0)
    App.flags = BitSet(App.flags, 3)
    App.flags = BitClear(App.flags, 0)
    App.acc = BitTest(App.flags, 3)

    // Masks / predicates
    App.tmp = Nibble(App.x)
    App.acc = Select(IsNonZero(App.tmp), App.tmp, 1)
    App.acc = Clamp(App.acc, 0, 15)
    App.acc = Min(App.acc, Max(App.y, 2))

    // Array R/W + ForEvery reduction
    App.rom[0] = App.acc
    App.rom[1] = Increment(App.y)
    App.rom[2] = AbsoluteValue(Subtract(0, 5))
    App.rom[3] = Xor(App.rom[0], App.rom[1])

    App.x = 0
    ForEvery e in App.rom {
        App.x = Add(App.x, e)
        App.y = Max(App.y, e)
    }

    // Control: If mux, Branch LUT, While 1-iter
    IfCondition GreaterThan(App.x, 10) ThenBlock: {
        App.flags = BitSet(App.flags, 1)
    } ElseBlock: {
        App.flags = BitClear(App.flags, 1)
    }

    Branch App.acc {
        Case 0: { App.tmp = 100 }
        Case 1: { App.tmp = 101 }
        Default: { App.tmp = 199 }
    }

    WhileLoop LessThan(App.y, 4) {
        App.y = Increment(App.y)
    }

    UntilCondition GreaterEqual(App.acc, 1) {
        App.acc = Increment(App.acc)
    }
}

RunTask(Main)
