// =============================================================================
// CRC-8 stream over FixedPool ROM — pure AILang soft-IP
// Walks a payload array one byte/clock, updates CRC, finishes with residue
// =============================================================================

FixedPool.CrcS {
    "crc":      Initialize=0
    "idx":      Initialize=0
    "byte":     Initialize=0
    "done":     Initialize=0
    "mode":     Initialize=0
    "len":      Initialize=8
    "payload":  ElementType-Byte, MaximumLength-8, Initialize=0
    "pop":      Initialize=0
    "ham":      Initialize=0
}

// CRC-8 poly 0x07 — one byte (unrolled)
Function.Crc8Byte {
    Input: crc: Integer
    Input: data: Integer
    Output: Integer
    Body: {
        c = LowBits(BitwiseXor(crc, data), 8)
        c = Select(IsNonZero(BitTest(c, 7)), BitwiseXor(ShiftLeft(c, 1), 7), ShiftLeft(c, 1))
        c = LowBits(c, 8)
        c = Select(IsNonZero(BitTest(c, 7)), BitwiseXor(ShiftLeft(c, 1), 7), ShiftLeft(c, 1))
        c = LowBits(c, 8)
        c = Select(IsNonZero(BitTest(c, 7)), BitwiseXor(ShiftLeft(c, 1), 7), ShiftLeft(c, 1))
        c = LowBits(c, 8)
        c = Select(IsNonZero(BitTest(c, 7)), BitwiseXor(ShiftLeft(c, 1), 7), ShiftLeft(c, 1))
        c = LowBits(c, 8)
        c = Select(IsNonZero(BitTest(c, 7)), BitwiseXor(ShiftLeft(c, 1), 7), ShiftLeft(c, 1))
        c = LowBits(c, 8)
        c = Select(IsNonZero(BitTest(c, 7)), BitwiseXor(ShiftLeft(c, 1), 7), ShiftLeft(c, 1))
        c = LowBits(c, 8)
        c = Select(IsNonZero(BitTest(c, 7)), BitwiseXor(ShiftLeft(c, 1), 7), ShiftLeft(c, 1))
        c = LowBits(c, 8)
        c = Select(IsNonZero(BitTest(c, 7)), BitwiseXor(ShiftLeft(c, 1), 7), ShiftLeft(c, 1))
        c = LowBits(c, 8)
        ReturnValue(c)
    }
}

SubRoutine.Main {
    Branch CrcS.mode {
        Case 0: {
            // load payload "HDL!\n..." style
            CrcS.payload[0] = 72
            CrcS.payload[1] = 68
            CrcS.payload[2] = 76
            CrcS.payload[3] = 33
            CrcS.payload[4] = 10
            CrcS.payload[5] = 1
            CrcS.payload[6] = 2
            CrcS.payload[7] = 3
            CrcS.crc = 0
            CrcS.idx = 0
            CrcS.done = 0
            CrcS.mode = 1
        }
        Case 1: {
            // stream one byte per clock
            CrcS.byte = CrcS.payload[CrcS.idx]
            CrcS.crc = Crc8Byte(CrcS.crc, CrcS.byte)
            CrcS.pop = PopCount8(CrcS.byte)
            CrcS.ham = Hamming8(CrcS.crc, CrcS.byte)
            CrcS.idx = Increment(CrcS.idx)
            IfCondition GreaterEqual(CrcS.idx, CrcS.len) ThenBlock: {
                CrcS.done = 1
                CrcS.mode = 2
            } ElseBlock: {
                CrcS.mode = 1
            }
        }
        Case 2: {
            // hold residue
            CrcS.mode = 2
        }
        Default: {
            CrcS.mode = 0
        }
    }
}

RunTask(Main)
