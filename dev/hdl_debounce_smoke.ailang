// =============================================================================
// Debouncer soft-IP — pure AILang
// N-cycle stable filter + rising/falling edge out
// ./ailang_hdl.x -hdl dev/hdl_debounce_smoke.ailang /tmp/db
// =============================================================================

FixedPool.Db {
    "raw":      Initialize=0
    "stable":   Initialize=0
    "cnt":      Initialize=0
    "out":      Initialize=0
    "prev":     Initialize=0
    "rise":     Initialize=0
    "fall":     Initialize=0
    "stim":     Initialize=0
    "phase":    Initialize=0
    "hold":     Initialize=4
}

SubRoutine.Main {
    // synthetic bounce: force raw toggles for a few cycles then settle high
    Branch Db.phase {
        Case 0: {
            // bounce window
            Db.raw = BitwiseXor(Db.raw, 1)
            Db.stim = Increment(Db.stim)
            IfCondition GreaterEqual(Db.stim, 6) ThenBlock: {
                Db.raw = 1
                Db.phase = 1
                Db.stim = 0
            } ElseBlock: {
                Db.phase = 0
            }
        }
        Case 1: {
            // hold high, wait for debounce to lock
            Db.raw = 1
            Db.stim = Increment(Db.stim)
            IfCondition GreaterEqual(Db.stim, 8) ThenBlock: {
                Db.phase = 2
                Db.stim = 0
            } ElseBlock: {
                Db.phase = 1
            }
        }
        Case 2: {
            // drop low
            Db.raw = 0
            Db.stim = Increment(Db.stim)
            IfCondition GreaterEqual(Db.stim, 8) ThenBlock: {
                Db.phase = 3
            } ElseBlock: {
                Db.phase = 2
            }
        }
        Case 3: {
            Db.phase = 3
        }
        Default: {
            Db.phase = 0
        }
    }

    // debounce core (every clock)
    IfCondition EqualTo(Db.raw, Db.stable) ThenBlock: {
        Db.cnt = 0
    } ElseBlock: {
        Db.cnt = Increment(Db.cnt)
        IfCondition GreaterEqual(Db.cnt, Db.hold) ThenBlock: {
            Db.stable = Db.raw
            Db.cnt = 0
        } ElseBlock: {
            Db.cnt = Db.cnt
        }
    }
    Db.out = Db.stable
    Db.rise = And(IsNonZero(Db.out), IsZero(Db.prev))
    Db.fall = And(IsZero(Db.out), IsNonZero(Db.prev))
    Db.prev = Db.out
}

RunTask(Main)
