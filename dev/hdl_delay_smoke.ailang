// Delay-line / moving average soft-IP — pure AILang, no TechBlock
// 8-tap tapped delay on a scalar stream (shift register in FixedPool array)

FixedPool.Dl {
    "in":     Initialize=1
    "out":    Initialize=0
    "sum":    Initialize=0
    "avg":    Initialize=0
    "tap":    ElementType-Integer, MaximumLength-8, Initialize=0
    "ctz":    Initialize=0
    "clz":    Initialize=0
    "bswap":  Initialize=0
    "phase":  Initialize=0
}

// Simple 8-tap sum (caller shifts taps)
Function.TapSum8 {
    Input: t0: Integer
    Input: t1: Integer
    Input: t2: Integer
    Input: t3: Integer
    Input: t4: Integer
    Input: t5: Integer
    Input: t6: Integer
    Input: t7: Integer
    Output: Integer
    Body: {
        s = Add(t0, t1)
        s = Add(s, t2)
        s = Add(s, t3)
        s = Add(s, t4)
        s = Add(s, t5)
        s = Add(s, t6)
        s = Add(s, t7)
        ReturnValue(s)
    }
}

SubRoutine.Main {
    // shift register: tap[i] <- tap[i-1], tap[0] <- in
    Dl.tap[7] = Dl.tap[6]
    Dl.tap[6] = Dl.tap[5]
    Dl.tap[5] = Dl.tap[4]
    Dl.tap[4] = Dl.tap[3]
    Dl.tap[3] = Dl.tap[2]
    Dl.tap[2] = Dl.tap[1]
    Dl.tap[1] = Dl.tap[0]
    Dl.tap[0] = Dl.in

    Dl.sum = TapSum8(Dl.tap[0], Dl.tap[1], Dl.tap[2], Dl.tap[3], Dl.tap[4], Dl.tap[5], Dl.tap[6], Dl.tap[7])
    // avg ≈ sum >> 3
    Dl.avg = ShiftRight(Dl.sum, 3)
    Dl.out = LowBits(Dl.avg, 16)

    // bit helpers on sum
    Dl.ctz = Ctz8(Dl.sum)
    Dl.clz = Clz8(Dl.sum)
    Dl.bswap = ByteSwap16(Dl.sum)

    // walk input as a soft counter stimulus
    Dl.in = LowBits(Increment(Dl.in), 8)
    Dl.phase = LowBits(Increment(Dl.phase), 4)
}

RunTask(Main)
