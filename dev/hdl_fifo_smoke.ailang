// =============================================================================
// Ring FIFO soft-IP — pure AILang, zero hand HDL
// Depth-4 circular buffer: push/pop with count, full/empty flags
// ./ailang_hdl.x -hdl dev/hdl_fifo_smoke.ailang /tmp/fifo
// =============================================================================

FixedPool.Fifo {
    "mem":      ElementType-Integer, MaximumLength-4, Initialize=0
    "head":     Initialize=0
    "tail":     Initialize=0
    "count":    Initialize=0
    "wr_data":  Initialize=0x10
    "rd_data":  Initialize=0
    "full":     Initialize=0
    "empty":    Initialize=1
    "mode":     Initialize=0
    "pushed":   Initialize=0
    "popped":   Initialize=0
    "ham":      Initialize=0
    "adiff":    Initialize=0
}

// Next index mod 4
Function.IncMod4 {
    Input: i: Integer
    Output: Integer
    Body: {
        ReturnValue(LowBits(Add(i, 1), 2))
    }
}

SubRoutine.Main {
    Fifo.full = EqualTo(Fifo.count, 4)
    Fifo.empty = IsZero(Fifo.count)

    Branch Fifo.mode {
        Case 0: {
            // PUSH until full (4 items)
            IfCondition IsZero(Fifo.full) ThenBlock: {
                Fifo.mem[Fifo.tail] = Fifo.wr_data
                Fifo.tail = IncMod4(Fifo.tail)
                Fifo.count = Increment(Fifo.count)
                Fifo.wr_data = LowBits(Add(Fifo.wr_data, 0x11), 8)
                Fifo.pushed = Increment(Fifo.pushed)
            } ElseBlock: {
                Fifo.mode = 1
            }
        }
        Case 1: {
            // POP until empty
            IfCondition IsZero(Fifo.empty) ThenBlock: {
                Fifo.rd_data = Fifo.mem[Fifo.head]
                Fifo.head = IncMod4(Fifo.head)
                Fifo.count = Decrement(Fifo.count)
                Fifo.popped = Increment(Fifo.popped)
                // soft metrics on payload
                Fifo.ham = Hamming8(Fifo.rd_data, Fifo.wr_data)
                Fifo.adiff = AbsDiff8(Fifo.rd_data, Fifo.wr_data)
            } ElseBlock: {
                Fifo.mode = 2
            }
        }
        Case 2: {
            // idle / hold
            Fifo.mode = 2
        }
        Default: {
            Fifo.mode = 0
        }
    }
}

RunTask(Main)
