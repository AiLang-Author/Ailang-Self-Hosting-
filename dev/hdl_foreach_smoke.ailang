// Bounded ForEvery unroll over FixedPool array
// ./ailang_hdl.x -hdl dev/hdl_foreach_smoke.ailang dev/hdl_foreach_out
// yosys -s dev/hdl_foreach_out.ys

FixedPool.App {
    "sum":  Initialize=0
    "mx":   Initialize=0
    "tab":  ElementType-Byte, MaximumLength-4, Initialize=0
}

SubRoutine.Main {
    // Seed table
    App.tab[0] = 3
    App.tab[1] = 9
    App.tab[2] = 1
    App.tab[3] = 7

    App.sum = 0
    App.mx = 0

    // Unroll 4×: item binds to App.tab[i]
    ForEvery item in App.tab {
        App.sum = Add(App.sum, item)
        App.mx = Max(App.mx, item)
        // Select as structured ternary
        App.sum = Select(GreaterThan(item, 5), Add(App.sum, 1), App.sum)
    }
}

RunTask(Main)
