// Orthogonal hello world: normal AILang → gates
// ./ailang_hdl.x -hdl dev/hdl_hello.ailang dev/hdl_hello_out
// yosys -s dev/hdl_hello_out.ys
//
// Host ties print_ready=1 and watches print_data/print_valid each clock
// for ASCII bytes: H e l l o ,   w o r l d \n

SubRoutine.Main {
    PrintMessage("Hello, world\n")
}

RunTask(Main)
