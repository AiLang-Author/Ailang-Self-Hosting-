// =============================================================================
// I²C-ish bit-bang soft-IP — pure AILang (simplified open-drain style)
// START → 8 data bits (MSB) + ACK slot → STOP
// scl/sda driven as push-pull model for netlist (not real OD, gates only)
// =============================================================================

FixedPool.I2c {
    "addr":     Initialize=0x50
    "wdata":    Initialize=0x3C
    "shift":    Initialize=0
    "bit_i":    Initialize=0
    "scl":      Initialize=1
    "sda":      Initialize=1
    "ack":      Initialize=0
    "mode":     Initialize=0
    "done":     Initialize=0
    "phase":    Initialize=0
    "byte_sel": Initialize=0
}

SubRoutine.Main {
    Branch I2c.mode {
        Case 0: {
            // idle high
            I2c.scl = 1
            I2c.sda = 1
            I2c.mode = 1
        }
        Case 1: {
            // START: SDA falls while SCL high
            I2c.sda = 0
            I2c.scl = 1
            // load addr<<1 | 0 (write)
            I2c.shift = LowBits(ShiftLeft(I2c.addr, 1), 8)
            I2c.bit_i = 0
            I2c.byte_sel = 0
            I2c.mode = 2
        }
        Case 2: {
            // bit: SCL low, present data
            I2c.scl = 0
            I2c.sda = BitTest(I2c.shift, 7)
            I2c.mode = 3
        }
        Case 3: {
            // bit: SCL high (sample)
            I2c.scl = 1
            I2c.mode = 4
        }
        Case 4: {
            // shift next
            I2c.scl = 0
            I2c.shift = LowBits(ShiftLeft(I2c.shift, 1), 8)
            I2c.bit_i = Increment(I2c.bit_i)
            IfCondition GreaterEqual(I2c.bit_i, 8) ThenBlock: {
                I2c.mode = 5
            } ElseBlock: {
                I2c.mode = 2
            }
        }
        Case 5: {
            // ACK slot: release SDA (pull high), clock once
            I2c.scl = 0
            I2c.sda = 1
            I2c.mode = 6
        }
        Case 6: {
            I2c.scl = 1
            I2c.ack = BitwiseXor(I2c.ack, 1)
            I2c.mode = 7
        }
        Case 7: {
            // next byte or stop
            IfCondition IsZero(I2c.byte_sel) ThenBlock: {
                I2c.shift = I2c.wdata
                I2c.bit_i = 0
                I2c.byte_sel = 1
                I2c.mode = 2
            } ElseBlock: {
                I2c.mode = 8
            }
        }
        Case 8: {
            // STOP: SDA rises while SCL high
            I2c.scl = 1
            I2c.sda = 0
            I2c.mode = 9
        }
        Case 9: {
            I2c.sda = 1
            I2c.done = 1
            I2c.phase = LowBits(Increment(I2c.phase), 4)
            // re-arm with next payload
            I2c.wdata = LowBits(Add(I2c.wdata, 1), 8)
            I2c.done = 0
            I2c.mode = 0
        }
        Default: {
            I2c.mode = 0
        }
    }
}

RunTask(Main)
