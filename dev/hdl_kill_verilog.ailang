// =============================================================================
// KILL VERILOG — pure AILang soft-IP, zero hand-written HDL
// LFSR, CRC-8, UART-ish bit-serial TX, priority encoder, one-hot decode
// ./ailang_hdl.x -hdl dev/hdl_kill_verilog.ailang dev/hdl_kill_out
// yosys -s dev/hdl_kill_out.ys
// =============================================================================

FixedPool.Kill {
    // LFSR-16
    "lfsr":     Initialize=1
    // CRC-8 running
    "crc":      Initialize=0
    // UART-ish: shift out byte on print-like bit stream
    "tx_byte":  Initialize=0x55
    "tx_bit":   Initialize=0
    "tx_shift": Initialize=0
    "tx_busy":  Initialize=0
    "tx_line":  Initialize=1
    // Priority encode input bus
    "req":      Initialize=0
    "grant":    Initialize=0
    "onehot":   Initialize=0
    "parity":   Initialize=0
    "rev":      Initialize=0
    "muxed":    Initialize=0
    "mode":     Initialize=0
    "tick":     Initialize=0
    "byte_rom": ElementType-Byte, MaximumLength-8, Initialize=0
}

// Galois LFSR step (poly x^16+x^15+x^13+x^4+1 → taps 15,13,4 style simplified)
Function.Lfsr16Step {
    Input: s: Integer
    Output: Integer
    Body: {
        // bit0 = feedback from high bits
        b = BitwiseXor(BitTest(s, 0), BitTest(s, 2))
        b = BitwiseXor(b, BitTest(s, 3))
        b = BitwiseXor(b, BitTest(s, 5))
        // shift right, insert feedback at bit 15
        n = ShiftRight(s, 1)
        n = Select(IsNonZero(b), BitSet(n, 15), BitClear(n, 15))
        ReturnValue(LowBits(n, 16))
    }
}

// CRC-8 (poly 0x07) one byte
Function.Crc8Update {
    Input: crc: Integer
    Input: data: Integer
    Output: Integer
    Body: {
        c = LowBits(BitwiseXor(crc, data), 8)
        // 8 shift-xor steps
        i = 0
        // unrolled 8×
        c = Select(IsNonZero(BitTest(c, 7)), BitwiseXor(ShiftLeft(c, 1), 7), ShiftLeft(c, 1))
        c = LowBits(c, 8)
        c = Select(IsNonZero(BitTest(c, 7)), BitwiseXor(ShiftLeft(c, 1), 7), ShiftLeft(c, 1))
        c = LowBits(c, 8)
        c = Select(IsNonZero(BitTest(c, 7)), BitwiseXor(ShiftLeft(c, 1), 7), ShiftLeft(c, 1))
        c = LowBits(c, 8)
        c = Select(IsNonZero(BitTest(c, 7)), BitwiseXor(ShiftLeft(c, 1), 7), ShiftLeft(c, 1))
        c = LowBits(c, 8)
        c = Select(IsNonZero(BitTest(c, 7)), BitwiseXor(ShiftLeft(c, 1), 7), ShiftLeft(c, 1))
        c = LowBits(c, 8)
        c = Select(IsNonZero(BitTest(c, 7)), BitwiseXor(ShiftLeft(c, 1), 7), ShiftLeft(c, 1))
        c = LowBits(c, 8)
        c = Select(IsNonZero(BitTest(c, 7)), BitwiseXor(ShiftLeft(c, 1), 7), ShiftLeft(c, 1))
        c = LowBits(c, 8)
        c = Select(IsNonZero(BitTest(c, 7)), BitwiseXor(ShiftLeft(c, 1), 7), ShiftLeft(c, 1))
        c = LowBits(c, 8)
        ReturnValue(c)
    }
}

// Priority encode 8-bit: highest set bit index (0..7), 0 if none
Function.PriorityEncode8 {
    Input: v: Integer
    Output: Integer
    Body: {
        x = LowBits(v, 8)
        r = 0
        r = Select(IsNonZero(BitTest(x, 0)), 0, r)
        r = Select(IsNonZero(BitTest(x, 1)), 1, r)
        r = Select(IsNonZero(BitTest(x, 2)), 2, r)
        r = Select(IsNonZero(BitTest(x, 3)), 3, r)
        r = Select(IsNonZero(BitTest(x, 4)), 4, r)
        r = Select(IsNonZero(BitTest(x, 5)), 5, r)
        r = Select(IsNonZero(BitTest(x, 6)), 6, r)
        r = Select(IsNonZero(BitTest(x, 7)), 7, r)
        ReturnValue(r)
    }
}

SubRoutine.Main {
    // ROM payload
    Kill.byte_rom[0] = 72   // H
    Kill.byte_rom[1] = 68   // D
    Kill.byte_rom[2] = 76   // L
    Kill.byte_rom[3] = 33   // !
    Kill.byte_rom[4] = 10
    Kill.byte_rom[5] = 0
    Kill.byte_rom[6] = 255
    Kill.byte_rom[7] = 170

    // --- mode machine ---
    Branch Kill.mode {
        Case 0: {
            // init TX
            Kill.tx_shift = Kill.tx_byte
            Kill.tx_bit = 0
            Kill.tx_busy = 1
            Kill.tx_line = 0
            Kill.mode = 1
        }
        Case 1: {
            // shift bits (UART-ish data bits only)
            Kill.tx_line = BitTest(Kill.tx_shift, 0)
            Kill.tx_shift = ShiftRight(Kill.tx_shift, 1)
            Kill.tx_bit = Increment(Kill.tx_bit)
            IfCondition GreaterEqual(Kill.tx_bit, 8) ThenBlock: {
                Kill.tx_busy = 0
                Kill.tx_line = 1
                Kill.mode = 2
            } ElseBlock: {
                Kill.mode = 1
            }
        }
        Case 2: {
            // LFSR + CRC over ROM via index
            Kill.lfsr = Lfsr16Step(Kill.lfsr)
            Kill.crc = Crc8Update(Kill.crc, Kill.byte_rom[LowBits(Kill.tick, 3)])
            Kill.tick = Increment(Kill.tick)
            IfCondition GreaterEqual(Kill.tick, 8) ThenBlock: {
                Kill.mode = 3
            } ElseBlock: {
                Kill.mode = 2
            }
        }
        Case 3: {
            // encode / decode / mux showcase
            Kill.req = LowBits(Kill.lfsr, 8)
            Kill.grant = PriorityEncode8(Kill.req)
            Kill.onehot = OneHot(Kill.grant, 8)
            Kill.parity = Parity8(Kill.req)
            Kill.rev = ReverseBits8(Kill.req)
            Kill.muxed = Mux4(LowBits(Kill.grant, 2), 10, 20, 30, 40)
            Kill.mode = 3
        }
        Default: {
            Kill.mode = 0
        }
    }

    // Continuous soft counters always
    Kill.tick = Select(EqualTo(Kill.mode, 3), Kill.tick, Kill.tick)
}

RunTask(Main)
