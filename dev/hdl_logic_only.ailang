// Pure logic smoke — no print channel (cleaner Yosys check)
// ./ailang_hdl.x -hdl dev/hdl_logic_only.ailang dev/hdl_logic_out
// yosys -s dev/hdl_logic_out.ys

FixedPool.App {
    "a":   Initialize=3
    "b":   Initialize=5
    "out": Initialize=0
    "sel": Initialize=0
    "tab": ElementType-Byte, MaximumLength-4, Initialize=1
}

Function.Mix {
    Input: x: Integer
    Input: y: Integer
    Output: Integer
    Body: {
        s = Add(x, y)
        z = BitwiseXor(s, y)
        ReturnValue(Modulo(ShiftLeft(z, 1), 16))
    }
}

SubRoutine.Main {
    App.out = Mix(App.a, App.b)
    App.out = Clamp(App.out, 0, 15)
    App.sel = Select(GreaterThan(App.out, 8), 1, 0)

    App.tab[0] = App.out
    App.tab[1] = Increment(App.a)

    // Mux-style if
    IfCondition EqualTo(App.sel, 1) ThenBlock: {
        App.a = Add(App.a, 1)
    } ElseBlock: {
        App.a = Subtract(App.a, 1)
    }

    // Reduce table
    App.b = 0
    ForEvery e in App.tab {
        App.b = Add(App.b, e)
        App.b = Max(App.b, e)
    }
}

RunTask(Main)
