// Orthogonal prims dogfood — normal AILang builtins → Yosys-facing cells
// ./ailang_hdl.x -hdl dev/hdl_prims_smoke.ailang dev/hdl_prims_out
// yosys -s dev/hdl_prims_out.ys
//
// Philosophy: structure in the language so the lowerer is boring.
// Functions, FixedPool, If, arithmetic — not a second HDL dialect.

FixedPool.App {
    "acc":   Initialize=0
    "flags": Initialize=0
    "pick":  Initialize=0
}

// Comb function: pure ops → $add $xor $shl … via NetlistPrims
Function.Mix {
    Input: a: Integer
    Input: b: Integer
    Output: Integer
    Body: {
        s = Add(a, b)
        x = BitwiseXor(s, b)
        sh = ShiftLeft(x, 1)
        m = Modulo(sh, 16)
        ReturnValue(m)
    }
}

Function.AbsLike {
    Input: v: Integer
    Output: Integer
    Body: {
        ReturnValue(AbsoluteValue(v))
    }
}

SubRoutine.Main {
    // Function instance
    App.acc = Mix(3, 5)

    // Structured If → mux (same target, expr arms) — not seq if-soup
    IfCondition GreaterThan(App.acc, 8) ThenBlock: {
        App.pick = Add(App.acc, 1)
    } ElseBlock: {
        App.pick = Subtract(App.acc, 1)
    }

    // Const arms still → 2-entry LUT
    IfCondition EqualTo(App.pick, 0) ThenBlock: {
        App.flags = 1
    } ElseBlock: {
        App.flags = 2
    }

    App.acc = AbsLike(App.pick)
}

RunTask(Main)
