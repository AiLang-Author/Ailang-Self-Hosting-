// =============================================================================
// PWM + free-running timer soft-IP — pure AILang
// counter wraps at period; pwm high while cnt < duty
// =============================================================================

FixedPool.Pwm {
    "cnt":      Initialize=0
    "period":   Initialize=16
    "duty":     Initialize=6
    "out":      Initialize=0
    "wrap":     Initialize=0
    "tick":     Initialize=0
    "duty2":    Initialize=0
    "mode":     Initialize=0
}

// next counter value with wrap
Function.TimerTick {
    Input: cnt: Integer
    Input: period: Integer
    Output: Integer
    Body: {
        n = Increment(cnt)
        // if n >= period → 0
        ReturnValue(Select(GreaterEqual(n, period), 0, n))
    }
}

SubRoutine.Main {
    // free-run timer
    Pwm.wrap = EqualTo(Pwm.cnt, Subtract(Pwm.period, 1))
    Pwm.cnt = TimerTick(Pwm.cnt, Pwm.period)
    // compare
    Pwm.out = Select(LessThan(Pwm.cnt, Pwm.duty), 1, 0)

    // slowly modulate duty for fabric interest
    Branch Pwm.mode {
        Case 0: {
            Pwm.tick = Increment(Pwm.tick)
            IfCondition GreaterEqual(Pwm.tick, 4) ThenBlock: {
                Pwm.duty = LowBits(Increment(Pwm.duty), 4)
                Pwm.tick = 0
                IfCondition GreaterEqual(Pwm.duty, Pwm.period) ThenBlock: {
                    Pwm.duty = 1
                    Pwm.mode = 1
                } ElseBlock: {
                    Pwm.mode = 0
                }
            } ElseBlock: {
                Pwm.mode = 0
            }
        }
        Case 1: {
            // second channel duty mirror via sat helpers
            Pwm.duty2 = SubSatU8(Pwm.period, Pwm.duty)
            Pwm.mode = 0
        }
        Default: {
            Pwm.mode = 0
        }
    }
}

RunTask(Main)
