// Minimal HDL smoke — FixedPool + Function + SubRoutine + RunTask
// ./ailang_hdl.x -hdl dev/hdl_smoke.ailang dev/hdl_smoke_out

FixedPool.App {
    "count": Initialize=0
    "limit": Initialize=42
    "flags": Initialize=1
}

Function.Inc {
    Input: step: Integer
    Output: Integer
    Body: {
        ReturnValue(step)
    }
}

SubRoutine.Tick {
}

SubRoutine.Main {
}

RunTask(Main)
