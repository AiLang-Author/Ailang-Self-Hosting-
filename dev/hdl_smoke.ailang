// HDL dogfood — Programming_Manual/AILANG HDL Programming Guide.md
// Artifacts: base.v base.nl.json base.sdc base.ys
// ./ailang_hdl.x -hdl dev/hdl_smoke.ailang dev/hdl_smoke_out

FixedPool.App {
    "count": Initialize=0
    "limit": Initialize=42
    "mode":  Initialize=1
    "table": ElementType-Integer, MaximumLength-4, Initialize=7
}

// Ready/valid stream ports
FixedPool.Stream {
    "in_data":   Initialize=0
    "in_valid":  Initialize=0
    "in_ready":  Initialize=1
    "out_data":  Initialize=0
    "out_valid": Initialize=0
    "out_ready": Initialize=0
}

Function.Inc {
    Input: step: Integer
    Output: Integer
    Body: {
        ReturnValue(Add(step, 1))
    }
}

SubRoutine.Main {
    // Multi-cycle: climb while count < 4
    WhileLoop LessThan(App.count, 4) {
        App.count = Inc(App.count)
    }

    // ROM: const + variable index
    App.limit = App.table[2]
    App.limit = App.table[App.mode]

    // Const-arm If → 2-entry LUT
    IfCondition EqualTo(App.mode, 0) ThenBlock: {
        App.count = 100
    } ElseBlock: {
        App.count = 200
    }

    // Stream fire: transfer when valid && our ready
    // in_ready asserted when we can accept (always-on sink for smoke)
    Stream.in_ready = 1
    IfCondition EqualTo(And(Stream.in_valid, Stream.in_ready), 1) ThenBlock: {
        Stream.out_data = Stream.in_data
        Stream.out_valid = 1
    } ElseBlock: {
        Stream.out_valid = 0
    }
}

RunTask(Main)
