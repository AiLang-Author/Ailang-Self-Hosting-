// HDL smoke: comb Function + sequential Main + Branch→LUT table
// ./ailang_hdl.x -hdl dev/hdl_smoke.ailang dev/hdl_smoke_out

FixedPool.App {
    "count": Initialize=0
    "limit": Initialize=42
    "mode":  Initialize=1
}

// Combinational: result = step + 1
Function.Inc {
    Input: step: Integer
    Output: Integer
    Body: {
        ReturnValue(Add(step, 1))
    }
}

// Sequential on ailang_top:
// 1) count <= count + 1
// 2) Branch mode → solution table (LUT), NOT if-else chains
SubRoutine.Main {
    App.count = Add(App.count, 1)

    Branch App.mode {
        Case 0: {
            App.limit = 10
        }
        Case 1: {
            App.limit = 20
        }
        Case 2: {
            App.limit = 30
        }
        Default: {
            App.limit = 0
        }
    }
}

RunTask(Main)
