// HDL dogfood — see Programming_Manual/AILANG HDL Programming Guide.md
// ./ailang_hdl.x -hdl dev/hdl_smoke.ailang dev/hdl_smoke_out

FixedPool.App {
    "count": Initialize=0
    "limit": Initialize=42
    "mode":  Initialize=1
}

// Combinational module
Function.Inc {
    Input: step: Integer
    Output: Integer
    Body: {
        ReturnValue(Add(step, 1))
    }
}

// Sequential on ailang_top: user call Inc + Branch→LUT
SubRoutine.Main {
    // User Function call → hierarchical instance
    App.count = Inc(App.count)

    Branch App.mode {
        Case 0: { App.limit = 10 }
        Case 1: { App.limit = 20 }
        Case 2: { App.limit = 30 }
        Default: { App.limit = 0 }
    }
}

RunTask(Main)
