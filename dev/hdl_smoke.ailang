// HDL dogfood — Programming_Manual/AILANG HDL Programming Guide.md
// ./ailang_hdl.x -hdl dev/hdl_smoke.ailang dev/hdl_smoke_out

FixedPool.App {
    "count": Initialize=0
    "limit": Initialize=42
    "mode":  Initialize=1
}

Function.Inc {
    Input: step: Integer
    Output: Integer
    Body: {
        ReturnValue(Add(step, 1))
    }
}

// Sequential top:
//  - While: one iteration per clock while count < 8 (multi-cycle climb)
//  - Branch: mode → limit LUT (table, not if-else)
SubRoutine.Main {
    WhileLoop LessThan(App.count, 8) {
        App.count = Inc(App.count)
    }

    Branch App.mode {
        Case 0: { App.limit = 10 }
        Case 1: { App.limit = 20 }
        Case 2: { App.limit = 30 }
        Default: { App.limit = 0 }
    }
}

RunTask(Main)
