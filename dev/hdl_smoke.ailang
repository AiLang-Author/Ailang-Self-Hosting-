// HDL dogfood — useful chip patterns in one file
// Guide: Programming_Manual/AILANG HDL Programming Guide.md
// Template: dev/hdl_templates/stream_skid_1deep.ailang
//
// ./ailang_hdl.x -hdl dev/hdl_smoke.ailang dev/hdl_smoke_out
// yosys -s dev/hdl_smoke_out.ys

FixedPool.App {
    "count": Initialize=0
    "mode":  Initialize=1
    "table": ElementType-Integer, MaximumLength-4, Initialize=7
}

// 1-deep skid stream (see template for comments)
FixedPool.Stream {
    "in_data":   Initialize=0
    "in_valid":  Initialize=0
    "in_ready":  Initialize=1
    "out_data":  Initialize=0
    "out_valid": Initialize=0
    "out_ready": Initialize=0
}

FixedPool.Skid {
    "data":  Initialize=0
    "valid": Initialize=0
}

Function.Inc {
    Input: step: Integer
    Output: Integer
    Body: {
        ReturnValue(Add(step, 1))
    }
}

SubRoutine.Main {
    // --- Comb / table style ---
    App.count = Inc(App.count)
    App.count = App.table[App.mode]

    // Const If → 2-entry LUT (prefer tables over deep if chains)
    IfCondition EqualTo(App.mode, 0) ThenBlock: {
        App.mode = 1
    } ElseBlock: {
        App.mode = 0
    }

    // --- Stream skid (useful default for backpressure) ---
    Stream.in_ready = 1
    IfCondition EqualTo(Skid.valid, 1) ThenBlock: {
        Stream.in_ready = Stream.out_ready
    }
    Stream.out_data = Skid.data
    Stream.out_valid = Skid.valid
    IfCondition EqualTo(And(Skid.valid, Stream.out_ready), 1) ThenBlock: {
        Skid.valid = 0
    }
    IfCondition EqualTo(And(Stream.in_valid, Stream.in_ready), 1) ThenBlock: {
        Skid.data = Stream.in_data
        Skid.valid = 1
    }
}

RunTask(Main)
