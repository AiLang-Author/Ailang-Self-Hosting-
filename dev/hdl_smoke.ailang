// HDL dogfood — Programming_Manual/AILANG HDL Programming Guide.md
// ./ailang_hdl.x -hdl dev/hdl_smoke.ailang dev/hdl_smoke_out

FixedPool.App {
    "count": Initialize=0
    "limit": Initialize=42
    "mode":  Initialize=1
    // ROM / array
    "table": ElementType-Integer, MaximumLength-4, Initialize=7
}

// Stream-style ports: in_* = inputs, out_* = outputs (ready/valid convention)
FixedPool.Stream {
    "in_data":   Initialize=0
    "in_valid":  Initialize=0
    "in_ready":  Initialize=1
    "out_data":  Initialize=0
    "out_valid": Initialize=0
    "out_ready": Initialize=0
}

Function.Inc {
    Input: step: Integer
    Output: Integer
    Body: {
        ReturnValue(Add(step, 1))
    }
}

// 2x2 solution matrix as flat ROM (row-major): index = y*2 + x
//   (0,0)=10 (0,1)=11
//   (1,0)=20 (1,1)=21
FixedPool.Mat {
    "cells": ElementType-Integer, MaximumLength-4, Initialize=0
}

SubRoutine.Main {
    // Multi-cycle climb
    WhileLoop LessThan(App.count, 4) {
        App.count = Inc(App.count)
    }

    // Const + variable index into ROM
    App.limit = App.table[2]
    App.limit = App.table[App.mode]

    // 2D matrix style: idx = mode*2 + (count & 1) approximated as Add
    // (keep simple: mode indexes mat)
    App.limit = Mat.cells[App.mode]

    // If both arms const → 2-entry LUT (not if-else chain)
    IfCondition EqualTo(App.mode, 0) ThenBlock: {
        App.count = 100
    } ElseBlock: {
        App.count = 200
    }

    // Stream: when in_valid and we are ready, capture; pulse out_valid
    IfCondition EqualTo(Stream.in_valid, 1) ThenBlock: {
        Stream.out_data = Stream.in_data
        Stream.out_valid = 1
    } ElseBlock: {
        Stream.out_valid = 0
    }
    Stream.in_ready = 1
}

RunTask(Main)
