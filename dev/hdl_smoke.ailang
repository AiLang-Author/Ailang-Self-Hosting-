// HDL dogfood — Programming_Manual/AILANG HDL Programming Guide.md
// ./ailang_hdl.x -hdl dev/hdl_smoke.ailang dev/hdl_smoke_out

FixedPool.App {
    "count": Initialize=0
    "limit": Initialize=42
    "mode":  Initialize=1
    // Array / ROM — MaximumLength + ElementType (dash form)
    "table": ElementType-Integer, MaximumLength-4, Initialize=7
}

Function.Inc {
    Input: step: Integer
    Output: Integer
    Body: {
        ReturnValue(Add(step, 1))
    }
}

SubRoutine.Main {
    WhileLoop LessThan(App.count, 4) {
        App.count = Inc(App.count)
    }

    // Const index into FixedPool array
    App.limit = App.table[2]

    Branch App.mode {
        Case 0: { App.limit = 10 }
        Case 1: { App.limit = 20 }
        Case 2: { App.limit = 30 }
        Default: { App.limit = 0 }
    }
}

RunTask(Main)
