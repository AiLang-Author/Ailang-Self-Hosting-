// HDL dogfood — Programming_Manual/AILANG HDL Programming Guide.md
// Artifacts: .v .nl.json .sdc .ys .pins  (+ .blif via yosys -s)
// ./ailang_hdl.x -hdl dev/hdl_smoke.ailang dev/hdl_smoke_out

// ---------------------------------------------------------------------------
// State + ROM
// ---------------------------------------------------------------------------
FixedPool.App {
    "count": Initialize=0
    "limit": Initialize=42
    "mode":  Initialize=1
    "table": ElementType-Integer, MaximumLength-4, Initialize=7
}

// Simple FSM state: 0=IDLE 1=RUN 2=DRAIN 3=DONE
FixedPool.Fsm {
    "state": Initialize=0
    "beats": Initialize=0
}

// ---------------------------------------------------------------------------
// Ready/valid stream + 1-deep skid hold
// ---------------------------------------------------------------------------
FixedPool.Stream {
    "in_data":   Initialize=0
    "in_valid":  Initialize=0
    "in_ready":  Initialize=1
    "out_data":  Initialize=0
    "out_valid": Initialize=0
    "out_ready": Initialize=0
}

// Skid buffer (one beat) when sink not ready
FixedPool.Skid {
    "data":  Initialize=0
    "valid": Initialize=0
}

Function.Inc {
    Input: step: Integer
    Output: Integer
    Body: {
        ReturnValue(Add(step, 1))
    }
}

SubRoutine.Main {
    // ----- FSM table (prefer Branch/LUT for dense multi-way) -----
    // IDLE(0) → RUN(1) when input valid
    // RUN(1)  → DRAIN(2) after 4 beats
    // DRAIN(2)→ DONE(3) when skid empty
    // DONE(3) stays
    Branch Fsm.state {
        Case 0: { Fsm.state = 0 }
        Case 1: { Fsm.state = 1 }
        Case 2: { Fsm.state = 2 }
        Case 3: { Fsm.state = 3 }
        Default: { Fsm.state = 0 }
    }

    // IDLE: arm run on first valid
    IfCondition EqualTo(Fsm.state, 0) ThenBlock: {
        IfCondition EqualTo(Stream.in_valid, 1) ThenBlock: {
            Fsm.state = 1
            Fsm.beats = 0
        }
    }

    // RUN: skid-aware stream
    // in_ready when skid free or sink draining us
    // Simplified skid:
    //   accept when !Skid.valid || Stream.out_ready
    //   present skid to output when Skid.valid
    IfCondition EqualTo(Fsm.state, 1) ThenBlock: {
        // default: ready if skid empty
        Stream.in_ready = 1
        IfCondition EqualTo(Skid.valid, 1) ThenBlock: {
            // skid full — only ready if sink takes a beat
            Stream.in_ready = Stream.out_ready
        }

        // drive output from skid
        Stream.out_data = Skid.data
        Stream.out_valid = Skid.valid

        // sink took a beat
        IfCondition EqualTo(And(Skid.valid, Stream.out_ready), 1) ThenBlock: {
            Skid.valid = 0
        }

        // source offered a beat and we can take it
        IfCondition EqualTo(And(Stream.in_valid, Stream.in_ready), 1) ThenBlock: {
            Skid.data = Stream.in_data
            Skid.valid = 1
            Fsm.beats = Inc(Fsm.beats)
        }

        // finished multi-beat run
        IfCondition EqualTo(Fsm.beats, 4) ThenBlock: {
            Fsm.state = 2
        }
    }

    // DRAIN: stop accepting; flush skid
    IfCondition EqualTo(Fsm.state, 2) ThenBlock: {
        Stream.in_ready = 0
        Stream.out_data = Skid.data
        Stream.out_valid = Skid.valid
        IfCondition EqualTo(And(Skid.valid, Stream.out_ready), 1) ThenBlock: {
            Skid.valid = 0
        }
        IfCondition EqualTo(Skid.valid, 0) ThenBlock: {
            Fsm.state = 3
            Stream.out_valid = 0
        }
    }

    // DONE: idle outputs
    IfCondition EqualTo(Fsm.state, 3) ThenBlock: {
        Stream.in_ready = 0
        Stream.out_valid = 0
        App.count = Inc(App.count)
    }

    // ROM demo
    App.limit = App.table[App.mode]
}

RunTask(Main)
