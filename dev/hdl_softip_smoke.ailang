// Soft-IP helpers: PopCount / Gray / saturating add — pure AILang core
// No TechBlock, no hand HDL. ./ailang_hdl.x -hdl dev/hdl_softip_smoke.ailang /tmp/sip

FixedPool.Sip {
    "x":      Initialize=0xA5
    "y":      Initialize=0x3C
    "pop":    Initialize=0
    "gray":   Initialize=0
    "bin":    Initialize=0
    "sat":    Initialize=0
    "addsat": Initialize=0
    "edge":   Initialize=0
    "prev":   Initialize=0
    "rise":   Initialize=0
}

// Rising edge detect (soft)
Function.RiseEdge {
    Input: cur: Integer
    Input: prev: Integer
    Output: Integer
    Body: {
        ReturnValue(And(IsNonZero(cur), IsZero(prev)))
    }
}

// Gray round-trip via builtins
Function.GrayRoundTrip {
    Input: v: Integer
    Output: Integer
    Body: {
        g = GrayEncode8(v)
        ReturnValue(GrayDecode8(g))
    }
}

SubRoutine.Main {
    Sip.pop = PopCount8(Sip.x)
    Sip.gray = GrayEncode8(Sip.x)
    Sip.bin = GrayRoundTrip(Sip.x)
    Sip.sat = SaturateU8(Add(Sip.x, 200))
    Sip.addsat = AddSatU8(Sip.x, Sip.y)
    // also exercise ctz/clz/byteswap on fabric
    Sip.y = LowBits(Add(Sip.y, Ctz8(Sip.x)), 8)
    Sip.y = LowBits(Add(Sip.y, Clz8(Sip.x)), 8)
    Sip.y = LowBits(ByteSwap16(Sip.y), 8)
    // edge: treat lsb of x as "input"
    Sip.edge = LowBits(Sip.x, 1)
    Sip.rise = RiseEdge(Sip.edge, Sip.prev)
    Sip.prev = Sip.edge
    // rotate / flip for more fabric
    Sip.y = LowBits(BitwiseXor(Sip.y, Sip.pop), 8)
}

RunTask(Main)
