// =============================================================================
// SPI-ish bit-serial master soft-IP — pure AILang (MSB-first, mode 0-ish)
// cs_n low during transfer; sclk toggles; mosi = shift MSB
// ./ailang_hdl.x -hdl dev/hdl_spi_smoke.ailang /tmp/spi
// =============================================================================

FixedPool.Spi {
    "tx_byte":  Initialize=0xA5
    "rx_byte":  Initialize=0
    "shift":    Initialize=0
    "bit_i":    Initialize=0
    "sclk":     Initialize=0
    "mosi":     Initialize=0
    "miso":     Initialize=0
    "cs_n":     Initialize=1
    "mode":     Initialize=0
    "done":     Initialize=0
    "phase":    Initialize=0
    "sats":     Initialize=0
    "sext":     Initialize=0
}

SubRoutine.Main {
    Branch Spi.mode {
        Case 0: {
            // load + assert CS
            Spi.shift = Spi.tx_byte
            Spi.bit_i = 0
            Spi.cs_n = 0
            Spi.sclk = 0
            Spi.mosi = BitTest(Spi.shift, 7)
            Spi.mode = 1
        }
        Case 1: {
            // clock high half: sample miso (tie to mosi loopback soft)
            Spi.sclk = 1
            Spi.miso = Spi.mosi
            Spi.rx_byte = LowBits(BitwiseOr(ShiftLeft(Spi.rx_byte, 1), Spi.miso), 8)
            Spi.mode = 2
        }
        Case 2: {
            // clock low half: shift next bit
            Spi.sclk = 0
            Spi.shift = LowBits(ShiftLeft(Spi.shift, 1), 8)
            Spi.bit_i = Increment(Spi.bit_i)
            IfCondition GreaterEqual(Spi.bit_i, 8) ThenBlock: {
                Spi.cs_n = 1
                Spi.mosi = 0
                Spi.done = 1
                Spi.mode = 3
            } ElseBlock: {
                Spi.mosi = BitTest(Spi.shift, 7)
                Spi.mode = 1
            }
        }
        Case 3: {
            // post: soft helpers on result
            Spi.sats = SubSatU8(Spi.tx_byte, Spi.rx_byte)
            Spi.sext = SignExtend8(Spi.rx_byte)
            Spi.phase = LowBits(Increment(Spi.phase), 4)
            // re-arm with next pattern
            Spi.tx_byte = LowBits(Add(Spi.tx_byte, 1), 8)
            Spi.done = 0
            Spi.rx_byte = 0
            Spi.mode = 0
        }
        Default: {
            Spi.mode = 0
        }
    }
}

RunTask(Main)
