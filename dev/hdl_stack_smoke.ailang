// =============================================================================
// Hardware stack soft-IP — pure AILang (depth-8)
// push / pop / peek with overflow & underflow flags
// =============================================================================

FixedPool.Stk {
    "mem":      ElementType-Integer, MaximumLength-8, Initialize=0
    "sp":       Initialize=0
    "tos":      Initialize=0
    "din":      Initialize=1
    "full":     Initialize=0
    "empty":    Initialize=1
    "ovf":      Initialize=0
    "unf":      Initialize=0
    "mode":     Initialize=0
    "n":        Initialize=0
}

SubRoutine.Main {
    Stk.full = EqualTo(Stk.sp, 8)
    Stk.empty = IsZero(Stk.sp)

    Branch Stk.mode {
        Case 0: {
            // push until full
            IfCondition IsZero(Stk.full) ThenBlock: {
                Stk.mem[Stk.sp] = Stk.din
                Stk.sp = Increment(Stk.sp)
                Stk.tos = Stk.din
                Stk.din = LowBits(Add(Stk.din, 3), 8)
                Stk.n = Increment(Stk.n)
            } ElseBlock: {
                Stk.ovf = 1
                Stk.mode = 1
            }
        }
        Case 1: {
            // pop until empty
            IfCondition IsZero(Stk.empty) ThenBlock: {
                Stk.sp = Decrement(Stk.sp)
                Stk.tos = Stk.mem[Stk.sp]
                Stk.n = Increment(Stk.n)
            } ElseBlock: {
                Stk.unf = 1
                Stk.mode = 2
            }
        }
        Case 2: {
            Stk.mode = 2
        }
        Default: {
            Stk.mode = 0
        }
    }
}

RunTask(Main)
