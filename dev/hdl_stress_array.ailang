// Aggressive: max ForEvery unroll (32), var index R/W, multi-driver patterns

FixedPool.App {
    "i":   Initialize=0
    "v":   Initialize=0
    "sum": Initialize=0
    "big": ElementType-Byte, MaximumLength-32, Initialize=0
}

SubRoutine.Main {
    // Fill via index writes
    App.i = 0
    WhileLoop LessThan(App.i, 32) {
        App.big[App.i] = LowBits(Add(App.i, 3), 8)
        App.i = Increment(App.i)
    }

    // Full unroll reduce depth=32
    App.sum = 0
    ForEvery e in App.big {
        App.sum = Add(App.sum, e)
        App.v = Max(App.v, e)
        App.v = Min(App.v, 200)
    }

    // Variable index read-modify-write chain
    App.i = 5
    App.v = App.big[App.i]
    App.big[App.i] = Add(App.v, 1)
    App.i = 31
    App.big[App.i] = BitSet(App.big[App.i], 0)
    App.v = App.big[App.i]

    // Intentional multi-driver: last should win for uncond seq
    App.sum = 1
    App.sum = 2
    App.sum = 3
}

RunTask(Main)
