// Aggressive: bit/rotate/power edge cases + wide expression trees

FixedPool.App {
    "w": Initialize=0xA5A5
    "r": Initialize=0
    "m": Initialize=0
    "p": Initialize=0
    "z": Initialize=0
}

SubRoutine.Main {
    // All bit positions 0..7
    App.m = 0
    App.m = BitSet(App.m, 0)
    App.m = BitSet(App.m, 1)
    App.m = BitSet(App.m, 2)
    App.m = BitSet(App.m, 3)
    App.m = BitSet(App.m, 4)
    App.m = BitSet(App.m, 5)
    App.m = BitSet(App.m, 6)
    App.m = BitSet(App.m, 7)
    App.m = BitClear(App.m, 3)
    App.z = BitTest(App.m, 7)

    // Rotate extremes
    App.r = RotateLeft(App.w, 1)
    App.r = RotateLeft(App.r, 63)
    App.r = RotateRight(App.r, 0)
    App.r = RotateRight(App.r, 32)

    // Power ladder
    App.p = Power(2, 0)
    App.p = Power(3, 1)
    App.p = Power(2, 8)
    App.p = Power(App.z, 2)

    // Fat expression
    App.w = Clamp(
        LowBits(
            Xor(
                RotateLeft(Add(App.w, App.m), 5),
                BitwiseOr(App.r, App.p)
            ),
            16
        ),
        0,
        65535
    )

    App.z = Select(IsZero(App.w), 1, Select(IsNonZero(App.m), App.m, 0))
    App.z = AbsoluteValue(Subtract(0, App.z))
    App.z = Min(Max(App.z, 0), 255)
}

RunTask(Main)
