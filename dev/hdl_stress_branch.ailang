// Aggressive: dense Branch table + multi-way + while/until mix

FixedPool.App {
    "mode": Initialize=0
    "out":  Initialize=0
    "n":    Initialize=0
}

Function.Decode {
    Input: m: Integer
    Output: Integer
    Body: {
        // table via nested Select (mux tree) — not Branch inside Function
        r = Select(EqualTo(m, 0), 10,
            Select(EqualTo(m, 1), 20,
            Select(EqualTo(m, 2), 30,
            Select(EqualTo(m, 3), 40, 99))))
        ReturnValue(r)
    }
}

SubRoutine.Main {
    App.mode = 3
    App.out = Decode(App.mode)

    Branch App.mode {
        Case 0: { App.out = 100 }
        Case 1: { App.out = 101 }
        Case 2: { App.out = 102 }
        Case 3: { App.out = 103 }
        Case 4: { App.out = 104 }
        Case 5: { App.out = 105 }
        Case 6: { App.out = 106 }
        Case 7: { App.out = 107 }
        Case 8: { App.out = 108 }
        Case 9: { App.out = 109 }
        Case 10: { App.out = 110 }
        Case 11: { App.out = 111 }
        Case 12: { App.out = 112 }
        Case 13: { App.out = 113 }
        Case 14: { App.out = 114 }
        Case 15: { App.out = 115 }
        Default: { App.out = 255 }
    }

    App.n = 0
    WhileLoop LessThan(App.n, 6) {
        App.n = Increment(App.n)
        App.out = Add(App.out, App.n)
    }

    UntilCondition GreaterEqual(App.n, 10) {
        App.n = Increment(App.n)
    }

    // multi-stmt if arms (force seq if, not LUT)
    IfCondition GreaterThan(App.out, 200) ThenBlock: {
        App.mode = 1
        App.n = Add(App.n, 1)
        App.out = LowBits(App.out, 8)
    } ElseBlock: {
        App.mode = 0
        App.n = Subtract(App.n, 1)
        App.out = BitSet(App.out, 0)
    }
}

RunTask(Main)
