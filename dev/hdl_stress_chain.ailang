// Stress: straight-line chain + array slot chain + multi-stmt if arms
// Must accumulate BitSet chain and tab[0] write-then-read via shadow

FixedPool.App {
    "m":   Initialize=0
    "x":   Initialize=0
    "tab": ElementType-Byte, MaximumLength-4, Initialize=0
}

SubRoutine.Main {
    // Scalar chain: all bits 0..3 set
    App.m = 0
    App.m = BitSet(App.m, 0)
    App.m = BitSet(App.m, 1)
    App.m = BitSet(App.m, 2)
    App.m = BitSet(App.m, 3)

    // Const-index array chain: write then read should see write
    App.tab[0] = 11
    App.tab[0] = Add(App.tab[0], 1)
    App.tab[1] = App.tab[0]
    App.x = App.tab[1]

    // Multi-stmt if arm chain
    IfCondition IsNonZero(App.m) ThenBlock: {
        App.x = BitSet(App.x, 0)
        App.x = BitSet(App.x, 1)
        App.m = Add(App.m, 1)
    } ElseBlock: {
        App.x = 0
        App.x = Increment(App.x)
        App.m = 1
    }
}

RunTask(Main)
