// EXTREME: deep calls, mixed control, multi-array, print+logic, edges
// Goal: break the compiler / Yosys

FixedPool.App {
    "a": Initialize=0
    "b": Initialize=1
    "c": Initialize=2
    "d": Initialize=3
    "acc": Initialize=0
    "st": Initialize=0
    "t0": ElementType-Byte, MaximumLength-8, Initialize=0
    "t1": ElementType-Byte, MaximumLength-8, Initialize=0
    "t2": ElementType-Byte, MaximumLength-16, Initialize=0
}

Function.OpA {
    Input: x: Integer
    Output: Integer
    Body: {
        ReturnValue(LowBits(Xor(RotateLeft(x, 3), 0x5A), 8))
    }
}

Function.OpB {
    Input: x: Integer
    Input: y: Integer
    Output: Integer
    Body: {
        ReturnValue(Clamp(Add(Multiply(x, y), Power(2, 3)), 0, 255))
    }
}

Function.OpC {
    Input: x: Integer
    Output: Integer
    Body: {
        // deep nest pure
        ReturnValue(OpA(OpB(x, Increment(x))))
    }
}

Function.Fold4 {
    Input: a: Integer
    Input: b: Integer
    Input: c: Integer
    Input: d: Integer
    Output: Integer
    Body: {
        ReturnValue(Max(Min(a, b), Min(c, d)))
    }
}

SubRoutine.Main {
    // Seed tables with chains
    App.t0[0] = 1
    App.t0[1] = 2
    App.t0[2] = 4
    App.t0[3] = 8
    App.t0[4] = 16
    App.t0[5] = 32
    App.t0[6] = 64
    App.t0[7] = 128

    App.t1[0] = App.t0[0]
    App.t1[1] = Add(App.t0[1], 1)
    App.t1[2] = BitSet(App.t0[2], 0)
    App.t1[3] = BitClear(App.t0[3], 3)
    App.t1[4] = RotateLeft(App.t0[4], 1)
    App.t1[5] = RotateRight(App.t0[5], 1)
    App.t1[6] = AbsoluteValue(Subtract(0, 7))
    App.t1[7] = Power(2, 4)

    // Fill t2 from mixed
    App.a = 0
    WhileLoop LessThan(App.a, 16) {
        App.t2[App.a] = LowBits(Add(App.a, App.t0[LowBits(App.a, 3)]), 8)
        App.a = Increment(App.a)
    }

    // Deep calls
    App.b = OpC(App.t1[3])
    App.c = OpB(App.b, App.t1[4])
    App.d = Fold4(App.t0[0], App.t0[1], App.t1[2], App.t1[3])

    // Nested ForEvery 8x8
    App.acc = 0
    ForEvery e in App.t0 {
        ForEvery f in App.t1 {
            App.acc = Add(App.acc, BitwiseAnd(e, f))
            App.acc = Select(GreaterThan(e, f), Add(App.acc, 1), App.acc)
        }
    }

    // ForEvery 16
    ForEvery e in App.t2 {
        App.st = Max(App.st, e)
        App.st = Min(App.st, 200)
    }

    // Nested if multi-stmt + while inside if
    IfCondition GreaterThan(App.acc, 0) ThenBlock: {
        App.a = BitSet(App.a, 0)
        App.a = BitSet(App.a, 1)
        App.b = OpA(App.a)
        WhileLoop LessThan(App.c, 5) {
            App.c = Increment(App.c)
            App.d = Xor(App.d, App.c)
        }
        IfCondition IsZero(App.d) ThenBlock: {
            App.d = 1
        } ElseBlock: {
            App.d = LowBits(App.d, 7)
            App.d = BitSet(App.d, 6)
        }
    } ElseBlock: {
        App.a = 0
        App.b = 0
        App.c = 0
        App.d = 255
    }

    // Branch dense + Default
    Branch LowBits(App.st, 4) {
        Case 0: { App.a = 10 }
        Case 1: { App.a = 11 }
        Case 2: { App.a = 12 }
        Case 3: { App.a = 13 }
        Case 4: { App.a = 14 }
        Case 5: { App.a = 15 }
        Case 6: { App.a = 16 }
        Case 7: { App.a = 17 }
        Case 8: { App.a = 18 }
        Case 9: { App.a = 19 }
        Case 10: { App.a = 20 }
        Case 11: { App.a = 21 }
        Case 12: { App.a = 22 }
        Case 13: { App.a = 23 }
        Case 14: { App.a = 24 }
        Case 15: { App.a = 25 }
        Default: { App.a = 99 }
    }

    // Until + edge Power/Rotate
    UntilCondition GreaterEqual(App.b, 3) {
        App.b = Increment(App.b)
    }
    App.c = Power(App.b, 0)
    App.c = Power(App.b, 1)
    App.d = RotateLeft(App.d, 0)
    App.d = RotateRight(App.d, 63)

    // Print queue + multi itoa jobs
    PrintMessage("acc=")
    PrintNumber(App.acc)
    PrintMessage(" st=")
    PrintNumber(App.st)
    PrintMessage("\n")
    PrintNumber(App.a)
    PrintNumber(App.b)
    PrintNumber(App.c)
    PrintNumber(App.d)
}

RunTask(Main)
