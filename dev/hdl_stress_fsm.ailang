// Soft FSM pattern: mode reg + Branch + While counters

FixedPool.App {
    "mode":  Initialize=0
    "cnt":   Initialize=0
    "tick":  Initialize=0
    "out":   Initialize=0
    "done":  Initialize=0
}

SubRoutine.Main {
    // mode machine via Branch
    Branch App.mode {
        Case 0: {
            App.out = 1
            App.cnt = 0
            App.mode = 1
        }
        Case 1: {
            App.cnt = Increment(App.cnt)
            App.out = BitSet(App.out, 1)
            IfCondition GreaterEqual(App.cnt, 4) ThenBlock: {
                App.mode = 2
                App.cnt = 0
            } ElseBlock: {
                App.mode = 1
            }
        }
        Case 2: {
            App.tick = Increment(App.tick)
            App.out = Xor(App.out, App.tick)
            IfCondition GreaterEqual(App.tick, 3) ThenBlock: {
                App.mode = 3
            } ElseBlock: {
                App.mode = 2
            }
        }
        Case 3: {
            App.done = 1
            App.out = 0
            App.mode = 3
        }
        Default: {
            App.mode = 0
            App.done = 0
        }
    }

    // secondary counter always runs
    WhileLoop LessThan(App.cnt, 1) {
        App.cnt = Increment(App.cnt)
    }
}

RunTask(Main)
