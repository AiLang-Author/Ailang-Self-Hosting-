// Aggressive: nested control, multi-function, shadow+if
// Expect: may break nested ForEvery / deep if multi-assign

FixedPool.App {
    "a": Initialize=1
    "b": Initialize=2
    "c": Initialize=0
    "s": Initialize=0
    "t": ElementType-Byte, MaximumLength-4, Initialize=0
    "u": ElementType-Byte, MaximumLength-4, Initialize=0
}

Function.F1 {
    Input: x: Integer
    Output: Integer
    Body: {
        ReturnValue(Add(Multiply(x, 3), 1))
    }
}

Function.F2 {
    Input: x: Integer
    Input: y: Integer
    Output: Integer
    Body: {
        ReturnValue(Clamp(Xor(x, y), 0, 255))
    }
}

Function.F3 {
    Input: x: Integer
    Output: Integer
    Body: {
        // nested pure calls
        ReturnValue(F1(LowBits(x, 8)))
    }
}

SubRoutine.Main {
    App.t[0] = 10
    App.t[1] = 20
    App.t[2] = 30
    App.t[3] = 40
    App.u[0] = 1
    App.u[1] = 2
    App.u[2] = 3
    App.u[3] = 4

    App.a = F3(F2(App.a, App.b))
    App.b = RotateLeft(BitSet(App.b, 5), 3)
    App.c = Power(App.a, 3)

    // Nested If (seq multi-stmt arms — not simple mux)
    IfCondition GreaterThan(App.c, 100) ThenBlock: {
        App.s = Add(App.s, 1)
        App.a = Decrement(App.a)
        IfCondition IsNonZero(App.a) ThenBlock: {
            App.b = BitClear(App.b, 1)
        } ElseBlock: {
            App.b = BitSet(App.b, 1)
        }
    } ElseBlock: {
        App.s = Subtract(App.s, 1)
        App.a = Increment(App.a)
    }

    // Outer ForEvery + inner ops
    ForEvery e in App.t {
        App.s = Add(App.s, e)
        App.c = Max(App.c, e)
        App.s = Select(GreaterThan(e, 25), Add(App.s, 7), App.s)
    }

    // Second array reduce
    ForEvery e in App.u {
        App.a = Add(App.a, e)
    }

    // Nested ForEvery — known hard; try it
    ForEvery e in App.t {
        ForEvery f in App.u {
            App.b = Add(App.b, BitwiseAnd(e, f))
        }
    }

    Branch App.s {
        Case 0: { App.c = 1 }
        Case 1: { App.c = 2 }
        Case 2: { App.c = 3 }
        Case 3: { App.c = 4 }
        Case 4: { App.c = 5 }
        Case 5: { App.c = 6 }
        Case 6: { App.c = 7 }
        Case 7: { App.c = 8 }
        Default: { App.c = 99 }
    }

    WhileLoop LessThan(App.a, 8) {
        App.a = Increment(App.a)
        IfCondition EqualTo(App.a, 5) ThenBlock: {
            App.c = BitSet(App.c, 2)
        } ElseBlock: {
            App.b = Xor(App.b, App.a)
        }
    }
}

RunTask(Main)
