// Saturating arith, popcount-ish, absdiff, median — push helpers

FixedPool.App {
    "x": Initialize=200
    "y": Initialize=100
    "z": Initialize=50
    "r": Initialize=0
    "s": Initialize=0
}

Function.SaturatingAdd8 {
    Input: a: Integer
    Input: b: Integer
    Output: Integer
    Body: {
        // software-style; HDL lowers to add+clamp
        ReturnValue(Clamp(Add(LowBits(a, 8), LowBits(b, 8)), 0, 255))
    }
}

Function.SaturatingSub8 {
    Input: a: Integer
    Input: b: Integer
    Output: Integer
    Body: {
        aa = LowBits(a, 8)
        bb = LowBits(b, 8)
        // if a < b then 0 else a-b
        ReturnValue(Select(LessThan(aa, bb), 0, Subtract(aa, bb)))
    }
}

Function.AbsDiff {
    Input: a: Integer
    Input: b: Integer
    Output: Integer
    Body: {
        ReturnValue(Select(GreaterThan(a, b), Subtract(a, b), Subtract(b, a)))
    }
}

Function.Median3 {
    Input: a: Integer
    Input: b: Integer
    Input: c: Integer
    Output: Integer
    Body: {
        // max of mins / min of maxs style
        ReturnValue(Max(Min(a, b), Max(Min(b, c), Min(a, c))))
    }
}

Function.PopCount8 {
    Input: x: Integer
    Output: Integer
    Body: {
        // unrolled bit sum
        v = LowBits(x, 8)
        s = BitTest(v, 0)
        s = Add(s, BitTest(v, 1))
        s = Add(s, BitTest(v, 2))
        s = Add(s, BitTest(v, 3))
        s = Add(s, BitTest(v, 4))
        s = Add(s, BitTest(v, 5))
        s = Add(s, BitTest(v, 6))
        s = Add(s, BitTest(v, 7))
        ReturnValue(s)
    }
}

SubRoutine.Main {
    App.r = SaturatingAdd8(App.x, App.y)
    App.s = SaturatingSub8(App.x, App.y)
    App.r = AbsDiff(App.r, App.s)
    App.s = Median3(App.x, App.y, App.z)
    App.r = PopCount8(0xF0)
    App.s = PopCount8(App.x)
    App.r = SaturatingAdd8(250, 20)
    App.s = SaturatingSub8(5, 20)
}

RunTask(Main)
