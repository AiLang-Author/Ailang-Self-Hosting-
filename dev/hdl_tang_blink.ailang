// =============================================================================
// Tang Nano 9K blink / binary counter — pure AILang soft-IP
// 27 MHz clk → ~0.5 s step on 6 LEDs (via board wrapper + CST)
//
//   ./dev/hdl_build_tang9k.sh
//   openFPGALoader -b tangnano9k dev/boards/tang_nano_9k/out/blink.fs
//
// Note: do NOT put a hold assign in the Else of a div-increment if —
// NBA last-wins would cancel the increment (see chain-shadow docs).
// =============================================================================

FixedPool.Board {
    // free-running divider (27e6 * 0.5 = 13_500_000)
    "div":  Initialize=0
    // low 6 bits → LEDs (wrapper inverts for active-low board LEDs)
    "led":  Initialize=0
    "tick": Initialize=0
}

SubRoutine.Main {
    // always count
    Board.div = Increment(Board.div)
    // wrap + step LEDs (no Else hold — that would undo Increment via NBA)
    IfCondition GreaterEqual(Board.div, 13500000) ThenBlock: {
        Board.div = 0
        Board.led = LowBits(Increment(Board.led), 6)
        Board.tick = Increment(Board.tick)
    }
}

RunTask(Main)
