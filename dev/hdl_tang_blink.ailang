// Tang Nano 9K — LED binary counter (pure AILang)
// 27 MHz clock, ~0.5 s per count step, 6 LEDs
//
// Build+flash:
//   ./dev/hdl_build_tang9k.sh
//   ./dev/hdl_flash_tang9k.sh

FixedPool.Board {
    "div":  Initialize=0
    "led":  Initialize=0
}

SubRoutine.Main {
    // Free-running divider (must not assign div in an Else hold — NBA cancels inc)
    Board.div = Increment(Board.div)
    // 27e6/2 = 13500000 clocks ≈ 0.5 s
    IfCondition GreaterEqual(Board.div, 13500000) ThenBlock: {
        Board.div = 0
        Board.led = LowBits(Increment(Board.led), 6)
    }
}

RunTask(Main)
