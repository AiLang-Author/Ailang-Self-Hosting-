// TechBlock = InlineAsm for gates
// Robust AILang core first; hard cells only as escape hatch.
// ./ailang_hdl.x -hdl dev/hdl_techblock_smoke.ailang dev/hdl_tb_out
// yosys -s dev/hdl_tb_out.ys   # blackbox stays opaque

FixedPool.App {
    "a": Initialize=3
    "b": Initialize=5
    "c": Initialize=7
    "y": Initialize=0
    "z": Initialize=0
}

// Soft AILang path (preferred) — portable prims, no vendor cell
Function.SoftAnd {
    Input: x: Integer
    Input: y: Integer
    Output: Integer
    Body: {
        ReturnValue(BitwiseAnd(x, y))
    }
}

SubRoutine.Main {
    // Core path — no escape needed
    App.y = SoftAnd(App.a, App.b)

    // Escape hatch (bracket form, same shape as InlineAsm["…"])
    // Ports: A, B, ... inputs; Y = result (convention). You own the lib.
    App.z = TechBlock["HARD_AND2", App.a, App.b]

    // Mix: soft then hard
    App.y = TechBlock["HARD_XOR2", App.y, App.z]

    // Wider hard cell (3 inputs) — still just an escape, not a dialect
    App.y = TechBlock["HARD_MUX2", App.c, App.y, App.z]

    // Paren form also accepted
    App.y = TechBlock("HARD_BUF", App.y)
    App.y = LowBits(App.y, 8)
}

RunTask(Main)
