// =============================================================================
// AILang HDL template: 1-deep skid buffer + ready/valid stream
// Copy into your chip, or merge pools/logic into Main.
// See: Programming_Manual/AILANG HDL Programming Guide.md
// =============================================================================
//
// Contract (each clock):
//   fire_in  = in_valid  && in_ready
//   fire_out = out_valid && out_ready
//   in_ready = !skid_valid || out_ready   (can accept if empty or draining)
//   out_valid = skid_valid
//   out_data  = skid_data
//
// Load skid on fire_in; clear skid on fire_out (if not same-cycle reload —
// this template clears then loads if both fire: load wins if ordered last).
// =============================================================================

FixedPool.Stream {
    "in_data":   Initialize=0
    "in_valid":  Initialize=0
    "in_ready":  Initialize=1
    "out_data":  Initialize=0
    "out_valid": Initialize=0
    "out_ready": Initialize=0
}

FixedPool.Skid {
    "data":  Initialize=0
    "valid": Initialize=0
}

SubRoutine.Main {
    // Ready toward source: free slot or sink will take our held beat
    Stream.in_ready = 1
    IfCondition EqualTo(Skid.valid, 1) ThenBlock: {
        Stream.in_ready = Stream.out_ready
    }

    // Present held beat
    Stream.out_data = Skid.data
    Stream.out_valid = Skid.valid

    // Sink took it
    IfCondition EqualTo(And(Skid.valid, Stream.out_ready), 1) ThenBlock: {
        Skid.valid = 0
    }

    // Source offered and we accepted — capture into skid
    IfCondition EqualTo(And(Stream.in_valid, Stream.in_ready), 1) ThenBlock: {
        Skid.data = Stream.in_data
        Skid.valid = 1
    }
}

RunTask(Main)
