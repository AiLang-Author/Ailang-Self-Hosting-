// =============================================================================
// UART-ish RX soft-IP — pure AILang (oversample-free, 1 bit/clock model)
// Detect start (line fall) → sample 8 data bits → stop → latch byte
// =============================================================================

FixedPool.Urx {
    "line":     Initialize=1
    "prev":     Initialize=1
    "shift":    Initialize=0
    "bit_i":    Initialize=0
    "byte":     Initialize=0
    "valid":    Initialize=0
    "mode":     Initialize=0
    "stim":     Initialize=0
    "tx_pat":   Initialize=0x96
    "tx_shift": Initialize=0
    "tx_bit":   Initialize=0
    "tx_mode":  Initialize=0
}

SubRoutine.Main {
    // --- soft TX stimulus (drives line) ---
    Branch Urx.tx_mode {
        Case 0: {
            Urx.line = 1
            Urx.tx_shift = Urx.tx_pat
            Urx.tx_bit = 0
            Urx.tx_mode = 1
        }
        Case 1: {
            // start bit
            Urx.line = 0
            Urx.tx_mode = 2
        }
        Case 2: {
            Urx.line = BitTest(Urx.tx_shift, 0)
            Urx.tx_shift = ShiftRight(Urx.tx_shift, 1)
            Urx.tx_bit = Increment(Urx.tx_bit)
            IfCondition GreaterEqual(Urx.tx_bit, 8) ThenBlock: {
                Urx.tx_mode = 3
            } ElseBlock: {
                Urx.tx_mode = 2
            }
        }
        Case 3: {
            // stop
            Urx.line = 1
            Urx.tx_pat = LowBits(Add(Urx.tx_pat, 1), 8)
            Urx.tx_mode = 0
        }
        Default: {
            Urx.tx_mode = 0
        }
    }

    // --- RX ---
    Branch Urx.mode {
        Case 0: {
            // wait start: falling edge
            Urx.valid = 0
            IfCondition And(IsZero(Urx.line), IsNonZero(Urx.prev)) ThenBlock: {
                Urx.shift = 0
                Urx.bit_i = 0
                Urx.mode = 1
            } ElseBlock: {
                Urx.mode = 0
            }
        }
        Case 1: {
            // sample data bit into LSB, shift up (MSB-last → reverse at latch)
            Urx.shift = LowBits(BitwiseOr(ShiftLeft(Urx.shift, 1), Urx.line), 8)
            Urx.bit_i = Increment(Urx.bit_i)
            IfCondition GreaterEqual(Urx.bit_i, 8) ThenBlock: {
                Urx.mode = 2
            } ElseBlock: {
                Urx.mode = 1
            }
        }
        Case 2: {
            // stop / latch (reverse bits so LSB-first wire order matches soft TX)
            Urx.byte = ReverseBits8(Urx.shift)
            Urx.valid = 1
            Urx.mode = 0
        }
        Default: {
            Urx.mode = 0
        }
    }
    Urx.prev = Urx.line
}

RunTask(Main)
