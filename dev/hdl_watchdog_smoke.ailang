// =============================================================================
// Watchdog soft-IP — pure AILang
// Kick reloads; timeout asserts reset pulse; sticky latched fault
// =============================================================================

FixedPool.Wdt {
    "cnt":      Initialize=0
    "limit":    Initialize=16
    "kick":     Initialize=0
    "enable":   Initialize=1
    "timeout":  Initialize=0
    "rst_out":  Initialize=0
    "fault":    Initialize=0
    "mode":     Initialize=0
    "tick":     Initialize=0
    "kicks":    Initialize=0
}

SubRoutine.Main {
    // stimulus: kick a few times, then starve
    Branch Wdt.mode {
        Case 0: {
            Wdt.kick = 1
            Wdt.kicks = Increment(Wdt.kicks)
            Wdt.tick = Increment(Wdt.tick)
            IfCondition GreaterEqual(Wdt.kicks, 3) ThenBlock: {
                Wdt.mode = 1
                Wdt.tick = 0
            } ElseBlock: {
                Wdt.mode = 0
            }
        }
        Case 1: {
            // no kicks — let it fire
            Wdt.kick = 0
            Wdt.tick = Increment(Wdt.tick)
            IfCondition GreaterEqual(Wdt.tick, 32) ThenBlock: {
                Wdt.mode = 2
            } ElseBlock: {
                Wdt.mode = 1
            }
        }
        Case 2: {
            // re-enable after fault observed
            Wdt.kick = 1
            Wdt.mode = 2
        }
        Default: {
            Wdt.mode = 0
        }
    }

    // watchdog core
    IfCondition IsZero(Wdt.enable) ThenBlock: {
        Wdt.cnt = 0
        Wdt.timeout = 0
        Wdt.rst_out = 0
    } ElseBlock: {
        IfCondition IsNonZero(Wdt.kick) ThenBlock: {
            Wdt.cnt = 0
            Wdt.timeout = 0
            Wdt.rst_out = 0
        } ElseBlock: {
            Wdt.cnt = Increment(Wdt.cnt)
            IfCondition GreaterEqual(Wdt.cnt, Wdt.limit) ThenBlock: {
                Wdt.timeout = 1
                Wdt.rst_out = 1
                Wdt.fault = 1
                Wdt.cnt = 0
            } ElseBlock: {
                Wdt.timeout = 0
                Wdt.rst_out = 0
            }
        }
    }
}

RunTask(Main)
