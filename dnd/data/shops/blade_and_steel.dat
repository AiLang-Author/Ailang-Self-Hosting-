# Blade & Steel — starter-town weapon shop.
#
# Format: one KEY=value per line. `#` starts a full-line comment.
# STOCK lines are `item_id,qty` — item_id refers to rows in
# data/items.dnddat (once the item loader is wired up).

NAME=Blade & Steel
TYPE=WEAPON
BUY_RATE=100
SELL_RATE=50

# Starter weapons — Short Sword, Long Sword, Dagger, Battle Axe.
STOCK=1,5
STOCK=2,3
STOCK=3,10
STOCK=4,2
