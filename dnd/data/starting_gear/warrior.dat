# Warrior starting gear.
#
# Format:
#   EQUIP=<item_id>         — equip by item_id from data/items.dnddat
#   INV=<item_id>,<qty>     — add to starting inventory

# Equipped
EQUIP=1          # Short Sword
EQUIP=5          # Leather Armor
EQUIP=8          # Shield

# Inventory
INV=9,2          # 2 Healing Potions
INV=16,3         # 3 Bread
