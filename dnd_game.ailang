// ============================================
// dnd.ailang
// AILANG D&D-style Dungeon Crawler
// Config-driven version with full world support
// ============================================
//
// USAGE:
//   dnd                    Load default game.dndconf
//   dnd mygame.dndconf     Load custom game config
//
// CONFIG FILES:
//   .dndconf files define complete game worlds
//   including maps, connections, shops, inns
//
// ============================================

LibraryImport.Arena
LibraryImport.TUI
LibraryImport.DnD.Engine.DND
LibraryImport.DnD.Character.Character
LibraryImport.DnD.Character.Item
LibraryImport.DnD.Character.EquipScreen
LibraryImport.DnD.Engine.GameConfig
LibraryImport.DnD.Engine.Portal
LibraryImport.DnD.Commerce.Shop
LibraryImport.DnD.Commerce.Inn
LibraryImport.DnD.Save.Save
LibraryImport.DnD.Save.SaveScreen
LibraryImport.DnD.Battle.BattleScreen
// HTMLBroadcast: off-by-default for TUI play, but imported so we
// smoke-test it stays linkable in its real context. When you want
// the web frontend, the game would call HTML_Init + HTML_StartServer
// instead of the TUI loop.
LibraryImport.DnD.Web.HTMLBroadcast

// ============================================
// GAME STATE
// ============================================

FixedPool.Game_Flags {
    "debug_mode": Initialize=0
    "steps_since_battle": Initialize=0
    "encounter_rate": Initialize=8
}

// ============================================
// ARGUMENT PARSING
// ============================================

Function.ParseArgs {
    Output: Address
    Body: {
        cmdline_path = "/proc/self/cmdline"
        fd = SystemCall(257, -100, cmdline_path, 0, 0)
        
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        buffer = Allocate(4096)
        bytes_read = SystemCall(0, fd, buffer, 4096)
        SystemCall(3, fd)
        
        IfCondition LessEqual(bytes_read, 0) ThenBlock: {
            Deallocate(buffer, 4096)
            ReturnValue(0)
        }
        
        // Skip program name
        pos = 0
        WhileLoop NotEqual(GetByte(buffer, pos), 0) {
            pos = Add(pos, 1)
        }
        pos = Add(pos, 1)
        
        // Check for config argument
        ch = GetByte(buffer, pos)
        IfCondition EqualTo(ch, 0) ThenBlock: {
            Deallocate(buffer, 4096)
            ReturnValue(0)
        }
        
        // Extract config path
        file_start = pos
        file_len = 0
        WhileLoop NotEqual(GetByte(buffer, pos), 0) {
            file_len = Add(file_len, 1)
            pos = Add(pos, 1)
        }
        
        filepath = Allocate(Add(file_len, 1))
        i = 0
        WhileLoop LessThan(i, file_len) {
            SetByte(filepath, i, GetByte(buffer, Add(file_start, i)))
            i = Add(i, 1)
        }
        SetByte(filepath, file_len, 0)
        
        Deallocate(buffer, 4096)
        ReturnValue(filepath)
    }
}

// ============================================
// CONFIG SELECTOR
// ============================================

FixedPool.CfgSelect_Limits {
    "MAX_CONFIGS": Initialize=16
    "PATH_LEN": Initialize=128
    "NAME_LEN": Initialize=64
    "ENTRY_SIZE": Initialize=192
    "DENTS_BUF": Initialize=4096
    "LASTCONF_LEN": Initialize=128
}

FixedPool.CfgSelect_State {
    "entries": Initialize=0, CanChange=True
    "count": Initialize=0, CanChange=True
    "cursor": Initialize=0, CanChange=True
    "last_used": Initialize=0, CanChange=True
    "running": Initialize=0, CanChange=True
}

Function.CfgSelect_Init {
    Body: {
        size = Multiply(CfgSelect_Limits.MAX_CONFIGS, CfgSelect_Limits.ENTRY_SIZE)
        CfgSelect_State.entries = Allocate(size)
        i = 0
        WhileLoop LessThan(i, size) {
            SetByte(CfgSelect_State.entries, i, 0)
            i = Add(i, 1)
        }
        CfgSelect_State.count = 0
        CfgSelect_State.cursor = 0
        CfgSelect_State.last_used = Allocate(CfgSelect_Limits.LASTCONF_LEN)
        SetByte(CfgSelect_State.last_used, 0, 0)
        CfgSelect_State.running = 0
        ReturnValue(0)
    }
}

Function.CfgSelect_Cleanup {
    Body: {
        IfCondition NotEqual(CfgSelect_State.entries, 0) ThenBlock: {
            size = Multiply(CfgSelect_Limits.MAX_CONFIGS, CfgSelect_Limits.ENTRY_SIZE)
            Deallocate(CfgSelect_State.entries, size)
            CfgSelect_State.entries = 0
        }
        IfCondition NotEqual(CfgSelect_State.last_used, 0) ThenBlock: {
            Deallocate(CfgSelect_State.last_used, CfgSelect_Limits.LASTCONF_LEN)
            CfgSelect_State.last_used = 0
        }
        ReturnValue(0)
    }
}

// Check if filename ends with ".dndconf" (8 chars)
// ASCII: . 46  d 100  n 110  d 100  c 99  o 111  n 110  f 102
Function.CfgSelect_EndsWith {
    Input: name: Address
    Output: Integer
    Body: {
        len = 0
        WhileLoop NotEqual(GetByte(name, len), 0) {
            len = Add(len, 1)
        }
        IfCondition LessThan(len, 8) ThenBlock: { ReturnValue(0) }
        s = Subtract(len, 8)
        IfCondition NotEqual(GetByte(name, s), 46) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(name, Add(s, 1)), 100) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(name, Add(s, 2)), 110) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(name, Add(s, 3)), 100) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(name, Add(s, 4)), 99) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(name, Add(s, 5)), 111) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(name, Add(s, 6)), 110) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(name, Add(s, 7)), 102) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// Byte-by-byte string equality
Function.CfgSelect_StrEqual {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        i = 0
        WhileLoop 1 {
            ca = GetByte(a, i)
            cb = GetByte(b, i)
            IfCondition NotEqual(ca, cb) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(ca, 0) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

// Scan dnd/ directory for .dndconf files
Function.CfgSelect_ScanDir {
    Output: Integer
    Body: {
        CfgSelect_State.count = 0
        // O_RDONLY | O_DIRECTORY = 65536
        dir_fd = SystemCall(257, -100, "dnd", 65536, 0)
        IfCondition LessThan(dir_fd, 0) ThenBlock: { ReturnValue(0) }

        dents_buf = Allocate(CfgSelect_Limits.DENTS_BUF)

        scanning = 1
        WhileLoop EqualTo(scanning, 1) {
            bytes_read = SystemCall(217, dir_fd, dents_buf, CfgSelect_Limits.DENTS_BUF)
            IfCondition LessEqual(bytes_read, 0) ThenBlock: { scanning = 0 }

            IfCondition EqualTo(scanning, 1) ThenBlock: {
                pos = 0
                WhileLoop LessThan(pos, bytes_read) {
                    reclen = Add(GetByte(dents_buf, Add(pos, 16)),
                                 Multiply(GetByte(dents_buf, Add(pos, 17)), 256))
                    IfCondition EqualTo(reclen, 0) ThenBlock: { pos = bytes_read }
                    IfCondition NotEqual(reclen, 0) ThenBlock: {
                        d_type = GetByte(dents_buf, Add(pos, 18))
                        d_name = Add(dents_buf, Add(pos, 19))

                        // Regular file (8) or unknown (0)
                        IfCondition Or(EqualTo(d_type, 8), EqualTo(d_type, 0)) ThenBlock: {
                            is_conf = CfgSelect_EndsWith(d_name)
                            IfCondition And(EqualTo(is_conf, 1),
                                            LessThan(CfgSelect_State.count, CfgSelect_Limits.MAX_CONFIGS)) ThenBlock: {
                                idx = CfgSelect_State.count
                                entry = Add(CfgSelect_State.entries,
                                            Multiply(idx, CfgSelect_Limits.ENTRY_SIZE))
                                // Write "dnd/" prefix
                                SetByte(entry, 0, 100)
                                SetByte(entry, 1, 110)
                                SetByte(entry, 2, 100)
                                SetByte(entry, 3, 47)
                                // Copy filename
                                fi = 0
                                WhileLoop And(NotEqual(GetByte(d_name, fi), 0),
                                              LessThan(Add(4, fi), Subtract(CfgSelect_Limits.PATH_LEN, 1))) {
                                    SetByte(entry, Add(4, fi), GetByte(d_name, fi))
                                    fi = Add(fi, 1)
                                }
                                SetByte(entry, Add(4, fi), 0)
                                // Default display name = filename
                                name_off = CfgSelect_Limits.PATH_LEN
                                ni = 0
                                WhileLoop And(NotEqual(GetByte(d_name, ni), 0),
                                              LessThan(ni, Subtract(CfgSelect_Limits.NAME_LEN, 1))) {
                                    SetByte(entry, Add(name_off, ni), GetByte(d_name, ni))
                                    ni = Add(ni, 1)
                                }
                                SetByte(entry, Add(name_off, ni), 0)
                                CfgSelect_State.count = Add(CfgSelect_State.count, 1)
                            }
                        }
                        pos = Add(pos, reclen)
                    }
                }
            }
        }

        Deallocate(dents_buf, CfgSelect_Limits.DENTS_BUF)
        SystemCall(3, dir_fd)
        ReturnValue(CfgSelect_State.count)
    }
}

// Read [WORLD] NAME= from each config for display names
Function.CfgSelect_LoadNames {
    Body: {
        read_buf = Allocate(1024)
        line_buf = Allocate(128)
        idx = 0
        WhileLoop LessThan(idx, CfgSelect_State.count) {
            entry = Add(CfgSelect_State.entries,
                        Multiply(idx, CfgSelect_Limits.ENTRY_SIZE))
            fd = SystemCall(257, -100, entry, 0, 0)
            IfCondition GreaterEqual(fd, 0) ThenBlock: {
                bytes = SystemCall(0, fd, read_buf, 1024)
                SystemCall(3, fd)
                IfCondition GreaterThan(bytes, 0) ThenBlock: {
                    in_world = 0
                    bpos = 0
                    WhileLoop LessThan(bpos, bytes) {
                        llen = 0
                        WhileLoop And(LessThan(bpos, bytes),
                                      NotEqual(GetByte(read_buf, bpos), 10)) {
                            ch = GetByte(read_buf, bpos)
                            IfCondition And(NotEqual(ch, 13), LessThan(llen, 126)) ThenBlock: {
                                SetByte(line_buf, llen, ch)
                                llen = Add(llen, 1)
                            }
                            bpos = Add(bpos, 1)
                        }
                        SetByte(line_buf, llen, 0)
                        bpos = Add(bpos, 1)

                        // Section headers
                        IfCondition EqualTo(GetByte(line_buf, 0), 91) ThenBlock: {
                            IfCondition Config_StrStartsWith(line_buf, "[WORLD]") ThenBlock: {
                                in_world = 1
                            } ElseBlock: {
                                IfCondition EqualTo(in_world, 1) ThenBlock: {
                                    bpos = bytes
                                }
                            }
                        }

                        // NAME= in [WORLD] section
                        IfCondition EqualTo(in_world, 1) ThenBlock: {
                            IfCondition Config_StrStartsWith(line_buf, "NAME=") ThenBlock: {
                                name_off = CfgSelect_Limits.PATH_LEN
                                vi = 5
                                di = 0
                                WhileLoop And(NotEqual(GetByte(line_buf, vi), 0),
                                              LessThan(di, Subtract(CfgSelect_Limits.NAME_LEN, 1))) {
                                    SetByte(entry, Add(name_off, di), GetByte(line_buf, vi))
                                    di = Add(di, 1)
                                    vi = Add(vi, 1)
                                }
                                SetByte(entry, Add(name_off, di), 0)
                                bpos = bytes
                            }
                        }
                    }
                }
            }
            idx = Add(idx, 1)
        }
        Deallocate(line_buf, 128)
        Deallocate(read_buf, 1024)
        ReturnValue(0)
    }
}

// Read dnd/.lastconf and set cursor to matching entry
Function.CfgSelect_LoadLast {
    Body: {
        fd = SystemCall(257, -100, "dnd/.lastconf", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        bytes = SystemCall(0, fd, CfgSelect_State.last_used,
                           Subtract(CfgSelect_Limits.LASTCONF_LEN, 1))
        SystemCall(3, fd)
        IfCondition LessEqual(bytes, 0) ThenBlock: {
            SetByte(CfgSelect_State.last_used, 0, 0)
            ReturnValue(0)
        }
        // Strip trailing newline
        last_idx = Subtract(bytes, 1)
        IfCondition EqualTo(GetByte(CfgSelect_State.last_used, last_idx), 10) ThenBlock: {
            SetByte(CfgSelect_State.last_used, last_idx, 0)
        } ElseBlock: {
            SetByte(CfgSelect_State.last_used, bytes, 0)
        }
        // Find match
        idx = 0
        WhileLoop LessThan(idx, CfgSelect_State.count) {
            entry = Add(CfgSelect_State.entries,
                        Multiply(idx, CfgSelect_Limits.ENTRY_SIZE))
            IfCondition EqualTo(CfgSelect_StrEqual(entry, CfgSelect_State.last_used), 1) ThenBlock: {
                CfgSelect_State.cursor = idx
                ReturnValue(1)
            }
            idx = Add(idx, 1)
        }
        ReturnValue(0)
    }
}

// Write selected path to dnd/.lastconf
Function.CfgSelect_SaveLast {
    Input: path: Address
    Body: {
        // O_WRONLY|O_CREAT|O_TRUNC = 577, mode 0644 = 420
        fd = SystemCall(257, -100, "dnd/.lastconf", 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(-1) }
        len = 0
        WhileLoop NotEqual(GetByte(path, len), 0) {
            len = Add(len, 1)
        }
        SystemCall(1, fd, path, len)
        nl = Allocate(1)
        SetByte(nl, 0, 10)
        SystemCall(1, fd, nl, 1)
        Deallocate(nl, 1)
        SystemCall(3, fd)
        ReturnValue(0)
    }
}

// Draw the config selection screen
Function.CfgSelect_Draw {
    Body: {
        TUI_Clear()
        width = TUI_GetWidth()

        TUI_SetFG(3)
        TUI_Bold()
        TUI_CenterText(3, "========================================", width)
        TUI_CenterText(4, "         SELECT GAME WORLD              ", width)
        TUI_CenterText(5, "========================================", width)
        TUI_ResetColor()

        TUI_SetFG(7)
        TUI_CenterText(7, "Choose an adventure:", width)
        TUI_ResetColor()

        row = 9
        idx = 0
        WhileLoop LessThan(idx, CfgSelect_State.count) {
            entry = Add(CfgSelect_State.entries,
                        Multiply(idx, CfgSelect_Limits.ENTRY_SIZE))
            name_ptr = Add(entry, CfgSelect_Limits.PATH_LEN)

            TUI_MoveTo(row, Subtract(Divide(width, 2), 20))
            IfCondition EqualTo(idx, CfgSelect_State.cursor) ThenBlock: {
                TUI_SetFG(2)
                TUI_Bold()
                TUI_Print("> ")
                TUI_Print(name_ptr)
                TUI_Print(" <")
            } ElseBlock: {
                TUI_Dim()
                TUI_Print("  ")
                TUI_Print(name_ptr)
            }
            TUI_ResetColor()

            // Show path dimmed below
            TUI_MoveTo(Add(row, 1), Subtract(Divide(width, 2), 18))
            TUI_Dim()
            TUI_Print("  (")
            TUI_Print(entry)
            TUI_Print(")")
            TUI_ResetColor()

            row = Add(row, 3)
            idx = Add(idx, 1)
        }

        TUI_Dim()
        TUI_CenterText(Subtract(TUI_GetHeight(), 2),
                        "Up/Down: Select   Enter: Load   Q/Esc: Quit", width)
        TUI_ResetColor()

        TUI_Refresh()
        ReturnValue(0)
    }
}

// Handle input for config selector
Function.CfgSelect_HandleInput {
    Body: {
        key = TUI_WaitKey()
        // Up
        IfCondition Or(EqualTo(key, TUI_Keys.KEY_UP), EqualTo(key, 107)) ThenBlock: {
            IfCondition GreaterThan(CfgSelect_State.cursor, 0) ThenBlock: {
                CfgSelect_State.cursor = Subtract(CfgSelect_State.cursor, 1)
            }
        }
        // Down
        IfCondition Or(EqualTo(key, TUI_Keys.KEY_DOWN), EqualTo(key, 106)) ThenBlock: {
            max_idx = Subtract(CfgSelect_State.count, 1)
            IfCondition LessThan(CfgSelect_State.cursor, max_idx) ThenBlock: {
                CfgSelect_State.cursor = Add(CfgSelect_State.cursor, 1)
            }
        }
        // Quit
        IfCondition Or(EqualTo(key, 113), EqualTo(key, 81)) ThenBlock: {
            CfgSelect_State.cursor = -1
            CfgSelect_State.running = 0
        }
        IfCondition EqualTo(key, TUI_Keys.KEY_ESC) ThenBlock: {
            CfgSelect_State.cursor = -1
            CfgSelect_State.running = 0
        }
        // Select
        IfCondition EqualTo(key, 10) ThenBlock: {
            CfgSelect_State.running = 0
        }
        ReturnValue(0)
    }
}

// Main config selector orchestrator
// Returns Address of selected config path, or 0 if quit/none found
Function.CfgSelect_Show {
    Output: Address
    Body: {
        CfgSelect_Init()
        count = CfgSelect_ScanDir()

        IfCondition EqualTo(count, 0) ThenBlock: {
            CfgSelect_Cleanup()
            ReturnValue(0)
        }

        CfgSelect_LoadNames()
        CfgSelect_LoadLast()

        // Auto-select if only one config
        IfCondition EqualTo(count, 1) ThenBlock: {
            entry = CfgSelect_State.entries
            CfgSelect_SaveLast(entry)
            ReturnValue(entry)
        }

        // Show picker
        CfgSelect_State.running = 1
        WhileLoop EqualTo(CfgSelect_State.running, 1) {
            CfgSelect_Draw()
            CfgSelect_HandleInput()
        }

        // User quit?
        IfCondition LessThan(CfgSelect_State.cursor, 0) ThenBlock: {
            CfgSelect_Cleanup()
            ReturnValue(0)
        }

        selected = Add(CfgSelect_State.entries,
                       Multiply(CfgSelect_State.cursor, CfgSelect_Limits.ENTRY_SIZE))
        CfgSelect_SaveLast(selected)
        ReturnValue(selected)
    }
}

// ============================================
// CONFIG LOADING
// ============================================

Function.LoadGameConfig {
    Input: config_path: Address
    Output: Integer
    Body: {
        Config_Init()
        Portal_Init()

        result = Config_Load(config_path)
        IfCondition LessThan(result, 0) ThenBlock: {
            ReturnValue(-1)
        }

        // Scan all maps to register portal, inn, and shop locations.
        // Each library owns its own scanner; each walks the list of
        // configured maps in Config_State and parses its marker lines
        // (PORTAL:, INN:, SHOP:) out of every .dndmap file.
        Portal_LoadAllLocations()
        Inn_LoadAllLocations()
        Shop_LoadAllLocations()

        ReturnValue(result)
    }
}

Function.StartFromConfig {
    Body: {
        DND_Player.x = Config_State.start_x
        DND_Player.y = Config_State.start_y
        DND_Player.gold = Config_State.start_gold
        
        // Use DND_LoadMap which now passes map_id correctly
        result = DND_LoadMap(Config_State.start_map)
        ReturnValue(result)
    }
}

Function.ShowConfigError {
    Input: tried_path: Address
    Body: {
        TUI_Clear()
        TUI_SetFG(1)
        TUI_Bold()
        TUI_PrintAt(5, 5, "Error: Could not load config file:")
        TUI_ResetColor()
        
        TUI_PrintAt(7, 5, tried_path)
        
        TUI_Dim()
        TUI_PrintAt(10, 5, "Create a .dndconf file or specify one as argument.")
        TUI_PrintAt(12, 5, "Expected format: game.dndconf")
        TUI_PrintAt(13, 5, "Or run: ./dnd_exec path/to/your.dndconf")
        TUI_ResetColor()
        
        TUI_PrintAt(16, 5, "Press any key to exit...")
        TUI_Refresh()
        TUI_WaitKey()
        
        ReturnValue(0)
    }
}

// ============================================
// MAP TRANSITIONS
// ============================================

Function.HandleMapTransition {
    Input: tile_type: Integer
    Output: Integer
    Body: {
        // DEBUG START
        TUI_Clear()
        TUI_SetFG(3)
        TUI_PrintAt(1, 1, "=== HandleMapTransition DEBUG ===")
        TUI_ResetColor()
        
        TUI_PrintAt(3, 1, "Current map: ")
        Portal_DebugPrintNum(3, 14, Config_State.current_map)
        TUI_PrintAt(4, 1, "Player X: ")
        Portal_DebugPrintNum(4, 11, DND_Player.x)
        TUI_PrintAt(5, 1, "Player Y: ")
        Portal_DebugPrintNum(5, 11, DND_Player.y)
        TUI_PrintAt(6, 1, "Tile type: ")
        Portal_DebugPrintNum(6, 12, tile_type)
        
        TUI_PrintAt(8, 1, "Calling Portal_GetDestination...")
        TUI_Refresh()
        TUI_WaitKey()
        // DEBUG END
        
        to_map_ptr = Allocate(8)
        to_x_ptr = Allocate(8)
        to_y_ptr = Allocate(8)
        
        found = Portal_GetDestination(Config_State.current_map, 
                                      DND_Player.x, DND_Player.y,
                                      to_map_ptr, to_x_ptr, to_y_ptr)
        
        // DEBUG: Show result
        TUI_PrintAt(10, 1, "Portal_GetDestination returned: ")
        Portal_DebugPrintNum(10, 33, found)
        TUI_Refresh()
        TUI_WaitKey()
        
        IfCondition EqualTo(found, 0) ThenBlock: {
            Deallocate(to_map_ptr, 8)
            Deallocate(to_x_ptr, 8)
            Deallocate(to_y_ptr, 8)
            DND_AddMessage("This path leads nowhere...")
            ReturnValue(0)
        }
        
        to_map = Dereference(to_map_ptr)
        to_x = Dereference(to_x_ptr)
        to_y = Dereference(to_y_ptr)
        
        // DEBUG: Show destination
        TUI_PrintAt(12, 1, "Destination map: ")
        Portal_DebugPrintNum(12, 18, to_map)
        TUI_PrintAt(13, 1, "Destination X: ")
        Portal_DebugPrintNum(13, 16, to_x)
        TUI_PrintAt(14, 1, "Destination Y: ")
        Portal_DebugPrintNum(14, 16, to_y)
        TUI_Refresh()
        TUI_WaitKey()
        
        Deallocate(to_map_ptr, 8)
        Deallocate(to_x_ptr, 8)
        Deallocate(to_y_ptr, 8)
        
        // Load destination map
        result = DND_LoadMap(to_map)
        IfCondition LessThan(result, 0) ThenBlock: {
            DND_AddMessage("Error: Could not load map!")
            ReturnValue(0)
        }
        
        DND_Player.x = to_x
        DND_Player.y = to_y
        
        ReturnValue(1)
    }
}

// ============================================
// SHOP INTERACTION
// ============================================

Function.Game_TryShopInteraction {
    Output: Integer
    Body: {
        shop_id = Shop_GetAtPosition(Config_State.current_map, DND_Player.x, DND_Player.y)
        IfCondition LessThan(shop_id, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        // Create gold pointer for shop system
        gold_ptr = Allocate(8)
        StoreValue(gold_ptr, DND_Player.gold)
        
        Shop_Open(shop_id, gold_ptr)
        
        DND_Player.gold = Dereference(gold_ptr)
        Deallocate(gold_ptr, 8)
        
        ReturnValue(1)
    }
}

// ============================================
// INN INTERACTION
// ============================================

Function.Game_TryInnInteraction {
    Output: Integer
    Body: {
        inn_id = Inn_GetAtPosition(Config_State.current_map, DND_Player.x, DND_Player.y)
        IfCondition LessThan(inn_id, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        gold_ptr = Allocate(8)
        StoreValue(gold_ptr, DND_Player.gold)

        Inn_MenuContext.player_x = DND_Player.x
        Inn_MenuContext.player_y = DND_Player.y
        Inn_MenuContext.map_id = Config_State.current_map
        Inn_ShowMenu_v2(inn_id, DND_Player.char_data, 0, 1, gold_ptr)

        DND_Player.gold = Dereference(gold_ptr)
        Deallocate(gold_ptr, 8)

        ReturnValue(1)
    }
}

// ============================================
// INTERACTION HANDLER
// ============================================

Function.Game_HandleInteraction {
    Output: Integer
    Body: {
        // Try shop first
        result = Game_TryShopInteraction()
        IfCondition EqualTo(result, 1) ThenBlock: {
            ReturnValue(1)
        }
        
        // Try inn
        result = Game_TryInnInteraction()
        IfCondition EqualTo(result, 1) ThenBlock: {
            ReturnValue(1)
        }
        
        // Nothing to interact with
        DND_AddMessage("Nothing to interact with here.")
        ReturnValue(0)
    }
}

// ============================================
// RANDOM ENCOUNTER CHECK
// ============================================

Function.Game_CheckEncounter {
    Output: Integer
    Body: {
        // Only in dungeons
        map_type = Config_GetMapType(Config_State.current_map)
        IfCondition NotEqual(map_type, Map_Types.DUNGEON) ThenBlock: {
            ReturnValue(0)
        }
        
        Game_Flags.steps_since_battle = Add(Game_Flags.steps_since_battle, 1)
        
        // Grace period of 3 steps
        IfCondition LessThan(Game_Flags.steps_since_battle, 3) ThenBlock: {
            ReturnValue(0)
        }
        
        // Roll for encounter
        roll = Dice_D100()
        IfCondition LessEqual(roll, Game_Flags.encounter_rate) ThenBlock: {
            Game_Flags.steps_since_battle = 0
            ReturnValue(1)
        }
        
        ReturnValue(0)
    }
}

// ============================================
// MOVEMENT WITH TRANSITIONS
// ============================================

Function.Game_MovePlayer {
    Input: dx: Integer
    Input: dy: Integer
    Output: Integer
    Body: {
        new_x = Add(DND_Player.x, dx)
        new_y = Add(DND_Player.y, dy)
        
        tile = DND_GetTile(new_x, new_y)
        
        // Inn (I = 73)
        IfCondition EqualTo(tile, 73) ThenBlock: {
            DND_Player.x = new_x
            DND_Player.y = new_y
            Game_TryInnInteraction()
            ReturnValue(1)
        }
        
        // Weapon Shop (W = 87)
        IfCondition EqualTo(tile, 87) ThenBlock: {
            DND_Player.x = new_x
            DND_Player.y = new_y
            Game_TryShopInteraction()
            ReturnValue(1)
        }
        
        // Armor Shop (A = 65)
        IfCondition EqualTo(tile, 65) ThenBlock: {
            DND_Player.x = new_x
            DND_Player.y = new_y
            Game_TryShopInteraction()
            ReturnValue(1)
        }
        
        // Exit portal (' = 39)
        IfCondition EqualTo(tile, 39) ThenBlock: {
            DND_Player.x = new_x
            DND_Player.y = new_y
            HandleMapTransition(39)
            ReturnValue(1)
        }
        
        // Stairs up (< = 60)
        IfCondition EqualTo(tile, 60) ThenBlock: {
            DND_Player.x = new_x
            DND_Player.y = new_y
            HandleMapTransition(60)
            ReturnValue(1)
        }
        
        // Stairs down (> = 62)
        IfCondition EqualTo(tile, 62) ThenBlock: {
            DND_Player.x = new_x
            DND_Player.y = new_y
            HandleMapTransition(62)
            ReturnValue(1)
        }
        
        // Everything else - doors, items, combat
        DND_MovePlayer(dx, dy)
        
        // Random encounter check
        encounter = Game_CheckEncounter()
        IfCondition EqualTo(encounter, 1) ThenBlock: {
            DND_AddMessage("A monster appears!")
        }
        
        ReturnValue(1)
    }
}

// ============================================
// DEBUG DISPLAY
// ============================================

Function.Game_DrawDebug {
    Body: {
        IfCondition EqualTo(Game_Flags.debug_mode, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        TUI_MoveTo(1, 50)
        TUI_Dim()
        TUI_Print("Map:")
        TUI_PrintNum(Config_State.current_map)
        TUI_Print(" (")
        TUI_PrintNum(DND_Player.x)
        TUI_Print(",")
        TUI_PrintNum(DND_Player.y)
        TUI_Print(") Steps:")
        TUI_PrintNum(Game_Flags.steps_since_battle)
        TUI_ResetColor()
        
        ReturnValue(0)
    }
}

// ============================================
// CUSTOM INPUT HANDLER
// ============================================

Function.Game_HandleInput {
    Input: key: Integer
    Output: Integer
    Body: {
        // Movement - arrows
        IfCondition EqualTo(key, TUI_Keys.KEY_UP) ThenBlock: {
            Game_MovePlayer(0, -1)
            ReturnValue(1)
        }
        IfCondition EqualTo(key, TUI_Keys.KEY_DOWN) ThenBlock: {
            Game_MovePlayer(0, 1)
            ReturnValue(1)
        }
        IfCondition EqualTo(key, TUI_Keys.KEY_LEFT) ThenBlock: {
            Game_MovePlayer(-1, 0)
            ReturnValue(1)
        }
        IfCondition EqualTo(key, TUI_Keys.KEY_RIGHT) ThenBlock: {
            Game_MovePlayer(1, 0)
            ReturnValue(1)
        }
        
        // Movement is arrow-keys only — vi-style h/j/k/l was removed
        // to leave all lowercase letters free for commands. If users
        // want vi movement back later, re-enable this as a toggle.

        // Interact - Space or Enter
        IfCondition Or(EqualTo(key, 32), EqualTo(key, 10)) ThenBlock: {
            Game_HandleInteraction()
            ReturnValue(1)
        }

        // Command keys are all uppercase so lowercase h/j/k/l stays
        // unambiguous as vi-style movement.

        // Equipment - E (69) or I (73)
        IfCondition Or(EqualTo(key, 69), EqualTo(key, 73)) ThenBlock: {
            EqScreen_Show(DND_Player.char_data)
            ReturnValue(1)
        }

        // Debug toggle - D (68)
        IfCondition EqualTo(key, 68) ThenBlock: {
            Game_Flags.debug_mode = Subtract(1, Game_Flags.debug_mode)
            IfCondition EqualTo(Game_Flags.debug_mode, 1) ThenBlock: {
                DND_AddMessage("Debug mode ON")
            } ElseBlock: {
                DND_AddMessage("Debug mode OFF")
            }
            ReturnValue(1)
        }

        // Help - ? (63)
        IfCondition EqualTo(key, 63) ThenBlock: {
            Game_ShowHelp()
            ReturnValue(1)
        }

        // Save - S (83). Opens SaveScreen picker.
        IfCondition EqualTo(key, 83) ThenBlock: {
            SaveScreen_Save(DND_Player.char_data,
                            DND_Player.x,
                            DND_Player.y,
                            Config_State.current_map,
                            DND_Player.gold,
                            DND_Map.name)
            ReturnValue(1)
        }

        // Load - L (76). Opens SaveScreen load-picker.
        // SaveScreen_Load writes everything into Save_LoadedState pool;
        // we need to provide a party buffer + a char_data scratch slot.
        IfCondition EqualTo(key, 76) ThenBlock: {
            load_party_buf = Allocate(32)
            Save_LoadedState.party = load_party_buf
            char_scratch = Allocate(8)
            StoreValue(char_scratch, 0)

            slot = SaveScreen_Load(char_scratch)

            IfCondition GreaterEqual(slot, 0) ThenBlock: {
                loaded_char = Dereference(char_scratch)
                IfCondition NotEqual(loaded_char, 0) ThenBlock: {
                    IfCondition NotEqual(DND_Player.char_data, loaded_char) ThenBlock: {
                        Deallocate(DND_Player.char_data, Char_Offsets.SIZE)
                    }
                    DND_Player.char_data = loaded_char
                }
                DND_Player.x = Save_LoadedState.player_x
                DND_Player.y = Save_LoadedState.player_y
                DND_Player.gold = Save_LoadedState.gold
                DND_LoadMap(Save_LoadedState.map_id)
                DND_AddMessage("Game loaded!")
            }

            Deallocate(char_scratch, 8)
            Deallocate(load_party_buf, 32)
            ReturnValue(1)
        }

        // Quit - Q (81) or Shift+Q
        IfCondition EqualTo(key, 81) ThenBlock: {
            DND_GameState.running = 0
            ReturnValue(1)
        }
        
        // ESC - quit
        IfCondition EqualTo(key, TUI_Keys.KEY_ESC) ThenBlock: {
            DND_GameState.running = 0
            ReturnValue(1)
        }
        
        ReturnValue(0)
    }
}

// ============================================
// HELP SCREEN
// ============================================

Function.Game_ShowHelp {
    Body: {
        TUI_Clear()
        
        width = TUI_GetWidth()
        
        TUI_SetFG(3)
        TUI_Bold()
        TUI_CenterText(2, "=== CONTROLS ===", width)
        TUI_ResetColor()
        
        TUI_PrintAt(4, 4, "MOVEMENT:")
        TUI_PrintAt(5, 6, "Arrow keys or h/j/k/l")
        
        TUI_PrintAt(7, 4, "ACTIONS:")
        TUI_PrintAt(8, 6, "Space/Enter - Interact (shop/inn/NPC)")
        TUI_PrintAt(9, 6, "e / i       - Equipment/Inventory")
        TUI_PrintAt(10, 6, "d           - Toggle debug info")
        TUI_PrintAt(11, 6, "?           - This help")
        TUI_PrintAt(12, 6, "q / ESC     - Quit")
        
        TUI_PrintAt(14, 4, "MAP TILES:")
        TUI_SetFG(7)
        TUI_PrintAt(15, 6, "#  Wall     .  Floor    +  Door")
        TUI_SetFG(6)
        TUI_PrintAt(16, 6, "<  Up       >  Down     '  Exit")
        TUI_SetFG(3)
        TUI_PrintAt(17, 6, "$  Gold     *  Chest    !  Item")
        TUI_SetFG(2)
        TUI_PrintAt(18, 6, "@  You")
        TUI_ResetColor()
        
        TUI_Dim()
        TUI_CenterText(21, "Press any key to continue...", width)
        TUI_ResetColor()
        
        TUI_Refresh()
        TUI_WaitKey()
        
        ReturnValue(0)
    }
}

// ============================================
// CUSTOM GAME LOOP
// ============================================

Function.Game_Run {
    Body: {
        DND_DrawUI()
        DND_AddMessage("Welcome! Press ? for help, Space to interact.")
        
        WhileLoop EqualTo(DND_GameState.running, 1) {
            DND_DrawUI()
            Game_DrawDebug()
            TUI_Refresh()
            
            key = TUI_GetKey()
            IfCondition NotEqual(key, TUI_Keys.KEY_NONE) ThenBlock: {
                Game_HandleInput(key)
            }
        }
        
        ReturnValue(0)
    }
}

// ============================================
// TITLE SCREEN
// ============================================

Function.ShowTitleScreen {
    Output: Integer
    Body: {
        TUI_Clear()
        
        width = TUI_GetWidth()
        
        TUI_SetFG(3)
        TUI_Bold()
        TUI_CenterText(5, "========================================", width)
        TUI_CenterText(6, "         AILANG DUNGEON CRAWLER         ", width)
        TUI_CenterText(7, "========================================", width)
        TUI_ResetColor()
        
        IfCondition NotEqual(GetByte(Config_State.world_name, 0), 0) ThenBlock: {
            TUI_SetFG(6)
            TUI_CenterText(9, Config_State.world_name, width)
            TUI_ResetColor()
        } ElseBlock: {
            TUI_SetFG(7)
            TUI_CenterText(9, "A roguelike adventure written in AILang", width)
            TUI_ResetColor()
        }
        
        TUI_SetFG(2)
        TUI_CenterText(11, "      ___________      ", width)
        TUI_CenterText(12, "     /           \\     ", width)
        TUI_CenterText(13, "    |   DUNGEON   |    ", width)
        TUI_CenterText(14, "    |   ENTRANCE  |    ", width)
        TUI_CenterText(15, "    |      @      |    ", width)
        TUI_CenterText(16, "    |_____[ ]_____|    ", width)
        TUI_ResetColor()
        
        has_saves = 0
        slot = 0
        WhileLoop LessThan(slot, 3) {
            IfCondition EqualTo(Save_SlotExists(slot), 1) ThenBlock: {
                has_saves = 1
                BreakLoop
            }
            slot = Add(slot, 1)
        }
        
        cursor = 0
        option_count = 2
        IfCondition EqualTo(has_saves, 1) ThenBlock: {
            option_count = 3
        }
        
        running = 1
        WhileLoop EqualTo(running, 1) {
            row = 18
            
            TUI_MoveTo(row, Subtract(Divide(width, 2), 8))
            IfCondition EqualTo(cursor, 0) ThenBlock: {
                TUI_SetFG(2)
                TUI_Bold()
                TUI_Print("> New Game <")
            } ElseBlock: {
                TUI_Dim()
                TUI_Print("  New Game  ")
            }
            TUI_ResetColor()
            row = Add(row, 1)
            
            IfCondition EqualTo(has_saves, 1) ThenBlock: {
                TUI_MoveTo(row, Subtract(Divide(width, 2), 8))
                IfCondition EqualTo(cursor, 1) ThenBlock: {
                    TUI_SetFG(2)
                    TUI_Bold()
                    TUI_Print("> Continue <")
                } ElseBlock: {
                    TUI_Dim()
                    TUI_Print("  Continue  ")
                }
                TUI_ResetColor()
                row = Add(row, 1)
            }
            
            quit_idx = Subtract(option_count, 1)
            TUI_MoveTo(row, Subtract(Divide(width, 2), 8))
            IfCondition EqualTo(cursor, quit_idx) ThenBlock: {
                TUI_SetFG(2)
                TUI_Bold()
                TUI_Print(">   Quit   <")
            } ElseBlock: {
                TUI_Dim()
                TUI_Print("    Quit    ")
            }
            TUI_ResetColor()
            
            TUI_Refresh()
            
            key = TUI_WaitKey()
            
            IfCondition Or(EqualTo(key, TUI_Keys.KEY_UP), EqualTo(key, 107)) ThenBlock: {
                IfCondition GreaterThan(cursor, 0) ThenBlock: {
                    cursor = Subtract(cursor, 1)
                }
            }
            IfCondition Or(EqualTo(key, TUI_Keys.KEY_DOWN), EqualTo(key, 106)) ThenBlock: {
                IfCondition LessThan(cursor, Subtract(option_count, 1)) ThenBlock: {
                    cursor = Add(cursor, 1)
                }
            }
            
            IfCondition Or(EqualTo(key, 113), EqualTo(key, 81)) ThenBlock: {
                ReturnValue(0)
            }
            
            IfCondition EqualTo(key, 10) ThenBlock: {
                running = 0
            }
        }
        
        IfCondition EqualTo(cursor, 0) ThenBlock: {
            ReturnValue(1)
        }
        
        IfCondition And(EqualTo(has_saves, 1), EqualTo(cursor, 1)) ThenBlock: {
            ReturnValue(2)
        }
        
        ReturnValue(0)
    }
}

// ============================================
// GAME OVER SCREEN
// ============================================

Function.ShowGameOverScreen {
    Body: {
        TUI_Clear()
        
        width = TUI_GetWidth()
        char_data = DND_Player.char_data
        
        TUI_SetFG(1)
        TUI_Bold()
        TUI_CenterText(8, "===== GAME OVER =====", width)
        TUI_ResetColor()
        
        TUI_CenterText(10, "Your adventure has ended.", width)
        TUI_CenterText(12, "Final Stats:", width)
        
        TUI_MoveTo(14, Subtract(Divide(width, 2), 10))
        TUI_Print("Level: ")
        TUI_PrintNum(Char_GetLevel(char_data))
        
        TUI_MoveTo(15, Subtract(Divide(width, 2), 10))
        TUI_Print("Gold: ")
        TUI_SetFG(3)
        TUI_PrintNum(DND_Player.gold)
        TUI_ResetColor()
        
        TUI_Dim()
        TUI_CenterText(20, "Press any key to exit...", width)
        TUI_ResetColor()
        
        TUI_Refresh()
        TUI_WaitKey()
        
        ReturnValue(0)
    }
}

// ============================================
// dnd.ailang - Main subroutine with debug
// ============================================

SubRoutine.Main {
      // DND_Init handles ALL initialization internally
    DND_Init()
    
    // Get config path from args or use default
    config_arg = ParseArgs()
    
    // Get config path from args or use default
 //   config_arg = ParseArgs()
    
    IfCondition NotEqual(config_arg, 0) ThenBlock: {
        config_path = config_arg
    } ElseBlock: {
        selected = CfgSelect_Show()
        IfCondition EqualTo(selected, 0) ThenBlock: {
            DND_Cleanup()
            SystemCall(60, 0)
        }
        // Copy selected path to stable buffer before cleanup
        sel_buf = Allocate(128)
        si = 0
        WhileLoop And(LessThan(si, 127), NotEqual(GetByte(selected, si), 0)) {
            SetByte(sel_buf, si, GetByte(selected, si))
            si = Add(si, 1)
        }
        SetByte(sel_buf, si, 0)
        CfgSelect_Cleanup()
        config_path = sel_buf
    }
    
    // Load game configuration
    config_result = LoadGameConfig(config_path)
    
    IfCondition LessThan(config_result, 0) ThenBlock: {
        ShowConfigError(config_path)
        IfCondition NotEqual(config_arg, 0) ThenBlock: {
            Deallocate(config_arg, 0)
        }
        DND_Cleanup()
        SystemCall(60, 1)
    }
    
    // DEBUG: Dump all portals to verify loading
    Portal_DebugDump()
    
    // Start from config
    result = StartFromConfig()
    
    IfCondition LessThan(result, 0) ThenBlock: {
        map_path = Config_GetMapPath(Config_State.start_map)
        ShowConfigError(map_path)
        IfCondition NotEqual(config_arg, 0) ThenBlock: {
            Deallocate(config_arg, 0)
        }
        Config_Cleanup()
        DND_Cleanup()
        SystemCall(60, 1)
    }
    
    // Title screen
    result = ShowTitleScreen()
    
    IfCondition EqualTo(result, 1) ThenBlock: {
        Game_Run()
        ShowGameOverScreen()
    }
    
    IfCondition EqualTo(result, 2) ThenBlock: {
        load_party_buf = Allocate(32)
        Save_LoadedState.party = load_party_buf
        char_scratch = Allocate(8)
        StoreValue(char_scratch, 0)

        slot = SaveScreen_TitleLoad(char_scratch)

        IfCondition GreaterEqual(slot, 0) ThenBlock: {
            loaded_char = Dereference(char_scratch)
            IfCondition NotEqual(loaded_char, 0) ThenBlock: {
                DND_Player.char_data = loaded_char
            }
            DND_Player.x = Save_LoadedState.player_x
            DND_Player.y = Save_LoadedState.player_y
            DND_Player.gold = Save_LoadedState.gold
            Config_State.current_map = Save_LoadedState.map_id
            DND_LoadMap(Save_LoadedState.map_id)

            Game_Run()
            ShowGameOverScreen()
        }

        Deallocate(char_scratch, 8)
        Deallocate(load_party_buf, 32)
    }
    
    // Cleanup
    IfCondition NotEqual(config_arg, 0) ThenBlock: {
        Deallocate(config_arg, 0)
    }
    DND_Cleanup()
    Portal_Cleanup()
    Config_Cleanup()
   // TUI_Shutdown()
    SystemCall(60, 0)
}

RunTask(Main)