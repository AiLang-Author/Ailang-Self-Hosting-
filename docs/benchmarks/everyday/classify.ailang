// Everyday byte classify. Independent range tests, the same shape as a
// hand-written character class scan: control, digit, upper, lower, other.
// Not a numeric kernel. n = 2000000, eight passes. Checksum is the counts.

LibraryImport.Arena

Function.Stamp {
    Input: buf: Integer
    Output: Integer
    Body: {
        dummy = SystemCall(228, 1, buf)
        sec = Dereference(buf)
        nsec = Dereference(Add(buf, 8))
        ns = Add(Multiply(sec, 1000000000), nsec)
        ReturnValue(ns)
    }
}

SubRoutine.Main {
    text = "The quick brown fox jumps over the lazy dog. 12345\n"
    tn = StringLength(text)
    n = 2000000
    buf = Allocate(n)
    i = 0
    WhileLoop LessThan(i, n) {
        SetByte(buf, i, StringCharAt(text, Modulo(i, tn)))
        i = Add(i, 1)
    }
    clock = Allocate(16)
    t0 = Stamp(clock)
    ctrl = 0
    digit = 0
    upper = 0
    lower = 0
    other = 0
    sum = 0
    rep = 0
    reps = 8
    WhileLoop LessThan(rep, reps) {
        i = 0
        WhileLoop LessThan(i, n) {
            c = GetByte(buf, i)
            kind = 5
            IfCondition LessThan(c, 33) ThenBlock: { kind = 1 }
            IfCondition And(GreaterEqual(c, 48), LessThan(c, 58)) ThenBlock: { kind = 2 }
            IfCondition And(GreaterEqual(c, 65), LessThan(c, 91)) ThenBlock: { kind = 3 }
            IfCondition And(GreaterEqual(c, 97), LessThan(c, 123)) ThenBlock: { kind = 4 }
            IfCondition EqualTo(kind, 1) ThenBlock: { ctrl = Add(ctrl, 1) }
            IfCondition EqualTo(kind, 2) ThenBlock: { digit = Add(digit, 1) }
            IfCondition EqualTo(kind, 3) ThenBlock: { upper = Add(upper, 1) }
            IfCondition EqualTo(kind, 4) ThenBlock: { lower = Add(lower, 1) }
            IfCondition EqualTo(kind, 5) ThenBlock: { other = Add(other, 1) }
            sum = Add(sum, c)
            i = Add(i, 1)
        }
        rep = Add(rep, 1)
    }
    t1 = Stamp(clock)
    PrintMessage("CLASS ctrl ")
    PrintNumber(ctrl)
    PrintMessage(" digit ")
    PrintNumber(digit)
    PrintMessage(" upper ")
    PrintNumber(upper)
    PrintMessage(" lower ")
    PrintNumber(lower)
    PrintMessage(" other ")
    PrintNumber(other)
    PrintMessage(" sum ")
    PrintNumber(sum)
    PrintMessage(" ns ")
    PrintNumber(Subtract(t1, t0))
    PrintMessage("\n")
    ProcessExit(0)
}

RunTask(Main)
