// Everyday wc: lines, words, and bytes. A two-state scan (in a word or
// not) written as ordinary ifs, not a numeric kernel.

LibraryImport.Arena

Function.Stamp {
    Input: buf: Integer
    Output: Integer
    Body: {
        dummy = SystemCall(228, 1, buf)
        sec = Dereference(buf)
        nsec = Dereference(Add(buf, 8))
        ns = Add(Multiply(sec, 1000000000), nsec)
        ReturnValue(ns)
    }
}

SubRoutine.Main {
    text = "The quick brown fox jumps over the lazy dog. 12345\n"
    tn = StringLength(text)
    n = 2000000
    buf = Allocate(n)
    i = 0
    WhileLoop LessThan(i, n) {
        SetByte(buf, i, StringCharAt(text, Modulo(i, tn)))
        i = Add(i, 1)
    }
    clock = Allocate(16)
    t0 = Stamp(clock)
    lines = 0
    words = 0
    bytes = 0
    reps = 8
    rep = 0
    WhileLoop LessThan(rep, reps) {
        inw = 0
        i = 0
        WhileLoop LessThan(i, n) {
            c = GetByte(buf, i)
            bytes = Add(bytes, 1)
            IfCondition EqualTo(c, 10) ThenBlock: { lines = Add(lines, 1) }
            sp = 0
            IfCondition EqualTo(c, 32) ThenBlock: { sp = 1 }
            IfCondition EqualTo(c, 10) ThenBlock: { sp = 1 }
            IfCondition EqualTo(c, 9) ThenBlock: { sp = 1 }
            IfCondition EqualTo(c, 13) ThenBlock: { sp = 1 }
            IfCondition EqualTo(sp, 1) ThenBlock: {
                inw = 0
            } ElseBlock: {
                IfCondition EqualTo(inw, 0) ThenBlock: {
                    words = Add(words, 1)
                    inw = 1
                }
            }
            i = Add(i, 1)
        }
        rep = Add(rep, 1)
    }
    t1 = Stamp(clock)
    PrintMessage("WC lines ")
    PrintNumber(lines)
    PrintMessage(" words ")
    PrintNumber(words)
    PrintMessage(" bytes ")
    PrintNumber(bytes)
    PrintMessage(" ns ")
    PrintNumber(Subtract(t1, t0))
    PrintMessage("\n")
    ProcessExit(0)
}

RunTask(Main)
