// Single-thread fannkuch-redux. Same permutation and flip order as
// fannkuch.cpp. At returns an expression and Put does not return, so
// the splice leaves both as calls. The clock wraps only the search.

LibraryImport.Arena

FixedPool.Fan {
    "checksum": Initialize=0, CanChange=True
    "maxf": Initialize=0, CanChange=True
}

Function.Stamp {
    Input: buf: Integer
    Output: Integer
    Body: {
        dummy = SystemCall(228, 1, buf)
        sec = Dereference(buf)
        nsec = Dereference(Add(buf, 8))
        ns = Add(Multiply(sec, 1000000000), nsec)
        ReturnValue(ns)
    }
}

Function.At {
    Input: base: Integer
    Input: i: Integer
    Output: Integer
    Body: {
        ReturnValue(Dereference(Add(base, Multiply(i, 8))))
    }
}

Function.Put {
    Input: base: Integer
    Input: i: Integer
    Input: v: Integer
    Body: {
        StoreValue(Add(base, Multiply(i, 8)), v)
    }
}

Function.Fannkuch {
    Input: n: Integer
    Input: perm: Integer
    Input: perm1: Integer
    Input: count: Integer
    Body: {
        maxf = 0
        sum = 0
        perm_count = 0
        i = 0
        WhileLoop LessThan(i, n) {
            Put(perm1, i, i)
            i = Add(i, 1)
        }
        r = n
        going = 1
        WhileLoop EqualTo(going, 1) {
            WhileLoop NotEqual(r, 1) {
                Put(count, Subtract(r, 1), r)
                r = Subtract(r, 1)
            }
            i = 0
            WhileLoop LessThan(i, n) {
                Put(perm, i, At(perm1, i))
                i = Add(i, 1)
            }
            flips = 0
            k = At(perm, 0)
            WhileLoop NotEqual(k, 0) {
                k2 = RightShift(Add(k, 1), 1)
                i = 0
                WhileLoop LessThan(i, k2) {
                    a = At(perm, i)
                    idx = Subtract(k, i)
                    b = At(perm, idx)
                    Put(perm, i, b)
                    Put(perm, idx, a)
                    i = Add(i, 1)
                }
                flips = Add(flips, 1)
                k = At(perm, 0)
            }
            IfCondition GreaterThan(flips, maxf) ThenBlock: {
                maxf = flips
            }
            IfCondition EqualTo(BitwiseAnd(perm_count, 1), 0) ThenBlock: {
                sum = Add(sum, flips)
            } ElseBlock: {
                sum = Subtract(sum, flips)
            }
            rotating = 1
            WhileLoop EqualTo(rotating, 1) {
                IfCondition EqualTo(r, n) ThenBlock: {
                    Fan.checksum = sum
                    Fan.maxf = maxf
                    going = 0
                    rotating = 0
                }
                IfCondition EqualTo(rotating, 1) ThenBlock: {
                    perm0 = At(perm1, 0)
                    i = 0
                    WhileLoop LessThan(i, r) {
                        j = Add(i, 1)
                        Put(perm1, i, At(perm1, j))
                        i = j
                    }
                    Put(perm1, r, perm0)
                    cr = Subtract(At(count, r), 1)
                    Put(count, r, cr)
                    IfCondition GreaterThan(cr, 0) ThenBlock: {
                        rotating = 0
                    }
                    IfCondition EqualTo(rotating, 1) ThenBlock: {
                        r = Add(r, 1)
                    }
                }
            }
            IfCondition EqualTo(going, 1) ThenBlock: {
                perm_count = Add(perm_count, 1)
            }
        }
    }
}

Function.RunN {
    Input: n: Integer
    Input: clock: Integer
    Body: {
        perm = Allocate(128)
        perm1 = Allocate(128)
        count = Allocate(128)
        t0 = Stamp(clock)
        Fannkuch(n, perm, perm1, count)
        t1 = Stamp(clock)
        PrintMessage("FANNKUCH ")
        PrintNumber(n)
        PrintMessage(" checksum ")
        PrintNumber(Fan.checksum)
        PrintMessage(" max ")
        PrintNumber(Fan.maxf)
        PrintMessage(" ns ")
        PrintNumber(Subtract(t1, t0))
        PrintMessage("\n")
    }
}

SubRoutine.Main {
    clock = Allocate(16)
    RunN(7, clock)
    RunN(10, clock)
    RunN(12, clock)
    ProcessExit(0)
}

RunTask(Main)
