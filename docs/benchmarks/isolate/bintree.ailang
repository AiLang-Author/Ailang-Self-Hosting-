// Bottom-up binary trees. Node is left, right, item at stride 24.
// 80 trees of depth 12. Check of one Build(12, 1) is 0.

LibraryImport.Arena

Function.Stamp {
    Input: buf: Integer
    Output: Integer
    Body: {
        dummy = SystemCall(228, 1, buf)
        sec = Dereference(buf)
        nsec = Dereference(Add(buf, 8))
        ns = Add(Multiply(sec, 1000000000), nsec)
        ReturnValue(ns)
    }
}

Function.Build {
    Input: d: Integer
    Input: item: Integer
    Output: Integer
    Body: {
        p = Allocate(24)
        StoreValue(Add(p, 16), item)
        IfCondition LessEqual(d, 0) ThenBlock: {
            StoreValue(p, 0)
            StoreValue(Add(p, 8), 0)
            ReturnValue(p)
        }
        StoreValue(p, Build(Subtract(d, 1), Subtract(Multiply(item, 2), 1)))
        StoreValue(Add(p, 8), Build(Subtract(d, 1), Multiply(item, 2)))
        ReturnValue(p)
    }
}

Function.Check {
    Input: p: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(p, 0) ThenBlock: {
            ReturnValue(0)
        }
        left = Dereference(p)
        right = Dereference(Add(p, 8))
        item = Dereference(Add(p, 16))
        IfCondition EqualTo(left, 0) ThenBlock: {
            ReturnValue(item)
        }
        ReturnValue(Subtract(Add(item, Check(left)), Check(right)))
    }
}

SubRoutine.Main {
    clock = Allocate(16)
    t0 = Stamp(clock)
    s = 0
    i = 0
    WhileLoop LessThan(i, 80) {
        t = Build(12, 1)
        s = Add(s, Check(t))
        i = Add(i, 1)
    }
    t1 = Stamp(clock)
    PrintMessage("BINTREE ")
    PrintNumber(s)
    PrintMessage(" ns ")
    PrintNumber(Subtract(t1, t0))
    PrintMessage("\n")
    IfCondition NotEqual(s, 0) ThenBlock: {
        ProcessExit(1)
    }
    ProcessExit(0)
}

RunTask(Main)
