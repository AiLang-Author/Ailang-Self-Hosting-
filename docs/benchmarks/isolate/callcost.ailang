// Split call cost: reg-leaf add, leaf with a local, non-leaf (full
// prologue), six-arg add, and a deep stack walk. Depth(512) * 2000
// walks a million frames. Checksums are in the C twin.

LibraryImport.Arena

Function.Stamp {
    Input: buf: Integer
    Output: Integer
    Body: {
        dummy = SystemCall(228, 1, buf)
        sec = Dereference(buf)
        nsec = Dereference(Add(buf, 8))
        ns = Add(Multiply(sec, 1000000000), nsec)
        ReturnValue(ns)
    }
}

Function.LeafAdd {
    Input: a: Integer
    Input: b: Integer
    Output: Integer
    Body: {
        ReturnValue(Add(a, b))
    }
}

Function.StubAdd {
    Input: a: Integer
    Input: b: Integer
    Output: Integer
    Body: {
        s = Add(a, b)
        ReturnValue(s)
    }
}

Function.Sink {
    Input: x: Integer
    Output: Integer
    Body: {
        ReturnValue(x)
    }
}

Function.CallAdd {
    Input: a: Integer
    Input: b: Integer
    Output: Integer
    Body: {
        s = Add(a, b)
        ReturnValue(Sink(s))
    }
}

Function.Sum6 {
    Input: a: Integer
    Input: b: Integer
    Input: c: Integer
    Input: d: Integer
    Input: e: Integer
    Input: f: Integer
    Output: Integer
    Body: {
        ReturnValue(Add(Add(Add(a, b), Add(c, d)), Add(e, f)))
    }
}

Function.Depth {
    Input: n: Integer
    Output: Integer
    Body: {
        here = n
        IfCondition LessEqual(n, 0) ThenBlock: {
            ReturnValue(here)
        }
        nm1 = Subtract(n, 1)
        below = Depth(nm1)
        ReturnValue(Add(here, below))
    }
}

Function.LoopLeaf {
    Input: n: Integer
    Output: Integer
    Body: {
        s = 0
        i = 0
        WhileLoop LessThan(i, n) {
            s = Add(s, LeafAdd(i, 1))
            i = Add(i, 1)
        }
        ReturnValue(s)
    }
}

Function.LoopStub {
    Input: n: Integer
    Output: Integer
    Body: {
        s = 0
        i = 0
        WhileLoop LessThan(i, n) {
            s = Add(s, StubAdd(i, 1))
            i = Add(i, 1)
        }
        ReturnValue(s)
    }
}

Function.LoopCall {
    Input: n: Integer
    Output: Integer
    Body: {
        s = 0
        i = 0
        WhileLoop LessThan(i, n) {
            s = Add(s, CallAdd(i, 1))
            i = Add(i, 1)
        }
        ReturnValue(s)
    }
}

Function.LoopSix {
    Input: n: Integer
    Output: Integer
    Body: {
        s = 0
        i = 0
        WhileLoop LessThan(i, n) {
            s = Add(s, Sum6(i, 1, 2, 3, 4, 5))
            i = Add(i, 1)
        }
        ReturnValue(s)
    }
}

Function.LoopDeep {
    Input: trips: Integer
    Input: n: Integer
    Output: Integer
    Body: {
        s = 0
        k = 0
        WhileLoop LessThan(k, trips) {
            s = Add(s, Depth(n))
            k = Add(k, 1)
        }
        ReturnValue(s)
    }
}

SubRoutine.Main {
    clock = Allocate(16)
    n = 20000000
    fails = 0

    t0 = Stamp(clock)
    leaf = LoopLeaf(n)
    t1 = Stamp(clock)
    IfCondition NotEqual(leaf, 200000010000000) ThenBlock: { fails = Add(fails, 1) }

    t2 = Stamp(clock)
    stub = LoopStub(n)
    t3 = Stamp(clock)
    IfCondition NotEqual(stub, 200000010000000) ThenBlock: { fails = Add(fails, 1) }

    t4 = Stamp(clock)
    callv = LoopCall(n)
    t5 = Stamp(clock)
    IfCondition NotEqual(callv, 200000010000000) ThenBlock: { fails = Add(fails, 1) }

    t6 = Stamp(clock)
    six = LoopSix(10000000)
    t7 = Stamp(clock)
    IfCondition NotEqual(six, 50000145000000) ThenBlock: { fails = Add(fails, 1) }

    t8 = Stamp(clock)
    deep = LoopDeep(2000, 512)
    t9 = Stamp(clock)
    IfCondition NotEqual(deep, 262656000) ThenBlock: { fails = Add(fails, 1) }

    PrintMessage("CHECK callcost fails ")
    PrintNumber(fails)
    PrintMessage(" leaf ")
    PrintNumber(leaf)
    PrintMessage(" stub ")
    PrintNumber(stub)
    PrintMessage(" call ")
    PrintNumber(callv)
    PrintMessage(" six ")
    PrintNumber(six)
    PrintMessage(" deep ")
    PrintNumber(deep)
    PrintMessage("\n")
    PrintMessage("TIME LEAFADD ns ")
    PrintNumber(Subtract(t1, t0))
    PrintMessage("\n")
    PrintMessage("TIME STUBADD ns ")
    PrintNumber(Subtract(t3, t2))
    PrintMessage("\n")
    PrintMessage("TIME CALLADD ns ")
    PrintNumber(Subtract(t5, t4))
    PrintMessage("\n")
    PrintMessage("TIME SIXARG ns ")
    PrintNumber(Subtract(t7, t6))
    PrintMessage("\n")
    PrintMessage("TIME DEEPWALK ns ")
    PrintNumber(Subtract(t9, t8))
    PrintMessage("\n")
    IfCondition EqualTo(fails, 0) ThenBlock: {
        ProcessExit(0)
    }
    ProcessExit(1)
}

RunTask(Main)
