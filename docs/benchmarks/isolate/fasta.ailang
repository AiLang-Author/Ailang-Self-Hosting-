// FASTA-style: ALU repeat + LCG random IUB. n=250000.
// Output goes to a buffer. Checksum is length and byte sum.

LibraryImport.Arena

Function.Stamp {
    Input: buf: Integer
    Output: Integer
    Body: {
        dummy = SystemCall(228, 1, buf)
        sec = Dereference(buf)
        nsec = Dereference(Add(buf, 8))
        ns = Add(Multiply(sec, 1000000000), nsec)
        ReturnValue(ns)
    }
}

Function.Put60 {
    Input: dst: Integer
    Input: pos: Integer
    Input: ch: Integer
    Input: col: Integer
    Output: Integer
    Body: {
        SetByte(dst, pos, ch)
        pos = Add(pos, 1)
        col = Add(col, 1)
        IfCondition EqualTo(col, 60) ThenBlock: {
            SetByte(dst, pos, 10)
            pos = Add(pos, 1)
            col = 0
        }
        ReturnValue(Add(pos, Multiply(col, 4294967296)))
    }
}

Function.RepeatAlu {
    Input: dst: Integer
    Input: alu: Integer
    Input: alun: Integer
    Input: n: Integer
    Output: Integer
    Body: {
        pos = 0
        col = 0
        i = 0
        k = 0
        WhileLoop LessThan(i, n) {
            SetByte(dst, pos, GetByte(alu, k))
            pos = Add(pos, 1)
            col = Add(col, 1)
            IfCondition EqualTo(col, 60) ThenBlock: {
                SetByte(dst, pos, 10)
                pos = Add(pos, 1)
                col = 0
            }
            k = Add(k, 1)
            IfCondition EqualTo(k, alun) ThenBlock: { k = 0 }
            i = Add(i, 1)
        }
        IfCondition GreaterThan(col, 0) ThenBlock: {
            SetByte(dst, pos, 10)
            pos = Add(pos, 1)
        }
        ReturnValue(pos)
    }
}

Function.RandomIub {
    Input: dst: Integer
    Input: n: Integer
    Input: seed0: Integer
    Output: Integer
    Body: {
        pos = 0
        col = 0
        seed = seed0
        i = 0
        WhileLoop LessThan(i, n) {
            seed = Modulo(Add(Multiply(seed, 3877), 29573), 139968)
            ch = 97
            IfCondition LessThan(seed, 37672) ThenBlock: { ch = 97 }
            IfCondition And(GreaterEqual(seed, 37672), LessThan(seed, 54375)) ThenBlock: { ch = 99 }
            IfCondition And(GreaterEqual(seed, 54375), LessThan(seed, 71078)) ThenBlock: { ch = 103 }
            IfCondition And(GreaterEqual(seed, 71078), LessThan(seed, 108750)) ThenBlock: { ch = 116 }
            IfCondition GreaterEqual(seed, 108750) ThenBlock: { ch = 66 }
            SetByte(dst, pos, ch)
            pos = Add(pos, 1)
            col = Add(col, 1)
            IfCondition EqualTo(col, 60) ThenBlock: {
                SetByte(dst, pos, 10)
                pos = Add(pos, 1)
                col = 0
            }
            i = Add(i, 1)
        }
        IfCondition GreaterThan(col, 0) ThenBlock: {
            SetByte(dst, pos, 10)
            pos = Add(pos, 1)
        }
        ReturnValue(Add(pos, Multiply(seed, 4294967296)))
    }
}

Function.SumBytes {
    Input: p: Integer
    Input: n: Integer
    Output: Integer
    Body: {
        s = 0
        i = 0
        WhileLoop LessThan(i, n) {
            s = Add(s, GetByte(p, i))
            i = Add(i, 1)
        }
        ReturnValue(s)
    }
}

SubRoutine.Main {
    alu_s = "GGCCGGGCGCGGTGGCTCACGCCTGTAATCCCAGCACTTTGGGAGGCCGAGGCGGGCGGATCACCTGAGGTCAGGAGTTCGAGACCAGCCTGGCCAACATGGTGAAACCCCGTCTCTACTAAAAATACAAAAATTAGCCGGGCGTGGTGGCGCGCGCCTGTAATCCCAGCTACTCGGGAGGCTGAGGCAGGAGAATCGCTTGAACCCGGGAGGCGGAGGTTGCAGTGAGCCGAGATCGCGCCACTGCACTCCAGCCTGGGCGACAGAGCGAGACTCCGTCTCAAAAA"
    alun = StringLength(alu_s)
    alu = Allocate(alun)
    i = 0
    WhileLoop LessThan(i, alun) {
        SetByte(alu, i, StringCharAt(alu_s, i))
        i = Add(i, 1)
    }
    n = 250000
    cap = 1200000
    dst = Allocate(cap)
    clock = Allocate(16)
    t0 = Stamp(clock)
    p1 = RepeatAlu(dst, alu, alun, Multiply(n, 2))
    packed = RandomIub(Add(dst, p1), n, 42)
    p2 = BitwiseAnd(packed, 4294967295)
    t1 = Stamp(clock)
    total = Add(p1, p2)
    sm = SumBytes(dst, total)
    PrintMessage("FASTA n ")
    PrintNumber(n)
    PrintMessage(" len ")
    PrintNumber(total)
    PrintMessage(" sum ")
    PrintNumber(sm)
    PrintMessage(" ns ")
    PrintNumber(Subtract(t1, t0))
    PrintMessage("\n")
    ProcessExit(0)
}

RunTask(Main)
