// Two bodies, field subtract and multiply, no square root.
// ix/jx live in memory. The update writes them back.

LibraryImport.Arena

Function.Stamp {
    Input: buf: Integer
    Output: Integer
    Body: {
        dummy = SystemCall(228, 1, buf)
        sec = RDMEM_64(buf)
        nsec = RDMEM_64(buf, 8)
        ns = Add(Multiply(sec, 1000000000), nsec)
        ReturnValue(ns)
    }
}

Function.Run {
    Input: p: Integer
    Input: q: Integer
    Output: Integer
    Body: {
        half = Float_FromInt(1)
        n = 0
        hits = 0
        WhileLoop LessThan(n, 8000000) {
            ix = RDMEM_64(p)
            iy = RDMEM_64(p, 8)
            jx = RDMEM_64(q)
            jy = RDMEM_64(q, 8)
            dx = Float_Sub(ix, jx)
            dy = Float_Sub(iy, jy)
            s = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
            ix = Float_Add(ix, Float_Mul(dx, half))
            iy = Float_Add(iy, Float_Mul(dy, half))
            WRMEM_64(p, ix)
            WRMEM_64(p, 8, iy)
            IfCondition Float_Lt(s, ix) ThenBlock: {
                hits = Add(hits, 1)
            }
            n = Add(n, 1)
        }
        ReturnValue(hits)
    }
}

SubRoutine.Main {
    clock = Allocate(16)
    p = Allocate(16)
    q = Allocate(16)
    WRMEM_64(p, 4607182418800017408)
    WRMEM_64(p, 8, 4611686018427387904)
    WRMEM_64(q, 4602678819172646912)
    WRMEM_64(q, 8, 4613937818241073152)
    t0 = Stamp(clock)
    hits = Run(p, q)
    t1 = Stamp(clock)
    PrintMessage("FIELDOP ")
    PrintNumber(hits)
    PrintMessage(" ns ")
    PrintNumber(Subtract(t1, t0))
    PrintMessage("\n")
    ProcessExit(0)
}

RunTask(Main)
