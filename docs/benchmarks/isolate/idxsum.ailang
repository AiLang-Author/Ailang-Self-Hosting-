// sum += a[i] over a small array, many passes.
// The address is base + i*8. No library call.

LibraryImport.Arena

Function.Stamp {
    Input: buf: Integer
    Output: Integer
    Body: {
        dummy = SystemCall(228, 1, buf)
        sec = Dereference(buf)
        nsec = Dereference(Add(buf, 8))
        ns = Add(Multiply(sec, 1000000000), nsec)
        ReturnValue(ns)
    }
}

Function.Run {
    Input: arr: Integer
    Output: Integer
    Body: {
        sum = 0
        pass = 0
        WhileLoop LessThan(pass, 20000) {
            i = 0
            WhileLoop LessThan(i, 1024) {
                sum = Add(sum, Dereference(Add(arr, Multiply(i, 8))))
                i = Add(i, 1)
            }
            pass = Add(pass, 1)
        }
        ReturnValue(sum)
    }
}

SubRoutine.Main {
    clock = Allocate(16)
    arr = Allocate(8192)
    i = 0
    WhileLoop LessThan(i, 1024) {
        StoreValue(Add(arr, Multiply(i, 8)), i)
        i = Add(i, 1)
    }
    t0 = Stamp(clock)
    sum = Run(arr)
    t1 = Stamp(clock)
    PrintMessage("IDXSUM ")
    PrintNumber(sum)
    PrintMessage(" ns ")
    PrintNumber(Subtract(t1, t0))
    PrintMessage("\n")
    ProcessExit(0)
}

RunTask(Main)
