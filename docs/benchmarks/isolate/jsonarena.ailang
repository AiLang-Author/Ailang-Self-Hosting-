// Generate a JSON array of objects into a buffer, parse into Arena nodes.
// Node is kind, ival, next, child at stride 32. N=200000 objects ~4.4MB text.

LibraryImport.Arena

Function.Stamp {
    Input: buf: Integer
    Output: Integer
    Body: {
        dummy = SystemCall(228, 1, buf)
        sec = Dereference(buf)
        nsec = Dereference(Add(buf, 8))
        ns = Add(Multiply(sec, 1000000000), nsec)
        ReturnValue(ns)
    }
}

Function.PutInt {
    Input: dst: Integer
    Input: pos: Integer
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(n, 0) ThenBlock: {
            SetByte(dst, pos, 45)
            pos = Add(pos, 1)
            n = Subtract(0, n)
        }
        IfCondition LessThan(n, 10) ThenBlock: {
            SetByte(dst, pos, Add(48, n))
            ReturnValue(Add(pos, 1))
        }
        t = n
        d = 0
        WhileLoop GreaterThan(t, 0) {
            d = Add(d, 1)
            t = Divide(t, 10)
        }
        t = n
        i = Subtract(d, 1)
        WhileLoop GreaterEqual(i, 0) {
            SetByte(dst, Add(pos, i), Add(48, Modulo(t, 10)))
            t = Divide(t, 10)
            i = Subtract(i, 1)
        }
        ReturnValue(Add(pos, d))
    }
}

Function.Generate {
    Input: dst: Integer
    Input: nobj: Integer
    Output: Integer
    Body: {
        pos = 0
        SetByte(dst, pos, 91)
        pos = Add(pos, 1)
        i = 0
        WhileLoop LessThan(i, nobj) {
            IfCondition GreaterThan(i, 0) ThenBlock: {
                SetByte(dst, pos, 44)
                pos = Add(pos, 1)
            }
            SetByte(dst, pos, 123)
            pos = Add(pos, 1)
            SetByte(dst, pos, 34)
            pos = Add(pos, 1)
            SetByte(dst, pos, 120)
            pos = Add(pos, 1)
            SetByte(dst, pos, 34)
            pos = Add(pos, 1)
            SetByte(dst, pos, 58)
            pos = Add(pos, 1)
            pos = PutInt(dst, pos, i)
            SetByte(dst, pos, 44)
            pos = Add(pos, 1)
            SetByte(dst, pos, 34)
            pos = Add(pos, 1)
            SetByte(dst, pos, 121)
            pos = Add(pos, 1)
            SetByte(dst, pos, 34)
            pos = Add(pos, 1)
            SetByte(dst, pos, 58)
            pos = Add(pos, 1)
            pos = PutInt(dst, pos, Multiply(i, 3))
            SetByte(dst, pos, 125)
            pos = Add(pos, 1)
            i = Add(i, 1)
        }
        SetByte(dst, pos, 93)
        pos = Add(pos, 1)
        ReturnValue(pos)
    }
}

Function.Skip {
    Input: src: Integer
    Input: i: Integer
    Input: n: Integer
    Output: Integer
    Body: {
        WhileLoop LessThan(i, n) {
            ch = GetByte(src, i)
            ok = 0
            IfCondition EqualTo(ch, 32) ThenBlock: { ok = 1 }
            IfCondition EqualTo(ch, 10) ThenBlock: { ok = 1 }
            IfCondition EqualTo(ch, 9) ThenBlock: { ok = 1 }
            IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(i) }
            i = Add(i, 1)
        }
        ReturnValue(i)
    }
}

Function.ParseNum {
    Input: src: Integer
    Input: i: Integer
    Input: n: Integer
    Input: node: Integer
    Output: Integer
    Body: {
        v = 0
        WhileLoop LessThan(i, n) {
            ch = GetByte(src, i)
            IfCondition LessThan(ch, 48) ThenBlock: { ExitLoop }
            IfCondition GreaterThan(ch, 57) ThenBlock: { ExitLoop }
            v = Add(Multiply(v, 10), Subtract(ch, 48))
            i = Add(i, 1)
        }
        StoreValue(node, 2)
        StoreValue(Add(node, 8), v)
        StoreValue(Add(node, 16), 0)
        StoreValue(Add(node, 24), 0)
        ReturnValue(i)
    }
}

Function.ParseArr {
    Input: src: Integer
    Input: i: Integer
    Input: n: Integer
    Input: arena: Integer
    Input: usedp: Integer
    Output: Integer
    Body: {
        arr = Dereference(usedp)
        StoreValue(usedp, Add(arr, 32))
        StoreValue(arr, 4)
        StoreValue(Add(arr, 8), 0)
        StoreValue(Add(arr, 16), 0)
        StoreValue(Add(arr, 24), 0)
        i = Add(i, 1)
        head = 0
        tail = 0
        count = 0
        WhileLoop LessThan(i, n) {
            i = Skip(src, i, n)
            ch = GetByte(src, i)
            IfCondition EqualTo(ch, 93) ThenBlock: {
                i = Add(i, 1)
                ExitLoop
            }
            IfCondition EqualTo(ch, 44) ThenBlock: {
                i = Add(i, 1)
                ContinueLoop
            }
            nd = Dereference(usedp)
            StoreValue(usedp, Add(nd, 32))
            IfCondition EqualTo(ch, 123) ThenBlock: {
                i = ParseObj(src, i, n, arena, usedp, nd)
            } ElseBlock: {
                i = ParseNum(src, i, n, nd)
            }
            IfCondition EqualTo(head, 0) ThenBlock: {
                head = nd
                StoreValue(Add(arr, 24), nd)
            } ElseBlock: {
                StoreValue(Add(tail, 16), nd)
            }
            tail = nd
            count = Add(count, 1)
        }
        StoreValue(Add(arr, 8), count)
        ReturnValue(i)
    }
}

Function.ParseObj {
    Input: src: Integer
    Input: i: Integer
    Input: n: Integer
    Input: arena: Integer
    Input: usedp: Integer
    Input: obj: Integer
    Output: Integer
    Body: {
        StoreValue(obj, 5)
        StoreValue(Add(obj, 8), 0)
        StoreValue(Add(obj, 16), 0)
        StoreValue(Add(obj, 24), 0)
        i = Add(i, 1)
        fields = 0
        last = 0
        WhileLoop LessThan(i, n) {
            i = Skip(src, i, n)
            ch = GetByte(src, i)
            IfCondition EqualTo(ch, 125) ThenBlock: {
                i = Add(i, 1)
                ExitLoop
            }
            IfCondition EqualTo(ch, 44) ThenBlock: {
                i = Add(i, 1)
                ContinueLoop
            }
            IfCondition EqualTo(ch, 34) ThenBlock: {
                i = Add(i, 1)
                WhileLoop LessThan(i, n) {
                    IfCondition EqualTo(GetByte(src, i), 34) ThenBlock: { ExitLoop }
                    i = Add(i, 1)
                }
                i = Add(i, 1)
                i = Skip(src, i, n)
                IfCondition EqualTo(GetByte(src, i), 58) ThenBlock: { i = Add(i, 1) }
                i = Skip(src, i, n)
                val = Dereference(usedp)
                StoreValue(usedp, Add(val, 32))
                i = ParseNum(src, i, n, val)
                IfCondition EqualTo(last, 0) ThenBlock: {
                    StoreValue(Add(obj, 24), val)
                } ElseBlock: {
                    StoreValue(Add(last, 16), val)
                }
                last = val
                fields = Add(fields, 1)
            } ElseBlock: {
                i = Add(i, 1)
            }
        }
        StoreValue(Add(obj, 8), fields)
        ReturnValue(i)
    }
}

Function.WalkSum {
    Input: node: Integer
    Output: Integer
    Body: {
        s = 0
        obj = Dereference(Add(node, 24))
        WhileLoop NotEqual(obj, 0) {
            field = Dereference(Add(obj, 24))
            WhileLoop NotEqual(field, 0) {
                IfCondition EqualTo(Dereference(field), 2) ThenBlock: {
                    s = Add(s, Dereference(Add(field, 8)))
                }
                field = Dereference(Add(field, 16))
            }
            obj = Dereference(Add(obj, 16))
        }
        ReturnValue(s)
    }
}

SubRoutine.Main {
    nobj = 200000
    text = Allocate(8000000)
    arena = Allocate(32000000)
    usedp = Allocate(8)
    tlen = Generate(text, nobj)
    StoreValue(usedp, arena)
    clock = Allocate(16)
    t0 = Stamp(clock)
    ParseArr(text, 0, tlen, arena, usedp)
    t1 = Stamp(clock)
    used = Subtract(Dereference(usedp), arena)
    sm = WalkSum(arena)
    PrintMessage("JSONARENA bytes ")
    PrintNumber(tlen)
    PrintMessage(" nodesb ")
    PrintNumber(used)
    PrintMessage(" sum ")
    PrintNumber(sm)
    PrintMessage(" ns ")
    PrintNumber(Subtract(t1, t0))
    PrintMessage("\n")
    ProcessExit(0)
}

RunTask(Main)
