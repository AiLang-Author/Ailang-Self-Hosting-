// Six live integer accumulators. The scan GPR pool is three registers.

LibraryImport.Arena

Function.Stamp {
    Input: buf: Integer
    Output: Integer
    Body: {
        dummy = SystemCall(228, 1, buf)
        sec = Dereference(buf)
        nsec = Dereference(Add(buf, 8))
        ns = Add(Multiply(sec, 1000000000), nsec)
        ReturnValue(ns)
    }
}

Function.Run {
    Output: Integer
    Body: {
        a = 0
        b = 0
        c = 0
        d = 0
        e = 0
        f = 0
        n = 0
        WhileLoop LessThan(n, 8000000) {
            a = Add(a, 1)
            b = Add(b, 2)
            c = Add(c, 3)
            d = Add(d, 4)
            e = Add(e, 5)
            f = Add(f, 6)
            n = Add(n, 1)
        }
        ReturnValue(Add(Add(Add(a, b), Add(c, d)), Add(e, f)))
    }
}

SubRoutine.Main {
    clock = Allocate(16)
    t0 = Stamp(clock)
    s = Run()
    t1 = Stamp(clock)
    PrintMessage("LIVEINT ")
    PrintNumber(s)
    PrintMessage(" ns ")
    PrintNumber(Subtract(t1, t0))
    PrintMessage("\n")
    ProcessExit(0)
}

RunTask(Main)
