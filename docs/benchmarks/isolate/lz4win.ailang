// Sliding-window 4-byte hash compressor. 1MB input, 4096-slot table.
// Unaligned 32-bit loads via GetByte. Checksum is output size + mix.

LibraryImport.Arena

Function.Stamp {
    Input: buf: Integer
    Output: Integer
    Body: {
        dummy = SystemCall(228, 1, buf)
        sec = Dereference(buf)
        nsec = Dereference(Add(buf, 8))
        ns = Add(Multiply(sec, 1000000000), nsec)
        ReturnValue(ns)
    }
}

Function.Load32 {
    Input: p: Integer
    Input: i: Integer
    Output: Integer
    Body: {
        b0 = GetByte(p, i)
        b1 = GetByte(p, Add(i, 1))
        b2 = GetByte(p, Add(i, 2))
        b3 = GetByte(p, Add(i, 3))
        ReturnValue(Add(Add(b0, Multiply(b1, 256)), Add(Multiply(b2, 65536), Multiply(b3, 16777216))))
    }
}

Function.Compress {
    Input: src: Integer
    Input: n: Integer
    Input: tab: Integer
    Output: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, 4096) {
            StoreValue(Add(tab, Multiply(i, 8)), 0)
            i = Add(i, 1)
        }
        i = 0
        out = 0
        mix = 0
        lim = Subtract(n, 4)
        WhileLoop LessThan(i, lim) {
            v = Add(Add(GetByte(src, i), Multiply(GetByte(src, Add(i, 1)), 256)), Add(Multiply(GetByte(src, Add(i, 2)), 65536), Multiply(GetByte(src, Add(i, 3)), 16777216)))
            h = BitwiseAnd(RightShift(BitwiseAnd(Multiply(v, 2654435761), 4294967295), 20), 4095)
            slot = Add(tab, Multiply(h, 8))
            prev = Dereference(slot)
            StoreValue(slot, i)
            hit = 0
            IfCondition GreaterThan(prev, 0) ThenBlock: {
                dist = Subtract(i, prev)
                IfCondition LessThan(dist, 65536) ThenBlock: {
                    pv = Add(Add(GetByte(src, prev), Multiply(GetByte(src, Add(prev, 1)), 256)), Add(Multiply(GetByte(src, Add(prev, 2)), 65536), Multiply(GetByte(src, Add(prev, 3)), 16777216)))
                    IfCondition EqualTo(pv, v) ThenBlock: { hit = 1 }
                }
            }
            IfCondition EqualTo(hit, 1) ThenBlock: {
                ml = 4
                WhileLoop LessThan(Add(i, ml), n) {
                    IfCondition NotEqual(GetByte(src, Add(i, ml)), GetByte(src, Add(prev, ml))) ThenBlock: {
                        ExitLoop
                    }
                    ml = Add(ml, 1)
                }
                out = Add(out, 3)
                mix = BitwiseAnd(BitwiseXor(mix, Add(dist, Multiply(ml, 65537))), 4294967295)
                i = Add(i, ml)
            } ElseBlock: {
                out = Add(out, 1)
                mix = BitwiseAnd(Add(mix, GetByte(src, i)), 4294967295)
                i = Add(i, 1)
            }
        }
        out = Add(out, Subtract(n, i))
        ReturnValue(Add(out, Multiply(BitwiseAnd(mix, 4294967295), 4294967296)))
    }
}

SubRoutine.Main {
    n = 1048576
    src = Allocate(n)
    tab = Allocate(32768)
    seed = 1
    i = 0
    WhileLoop LessThan(i, n) {
        seed = BitwiseAnd(Add(Multiply(seed, 1664525), 1013904223), 4294967295)
        SetByte(src, i, BitwiseAnd(RightShift(seed, 24), 255))
        IfCondition EqualTo(BitwiseAnd(i, 63), 0) ThenBlock: {
            SetByte(src, i, GetByte(src, BitwiseAnd(i, 255)))
        }
        i = Add(i, 1)
    }
    clock = Allocate(16)
    t0 = Stamp(clock)
    packed = Compress(src, n, tab)
    t1 = Stamp(clock)
    outn = BitwiseAnd(packed, 4294967295)
    mix = RightShift(packed, 32)
    PrintMessage("LZ4WIN out ")
    PrintNumber(outn)
    PrintMessage(" mix ")
    PrintNumber(mix)
    PrintMessage(" ns ")
    PrintNumber(Subtract(t1, t0))
    PrintMessage("\n")
    ProcessExit(0)
}

RunTask(Main)
