// Scalar float chain. No structs, no square root. The n-body
// squares and adds, with every value already a local.

LibraryImport.Arena

Function.Stamp {
    Input: buf: Integer
    Output: Integer
    Body: {
        dummy = SystemCall(228, 1, buf)
        sec = Dereference(buf)
        nsec = Dereference(Add(buf, 8))
        ns = Add(Multiply(sec, 1000000000), nsec)
        ReturnValue(ns)
    }
}

Function.Run {
    Output: Integer
    Body: {
        cr = Float_FromInt(1)
        ci = Float_FromInt(1)
        two = Float_FromInt(2)
        four = Float_FromInt(4)
        x = Float_FromInt(0)
        y = Float_FromInt(0)
        n = 0
        hits = 0
        WhileLoop LessThan(n, 8000000) {
            x2 = Float_Mul(x, x)
            y2 = Float_Mul(y, y)
            mag = Float_Add(x2, y2)
            y = Float_Add(Float_Mul(two, Float_Mul(x, y)), ci)
            x = Float_Add(Float_Sub(x2, y2), cr)
            IfCondition Float_Lt(mag, four) ThenBlock: {
                hits = Add(hits, 1)
            }
            n = Add(n, 1)
        }
        ReturnValue(hits)
    }
}

SubRoutine.Main {
    clock = Allocate(16)
    t0 = Stamp(clock)
    hits = Run()
    t1 = Stamp(clock)
    PrintMessage("REGCHAIN ")
    PrintNumber(hits)
    PrintMessage(" ns ")
    PrintNumber(Subtract(t1, t0))
    PrintMessage("\n")
    ProcessExit(0)
}

RunTask(Main)
