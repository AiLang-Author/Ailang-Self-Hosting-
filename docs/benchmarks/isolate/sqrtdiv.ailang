// n-body mag chain, no structs. dist3 = dist2 * sqrt(dist2), mag = dt/dist3.
// x walks so the compiler cannot hoist the sqrt.

LibraryImport.Arena

Function.Stamp {
    Input: buf: Integer
    Output: Integer
    Body: {
        dummy = SystemCall(228, 1, buf)
        sec = Dereference(buf)
        nsec = Dereference(Add(buf, 8))
        ns = Add(Multiply(sec, 1000000000), nsec)
        ReturnValue(ns)
    }
}

Function.Run {
    Output: Integer
    Body: {
        dt = Float_Div(Float_FromInt(1), Float_FromInt(100))
        x = Float_FromInt(1)
        y = Float_FromInt(1)
        z = Float_FromInt(1)
        acc = Float_FromInt(0)
        n = 0
        WhileLoop LessThan(n, 8000000) {
            x2 = Float_Mul(x, x)
            y2 = Float_Mul(y, y)
            z2 = Float_Mul(z, z)
            dist2 = Float_Add(x2, y2)
            dist2 = Float_Add(dist2, z2)
            dist = Float_Sqrt(dist2)
            dist3 = Float_Mul(dist2, dist)
            mag = Float_Div(dt, dist3)
            x = Float_Add(x, mag)
            acc = Float_Add(acc, mag)
            n = Add(n, 1)
        }
        ReturnValue(acc)
    }
}

SubRoutine.Main {
    clock = Allocate(16)
    t0 = Stamp(clock)
    acc = Run()
    t1 = Stamp(clock)
    PrintMessage("SQRTDIV ")
    PrintNumber(acc)
    PrintMessage(" ns ")
    PrintNumber(Subtract(t1, t0))
    PrintMessage("\n")
    ProcessExit(0)
}

RunTask(Main)
