// The fannkuch flip, alone. perm[i] with perm[k-i], many reps.
// An even number of reversals puts the array back.

LibraryImport.Arena

Function.Stamp {
    Input: buf: Integer
    Output: Integer
    Body: {
        dummy = SystemCall(228, 1, buf)
        sec = Dereference(buf)
        nsec = Dereference(Add(buf, 8))
        ns = Add(Multiply(sec, 1000000000), nsec)
        ReturnValue(ns)
    }
}

Function.Run {
    Input: perm: Integer
    Output: Integer
    Body: {
        rep = 0
        WhileLoop LessThan(rep, 4000000) {
            i = 0
            WhileLoop LessThan(i, 8) {
                a = Dereference(Add(perm, Multiply(i, 8)))
                idx = Subtract(15, i)
                b = Dereference(Add(perm, Multiply(idx, 8)))
                StoreValue(Add(perm, Multiply(i, 8)), b)
                StoreValue(Add(perm, Multiply(idx, 8)), a)
                i = Add(i, 1)
            }
            rep = Add(rep, 1)
        }
        sum = 0
        i = 0
        WhileLoop LessThan(i, 16) {
            sum = Add(sum, Dereference(Add(perm, Multiply(i, 8))))
            i = Add(i, 1)
        }
        ReturnValue(sum)
    }
}

SubRoutine.Main {
    clock = Allocate(16)
    perm = Allocate(128)
    i = 0
    WhileLoop LessThan(i, 16) {
        StoreValue(Add(perm, Multiply(i, 8)), i)
        i = Add(i, 1)
    }
    t0 = Stamp(clock)
    sum = Run(perm)
    t1 = Stamp(clock)
    PrintMessage("SWAPLOOP ")
    PrintNumber(sum)
    PrintMessage(" ns ")
    PrintNumber(Subtract(t1, t0))
    PrintMessage("\n")
    ProcessExit(0)
}

RunTask(Main)
