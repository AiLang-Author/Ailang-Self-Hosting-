// Stream triad. a[i] = b[i] + c[i]*d[i]. Pointers escape through Allocate.

LibraryImport.Arena

Function.Stamp {
    Input: buf: Integer
    Output: Integer
    Body: {
        dummy = SystemCall(228, 1, buf)
        sec = Dereference(buf)
        nsec = Dereference(Add(buf, 8))
        ns = Add(Multiply(sec, 1000000000), nsec)
        ReturnValue(ns)
    }
}

Function.Run {
    Input: a: Integer
    Input: b: Integer
    Input: c: Integer
    Input: d: Integer
    Input: n: Integer
    Output: Integer
    Body: {
        s = Float_FromInt(0)
        i = 0
        WhileLoop LessThan(i, n) {
            off = Multiply(i, 8)
            bv = Dereference(Add(b, off))
            cv = Dereference(Add(c, off))
            dv = Dereference(Add(d, off))
            t = Float_Add(bv, Float_Mul(cv, dv))
            StoreValue(Add(a, off), t)
            s = Float_Add(s, t)
            i = Add(i, 1)
        }
        ReturnValue(s)
    }
}

SubRoutine.Main {
    n = 2000000
    bytes = Multiply(n, 8)
    a = Allocate(bytes)
    b = Allocate(bytes)
    c = Allocate(bytes)
    d = Allocate(bytes)
    i = 0
    WhileLoop LessThan(i, n) {
        off = Multiply(i, 8)
        StoreValue(Add(b, off), Float_FromInt(i))
        StoreValue(Add(c, off), Float_FromInt(1))
        StoreValue(Add(d, off), Float_FromInt(2))
        i = Add(i, 1)
    }
    clock = Allocate(16)
    t0 = Stamp(clock)
    s = Run(a, b, c, d, n)
    t1 = Stamp(clock)
    PrintMessage("TRIAD ")
    PrintNumber(s)
    PrintMessage(" ns ")
    PrintNumber(Subtract(t1, t0))
    PrintMessage("\n")
    ProcessExit(0)
}

RunTask(Main)
