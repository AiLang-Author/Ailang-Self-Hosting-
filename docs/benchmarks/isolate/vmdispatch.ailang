// 256-byte bytecode, 100 million fetches, 16-way Branch dispatch.
// Accumulators a,b,c stay live across the loop.

LibraryImport.Arena

Function.Stamp {
    Input: buf: Integer
    Output: Integer
    Body: {
        dummy = SystemCall(228, 1, buf)
        sec = Dereference(buf)
        nsec = Dereference(Add(buf, 8))
        ns = Add(Multiply(sec, 1000000000), nsec)
        ReturnValue(ns)
    }
}

Function.Run {
    Input: code: Integer
    Input: n: Integer
    Output: Integer
    Body: {
        a = 1
        b = 1
        c = 0
        pc = 0
        i = 0
        WhileLoop LessThan(i, n) {
            op = GetByte(code, BitwiseAnd(pc, 255))
            Branch op {
                Case 0: { a = Add(a, 1) }
                Case 1: { a = Add(a, b) }
                Case 2: { b = Add(b, 1) }
                Case 3: { c = Add(c, a) }
                Case 4: { a = BitwiseXor(a, b) }
                Case 5: { b = BitwiseAnd(b, 65535) }
                Case 6: { a = Add(Multiply(a, 1664525), 1013904223) }
                Case 7: { c = BitwiseXor(c, pc) }
                Case 8: { a = Subtract(a, b) }
                Case 9: { b = Add(b, c) }
                Case 10: { c = Add(c, 1) }
                Case 11: { a = BitwiseOr(a, 1) }
                Case 12: { b = BitwiseXor(b, a) }
                Case 13: { a = Add(a, pc) }
                Case 14: { c = Subtract(c, 1) }
                Case 15: { b = Add(b, 3) }
                Default: { a = Add(a, 1) }
            }
            pc = Add(pc, 1)
            i = Add(i, 1)
        }
        ReturnValue(BitwiseXor(BitwiseXor(a, b), c))
    }
}

SubRoutine.Main {
    code = Allocate(256)
    i = 0
    WhileLoop LessThan(i, 256) {
        SetByte(code, i, BitwiseAnd(i, 15))
        i = Add(i, 1)
    }
    clock = Allocate(16)
    t0 = Stamp(clock)
    h = Run(code, 100000000)
    t1 = Stamp(clock)
    PrintMessage("VMDISPATCH ")
    PrintNumber(h)
    PrintMessage(" ns ")
    PrintNumber(Subtract(t1, t0))
    PrintMessage("\n")
    ProcessExit(0)
}

RunTask(Main)
