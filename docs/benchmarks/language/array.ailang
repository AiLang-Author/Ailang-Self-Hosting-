// Library.Array push, get, and linear IndexOf.
// The C twin grows the same way and copies with glibc memcpy.

LibraryImport.Arena
LibraryImport.Array

Function.Stamp {
    Input: buf: Integer
    Output: Integer
    Body: {
        dummy = SystemCall(228, 1, buf)
        sec = Dereference(buf)
        nsec = Dereference(Add(buf, 8))
        ns = Add(Multiply(sec, 1000000000), nsec)
        ReturnValue(ns)
    }
}

SubRoutine.Main {
    Arena_Init()
    clock = Allocate(16)
    n = 100000
    fails = 0
    arr = Array.Create(16)

    t0 = Stamp(clock)
    i = 0
    WhileLoop LessThan(i, n) {
        v = Add(i, 1)
        Array.Push(arr, v)
        i = Add(i, 1)
    }
    sum = 0
    i = 0
    WhileLoop LessThan(i, n) {
        v = Array.Get(arr, i)
        sum = Add(sum, v)
        i = Add(i, 1)
    }
    t1 = Stamp(clock)

    sz = Array.Size(arr)
    IfCondition NotEqual(sz, n) ThenBlock: {
        fails = Add(fails, 1)
    }
    expect = Divide(Multiply(n, Add(n, 1)), 2)
    IfCondition NotEqual(sum, expect) ThenBlock: {
        fails = Add(fails, 1)
    }
    at = Array.IndexOf(arr, 1)
    IfCondition NotEqual(at, 0) ThenBlock: {
        fails = Add(fails, 1)
    }
    at = Array.IndexOf(arr, n)
    last = Subtract(n, 1)
    IfCondition NotEqual(at, last) ThenBlock: {
        fails = Add(fails, 1)
    }
    at = Array.IndexOf(arr, -1)
    IfCondition NotEqual(at, -1) ThenBlock: {
        fails = Add(fails, 1)
    }
    // 0 and n+1 are absent. A stale loop exit would walk off the array
    // or return a present index, and fails would leave 0.
    at = Array.IndexOf(arr, 0)
    IfCondition NotEqual(at, -1) ThenBlock: {
        fails = Add(fails, 1)
    }
    missing = Add(n, 1)
    at = Array.IndexOf(arr, missing)
    IfCondition NotEqual(at, -1) ThenBlock: {
        fails = Add(fails, 1)
    }
    has = Array.Contains(arr, 50)
    IfCondition NotEqual(has, 1) ThenBlock: {
        fails = Add(fails, 1)
    }
    has = Array.Contains(arr, -2)
    IfCondition NotEqual(has, 0) ThenBlock: {
        fails = Add(fails, 1)
    }

    PrintMessage("CHECK array fails ")
    PrintNumber(fails)
    PrintMessage(" sum ")
    PrintNumber(sum)
    PrintMessage("\n")
    PrintMessage("TIME array build ns ")
    PrintNumber(Subtract(t1, t0))
    PrintMessage("\n")

    acc = 0
    t0 = Stamp(clock)
    rep = 0
    WhileLoop LessThan(rep, 8) {
        at = Array.IndexOf(arr, n)
        acc = Add(acc, at)
        rep = Add(rep, 1)
    }
    t1 = Stamp(clock)
    PrintMessage("TIME array find ns ")
    PrintNumber(Subtract(t1, t0))
    PrintMessage(" acc ")
    PrintNumber(acc)
    PrintMessage("\n")

    Array.Destroy(arr)
    IfCondition EqualTo(fails, 0) ThenBlock: {
        ProcessExit(0)
    }
    ProcessExit(1)
}

RunTask(Main)
