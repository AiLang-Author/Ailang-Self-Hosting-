// Phase timer for the official hash span. Not the official bench.
// n = 20000 keys, "k" plus 7 digits. Two write passes, two hash passes,
// two length passes, two compares, then insert, lookup, and update.
// TIME official is the same work as TIME hash build.
LibraryImport.Arena
LibraryImport.Hash

Function.Stamp {
    Input: buf: Integer
    Output: Integer
    Body: {
        dummy = SystemCall(228, 1, buf)
        sec = Dereference(buf)
        nsec = Dereference(Add(buf, 8))
        ns = Add(Multiply(sec, 1000000000), nsec)
        ReturnValue(ns)
    }
}

Function.WriteKey {
    Input: buf: Address
    Input: i: Integer
    Body: {
        n = i
        p = 7
        SetByte(buf, 0, 107)
        WhileLoop GreaterThan(p, 0) {
            dig = Modulo(n, 10)
            ch = Add(48, dig)
            SetByte(buf, p, ch)
            n = Divide(n, 10)
            p = Subtract(p, 1)
        }
        SetByte(buf, 8, 0)
    }
}

SubRoutine.Main {
    Arena_Init()
    clock = Allocate(16)
    n = 20000
    keys = Allocate(Multiply(n, 16))
    keys2 = Allocate(Multiply(n, 16))
    fails = 0

    t0 = Stamp(clock)
    i = 0
    WhileLoop LessThan(i, n) {
        WriteKey(Add(keys, Multiply(i, 16)), i)
        i = Add(i, 1)
    }
    i = 0
    WhileLoop LessThan(i, n) {
        WriteKey(Add(keys, Multiply(i, 16)), i)
        i = Add(i, 1)
    }
    t1 = Stamp(clock)

    i = 0
    WhileLoop LessThan(i, n) {
        WriteKey(Add(keys2, Multiply(i, 16)), i)
        i = Add(i, 1)
    }

    crc_sum = 0
    t2 = Stamp(clock)
    i = 0
    WhileLoop LessThan(i, n) {
        crc_sum = Add(crc_sum, Hash.HashString(Add(keys, Multiply(i, 16))))
        i = Add(i, 1)
    }
    i = 0
    WhileLoop LessThan(i, n) {
        crc_sum = Add(crc_sum, Hash.HashString(Add(keys, Multiply(i, 16))))
        i = Add(i, 1)
    }
    t3 = Stamp(clock)

    len_sum = 0
    t4 = Stamp(clock)
    i = 0
    WhileLoop LessThan(i, n) {
        len_sum = Add(len_sum, StringLength(Add(keys, Multiply(i, 16))))
        i = Add(i, 1)
    }
    i = 0
    WhileLoop LessThan(i, n) {
        len_sum = Add(len_sum, StringLength(Add(keys, Multiply(i, 16))))
        i = Add(i, 1)
    }
    t5 = Stamp(clock)

    cmp_sum = 0
    t6 = Stamp(clock)
    i = 0
    WhileLoop LessThan(i, n) {
        cmp_sum = Add(cmp_sum, StringCompare(Add(keys, Multiply(i, 16)), Add(keys2, Multiply(i, 16))))
        i = Add(i, 1)
    }
    i = 0
    WhileLoop LessThan(i, n) {
        cmp_sum = Add(cmp_sum, StringCompare(Add(keys, Multiply(i, 16)), Add(keys2, Multiply(i, 16))))
        i = Add(i, 1)
    }
    t7 = Stamp(clock)

    copies = Allocate(Multiply(n, 16))
    copy_sum = 0
    t16 = Stamp(clock)
    i = 0
    WhileLoop LessThan(i, n) {
        src = Add(keys, Multiply(i, 16))
        dst = Add(copies, Multiply(i, 16))
        MemoryCopy(dst, src, 8)
        copy_sum = Add(copy_sum, GetByte(dst, 0))
        i = Add(i, 1)
    }
    t17 = Stamp(clock)

    kb_table = Hash.Create(16)
    kb_sum = 0
    t18 = Stamp(clock)
    i = 0
    WhileLoop LessThan(i, n) {
        cell = Hash.KeyBytes(kb_table, Add(keys, Multiply(i, 16)), 8)
        kb_sum = Add(kb_sum, GetByte(cell, 0))
        i = Add(i, 1)
    }
    t19 = Stamp(clock)

    ord = Array.Create(8)
    t20 = Stamp(clock)
    i = 0
    WhileLoop LessThan(i, n) {
        Hash.OrderPush(ord, Add(keys, Multiply(i, 16)))
        i = Add(i, 1)
    }
    t21 = Stamp(clock)
    ord_n = Array.Size(ord)

    table = Hash.Create(16)
    set_sum = 0
    t8 = Stamp(clock)
    i = 0
    WhileLoop LessThan(i, n) {
        set_sum = Add(set_sum, Hash.Set(table, Add(keys, Multiply(i, 16)), Add(i, 1)))
        i = Add(i, 1)
    }
    t9 = Stamp(clock)

    get_sum = 0
    t10 = Stamp(clock)
    i = 0
    WhileLoop LessThan(i, n) {
        get_sum = Add(get_sum, Hash.Get(table, Add(keys, Multiply(i, 16))))
        i = Add(i, 1)
    }
    t11 = Stamp(clock)

    upd_sum = 0
    t12 = Stamp(clock)
    i = 0
    WhileLoop LessThan(i, n) {
        upd_sum = Add(upd_sum, Hash.Set(table, Add(keys, Multiply(i, 16)), Add(i, 2)))
        i = Add(i, 1)
    }
    t13 = Stamp(clock)

    upd_get = 0
    i = 0
    WhileLoop LessThan(i, n) {
        upd_get = Add(upd_get, Hash.Get(table, Add(keys, Multiply(i, 16))))
        i = Add(i, 1)
    }

    table2 = Hash.Create(16)
    one = Allocate(16)
    off_sum = 0
    t14 = Stamp(clock)
    i = 0
    WhileLoop LessThan(i, n) {
        WriteKey(one, i)
        Hash.Set(table2, one, Add(i, 1))
        i = Add(i, 1)
    }
    i = 0
    WhileLoop LessThan(i, n) {
        WriteKey(one, i)
        off_sum = Add(off_sum, Hash.Get(table2, one))
        i = Add(i, 1)
    }
    t15 = Stamp(clock)

    expect = Divide(Multiply(n, Add(n, 1)), 2)
    IfCondition NotEqual(len_sum, 320000) ThenBlock: {
        fails = Add(fails, 1)
    }
    IfCondition NotEqual(cmp_sum, 0) ThenBlock: {
        fails = Add(fails, 1)
    }
    IfCondition NotEqual(set_sum, n) ThenBlock: {
        fails = Add(fails, 1)
    }
    IfCondition NotEqual(get_sum, expect) ThenBlock: {
        fails = Add(fails, 1)
    }
    IfCondition NotEqual(upd_sum, 0) ThenBlock: {
        fails = Add(fails, 1)
    }
    IfCondition NotEqual(upd_get, Add(expect, n)) ThenBlock: {
        fails = Add(fails, 1)
    }
    IfCondition NotEqual(off_sum, expect) ThenBlock: {
        fails = Add(fails, 1)
    }
    IfCondition NotEqual(Hash.Size(table), n) ThenBlock: {
        fails = Add(fails, 1)
    }
    IfCondition NotEqual(copy_sum, 2140000) ThenBlock: {
        fails = Add(fails, 1)
    }
    IfCondition NotEqual(kb_sum, 2140000) ThenBlock: {
        fails = Add(fails, 1)
    }
    IfCondition NotEqual(ord_n, n) ThenBlock: {
        fails = Add(fails, 1)
    }

    PrintMessage("CHECK phases fails ")
    PrintNumber(fails)
    PrintMessage(" crc ")
    PrintNumber(crc_sum)
    PrintMessage(" len ")
    PrintNumber(len_sum)
    PrintMessage(" cmp ")
    PrintNumber(cmp_sum)
    PrintMessage(" set ")
    PrintNumber(set_sum)
    PrintMessage(" get ")
    PrintNumber(get_sum)
    PrintMessage(" upd ")
    PrintNumber(upd_sum)
    PrintMessage(" official ")
    PrintNumber(off_sum)
    PrintMessage("\n")
    PrintMessage("TIME write2 ns ")
    PrintNumber(Subtract(t1, t0))
    PrintMessage("\n")
    PrintMessage("TIME crc2 ns ")
    PrintNumber(Subtract(t3, t2))
    PrintMessage("\n")
    PrintMessage("TIME len2 ns ")
    PrintNumber(Subtract(t5, t4))
    PrintMessage("\n")
    PrintMessage("TIME cmp2 ns ")
    PrintNumber(Subtract(t7, t6))
    PrintMessage("\n")
    PrintMessage("TIME copy8 ns ")
    PrintNumber(Subtract(t17, t16))
    PrintMessage("\n")
    PrintMessage("TIME keybytes ns ")
    PrintNumber(Subtract(t19, t18))
    PrintMessage("\n")
    PrintMessage("TIME order ns ")
    PrintNumber(Subtract(t21, t20))
    PrintMessage("\n")
    PrintMessage("TIME set ns ")
    PrintNumber(Subtract(t9, t8))
    PrintMessage("\n")
    PrintMessage("TIME get ns ")
    PrintNumber(Subtract(t11, t10))
    PrintMessage("\n")
    PrintMessage("TIME update ns ")
    PrintNumber(Subtract(t13, t12))
    PrintMessage("\n")
    PrintMessage("TIME official ns ")
    PrintNumber(Subtract(t15, t14))
    PrintMessage("\n")

    IfCondition EqualTo(fails, 0) ThenBlock: {
        ProcessExit(0)
    }
    ProcessExit(1)
}

RunTask(Main)
