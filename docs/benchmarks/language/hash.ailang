// Library.Hash open-address map. Keys are "k" plus 7 digits.
// Stored values are i+1 so a missing Get (0) is distinct.
// The C twin is a flat open-address table with the SSE4.2 CRC32 instruction.

LibraryImport.Arena
LibraryImport.Hash

Function.Stamp {
    Input: buf: Integer
    Output: Integer
    Body: {
        dummy = SystemCall(228, 1, buf)
        sec = Dereference(buf)
        nsec = Dereference(Add(buf, 8))
        ns = Add(Multiply(sec, 1000000000), nsec)
        ReturnValue(ns)
    }
}

Function.WriteKey {
    Input: buf: Address
    Input: i: Integer
    Body: {
        n = i
        p = 7
        SetByte(buf, 0, 107)
        WhileLoop GreaterThan(p, 0) {
            dig = Modulo(n, 10)
            ch = Add(48, dig)
            SetByte(buf, p, ch)
            n = Divide(n, 10)
            p = Subtract(p, 1)
        }
        SetByte(buf, 8, 0)
    }
}

SubRoutine.Main {
    Arena_Init()
    clock = Allocate(16)
    n = 20000
    fails = 0
    key = Allocate(16)
    table = Hash.Create(16)

    t0 = Stamp(clock)
    i = 0
    WhileLoop LessThan(i, n) {
        WriteKey(key, i)
        v = Add(i, 1)
        Hash.Set(table, key, v)
        i = Add(i, 1)
    }
    sum = 0
    i = 0
    WhileLoop LessThan(i, n) {
        WriteKey(key, i)
        v = Hash.Get(table, key)
        sum = Add(sum, v)
        i = Add(i, 1)
    }
    t1 = Stamp(clock)

    sz = Hash.Size(table)
    IfCondition NotEqual(sz, n) ThenBlock: {
        fails = Add(fails, 1)
    }
    expect = Divide(Multiply(n, Add(n, 1)), 2)
    IfCondition NotEqual(sum, expect) ThenBlock: {
        fails = Add(fails, 1)
    }

    WriteKey(key, 3)
    gone = Hash.Delete(table, key)
    IfCondition NotEqual(gone, 1) ThenBlock: {
        fails = Add(fails, 1)
    }
    has = Hash.Contains(table, key)
    IfCondition NotEqual(has, 0) ThenBlock: {
        fails = Add(fails, 1)
    }
    v = Hash.Get(table, key)
    IfCondition NotEqual(v, 0) ThenBlock: {
        fails = Add(fails, 1)
    }
    sz = Hash.Size(table)
    left = Subtract(n, 1)
    IfCondition NotEqual(sz, left) ThenBlock: {
        fails = Add(fails, 1)
    }
    put = Hash.Set(table, key, 99)
    IfCondition NotEqual(put, 1) ThenBlock: {
        fails = Add(fails, 1)
    }
    v = Hash.Get(table, key)
    IfCondition NotEqual(v, 99) ThenBlock: {
        fails = Add(fails, 1)
    }
    put = Hash.Set(table, key, 4)
    IfCondition NotEqual(put, 0) ThenBlock: {
        fails = Add(fails, 1)
    }
    v = Hash.Get(table, key)
    IfCondition NotEqual(v, 4) ThenBlock: {
        fails = Add(fails, 1)
    }

    miss = "no-such"
    has = Hash.Contains(table, miss)
    IfCondition NotEqual(has, 0) ThenBlock: {
        fails = Add(fails, 1)
    }

    PrintMessage("CHECK hash fails ")
    PrintNumber(fails)
    PrintMessage(" sum ")
    PrintNumber(sum)
    PrintMessage("\n")
    PrintMessage("TIME hash build ns ")
    PrintNumber(Subtract(t1, t0))
    PrintMessage("\n")

    IfCondition EqualTo(fails, 0) ThenBlock: {
        ProcessExit(0)
    }
    ProcessExit(1)
}

RunTask(Main)
