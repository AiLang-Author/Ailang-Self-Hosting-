// MemoryCopy, MemorySet, MemCompare, MemChr.
// The compiler claims MemoryCopy and MemorySet in CompileMem before the SSE2
// emitter, so those two are REP MOVSB and REP STOSB. MemCompare and MemChr
// are the SSE2 keyword. Copy returns the dest pointer. That address moves
// with each run, so the check compares it to dst and the copy timer adds
// the byte count. Set returns the byte.
// Non-overlapping only. MemCompare returns 0 or 1, not a signed memcmp delta.
// The C twin uses glibc plus a hand-written SSE2 copy.

LibraryImport.Arena

Function.Stamp {
    Input: buf: Integer
    Output: Integer
    Body: {
        dummy = SystemCall(228, 1, buf)
        sec = Dereference(buf)
        nsec = Dereference(Add(buf, 8))
        ns = Add(Multiply(sec, 1000000000), nsec)
        ReturnValue(ns)
    }
}

Function.FillPat {
    Input: buf: Address
    Input: n: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, n) {
            b = BitwiseAnd(i, 255)
            SetByte(buf, i, b)
            i = Add(i, 1)
        }
    }
}

Function.CheckCopy {
    Input: src: Address
    Input: dst: Address
    Input: n: Integer
    Output: Integer
    Body: {
        fails = 0
        MemorySet(dst, 255, n)
        FillPat(src, n)
        MemoryCopy(dst, src, n)
        i = 0
        WhileLoop LessThan(i, n) {
            b = GetByte(dst, i)
            e = BitwiseAnd(i, 255)
            IfCondition NotEqual(b, e) ThenBlock: {
                fails = Add(fails, 1)
            }
            i = Add(i, 1)
        }
        ReturnValue(fails)
    }
}

Function.CheckSet {
    Input: dst: Address
    Input: n: Integer
    Input: val: Integer
    Output: Integer
    Body: {
        fails = 0
        MemorySet(dst, val, n)
        i = 0
        WhileLoop LessThan(i, n) {
            b = GetByte(dst, i)
            IfCondition NotEqual(b, val) ThenBlock: {
                fails = Add(fails, 1)
            }
            i = Add(i, 1)
        }
        ReturnValue(fails)
    }
}

SubRoutine.Main {
    Arena_Init()
    clock = Allocate(16)
    src = Allocate(1100000)
    dst = Allocate(1100000)
    fails = 0

    f = CheckCopy(src, dst, 0)
    fails = Add(fails, f)
    f = CheckCopy(src, dst, 1)
    fails = Add(fails, f)
    f = CheckCopy(src, dst, 7)
    fails = Add(fails, f)
    f = CheckCopy(src, dst, 15)
    fails = Add(fails, f)
    f = CheckCopy(src, dst, 16)
    fails = Add(fails, f)
    f = CheckCopy(src, dst, 17)
    fails = Add(fails, f)
    f = CheckCopy(src, dst, 31)
    fails = Add(fails, f)
    f = CheckCopy(src, dst, 32)
    fails = Add(fails, f)
    f = CheckCopy(src, dst, 63)
    fails = Add(fails, f)
    f = CheckCopy(src, dst, 64)
    fails = Add(fails, f)
    f = CheckCopy(src, dst, 127)
    fails = Add(fails, f)
    f = CheckCopy(src, dst, 128)
    fails = Add(fails, f)
    f = CheckCopy(src, dst, 255)
    fails = Add(fails, f)
    f = CheckCopy(src, dst, 256)
    fails = Add(fails, f)
    f = CheckCopy(src, dst, 1000)
    fails = Add(fails, f)
    f = CheckCopy(src, dst, 4096)
    fails = Add(fails, f)
    f = CheckCopy(src, dst, 65536)
    fails = Add(fails, f)
    f = CheckCopy(src, dst, 1048576)
    fails = Add(fails, f)

    src_u = Add(src, 7)
    dst_u = Add(dst, 1)
    f = CheckCopy(src_u, dst_u, 100)
    fails = Add(fails, f)
    src_u = Add(src, 1)
    dst_u = Add(dst, 8)
    f = CheckCopy(src_u, dst_u, 4096)
    fails = Add(fails, f)

    f = CheckSet(dst, 0, 165)
    fails = Add(fails, f)
    f = CheckSet(dst, 1, 165)
    fails = Add(fails, f)
    f = CheckSet(dst, 17, 165)
    fails = Add(fails, f)
    f = CheckSet(dst, 64, 165)
    fails = Add(fails, f)
    f = CheckSet(dst, 1000, 90)
    fails = Add(fails, f)

    FillPat(src, 1000)
    MemoryCopy(dst, src, 1000)
    cmp = MemCompare(src, dst, 1000)
    IfCondition NotEqual(cmp, 0) ThenBlock: {
        fails = Add(fails, 1)
    }
    cmp = MemCompare(src, dst, 0)
    IfCondition NotEqual(cmp, 0) ThenBlock: {
        fails = Add(fails, 1)
    }
    SetByte(dst, 999, 1)
    cmp = MemCompare(src, dst, 1000)
    IfCondition NotEqual(cmp, 1) ThenBlock: {
        fails = Add(fails, 1)
    }
    SetByte(dst, 999, 231)
    SetByte(dst, 0, 9)
    cmp = MemCompare(src, dst, 1000)
    IfCondition NotEqual(cmp, 1) ThenBlock: {
        fails = Add(fails, 1)
    }

    MemorySet(src, 0, 200)
    SetByte(src, 0, 90)
    SetByte(src, 15, 90)
    SetByte(src, 16, 90)
    SetByte(src, 100, 90)
    at = MemChr(src, 90, 200)
    IfCondition NotEqual(at, 0) ThenBlock: {
        fails = Add(fails, 1)
    }
    at = MemChr(Add(src, 1), 90, 199)
    IfCondition NotEqual(at, 14) ThenBlock: {
        fails = Add(fails, 1)
    }
    at = MemChr(src, 91, 200)
    IfCondition NotEqual(at, -1) ThenBlock: {
        fails = Add(fails, 1)
    }

    got = MemoryCopy(dst, src, 0)
    IfCondition NotEqual(got, dst) ThenBlock: {
        fails = Add(fails, 1)
    }
    got = MemoryCopy(dst, src, 1)
    copy1 = 0
    IfCondition EqualTo(got, dst) ThenBlock: {
        copy1 = 1
    } ElseBlock: {
        fails = Add(fails, 1)
    }
    got = MemoryCopy(dst, src, 7)
    IfCondition NotEqual(got, dst) ThenBlock: {
        fails = Add(fails, 1)
    }
    got = MemoryCopy(dst, src, 8)
    IfCondition NotEqual(got, dst) ThenBlock: {
        fails = Add(fails, 1)
    }
    got = MemoryCopy(dst, src, 15)
    IfCondition NotEqual(got, dst) ThenBlock: {
        fails = Add(fails, 1)
    }
    got = MemoryCopy(dst, src, 64)
    IfCondition NotEqual(got, dst) ThenBlock: {
        fails = Add(fails, 1)
    }
    got = MemoryCopy(Add(dst, 1), Add(src, 7), 100)
    IfCondition NotEqual(got, Add(dst, 1)) ThenBlock: {
        fails = Add(fails, 1)
    }
    got = MemoryCopy(dst, src, 1048576)
    IfCondition NotEqual(got, dst) ThenBlock: {
        fails = Add(fails, 1)
    }
    PrintMessage("CHECK memcopy fails ")
    PrintNumber(fails)
    PrintMessage(" copy1 ")
    PrintNumber(copy1)
    got = MemorySet(dst, 165, 16)
    PrintMessage(" set16 ")
    PrintNumber(got)
    PrintMessage("\n")

    bytes = 1048576
    FillPat(src, bytes)
    reps = 200
    acc = 0
    t0 = Stamp(clock)
    rep = 0
    WhileLoop LessThan(rep, reps) {
        nret = MemoryCopy(dst, src, bytes)
        IfCondition NotEqual(nret, dst) ThenBlock: {
            fails = Add(fails, 1)
        }
        acc = Add(acc, bytes)
        rep = Add(rep, 1)
    }
    t1 = Stamp(clock)
    PrintMessage("TIME memcopy copy ns ")
    PrintNumber(Subtract(t1, t0))
    PrintMessage(" acc ")
    PrintNumber(acc)
    PrintMessage("\n")

    acc = 0
    t0 = Stamp(clock)
    rep = 0
    WhileLoop LessThan(rep, reps) {
        nret = MemorySet(dst, 165, bytes)
        acc = Add(acc, nret)
        rep = Add(rep, 1)
    }
    t1 = Stamp(clock)
    PrintMessage("TIME memcopy set ns ")
    PrintNumber(Subtract(t1, t0))
    PrintMessage(" acc ")
    PrintNumber(acc)
    PrintMessage("\n")

    MemoryCopy(dst, src, bytes)
    acc = 0
    t0 = Stamp(clock)
    rep = 0
    WhileLoop LessThan(rep, reps) {
        nret = MemCompare(src, dst, bytes)
        acc = Add(acc, nret)
        rep = Add(rep, 1)
    }
    t1 = Stamp(clock)
    PrintMessage("TIME memcopy cmp ns ")
    PrintNumber(Subtract(t1, t0))
    PrintMessage(" acc ")
    PrintNumber(acc)
    PrintMessage("\n")

    SetByte(src, 1048575, 90)
    acc = 0
    t0 = Stamp(clock)
    rep = 0
    WhileLoop LessThan(rep, reps) {
        nret = MemChr(src, 90, bytes)
        acc = Add(acc, nret)
        rep = Add(rep, 1)
    }
    t1 = Stamp(clock)
    PrintMessage("TIME memcopy chr ns ")
    PrintNumber(Subtract(t1, t0))
    PrintMessage(" acc ")
    PrintNumber(acc)
    PrintMessage("\n")

    IfCondition EqualTo(fails, 0) ThenBlock: {
        ProcessExit(0)
    }
    ProcessExit(1)
}

RunTask(Main)
