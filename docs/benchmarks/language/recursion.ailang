// Naive Fib and a non-tail stack chain.
// fib(35) is 9227465. Depth(8192) sums to 33558528.
// The C twin is compiled without sibling-call optimization.

LibraryImport.Arena

Function.Stamp {
    Input: buf: Integer
    Output: Integer
    Body: {
        dummy = SystemCall(228, 1, buf)
        sec = Dereference(buf)
        nsec = Dereference(Add(buf, 8))
        ns = Add(Multiply(sec, 1000000000), nsec)
        ReturnValue(ns)
    }
}

Function.Fib {
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(n, 2) ThenBlock: {
            ReturnValue(n)
        }
        n1 = Subtract(n, 1)
        n2 = Subtract(n, 2)
        a = Fib(n1)
        b = Fib(n2)
        ReturnValue(Add(a, b))
    }
}

Function.Depth {
    Input: n: Integer
    Output: Integer
    Body: {
        here = n
        IfCondition LessEqual(n, 0) ThenBlock: {
            ReturnValue(here)
        }
        nm1 = Subtract(n, 1)
        below = Depth(nm1)
        ReturnValue(Add(here, below))
    }
}

SubRoutine.Main {
    Arena_Init()
    clock = Allocate(16)
    fails = 0

    f = Fib(0)
    IfCondition NotEqual(f, 0) ThenBlock: { fails = Add(fails, 1) }
    f = Fib(1)
    IfCondition NotEqual(f, 1) ThenBlock: { fails = Add(fails, 1) }
    f = Fib(10)
    IfCondition NotEqual(f, 55) ThenBlock: { fails = Add(fails, 1) }
    f = Fib(20)
    IfCondition NotEqual(f, 6765) ThenBlock: { fails = Add(fails, 1) }

    d = Depth(1)
    IfCondition NotEqual(d, 1) ThenBlock: { fails = Add(fails, 1) }
    d = Depth(100)
    IfCondition NotEqual(d, 5050) ThenBlock: { fails = Add(fails, 1) }

    t0 = Stamp(clock)
    deep = Depth(8192)
    t1 = Stamp(clock)
    IfCondition NotEqual(deep, 33558528) ThenBlock: {
        fails = Add(fails, 1)
    }

    t2 = Stamp(clock)
    fib35 = Fib(35)
    t3 = Stamp(clock)
    IfCondition NotEqual(fib35, 9227465) ThenBlock: {
        fails = Add(fails, 1)
    }

    PrintMessage("CHECK recursion fails ")
    PrintNumber(fails)
    PrintMessage(" fib35 ")
    PrintNumber(fib35)
    PrintMessage(" depth ")
    PrintNumber(deep)
    PrintMessage("\n")
    PrintMessage("TIME recursion depth ns ")
    PrintNumber(Subtract(t1, t0))
    PrintMessage("\n")
    PrintMessage("TIME recursion fib35 ns ")
    PrintNumber(Subtract(t3, t2))
    PrintMessage("\n")

    IfCondition EqualTo(fails, 0) ThenBlock: {
        ProcessExit(0)
    }
    ProcessExit(1)
}

RunTask(Main)
