// StringLength, StringCompare, StringStartsWith, StringEndsWith, StringToInt.
// StringIndexOf is the compiler character search (first byte of the needle).
// The StringUtils substring function of the same name is not what a call reaches.
// An empty needle searches for the terminator and returns the string length.
// The C twin times glibc strchr for that search, plus strstr as a separate row.

LibraryImport.Arena
LibraryImport.StringUtils

Function.Stamp {
    Input: buf: Integer
    Output: Integer
    Body: {
        dummy = SystemCall(228, 1, buf)
        sec = Dereference(buf)
        nsec = Dereference(Add(buf, 8))
        ns = Add(Multiply(sec, 1000000000), nsec)
        ReturnValue(ns)
    }
}

SubRoutine.Main {
    Arena_Init()
    clock = Allocate(16)
    fails = 0
    n = 262144
    h = Allocate(Add(n, 1))
    other = Allocate(Add(n, 1))

    len = StringLength("foobar")
    IfCondition NotEqual(len, 6) ThenBlock: {
        fails = Add(fails, 1)
    }
    cmp = StringCompare("abc", "abc")
    IfCondition NotEqual(cmp, 0) ThenBlock: {
        fails = Add(fails, 1)
    }
    cmp = StringCompare("abc", "abd")
    IfCondition EqualTo(cmp, 0) ThenBlock: {
        fails = Add(fails, 1)
    }
    sw = StringStartsWith("foobar", "foo")
    IfCondition NotEqual(sw, 1) ThenBlock: {
        fails = Add(fails, 1)
    }
    sw = StringStartsWith("foobar", "bar")
    IfCondition NotEqual(sw, 0) ThenBlock: {
        fails = Add(fails, 1)
    }
    ew = StringEndsWith("foobar", "bar")
    IfCondition NotEqual(ew, 1) ThenBlock: {
        fails = Add(fails, 1)
    }
    ew = StringEndsWith("foobar", "foo")
    IfCondition NotEqual(ew, 0) ThenBlock: {
        fails = Add(fails, 1)
    }
    at = StringIndexOf("abracadabra", "cad")
    IfCondition NotEqual(at, 4) ThenBlock: {
        fails = Add(fails, 1)
    }
    at = StringIndexOf("abracadabra", "")
    IfCondition NotEqual(at, 11) ThenBlock: {
        fails = Add(fails, 1)
    }
    at = StringIndexOf("abXabc", "abc")
    IfCondition NotEqual(at, 0) ThenBlock: {
        fails = Add(fails, 1)
    }
    at = StringIndexOf("abracadabra", "zzz")
    IfCondition NotEqual(at, -1) ThenBlock: {
        fails = Add(fails, 1)
    }
    num = StringToInt("2048x")
    IfCondition NotEqual(num, 2048) ThenBlock: {
        fails = Add(fails, 1)
    }

    i = 0
    WhileLoop LessThan(i, n) {
        SetByte(h, i, 97)
        SetByte(other, i, 97)
        i = Add(i, 1)
    }
    SetByte(h, n, 0)
    SetByte(other, n, 0)
    pos = 262139
    SetByte(h, pos, 120)
    SetByte(h, Add(pos, 1), 121)
    SetByte(h, Add(pos, 2), 122)
    SetByte(h, Add(pos, 3), 122)
    SetByte(h, Add(pos, 4), 121)

    len = StringLength(h)
    IfCondition NotEqual(len, n) ThenBlock: {
        fails = Add(fails, 1)
    }
    needle = "xyzzy"
    at = StringIndexOf(h, needle)
    IfCondition NotEqual(at, pos) ThenBlock: {
        fails = Add(fails, 1)
    }
    at = StringIndexOf(h, "qqq")
    IfCondition NotEqual(at, -1) ThenBlock: {
        fails = Add(fails, 1)
    }
    sw = StringStartsWith(h, "aaa")
    IfCondition NotEqual(sw, 1) ThenBlock: {
        fails = Add(fails, 1)
    }
    ew = StringEndsWith(h, needle)
    IfCondition NotEqual(ew, 1) ThenBlock: {
        fails = Add(fails, 1)
    }
    cmp = StringCompare(other, other)
    IfCondition NotEqual(cmp, 0) ThenBlock: {
        fails = Add(fails, 1)
    }
    SetByte(other, 262143, 98)
    cmp = StringCompare(h, other)
    IfCondition EqualTo(cmp, 0) ThenBlock: {
        fails = Add(fails, 1)
    }

    PrintMessage("CHECK strings fails ")
    PrintNumber(fails)
    PrintMessage(" at ")
    PrintNumber(pos)
    PrintMessage("\n")

    reps = 40
    acc = 0
    t0 = Stamp(clock)
    rep = 0
    WhileLoop LessThan(rep, reps) {
        hit = StringIndexOf(h, needle)
        acc = Add(acc, hit)
        rep = Add(rep, 1)
    }
    t1 = Stamp(clock)
    PrintMessage("TIME strings index ns ")
    PrintNumber(Subtract(t1, t0))
    PrintMessage(" acc ")
    PrintNumber(acc)
    PrintMessage("\n")

    acc = 0
    t0 = Stamp(clock)
    rep = 0
    WhileLoop LessThan(rep, reps) {
        hit = StringLength(h)
        acc = Add(acc, hit)
        rep = Add(rep, 1)
    }
    t1 = Stamp(clock)
    PrintMessage("TIME strings length ns ")
    PrintNumber(Subtract(t1, t0))
    PrintMessage(" acc ")
    PrintNumber(acc)
    PrintMessage("\n")

    SetByte(other, 262143, 97)
    acc = 0
    t0 = Stamp(clock)
    rep = 0
    WhileLoop LessThan(rep, reps) {
        hit = StringCompare(h, other)
        acc = Add(acc, hit)
        rep = Add(rep, 1)
    }
    t1 = Stamp(clock)
    PrintMessage("TIME strings compare ns ")
    PrintNumber(Subtract(t1, t0))
    PrintMessage(" acc ")
    PrintNumber(acc)
    PrintMessage("\n")

    IfCondition EqualTo(fails, 0) ThenBlock: {
        ProcessExit(0)
    }
    ProcessExit(1)
}

RunTask(Main)
