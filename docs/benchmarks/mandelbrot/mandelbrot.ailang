// Interior pixels of a 400x400 Mandelbrot, 50 iterations.
// The C twin uses the same map and the same bailout. Expected count
// is whatever both sides print; they must match.

LibraryImport.Arena

Function.Stamp {
    Input: buf: Integer
    Output: Integer
    Body: {
        dummy = SystemCall(228, 1, buf)
        sec = Dereference(buf)
        nsec = Dereference(Add(buf, 8))
        ns = Add(Multiply(sec, 1000000000), nsec)
        ReturnValue(ns)
    }
}

Function.CountInside {
    Input: h: Integer
    Output: Integer
    Body: {
        two = Float_FromInt(2)
        three = Float_FromInt(3)
        four = Float_FromInt(4)
        half = Float_Div(Float_FromInt(1), two)
        hf = Float_FromInt(h)
        scale2 = Float_Div(two, hf)
        scale3 = Float_Div(three, hf)
        half_i = Divide(h, 2)
        n = 0
        y = 0
        WhileLoop LessThan(y, h) {
            ci = Float_Mul(Float_FromInt(Subtract(y, half_i)), scale2)
            x = 0
            WhileLoop LessThan(x, h) {
                cr = Float_Sub(Float_Mul(Float_FromInt(Subtract(x, half_i)), scale3), half)
                zr = Float_FromInt(0)
                zi = Float_FromInt(0)
                inside = 1
                i = 0
                WhileLoop LessThan(i, 50) {
                    zr2 = Float_Mul(zr, zr)
                    zi2 = Float_Mul(zi, zi)
                    mag = Float_Add(zr2, zi2)
                    IfCondition Float_Lt(four, mag) ThenBlock: {
                        inside = 0
                        i = 50
                    } ElseBlock: {
                        zi = Float_Add(Float_Mul(two, Float_Mul(zr, zi)), ci)
                        zr = Float_Add(Float_Sub(zr2, zi2), cr)
                        i = Add(i, 1)
                    }
                }
                n = Add(n, inside)
                x = Add(x, 1)
            }
            y = Add(y, 1)
        }
        ReturnValue(n)
    }
}

SubRoutine.Main {
    Arena_Init()
    clock = Allocate(16)
    t0 = Stamp(clock)
    n = CountInside(400)
    t1 = Stamp(clock)
    PrintMessage("MANDEL inside ")
    PrintNumber(n)
    PrintMessage(" ns ")
    PrintNumber(Subtract(t1, t0))
    PrintMessage("\n")
    ProcessExit(0)
}

RunTask(Main)
