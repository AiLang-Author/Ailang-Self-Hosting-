// 64x64 f64 matmul, 2x2 register tile, row-major.
// C[i][j] += A[i][k] * B[k][j], two rows by two columns per inner trip.
// Entries are small integers, so a contracted fma and a separate mul/add
// produce the same f64 bits. The address math stays in the inner loop.

LibraryImport.Arena

FixedPool.Mat {
    "a": Initialize=0, CanChange=True
    "b": Initialize=0, CanChange=True
    "c": Initialize=0, CanChange=True
}

Function.Stamp {
    Input: buf: Integer
    Output: Integer
    Body: {
        dummy = SystemCall(228, 1, buf)
        sec = Dereference(buf)
        nsec = Dereference(Add(buf, 8))
        ns = Add(Multiply(sec, 1000000000), nsec)
        ReturnValue(ns)
    }
}

Function.Fill {
    Input: ma: Integer
    Input: mb: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, 64) {
            j = 0
            WhileLoop LessThan(j, 64) {
                av = Float_FromInt(Add(Add(i, j), 1))
                bv = Float_FromInt(Add(Subtract(Multiply(i, 3), j), 64))
                slot = Add(Multiply(i, 64), j)
                off = Multiply(slot, 8)
                StoreValue(Add(ma, off), av)
                StoreValue(Add(mb, off), bv)
                j = Add(j, 1)
            }
            i = Add(i, 1)
        }
    }
}

Function.TileMul {
    Input: ma: Integer
    Input: mb: Integer
    Input: mc: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, 64) {
            j = 0
            WhileLoop LessThan(j, 64) {
                s00 = 0
                s01 = 0
                s10 = 0
                s11 = 0
                k = 0
                WhileLoop LessThan(k, 64) {
                    ak = Add(Multiply(i, 64), k)
                    a0 = Dereference(Add(ma, Multiply(ak, 8)))
                    ak1 = Add(Multiply(Add(i, 1), 64), k)
                    a1 = Dereference(Add(ma, Multiply(ak1, 8)))
                    bk = Add(Multiply(k, 64), j)
                    b0 = Dereference(Add(mb, Multiply(bk, 8)))
                    bk1 = Add(bk, 1)
                    b1 = Dereference(Add(mb, Multiply(bk1, 8)))
                    s00 = Float_Add(s00, Float_Mul(a0, b0))
                    s01 = Float_Add(s01, Float_Mul(a0, b1))
                    s10 = Float_Add(s10, Float_Mul(a1, b0))
                    s11 = Float_Add(s11, Float_Mul(a1, b1))
                    k = Add(k, 1)
                }
                cj = Add(Multiply(i, 64), j)
                StoreValue(Add(mc, Multiply(cj, 8)), s00)
                StoreValue(Add(mc, Multiply(Add(cj, 1), 8)), s01)
                cj1 = Add(Multiply(Add(i, 1), 64), j)
                StoreValue(Add(mc, Multiply(cj1, 8)), s10)
                StoreValue(Add(mc, Multiply(Add(cj1, 1), 8)), s11)
                j = Add(j, 2)
            }
            i = Add(i, 2)
        }
    }
}

Function.Digest {
    Input: mc: Integer
    Body: {
        sum = 0
        mix = 0
        n = 0
        last = Multiply(64, 64)
        WhileLoop LessThan(n, last) {
            bits = Dereference(Add(mc, Multiply(n, 8)))
            sum = Float_Add(sum, bits)
            mix = BitwiseXor(mix, bits)
            n = Add(n, 1)
        }
        PrintMessage("ROW 64 bits ")
        PrintNumber(sum)
        PrintMessage(" mix ")
        PrintNumber(mix)
    }
}

SubRoutine.Main {
    bytes = Multiply(Multiply(64, 64), 8)
    Mat.a = Allocate(bytes)
    Mat.b = Allocate(bytes)
    Mat.c = Allocate(bytes)
    clock = Allocate(16)
    Fill(Mat.a, Mat.b)
    t0 = Stamp(clock)
    rep = 0
    WhileLoop LessThan(rep, 2000) {
        TileMul(Mat.a, Mat.b, Mat.c)
        rep = Add(rep, 1)
    }
    t1 = Stamp(clock)
    Digest(Mat.c)
    PrintMessage(" ns ")
    PrintNumber(Subtract(t1, t0))
    PrintMessage("\n")
    ProcessExit(0)
}

RunTask(Main)
