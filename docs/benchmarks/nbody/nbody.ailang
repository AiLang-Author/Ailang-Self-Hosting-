// Five-body solar system, same layout as nbody.cpp: seven f64 fields
// packed at stride 56. Products are separate assignments. A one-use
// multiply stays out of an add or a subtract, so both energies match
// C++. The clock wraps only Advance.

LibraryImport.Arena

Function.Stamp {
    Input: buf: Integer
    Output: Integer
    Body: {
        dummy = SystemCall(228, 1, buf)
        sec = Dereference(buf)
        nsec = Dereference(Add(buf, 8))
        ns = Add(Multiply(sec, 1000000000), nsec)
        ReturnValue(ns)
    }
}

Function.StorePos {
    Input: p: Integer
    Input: x: Integer
    Input: y: Integer
    Input: z: Integer
    Body: {
        StoreValue(p, x)
        StoreValue(Add(p, 8), y)
        StoreValue(Add(p, 16), z)
    }
}

Function.StoreVel {
    Input: p: Integer
    Input: vx: Integer
    Input: vy: Integer
    Input: vz: Integer
    Input: m: Integer
    Body: {
        StoreValue(Add(p, 24), vx)
        StoreValue(Add(p, 32), vy)
        StoreValue(Add(p, 40), vz)
        StoreValue(Add(p, 48), m)
    }
}

// Positions are the published literals. Velocities are already scaled
// by 365.24 and masses by 4*pi*pi. Sun velocity is filled by Offset.
Function.Init {
    Input: base: Integer
    Body: {
        p = base
        StorePos(p, 0, 0, 0)
        StoreVel(p, 0, 0, 0, 4630752910647379422)
        p = Add(base, 56)
        StorePos(p, 4617136985637443884, -4615467600764216452, -4631240860977730576)
        StoreVel(p, 4603636522180398268, 4613514450253485211, -4640446117579192555, 4585593052079010776)
        p = Add(base, 112)
        StorePos(p, 4620886515960171111, 4616330128746480048, -4622431185293064580)
        StoreVel(p, -4616141094713322430, 4610900871547424531, 4576004977915405236, 4577659745833829943)
        p = Add(base, 168)
        StorePos(p, 4623448502799161807, -4598675596822288770, -4626158513131520608)
        StoreVel(p, 4607555276345777135, 4605999890795117509, -4645973824767902084, 4565592097032511155)
        p = Add(base, 224)
        StorePos(p, 4624847617829197610, -4595383180696444384, 4595626498235032896)
        StoreVel(p, 4606994084859067466, 4603531791922690979, -4638202354754755082, 4566835785178257836)
    }
}

Function.Offset {
    Input: base: Integer
    Body: {
        px = 0
        py = 0
        pz = 0
        i = 0
        WhileLoop LessThan(i, 5) {
            bi = Add(base, Multiply(i, 56))
            m = Dereference(Add(bi, 48))
            vx = Dereference(Add(bi, 24))
            vy = Dereference(Add(bi, 32))
            vz = Dereference(Add(bi, 40))
            mx = Float_Mul(m, vx)
            my = Float_Mul(m, vy)
            mz = Float_Mul(m, vz)
            px = Float_Add(px, mx)
            py = Float_Add(py, my)
            pz = Float_Add(pz, mz)
            i = Add(i, 1)
        }
        solar = Dereference(Add(base, 48))
        px = Float_Div(Float_Neg(px), solar)
        py = Float_Div(Float_Neg(py), solar)
        pz = Float_Div(Float_Neg(pz), solar)
        StoreValue(Add(base, 24), px)
        StoreValue(Add(base, 32), py)
        StoreValue(Add(base, 40), pz)
    }
}

Function.Advance {
    Input: base: Integer
    Input: dt: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, 5) {
            j = Add(i, 1)
            WhileLoop LessThan(j, 5) {
                bi = Add(base, Multiply(i, 56))
                bj = Add(base, Multiply(j, 56))
                ix = Dereference(bi)
                iy = Dereference(Add(bi, 8))
                iz = Dereference(Add(bi, 16))
                ivx = Dereference(Add(bi, 24))
                ivy = Dereference(Add(bi, 32))
                ivz = Dereference(Add(bi, 40))
                im = Dereference(Add(bi, 48))
                jx = Dereference(bj)
                jy = Dereference(Add(bj, 8))
                jz = Dereference(Add(bj, 16))
                jvx = Dereference(Add(bj, 24))
                jvy = Dereference(Add(bj, 32))
                jvz = Dereference(Add(bj, 40))
                jm = Dereference(Add(bj, 48))
                dx = Float_Sub(ix, jx)
                dy = Float_Sub(iy, jy)
                dz = Float_Sub(iz, jz)
                dx2 = Float_Mul(dx, dx)
                dy2 = Float_Mul(dy, dy)
                dz2 = Float_Mul(dz, dz)
                dist2 = Float_Add(dx2, dy2)
                dist2 = Float_Add(dist2, dz2)
                dist = Float_Sqrt(dist2)
                dist3 = Float_Mul(dist2, dist)
                mag = Float_Div(dt, dist3)
                m2 = Float_Mul(jm, mag)
                m1 = Float_Mul(im, mag)
                dxm = Float_Mul(dx, m2)
                dym = Float_Mul(dy, m2)
                dzm = Float_Mul(dz, m2)
                ivx = Float_Sub(ivx, dxm)
                ivy = Float_Sub(ivy, dym)
                ivz = Float_Sub(ivz, dzm)
                dxm = Float_Mul(dx, m1)
                dym = Float_Mul(dy, m1)
                dzm = Float_Mul(dz, m1)
                jvx = Float_Add(jvx, dxm)
                jvy = Float_Add(jvy, dym)
                jvz = Float_Add(jvz, dzm)
                StoreValue(Add(bi, 24), ivx)
                StoreValue(Add(bi, 32), ivy)
                StoreValue(Add(bi, 40), ivz)
                StoreValue(Add(bj, 24), jvx)
                StoreValue(Add(bj, 32), jvy)
                StoreValue(Add(bj, 40), jvz)
                j = Add(j, 1)
            }
            i = Add(i, 1)
        }
        i = 0
        WhileLoop LessThan(i, 5) {
            bi = Add(base, Multiply(i, 56))
            ix = Dereference(bi)
            iy = Dereference(Add(bi, 8))
            iz = Dereference(Add(bi, 16))
            ivx = Dereference(Add(bi, 24))
            ivy = Dereference(Add(bi, 32))
            ivz = Dereference(Add(bi, 40))
            dtvx = Float_Mul(dt, ivx)
            dtvy = Float_Mul(dt, ivy)
            dtvz = Float_Mul(dt, ivz)
            ix = Float_Add(ix, dtvx)
            iy = Float_Add(iy, dtvy)
            iz = Float_Add(iz, dtvz)
            StoreValue(bi, ix)
            StoreValue(Add(bi, 8), iy)
            StoreValue(Add(bi, 16), iz)
            i = Add(i, 1)
        }
    }
}

Function.Energy {
    Input: base: Integer
    Output: Integer
    Body: {
        half = 4602678819172646912
        e = 0
        i = 0
        WhileLoop LessThan(i, 5) {
            bi = Add(base, Multiply(i, 56))
            ix = Dereference(bi)
            iy = Dereference(Add(bi, 8))
            iz = Dereference(Add(bi, 16))
            ivx = Dereference(Add(bi, 24))
            ivy = Dereference(Add(bi, 32))
            ivz = Dereference(Add(bi, 40))
            im = Dereference(Add(bi, 48))
            vx2 = Float_Mul(ivx, ivx)
            vy2 = Float_Mul(ivy, ivy)
            vz2 = Float_Mul(ivz, ivz)
            v2 = Float_Add(vx2, vy2)
            v2 = Float_Add(v2, vz2)
            mv = Float_Mul(im, v2)
            kin = Float_Mul(half, mv)
            e = Float_Add(e, kin)
            j = Add(i, 1)
            WhileLoop LessThan(j, 5) {
                bj = Add(base, Multiply(j, 56))
                jx = Dereference(bj)
                jy = Dereference(Add(bj, 8))
                jz = Dereference(Add(bj, 16))
                jm = Dereference(Add(bj, 48))
                dx = Float_Sub(ix, jx)
                dy = Float_Sub(iy, jy)
                dz = Float_Sub(iz, jz)
                dx2 = Float_Mul(dx, dx)
                dy2 = Float_Mul(dy, dy)
                dz2 = Float_Mul(dz, dz)
                dist2 = Float_Add(dx2, dy2)
                dist2 = Float_Add(dist2, dz2)
                dist = Float_Sqrt(dist2)
                mm = Float_Mul(im, jm)
                pot = Float_Div(mm, dist)
                e = Float_Sub(e, pot)
                j = Add(j, 1)
            }
            i = Add(i, 1)
        }
        ReturnValue(e)
    }
}

Function.RunN {
    Input: steps: Integer
    Input: clock: Integer
    Body: {
        base = Allocate(280)
        dt = 4576918229304087675
        Init(base)
        Offset(base)
        e0 = Energy(base)
        t0 = Stamp(clock)
        step = 0
        WhileLoop LessThan(step, steps) {
            Advance(base, dt)
            step = Add(step, 1)
        }
        t1 = Stamp(clock)
        e1 = Energy(base)
        PrintMessage("NBODY ")
        PrintNumber(steps)
        PrintMessage(" e0 ")
        PrintNumber(e0)
        PrintMessage(" e1 ")
        PrintNumber(e1)
        PrintMessage(" ns ")
        PrintNumber(Subtract(t1, t0))
        PrintMessage("\n")
    }
}

SubRoutine.Main {
    clock = Allocate(16)
    RunN(1000, clock)
    RunN(1000000, clock)
    ProcessExit(0)
}

RunTask(Main)
