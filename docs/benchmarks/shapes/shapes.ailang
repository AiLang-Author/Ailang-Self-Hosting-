        }
        ReturnValue(acc)
    }
}

Function.Scrub {
    Body: {
        n = 33554432
        buf = Allocate(n)
        i = 0
        WhileLoop LessThan(i, n) {
            StoreValue(Add(buf, i), i)
            i = Add(i, 64)
        }
    }
}

Function.Fill {
    Body: {
        n = 4096
        bytes = Multiply(n, 24)
        buf = Bench.shapes
        i = 0
        WhileLoop LessThan(i, n) {
            state = NextU32()
            typ = BitwiseAnd(RightShift(state, 28), 3)
            wint = Add(BitwiseAnd(RightShift(state, 16), 15), 1)
            hint = Add(BitwiseAnd(RightShift(state, 8), 15), 1)
            IfCondition EqualTo(typ, 0) ThenBlock: {
                hint = wint
            } ElseBlock: {
                IfCondition EqualTo(typ, 3) ThenBlock: {
                    hint = wint
                }
            }
            addr = Add(buf, Multiply(i, 24))
            StoreValue(addr, typ)
            StoreValue(Add(addr, 8), Float_FromInt(wint))
            StoreValue(Add(addr, 16), Float_FromInt(hint))
            i = Add(i, 1)
        }
    }
}

Function.Stamp {
    Input: buf: Integer
    Output: Integer
    Body: {
        dummy = SystemCall(228, 1, buf)
        sec = Dereference(buf)
        nsec = Dereference(Add(buf, 8))
        ns = Add(Multiply(sec, 1000000000), nsec)
        ReturnValue(ns)
    }
}

Function.EmitHead {
    Body: {
        PrintMessage("ROW ")
        IfCondition EqualTo(Bench.hot, 1) ThenBlock: {
            PrintMessage("hot ")
        } ElseBlock: {
            PrintMessage("cold ")
        }
        PrintNumber(Bench.count)
        PrintMessage(" ")
    }
}

Function.EmitTail {
    Input: bits: Integer
    Input: ns: Integer
    Body: {
        PrintNumber(ns)
        PrintMessage(" ")
        PrintNumber(bits)
        PrintMessage("\n")
    }
}

Function.RunAll {
    Input: buf: Integer
    Output: Integer
    Body: {
        sink = 0

        EmitHead()
        PrintMessage("loop-int ")
        t0 = Stamp(buf)
        bits = SumInt()
        t1 = Stamp(buf)
        EmitTail(bits, Subtract(t1, t0))
        sink = Add(sink, bits)

        EmitHead()
        PrintMessage("loop-fadd ")
        t0 = Stamp(buf)
        bits = SumFadd()
        t1 = Stamp(buf)
        EmitTail(bits, Subtract(t1, t0))
        sink = Add(sink, bits)

        EmitHead()
        PrintMessage("loop-fmul ")
        t0 = Stamp(buf)
        bits = SumFmul()
        t1 = Stamp(buf)
        EmitTail(bits, Subtract(t1, t0))
        sink = Add(sink, bits)

        EmitHead()
        PrintMessage("area-if-call ")
        t0 = Stamp(buf)
        bits = SumAreaIf()
        t1 = Stamp(buf)
        EmitTail(bits, Subtract(t1, t0))
        sink = Add(sink, bits)

        EmitHead()
        PrintMessage("area-fork-call ")
        t0 = Stamp(buf)
        bits = SumAreaFork()
        t1 = Stamp(buf)
        EmitTail(bits, Subtract(t1, t0))
        sink = Add(sink, bits)

        EmitHead()
        PrintMessage("area-branch-call ")
        t0 = Stamp(buf)
        bits = SumAreaBranch()
        t1 = Stamp(buf)
        EmitTail(bits, Subtract(t1, t0))
        sink = Add(sink, bits)

        EmitHead()
        PrintMessage("area-table-call ")
        t0 = Stamp(buf)
        bits = SumAreaTable()
        t1 = Stamp(buf)
        EmitTail(bits, Subtract(t1, t0))
        sink = Add(sink, bits)

        EmitHead()
        PrintMessage("area-if ")
        t0 = Stamp(buf)
        bits = SumAreaIfIn()
        t1 = Stamp(buf)
        EmitTail(bits, Subtract(t1, t0))
        sink = Add(sink, bits)

        EmitHead()
        PrintMessage("area-fork ")
        t0 = Stamp(buf)
        bits = SumAreaForkIn()
        t1 = Stamp(buf)
        EmitTail(bits, Subtract(t1, t0))
        sink = Add(sink, bits)

        EmitHead()
        PrintMessage("area-branch ")
        t0 = Stamp(buf)
        bits = SumAreaBranchIn()
        t1 = Stamp(buf)
        EmitTail(bits, Subtract(t1, t0))
        sink = Add(sink, bits)

        EmitHead()
        PrintMessage("area-table ")
        t0 = Stamp(buf)
        bits = SumAreaTableIn()
        t1 = Stamp(buf)
        EmitTail(bits, Subtract(t1, t0))
        sink = Add(sink, bits)

        EmitHead()
        PrintMessage("area-table-x4 ")
        t0 = Stamp(buf)
        bits = SumAreaTable4()
        t1 = Stamp(buf)
        EmitTail(bits, Subtract(t1, t0))
        sink = Add(sink, bits)

        EmitHead()
        PrintMessage("corner-call ")
        t0 = Stamp(buf)
        bits = SumCornerCall()
        t1 = Stamp(buf)
        EmitTail(bits, Subtract(t1, t0))
        sink = Add(sink, bits)

        EmitHead()
        PrintMessage("corner-two ")
        t0 = Stamp(buf)
        bits = SumCornerTwo()
        t1 = Stamp(buf)
        EmitTail(bits, Subtract(t1, t0))
        sink = Add(sink, bits)

        EmitHead()
        PrintMessage("corner-one ")
        t0 = Stamp(buf)
        bits = SumCornerOne()
        t1 = Stamp(buf)
        EmitTail(bits, Subtract(t1, t0))
        sink = Add(sink, bits)

        EmitHead()
        PrintMessage("corner-table ")
        t0 = Stamp(buf)
        bits = SumCornerTable()
        t1 = Stamp(buf)
        EmitTail(bits, Subtract(t1, t0))
        sink = Add(sink, bits)

        ReturnValue(sink)
    }
}

SubRoutine.Main {
    one = Float_FromInt(1)
    half = Float_Div(one, Float_FromInt(2))
    pi = 4614256656552045848
    Bench.one = one
    Bench.half = half
    Bench.pi = pi

    atable = CoeffAddr()
    ctable = Add(atable, 32)
    Bench.atable = atable
    Bench.ctable = ctable
    Bench.shapes = ShapeAddr()
    StoreValue(atable, one)
    StoreValue(Add(atable, 8), one)
    StoreValue(Add(atable, 16), half)
    StoreValue(Add(atable, 24), pi)
    fifth = Float_Div(one, Float_FromInt(5))
    eighth = Float_Div(half, Float_FromInt(4))
    StoreValue(ctable, fifth)
    StoreValue(Add(ctable, 8), fifth)
    StoreValue(Add(ctable, 16), eighth)
    StoreValue(Add(ctable, 24), pi)

    Fill()
    clock = Allocate(16)

    Bench.hot = 1
    SetSize(256, 200)
    sink = RunAll(clock)
    SetSize(4096, 200)
    sink = Add(sink, RunAll(clock))

    Scrub()
    Bench.hot = 0
    SetSize(4096, 1)
    sink = Add(sink, RunAll(clock))
    ProcessExit(BitwiseAnd(sink, 255))
}

RunTask(Main)
