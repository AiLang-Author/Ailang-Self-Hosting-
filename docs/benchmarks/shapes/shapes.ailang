                area = 0
                IfCondition EqualTo(typ, 0) ThenBlock: {
                    area = Float_Mul(w, w)
                } ElseBlock: {
                    IfCondition EqualTo(typ, 1) ThenBlock: {
                        area = Float_Mul(w, h)
                    } ElseBlock: {
                        IfCondition EqualTo(typ, 2) ThenBlock: {
                            hw = Float_Mul(half, w)
                            area = Float_Mul(hw, h)
                        } ElseBlock: {
                            pw = Float_Mul(pi, w)
                            area = Float_Mul(pw, w)
                        }
                    }
