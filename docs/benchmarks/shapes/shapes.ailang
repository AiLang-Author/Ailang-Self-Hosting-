            cursor = base
            WhileLoop LessThan(cursor, limit) {
                typ = Dereference(cursor)
                w = Dereference(Add(cursor, 8))
                h = Dereference(Add(cursor, 16))
                corners = 0
                Branch typ {
                    Case 0: { corners = 4 }
                    Case 1: { corners = 4 }
                    Case 2: { corners = 3 }
                    Case 3: { corners = 0 }
                    Default: { corners = 0 }
                }
                area = 0
                Branch typ {
                    Case 0: { area = Float_Mul(w, w) }
                    Case 1: { area = Float_Mul(w, h) }
                    Case 2: {
                        hw = Float_Mul(half, w)
                        area = Float_Mul(hw, h)
                    }
                    Case 3: {
                        pw = Float_Mul(pi, w)
                        area = Float_Mul(pw, w)
                    }
                    Default: { area = 0 }
                }
                den = Float_FromInt(Add(corners, 1))
                weight = Float_Div(one, den)
                weighted = Float_Mul(weight, area)
                psum = Float_Add(psum, weighted)
                cursor = Add(cursor, 24)
            }
            acc = Float_Add(acc, psum)
            rep = Add(rep, 1)
        }
        ReturnValue(acc)
    }
}

Function.SumCornerOne {
    Output: Integer
    Body: {
        acc = 0
        rep = 0
        reps = Bench.reps
        base = Bench.shapes
        limit = Add(base, Bench.nbytes)
        one = Bench.one
        half = Bench.half
        pi = Bench.pi
        WhileLoop LessThan(rep, reps) {
            psum = 0
            cursor = base
            WhileLoop LessThan(cursor, limit) {
                typ = Dereference(cursor)
                w = Dereference(Add(cursor, 8))
                h = Dereference(Add(cursor, 16))
                corners = 0
                area = 0
                Branch typ {
                    Case 0: {
                        corners = 4
                        area = Float_Mul(w, w)
                    }
                    Case 1: {
                        corners = 4
                        area = Float_Mul(w, h)
                    }
                    Case 2: {
                        corners = 3
                        hw = Float_Mul(half, w)
                        area = Float_Mul(hw, h)
                    }
                    Case 3: {
                        corners = 0
                        pw = Float_Mul(pi, w)
                        area = Float_Mul(pw, w)
                    }
                    Default: {
                        corners = 0
                        area = 0
                    }
                }
                den = Float_FromInt(Add(corners, 1))
                weight = Float_Div(one, den)
                weighted = Float_Mul(weight, area)
                psum = Float_Add(psum, weighted)
                cursor = Add(cursor, 24)
            }
            acc = Float_Add(acc, psum)
            rep = Add(rep, 1)
        }
        ReturnValue(acc)
    }
}

