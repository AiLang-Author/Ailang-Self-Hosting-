Function.SumAreaIfIn {
    Output: Integer
    Body: {
        acc = 0
        rep = 0
        reps = Bench.reps
        base = Bench.shapes
        limit = Add(base, Bench.nbytes)
        half = Bench.half
        pi = Bench.pi
        WhileLoop LessThan(rep, reps) {
            psum = 0
