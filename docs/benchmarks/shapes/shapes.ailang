// AILANG counterparts to Casey Muratori's shape-area listings.
// Records are 24 bytes: int64 type, float64 width, float64 height.
// Function is a real call. Branch is a compare/jump chain. Fork is the
// two-sided conditional. The table is listing 27 / listing 36.

LibraryImport.Arena

FixedPool.Bench {
    "shapes": Initialize=0, CanChange=True
    "nbytes": Initialize=0, CanChange=True
    "count": Initialize=0, CanChange=True
    "reps": Initialize=0, CanChange=True
    "total": Initialize=0, CanChange=True
    "hot": Initialize=1, CanChange=True
    "one": Initialize=0, CanChange=True
    "half": Initialize=0, CanChange=True
    "pi": Initialize=0, CanChange=True
    "atable": Initialize=0, CanChange=True
    "ctable": Initialize=0, CanChange=True
}

FixedPool.Rng {
    "state": Initialize=1, CanChange=True
}

// Eight coefficient doubles live in the pool image. The shape records follow
// them, still inside the one 262144-byte pool mapping, past the named slots.
// Slot 0..130 are Arena plus Bench plus Rng. Coeff is 131..138 (1048).
// Shapes start at byte 1112. 4096 records * 24 bytes end at 99416.
FixedPool.Coeff {
    "a0": Initialize=4660, CanChange=True
    "a1": Initialize=0, CanChange=True
    "a2": Initialize=0, CanChange=True
    "a3": Initialize=0, CanChange=True
    "k0": Initialize=0, CanChange=True
    "k1": Initialize=0, CanChange=True
    "k2": Initialize=0, CanChange=True
    "k3": Initialize=0, CanChange=True
}

Function.CoeffAddr {
    Output: Integer
    Body: {
        p = InlineAsm["4C 89 F8 48 05 18 04 00 00"]
        ReturnValue(p)
    }
}

Function.ShapeAddr {
    Output: Integer
    Body: {
        p = InlineAsm["4C 89 F8 48 05 58 04 00 00"]
        ReturnValue(p)
    }
}

Function.SetSize {
    Input: n: Integer
    Input: r: Integer
    Body: {
        Bench.count = n
        Bench.nbytes = Multiply(n, 24)
        Bench.reps = r
        Bench.total = Multiply(n, r)
    }
}

Function.NextU32 {
    Output: Integer
    Body: {
        state = Rng.state
        step = Multiply(state, 1664525)
        step = Add(step, 1013904223)
        step = BitwiseAnd(step, 4294967295)
        Rng.state = step
        ReturnValue(step)
    }
}

Function.AreaIf {
    Input: typ: Integer
    Input: w: Integer
    Input: h: Integer
    Output: Integer
    Body: {
        area = 0
        IfCondition EqualTo(typ, 0) ThenBlock: {
            area = Float_Mul(w, w)
        } ElseBlock: {
            IfCondition EqualTo(typ, 1) ThenBlock: {
                area = Float_Mul(w, h)
            } ElseBlock: {
                IfCondition EqualTo(typ, 2) ThenBlock: {
                    hw = Float_Mul(Bench.half, w)
                    area = Float_Mul(hw, h)
                } ElseBlock: {
                    pw = Float_Mul(Bench.pi, w)
                    area = Float_Mul(pw, w)
                }
            }
        }
        ReturnValue(area)
    }
}

Function.AreaFork {
    Input: typ: Integer
    Input: w: Integer
    Input: h: Integer
    Output: Integer
    Body: {
        area = 0
        Fork EqualTo(typ, 0) TrueBlock: {
            area = Float_Mul(w, w)
        } FalseBlock: {
            Fork EqualTo(typ, 1) TrueBlock: {
                area = Float_Mul(w, h)
            } FalseBlock: {
                Fork EqualTo(typ, 2) TrueBlock: {
                    hw = Float_Mul(Bench.half, w)
                    area = Float_Mul(hw, h)
                } FalseBlock: {
                    pw = Float_Mul(Bench.pi, w)
                    area = Float_Mul(pw, w)
                }
            }
        }
        ReturnValue(area)
    }
}

Function.AreaBranch {
    Input: typ: Integer
    Input: w: Integer
    Input: h: Integer
    Output: Integer
    Body: {
        area = 0
        Branch typ {
            Case 0: { area = Float_Mul(w, w) }
            Case 1: { area = Float_Mul(w, h) }
            Case 2: {
                hw = Float_Mul(Bench.half, w)
                area = Float_Mul(hw, h)
            }
            Case 3: {
                pw = Float_Mul(Bench.pi, w)
                area = Float_Mul(pw, w)
            }
            Default: { area = 0 }
        }
        ReturnValue(area)
    }
}

Function.AreaTable {
    Input: typ: Integer
    Input: w: Integer
    Input: h: Integer
    Output: Integer
    Body: {
        slot = Multiply(typ, 8)
        coeff = Dereference(Add(Bench.atable, slot))
        cw = Float_Mul(coeff, w)
        area = Float_Mul(cw, h)
        ReturnValue(area)
    }
}

Function.CornersBranch {
    Input: typ: Integer
    Output: Integer
    Body: {
        corners = 0
        Branch typ {
            Case 0: { corners = 4 }
            Case 1: { corners = 4 }
            Case 2: { corners = 3 }
            Case 3: { corners = 0 }
            Default: { corners = 0 }
        }
        ReturnValue(corners)
    }
}

Function.SumInt {
    Output: Integer
    Body: {
        acc = 0
        rep = 0
        reps = Bench.reps
        base = Bench.shapes
        limit = Add(base, Bench.nbytes)
        WhileLoop LessThan(rep, reps) {
            psum = 0
            cursor = base
            WhileLoop LessThan(cursor, limit) {
                typ = Dereference(cursor)
                psum = Add(psum, typ)
                cursor = Add(cursor, 24)
            }
            acc = Add(acc, psum)
            rep = Add(rep, 1)
        }
        ReturnValue(acc)
    }
}

Function.SumFadd {
    Output: Integer
    Body: {
        acc = 0
        rep = 0
        reps = Bench.reps
        base = Bench.shapes
        limit = Add(base, Bench.nbytes)
        WhileLoop LessThan(rep, reps) {
            psum = 0
            cursor = base
            WhileLoop LessThan(cursor, limit) {
                w = Dereference(Add(cursor, 8))
                psum = Float_Add(psum, w)
                cursor = Add(cursor, 24)
            }
            acc = Float_Add(acc, psum)
            rep = Add(rep, 1)
        }
        ReturnValue(acc)
    }
}

Function.SumFmul {
    Output: Integer
    Body: {
        acc = 0
        rep = 0
        reps = Bench.reps
        base = Bench.shapes
        limit = Add(base, Bench.nbytes)
        WhileLoop LessThan(rep, reps) {
            psum = 0
            cursor = base
            WhileLoop LessThan(cursor, limit) {
                w = Dereference(Add(cursor, 8))
                h = Dereference(Add(cursor, 16))
                prod = Float_Mul(w, h)
                psum = Float_Add(psum, prod)
                cursor = Add(cursor, 24)
            }
            acc = Float_Add(acc, psum)
            rep = Add(rep, 1)
        }
        ReturnValue(acc)
    }
}

