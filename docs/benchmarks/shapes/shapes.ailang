Function.SumAreaTableIn {
    Output: Integer
    Body: {
        acc = 0
        rep = 0
        reps = Bench.reps
        base = Bench.shapes
        limit = Add(base, Bench.nbytes)
        table = Bench.atable
        WhileLoop LessThan(rep, reps) {
            psum = 0
            cursor = base
            WhileLoop LessThan(cursor, limit) {
                typ = Dereference(cursor)
                w = Dereference(Add(cursor, 8))
                h = Dereference(Add(cursor, 16))
                coeff = Dereference(Add(table, Multiply(typ, 8)))
                cw = Float_Mul(coeff, w)
                area = Float_Mul(cw, h)
                psum = Float_Add(psum, area)
                cursor = Add(cursor, 24)
            }
            acc = Float_Add(acc, psum)
            rep = Add(rep, 1)
        }
        ReturnValue(acc)
    }
}

Function.SumAreaTable4 {
    Output: Integer
    Body: {
        acc = 0
        rep = 0
        reps = Bench.reps
        base = Bench.shapes
        table = Bench.atable
        groups = Divide(Bench.count, 4)
        WhileLoop LessThan(rep, reps) {
            a0 = 0
            a1 = 0
            a2 = 0
            a3 = 0
            g = 0
            cursor = base
            WhileLoop LessThan(g, groups) {
                typ = Dereference(cursor)
                w = Dereference(Add(cursor, 8))
                h = Dereference(Add(cursor, 16))
                coeff = Dereference(Add(table, Multiply(typ, 8)))
                cw = Float_Mul(coeff, w)
                area = Float_Mul(cw, h)
                a0 = Float_Add(a0, area)
                cursor = Add(cursor, 24)

                typ = Dereference(cursor)
                w = Dereference(Add(cursor, 8))
                h = Dereference(Add(cursor, 16))
                coeff = Dereference(Add(table, Multiply(typ, 8)))
                cw = Float_Mul(coeff, w)
                area = Float_Mul(cw, h)
                a1 = Float_Add(a1, area)
                cursor = Add(cursor, 24)

                typ = Dereference(cursor)
                w = Dereference(Add(cursor, 8))
                h = Dereference(Add(cursor, 16))
                coeff = Dereference(Add(table, Multiply(typ, 8)))
                cw = Float_Mul(coeff, w)
                area = Float_Mul(cw, h)
                a2 = Float_Add(a2, area)
                cursor = Add(cursor, 24)

                typ = Dereference(cursor)
                w = Dereference(Add(cursor, 8))
                h = Dereference(Add(cursor, 16))
                coeff = Dereference(Add(table, Multiply(typ, 8)))
                cw = Float_Mul(coeff, w)
                area = Float_Mul(cw, h)
                a3 = Float_Add(a3, area)
                cursor = Add(cursor, 24)

                g = Add(g, 1)
            }
            s01 = Float_Add(a0, a1)
            s23 = Float_Add(a2, a3)
            psum = Float_Add(s01, s23)
            acc = Float_Add(acc, psum)
            rep = Add(rep, 1)
        }
        ReturnValue(acc)
    }
}

Function.SumCornerCall {
    Output: Integer
    Body: {
        acc = 0
        rep = 0
        reps = Bench.reps
        base = Bench.shapes
        limit = Add(base, Bench.nbytes)
        one = Bench.one
        WhileLoop LessThan(rep, reps) {
            psum = 0
            cursor = base
            WhileLoop LessThan(cursor, limit) {
                typ = Dereference(cursor)
                w = Dereference(Add(cursor, 8))
                h = Dereference(Add(cursor, 16))
                corners = CornersBranch(typ)
                area = AreaBranch(typ, w, h)
                den = Float_FromInt(Add(corners, 1))
                weight = Float_Div(one, den)
                weighted = Float_Mul(weight, area)
                psum = Float_Add(psum, weighted)
                cursor = Add(cursor, 24)
            }
            acc = Float_Add(acc, psum)
            rep = Add(rep, 1)
        }
        ReturnValue(acc)
    }
}

Function.SumCornerTwo {
    Output: Integer
    Body: {
        acc = 0
        rep = 0
        reps = Bench.reps
        base = Bench.shapes
        limit = Add(base, Bench.nbytes)
        one = Bench.one
        half = Bench.half
        pi = Bench.pi
        WhileLoop LessThan(rep, reps) {
