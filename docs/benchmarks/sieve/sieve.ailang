// Count primes below N with a byte sieve. N = 1000000.
// The C twin is the same algorithm.

LibraryImport.Arena

Function.Stamp {
    Input: buf: Integer
    Output: Integer
    Body: {
        dummy = SystemCall(228, 1, buf)
        sec = Dereference(buf)
        nsec = Dereference(Add(buf, 8))
        ns = Add(Multiply(sec, 1000000000), nsec)
        ReturnValue(ns)
    }
}

Function.CountPrimes {
    Input: n: Integer
    Output: Integer
    Body: {
        mark = Allocate(n)
        MemorySet(mark, 1, n)
        IfCondition GreaterThan(n, 0) ThenBlock: {
            SetByte(mark, 0, 0)
        }
        IfCondition GreaterThan(n, 1) ThenBlock: {
            SetByte(mark, 1, 0)
        }
        i = 2
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(GetByte(mark, i), 1) ThenBlock: {
                j = Add(i, i)
                WhileLoop LessThan(j, n) {
                    SetByte(mark, j, 0)
                    j = Add(j, i)
                }
            }
            i = Add(i, 1)
        }
        count = 0
        i = 0
        WhileLoop LessThan(i, n) {
            count = Add(count, GetByte(mark, i))
            i = Add(i, 1)
        }
        Deallocate(mark, n)
        ReturnValue(count)
    }
}

SubRoutine.Main {
    Arena_Init()
    clock = Allocate(16)
    t0 = Stamp(clock)
    primes = CountPrimes(1000000)
    t1 = Stamp(clock)
    PrintMessage("SIEVE primes ")
    PrintNumber(primes)
    PrintMessage(" ns ")
    PrintNumber(Subtract(t1, t0))
    PrintMessage("\n")
    IfCondition EqualTo(primes, 78498) ThenBlock: {
        ProcessExit(0)
    }
    ProcessExit(1)
}

RunTask(Main)
