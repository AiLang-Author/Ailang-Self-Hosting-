// Spectral norm, plain loop from the Benchmarks Game gcc #8 entry.
// Au[i] += (1 / ((i+j)*(i+j+1)/2 + i + 1)) * u[j], ten iterations.
// The C function eval_A is open here so the denominator temps sit in
// the loop the way g++ -O3 inlines that one-line function.
// N=5500 answer is 1.274224153.

LibraryImport.Arena

FixedPool.Spec {
    "one": Initialize=0, CanChange=True
    "u": Initialize=0, CanChange=True
    "v": Initialize=0, CanChange=True
    "w": Initialize=0, CanChange=True
}

Function.Stamp {
    Input: buf: Integer
    Output: Integer
    Body: {
        dummy = SystemCall(228, 1, buf)
        sec = Dereference(buf)
        nsec = Dereference(Add(buf, 8))
        ns = Add(Multiply(sec, 1000000000), nsec)
        ReturnValue(ns)
    }
}

// eval_A(i, j) * u[j], accumulated into dst.
Function.MulA {
    Input: n: Integer
    Input: src: Integer
    Input: dst: Integer
    Input: one: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, n) {
            sum = 0
            j = 0
            row = Add(dst, Multiply(i, 8))
            WhileLoop LessThan(j, n) {
                ij = Add(i, j)
                ij1 = Add(ij, 1)
                tri = Divide(Multiply(ij, ij1), 2)
                ip1 = Add(i, 1)
                den_i = Add(tri, ip1)
                den = Float_FromInt(den_i)
                a = Float_Div(one, den)
                uj = Dereference(Add(src, Multiply(j, 8)))
                prod = Float_Mul(a, uj)
                sum = Float_Add(sum, prod)
                j = Add(j, 1)
            }
            StoreValue(row, sum)
            i = Add(i, 1)
        }
    }
}

// eval_A(j, i) * u[j]. Same denominator with j in place of i.
Function.MulAt {
    Input: n: Integer
    Input: src: Integer
    Input: dst: Integer
    Input: one: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, n) {
            sum = 0
            j = 0
            row = Add(dst, Multiply(i, 8))
            WhileLoop LessThan(j, n) {
                ij = Add(j, i)
                ij1 = Add(ij, 1)
                tri = Divide(Multiply(ij, ij1), 2)
                jp1 = Add(j, 1)
                den_i = Add(tri, jp1)
                den = Float_FromInt(den_i)
                a = Float_Div(one, den)
                uj = Dereference(Add(src, Multiply(j, 8)))
                prod = Float_Mul(a, uj)
                sum = Float_Add(sum, prod)
                j = Add(j, 1)
            }
            StoreValue(row, sum)
            i = Add(i, 1)
        }
    }
}

Function.AtA {
    Input: n: Integer
    Input: src: Integer
    Input: dst: Integer
    Input: tmp: Integer
    Input: one: Integer
    Body: {
        MulA(n, src, tmp, one)
        MulAt(n, tmp, dst, one)
    }
}

Function.RunN {
    Input: n: Integer
    Input: clock: Integer
    Body: {
        one = Spec.one
        u = Spec.u
        v = Spec.v
        w = Spec.w
        i = 0
        WhileLoop LessThan(i, n) {
            StoreValue(Add(u, Multiply(i, 8)), one)
            i = Add(i, 1)
        }
        t0 = Stamp(clock)
        rep = 0
        WhileLoop LessThan(rep, 10) {
            AtA(n, u, v, w, one)
            AtA(n, v, u, w, one)
            rep = Add(rep, 1)
        }
        vBv = 0
        vv = 0
        i = 0
        WhileLoop LessThan(i, n) {
            ui = Dereference(Add(u, Multiply(i, 8)))
            vi = Dereference(Add(v, Multiply(i, 8)))
            uv = Float_Mul(ui, vi)
            vBv = Float_Add(vBv, uv)
            vv_term = Float_Mul(vi, vi)
            vv = Float_Add(vv, vv_term)
            i = Add(i, 1)
        }
        ratio = Float_Div(vBv, vv)
        result = Float_Sqrt(ratio)
        t1 = Stamp(clock)
        PrintMessage("ROW ")
        PrintNumber(n)
        PrintMessage(" bits ")
        PrintNumber(result)
        PrintMessage(" ns ")
        PrintNumber(Subtract(t1, t0))
        PrintMessage("\n")
    }
}

SubRoutine.Main {
    Spec.one = Float_FromInt(1)
    bytes = Multiply(5500, 8)
    Spec.u = Allocate(bytes)
    Spec.v = Allocate(bytes)
    Spec.w = Allocate(bytes)
    clock = Allocate(16)
    RunN(100, clock)
    RunN(5500, clock)
    ProcessExit(0)
}

RunTask(Main)
