digraph board {
  rankdir=LR;
  node [shape=box, fontname="Helvetica"];
  edge [fontname="Helvetica", fontsize=10];
  labelloc="t";
  label="Commodore 64 NTSC";
  "cpu" [label="cpu\nMOS6510\nCPU6502"];
  "vic" [label="vic\nMOS6567\nC64VIC"];
  "sid" [label="sid\nMOS6581\nC64SID"];
  "cia1" [label="cia1\nMOS6526\nC64CIA"];
  "cia2" [label="cia2\nMOS6526\nC64CIA"];
  "ram" [label="ram\n4164x8\nBus6502RAM"];
  "basic" [label="basic\n901226-01\nROM"];
  "kernal" [label="kernal\n901227-02\nROM"];
  "chargen" [label="chargen\n901225-01\nROM"];
  "cpu_bus" -> "ram" [style=dashed, label="0000-FFFF devid 0"];
  "cpu_bus" -> "basic" [style=dashed, label="A000-BFFF devid 0"];
  "cpu_bus" -> "kernal" [style=dashed, label="E000-FFFF devid 0"];
  "cpu_bus" -> "vic" [style=dashed, label="D000-D3FF devid 1"];
  "cpu_bus" -> "sid" [style=dashed, label="D400-D7FF devid 2"];
  "cpu_bus" -> "cia1" [style=dashed, label="DC00-DCFF devid 3"];
  "cpu_bus" -> "cia2" [style=dashed, label="DD00-DDFF devid 4"];
  "cpu_bus" -> "cpu" [style=dashed, label="0000-0001 devid 5"];
  "cpu_bus" [shape=ellipse, style=filled, fillcolor=lightgrey];
  "cia1" -> "cpu" [color=red, label="irq"];
  "cia2" -> "cpu" [color=red, label="irq"];
  "vic" -> "cpu" [color=red, label="irq"];
  "cia2" -> "cpu" [color=red, label="nmi"];
  "restore" -> "cpu" [color=red, label="nmi"];
  "clock" -> "cpu" [color=red, label="phi2"];
  "clock" -> "vic" [color=red, label="phi2"];
  "clock" -> "cia1" [color=red, label="phi2"];
  "clock" -> "cia2" [color=red, label="phi2"];
  "clock" -> "sid" [color=red, label="phi2"];
  "vic" -> "cpu" [color=red, label="aec"];
}
