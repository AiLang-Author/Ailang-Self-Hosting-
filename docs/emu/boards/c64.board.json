{
  "board": "c64-ntsc",
  "title": "Commodore 64 NTSC",
  "clock_hz": 1022727,
  "comment": "Motherboard is this file. Chips are Ailang libraries. Nets are wires.",

  "chips": [
    {"id": "cpu",  "part": "MOS6510", "model": "CPU6502", "socket": "u7"},
    {"id": "port", "part": "MOS6510-port", "model": "Port6510", "socket": "u7-port"},
    {"id": "vic",  "part": "MOS6567", "model": "C64VIC",  "socket": "u19"},
    {"id": "sid",  "part": "MOS6581", "model": "C64SID",  "socket": "u18"},
    {"id": "cia1", "part": "MOS6526", "model": "C64CIA",  "unit": 1, "socket": "u1"},
    {"id": "cia2", "part": "MOS6526", "model": "C64CIA",  "unit": 2, "socket": "u2"},
    {"id": "kernalstub", "part": "KERNAL-STUB", "model": "KernalStub", "comment": "Palm/Lorenz jump-table stubs, not copyrighted ROM"},
    {"id": "ram",  "part": "4164x8",  "model": "Bus6502RAM", "size": 65536},
    {"id": "basic","part": "901226-01", "model": "ROM", "file": "roms/basic.bin", "size": 8192},
    {"id": "kernal","part": "901227-02", "model": "ROM", "file": "roms/kernal.bin", "size": 8192},
    {"id": "chargen","part": "901225-01", "model": "ROM", "file": "roms/chargen.bin", "size": 4096}
  ],

  "buses": [
    {"id": "cpu_bus", "addr_bits": 16, "data_bits": 8, "clock": "phi2"}
  ],

  "maps": [
    {"chip": "ram",    "bus": "cpu_bus", "lo": "0000", "hi": "FFFF", "devid": 0},
    {"chip": "basic",  "bus": "cpu_bus", "lo": "A000", "hi": "BFFF", "devid": 0, "window": "banked"},
    {"chip": "kernal", "bus": "cpu_bus", "lo": "E000", "hi": "FFFF", "devid": 0, "window": "banked"},
    {"chip": "vic",    "bus": "cpu_bus", "lo": "D000", "hi": "D3FF", "devid": 1},
    {"chip": "sid",    "bus": "cpu_bus", "lo": "D400", "hi": "D7FF", "devid": 2},
    {"chip": "cia1",   "bus": "cpu_bus", "lo": "DC00", "hi": "DCFF", "devid": 3},
    {"chip": "cia2",   "bus": "cpu_bus", "lo": "DD00", "hi": "DDFF", "devid": 4},
    {"chip": "port",   "bus": "cpu_bus", "lo": "0000", "hi": "0001", "devid": 5, "comment": "6510 on-die I/O port"},
    {"chip": "kernalstub", "bus": "cpu_bus", "lo": "FF00", "hi": "FFFF", "devid": 7}
  ],

  "nets": [
    {"name": "irq",  "combine": "wired-and", "from": ["cia1.irq", "cia2.irq", "vic.irq"], "to": ["cpu.irq"]},
    {"name": "nmi",  "combine": "wired-and", "from": ["cia2.nmi", "restore"], "to": ["cpu.nmi"]},
    {"name": "phi2", "from": ["clock.out"], "to": ["cpu.phi2", "vic.phi2", "cia1.phi2", "cia2.phi2", "sid.phi2"]},
    {"name": "aec",  "from": ["vic.aec"], "to": ["cpu.rdy"]}
  ],

  "asic_slot": {
    "comment": "Drop-in custom chip: add a chips[] row with model = an Ailang library that exports Chip_Read, Chip_Write, Chip_Tick, Chip_Pin, then a maps[] decode and nets[] wires.",
    "example": {
      "id": "uart",
      "part": "HOMEBREW_UART",
      "model": "ASIC.UART",
      "maps": [{"bus": "cpu_bus", "lo": "DE00", "hi": "DE0F", "devid": 16}],
      "nets": [{"name": "irq", "from": ["uart.irq"], "to": ["cpu.irq"]}]
    }
  }
}
