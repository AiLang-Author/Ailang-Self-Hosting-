// editor_test.ailang
// Standalone test application for Library.Editor
// Usage: ./editor_test [filename]

// =============================================================================
// LIBRARY IMPORTS
// =============================================================================
LibraryImport.XArrays
LibraryImport.TUI
LibraryImport.Editor

// =============================================================================
// TEST ENTRY POINT
// =============================================================================
SubRoutine.EditorTestMain {
    PrintMessage("Editor Test Application\n")
    PrintMessage("=======================\n")
    PrintMessage("\n")
    PrintMessage("Controls:\n")
    PrintMessage("  Arrow keys  - Navigate\n")
    PrintMessage("  Home/End    - Line start/end\n")
    PrintMessage("  Backspace   - Delete char\n")
    PrintMessage("  Enter       - New line\n")
    PrintMessage("  Ctrl+S      - Save file\n")
    PrintMessage("  Ctrl+Q/ESC  - Quit editor\n")
    PrintMessage("\n")
    PrintMessage("Press Enter to start editor (new file)...\n")

    // Wait for user input before starting
    buf = Allocate(16)
    SystemCall(0, 0, buf, 1)
    Deallocate(buf, 16)

    // Start editor with no file (new document)
    Editor_Open(0)

    PrintMessage("\nEditor closed.\n")
}

RunTask(EditorTestMain)
