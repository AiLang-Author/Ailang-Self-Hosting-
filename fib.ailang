Function.Fib {
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(n, 2) ThenBlock: { ReturnValue(n) }
        ReturnValue(Add(Fib(Subtract(n, 1)), Fib(Subtract(n, 2))))
    }
}

SubRoutine.Main {
    r = Fib(35)
    PrintMessage("fib(35) = ")
    PrintNumber(r)
    PrintMessage("\n")
}
RunTask(Main)
