
LibraryImport.Arena
LibraryImport.MessageTypes
LibraryImport.MessagePort

SubRoutine.Main {
    Arena_Init()
    env = MsgEnv_Alloc(1, 1, 0, 0)
    MsgEnv_AddInt(env, 10, 800)
    MsgEnv_AddInt(env, 11, 600)

    PrintMessage("find hash 10\n")
    f1 = MsgField_Find(env, 10)
    PrintMessage("found: ")
    PrintNumber(f1)
    PrintMessage("\n")

    PrintMessage("find hash 11\n")
    f2 = MsgField_Find(env, 11)
    PrintMessage("found: ")
    PrintNumber(f2)
    PrintMessage("\n")

    Exit(0)
}

RunTask(Main)