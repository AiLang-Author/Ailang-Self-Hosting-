# Makefile for the AiLang kernel module C shim.
#
# This builds the combined kernel module (ail_combined.ko) by linking
# the C shim (ail_shim.o) with the AiLang-generated payload (ail_payload.o).

# The final module will be ail_combined.ko
obj-m += ail_combined.o

# ail_combined.o is built from the shim and the payload.
# kbuild will compile ail_shim.c to ail_shim.o and expects ail_payload.o
# to be present in the same directory.
ail_combined-objs := ail_shim.o ail_payload.o

# Standard targets for building external modules.
# We add a dependency on 'check_payload' to provide a user-friendly error
# if the AiLang payload object is missing.
all: check_payload
	make -C /lib/modules/$(shell uname -r)/build M=$(PWD) modules

clean:
	make -C /lib/modules/$(shell uname -r)/build M=$(PWD) clean

check_payload:
	@if [ ! -f ail_payload.o ]; then \
		echo "ERROR: 'ail_payload.o' not found."; \
		echo "This file must be generated by the AiLang compiler (-kmod)"; \
		exit 1; \
	fi