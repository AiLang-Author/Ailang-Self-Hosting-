// logic_operations_demo.ailang
// Tests And, Or, Not operations
// Includes tests for the short-circuit evaluation compiler fix.

PrintMessage("==============================================")
PrintMessage("LOGICAL OPERATIONS DEMONSTRATION")
PrintMessage("==============================================")
PrintMessage("")

FixedPool.TestState {
    "total_tests": Initialize=0
    "passed_tests": Initialize=0
    "test_name": Initialize=0
    "expected": Initialize=0
    "actual": Initialize=0
}

SubRoutine.TestResult {
    TestState.total_tests = Add(TestState.total_tests, 1)
    PrintMessage("TEST: ")
    PrintMessage(TestState.test_name)
    PrintMessage(" | Exp: ")
    PrintNumber(TestState.expected)
    PrintMessage(" | Act: ")
    PrintNumber(TestState.actual)
    
    IfCondition EqualTo(TestState.expected, TestState.actual) ThenBlock: {
        PrintMessage(" | PASS")
        TestState.passed_tests = Add(TestState.passed_tests, 1)
    } ElseBlock: {
        PrintMessage(" | FAIL")
    }
}

// ==============================================
// TEST 1: AND Operations
// ==============================================
PrintMessage("")
PrintMessage("TEST 1: AND Operations")

TestState.test_name = "1 AND 1 -> 1"
TestState.expected = 1
TestState.actual = And(1, 1)
RunTask(TestResult)

TestState.test_name = "1 AND 0 -> 0"
TestState.expected = 0
TestState.actual = And(1, 0)
RunTask(TestResult)

TestState.test_name = "0 AND 1 -> 0"
TestState.expected = 0
TestState.actual = And(0, 1)
RunTask(TestResult)

TestState.test_name = "0 AND 0 -> 0"
TestState.expected = 0
TestState.actual = And(0, 0)
RunTask(TestResult)

TestState.test_name = "AND Short-Circuit (no crash)"
TestState.expected = 0
// If short-circuit fails, evaluating Divide(1, 0) will crash the program.
TestState.actual = And(0, Divide(1, 0))
RunTask(TestResult)

// ==============================================
// TEST 2: OR Operations
// ==============================================
PrintMessage("")
PrintMessage("TEST 2: OR Operations")

TestState.test_name = "1 OR 1 -> 1"
TestState.expected = 1
TestState.actual = Or(1, 1)
RunTask(TestResult)

TestState.test_name = "1 OR 0 -> 1"
TestState.expected = 1
TestState.actual = Or(1, 0)
RunTask(TestResult)

TestState.test_name = "0 OR 1 -> 1"
TestState.expected = 1
TestState.actual = Or(0, 1)
RunTask(TestResult)

TestState.test_name = "0 OR 0 -> 0"
TestState.expected = 0
TestState.actual = Or(0, 0)
RunTask(TestResult)

TestState.test_name = "OR Short-Circuit (no crash)"
TestState.expected = 1
// If short-circuit fails, evaluating Divide(1, 0) will crash the program.
TestState.actual = Or(1, Divide(1, 0))
RunTask(TestResult)

// ==============================================
// TEST 3: NOT Operations
// ==============================================
PrintMessage("")
PrintMessage("TEST 3: NOT Operations")

TestState.test_name = "NOT 0 -> 1"
TestState.expected = 1
TestState.actual = Not(0)
RunTask(TestResult)

TestState.test_name = "NOT 1 -> 0"
TestState.expected = 0
TestState.actual = Not(1)
RunTask(TestResult)

TestState.test_name = "NOT 99 -> 0"
TestState.expected = 0
TestState.actual = Not(99)
RunTask(TestResult)

// ==============================================
// TEST 4: Nested Logic
// ==============================================
PrintMessage("")
PrintMessage("TEST 4: Nested Logic")

TestState.test_name = "And(1, Or(0, 1)) -> 1"
TestState.expected = 1
TestState.actual = And(1, Or(0, 1))
RunTask(TestResult)

TestState.test_name = "Or(0, And(1, 0)) -> 0"
TestState.expected = 0
TestState.actual = Or(0, And(1, 0))
RunTask(TestResult)

// ==============================================
// FINAL SUMMARY
// ==============================================
PrintMessage("")
PrintMessage("==============================================")
PrintMessage("LOGIC OPERATIONS SUMMARY")
PrintMessage("==============================================")

PrintMessage("Total Tests: ")
PrintNumber(TestState.total_tests)
PrintMessage("Passed: ")
PrintNumber(TestState.passed_tests)

IfCondition EqualTo(TestState.passed_tests, TestState.total_tests) ThenBlock: {
    PrintMessage("ALL TESTS PASSED!")
    PrintMessage("Short-circuiting works perfectly (survived division by zero).")
} ElseBlock: {
    PrintMessage("SOME TESTS FAILED")
}
