LibraryImport.Arena

SubRoutine.Main {
    Arena_Init()
    size = 10000000

    arr = Arena_AllocGeneral(Multiply(size, 8))

    i = 0
    WhileLoop LessThan(i, size) {
        StoreValue(Add(arr, Multiply(i, 8)), i)
        i = Add(i, 1)
    }

    sum = 0
    pass = 0
    WhileLoop LessThan(pass, 10) {
        i = 0
        WhileLoop LessThan(i, size) {
            sum = Add(sum, Dereference(Add(arr, Multiply(i, 8))))
            i = Add(i, 16)
        }
        pass = Add(pass, 1)
    }

    PrintMessage("Sum: ")
    PrintNumber(sum)
    PrintMessage("\n")
}
RunTask(Main)
