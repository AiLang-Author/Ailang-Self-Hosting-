// memory_leak_scanner.ailang
// Quick tool to scan compiler modules for memory leaks

LibraryImport.XArrays
LibraryImport.AILangChecker

// =============================================================================
// SCANNER STATE
// =============================================================================
FixedPool.Scanner {
    "files_checked": Initialize=0, CanChange=True
    "total_allocs": Initialize=0, CanChange=True
    "total_deallocs": Initialize=0, CanChange=True
    "potential_leaks": Initialize=0, CanChange=True
    "buffer": Initialize=0, CanChange=True
    "buffer_size": Initialize=65536
}

// =============================================================================
// FILE I/O (from ailang_console)
// =============================================================================
Function.IO_Open {
    Input: filename: Address
    Input: flags: Integer
    Output: Integer
    Body: {
        fd = SystemCall(2, filename, flags, 420)
        ReturnValue(fd)
    }
}

Function.IO_Close {
    Input: fd: Integer
    Output: Integer
    Body: {
        result = SystemCall(3, fd)
        ReturnValue(result)
    }
}

Function.IO_Read {
    Input: fd: Integer
    Input: buffer: Address
    Input: count: Integer
    Output: Integer
    Body: {
        bytes_read = SystemCall(0, fd, buffer, count)
        ReturnValue(bytes_read)
    }
}

Function.IO_GetFileSize {
    Input: fd: Integer
    Output: Integer
    Body: {
        // lseek to end
        size = SystemCall(8, fd, 0, 2)
        // lseek back to start
        SystemCall(8, fd, 0, 0)
        ReturnValue(size)
    }
}

// =============================================================================
// LOAD AND SCAN A FILE
// =============================================================================
Function.ScanFile {
    Input: filename: Address
    Body: {
        PrintMessage("\n========================================\n")
        PrintMessage("Scanning: ")
        PrintMessage(filename)
        PrintMessage("\n========================================\n")
        
        // Open file
        fd = IO_Open(filename, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("ERROR: Could not open file\n")
            ReturnValue(0)
        }
        
        // Get size
        file_size = IO_GetFileSize(fd)
        IfCondition LessEqual(file_size, 0) ThenBlock: {
            PrintMessage("ERROR: Empty file or size error\n")
            IO_Close(fd)
            ReturnValue(0)
        }
        
        PrintMessage("File size: ")
        PrintNumber(file_size)
        PrintMessage(" bytes\n")
        
        // Allocate buffer
        buffer = Allocate(Add(file_size, 1))
        
        // Read file
        bytes_read = IO_Read(fd, buffer, file_size)
        IO_Close(fd)
        
        IfCondition LessEqual(bytes_read, 0) ThenBlock: {
            PrintMessage("ERROR: Failed to read file\n")
            Deallocate(buffer, Add(file_size, 1))
            ReturnValue(0)
        }
        
        // Null terminate
        SetByte(buffer, bytes_read, 0)
        
        // Run checker
        Checker.Init(buffer)
        Checker.Lex()
        Checker.Analyze()
        
        // Report
        PrintMessage("\nResults:\n")
        PrintMessage("  Allocate() calls:   ")
        PrintNumber(Checker.alloc_count)
        PrintMessage("\n")
        
        PrintMessage("  Deallocate() calls: ")
        PrintNumber(Checker.dealloc_count)
        PrintMessage("\n")
        
        diff = Subtract(Checker.alloc_count, Checker.dealloc_count)
        IfCondition GreaterThan(diff, 0) ThenBlock: {
            PrintMessage("  ⚠️  UNMATCHED: ")
            PrintNumber(diff)
            PrintMessage(" Allocate() without Deallocate()\n")
            Scanner.potential_leaks = Add(Scanner.potential_leaks, diff)
        } ElseBlock: {
            PrintMessage("  ✓ Allocate/Deallocate balanced\n")
        }
        
        PrintMessage("  Max loop depth: ")
        PrintNumber(Checker.max_loop_depth)
        PrintMessage("\n")
        
        PrintMessage("  Max block depth: ")
        PrintNumber(Checker.max_depth)
        PrintMessage("\n")
        
        // Show warnings
        IfCondition GreaterThan(Checker.warning_count, 0) ThenBlock: {
            PrintMessage("\nWarnings:\n")
            i = 0
            WhileLoop LessThan(i, Checker.warning_count) {
                msg = XArray.XGet(Checker.warnings, i)
                PrintMessage("  - ")
                PrintMessage(msg)
                PrintMessage("\n")
                i = Add(i, 1)
            }
        }
        
        // Update totals
        Scanner.total_allocs = Add(Scanner.total_allocs, Checker.alloc_count)
        Scanner.total_deallocs = Add(Scanner.total_deallocs, Checker.dealloc_count)
        Scanner.files_checked = Add(Scanner.files_checked, 1)
        
        Checker.Cleanup()
        Deallocate(buffer, Add(file_size, 1))
        
        ReturnValue(1)
    }
}

// =============================================================================
// MAIN
// =============================================================================
SubRoutine.Main {
    PrintMessage("╔════════════════════════════════════════╗\n")
    PrintMessage("║   AILang Memory Leak Scanner v1.0      ║\n")
    PrintMessage("╚════════════════════════════════════════╝\n")
    
    Scanner.files_checked = 0
    Scanner.total_allocs = 0
    Scanner.total_deallocs = 0
    Scanner.potential_leaks = 0
    
    // Scan the suspect files
    ScanFile("Librarys/Compiler/Compile/Modules/Library.CCompileScope.ailang")
    ScanFile("Librarys/Compiler/Compile/Modules/Library.CCompileFunc.ailang")
    ScanFile("Librarys/Compiler/Compile/Modules/Library.CCompileExpr.ailang")
    ScanFile("Librarys/Compiler/Compile/Library.CCompileMain.ailang")
    
    // Summary
    PrintMessage("\n╔════════════════════════════════════════╗\n")
    PrintMessage("║            SUMMARY                     ║\n")
    PrintMessage("╚════════════════════════════════════════╝\n")
    
    PrintMessage("Files scanned:     ")
    PrintNumber(Scanner.files_checked)
    PrintMessage("\n")
    
    PrintMessage("Total Allocate():  ")
    PrintNumber(Scanner.total_allocs)
    PrintMessage("\n")
    
    PrintMessage("Total Deallocate(): ")
    PrintNumber(Scanner.total_deallocs)
    PrintMessage("\n")
    
    total_diff = Subtract(Scanner.total_allocs, Scanner.total_deallocs)
    IfCondition GreaterThan(total_diff, 0) ThenBlock: {
        PrintMessage("\n⚠️  TOTAL UNMATCHED: ")
        PrintNumber(total_diff)
        PrintMessage("\n")
        PrintMessage("These may be intentional (returned pointers) or actual leaks.\n")
    } ElseBlock: {
        PrintMessage("\n✓ All Allocate/Deallocate calls balanced!\n")
    }
    
    PrintMessage("\n")
}

RunTask(Main)