// pg_connect_test.ailang
// Minimal PostgreSQL connection + query test
// Tests: connect, simple query, read result, disconnect
//
// Prerequisites:
//   PostgreSQL running locally
//   Database: ailang_system
//   User: bob (trust or peer auth)
//
// Run: ./pg_connect_test.x

LibraryImport.Arena
LibraryImport.Socket
LibraryImport.HashMap
LibraryImport.XArrays
LibraryImport.StringUtils
LibraryImport.PostgreSQL_Complete

SubRoutine.Main {
    PrintMessage("=== PostgreSQL Connection Test ===\n\n")

    Arena_Init()

    // Connect to local PostgreSQL
    PrintMessage("[TEST] Connecting to ailang_system...\n")
    conn = PG_Connect("127.0.0.1", 5432, "ailang_system", "bob", "")

    IfCondition EqualTo(conn, 0) ThenBlock: {
        PrintMessage("[FAIL] Connection failed\n")
        PrintMessage("Check: is PostgreSQL running? pg_hba.conf auth method?\n")
        HaltProgram
    }
    PrintMessage("[PASS] Connected\n\n")

    // Test 1: Simple SELECT
    PrintMessage("[TEST] SELECT 1 AS test_val...\n")
    result = PG_Query(conn, "SELECT 1 AS test_val")
    IfCondition EqualTo(result, 0) ThenBlock: {
        PrintMessage("[FAIL] Query returned null\n")
        PG_Disconnect(conn)
        HaltProgram
    }

    row_count = XArray.XSize(result)
    PrintMessage("[INFO] Rows returned: ")
    PrintNumber(row_count)
    PrintMessage("\n")

    IfCondition EqualTo(row_count, 1) ThenBlock: {
        row = XArray.XGet(result, 0)
        val = HashMap.HGetSimple(row, "test_val")
        IfCondition NotEqual(val, 0) ThenBlock: {
            PrintMessage("[INFO] test_val = ")
            PrintString(val)
            PrintMessage("\n")
            PrintMessage("[PASS] Simple query works\n\n")
        } ElseBlock: {
            PrintMessage("[FAIL] Could not read test_val from row\n\n")
        }
    } ElseBlock: {
        PrintMessage("[FAIL] Expected 1 row, got ")
        PrintNumber(row_count)
        PrintMessage("\n\n")
    }
    PG_DestroyResult(result)

    // Test 2: CREATE TABLE
    PrintMessage("[TEST] CREATE TABLE pg_test...\n")
    result2 = PG_Query(conn, "DROP TABLE IF EXISTS pg_test")
    IfCondition NotEqual(result2, 0) ThenBlock: { PG_DestroyResult(result2) }

    result3 = PG_Query(conn, "CREATE TABLE pg_test (id SERIAL PRIMARY KEY, name TEXT, value INTEGER)")
    IfCondition EqualTo(result3, 0) ThenBlock: {
        PrintMessage("[FAIL] CREATE TABLE failed\n")
        PG_Disconnect(conn)
        HaltProgram
    }
    PG_DestroyResult(result3)
    PrintMessage("[PASS] Table created\n\n")

    // Test 3: INSERT
    PrintMessage("[TEST] INSERT rows...\n")
    r4 = PG_Query(conn, "INSERT INTO pg_test (name, value) VALUES ('hello', 42)")
    IfCondition NotEqual(r4, 0) ThenBlock: { PG_DestroyResult(r4) }
    r5 = PG_Query(conn, "INSERT INTO pg_test (name, value) VALUES ('world', 99)")
    IfCondition NotEqual(r5, 0) ThenBlock: { PG_DestroyResult(r5) }
    PrintMessage("[PASS] Inserted 2 rows\n\n")

    // Test 4: SELECT back
    PrintMessage("[TEST] SELECT * FROM pg_test...\n")
    result6 = PG_Query(conn, "SELECT id, name, value FROM pg_test ORDER BY id")
    IfCondition EqualTo(result6, 0) ThenBlock: {
        PrintMessage("[FAIL] SELECT query failed\n")
        PG_Disconnect(conn)
        HaltProgram
    }

    sel_count = XArray.XSize(result6)
    PrintMessage("[INFO] Rows: ")
    PrintNumber(sel_count)
    PrintMessage("\n")

    ri = 0
    WhileLoop LessThan(ri, sel_count) {
        sel_row = XArray.XGet(result6, ri)
        r_id   = HashMap.HGetSimple(sel_row, "id")
        r_name = HashMap.HGetSimple(sel_row, "name")
        r_val  = HashMap.HGetSimple(sel_row, "value")
        PrintMessage("  row ")
        PrintNumber(ri)
        PrintMessage(": id=")
        IfCondition NotEqual(r_id, 0) ThenBlock: { PrintString(r_id) }
        PrintMessage(" name=")
        IfCondition NotEqual(r_name, 0) ThenBlock: { PrintString(r_name) }
        PrintMessage(" value=")
        IfCondition NotEqual(r_val, 0) ThenBlock: { PrintString(r_val) }
        PrintMessage("\n")
        ri = Add(ri, 1)
    }

    IfCondition EqualTo(sel_count, 2) ThenBlock: {
        PrintMessage("[PASS] SELECT returned expected rows\n\n")
    } ElseBlock: {
        PrintMessage("[FAIL] Expected 2 rows\n\n")
    }
    PG_DestroyResult(result6)

    // Cleanup
    PrintMessage("[TEST] DROP TABLE pg_test...\n")
    r7 = PG_Query(conn, "DROP TABLE pg_test")
    IfCondition NotEqual(r7, 0) ThenBlock: { PG_DestroyResult(r7) }
    PrintMessage("[PASS] Cleaned up\n\n")

    // Disconnect
    PrintMessage("[TEST] Disconnecting...\n")
    PG_Disconnect(conn)
    PrintMessage("[PASS] Disconnected\n\n")

    PrintMessage("=== ALL TESTS COMPLETE ===\n")
}

RunTask(Main)