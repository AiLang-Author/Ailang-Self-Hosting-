// =============================================================================
// Prime Sieve - Arena + MemorySet Version
// Uses REP STOSB for hardware-accelerated buffer clearing
// =============================================================================

LibraryImport.Arena

FixedPool.Config {
    "MAX_NUMBER": Initialize=1000000
    "RUN_SECONDS": Initialize=5
    "CLOCK_MONOTONIC": Initialize=1
    "SQRT_LIMIT": Initialize=1000
    "BUF_SIZE": Initialize=500000
    "EXPECTED_COUNT": Initialize=78498
}

FixedPool.State {
    "primes": Initialize=0
    "prime_count": Initialize=0
    "buffer": Initialize=0
    "ts_buf": Initialize=0
}

// =============================================================================
// Generate small primes using simple sieve
// =============================================================================
Function.GenerateSmallPrimes {
    Input: arr: Address
    Input: limit: Integer
    Output: Integer
    Body: {
        half = Divide(limit, 2)
        mini_sieve = Arena_AllocGeneral(half)
        
        // Use MemorySet for fast clear (REP STOSB)
        MemorySet(mini_sieve, 0, half)
        
        // Sieve for odd numbers: index i = number (2i+1)
        i = 1
        WhileLoop LessThan(i, half) {
            val = GetByte(mini_sieve, i)
            IfCondition EqualTo(val, 0) ThenBlock: {
                p = Add(Multiply(i, 2), 1)
                j = Divide(Multiply(p, p), 2)
                WhileLoop LessThan(j, half) {
                    SetByte(mini_sieve, j, 1)
                    j = Add(j, p)
                }
            }
            i = Add(i, 1)
        }
        
        // Extract primes into array
        count = 0
        i = 1
        WhileLoop LessThan(i, half) {
            val = GetByte(mini_sieve, i)
            IfCondition EqualTo(val, 0) ThenBlock: {
                prime = Add(Multiply(i, 2), 1)
                ArraySet(arr, count, prime)
                count = Add(count, 1)
            }
            i = Add(i, 1)
        }
        
        ReturnValue(count)
    }
}

// =============================================================================
// Run main sieve - uses MemorySet for fast clear
// =============================================================================
Function.RunSieve {
    Input: buffer: Address
    Input: buf_size: Integer
    Input: primes: Address
    Input: prime_count: Integer
    Output: Integer
    Body: {
        // REP STOSB - hardware accelerated!
        MemorySet(buffer, 0, buf_size)
        
        // Mark index 0 (represents 1) as not prime
        SetByte(buffer, 0, 1)
        
        // Sieve using small primes
        p_idx = 0
        WhileLoop LessThan(p_idx, prime_count) {
            prime = ArrayGet(primes, p_idx)
            
            // Start at prime^2, index = (p^2)/2
            start_idx = Divide(Multiply(prime, prime), 2)
            
            // Mark all odd multiples
            n_idx = start_idx
            WhileLoop LessThan(n_idx, buf_size) {
                SetByte(buffer, n_idx, 1)
                n_idx = Add(n_idx, prime)
            }
            
            p_idx = Add(p_idx, 1)
        }
        
        ReturnValue(1)
    }
}

// =============================================================================
// Count primes in sieve
// =============================================================================
Function.CountPrimes {
    Input: buffer: Address
    Input: buf_size: Integer
    Output: Integer
    Body: {
        count = 1  // Prime 2
        
        i = 1
        WhileLoop LessThan(i, buf_size) {
            val = GetByte(buffer, i)
            IfCondition EqualTo(val, 0) ThenBlock: {
                count = Add(count, 1)
            }
            i = Add(i, 1)
        }
        
        ReturnValue(count)
    }
}

// =============================================================================
// Get current time
// =============================================================================
Function.GetTimeSec {
    Input: ts_buf: Address
    Output: Integer
    Body: {
        dummy = SystemCall(228, Config.CLOCK_MONOTONIC, ts_buf)
        sec = Dereference(ts_buf)
        ReturnValue(sec)
    }
}

// =============================================================================
// MAIN
// =============================================================================
SubRoutine.Main {
    PrintMessage("=== Prime Sieve - Arena + MemorySet ===\n")
    
    Arena_Init()
    
    State.ts_buf = Arena_Alloc24()
    State.primes = ArrayCreate(200)
    
    PrintMessage("Generating small primes...\n")
    State.prime_count = GenerateSmallPrimes(State.primes, Config.SQRT_LIMIT)
    
    PrintMessage("Found ")
    PrintNumber(State.prime_count)
    PrintMessage(" small primes\n")
    
    buf_size = Config.BUF_SIZE
    State.buffer = Arena_AllocGeneral(buf_size)
    
    PrintMessage("Buffer: ")
    PrintNumber(buf_size)
    PrintMessage(" bytes\n")
    
    // === VALIDATION ===
    PrintMessage("\n--- Validation ---\n")
    
    dummy = RunSieve(State.buffer, buf_size, State.primes, State.prime_count)
    prime_count = CountPrimes(State.buffer, buf_size)
    
    PrintMessage("Count: ")
    PrintNumber(prime_count)
    PrintMessage(" (expect ")
    PrintNumber(Config.EXPECTED_COUNT)
    PrintMessage(")\n")
    
    IfCondition NotEqual(prime_count, Config.EXPECTED_COUNT) ThenBlock: {
        PrintMessage("VALIDATION FAILED!\n")
        Arena_Report()
        Exit(1)
    }
    
    PrintMessage("PASSED!\n")
    
    // === TIMED RUN ===
    PrintMessage("\n--- Timed Run (")
    PrintNumber(Config.RUN_SECONDS)
    PrintMessage("s) ---\n")
    
    start_sec = GetTimeSec(State.ts_buf)
    end_time_sec = Add(start_sec, Config.RUN_SECONDS)
    
    passes = 0
    keepgoing = 1
    
    WhileLoop EqualTo(keepgoing, 1) {
        dummy = RunSieve(State.buffer, buf_size, State.primes, State.prime_count)
        passes = Add(passes, 1)
        
        now = GetTimeSec(State.ts_buf)
        IfCondition GreaterEqual(now, end_time_sec) ThenBlock: {
            keepgoing = 0
        }
    }
    
    final_sec = GetTimeSec(State.ts_buf)
    elapsed = Subtract(final_sec, start_sec)
    
    PrintMessage("\n--- Results ---\n")
    PrintMessage("Passes: ")
    PrintNumber(passes)
    PrintMessage("\nTime: ")
    PrintNumber(elapsed)
    PrintMessage("s\n")
    
    // Passes per second
    pps = Divide(passes, elapsed)
    PrintMessage("Passes/sec: ")
    PrintNumber(pps)
    PrintMessage("\n")
    
    // Drag race output
    PrintMessage("\n--- Drag Race ---\n")
    PrintMessage("ailang-memset;")
    PrintNumber(passes)
    PrintMessage(";")
    PrintNumber(elapsed)
    PrintMessage(";1;algorithm=base,faithful=no,bits=8\n")
    
    Arena_Report()
    
    ArrayDestroy(State.primes)
    PrintMessage("\nDone.\n")
}

RunTask(Main)