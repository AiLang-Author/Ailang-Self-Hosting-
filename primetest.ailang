SubRoutine.Main {
    limit = 1000000
    count = 0
    n = 2
    
    WhileLoop LessThan(n, limit) {
        is_prime = 1
        i = 2
        WhileLoop LessThan(Multiply(i, i), Add(n, 1)) {
            IfCondition EqualTo(Modulo(n, i), 0) ThenBlock: {
                is_prime = 0
            }
            i = Add(i, 1)
        }
        IfCondition EqualTo(is_prime, 1) ThenBlock: {
            count = Add(count, 1)
        }
        n = Add(n, 1)
    }
    
    PrintMessage("Primes found: ")
    PrintNumber(count)
    PrintMessage("\n")
}
RunTask(Main)