// Narrow where a* crashes — compile vs match.
LibraryImport.Arena
LibraryImport.Regex_Thompson

// Search-style helper: Regex_Match is anchored at start_pos. For grep-
// style "match anywhere in line" semantics we iterate.
Function.MatchAnywhere {
    Input: regex: Address
    Input: text: Address
    Output: Integer
    Body: {
        tlen = StringLength(text)
        start = 0
        WhileLoop LessEqual(start, tlen) {
            m = Regex_Match(regex, text, start)
            IfCondition GreaterEqual(m, 0) ThenBlock: { ReturnValue(1) }
            start = Add(start, 1)
        }
        ReturnValue(0)
    }
}

Function.RunCase {
    Input: name: Address
    Input: pattern: Address
    Input: text: Address
    Input: expect: Integer
    Body: {
        r = Regex_Compile(pattern, 0)
        IfCondition EqualTo(r, 0) ThenBlock: {
            SystemCall(1, 1, "COMPILE_FAIL ", 13)
            SystemCall(1, 1, name, StringLength(name))
            SystemCall(1, 1, "\n", 1)
        } ElseBlock: {
            matched = MatchAnywhere(r, text)
            IfCondition EqualTo(matched, expect) ThenBlock: {
                SystemCall(1, 1, "PASS ", 5)
            } ElseBlock: {
                SystemCall(1, 1, "FAIL ", 5)
            }
            SystemCall(1, 1, name, StringLength(name))
            SystemCall(1, 1, "\n", 1)
            Regex_Free(r)
        }
    }
}

SubRoutine.Main {
    RunCase("literal",         "hello",       "hello world", 1)
    RunCase("literal-nomatch", "xyz",         "hello",       0)
    RunCase("dot",             "h.llo",       "hello",       1)
    RunCase("star-bare",       "a*",          "aaa",         1)
    RunCase("star-mid",        "he*l",        "heeeeeel",    1)
    RunCase("star-zero",       "he*l",        "hl",          1)
    RunCase("plus",            "he+l",        "heeel",       1)
    RunCase("plus-zero-fail",  "he+l",        "hl",          0)
    RunCase("question-yes",    "he?l",        "hel",         1)
    RunCase("question-no",     "he?l",        "hl",          1)
    RunCase("anchor-start",    "^hello",      "hello world", 1)
    RunCase("anchor-start-no", "^world",      "hello world", 0)
    RunCase("anchor-end",      "world$",      "hello world", 1)
    RunCase("anchor-end-no",   "hello$",      "hello world", 0)
    RunCase("class-single",    "[a]",         "abc",         1)
    RunCase("class-multi",     "[abc]",       "xxxbxxx",     1)
    RunCase("class-no-match",  "[xyz]",       "abc",         0)
    RunCase("class-range-09",  "[0-9]",       "abc123",      1)
    RunCase("class-range-az",  "[a-c]",       "xbz",         1)
    RunCase("class-neg",       "[^abc]",      "abc",         0)
    RunCase("class-neg-yes",   "[^abc]",      "xyz",         1)
    RunCase("alternation-a",   "cat|dog",     "it is a cat", 1)
    RunCase("alternation-b",   "cat|dog",     "it is a dog", 1)
    RunCase("alternation-no",  "cat|dog",     "it is a bird",0)
    SystemCall(60, 0)
}
RunTask(Main)
