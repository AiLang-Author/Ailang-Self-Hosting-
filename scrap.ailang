// test_flattened.ailang
// Same tests but with flattened return patterns
// Testing if nested ReturnValue(FunctionCall()) is the bug

Function.Test1_Return {
    Input: x: Integer
    Output: Integer
    Body: {
        ReturnValue(x)
    }
}

Function.Test2_FlatAdd {
    Input: a: Integer
    Input: b: Integer  
    Output: Integer
    Body: {
        result = Add(a, b)
        ReturnValue(result)
    }
}

Function.Test3_AddLiteral {
    Input: x: Integer
    Output: Integer
    Body: {
        result = Add(x, 1)
        ReturnValue(result)
    }
}

Function.Test4_NestedFirst {
    Input: x: Integer
    Output: Integer
    Body: {
        result = Add(Multiply(x, 2), 1)
        ReturnValue(result)
    }
}

Function.Test5_NestedSecond {
    Input: x: Integer
    Output: Integer
    Body: {
        result = Add(1, Multiply(x, 2))
        ReturnValue(result)
    }
}

Function.Test6_BothNested {
    Input: x: Integer
    Output: Integer
    Body: {
        result = Add(Multiply(x, 2), Subtract(x, 1))
        ReturnValue(result)
    }
}

SubRoutine.Main {
    PrintMessage("=== Flattened Return Test ===\n")
    
    PrintMessage("Test1: ")
    r1 = Test1_Return(5)
    PrintNumber(r1)
    PrintMessage("\n")
    
    PrintMessage("Test2: ")
    r2 = Test2_FlatAdd(3, 4)
    PrintNumber(r2)
    PrintMessage("\n")
    
    PrintMessage("Test3: ")
    r3 = Test3_AddLiteral(10)
    PrintNumber(r3)
    PrintMessage("\n")
    
    PrintMessage("Test4: ")
    r4 = Test4_NestedFirst(5)
    PrintNumber(r4)
    PrintMessage("\n")
    
    PrintMessage("Test5: ")
    r5 = Test5_NestedSecond(5)
    PrintNumber(r5)
    PrintMessage("\n")
    
    PrintMessage("Test6: ")
    r6 = Test6_BothNested(5)
    PrintNumber(r6)
    PrintMessage("\n")
    
    PrintMessage("=== Done ===\n")
}

RunTask(Main)