// test_pool_08.ailang
LibraryImport.Arena

LinkagePool.SimplePool {
    "x": Initialize=0
    "y": Initialize=100
}

SubRoutine.Main {
    Arena_Init()
    
    ptr = AllocateLinkage(LinkagePool.SimplePool)
    
    PrintMessage("Reading without write first:\n")
    val_x = ptr.x
    PrintNumber(val_x)
    PrintMessage("\n")
    
    Exit(0)
}

RunTask(Main)