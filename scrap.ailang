// =============================================================================
// ExactPattern.ailang - Test exact patterns that failed
// =============================================================================

// Inner function WITH a loop (like InnerWork)
Function.InnerWithLoop {
    Input: limit: Integer
    Output: Integer
    Body: {
        count = 0
        k = 0
        WhileLoop LessThan(k, limit) {
            count = Add(count, 1)
            k = Add(k, 1)
        }
        ReturnValue(count)
    }
}

// 2-param function with loop that calls function with loop
Function.TwoParamLoopCalls {
    Input: outer: Integer
    Input: inner: Integer
    Output: Integer
    Body: {
        total = 0
        j = 0
        WhileLoop LessThan(j, outer) {
            result = InnerWithLoop(inner)
            total = Add(total, result)
            j = Add(j, 1)
        }
        ReturnValue(total)
    }
}

// 1-param version for comparison
Function.OneParamLoopCalls {
    Input: iterations: Integer
    Output: Integer
    Body: {
        total = 0
        j = 0
        WhileLoop LessThan(j, iterations) {
            result = InnerWithLoop(10)
            total = Add(total, result)
            j = Add(j, 1)
        }
        ReturnValue(total)
    }
}

// 3-param version 
Function.ThreeParamLoopCalls {
    Input: outer: Integer
    Input: inner: Integer
    Input: extra: Integer
    Output: Integer
    Body: {
        total = extra
        j = 0
        WhileLoop LessThan(j, outer) {
            result = InnerWithLoop(inner)
            total = Add(total, result)
            j = Add(j, 1)
        }
        ReturnValue(total)
    }
}

SubRoutine.Main {
    PrintMessage("=== Exact Pattern Tests ===\n\n")
    
    // TEST A: 1-param function with loop calling function with loop
    ts1 = 86500
    ts2 = 86505
    PrintMessage("TEST A: 1-param function (loop calls func with loop)\n")
    PrintMessage("  Before: ts1=") PrintNumber(ts1) PrintMessage(" ts2=") PrintNumber(ts2) PrintMessage("\n")
    
    i = 0
    WhileLoop LessThan(i, 5) {
        dummy = OneParamLoopCalls(3)
        i = Add(i, 1)
    }
    
    PrintMessage("  After:  ts1=") PrintNumber(ts1) PrintMessage(" ts2=") PrintNumber(ts2) PrintMessage("\n")
    IfCondition NotEqual(ts1, 86500) ThenBlock: {
        PrintMessage("  *** CORRUPTED! ***\n")
    } ElseBlock: {
        PrintMessage("  OK\n")
    }
    PrintMessage("\n")
    
    // TEST B: 2-param function with loop calling function with loop
    ts1 = 86500
    ts2 = 86505
    PrintMessage("TEST B: 2-param function (loop calls func with loop)\n")
    PrintMessage("  Before: ts1=") PrintNumber(ts1) PrintMessage(" ts2=") PrintNumber(ts2) PrintMessage("\n")
    
    i = 0
    WhileLoop LessThan(i, 5) {
        dummy = TwoParamLoopCalls(3, 10)
        i = Add(i, 1)
    }
    
    PrintMessage("  After:  ts1=") PrintNumber(ts1) PrintMessage(" ts2=") PrintNumber(ts2) PrintMessage("\n")
    IfCondition NotEqual(ts1, 86500) ThenBlock: {
        PrintMessage("  *** CORRUPTED! ***\n")
    } ElseBlock: {
        PrintMessage("  OK\n")
    }
    PrintMessage("\n")
    
    // TEST C: 3-param function with loop calling function with loop
    ts1 = 86500
    ts2 = 86505
    PrintMessage("TEST C: 3-param function (loop calls func with loop)\n")
    PrintMessage("  Before: ts1=") PrintNumber(ts1) PrintMessage(" ts2=") PrintNumber(ts2) PrintMessage("\n")
    
    i = 0
    WhileLoop LessThan(i, 5) {
        dummy = ThreeParamLoopCalls(3, 10, 0)
        i = Add(i, 1)
    }
    
    PrintMessage("  After:  ts1=") PrintNumber(ts1) PrintMessage(" ts2=") PrintNumber(ts2) PrintMessage("\n")
    IfCondition NotEqual(ts1, 86500) ThenBlock: {
        PrintMessage("  *** CORRUPTED! ***\n")
    } ElseBlock: {
        PrintMessage("  OK\n")
    }
    PrintMessage("\n")
    
    // TEST D: Direct copy of NestedTest's failing pattern
    ts1 = 86500
    ts2 = 86505
    passes = 0
    PrintMessage("TEST D: EXACT NestedTest pattern\n")
    PrintMessage("  Before: ts1=") PrintNumber(ts1) PrintMessage(" ts2=") PrintNumber(ts2) PrintMessage("\n")
    
    i = 0
    WhileLoop LessThan(i, 5) {
        result = TwoParamLoopCalls(3, 10)
        passes = Add(passes, 1)
        i = Add(i, 1)
    }
    
    PrintMessage("  After:  ts1=") PrintNumber(ts1) PrintMessage(" ts2=") PrintNumber(ts2) PrintMessage("\n")
    PrintMessage("  passes=") PrintNumber(passes) PrintMessage(" (expect 5)\n")
    IfCondition NotEqual(ts1, 86500) ThenBlock: {
        PrintMessage("  *** CORRUPTED! ***\n")
    } ElseBlock: {
        PrintMessage("  OK\n")
    }
    PrintMessage("\n")
    
    PrintMessage("=== Done ===\n")
}

RunTask(Main)