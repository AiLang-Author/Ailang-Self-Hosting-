
SubRoutine.Main {
    PrintMessage("DebugPerf Test\n")
    PrintMessage("==============\n\n")
    
    DebugPerf.Start("outer")
    
    DebugPerf.Start("loop")
    i = 0
    WhileLoop LessThan(i, 10000) {
        x = Add(i, 1)
        i = x
    }
    DebugPerf.End("loop")
    
    DebugPerf.Start("simple")
    y = Add(100, 200)
    DebugPerf.End("simple")
    
    DebugPerf.End("outer")
    
    PrintMessage("\nDone!\n")
}

RunTask(Main)