SubRoutine.Main {
    PrintMessage("PrintHex Test\n")
    PrintMessage("==============\n")
    
    PrintMessage("0 = ")
    PrintHex(0)
    PrintMessage("\n")
    
    PrintMessage("255 = ")
    PrintHex(255)
    PrintMessage("\n")
    
    PrintMessage("256 = ")
    PrintHex(256)
    PrintMessage("\n")
    
    PrintMessage("4096 = ")
    PrintHex(4096)
    PrintMessage("\n")
    
    PrintMessage("65535 = ")
    PrintHex(65535)
    PrintMessage("\n")
    
    PrintMessage("0xDEADBEEF = ")
    PrintHex(3735928559)
    PrintMessage("\n")
    
    PrintMessage("\nDone!\n")
}

RunTask(Main)