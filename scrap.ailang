// test_atomic.ailang
// Standalone test for AtomicCompareSwap, AtomicExchange, AtomicAdd

SubRoutine.Main {
    PrintMessage("==============================================\n")
    PrintMessage("  ATOMIC OPERATIONS TEST\n")
    PrintMessage("==============================================\n")

    // Allocate a test word (use mmap since no Arena)
    addr = SystemCall(9, 0, 4096, 3, 34, -1, 0)
    StoreValue(addr, 0)

    passed = 0
    failed = 0

    // TEST 1: CAS on 0, expect success
    PrintMessage("\nTEST 1: CAS 0 -> 42\n")
    StoreValue(addr, 0)
    old = AtomicCompareSwap(addr, 0, 42)
    PrintMessage("  old=")
    PrintNumber(old)
    PrintMessage(" val=")
    PrintNumber(Dereference(addr))
    PrintMessage("\n")
    IfCondition And(EqualTo(old, 0), EqualTo(Dereference(addr), 42)) ThenBlock: {
        PrintMessage("  PASS\n")
        passed = Add(passed, 1)
    } ElseBlock: {
        PrintMessage("  FAIL\n")
        failed = Add(failed, 1)
    }

    // TEST 2: CAS with wrong expected, should fail
    PrintMessage("\nTEST 2: CAS expect 0 but value is 42 — should fail\n")
    old = AtomicCompareSwap(addr, 0, 99)
    PrintMessage("  old=")
    PrintNumber(old)
    PrintMessage(" val=")
    PrintNumber(Dereference(addr))
    PrintMessage("\n")
    IfCondition And(EqualTo(old, 42), EqualTo(Dereference(addr), 42)) ThenBlock: {
        PrintMessage("  PASS (swap did not happen)\n")
        passed = Add(passed, 1)
    } ElseBlock: {
        PrintMessage("  FAIL\n")
        failed = Add(failed, 1)
    }

    // TEST 3: CAS with correct expected
    PrintMessage("\nTEST 3: CAS 42 -> 100\n")
    old = AtomicCompareSwap(addr, 42, 100)
    PrintMessage("  old=")
    PrintNumber(old)
    PrintMessage(" val=")
    PrintNumber(Dereference(addr))
    PrintMessage("\n")
    IfCondition And(EqualTo(old, 42), EqualTo(Dereference(addr), 100)) ThenBlock: {
        PrintMessage("  PASS\n")
        passed = Add(passed, 1)
    } ElseBlock: {
        PrintMessage("  FAIL\n")
        failed = Add(failed, 1)
    }

    // TEST 4: AtomicExchange
    PrintMessage("\nTEST 4: AtomicExchange 100 -> 777\n")
    old = AtomicExchange(addr, 777)
    PrintMessage("  old=")
    PrintNumber(old)
    PrintMessage(" val=")
    PrintNumber(Dereference(addr))
    PrintMessage("\n")
    IfCondition And(EqualTo(old, 100), EqualTo(Dereference(addr), 777)) ThenBlock: {
        PrintMessage("  PASS\n")
        passed = Add(passed, 1)
    } ElseBlock: {
        PrintMessage("  FAIL\n")
        failed = Add(failed, 1)
    }

    // TEST 5: AtomicAdd
    PrintMessage("\nTEST 5: AtomicAdd 777 + 23\n")
    old = AtomicAdd(addr, 23)
    PrintMessage("  old=")
    PrintNumber(old)
    PrintMessage(" val=")
    PrintNumber(Dereference(addr))
    PrintMessage("\n")
    IfCondition And(EqualTo(old, 777), EqualTo(Dereference(addr), 800)) ThenBlock: {
        PrintMessage("  PASS\n")
        passed = Add(passed, 1)
    } ElseBlock: {
        PrintMessage("  FAIL\n")
        failed = Add(failed, 1)
    }

    // TEST 6: CAS loop (simulate mutex acquire)
    PrintMessage("\nTEST 6: CAS loop — lock/unlock pattern\n")
    StoreValue(addr, 0)
    // Lock: CAS 0 -> 1
    old = AtomicCompareSwap(addr, 0, 1)
    lock_ok = EqualTo(old, 0)
    // Unlock: exchange back to 0
    old = AtomicExchange(addr, 0)
    unlock_ok = EqualTo(old, 1)
    PrintMessage("  lock=")
    PrintNumber(lock_ok)
    PrintMessage(" unlock=")
    PrintNumber(unlock_ok)
    PrintMessage(" final=")
    PrintNumber(Dereference(addr))
    PrintMessage("\n")
    IfCondition And(EqualTo(lock_ok, 1), EqualTo(unlock_ok, 1)) ThenBlock: {
        PrintMessage("  PASS\n")
        passed = Add(passed, 1)
    } ElseBlock: {
        PrintMessage("  FAIL\n")
        failed = Add(failed, 1)
    }

    // SUMMARY
    PrintMessage("\n==============================================\n")
    PrintMessage("  Passed: ")
    PrintNumber(passed)
    PrintMessage("\n  Failed: ")
    PrintNumber(failed)
    PrintMessage("\n")
    IfCondition EqualTo(failed, 0) ThenBlock: {
        PrintMessage("  ALL ATOMIC TESTS PASSED!\n")
    } ElseBlock: {
        PrintMessage("  SOME TESTS FAILED\n")
    }
    PrintMessage("==============================================\n")

    // Cleanup
    SystemCall(11, addr, 4096, 0, 0, 0, 0)
}

RunTask(Main)