// test_hex_literals.ailang
// Test hex, binary, and octal literal support in lexer

FixedPool.T {
    "v": Initialize=0, CanChange=True
    "passed": Initialize=0, CanChange=True
    "failed": Initialize=0, CanChange=True
}

SubRoutine.Pass {
    T.passed = Add(T.passed, 1)
    PrintMessage(" [OK]\n")
}

SubRoutine.Fail {
    T.failed = Add(T.failed, 1)
    PrintMessage(" [FAIL]\n")
}

SubRoutine.Main {
    PrintMessage("=== Hex/Binary/Octal Literal Tests ===\n\n")
    
    // ========================================
    // HEX TESTS
    // ========================================
    PrintMessage("HEX LITERALS:\n")
    
    PrintMessage("  0x10 = ")
    T.v = 0x10
    PrintNumber(T.v)
    IfCondition EqualTo(T.v, 16) ThenBlock: { RunTask(Pass) } ElseBlock: { RunTask(Fail) }
    
    PrintMessage("  0x48 = ")
    T.v = 0x48
    PrintNumber(T.v)
    IfCondition EqualTo(T.v, 72) ThenBlock: { RunTask(Pass) } ElseBlock: { RunTask(Fail) }
    
    PrintMessage("  0xFF = ")
    T.v = 0xFF
    PrintNumber(T.v)
    IfCondition EqualTo(T.v, 255) ThenBlock: { RunTask(Pass) } ElseBlock: { RunTask(Fail) }
    
    PrintMessage("  0xB8 = ")
    T.v = 0xB8
    PrintNumber(T.v)
    IfCondition EqualTo(T.v, 184) ThenBlock: { RunTask(Pass) } ElseBlock: { RunTask(Fail) }
    
    PrintMessage("  0x1234 = ")
    T.v = 0x1234
    PrintNumber(T.v)
    IfCondition EqualTo(T.v, 4660) ThenBlock: { RunTask(Pass) } ElseBlock: { RunTask(Fail) }
    
    PrintMessage("  0xDEAD = ")
    T.v = 0xDEAD
    PrintNumber(T.v)
    IfCondition EqualTo(T.v, 57005) ThenBlock: { RunTask(Pass) } ElseBlock: { RunTask(Fail) }
    
    // ========================================
    // BINARY TESTS
    // ========================================
    PrintMessage("\nBINARY LITERALS:\n")
    
    PrintMessage("  0b0 = ")
    T.v = 0b0
    PrintNumber(T.v)
    IfCondition EqualTo(T.v, 0) ThenBlock: { RunTask(Pass) } ElseBlock: { RunTask(Fail) }
    
    PrintMessage("  0b1 = ")
    T.v = 0b1
    PrintNumber(T.v)
    IfCondition EqualTo(T.v, 1) ThenBlock: { RunTask(Pass) } ElseBlock: { RunTask(Fail) }
    
    PrintMessage("  0b1010 = ")
    T.v = 0b1010
    PrintNumber(T.v)
    IfCondition EqualTo(T.v, 10) ThenBlock: { RunTask(Pass) } ElseBlock: { RunTask(Fail) }
    
    PrintMessage("  0b11111111 = ")
    T.v = 0b11111111
    PrintNumber(T.v)
    IfCondition EqualTo(T.v, 255) ThenBlock: { RunTask(Pass) } ElseBlock: { RunTask(Fail) }
    
    PrintMessage("  0b10000000 = ")
    T.v = 0b10000000
    PrintNumber(T.v)
    IfCondition EqualTo(T.v, 128) ThenBlock: { RunTask(Pass) } ElseBlock: { RunTask(Fail) }
    
    // ========================================
    // OCTAL TESTS
    // ========================================
    PrintMessage("\nOCTAL LITERALS:\n")
    
    PrintMessage("  0o0 = ")
    T.v = 0o0
    PrintNumber(T.v)
    IfCondition EqualTo(T.v, 0) ThenBlock: { RunTask(Pass) } ElseBlock: { RunTask(Fail) }
    
    PrintMessage("  0o7 = ")
    T.v = 0o7
    PrintNumber(T.v)
    IfCondition EqualTo(T.v, 7) ThenBlock: { RunTask(Pass) } ElseBlock: { RunTask(Fail) }
    
    PrintMessage("  0o10 = ")
    T.v = 0o10
    PrintNumber(T.v)
    IfCondition EqualTo(T.v, 8) ThenBlock: { RunTask(Pass) } ElseBlock: { RunTask(Fail) }
    
    PrintMessage("  0o755 = ")
    T.v = 0o755
    PrintNumber(T.v)
    IfCondition EqualTo(T.v, 493) ThenBlock: { RunTask(Pass) } ElseBlock: { RunTask(Fail) }
    
    PrintMessage("  0o777 = ")
    T.v = 0o777
    PrintNumber(T.v)
    IfCondition EqualTo(T.v, 511) ThenBlock: { RunTask(Pass) } ElseBlock: { RunTask(Fail) }
    
    // ========================================
    // X86 CRITICAL VALUES
    // ========================================
    PrintMessage("\nX86 CRITICAL VALUES:\n")
    
    PrintMessage("  REX.W (0x48) = ")
    T.v = 0x48
    PrintNumber(T.v)
    IfCondition EqualTo(T.v, 72) ThenBlock: { RunTask(Pass) } ElseBlock: { RunTask(Fail) }
    
    PrintMessage("  MOV RAX (0xB8) = ")
    T.v = 0xB8
    PrintNumber(T.v)
    IfCondition EqualTo(T.v, 184) ThenBlock: { RunTask(Pass) } ElseBlock: { RunTask(Fail) }
    
    PrintMessage("  ModRM 0xC0 = ")
    T.v = 0xC0
    PrintNumber(T.v)
    IfCondition EqualTo(T.v, 192) ThenBlock: { RunTask(Pass) } ElseBlock: { RunTask(Fail) }
    
    PrintMessage("  ModRM 0xD8 = ")
    T.v = 0xD8
    PrintNumber(T.v)
    IfCondition EqualTo(T.v, 216) ThenBlock: { RunTask(Pass) } ElseBlock: { RunTask(Fail) }
    
    // ========================================
    // SUMMARY
    // ========================================
    PrintMessage("\n========================================\n")
    PrintMessage("RESULTS: ")
    PrintNumber(T.passed)
    PrintMessage(" passed, ")
    PrintNumber(T.failed)
    PrintMessage(" failed\n")
    
    IfCondition EqualTo(T.failed, 0) ThenBlock: {
        PrintMessage("*** ALL TESTS PASSED ***\n")
    } ElseBlock: {
        PrintMessage("*** SOME TESTS FAILED ***\n")
    }
}

RunTask(Main)