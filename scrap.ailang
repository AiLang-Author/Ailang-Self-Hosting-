LibraryImport.Arena

LinkagePool.Node {
    "value": Initialize=0
    "next": Initialize=0, PointerTo=LinkagePool.Node
}

LinkagePool.List {
    "head": Initialize=0, PointerTo=LinkagePool.Node
    "tail": Initialize=0, PointerTo=LinkagePool.Node
    "count": Initialize=0
}

SubRoutine.Main {
    Arena_Init()
    
    list = AllocateLinkage(LinkagePool.List)
    
    node1 = AllocateLinkage(LinkagePool.Node)
    node1@value = 100
    node1@next = 0
    
    node2 = AllocateLinkage(LinkagePool.Node)
    node2@value = 200
    node2@next = 0
    
    // Set up list
    list@head = node1
    list@tail = node2
    list@count = 2
    
    // Link nodes
    node1@next = node2
    
    // THIS IS THE TEST - read through pointer field
    head = list@head          // Should know head is LinkagePool.Node
    PrintMessage("head@value = ")
    PrintNumber(head@value)   // Should work!
    PrintMessage("\n")
    
    // Chain through
    second = head@next        // Should know second is LinkagePool.Node
    PrintMessage("second@value = ")
    PrintNumber(second@value) // Should work!
    PrintMessage("\n")
    
    PrintMessage("Done!\n")
    Exit(0)
}

RunTask(Main)