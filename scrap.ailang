LibraryImport.Arena

SubRoutine.Main {
    PrintMessage("DebugMemory.Dump Test\n")
    PrintMessage("=====================\n\n")
    
    buffer = Allocate(32)
    SetByte(buffer, 0, 72)    // 'H'
    SetByte(buffer, 1, 101)   // 'e'
    SetByte(buffer, 2, 108)   // 'l'
    SetByte(buffer, 3, 108)   // 'l'
    SetByte(buffer, 4, 111)   // 'o'
    SetByte(buffer, 5, 32)    // ' '
    SetByte(buffer, 6, 87)    // 'W'
    SetByte(buffer, 7, 111)   // 'o'
    SetByte(buffer, 8, 114)   // 'r'
    SetByte(buffer, 9, 108)   // 'l'
    SetByte(buffer, 10, 100)  // 'd'
    SetByte(buffer, 11, 0)    // null
    
    DebugMemory.Dump(buffer, 32, "hello buffer")
    
    Deallocate(buffer, 32)
    
    PrintMessage("\nDone!\n")
}

RunTask(Main)
