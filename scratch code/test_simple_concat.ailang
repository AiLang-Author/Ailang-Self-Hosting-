// test_simple_concat.ailang
SubRoutine.Main {
    PrintMessage("Start\n")
    
    s = "Hello "
    PrintMessage("After first assign\n")
    
    s = StringConcat(s, "World")
    PrintMessage("After concat\n")
    
    PrintMessage(s)
    PrintMessage("\n")
    
    PrintMessage("Done\n")
}

RunTask(Main)