//test_strcmp.ailang 
SubRoutine.Main {
    PrintMessage("Testing StringCompare SSE2:\n")
    
    r = StringCompare("Hello", "Hello")
    PrintMessage("Hello vs Hello: ")
    PrintNumber(r)
    PrintMessage("\n")
    
    r = StringCompare("Hello", "World")
    PrintMessage("Hello vs World: ")
    PrintNumber(r)
    PrintMessage("\n")
    
    r = StringCompare("X86_MovRaxDerefRsp", "X86_MovRaxDerefRbx")
    PrintMessage("X86_MovRaxDerefRsp vs X86_MovRaxDerefRbx: ")
    PrintNumber(r)
    PrintMessage("\n")
    
    r = StringCompare("Emit_MovRaxDerefRax", "Emit_MovRaxDerefRbx")
    PrintMessage("Emit_MovRaxDerefRax vs Emit_MovRaxDerefRbx: ")
    PrintNumber(r)
    PrintMessage("\n")
}
RunTask(Main)