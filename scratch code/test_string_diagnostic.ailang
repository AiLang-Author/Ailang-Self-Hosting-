// test_string_diagnostic.ailang
// Comprehensive SSE2 string method diagnostic suite

// =============================================================================
// HELPER: Print test result
// =============================================================================
Function.PrintResult {
    Input: name: Address
    Input: got: Integer
    Input: expected: Integer
    Body: {
        PrintMessage(name)
        PrintMessage(": got ")
        PrintNumber(got)
        PrintMessage(", expected ")
        PrintNumber(expected)
        IfCondition EqualTo(got, expected) ThenBlock: {
            PrintMessage(" [PASS]\n")
        } ElseBlock: {
            PrintMessage(" [FAIL] <<<\n")
        }
    }
}

Function.PrintNonZeroResult {
    Input: name: Address
    Input: got: Integer
    Body: {
        PrintMessage(name)
        PrintMessage(": got ")
        PrintNumber(got)
        IfCondition NotEqual(got, 0) ThenBlock: {
            PrintMessage(" [PASS] (non-zero)\n")
        } ElseBlock: {
            PrintMessage(" [FAIL] <<<\n")
        }
    }
}

// =============================================================================
// TEST: StringLength at various boundaries
// =============================================================================
SubRoutine.TestStringLength {
    PrintMessage("\n")
    PrintMessage("============================================================\n")
    PrintMessage("TEST: StringLength - Boundary Testing\n")
    PrintMessage("============================================================\n")
    
    len = StringLength("")
    PrintResult("Empty string", len, 0)
    
    len = StringLength("A")
    PrintResult("1 char", len, 1)
    
    len = StringLength("123456789012345")
    PrintResult("15 chars", len, 15)
    
    len = StringLength("1234567890123456")
    PrintResult("16 chars", len, 16)
    
    len = StringLength("12345678901234567")
    PrintResult("17 chars", len, 17)
    
    len = StringLength("1234567890123456789012345678901")
    PrintResult("31 chars", len, 31)
    
    len = StringLength("12345678901234567890123456789012")
    PrintResult("32 chars", len, 32)
    
    len = StringLength("123456789012345678901234567890123")
    PrintResult("33 chars", len, 33)
    
    len = StringLength("123456789012345678901234567890123456789012345678")
    PrintResult("48 chars", len, 48)
    
    len = StringLength("123456789012345678901234567890123456789012345678901234567890123")
    PrintResult("63 chars", len, 63)
    
    len = StringLength("1234567890123456789012345678901234567890123456789012345678901234")
    PrintResult("64 chars", len, 64)
}

// =============================================================================
// TEST: StringCompare - Equal strings
// =============================================================================
SubRoutine.TestStringCompareEqual {
    PrintMessage("\n")
    PrintMessage("============================================================\n")
    PrintMessage("TEST: StringCompare - Equal Strings\n")
    PrintMessage("============================================================\n")
    
    cmp = StringCompare("", "")
    PrintResult("Empty vs Empty", cmp, 0)
    
    cmp = StringCompare("A", "A")
    PrintResult("A vs A", cmp, 0)
    
    cmp = StringCompare("123456789012345", "123456789012345")
    PrintResult("15 chars equal", cmp, 0)
    
    cmp = StringCompare("1234567890123456", "1234567890123456")
    PrintResult("16 chars equal", cmp, 0)
    
    cmp = StringCompare("12345678901234567", "12345678901234567")
    PrintResult("17 chars equal", cmp, 0)
    
    cmp = StringCompare("12345678901234567890123456789012", "12345678901234567890123456789012")
    PrintResult("32 chars equal", cmp, 0)
    
    cmp = StringCompare("123456789012345678901234567890123", "123456789012345678901234567890123")
    PrintResult("33 chars equal", cmp, 0)
}

// =============================================================================
// TEST: StringCompare - Differ at position 0
// =============================================================================
SubRoutine.TestStringCompareDiffPos0 {
    PrintMessage("\n")
    PrintMessage("============================================================\n")
    PrintMessage("TEST: StringCompare - Differ at Position 0\n")
    PrintMessage("============================================================\n")
    
    cmp = StringCompare("A", "B")
    PrintNonZeroResult("A vs B", cmp)
    
    cmp = StringCompare("A234567890123456", "B234567890123456")
    PrintNonZeroResult("A234... vs B234... (16 chars)", cmp)
    
    cmp = StringCompare("A2345678901234567890123456789012", "B2345678901234567890123456789012")
    PrintNonZeroResult("32 chars differ at 0", cmp)
}

// =============================================================================
// TEST: StringCompare - Differ at position 15 (end of first chunk)
// =============================================================================
SubRoutine.TestStringCompareDiffPos15 {
    PrintMessage("\n")
    PrintMessage("============================================================\n")
    PrintMessage("TEST: StringCompare - Differ at Position 15\n")
    PrintMessage("============================================================\n")
    
    cmp = StringCompare("123456789012345A", "123456789012345B")
    PrintNonZeroResult("16 chars differ at 15", cmp)
    
    cmp = StringCompare("123456789012345A7890123456789012", "123456789012345B7890123456789012")
    PrintNonZeroResult("32 chars differ at 15", cmp)
}

// =============================================================================
// TEST: StringCompare - Differ at position 16 (start of second chunk)
// =============================================================================
SubRoutine.TestStringCompareDiffPos16 {
    PrintMessage("\n")
    PrintMessage("============================================================\n")
    PrintMessage("TEST: StringCompare - Differ at Position 16\n")
    PrintMessage("============================================================\n")
    
    cmp = StringCompare("1234567890123456A", "1234567890123456B")
    PrintNonZeroResult("17 chars differ at 16", cmp)
    
    cmp = StringCompare("1234567890123456A890123456789012", "1234567890123456B890123456789012")
    PrintNonZeroResult("32 chars differ at 16", cmp)
}

// =============================================================================
// TEST: StringCompare - Differ at position 17 (THE BUG CASE)
// =============================================================================
SubRoutine.TestStringCompareDiffPos17 {
    PrintMessage("\n")
    PrintMessage("============================================================\n")
    PrintMessage("TEST: StringCompare - Differ at Position 17 (BUG CASE)\n")
    PrintMessage("============================================================\n")
    
    cmp = StringCompare("12345678901234567AB", "12345678901234567XB")
    PrintNonZeroResult("19 chars differ at 17", cmp)
    
    cmp = StringCompare("Emit_MovRaxDerefRax", "Emit_MovRaxDerefRbx")
    PrintNonZeroResult("Emit_MovRaxDerefRax vs Rbx", cmp)
    
    cmp = StringCompare("X86_MovRaxDerefRsp", "X86_MovRaxDerefRbx")
    PrintNonZeroResult("X86_MovRaxDerefRsp vs Rbx", cmp)
}

// =============================================================================
// TEST: StringCompare - Differ at last char (various lengths)
// =============================================================================
SubRoutine.TestStringCompareDiffLast {
    PrintMessage("\n")
    PrintMessage("============================================================\n")
    PrintMessage("TEST: StringCompare - Differ at Last Character\n")
    PrintMessage("============================================================\n")
    
    cmp = StringCompare("12345678901234A", "12345678901234B")
    PrintNonZeroResult("15 chars differ at last", cmp)
    
    cmp = StringCompare("123456789012345A", "123456789012345B")
    PrintNonZeroResult("16 chars differ at last", cmp)
    
    cmp = StringCompare("1234567890123456A", "1234567890123456B")
    PrintNonZeroResult("17 chars differ at last", cmp)
    
    cmp = StringCompare("12345678901234567A", "12345678901234567B")
    PrintNonZeroResult("18 chars differ at last", cmp)
    
    cmp = StringCompare("123456789012345678A", "123456789012345678B")
    PrintNonZeroResult("19 chars differ at last", cmp)
    
    cmp = StringCompare("1234567890123456789A", "1234567890123456789B")
    PrintNonZeroResult("20 chars differ at last", cmp)
    
    cmp = StringCompare("123456789012345678901234567890A", "123456789012345678901234567890B")
    PrintNonZeroResult("31 chars differ at last", cmp)
    
    cmp = StringCompare("1234567890123456789012345678901A", "1234567890123456789012345678901B")
    PrintNonZeroResult("32 chars differ at last", cmp)
    
    cmp = StringCompare("12345678901234567890123456789012A", "12345678901234567890123456789012B")
    PrintNonZeroResult("33 chars differ at last", cmp)
}

// =============================================================================
// TEST: StringCompare - Different lengths
// =============================================================================
SubRoutine.TestStringCompareDiffLen {
    PrintMessage("\n")
    PrintMessage("============================================================\n")
    PrintMessage("TEST: StringCompare - Different Lengths\n")
    PrintMessage("============================================================\n")
    
    cmp = StringCompare("Hello", "HelloWorld")
    PrintNonZeroResult("Hello vs HelloWorld", cmp)
    
    cmp = StringCompare("HelloWorld", "Hello")
    PrintNonZeroResult("HelloWorld vs Hello", cmp)
    
    cmp = StringCompare("1234567890123456", "12345678901234567")
    PrintNonZeroResult("16 chars vs 17 chars", cmp)
    
    cmp = StringCompare("", "A")
    PrintNonZeroResult("Empty vs A", cmp)
}

// =============================================================================
// TEST: StringEquals
// =============================================================================
SubRoutine.TestStringEquals {
    PrintMessage("\n")
    PrintMessage("============================================================\n")
    PrintMessage("TEST: StringEquals\n")
    PrintMessage("============================================================\n")
    
    eq = StringEquals("", "")
    PrintResult("Empty vs Empty", eq, 1)
    
    eq = StringEquals("A", "A")
    PrintResult("A vs A", eq, 1)
    
    eq = StringEquals("A", "B")
    PrintResult("A vs B", eq, 0)
    
    eq = StringEquals("1234567890123456", "1234567890123456")
    PrintResult("16 chars equal", eq, 1)
    
    eq = StringEquals("1234567890123456", "1234567890123457")
    PrintResult("16 chars differ at last", eq, 0)
    
    eq = StringEquals("Emit_MovRaxDerefRax", "Emit_MovRaxDerefRbx")
    PrintResult("Emit_MovRaxDerefRax vs Rbx", eq, 0)
}

// =============================================================================
// TEST: StringIndexOf
// =============================================================================
SubRoutine.TestStringIndexOf {
    PrintMessage("\n")
    PrintMessage("============================================================\n")
    PrintMessage("TEST: StringIndexOf\n")
    PrintMessage("============================================================\n")
    
    idx = StringIndexOf("ABCDEF", 65)
    PrintResult("A in ABCDEF (pos 0)", idx, 0)
    
    idx = StringIndexOf("ABCDEF", 70)
    PrintResult("F in ABCDEF (pos 5)", idx, 5)
    
    idx = StringIndexOf("ABCDEF", 90)
    PrintResult("Z in ABCDEF (not found)", idx, -1)
    
    idx = StringIndexOf("123456789012345X", 88)
    PrintResult("X at pos 15", idx, 15)
    
    idx = StringIndexOf("1234567890123456X", 88)
    PrintResult("X at pos 16", idx, 16)
    
    idx = StringIndexOf("12345678901234567X", 88)
    PrintResult("X at pos 17", idx, 17)
    
    idx = StringIndexOf("1234567890123456789012345678901X", 88)
    PrintResult("X at pos 31", idx, 31)
    
    idx = StringIndexOf("12345678901234567890123456789012X", 88)
    PrintResult("X at pos 32", idx, 32)
    
    idx = StringIndexOf("", 65)
    PrintResult("A in empty string", idx, -1)
}

// =============================================================================
// TEST: StringContains
// =============================================================================
SubRoutine.TestStringContains {
    PrintMessage("\n")
    PrintMessage("============================================================\n")
    PrintMessage("TEST: StringContains\n")
    PrintMessage("============================================================\n")
    
    has = StringContains("Hello", 72)
    PrintResult("H in Hello", has, 1)
    
    has = StringContains("Hello", 111)
    PrintResult("o in Hello", has, 1)
    
    has = StringContains("Hello", 90)
    PrintResult("Z in Hello", has, 0)
    
    has = StringContains("", 65)
    PrintResult("A in empty", has, 0)
    
    has = StringContains("1234567890123456X", 88)
    PrintResult("X at pos 16", has, 1)
}

// =============================================================================
// TEST: StringCopy
// =============================================================================
SubRoutine.TestStringCopy {
    PrintMessage("\n")
    PrintMessage("============================================================\n")
    PrintMessage("TEST: StringCopy\n")
    PrintMessage("============================================================\n")
    
    buf1 = Allocate(64)
    buf2 = Allocate(64)
    buf3 = Allocate(64)
    
    StringCopy(buf1, "Hello")
    PrintMessage("Copy 'Hello': ")
    PrintMessage(buf1)
    PrintMessage("\n")
    
    StringCopy(buf2, "1234567890123456")
    PrintMessage("Copy 16 chars: ")
    PrintMessage(buf2)
    len = StringLength(buf2)
    PrintMessage(" (len=")
    PrintNumber(len)
    PrintMessage(")\n")
    
    StringCopy(buf3, "12345678901234567890123456789012")
    PrintMessage("Copy 32 chars: ")
    PrintMessage(buf3)
    len = StringLength(buf3)
    PrintMessage(" (len=")
    PrintNumber(len)
    PrintMessage(")\n")
    
    cmp = StringCompare(buf2, "1234567890123456")
    PrintResult("Verify 16 char copy", cmp, 0)
    
    cmp = StringCompare(buf3, "12345678901234567890123456789012")
    PrintResult("Verify 32 char copy", cmp, 0)
    
    Deallocate(buf1, 64)
    Deallocate(buf2, 64)
    Deallocate(buf3, 64)
}

// =============================================================================
// TEST: Real compiler function names
// =============================================================================
SubRoutine.TestRealFunctionNames {
    PrintMessage("\n")
    PrintMessage("============================================================\n")
    PrintMessage("TEST: Real Compiler Function Names\n")
    PrintMessage("============================================================\n")
    
    cmp = StringCompare("Emit_MovByteDerefRdiZero", "Emit_MovByteDerefRdiAl")
    PrintNonZeroResult("Emit_MovByteDerefRdiZero vs Al", cmp)
    
    cmp = StringCompare("Emit_MovzxRaxByteDerefRax", "Emit_MovzxRaxByteDerefRbx")
    PrintNonZeroResult("Emit_MovzxRaxByteDerefRax vs Rbx", cmp)
    
    cmp = StringCompare("Emit_MovzxRaxByteDerefRbx", "Emit_MovzxRaxByteDerefRdi")
    PrintNonZeroResult("Emit_MovzxRaxByteDerefRbx vs Rdi", cmp)
    
    cmp = StringCompare("X86_MovzxRaxByteDerefRbx", "X86_MovzxRaxByteDerefRsi")
    PrintNonZeroResult("X86_MovzxRaxByteDerefRbx vs Rsi", cmp)
    
    cmp = StringCompare("CompileStringCore_Concat", "CompileStringCore_NumberToString")
    PrintNonZeroResult("CompileStringCore_Concat vs NumberToString", cmp)
    
    cmp = StringCompare("FPUCompileX86_FloatSqrt", "FPUCompileX86_FloatFromInt")
    PrintNonZeroResult("FPUCompileX86_FloatSqrt vs FloatFromInt", cmp)
}

// =============================================================================
// MAIN
// =============================================================================
SubRoutine.Main {
    PrintMessage("============================================================\n")
    PrintMessage("SSE2 STRING DIAGNOSTIC SUITE\n")
    PrintMessage("============================================================\n")
    
    TestStringLength()
    TestStringCompareEqual()
    TestStringCompareDiffPos0()
    TestStringCompareDiffPos15()
    TestStringCompareDiffPos16()
    TestStringCompareDiffPos17()
    TestStringCompareDiffLast()
    TestStringCompareDiffLen()
    TestStringEquals()
    TestStringIndexOf()
    TestStringContains()
    TestStringCopy()
    TestRealFunctionNames()
    
    PrintMessage("\n")
    PrintMessage("============================================================\n")
    PrintMessage("DIAGNOSTIC COMPLETE\n")
    PrintMessage("============================================================\n")
}

RunTask(Main)