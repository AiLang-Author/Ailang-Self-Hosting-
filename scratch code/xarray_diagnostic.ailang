// xarray_diagnostic.ailang
// Isolate the XDelete crash WITHOUT RunTask subroutine calls
// All checks inline to avoid subroutine state conflicts

LibraryImport.XArrays
LibraryImport.Arena

FixedPool.Diag {
    "passed": Initialize=0
    "failed": Initialize=0
}

PrintMessage("=== XArray Diagnostic - Inline Tests ===\n")
PrintMessage("Testing without RunTask to isolate crash\n\n")

Arena_Init()

// =============================================================================
// TEST: XDelete in isolation
// =============================================================================
PrintMessage("--- Creating array ---\n")
arr = XArray.XCreate(16)
PrintMessage("arr = ")
PrintNumber(arr)
PrintMessage("\n")

PrintMessage("--- Pushing 10, 20, 30, 40 ---\n")
XArray.XPush(arr, 10)
XArray.XPush(arr, 20)
XArray.XPush(arr, 30)
XArray.XPush(arr, 40)

PrintMessage("Size after push: ")
PrintNumber(XArray.XSize(arr))
PrintMessage("\n")

PrintMessage("Contents: ")
i = 0
sz = XArray.XSize(arr)
WhileLoop LessThan(i, sz) {
    PrintMessage("[")
    PrintNumber(i)
    PrintMessage("]=")
    PrintNumber(XArray.XGet(arr, i))
    PrintMessage(" ")
    i = Add(i, 1)
}
PrintMessage("\n\n")

// =============================================================================
// XInsert test
// =============================================================================
PrintMessage("--- XInsert(2, 25) ---\n")
XArray.XInsert(arr, 2, 25)
// Should be: [10, 20, 25, 30, 40]

PrintMessage("Size after insert: ")
PrintNumber(XArray.XSize(arr))
PrintMessage("\n")

PrintMessage("Contents: ")
i = 0
sz = XArray.XSize(arr)
WhileLoop LessThan(i, sz) {
    PrintMessage("[")
    PrintNumber(i)
    PrintMessage("]=")
    PrintNumber(XArray.XGet(arr, i))
    PrintMessage(" ")
    i = Add(i, 1)
}
PrintMessage("\n\n")

// =============================================================================
// XInsert at 0
// =============================================================================
PrintMessage("--- XInsert(0, 5) ---\n")
XArray.XInsert(arr, 0, 5)
// Should be: [5, 10, 20, 25, 30, 40]

PrintMessage("Size after insert at 0: ")
PrintNumber(XArray.XSize(arr))
PrintMessage("\n")

PrintMessage("Contents: ")
i = 0
sz = XArray.XSize(arr)
WhileLoop LessThan(i, sz) {
    PrintMessage("[")
    PrintNumber(i)
    PrintMessage("]=")
    PrintNumber(XArray.XGet(arr, i))
    PrintMessage(" ")
    i = Add(i, 1)
}
PrintMessage("\n\n")

// =============================================================================
// THE CRASH POINT - XDelete
// =============================================================================
PrintMessage("--- About to call XDelete(2) ---\n")
PrintMessage("Array state BEFORE delete:\n")
PrintMessage("  size = ")
PrintNumber(XArray.XSize(arr))
PrintMessage("\n")
PrintMessage("  capacity = ")
PrintNumber(XArray.XCapacity(arr))
PrintMessage("\n")
PrintMessage("  data ptr = ")
data_ptr = Dereference(Add(arr, 16))
PrintNumber(data_ptr)
PrintMessage("\n")

PrintMessage("Calling XDelete(2)...\n")
deleted_val = XArray.XDelete(arr, 2)

PrintMessage("XDelete returned: ")
PrintNumber(deleted_val)
PrintMessage("\n")

PrintMessage("--- AFTER XDelete ---\n")
PrintMessage("About to call XSize...\n")

// This is where it might crash
sz_after = XArray.XSize(arr)
PrintMessage("Size after delete: ")
PrintNumber(sz_after)
PrintMessage("\n")

PrintMessage("About to read contents...\n")
PrintMessage("Contents: ")
i = 0
WhileLoop LessThan(i, sz_after) {
    PrintMessage("[")
    PrintNumber(i)
    PrintMessage("]=")
    val = XArray.XGet(arr, i)
    PrintNumber(val)
    PrintMessage(" ")
    i = Add(i, 1)
}
PrintMessage("\n\n")

// =============================================================================
// XShift test
// =============================================================================
PrintMessage("--- About to call XShift ---\n")
shifted = XArray.XShift(arr)
PrintMessage("XShift returned: ")
PrintNumber(shifted)
PrintMessage("\n")

PrintMessage("Size after shift: ")
PrintNumber(XArray.XSize(arr))
PrintMessage("\n")

PrintMessage("First element now: ")
PrintNumber(XArray.XGet(arr, 0))
PrintMessage("\n\n")

// =============================================================================
// Cleanup
// =============================================================================
PrintMessage("--- Destroying array ---\n")
XArray.XDestroy(arr)
PrintMessage("Destroyed.\n\n")

PrintMessage("=== Diagnostic Complete ===\n")
Arena_Report()