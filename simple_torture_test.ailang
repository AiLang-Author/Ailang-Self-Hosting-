// simple_torture_test.ailang

SubRoutine.Main {
    PrintMessage("Starting 24hr test\n")
    
    hour = 0
    WhileLoop LessThan(hour, 24) {
        minute = 0
        WhileLoop LessThan(minute, 60) {
            // Do some work
            i = 0
            WhileLoop LessThan(i, 10000) {
                x = Add(i, 1)
                x = Multiply(x, 2)
                x = Divide(x, 3)
                i = Add(i, 1)
            }
            
            // Sleep ~60 sec (busy wait)
            j = 0
            WhileLoop LessThan(j, 500000000) {
                j = Add(j, 1)
            }
            
            minute = Add(minute, 1)
        }
        
        hour = Add(hour, 1)
        PrintMessage("Hour ")
        PrintNumber(hour)
        PrintMessage(" done\n")
    }
    
    PrintMessage("Test complete\n")
}

RunTask(Main)