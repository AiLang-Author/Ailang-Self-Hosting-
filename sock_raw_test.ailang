// sock_raw_test.ailang
// Tests raw socket syscalls — no library dependencies except Arena

LibraryImport.Arena

SubRoutine.Main {
    Arena_Init()

    PrintMessage("=== Raw Socket Test ===\n")

    // Step 1: create socket
    // syscall 41 = socket(AF_INET=2, SOCK_STREAM=1, 0)
    PrintMessage("[1] Creating socket...\n")
    sock = SystemCall(41, 2, 1, 0)
    PrintMessage("[1] socket() returned: ")
    PrintNumber(sock)
    PrintMessage("\n")

    IfCondition LessThan(sock, 0) ThenBlock: {
        PrintMessage("[FAIL] socket() failed\n")
        HaltProgram
    }

    // Step 2: build sockaddr_in manually
    PrintMessage("[2] Building sockaddr_in...\n")
    addr = Allocate(16)

    // sin_family = AF_INET = 2 (little-endian 16-bit)
    SetByte(addr, 0, 2)
    SetByte(addr, 1, 0)

    // sin_port = 5432 in big-endian
    // 5432 / 256 = 21, 5432 - (21*256) = 56
    ph = Divide(5432, 256)
    pl = Subtract(5432, Multiply(ph, 256))
    SetByte(addr, 2, ph)
    SetByte(addr, 3, pl)

    PrintMessage("  port bytes: ")
    PrintNumber(ph)
    PrintMessage(", ")
    PrintNumber(pl)
    PrintMessage("\n")

    // sin_addr = 127.0.0.1
    SetByte(addr, 4, 127)
    SetByte(addr, 5, 0)
    SetByte(addr, 6, 0)
    SetByte(addr, 7, 1)

    // zero padding
    SetByte(addr, 8, 0)
    SetByte(addr, 9, 0)
    SetByte(addr, 10, 0)
    SetByte(addr, 11, 0)
    SetByte(addr, 12, 0)
    SetByte(addr, 13, 0)
    SetByte(addr, 14, 0)
    SetByte(addr, 15, 0)

    // Verify bytes
    PrintMessage("  addr bytes: ")
    vi = 0
    WhileLoop LessThan(vi, 16) {
        vb = GetByte(addr, vi)
        PrintNumber(vb)
        PrintMessage(" ")
        vi = Add(vi, 1)
    }
    PrintMessage("\n")

    // Step 3: connect
    // syscall 42 = connect(sock, addr, 16)
    PrintMessage("[3] Connecting to 127.0.0.1:5432...\n")
    res = SystemCall(42, sock, addr, 16)
    PrintMessage("[3] connect() returned: ")
    PrintNumber(res)
    PrintMessage("\n")

    IfCondition LessThan(res, 0) ThenBlock: {
        PrintMessage("[FAIL] connect() failed\n")
        SystemCall(3, sock, 0, 0)
        Deallocate(addr, 16)
        HaltProgram
    }

    PrintMessage("[PASS] Connected!\n")

    // Step 4: close
    PrintMessage("[4] Closing...\n")
    SystemCall(3, sock, 0, 0)
    Deallocate(addr, 16)

    PrintMessage("=== Done ===\n")
}

RunTask(Main)