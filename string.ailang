LibraryImport.Arena

SubRoutine.Main {
    Arena_Init()
    
    PrintMessage("========== STRING FUNCTION TESTS ==========\n\n")
    
    // StringLength
    PrintMessage("--- StringLength ---\n")
    PrintMessage("Length of 'Hello': ")
    PrintNumber(StringLength("Hello"))
    PrintMessage("\n")
    PrintMessage("Length of '': ")
    PrintNumber(StringLength(""))
    PrintMessage("\n")
    PrintMessage("Length of 'Hello World': ")
    PrintNumber(StringLength("Hello World"))
    PrintMessage("\n\n")
    
    // StringConcat
    PrintMessage("--- StringConcat ---\n")
    PrintMessage("Concat 'Hello' + 'World': ")
    PrintMessage(StringConcat("Hello", "World"))
    PrintMessage("\n")
    PrintMessage("Concat '' + 'Test': ")
    PrintMessage(StringConcat("", "Test"))
    PrintMessage("\n")
    PrintMessage("Concat 'Test' + '': ")
    PrintMessage(StringConcat("Test", ""))
    PrintMessage("\n\n")
    
    // StringSubstring
    PrintMessage("--- StringSubstring ---\n")
    PrintMessage("Substring('Hello World', 0, 5): ")
    PrintMessage(StringSubstring("Hello World", 0, 5))
    PrintMessage("\n")
    PrintMessage("Substring('Hello World', 6, 5): ")
    PrintMessage(StringSubstring("Hello World", 6, 5))
    PrintMessage("\n")
    PrintMessage("Substring('debug 1', 6, 1): ")
    PrintMessage(StringSubstring("debug 1", 6, 1))
    PrintMessage("\n\n")
    
    // StringCharAt
    PrintMessage("--- StringCharAt ---\n")
    PrintMessage("CharAt('Hello', 0): ")
    PrintNumber(StringCharAt("Hello", 0))
    PrintMessage(" (should be 72 = 'H')\n")
    PrintMessage("CharAt('Hello', 4): ")
    PrintNumber(StringCharAt("Hello", 4))
    PrintMessage(" (should be 111 = 'o')\n\n")
    
    // StringFromChar
    PrintMessage("--- StringFromChar ---\n")
    PrintMessage("FromChar(65): ")
    PrintMessage(StringFromChar(65))
    PrintMessage(" (should be 'A')\n")
    PrintMessage("FromChar(90): ")
    PrintMessage(StringFromChar(90))
    PrintMessage(" (should be 'Z')\n\n")
    
    // StringToUpper
    PrintMessage("--- StringToUpper ---\n")
    PrintMessage("ToUpper('hello'): ")
    PrintMessage(StringToUpper("hello"))
    PrintMessage("\n")
    PrintMessage("ToUpper('Hello World'): ")
    PrintMessage(StringToUpper("Hello World"))
    PrintMessage("\n\n")
    
    // StringToLower
    PrintMessage("--- StringToLower ---\n")
    PrintMessage("ToLower('HELLO'): ")
    PrintMessage(StringToLower("HELLO"))
    PrintMessage("\n")
    PrintMessage("ToLower('Hello World'): ")
    PrintMessage(StringToLower("Hello World"))
    PrintMessage("\n\n")
    
    // StringTrim
    PrintMessage("--- StringTrim ---\n")
    PrintMessage("Trim('  hello  '): [")
    PrintMessage(StringTrim("  hello  "))
    PrintMessage("]\n")
    PrintMessage("Trim('no spaces'): [")
    PrintMessage(StringTrim("no spaces"))
    PrintMessage("]\n\n")
    
    // NumberToString
    PrintMessage("--- NumberToString ---\n")
    PrintMessage("NumberToString(0): ")
    PrintMessage(NumberToString(0))
    PrintMessage("\n")
    PrintMessage("NumberToString(42): ")
    PrintMessage(NumberToString(42))
    PrintMessage("\n")
    PrintMessage("NumberToString(-123): ")
    PrintMessage(NumberToString(-123))
    PrintMessage("\n")
    PrintMessage("NumberToString(9876543): ")
    PrintMessage(NumberToString(9876543))
    PrintMessage("\n\n")
    
    // StringToNumber
    PrintMessage("--- StringToNumber ---\n")
    PrintMessage("StringToNumber('0'): ")
    PrintNumber(StringToNumber("0"))
    PrintMessage("\n")
    PrintMessage("StringToNumber('42'): ")
    PrintNumber(StringToNumber("42"))
    PrintMessage("\n")
    PrintMessage("StringToNumber('-123'): ")
    PrintNumber(StringToNumber("-123"))
    PrintMessage("\n")
    PrintMessage("StringToNumber('  456  '): ")
    PrintNumber(StringToNumber("  456  "))
    PrintMessage("\n\n")
    
    // StringEquals
    PrintMessage("--- StringEquals ---\n")
    PrintMessage("Equals('hello', 'hello'): ")
    PrintNumber(StringEquals("hello", "hello"))
    PrintMessage("\n")
    PrintMessage("Equals('hello', 'world'): ")
    PrintNumber(StringEquals("hello", "world"))
    PrintMessage("\n")
    PrintMessage("Equals('', ''): ")
    PrintNumber(StringEquals("", ""))
    PrintMessage("\n\n")
    
    // StringCompare
    PrintMessage("--- StringCompare ---\n")
    PrintMessage("Compare('apple', 'banana'): ")
    PrintNumber(StringCompare("apple", "banana"))
    PrintMessage("\n")
    PrintMessage("Compare('banana', 'apple'): ")
    PrintNumber(StringCompare("banana", "apple"))
    PrintMessage("\n")
    PrintMessage("Compare('same', 'same'): ")
    PrintNumber(StringCompare("same", "same"))
    PrintMessage("\n\n")
    
    PrintMessage("========== ALL TESTS COMPLETE ==========\n")
}
RunTask(Main)