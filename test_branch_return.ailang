LibraryImport.Arena

Function.F {
    Input: x: Integer
    Output: Integer
    Body: {
        Branch x {
            Case 1: { ReturnValue(100) }
            Case 2: { ReturnValue(200) }
            Case 3: { ReturnValue(300) }
        }
        ReturnValue(0)
    }
}

SubRoutine.Main {
    PrintNumber(F(1)) PrintMessage("\n")
    PrintNumber(F(2)) PrintMessage("\n")
    PrintNumber(F(3)) PrintMessage("\n")
    PrintNumber(F(99)) PrintMessage("\n")
    SystemCall(60, 0)
}
RunTask(Main)
