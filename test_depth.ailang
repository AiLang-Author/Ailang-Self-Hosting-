SubRoutine.Main {
    a = 3
    b = 4
    c = 10
    d = 20

    PrintMessage("Depth 1 - Multiply(a,b) expect 12: ")
    PrintNumber(Multiply(a, b))
    PrintMessage("\n")

    PrintMessage("Depth 1 - Add(c,d) expect 30: ")
    PrintNumber(Add(c, d))
    PrintMessage("\n")

    PrintMessage("Depth 2 - Add(Multiply(a,b), Add(c,d)) expect 42: ")
    PrintNumber(Add(Multiply(a, b), Add(c, d)))
    PrintMessage("\n")

    PrintMessage("Depth 2 assign - expect 42: ")
    r1 = Add(Multiply(a, b), Add(c, d))
    PrintNumber(r1)
    PrintMessage("\n")

    PrintMessage("Depth 3 - Add(sum, Add(Mul,Add)) expect 42: ")
    sum = 0
    sum = Add(sum, Add(Multiply(a, b), Add(c, d)))
    PrintNumber(sum)
    PrintMessage("\n")

    PrintMessage("Manual flatten - expect 42: ")
    t1 = Multiply(a, b)
    t2 = Add(c, d)
    t3 = Add(t1, t2)
    PrintNumber(t3)
    PrintMessage("\n")

    PrintMessage("Manual accumulate - expect 8400: ")
    sum = 0
    i = 0
    WhileLoop LessThan(i, 200) {
        t1 = Multiply(a, b)
        t2 = Add(c, d)
        t3 = Add(t1, t2)
        sum = Add(sum, t3)
        i = Add(i, 1)
    }
    PrintNumber(sum)
    PrintMessage("\n")
}
RunTask(Main)