// test_fpu_showcase.ailang
// Showcase combining FPU math, SSE2 strings, and memory ops
// Prime sieve + statistics + ASCII visualization

SubRoutine.Main {
    PrintMessage("╔══════════════════════════════════════════════════════════════╗\n")
    PrintMessage("║        AILang FPU/SSE2 Showcase - Prime Analysis             ║\n")
    PrintMessage("╚══════════════════════════════════════════════════════════════╝\n\n")
    
    // === PHASE 1: Sieve of Eratosthenes using MemorySet ===
    PrintMessage("▶ Phase 1: Generating primes using Sieve of Eratosthenes\n")
    PrintMessage("  (Using MemorySet for initialization, ISqrt for optimization)\n\n")
    
    limit = 1000
    sieve = Allocate(limit)
    MemorySet(sieve, 1, limit)  // SSE2 memset - mark all as prime
    
    // 0 and 1 are not prime
    StoreValue(sieve, 0, "byte")
    StoreValue(Add(sieve, 1), 0, "byte")
    
    // Sieve using ISqrt for limit optimization
    sqrt_limit = ISqrt(limit)
    PrintMessage("  Sieving up to ")
    PrintNumber(limit)
    PrintMessage(" (sqrt limit = ")
    PrintNumber(sqrt_limit)
    PrintMessage(")\n")
    
    i = 2
    WhileLoop LessEqual(i, sqrt_limit) {
        is_prime = Dereference(Add(sieve, i), "byte")
        IfCondition EqualTo(is_prime, 1) ThenBlock: {
            // Mark multiples
            j = Multiply(i, i)
            WhileLoop LessThan(j, limit) {
                StoreValue(Add(sieve, j), 0, "byte")
                j = Add(j, i)
            }
        }
        i = Add(i, 1)
    }
    
    // === PHASE 2: Count and collect primes ===
    PrintMessage("\n▶ Phase 2: Analyzing prime distribution\n")
    
    prime_count = 0
    prime_sum = 0
    largest_gap = 0
    last_prime = 2
    twin_count = 0
    
    i = 2
    WhileLoop LessThan(i, limit) {
        is_prime = Dereference(Add(sieve, i), "byte")
        IfCondition EqualTo(is_prime, 1) ThenBlock: {
            prime_count = Add(prime_count, 1)
            prime_sum = Add(prime_sum, i)
            
            gap = Subtract(i, last_prime)
            largest_gap = Max(largest_gap, gap)
            
            // Twin prime check (gap of 2)
            IfCondition EqualTo(gap, 2) ThenBlock: {
                twin_count = Add(twin_count, 1)
            }
            
            last_prime = i
        }
        i = Add(i, 1)
    }
    
    // Calculate average using float division
    avg_prime = Float_Div(prime_sum, prime_count)
    
    // === PHASE 3: Build statistics report ===
    PrintMessage("\n┌─────────────────────────────────────┐\n")
    PrintMessage("│         PRIME STATISTICS            │\n")
    PrintMessage("├─────────────────────────────────────┤\n")
    
    PrintMessage("│ Range:          1 to ")
    PrintNumber(limit)
    PrintMessage("          │\n")
    
    PrintMessage("│ Primes found:   ")
    PrintNumber(prime_count)
    spaces = Subtract(20, StringLength(NumberToString(prime_count)))
    rep = 0
    WhileLoop LessThan(rep, spaces) {
        PrintMessage(" ")
        rep = Add(rep, 1)
    }
    PrintMessage("│\n")
    
    PrintMessage("│ Sum of primes:  ")
    PrintNumber(prime_sum)
    spaces = Subtract(20, StringLength(NumberToString(prime_sum)))
    rep = 0
    WhileLoop LessThan(rep, spaces) {
        PrintMessage(" ")
        rep = Add(rep, 1)
    }
    PrintMessage("│\n")
    
    PrintMessage("│ Average prime:  ")
    PrintNumber(avg_prime)
    spaces = Subtract(20, StringLength(NumberToString(avg_prime)))
    rep = 0
    WhileLoop LessThan(rep, spaces) {
        PrintMessage(" ")
        rep = Add(rep, 1)
    }
    PrintMessage("│\n")
    
    PrintMessage("│ Largest gap:    ")
    PrintNumber(largest_gap)
    spaces = Subtract(20, StringLength(NumberToString(largest_gap)))
    rep = 0
    WhileLoop LessThan(rep, spaces) {
        PrintMessage(" ")
        rep = Add(rep, 1)
    }
    PrintMessage("│\n")
    
    PrintMessage("│ Twin primes:    ")
    PrintNumber(twin_count)
    PrintMessage(" pairs")
    spaces = Subtract(14, StringLength(NumberToString(twin_count)))
    rep = 0
    WhileLoop LessThan(rep, spaces) {
        PrintMessage(" ")
        rep = Add(rep, 1)
    }
    PrintMessage("│\n")
    
    PrintMessage("└─────────────────────────────────────┘\n")
    
    // === PHASE 4: ASCII histogram of prime density ===
    PrintMessage("\n▶ Phase 3: Prime density histogram (per 100)\n\n")
    
    bucket = 0
    WhileLoop LessThan(bucket, 10) {
        start = Multiply(bucket, 100)
        end = Add(start, 100)
        
        // Count primes in this bucket
        count = 0
        i = start
        IfCondition EqualTo(i, 0) ThenBlock: { i = 2 }
        WhileLoop LessThan(i, end) {
            is_prime = Dereference(Add(sieve, i), "byte")
            IfCondition EqualTo(is_prime, 1) ThenBlock: {
                count = Add(count, 1)
            }
            i = Add(i, 1)
        }
        
        // Print bucket label
        PrintNumber(start)
        PrintMessage("-")
        PrintNumber(Subtract(end, 1))
        PrintMessage(": ")
        IfCondition LessThan(start, 100) ThenBlock: { PrintMessage(" ") }
        
        // Print bar using string ops
        bar_len = count
        b = 0
        WhileLoop LessThan(b, bar_len) {
            PrintMessage("█")
            b = Add(b, 1)
        }
        
        PrintMessage(" (")
        PrintNumber(count)
        PrintMessage(")\n")
        
        bucket = Add(bucket, 1)
    }
    
    // === PHASE 5: First 20 primes formatted nicely ===
    PrintMessage("\n▶ Phase 4: First 20 primes with digit analysis\n\n")
    
    output = Allocate(512)
    MemorySet(output, 0, 512)
    
    pos = 0
    count = 0
    i = 2
    WhileLoop And(LessThan(i, limit), LessThan(count, 20)) {
        is_prime = Dereference(Add(sieve, i), "byte")
        IfCondition EqualTo(is_prime, 1) ThenBlock: {
            // Convert to string
            num_str = NumberToString(i)
            num_len = StringLength(num_str)
            digit_sum = 0
            
            // Sum digits
            d = 0
            WhileLoop LessThan(d, num_len) {
                digit = Subtract(StringCharAt(num_str, d), 48)
                digit_sum = Add(digit_sum, digit)
                d = Add(d, 1)
            }
            
            PrintMessage("  ")
            PrintNumber(i)
            PrintMessage(" (digits: ")
            PrintNumber(num_len)
            PrintMessage(", sum: ")
            PrintNumber(digit_sum)
            PrintMessage(")")
            
            // Check if digit sum is also prime (meta!)
            IfCondition And(GreaterThan(digit_sum, 1), LessThan(digit_sum, limit)) ThenBlock: {
                is_sum_prime = Dereference(Add(sieve, digit_sum), "byte")
                IfCondition EqualTo(is_sum_prime, 1) ThenBlock: {
                    PrintMessage(" ★")
                }
            }
            PrintMessage("\n")
            
            count = Add(count, 1)
        }
        i = Add(i, 1)
    }
    
    PrintMessage("\n  ★ = digit sum is also prime!\n")
    
    // === PHASE 6: Distance calculation using Float_Sqrt ===
    PrintMessage("\n▶ Phase 5: Geometric calculations with SSE2\n\n")
    
    // Calculate hypotenuse: sqrt(3² + 4²) = 5
    a = 3
    b = 4
    a_sq = Float_Mul(a, a)
    b_sq = Float_Mul(b, b)
    sum_sq = Float_Add(a_sq, b_sq)
    hyp = Float_Sqrt(sum_sq)
    
    PrintMessage("  Pythagorean: √(3² + 4²) = √(9 + 16) = √25 = ")
    PrintNumber(hyp)
    IfCondition EqualTo(hyp, 5) ThenBlock: {
        PrintMessage(" ✓\n")
    } ElseBlock: {
        PrintMessage(" ✗\n")
    }
    
    // Another one: sqrt(5² + 12²) = 13
    a = 5
    b = 12
    hyp = Float_Sqrt(Float_Add(Float_Mul(a, a), Float_Mul(b, b)))
    PrintMessage("  Pythagorean: √(5² + 12²) = √(25 + 144) = √169 = ")
    PrintNumber(hyp)
    IfCondition EqualTo(hyp, 13) ThenBlock: {
        PrintMessage(" ✓\n")
    } ElseBlock: {
        PrintMessage(" ✗\n")
    }
    
    // Quadratic-ish: find sqrt of prime count squared
    pc_squared = Float_Mul(prime_count, prime_count)
    pc_back = Float_Sqrt(pc_squared)
    PrintMessage("  Roundtrip: √(")
    PrintNumber(prime_count)
    PrintMessage("²) = √")
    PrintNumber(pc_squared)
    PrintMessage(" = ")
    PrintNumber(pc_back)
    IfCondition EqualTo(pc_back, prime_count) ThenBlock: {
        PrintMessage(" ✓\n")
    } ElseBlock: {
        PrintMessage(" ✗\n")
    }
    
    // Cleanup
    Deallocate(sieve, limit)
    Deallocate(output, 512)
    
    PrintMessage("\n╔══════════════════════════════════════════════════════════════╗\n")
    PrintMessage("║                    Showcase Complete!                        ║\n")
    PrintMessage("║  Combined: MemorySet, ISqrt, Float_*, String*, NumberTo*     ║\n")
    PrintMessage("╚══════════════════════════════════════════════════════════════╝\n")
}

RunTask(Main)