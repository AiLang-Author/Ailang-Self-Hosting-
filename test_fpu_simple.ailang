// test_fpu_simple.ailang
// Simple standalone test for FPU types and basic functionality
// Location: Tests/FPU/test_fpu_simple.ailang
//
// This test verifies:
//   1. FPUTypes FixedPool loads correctly
//   2. Basic emit functions don't crash
//   3. Byte sequences are correct
//
// Minimal dependencies - good for initial bring-up

LibraryImport.Compiler.Compile.FPU.FPUTypes

// =============================================================================
// TEST: FixedPool Constants
// =============================================================================

SubRoutine.TestConstants {
    PrintMessage("--- Testing FPUTypes Constants ---\n")
    
    passed = 0
    failed = 0
    
    // XMM register constants
    PrintMessage("XMM0 = ")
    PrintNumber(XMM.XMM0)
    IfCondition EqualTo(XMM.XMM0, 0) ThenBlock: {
        PrintMessage(" [OK]\n")
        passed = Add(passed, 1)
    } ElseBlock: {
        PrintMessage(" [FAIL] expected 0\n")
        failed = Add(failed, 1)
    }
    
    PrintMessage("XMM7 = ")
    PrintNumber(XMM.XMM7)
    IfCondition EqualTo(XMM.XMM7, 7) ThenBlock: {
        PrintMessage(" [OK]\n")
        passed = Add(passed, 1)
    } ElseBlock: {
        PrintMessage(" [FAIL] expected 7\n")
        failed = Add(failed, 1)
    }
    
    PrintMessage("XMM15 = ")
    PrintNumber(XMM.XMM15)
    IfCondition EqualTo(XMM.XMM15, 15) ThenBlock: {
        PrintMessage(" [OK]\n")
        passed = Add(passed, 1)
    } ElseBlock: {
        PrintMessage(" [FAIL] expected 15\n")
        failed = Add(failed, 1)
    }
    
    // Float operation codes
    PrintMessage("FloatOp.ADD = ")
    PrintNumber(FloatOp.ADD)
    IfCondition EqualTo(FloatOp.ADD, 0) ThenBlock: {
        PrintMessage(" [OK]\n")
        passed = Add(passed, 1)
    } ElseBlock: {
        PrintMessage(" [FAIL] expected 0\n")
        failed = Add(failed, 1)
    }
    
    PrintMessage("FloatOp.DIV = ")
    PrintNumber(FloatOp.DIV)
    IfCondition EqualTo(FloatOp.DIV, 3) ThenBlock: {
        PrintMessage(" [OK]\n")
        passed = Add(passed, 1)
    } ElseBlock: {
        PrintMessage(" [FAIL] expected 3\n")
        failed = Add(failed, 1)
    }
    
    // Type sizes
    PrintMessage("FPUSize.FLOAT = ")
    PrintNumber(FPUSize.FLOAT)
    IfCondition EqualTo(FPUSize.FLOAT, 8) ThenBlock: {
        PrintMessage(" [OK]\n")
        passed = Add(passed, 1)
    } ElseBlock: {
        PrintMessage(" [FAIL] expected 8\n")
        failed = Add(failed, 1)
    }
    
    PrintMessage("FPUSize.VEC2 = ")
    PrintNumber(FPUSize.VEC2)
    IfCondition EqualTo(FPUSize.VEC2, 16) ThenBlock: {
        PrintMessage(" [OK]\n")
        passed = Add(passed, 1)
    } ElseBlock: {
        PrintMessage(" [FAIL] expected 16\n")
        failed = Add(failed, 1)
    }
    
    PrintMessage("FPUSize.MAT4 = ")
    PrintNumber(FPUSize.MAT4)
    IfCondition EqualTo(FPUSize.MAT4, 128) ThenBlock: {
        PrintMessage(" [OK]\n")
        passed = Add(passed, 1)
    } ElseBlock: {
        PrintMessage(" [FAIL] expected 128\n")
        failed = Add(failed, 1)
    }
    
    // SSE prefixes
    PrintMessage("SSEPrefix.P_66 = ")
    PrintNumber(SSEPrefix.P_66)
    IfCondition EqualTo(SSEPrefix.P_66, 102) ThenBlock: {
        PrintMessage(" [OK] (0x66)\n")
        passed = Add(passed, 1)
    } ElseBlock: {
        PrintMessage(" [FAIL] expected 102\n")
        failed = Add(failed, 1)
    }
    
    PrintMessage("SSEPrefix.P_F2 = ")
    PrintNumber(SSEPrefix.P_F2)
    IfCondition EqualTo(SSEPrefix.P_F2, 242) ThenBlock: {
        PrintMessage(" [OK] (0xF2)\n")
        passed = Add(passed, 1)
    } ElseBlock: {
        PrintMessage(" [FAIL] expected 242\n")
        failed = Add(failed, 1)
    }
    
    // Comparison codes
    PrintMessage("FloatCmp.LT = ")
    PrintNumber(FloatCmp.LT)
    IfCondition EqualTo(FloatCmp.LT, 2) ThenBlock: {
        PrintMessage(" [OK]\n")
        passed = Add(passed, 1)
    } ElseBlock: {
        PrintMessage(" [FAIL] expected 2\n")
        failed = Add(failed, 1)
    }
    
    // Vector sizes
    PrintMessage("VecSize.VEC3 = ")
    PrintNumber(VecSize.VEC3)
    IfCondition EqualTo(VecSize.VEC3, 3) ThenBlock: {
        PrintMessage(" [OK]\n")
        passed = Add(passed, 1)
    } ElseBlock: {
        PrintMessage(" [FAIL] expected 3\n")
        failed = Add(failed, 1)
    }
    
    // FPU State
    PrintMessage("FPUState.enabled = ")
    PrintNumber(FPUState.enabled)
    IfCondition EqualTo(FPUState.enabled, 1) ThenBlock: {
        PrintMessage(" [OK]\n")
        passed = Add(passed, 1)
    } ElseBlock: {
        PrintMessage(" [FAIL] expected 1\n")
        failed = Add(failed, 1)
    }
    
    PrintMessage("\nConstants test: ")
    PrintNumber(passed)
    PrintMessage(" passed, ")
    PrintNumber(failed)
    PrintMessage(" failed\n")
}

// =============================================================================
// TEST: State Modification
// =============================================================================

SubRoutine.TestStateModification {
    PrintMessage("\n--- Testing State Modification ---\n")
    
    // Test that we can modify mutable state
    old_enabled = FPUState.enabled
    PrintMessage("Initial FPUState.enabled = ")
    PrintNumber(old_enabled)
    PrintMessage("\n")
    
    // Disable
    FPUState.enabled = 0
    PrintMessage("After setting to 0: ")
    PrintNumber(FPUState.enabled)
    IfCondition EqualTo(FPUState.enabled, 0) ThenBlock: {
        PrintMessage(" [OK]\n")
    } ElseBlock: {
        PrintMessage(" [FAIL]\n")
    }
    
    // Re-enable
    FPUState.enabled = 1
    PrintMessage("After setting to 1: ")
    PrintNumber(FPUState.enabled)
    IfCondition EqualTo(FPUState.enabled, 1) ThenBlock: {
        PrintMessage(" [OK]\n")
    } ElseBlock: {
        PrintMessage(" [FAIL]\n")
    }
    
    // Test xmm_in_use bitmask
    FPUState.xmm_in_use = 0
    PrintMessage("xmm_in_use = 0: ")
    PrintNumber(FPUState.xmm_in_use)
    PrintMessage(" [OK]\n")
    
    // Set bit for XMM0
    FPUState.xmm_in_use = BitOr(FPUState.xmm_in_use, 1)
    PrintMessage("After marking XMM0 in use: ")
    PrintNumber(FPUState.xmm_in_use)
    PrintMessage("\n")
    
    // Set bit for XMM3 (bit 3 = 8)
    FPUState.xmm_in_use = BitOr(FPUState.xmm_in_use, 8)
    PrintMessage("After marking XMM3 in use: ")
    PrintNumber(FPUState.xmm_in_use)
    IfCondition EqualTo(FPUState.xmm_in_use, 9) ThenBlock: {
        PrintMessage(" [OK] (0b1001 = 9)\n")
    } ElseBlock: {
        PrintMessage(" [FAIL] expected 9\n")
    }
    
    // Check if XMM0 is in use
    mask = BitAnd(FPUState.xmm_in_use, 1)
    PrintMessage("XMM0 in use? ")
    PrintNumber(mask)
    IfCondition EqualTo(mask, 1) ThenBlock: {
        PrintMessage(" = yes [OK]\n")
    } ElseBlock: {
        PrintMessage(" = no [FAIL]\n")
    }
    
    // Check if XMM1 is in use
    mask = BitAnd(FPUState.xmm_in_use, 2)
    PrintMessage("XMM1 in use? ")
    PrintNumber(mask)
    IfCondition EqualTo(mask, 0) ThenBlock: {
        PrintMessage(" = no [OK]\n")
    } ElseBlock: {
        PrintMessage(" = yes [FAIL]\n")
    }
    
    // Clear
    FPUState.xmm_in_use = 0
    PrintMessage("Cleared xmm_in_use\n")
}

// =============================================================================
// TEST: Computed values using constants
// =============================================================================

SubRoutine.TestComputedValues {
    PrintMessage("\n--- Testing Computed Values ---\n")
    
    // Calculate Vec3 size (3 doubles @ 8 bytes each)
    calc_vec3 = Multiply(VecSize.VEC3, FPUSize.FLOAT)
    PrintMessage("VEC3 size (computed): ")
    PrintNumber(calc_vec3)
    IfCondition EqualTo(calc_vec3, 24) ThenBlock: {
        PrintMessage(" [OK] = FPUSize.VEC3\n")
    } ElseBlock: {
        PrintMessage(" [FAIL] expected 24\n")
    }
    
    // Calculate Mat4 size (16 doubles)
    calc_mat4 = Multiply(16, FPUSize.FLOAT)
    PrintMessage("MAT4 size (computed): ")
    PrintNumber(calc_mat4)
    IfCondition EqualTo(calc_mat4, FPUSize.MAT4) ThenBlock: {
        PrintMessage(" [OK] matches FPUSize.MAT4\n")
    } ElseBlock: {
        PrintMessage(" [FAIL]\n")
    }
    
    // XMM register index math
    xmm_idx = Add(XMM.XMM8, 2)
    PrintMessage("XMM8 + 2 = XMM10? ")
    PrintNumber(xmm_idx)
    IfCondition EqualTo(xmm_idx, XMM.XMM10) ThenBlock: {
        PrintMessage(" = ")
        PrintNumber(XMM.XMM10)
        PrintMessage(" [OK]\n")
    } ElseBlock: {
        PrintMessage(" [FAIL]\n")
    }
}

// =============================================================================
// MAIN
// =============================================================================

SubRoutine.Main {
    PrintMessage("==============================================\n")
    PrintMessage("FPU Types Simple Test\n")
    PrintMessage("==============================================\n\n")
    
    TestConstants()
    TestStateModification()
    TestComputedValues()
    
    PrintMessage("\n==============================================\n")
    PrintMessage("Simple test complete!\n")
    PrintMessage("==============================================\n")
}

RunTask(Main)