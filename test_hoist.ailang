// test_hoist.ailang
// Tests loop-invariant code motion optimization
// Each test prints expected vs actual values

SubRoutine.Main {

    // =========================================
    // TEST 1: Simple invariant multiply
    // Multiply(x, y) should be hoisted — neither changes in loop
    // Expected: sum = 200 * 1000 = 200000
    // =========================================
    PrintMessage("TEST 1: Simple invariant multiply\n")
    x = 10
    y = 20
    sum = 0
    i = 0
    WhileLoop LessThan(i, 1000) {
        sum = Add(sum, Multiply(x, y))
        i = Add(i, 1)
    }
    PrintMessage("  Expected: 200000\n")
    PrintMessage("  Got:      ")
    PrintNumber(sum)
    PrintMessage("\n\n")

    // =========================================
    // TEST 2: Invariant nested expression
    // Add(Multiply(a, b), c) — all invariant
    // Value = (3 * 7) + 5 = 26
    // Expected: sum = 26 * 500 = 13000
    // =========================================
    PrintMessage("TEST 2: Nested invariant expression\n")
    a = 3
    b = 7
    c = 5
    sum = 0
    i = 0
    WhileLoop LessThan(i, 500) {
        sum = Add(sum, Add(Multiply(a, b), c))
        i = Add(i, 1)
    }
    PrintMessage("  Expected: 13000\n")
    PrintMessage("  Got:      ")
    PrintNumber(sum)
    PrintMessage("\n\n")

    // =========================================
    // TEST 3: Mixed — one invariant, one not
    // Multiply(x, y) is invariant, Add(sum, result) is not
    // Should hoist Multiply(x, y) but not the outer Add
    // Expected: sum = 42 * 100 = 4200
    // =========================================
    PrintMessage("TEST 3: Mixed invariant and non-invariant\n")
    x = 6
    y = 7
    sum = 0
    i = 0
    WhileLoop LessThan(i, 100) {
        sum = Add(sum, Multiply(x, y))
        i = Add(i, 1)
    }
    PrintMessage("  Expected: 4200\n")
    PrintMessage("  Got:      ")
    PrintNumber(sum)
    PrintMessage("\n\n")

    // =========================================
    // TEST 4: Nothing to hoist — all depend on loop var
    // Multiply(i, 2) depends on i which is written
    // Should NOT be hoisted
    // Expected: sum = 0+2+4+6+8+...+198 = 9900
    // =========================================
    PrintMessage("TEST 4: No hoisting (depends on loop var)\n")
    sum = 0
    i = 0
    WhileLoop LessThan(i, 100) {
        sum = Add(sum, Multiply(i, 2))
        i = Add(i, 1)
    }
    PrintMessage("  Expected: 9900\n")
    PrintMessage("  Got:      ")
    PrintNumber(sum)
    PrintMessage("\n\n")

    // =========================================
    // TEST 5: Invariant in condition
    // LessThan(i, Multiply(limit, 2)) — Multiply(limit, 2) is invariant
    // limit=50, so loop runs 0..99
    // Expected: sum = 0+1+2+...+99 = 4950
    // =========================================
    PrintMessage("TEST 5: Invariant in loop condition\n")
    limit = 50
    sum = 0
    i = 0
    WhileLoop LessThan(i, Multiply(limit, 2)) {
        sum = Add(sum, i)
        i = Add(i, 1)
    }
    PrintMessage("  Expected: 4950\n")
    PrintMessage("  Got:      ")
    PrintNumber(sum)
    PrintMessage("\n\n")

    // =========================================
    // TEST 6: Multiple invariants in same loop
    // Both Multiply(a, b) and Add(c, d) should be hoisted
    // Multiply(3, 4) = 12, Add(10, 20) = 30
    // Each iteration: sum += 12 + 30 = 42
    // Expected: sum = 42 * 200 = 8400
    // =========================================
    PrintMessage("TEST 6: Multiple invariants\n")
    a = 3
    b = 4
    c = 10
    d = 20
    sum = 0
    i = 0
    WhileLoop LessThan(i, 200) {
        sum = Add(sum, Add(Multiply(a, b), Add(c, d)))
        i = Add(i, 1)
    }
    PrintMessage("  Expected: 8400\n")
    PrintMessage("  Got:      ")
    PrintNumber(sum)
    PrintMessage("\n\n")

    // =========================================
    // TEST 7: Variable reassigned before loop — not inside
    // x gets set before the loop, never written inside
    // Should be hoisted
    // Expected: sum = 25 * 300 = 7500
    // =========================================
    PrintMessage("TEST 7: Var set before loop only\n")
    x = 5
    x = Multiply(x, 5)
    sum = 0
    i = 0
    WhileLoop LessThan(i, 300) {
        sum = Add(sum, x)
        i = Add(i, 1)
    }
    PrintMessage("  Expected: 7500\n")
    PrintMessage("  Got:      ")
    PrintNumber(sum)
    PrintMessage("\n\n")

    PrintMessage("=== ALL TESTS COMPLETE ===\n")
}
RunTask(Main)