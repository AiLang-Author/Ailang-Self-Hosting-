Function.Factorial {
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(n, 2) ThenBlock: {
            ReturnValue(1)
        }
        prev = Factorial(Subtract(n, 1))
        ReturnValue(Multiply(n, prev))
    }
}

SubRoutine.Main {
    PrintMessage("Factorial test:\n")
    PrintMessage("5! = ")
    result = Factorial(5)
    PrintNumber(result)
    PrintMessage("\n")
}

RunTask(Main)