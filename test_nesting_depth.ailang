// test_sequential_vs_nested.ailang
// Tests sequential IfConditions vs nested ElseBlocks

LibraryImport.Core

FixedPool.Test {
    "passed": Initialize=0, CanChange=True
    "failed": Initialize=0, CanChange=True
}

// BROKEN PATTERN: Sequential IfConditions (all execute)
Function.SequentialIfs {
    Input: value: Integer
    Output: Integer
    Body: {
        result = 0
        
        IfCondition EqualTo(value, 1) ThenBlock: { result = 10 }
        IfCondition EqualTo(value, 2) ThenBlock: { result = 20 }
        IfCondition EqualTo(value, 3) ThenBlock: { result = 30 }
        IfCondition EqualTo(value, 4) ThenBlock: { result = 40 }
        IfCondition EqualTo(value, 5) ThenBlock: { result = 50 }
        
        ReturnValue(result)
    }
}

// CORRECT PATTERN: Nested ElseBlocks (mutual exclusion)
Function.NestedElses {
    Input: value: Integer
    Output: Integer
    Body: {
        result = 0
        
        IfCondition EqualTo(value, 1) ThenBlock: {
            result = 10
        } ElseBlock: {
            IfCondition EqualTo(value, 2) ThenBlock: {
                result = 20
            } ElseBlock: {
                IfCondition EqualTo(value, 3) ThenBlock: {
                    result = 30
                } ElseBlock: {
                    IfCondition EqualTo(value, 4) ThenBlock: {
                        result = 40
                    } ElseBlock: {
                        IfCondition EqualTo(value, 5) ThenBlock: {
                            result = 50
                        }
                    }
                }
            }
        }
        
        ReturnValue(result)
    }
}

Function.CheckResult {
    Input: name: Address
    Input: input_val: Integer
    Input: expected: Integer
    Input: actual: Integer
    Body: {
        IfCondition EqualTo(expected, actual) ThenBlock: {
            Test.passed = Add(Test.passed, 1)
            PrintMessage("[PASS] ")
        } ElseBlock: {
            Test.failed = Add(Test.failed, 1)
            PrintMessage("[FAIL] ")
        }
        PrintMessage(name)
        PrintMessage("(")
        PrintNumber(input_val)
        PrintMessage(") = ")
        PrintNumber(actual)
        PrintMessage(" expected ")
        PrintNumber(expected)
        PrintMessage("\n")
    }
}

SubRoutine.Main {
    PrintMessage("=== Sequential vs Nested IfCondition Test ===\n\n")
    
    PrintMessage("--- Sequential IfConditions (expect ALL to fail if bug exists) ---\n")
    r = SequentialIfs(1)
    CheckResult("SequentialIfs", 1, 10, r)
    
    r = SequentialIfs(3)
    CheckResult("SequentialIfs", 3, 30, r)
    
    r = SequentialIfs(5)
    CheckResult("SequentialIfs", 5, 50, r)
    
    r = SequentialIfs(99)
    CheckResult("SequentialIfs", 99, 0, r)
    
    PrintMessage("\n--- Nested ElseBlocks (should all pass) ---\n")
    r = NestedElses(1)
    CheckResult("NestedElses", 1, 10, r)
    
    r = NestedElses(3)
    CheckResult("NestedElses", 3, 30, r)
    
    r = NestedElses(5)
    CheckResult("NestedElses", 5, 50, r)
    
    r = NestedElses(99)
    CheckResult("NestedElses", 99, 0, r)
    
    PrintMessage("\n=== Summary ===\n")
    PrintMessage("Passed: ")
    PrintNumber(Test.passed)
    PrintMessage("\nFailed: ")
    PrintNumber(Test.failed)
    PrintMessage("\n")
    
    PrintMessage("\nNOTE: Sequential IfConditions are NOT short-circuit.\n")
    PrintMessage("Each IfCondition executes independently.\n")
    PrintMessage("Use nested ElseBlocks for mutual exclusion.\n")
}

RunTask(Main)