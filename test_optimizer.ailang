// =============================================================================
// test_optimizer.ailang
// Test file for CCompilerOptimizer math expression optimization
// =============================================================================

// Test state pool
FixedPool.TestState {
    "total_tests": Initialize=0, CanChange=True
    "passed_tests": Initialize=0, CanChange=True
    "failed_tests": Initialize=0, CanChange=True
    "test_name": Initialize="", CanChange=True
    "expected": Initialize=0, CanChange=True
    "actual": Initialize=0, CanChange=True
}

SubRoutine.RecordTest {
    TestState.total_tests = Add(TestState.total_tests, 1)
    PrintMessage("TEST ")
    PrintNumber(TestState.total_tests)
    PrintMessage(": ")
    PrintMessage(TestState.test_name)
    PrintMessage(" | Expected: ")
    PrintNumber(TestState.expected)
    PrintMessage(" Actual: ")
    PrintNumber(TestState.actual)
    
    IfCondition EqualTo(TestState.expected, TestState.actual) ThenBlock: {
        PrintMessage(" PASS\n")
        TestState.passed_tests = Add(TestState.passed_tests, 1)
    } ElseBlock: {
        PrintMessage(" FAIL\n")
        TestState.failed_tests = Add(TestState.failed_tests, 1)
    }
}

// =============================================================================
// SECTION 1: Simple Add (two constants)
// =============================================================================
Function.TestAddConstants {
    Output: Integer
    Body: {
        result = Add(10, 25)
        ReturnValue(result)
    }
}

// =============================================================================
// SECTION 2: Simple Add (two variables)
// =============================================================================
Function.TestAddVariables {
    Input: a: Integer
    Input: b: Integer
    Output: Integer
    Body: {
        result = Add(a, b)
        ReturnValue(result)
    }
}

// =============================================================================
// SECTION 3: Add variable and constant
// =============================================================================
Function.TestAddMixed {
    Input: x: Integer
    Output: Integer
    Body: {
        result = Add(x, 100)
        ReturnValue(result)
    }
}

// =============================================================================
// SECTION 4: Simple Multiply (two constants)
// =============================================================================
Function.TestMulConstants {
    Output: Integer
    Body: {
        result = Multiply(6, 7)
        ReturnValue(result)
    }
}

// =============================================================================
// SECTION 5: Simple Multiply (two variables)
// =============================================================================
Function.TestMulVariables {
    Input: a: Integer
    Input: b: Integer
    Output: Integer
    Body: {
        result = Multiply(a, b)
        ReturnValue(result)
    }
}

// =============================================================================
// SECTION 6: Nested - Add(Multiply(a, b), c) - THE KEY TEST
// This is where push/pop elimination matters most
// =============================================================================
Function.TestNestedMulAdd {
    Input: a: Integer
    Input: b: Integer
    Input: c: Integer
    Output: Integer
    Body: {
        result = Add(Multiply(a, b), c)
        ReturnValue(result)
    }
}

// =============================================================================
// SECTION 7: Nested - Multiply(Add(a, b), c)
// =============================================================================
Function.TestNestedAddMul {
    Input: a: Integer
    Input: b: Integer
    Input: c: Integer
    Output: Integer
    Body: {
        result = Multiply(Add(a, b), c)
        ReturnValue(result)
    }
}

// =============================================================================
// SECTION 8: Deeper nesting - Add(Multiply(a, b), Multiply(c, d))
// =============================================================================
Function.TestDeepNest {
    Input: a: Integer
    Input: b: Integer
    Input: c: Integer
    Input: d: Integer
    Output: Integer
    Body: {
        result = Add(Multiply(a, b), Multiply(c, d))
        ReturnValue(result)
    }
}

// =============================================================================
// SECTION 9: Subtract tests
// =============================================================================
Function.TestSubVariables {
    Input: a: Integer
    Input: b: Integer
    Output: Integer
    Body: {
        result = Subtract(a, b)
        ReturnValue(result)
    }
}

// =============================================================================
// SECTION 10: Modulo test (important for primes!)
// =============================================================================
Function.TestModulo {
    Input: a: Integer
    Input: b: Integer
    Output: Integer
    Body: {
        result = Modulo(a, b)
        ReturnValue(result)
    }
}

// =============================================================================
// SECTION 11: Primes-like pattern - the hot loop operation
// =============================================================================
Function.TestPrimesPattern {
    Input: n: Integer
    Input: i: Integer
    Output: Integer
    Body: {
        remainder = Modulo(n, i)
        ReturnValue(remainder)
    }
}

// =============================================================================
// MAIN TEST RUNNER
// =============================================================================
SubRoutine.Main {
    PrintMessage("==============================================\n")
    PrintMessage("OPTIMIZER TEST SUITE\n")
    PrintMessage("Testing math expression optimization\n")
    PrintMessage("==============================================\n\n")
    
    // Test 1: Add constants
    TestState.test_name = "Add(10, 25)"
    TestState.expected = 35
    TestState.actual = TestAddConstants()
    RunTask(RecordTest)
    
    // Test 2: Add variables
    TestState.test_name = "Add(a=15, b=25)"
    TestState.expected = 40
    TestState.actual = TestAddVariables(15, 25)
    RunTask(RecordTest)
    
    // Test 3: Add mixed
    TestState.test_name = "Add(x=50, 100)"
    TestState.expected = 150
    TestState.actual = TestAddMixed(50)
    RunTask(RecordTest)
    
    // Test 4: Multiply constants
    TestState.test_name = "Multiply(6, 7)"
    TestState.expected = 42
    TestState.actual = TestMulConstants()
    RunTask(RecordTest)
    
    // Test 5: Multiply variables
    TestState.test_name = "Multiply(a=8, b=9)"
    TestState.expected = 72
    TestState.actual = TestMulVariables(8, 9)
    RunTask(RecordTest)
    
    // Test 6: Nested Multiply then Add (KEY TEST)
    TestState.test_name = "Add(Multiply(3,4), 5)"
    TestState.expected = 17
    TestState.actual = TestNestedMulAdd(3, 4, 5)
    RunTask(RecordTest)
    
    // Test 7: Nested Add then Multiply
    TestState.test_name = "Multiply(Add(2,3), 4)"
    TestState.expected = 20
    TestState.actual = TestNestedAddMul(2, 3, 4)
    RunTask(RecordTest)
    
    // Test 8: Deep nesting
    TestState.test_name = "Add(Mul(2,3), Mul(4,5))"
    TestState.expected = 26
    TestState.actual = TestDeepNest(2, 3, 4, 5)
    RunTask(RecordTest)
    
    // Test 9: Subtract
    TestState.test_name = "Subtract(100, 37)"
    TestState.expected = 63
    TestState.actual = TestSubVariables(100, 37)
    RunTask(RecordTest)
    
    // Test 10: Modulo
    TestState.test_name = "Modulo(17, 5)"
    TestState.expected = 2
    TestState.actual = TestModulo(17, 5)
    RunTask(RecordTest)
    
    // Test 11: Primes pattern - divisible
    TestState.test_name = "Modulo(15, 3) == 0"
    TestState.expected = 0
    TestState.actual = TestPrimesPattern(15, 3)
    RunTask(RecordTest)
    
    // Test 12: Primes pattern - not divisible
    TestState.test_name = "Modulo(17, 3) != 0"
    TestState.expected = 2
    TestState.actual = TestPrimesPattern(17, 3)
    RunTask(RecordTest)
    
    // Summary
    PrintMessage("\n==============================================\n")
    PrintMessage("RESULTS: ")
    PrintNumber(TestState.passed_tests)
    PrintMessage(" passed, ")
    PrintNumber(TestState.failed_tests)
    PrintMessage(" failed, ")
    PrintNumber(TestState.total_tests)
    PrintMessage(" total\n")
    PrintMessage("==============================================\n")
    
    IfCondition EqualTo(TestState.failed_tests, 0) ThenBlock: {
        PrintMessage("\nAll tests PASSED!\n")
    } ElseBlock: {
        PrintMessage("\nSome tests FAILED!\n")
    }
}

RunTask(Main)