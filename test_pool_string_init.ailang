// Verify FixedPool string-literal Initialize works.
LibraryImport.Arena

FixedPool.S {
    "short":     Initialize="hi"
    "medium":    Initialize="hello world"
    "mixed_int": Initialize=42
}

SubRoutine.Main {
    SystemCall(1, 1, "short=",  6)
    SystemCall(1, 1, S.short,  StringLength(S.short))
    SystemCall(1, 1, "\nmed=",  5)
    SystemCall(1, 1, S.medium, StringLength(S.medium))
    SystemCall(1, 1, "\nint=",  5)
    PrintNumber(S.mixed_int)
    SystemCall(1, 1, "\n", 1)
    SystemCall(60, 0)
}
RunTask(Main)
