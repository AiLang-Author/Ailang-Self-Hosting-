// Verify Regex_DFASearch matches what Regex_Search would return.
// For each (pattern, text, expected) tuple: compile, init DFA, search,
// compare.

LibraryImport.Arena
LibraryImport.Regex_Thompson

Function.Run {
    Input: label: Address
    Input: pat:   Address
    Input: text:  Address
    Input: exp:   Integer
    Body: {
        SystemCall(1, 1, label, StringLength(label))
        SystemCall(1, 1, " pat=", 5)
        SystemCall(1, 1, pat, StringLength(pat))
        SystemCall(1, 1, " text=", 6)
        SystemCall(1, 1, text, StringLength(text))

        r = Regex_Compile(pat, 0)
        IfCondition EqualTo(r, 0) ThenBlock: {
            SystemCall(1, 1, " COMPILE_FAIL\n", 14)
            ReturnValue(0)
        }

        ok = Regex_DFAInit(r)
        IfCondition EqualTo(ok, 0) ThenBlock: {
            SystemCall(1, 1, " DFA_INIT_SKIP (assertions or alloc)\n", 37)
            ReturnValue(0)
        }

        tlen = StringLength(text)
        got = Regex_DFASearch(text, tlen)

        IfCondition LessThan(got, 0) ThenBlock: {
            SystemCall(1, 1, " DFA_OVERFLOW\n", 14)
            ReturnValue(0)
        }

        IfCondition EqualTo(got, exp) ThenBlock: {
            SystemCall(1, 1, " PASS\n", 6)
        } ElseBlock: {
            SystemCall(1, 1, " FAIL exp=", 10)
            PrintNumber(exp)
            SystemCall(1, 1, " got=", 5)
            PrintNumber(got)
            SystemCall(1, 1, "\n", 1)
        }
    }
}

SubRoutine.Main {
    Run("literal      ", "foo",           "hello foo world",     1)
    Run("literal-nope ", "foo",           "hello bar world",     0)
    Run("dot          ", "h.llo",         "say hello",           1)
    Run("star-bare    ", "a*",            "aaa",                 1)
    Run("star-mid     ", "he*l",          "heeeeeel",            1)
    Run("star-zero    ", "he*l",          "hl",                  1)
    Run("plus         ", "he+l",          "heeel",               1)
    Run("plus-zero-nope","he+l",          "hl",                  0)
    Run("question-y   ", "he?l",          "hel",                 1)
    Run("question-n   ", "he?l",          "hl",                  1)
    Run("class-simple ", "[abc]",         "xxxbxxx",             1)
    Run("class-no     ", "[xyz]",         "abc",                 0)
    Run("class-range  ", "[0-9]",         "abc123",              1)
    Run("class-neg    ", "[^abc]",        "abc",                 0)
    Run("class-neg-yes", "[^abc]",        "xyz",                 1)
    Run("alt-a        ", "cat|dog",       "it is a cat",         1)
    Run("alt-b        ", "cat|dog",       "it is a dog",         1)
    Run("alt-no       ", "cat|dog",       "it is a bird",        0)
    Run("mixed        ", "F[a-z]*n",      "Function",            1)
    Run("mixed-no     ", "F[a-z]*n",      "GunX",                0)
    SystemCall(60, 0)
}
RunTask(Main)
