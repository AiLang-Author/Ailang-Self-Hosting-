// Mimic grep's flow: compile once, then iterate matches over many lines.
// Also test multiple-pattern compile (grep -e A -e B).

LibraryImport.Arena
LibraryImport.Regex_Thompson

Function.MatchAnywhere {
    Input: regex: Address
    Input: text: Address
    Output: Integer
    Body: {
        tlen = StringLength(text)
        start = 0
        WhileLoop LessEqual(start, tlen) {
            m = Regex_Match(regex, text, start)
            IfCondition GreaterEqual(m, 0) ThenBlock: { ReturnValue(1) }
            start = Add(start, 1)
        }
        ReturnValue(0)
    }
}

SubRoutine.Main {
    // Test 1: compile once, match 100 times against same string
    SystemCall(1, 1, "TEST 1: compile once, match 100x\n", 33)
    r = Regex_Compile("F[a-z]*n", 0)
    IfCondition EqualTo(r, 0) ThenBlock: {
        SystemCall(1, 1, "  COMPILE_FAIL\n", 15)
    } ElseBlock: {
        ok = 0
        fail = 0
        i = 0
        WhileLoop LessThan(i, 100) {
            m = MatchAnywhere(r, "Function.Foo")
            IfCondition EqualTo(m, 1) ThenBlock: {
                ok = Add(ok, 1)
            } ElseBlock: {
                fail = Add(fail, 1)
            }
            i = Add(i, 1)
        }
        SystemCall(1, 1, "  ok=", 5)
        PrintNumber(ok)
        SystemCall(1, 1, " fail=", 6)
        PrintNumber(fail)
        SystemCall(1, 1, "\n", 1)
    }

    // Test 2: compile TWO patterns, match both
    SystemCall(1, 1, "TEST 2: two compiled patterns\n", 30)
    r1 = Regex_Compile("F[a-z]*n", 0)
    r2 = Regex_Compile("[A-Z][a-z]+", 0)

    IfCondition EqualTo(r1, 0) ThenBlock: {
        SystemCall(1, 1, "  r1 COMPILE_FAIL\n", 18)
    } ElseBlock: {
        SystemCall(1, 1, "  r1 compiled\n", 14)
    }
    IfCondition EqualTo(r2, 0) ThenBlock: {
        SystemCall(1, 1, "  r2 COMPILE_FAIL\n", 18)
    } ElseBlock: {
        SystemCall(1, 1, "  r2 compiled\n", 14)
    }

    // After r2 compiled, does r1 still match?
    IfCondition NotEqual(r1, 0) ThenBlock: {
        m = MatchAnywhere(r1, "Function")
        SystemCall(1, 1, "  r1 match after r2 compile: ", 29)
        PrintNumber(m)
        SystemCall(1, 1, "\n", 1)
    }
    IfCondition NotEqual(r2, 0) ThenBlock: {
        m = MatchAnywhere(r2, "Function")
        SystemCall(1, 1, "  r2 match: ", 12)
        PrintNumber(m)
        SystemCall(1, 1, "\n", 1)
    }

    SystemCall(60, 0)
}
RunTask(Main)
