LibraryImport.Arena

SubRoutine.Main {
    Arena_Init()
    
    PrintMessage("Test 1: StringConcat\n")
    result = StringConcat("Hello", "World")
    PrintMessage(result)
    PrintMessage("\n")
    
    PrintMessage("Test 2: NumberToString\n")
    num_str = NumberToString(42)
    PrintMessage(num_str)
    PrintMessage("\n")
    
    PrintMessage("Test 3: StringSubstring\n")
    sub = StringSubstring("debug 1", 6, 1)
    PrintMessage("Got: [")
    PrintMessage(sub)
    PrintMessage("]\n")
    
    PrintMessage("Test 4: StringToNumber\n")
    num = StringToNumber(sub)
    PrintMessage("As number: ")
    PrintNumber(num)
    PrintMessage("\n")
    
    PrintMessage("Done!\n")
}
RunTask(Main)