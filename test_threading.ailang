// test_threading.ailang
// Full test harness for Library.ThreadTrampoline
//
// Build: ./build.sh test_threading.ailang
// Run:   ./test_threading.x

LibraryImport.ThreadTrampoline

// =============================================================================
// TEST FRAMEWORK
// =============================================================================
FixedPool.Test {
    "total":  Initialize=0
    "passed": Initialize=0
    "failed": Initialize=0
}

Function.TestAssert {
    Input: name:     Address
    Input: expected: Integer
    Input: actual:   Integer
    Output: Integer
    Body: {
        Test.total = Add(Test.total, 1)
        PrintMessage("  TEST: ")
        PrintMessage(name)
        PrintMessage(" | exp=")
        PrintNumber(expected)
        PrintMessage(" act=")
        PrintNumber(actual)

        IfCondition EqualTo(expected, actual) ThenBlock: {
            PrintMessage(" | PASS\n")
            Test.passed = Add(Test.passed, 1)
            ReturnValue(1)
        } ElseBlock: {
            PrintMessage(" | FAIL\n")
            Test.failed = Add(Test.failed, 1)
            ReturnValue(0)
        }
    }
}

Function.TestAssertNonZero {
    Input: name:   Address
    Input: actual: Integer
    Output: Integer
    Body: {
        Test.total = Add(Test.total, 1)
        PrintMessage("  TEST: ")
        PrintMessage(name)
        PrintMessage(" | act=")
        PrintNumber(actual)

        IfCondition NotEqual(actual, 0) ThenBlock: {
            PrintMessage(" | PASS (nonzero)\n")
            Test.passed = Add(Test.passed, 1)
            ReturnValue(1)
        } ElseBlock: {
            PrintMessage(" | FAIL (was zero)\n")
            Test.failed = Add(Test.failed, 1)
            ReturnValue(0)
        }
    }
}

// =============================================================================
// WORKER FUNCTIONS
// =============================================================================

// Returns cookie as exit code
Function.Worker_Echo {
    Input: cookie: Integer
    Output: Integer
    Body: {
        PrintMessage("    [Worker_Echo] cookie=")
        PrintNumber(cookie)
        PrintMessage(" tid=")
        PrintNumber(Thread_Self())
        PrintMessage("\n")
        ReturnValue(cookie)
    }
}

// Returns cookie * 2
Function.Worker_Double {
    Input: cookie: Integer
    Output: Integer
    Body: {
        PrintMessage("    [Worker_Double] cookie=")
        PrintNumber(cookie)
        PrintMessage("\n")
        ReturnValue(Multiply(cookie, 2))
    }
}

// Shared state for increment tests
FixedPool.Shared {
    "counter":       Initialize=0
    "mutex_counter": Initialize=0
    "mutex_ptr":     Initialize=0
}

// Increments shared counter (NO mutex — unsafe, single-thread only)
Function.Worker_IncrementUnsafe {
    Input: cookie: Integer
    Output: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, cookie) {
            val = Shared.counter
            Shared.counter = Add(val, 1)
            i = Add(i, 1)
        }
        PrintMessage("    [Worker_IncrementUnsafe] did ")
        PrintNumber(cookie)
        PrintMessage(" increments\n")
        ReturnValue(0)
    }
}

// Increments shared counter WITH mutex
Function.Worker_IncrementSafe {
    Input: cookie: Integer
    Output: Integer
    Body: {
        m = Shared.mutex_ptr
        i = 0
        WhileLoop LessThan(i, cookie) {
            Mutex_Lock(m)
            val = Shared.mutex_counter
            Shared.mutex_counter = Add(val, 1)
            Mutex_Unlock(m)
            i = Add(i, 1)
        }
        PrintMessage("    [Worker_IncrementSafe] did ")
        PrintNumber(cookie)
        PrintMessage(" safe increments\n")
        ReturnValue(0)
    }
}

// Sleeps then returns
Function.Worker_Sleeper {
    Input: cookie: Integer
    Output: Integer
    Body: {
        PrintMessage("    [Worker_Sleeper] sleeping ")
        PrintNumber(cookie)
        PrintMessage("ms\n")
        Thread_Sleep(cookie)
        PrintMessage("    [Worker_Sleeper] woke up\n")
        ReturnValue(cookie)
    }
}

// =============================================================================
// TEST 1: Basic spawn + join
// =============================================================================
SubRoutine.Test1_BasicSpawnJoin {
    PrintMessage("\n========================================\n")
    PrintMessage("TEST 1: Basic Spawn + Join\n")
    PrintMessage("========================================\n")

    tid = Thread_Spawn(AddressOf(Worker_Echo), 42)
    TestAssertNonZero("spawn returned tid", tid)

    exit_code = Thread_Join(tid)
    TestAssert("join got exit code", 42, exit_code)
}

// =============================================================================
// TEST 2: Thread returns computed value
// =============================================================================
SubRoutine.Test2_ReturnValue {
    PrintMessage("\n========================================\n")
    PrintMessage("TEST 2: Thread Returns Computed Value\n")
    PrintMessage("========================================\n")

    tid = Thread_Spawn(AddressOf(Worker_Double), 21)
    TestAssertNonZero("spawn ok", tid)

    exit_code = Thread_Join(tid)
    TestAssert("double(21) = 42", 42, exit_code)
}

// =============================================================================
// TEST 3: Two threads concurrently
// =============================================================================
SubRoutine.Test3_TwoThreads {
    PrintMessage("\n========================================\n")
    PrintMessage("TEST 3: Two Concurrent Threads\n")
    PrintMessage("========================================\n")

    tid1 = Thread_Spawn(AddressOf(Worker_Echo), 100)
    TestAssertNonZero("thread 1 spawned", tid1)

    tid2 = Thread_Spawn(AddressOf(Worker_Double), 50)
    TestAssertNonZero("thread 2 spawned", tid2)

    count = Thread_Count()
    TestAssert("2 threads active", 2, count)

    ec1 = Thread_Join(tid1)
    TestAssert("thread 1 echo(100)", 100, ec1)

    ec2 = Thread_Join(tid2)
    TestAssert("thread 2 double(50)", 100, ec2)

    count2 = Thread_Count()
    TestAssert("0 threads after join", 0, count2)
}

// =============================================================================
// TEST 4: Shared memory (single thread, proves CLONE_VM)
// =============================================================================
SubRoutine.Test4_SharedMemory {
    PrintMessage("\n========================================\n")
    PrintMessage("TEST 4: Shared Memory via CLONE_VM\n")
    PrintMessage("========================================\n")

    Shared.counter = 0

    tid = Thread_Spawn(AddressOf(Worker_IncrementUnsafe), 1000)
    TestAssertNonZero("spawned", tid)

    Thread_Join(tid)

    TestAssert("single-thread counter", 1000, Shared.counter)
}

// =============================================================================
// TEST 5: Mutex-protected counter (two threads)
// =============================================================================
SubRoutine.Test5_MutexCounter {
    PrintMessage("\n========================================\n")
    PrintMessage("TEST 5: Mutex-Protected Shared Counter\n")
    PrintMessage("========================================\n")

    Shared.mutex_counter = 0
    m = Mutex_Create()
    Shared.mutex_ptr = m

    tid1 = Thread_Spawn(AddressOf(Worker_IncrementSafe), 500)
    tid2 = Thread_Spawn(AddressOf(Worker_IncrementSafe), 500)

    TestAssertNonZero("thread 1 spawned", tid1)
    TestAssertNonZero("thread 2 spawned", tid2)

    Thread_Join(tid1)
    Thread_Join(tid2)

    TestAssert("mutex counter = 1000", 1000, Shared.mutex_counter)

    Mutex_Destroy(m)
}

// =============================================================================
// TEST 6: Thread_Self and Thread_IsAlive
// =============================================================================
SubRoutine.Test6_Queries {
    PrintMessage("\n========================================\n")
    PrintMessage("TEST 6: Thread_Self / Thread_IsAlive\n")
    PrintMessage("========================================\n")

    main_tid = Thread_Self()
    TestAssertNonZero("main tid nonzero", main_tid)
    PrintMessage("  Main thread tid=")
    PrintNumber(main_tid)
    PrintMessage("\n")

    tid = Thread_Spawn(AddressOf(Worker_Sleeper), 200)
    TestAssertNonZero("spawned sleeper", tid)

    alive = Thread_IsAlive(tid)
    TestAssert("sleeper alive", 1, alive)

    ec = Thread_Join(tid)
    TestAssert("sleeper exit code", 200, ec)

    alive2 = Thread_IsAlive(tid)
    TestAssert("sleeper gone after join", 0, alive2)
}

// =============================================================================
// TEST 7: Sequential spawn-join stress
// =============================================================================
SubRoutine.Test7_Stress {
    PrintMessage("\n========================================\n")
    PrintMessage("TEST 7: Sequential Spawn-Join Stress\n")
    PrintMessage("========================================\n")

    num_iters = 20
    all_ok = 1
    sum = 0

    i = 0
    WhileLoop LessThan(i, num_iters) {
        tid = Thread_Spawn(AddressOf(Worker_Echo), i)
        IfCondition EqualTo(tid, 0) ThenBlock: {
            PrintMessage("  FAIL: spawn failed at i=")
            PrintNumber(i)
            PrintMessage("\n")
            all_ok = 0
        } ElseBlock: {
            ec = Thread_Join(tid)
            IfCondition NotEqual(ec, i) ThenBlock: {
                PrintMessage("  FAIL: wrong exit code at i=")
                PrintNumber(i)
                PrintMessage(" got=")
                PrintNumber(ec)
                PrintMessage("\n")
                all_ok = 0
            }
            sum = Add(sum, ec)
        }
        i = Add(i, 1)
    }

    TestAssert("stress sum 0..19", 190, sum)
    TestAssert("all spawns ok", 1, all_ok)
    TestAssert("no leaked threads", 0, Thread_Count())
}

// =============================================================================
// MAIN
// =============================================================================
SubRoutine.Main {
    PrintMessage("==============================================\n")
    PrintMessage("  AILANG THREADING TEST HARNESS\n")
    PrintMessage("==============================================\n")
    PrintMessage("  Main PID: ")
    PrintNumber(SystemCall(39, 0, 0, 0, 0, 0, 0))
    PrintMessage("\n")
    PrintMessage("  Main TID: ")
    PrintNumber(SystemCall(186, 0, 0, 0, 0, 0, 0))
    PrintMessage("\n")

    Thread_Init()

    RunTask(Test1_BasicSpawnJoin)
    RunTask(Test2_ReturnValue)
    RunTask(Test3_TwoThreads)
    RunTask(Test4_SharedMemory)
    RunTask(Test5_MutexCounter)
    RunTask(Test6_Queries)
    RunTask(Test7_Stress)

    // === SUMMARY ===
    PrintMessage("\n==============================================\n")
    PrintMessage("  RESULTS\n")
    PrintMessage("==============================================\n")
    PrintMessage("  Total:  ")
    PrintNumber(Test.total)
    PrintMessage("\n  Passed: ")
    PrintNumber(Test.passed)
    PrintMessage("\n  Failed: ")
    PrintNumber(Test.failed)
    PrintMessage("\n")

    IfCondition EqualTo(Test.failed, 0) ThenBlock: {
        PrintMessage("\n  ALL TESTS PASSED!\n")
    } ElseBlock: {
        PrintMessage("\n  SOME TESTS FAILED\n")
    }

    PrintMessage("==============================================\n")
}

RunTask(Main)