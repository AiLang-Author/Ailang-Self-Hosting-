
LibraryImport.Arena

LinkagePool.SimplePool {
    "x": Initialize=0
    "y": Initialize=0
}

SubRoutine.Main {
    Arena_Init()
    
    PrintMessage("Write Test\n")
    ptr = AllocateLinkage(LinkagePool.SimplePool)
    
    ptr@x = 42
    ptr@y = 100
    
    val_x = ptr@x
    val_y = ptr@y
    
    PrintMessage("x = ")
    PrintNumber(val_x)
    PrintMessage("\n")
    
    PrintMessage("y = ")
    PrintNumber(val_y)
    PrintMessage("\n")
    
    Exit(0)
}

RunTask(Main)
