LibraryImport.Arena

LinkagePool.Simple {
    "a": Initialize=0
    "b": Initialize=0
    "c": Initialize=0
    "d": Initialize=0
    "e": Initialize=0
    "f": Initialize=0
}

SubRoutine.Main {
    Arena_Init()
    PrintMessage("before alloc\n")
    p = AllocateLinkage(LinkagePool.Simple)
    PrintMessage("after alloc\n")
    PrintNumber(p)
    PrintMessage("\n")
    Exit(0)
}

RunTask(Main)