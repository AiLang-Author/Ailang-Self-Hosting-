// Illegal: 7 inputs, only 6 SysV registers. The 7th is dropped.
Function.TooMany {
    Input: a: Integer
    Input: b: Integer
    Input: c: Integer
    Input: d: Integer
    Input: e: Integer
    Input: f: Integer
    Input: g: Integer
    Output: Integer
    Body: {
        ReturnValue(a)
    }
}

SubRoutine.Main {
    SystemCall(60, 0)
}

RunTask(Main)
