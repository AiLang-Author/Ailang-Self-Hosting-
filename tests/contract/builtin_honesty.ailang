LibraryImport.Arena

SubRoutine.Main {
    Arena_Init()

    s = NumberToString(42)
    PrintMessage("nts42=")
    PrintMessage(s)
    PrintMessage("\n")

    sn = NumberToString(-7)
    PrintMessage("ntsn7=")
    PrintMessage(sn)
    PrintMessage("\n")

    sz = NumberToString(0)
    PrintMessage("nts0=")
    PrintMessage(sz)
    PrintMessage("\n")

    one = 4607182418800017408
    two = 4611686018427387904
    three = 4613937818241073152
    four = 4616189618054758400
    mone = -4616189618054758400
    mtwo = -4611686018427387904
    zero = 0

    p = Float_Mul(mtwo, three)
    PrintMessage("mul_m2_3=")
    PrintNumber(p)
    PrintMessage("\n")

    q = Float_Mul(mtwo, mtwo)
    PrintMessage("mul_m2_m2=")
    PrintNumber(q)
    PrintMessage("\n")

    r = Float_Mul(two, three)
    PrintMessage("mul_2_3=")
    PrintNumber(r)
    PrintMessage("\n")

    le1 = Float_Le(mone, zero)
    PrintMessage("le_m1_0=")
    PrintNumber(le1)
    PrintMessage("\n")

    le2 = Float_Le(one, zero)
    PrintMessage("le_1_0=")
    PrintNumber(le2)
    PrintMessage("\n")

    le3 = Float_Le(zero, zero)
    PrintMessage("le_0_0=")
    PrintNumber(le3)
    PrintMessage("\n")

    lt1 = Float_Lt(mone, zero)
    PrintMessage("lt_m1_0=")
    PrintNumber(lt1)
    PrintMessage("\n")

    lt2 = Float_Lt(one, zero)
    PrintMessage("lt_1_0=")
    PrintNumber(lt2)
    PrintMessage("\n")

    ge1 = Float_Ge(mone, zero)
    PrintMessage("ge_m1_0=")
    PrintNumber(ge1)
    PrintMessage("\n")

    ProcessExit(0)
}

RunTask(Main)
