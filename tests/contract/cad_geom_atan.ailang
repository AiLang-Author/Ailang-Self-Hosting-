LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom

SubRoutine.Main {
    Arena_Init()
    zero = 0
    one = 0x3FF0000000000000
    a0 = CAD_Geom.Atan(zero)
    IfCondition NotEqual(a0, zero) ThenBlock: { ProcessExit(1) }
    a1 = CAD_Geom.Atan(one)
    pi4 = 0x3FE921FB54442D18
    d = Float_Sub(a1, pi4)
    IfCondition EqualTo(CAD_Num.IsZero(d, 0x3E7AD7F29ABCAF48), 0) ThenBlock: {
        ProcessExit(2)
    }
    mone = Float_Sub(0, one)
    am = CAD_Geom.Atan(mone)
    mpi4 = Float_Sub(0, pi4)
    d2 = Float_Sub(am, mpi4)
    IfCondition EqualTo(CAD_Num.IsZero(d2, 0x3E7AD7F29ABCAF48), 0) ThenBlock: {
        ProcessExit(3)
    }
    ProcessExit(0)
}

RunTask(Main)
