LibraryImport.Arena
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom

SubRoutine.Main {
    Arena_Init()
    zero = 0
    one = 0x3FF0000000000000
    pi2 = 0x3FF921FB54442D18
    s0 = CAD_Geom.Sin(zero)
    c0 = CAD_Geom.Cos(zero)
    IfCondition NotEqual(s0, zero) ThenBlock: { ProcessExit(1) }
    IfCondition NotEqual(c0, one) ThenBlock: { ProcessExit(2) }
    s1 = CAD_Geom.Sin(pi2)
    c1 = CAD_Geom.Cos(pi2)
    d1 = Float_Sub(s1, one)
    IfCondition EqualTo(CAD_Num.IsZero(d1, 0x3E7AD7F29ABCAF48), 0) ThenBlock: {
        ProcessExit(3)
    }
    d2 = CAD_Num.Abs(c1)
    IfCondition EqualTo(CAD_Num.IsZero(d2, 0x3E7AD7F29ABCAF48), 0) ThenBlock: {
        ProcessExit(4)
    }
    ProcessExit(0)
}

RunTask(Main)
