// CQO + SHL rax, cl (Enc gaps). Divide and variable shift.
Function.Divish {
    Input: a: Integer
    Input: b: Integer
    Output: Integer
    Body: {
        q = Divide(a, b)
        ReturnValue(q)
    }
}

Function.ShlVar {
    Input: v: Integer
    Input: n: Integer
    Output: Integer
    Body: {
        s = LeftShift(v, n)
        ReturnValue(s)
    }
}

SubRoutine.Main {
    q = Divish(20, 4)
    PrintMessage("div=")
    PrintNumber(q)
    PrintMessage("\n")
    s = ShlVar(3, 2)
    PrintMessage("shl=")
    PrintNumber(s)
    PrintMessage("\n")
    IfCondition NotEqual(q, 5) ThenBlock: {
        ProcessExit(1)
    }
    IfCondition NotEqual(s, 12) ThenBlock: {
        ProcessExit(2)
    }
    ProcessExit(0)
}

RunTask(Main)
