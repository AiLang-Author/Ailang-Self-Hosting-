// Float_Atan2(y, x). Integer literals are IEEE-754 bit patterns.
SubRoutine.Main {
    one = 4607182418800017408
    mone = -4616189618054758400
    z = Float_Atan2(0, one)
    PrintMessage("z=")
    PrintNumber(z)
    PrintMessage("\n")

    a = Float_Atan2(one, one)
    PrintMessage("pp=")
    PrintNumber(a)
    PrintMessage("\n")

    a = Float_Atan2(one, 0)
    PrintMessage("p0=")
    PrintNumber(a)
    PrintMessage("\n")

    a = Float_Atan2(one, mone)
    PrintMessage("pn=")
    PrintNumber(a)
    PrintMessage("\n")

    a = Float_Atan2(0, mone)
    PrintMessage("zn=")
    PrintNumber(a)
    PrintMessage("\n")

    a = Float_Atan2(mone, mone)
    PrintMessage("nn=")
    PrintNumber(a)
    PrintMessage("\n")

    a = Float_Atan2(mone, 0)
    PrintMessage("n0=")
    PrintNumber(a)
    PrintMessage("\n")

    a = Float_Atan2(mone, one)
    PrintMessage("np=")
    PrintNumber(a)
    PrintMessage("\n")

    three = 4613937818241073152
    four = 4616189618054758400
    a = Float_Atan2(three, four)
    PrintMessage("34=")
    PrintNumber(a)
    PrintMessage("\n")

    pinf = 9218868437227405312
    a = Float_Atan2(pinf, pinf)
    PrintMessage("ii=")
    PrintNumber(a)
    PrintMessage("\n")

    qnan = 9221120237041090560
    a = Float_Atan2(qnan, one)
    PrintMessage("qy=")
    PrintNumber(a)
    PrintMessage("\n")

    ProcessExit(0)
}

RunTask(Main)
