// SSE4.1 ROUNDSD + FMA3 smoke. Baseline compiler ISA is SSE2;
// this probe is only run if the CPU has the extra flags.
SubRoutine.Main {
    seven = Float_FromInt(7)
    two = Float_FromInt(2)
    x = Float_Div(seven, two)

    fl = Float_Floor(x)
    fi = Float_ToInt(fl)
    PrintMessage("floor=")
    PrintNumber(fi)
    PrintMessage("\n")

    ce = Float_Ceil(x)
    ci = Float_ToInt(ce)
    PrintMessage("ceil=")
    PrintNumber(ci)
    PrintMessage("\n")

    tr = Float_Trunc(x)
    ti = Float_ToInt(tr)
    PrintMessage("trunc=")
    PrintNumber(ti)
    PrintMessage("\n")

    a = Float_FromInt(2)
    b = Float_FromInt(3)
    c = Float_FromInt(4)
    r = Float_FMA(a, b, c)
    ri = Float_ToInt(r)
    PrintMessage("fma=")
    PrintNumber(ri)
    PrintMessage("\n")

    ProcessExit(0)
}

RunTask(Main)
