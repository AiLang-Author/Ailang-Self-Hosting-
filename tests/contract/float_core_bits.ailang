SubRoutine.Main {
    one = 4607182418800017408
    mone = -4616189618054758400
    n0 = -9223372036854775808
    pinf = 9218868437227405312
    qn = 9221120237041090560
    n = Float_Neg(one)
    IfCondition NotEqual(n, mone) ThenBlock: { ProcessExit(1) }
    a = Float_Abs(mone)
    IfCondition NotEqual(a, one) ThenBlock: { ProcessExit(2) }
    c = Float_Copysign(one, mone)
    IfCondition NotEqual(c, mone) ThenBlock: { ProcessExit(3) }
    IfCondition NotEqual(Float_SignBit(n0), 1) ThenBlock: { ProcessExit(4) }
    IfCondition NotEqual(Float_SignBit(one), 0) ThenBlock: { ProcessExit(5) }
    IfCondition NotEqual(Float_IsInf(pinf), 1) ThenBlock: { ProcessExit(6) }
    IfCondition NotEqual(Float_IsInf(one), 0) ThenBlock: { ProcessExit(7) }
    IfCondition NotEqual(Float_IsNan(qn), 1) ThenBlock: { ProcessExit(8) }
    IfCondition NotEqual(Float_IsNan(one), 0) ThenBlock: { ProcessExit(9) }
    two = 4611686018427387904
    m = Float_Mod(two, one)
    IfCondition NotEqual(m, 0) ThenBlock: { ProcessExit(10) }
    ProcessExit(0)
}

RunTask(Main)
