// Float_Cos probe. Integer literals are IEEE-754 bit patterns.
SubRoutine.Main {
    z = Float_Cos(0)
    PrintMessage("z=")
    PrintNumber(z)
    PrintMessage("\n")

    nz = Float_Cos(-9223372036854775808)
    PrintMessage("nz=")
    PrintNumber(nz)
    PrintMessage("\n")

    pi2 = Float_Cos(4609753056924675352)
    PrintMessage("pi2=")
    PrintNumber(pi2)
    PrintMessage("\n")

    pi = Float_Cos(4614256656552045848)
    PrintMessage("pi=")
    PrintNumber(pi)
    PrintMessage("\n")

    npi2 = Float_Cos(-4613618979930100456)
    PrintMessage("npi2=")
    PrintNumber(npi2)
    PrintMessage("\n")

    tpi2 = Float_Cos(4616991696741409234)
    PrintMessage("tpi2=")
    PrintNumber(tpi2)
    PrintMessage("\n")

    twopi = Float_Cos(4618760256179416344)
    PrintMessage("twopi=")
    PrintNumber(twopi)
    PrintMessage("\n")

    pi3 = Float_Cos(4607394977673999205)
    PrintMessage("pi3=")
    PrintNumber(pi3)
    PrintMessage("\n")

    one = Float_Cos(4607182418800017408)
    PrintMessage("one=")
    PrintNumber(one)
    PrintMessage("\n")

    pinf = Float_Cos(9218868437227405312)
    PrintMessage("pinf=")
    PrintNumber(pinf)
    PrintMessage("\n")

    ninf = Float_Cos(-4503599627370496)
    PrintMessage("ninf=")
    PrintNumber(ninf)
    PrintMessage("\n")

    qnan = Float_Cos(9221120237041090560)
    PrintMessage("qnan=")
    PrintNumber(qnan)
    PrintMessage("\n")

    fi = Float_FromInt(0)
    z2 = Float_Cos(fi)
    PrintMessage("fromint0=")
    PrintNumber(z2)
    PrintMessage("\n")

    i = 0
    WhileLoop LessThan(i, 8) {
        fx = Float_FromInt(i)
        s = Float_Cos(fx)
        PrintMessage("grid=")
        PrintNumber(i)
        PrintMessage(" ")
        PrintNumber(s)
        PrintMessage("\n")
        i = Add(i, 1)
    }

    ni = 1
    WhileLoop LessThan(ni, 5) {
        nneg = Subtract(0, ni)
        fxn = Float_FromInt(nneg)
        sn = Float_Cos(fxn)
        PrintMessage("ngrid=")
        PrintNumber(nneg)
        PrintMessage(" ")
        PrintNumber(sn)
        PrintMessage("\n")
        ni = Add(ni, 1)
    }

    ProcessExit(0)
}

RunTask(Main)
