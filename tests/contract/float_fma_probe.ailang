// Float_FMA(a,b,c) = a*b+c. Nested Add(Mul) should fuse on Hw.level ≥ 2.
SubRoutine.Main {
    one = 4607182418800017408
    two = 4611686018427387904
    three = 4613937818241073152
    five = Float_FMA(one, two, three)
    PrintMessage("fma=")
    PrintNumber(five)
    PrintMessage("\n")
    fused = Float_Add(Float_Mul(one, two), three)
    PrintMessage("fused=")
    PrintNumber(fused)
    PrintMessage("\n")
    m = Float_Mul(one, two)
    s = Float_Add(m, three)
    PrintMessage("sep=")
    PrintNumber(s)
    PrintMessage("\n")
    ProcessExit(0)
}

RunTask(Main)
