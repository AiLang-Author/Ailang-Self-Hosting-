// Float_Sin probe. Integer literals are IEEE-754 bit patterns.
// z=0  pi2=π/2  pi=π  npi2=-π/2  pi6=π/6  one=1.0  pinf=+Inf  ninf=-Inf  qnan=NaN
SubRoutine.Main {
    z = Float_Sin(0)
    PrintMessage("z=")
    PrintNumber(z)
    PrintMessage("\n")

    nz = Float_Sin(-9223372036854775808)
    PrintMessage("nz=")
    PrintNumber(nz)
    PrintMessage("\n")

    pi2 = Float_Sin(4609753056924675352)
    PrintMessage("pi2=")
    PrintNumber(pi2)
    PrintMessage("\n")

    pi = Float_Sin(4614256656552045848)
    PrintMessage("pi=")
    PrintNumber(pi)
    PrintMessage("\n")

    npi2 = Float_Sin(-4613618979930100456)
    PrintMessage("npi2=")
    PrintNumber(npi2)
    PrintMessage("\n")

    tpi2 = Float_Sin(4616991696741409234)
    PrintMessage("tpi2=")
    PrintNumber(tpi2)
    PrintMessage("\n")

    twopi = Float_Sin(4618760256179416344)
    PrintMessage("twopi=")
    PrintNumber(twopi)
    PrintMessage("\n")

    pi6 = Float_Sin(4602891378046628709)
    PrintMessage("pi6=")
    PrintNumber(pi6)
    PrintMessage("\n")

    one = Float_Sin(4607182418800017408)
    PrintMessage("one=")
    PrintNumber(one)
    PrintMessage("\n")

    pinf = Float_Sin(9218868437227405312)
    PrintMessage("pinf=")
    PrintNumber(pinf)
    PrintMessage("\n")

    ninf = Float_Sin(-4503599627370496)
    PrintMessage("ninf=")
    PrintNumber(ninf)
    PrintMessage("\n")

    qnan = Float_Sin(9221120237041090560)
    PrintMessage("qnan=")
    PrintNumber(qnan)
    PrintMessage("\n")

    fi = Float_FromInt(0)
    z2 = Float_Sin(fi)
    PrintMessage("fromint0=")
    PrintNumber(z2)
    PrintMessage("\n")

    i = 0
    WhileLoop LessThan(i, 8) {
        fx = Float_FromInt(i)
        s = Float_Sin(fx)
        PrintMessage("grid=")
        PrintNumber(i)
        PrintMessage(" ")
        PrintNumber(s)
        PrintMessage("\n")
        i = Add(i, 1)
    }

    ni = 1
    WhileLoop LessThan(ni, 5) {
        nneg = Subtract(0, ni)
        fxn = Float_FromInt(nneg)
        sn = Float_Sin(fxn)
        PrintMessage("ngrid=")
        PrintNumber(nneg)
        PrintMessage(" ")
        PrintNumber(sn)
        PrintMessage("\n")
        ni = Add(ni, 1)
    }

    ProcessExit(0)
}

RunTask(Main)
