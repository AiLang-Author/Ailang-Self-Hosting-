// Float_Tan probe. Integer literals are IEEE-754 bit patterns.
SubRoutine.Main {
    z = Float_Tan(0)
    PrintMessage("z=")
    PrintNumber(z)
    PrintMessage("\n")

    nz = Float_Tan(-9223372036854775808)
    PrintMessage("nz=")
    PrintNumber(nz)
    PrintMessage("\n")

    pi4 = Float_Tan(4605249457297304856)
    PrintMessage("pi4=")
    PrintNumber(pi4)
    PrintMessage("\n")

    npi4 = Float_Tan(-4618122579557470952)
    PrintMessage("npi4=")
    PrintNumber(npi4)
    PrintMessage("\n")

    pi = Float_Tan(4614256656552045848)
    PrintMessage("pi=")
    PrintNumber(pi)
    PrintMessage("\n")

    pi6 = Float_Tan(4602891378046628709)
    PrintMessage("pi6=")
    PrintNumber(pi6)
    PrintMessage("\n")

    one = Float_Tan(4607182418800017408)
    PrintMessage("one=")
    PrintNumber(one)
    PrintMessage("\n")

    twopi = Float_Tan(4618760256179416344)
    PrintMessage("twopi=")
    PrintNumber(twopi)
    PrintMessage("\n")

    pinf = Float_Tan(9218868437227405312)
    PrintMessage("pinf=")
    PrintNumber(pinf)
    PrintMessage("\n")

    ninf = Float_Tan(-4503599627370496)
    PrintMessage("ninf=")
    PrintNumber(ninf)
    PrintMessage("\n")

    qnan = Float_Tan(9221120237041090560)
    PrintMessage("qnan=")
    PrintNumber(qnan)
    PrintMessage("\n")

    i = 0
    WhileLoop LessThan(i, 8) {
        fx = Float_FromInt(i)
        t = Float_Tan(fx)
        PrintMessage("grid=")
        PrintNumber(i)
        PrintMessage(" ")
        PrintNumber(t)
        PrintMessage("\n")
        i = Add(i, 1)
    }

    ni = 1
    WhileLoop LessThan(ni, 5) {
        nneg = Subtract(0, ni)
        fxn = Float_FromInt(nneg)
        tn = Float_Tan(fxn)
        PrintMessage("ngrid=")
        PrintNumber(nneg)
        PrintMessage(" ")
        PrintNumber(tn)
        PrintMessage("\n")
        ni = Add(ni, 1)
    }

    ProcessExit(0)
}

RunTask(Main)
