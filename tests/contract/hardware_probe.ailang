LibraryImport.Hardware

SubRoutine.Main {
    Hw.Probe()
    PrintMessage("vendor=")
    PrintMessage(Hw.vendor)
    PrintMessage("\n")
    PrintMessage("summary=")
    PrintMessage(Hw.summary)
    PrintMessage("\n")
    PrintMessage("sse2=")
    PrintNumber(Hw.sse2)
    PrintMessage(" sse4.1=")
    PrintNumber(Hw.sse4_1)
    PrintMessage(" avx=")
    PrintNumber(Hw.avx)
    PrintMessage(" fma=")
    PrintNumber(Hw.fma)
    PrintMessage(" avx2=")
    PrintNumber(Hw.avx2)
    PrintMessage(" level=")
    PrintNumber(Hw.level)
    PrintMessage("\n")
    IfCondition EqualTo(Hw.sse2, 0) ThenBlock: {
        ProcessExit(1)
    }
    ProcessExit(0)
}

RunTask(Main)
