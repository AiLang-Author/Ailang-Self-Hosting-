LibraryImport.Math

SubRoutine.Main {
    three = 4613937818241073152
    four = 4616189618054758400
    five = 4617315517961601024
    h = Math.Hypot(three, four)
    IfCondition NotEqual(h, five) ThenBlock: {
        ProcessExit(1)
    }
    one = 4607182418800017408
    z = Math.Atan(0)
    IfCondition NotEqual(z, 0) ThenBlock: {
        ProcessExit(2)
    }
    e2 = Math.Exp2(0)
    IfCondition NotEqual(e2, one) ThenBlock: {
        ProcessExit(3)
    }
    ProcessExit(0)
}

RunTask(Main)
