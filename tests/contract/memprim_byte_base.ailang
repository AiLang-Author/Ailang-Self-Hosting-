LibraryImport.Arena

FixedPool.GP {
    "buffer": Initialize=0, CanChange=True
    "pos": Initialize=0, CanChange=True
}

SubRoutine.Main {
    GP.buffer = "  {\"a\": 1}"
    GP.pos = 0
    n = 0
    WhileLoop LessThan(GP.pos, 11) {
        a = RDMEM_8(GP.buffer, GP.pos)
        b = RDMEM_8(Add(GP.buffer, GP.pos))
        IfCondition NotEqual(a, b) ThenBlock: { n = Add(n, 1) }
        GP.pos = Add(GP.pos, 1)
    }
    PrintMessage("mismatches ")
    PrintNumber(n)
    PrintMessage("\n")
}
RunTask(Main)
