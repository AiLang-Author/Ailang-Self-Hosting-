LibraryImport.Arena

// RDMEM_ / WRMEM_ coverage: every width, both address shapes, sign
// extension, the _IO_ forms, and an IO poll loop. Each line prints
// "name got want ok"; tools/contract_identity.sh fails on any FAIL.

Function.Check {
    Input: label: Address
    Input: got: Integer
    Input: want: Integer
    Body: {
        PrintMessage(label)
        PrintMessage(" ")
        PrintNumber(got)
        PrintMessage(" ")
        PrintNumber(want)
        IfCondition EqualTo(got, want) ThenBlock: {
            PrintMessage(" ok\n")
        } ElseBlock: {
            PrintMessage(" FAIL\n")
        }
    }
}

// A one-line reader the inliner can splice. The IO form must stay a
// single read per call.
Function.Reg32 {
    Input: base: Address
    Input: off: Integer
    Output: Integer
    Body: { ReturnValue(RDMEM_IO_32(base, off)) }
}

SubRoutine.Main {
    buf = Allocate(64)
    MemorySet(buf, 0, 64)

    // Stores in both shapes, every width.
    WRMEM_8(buf, 0, 0x81)
    WRMEM_8(Add(buf, 1), 0x7F)
    WRMEM_16(buf, 2, 0xFFFE)
    WRMEM_16(Add(buf, 4), 0x1234)
    WRMEM_32(buf, 8, 0xFFFFFFF0)
    WRMEM_32(Add(buf, 12), 0x12345678)
    WRMEM_64(buf, 16, -5)
    WRMEM_64(Add(buf, 24), 0x1122334455667788)

    // A narrow store keeps its neighbours.
    WRMEM_64(buf, 32, -1)
    WRMEM_16(buf, 34, 0)
    Check("narrow16", RDMEM_64(buf, 32), -4294901761)
    WRMEM_8(buf, 39, 0)
    Check("narrow8", RDMEM_64(buf, 32), 72057589743026175)

    Check("rd8", RDMEM_8(buf, 0), 129)
    Check("rd8a", RDMEM_8(Add(buf, 1)), 127)
    Check("rds8", RDMEM_S8(buf, 0), -127)
    Check("rds8b", RDMEM_S8(buf, 1), 127)
    Check("rd16", RDMEM_16(buf, 2), 65534)
    Check("rds16", RDMEM_S16(buf, 2), -2)
    Check("rds16a", RDMEM_S16(Add(buf, 4)), 4660)
    Check("rd32", RDMEM_32(buf, 8), 4294967280)
    Check("rds32", RDMEM_S32(buf, 8), -16)
    Check("rd32a", RDMEM_32(Add(buf, 12)), 305419896)
    Check("rd64", RDMEM_64(buf, 16), -5)
    Check("rd64a", RDMEM_64(Add(buf, 24)), 1234605616436508552)

    // Same bytes through the old spellings.
    Check("old_getbyte", RDMEM_8(buf, 0), 129)
    Check("old_deref32", RDMEM_32(buf, 8), 4294967280)
    Check("old_deref64", RDMEM_64(buf, 16), -5)

    // IO forms.
    WRMEM_IO_32(buf, 40, 0xDEADBEEF)
    Check("io32", RDMEM_IO_32(buf, 40), 3735928559)
    Check("ios32", RDMEM_IO_S32(Add(buf, 40)), -559038737)
    WRMEM_IO_8(Add(buf, 44), 0xFF)
    Check("io8", RDMEM_IO_8(buf, 44), 255)
    Check("ios8", RDMEM_IO_S8(buf, 44), -1)
    WRMEM_IO_16(buf, 46, 0x8000)
    Check("ios16", RDMEM_IO_S16(buf, 46), -32768)
    WRMEM_IO_64(buf, 48, 0x0102030405060708)
    Check("io64", RDMEM_IO_64(buf, 48), 72623859790382856)
    Check("reg32", Reg32(buf, 40), 3735928559)

    // Polling loop: the read sits in the loop body and the store moves
    // the value it waits on.
    WRMEM_IO_32(buf, 56, 0)
    i = 0
    seen = 0
    WhileLoop LessThan(i, 1000) {
        v = RDMEM_IO_32(buf, 56)
        IfCondition EqualTo(v, 7) ThenBlock: { seen = Add(seen, 1) }
        IfCondition EqualTo(i, 500) ThenBlock: { WRMEM_IO_32(buf, 56, 7) }
        i = Add(i, 1)
    }
    Check("poll", seen, 499)

    // Sum through a loop with plain reads, to keep the scan allocator busy.
    j = 0
    s = 0
    WhileLoop LessThan(j, 8) {
        s = Add(s, RDMEM_8(buf, j))
        s = Add(s, RDMEM_S16(buf, 2))
        j = Add(j, 1)
    }
    Check("loopsum", s, 819)
    PrintMessage("done\n")
}
RunTask(Main)
