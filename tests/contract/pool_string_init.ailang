// Prove FixedPool Initialize=string lands a real pointer, not 0.
FixedPool.Msg {
    "hello": Initialize="hello"
    "empty": Initialize=""
    "num": Initialize=42
}

SubRoutine.Main {
    IfCondition EqualTo(Msg.hello, 0) ThenBlock: {
        PrintMessage("FAIL hello is null\n")
        ProcessExit(1)
    }
    PrintMessage("hello=")
    PrintMessage(Msg.hello)
    PrintMessage("\n")
    h0 = GetByte(Msg.hello, 0)
    PrintMessage("hello0=")
    PrintNumber(h0)
    PrintMessage("\n")
    PrintMessage("num=")
    PrintNumber(Msg.num)
    PrintMessage("\n")
    IfCondition EqualTo(Msg.empty, 0) ThenBlock: {
        PrintMessage("empty is null\n")
        ProcessExit(2)
    }
    elen = StringLength(Msg.empty)
    PrintMessage("empty_len=")
    PrintNumber(elen)
    PrintMessage("\n")
    ProcessExit(0)
}

RunTask(Main)
