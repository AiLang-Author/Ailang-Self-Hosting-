// A local read only through ptr@field must keep its frame store.
// Optimize_TryCmpSkip drops the store when every later read is a
// compare. Optimize_TreeHasName did not see the base name of ptr@field,
// so `lists = G.p` looked compare-only and lists@b read a slot that was
// never written. Library.Synth crashed in Synth_NoteOff this way.
LibraryImport.Arena

LinkagePool.LL {
    "a": Initialize=0
    "b": Initialize=0
}

FixedPool.G {
    "p": Initialize=0, CanChange=True
}

// Gives the name `lists` its pool type. Get relies on the
// first-entry-anywhere lookup, the way Library.Synth does.
Function.Make {
    Output: Address
    Body: {
        lists = AllocateLinkage(LinkagePool.LL)
        lists@b = 77
        ReturnValue(lists)
    }
}

// Same shape as Synth_NoteOff: the assignment sits in a then-block,
// a compare reads it, and only ptr@field reads it after that.
Function.Get {
    Input: k: Integer
    Output: Integer
    Body: {
        vi = k
        IfCondition LessThan(vi, 0) ThenBlock: {
            lists = G.p
            IfCondition EqualTo(lists, 0) ThenBlock: { ReturnValue(0) }
            node = lists@b
            vi = node
        }
        ReturnValue(vi)
    }
}

SubRoutine.Main {
    G.p = Make()
    PrintMessage("ptrfield ")
    PrintNumber(Get(-1))
    PrintMessage("\n")
}
RunTask(Main)
