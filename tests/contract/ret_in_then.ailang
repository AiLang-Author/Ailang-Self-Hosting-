// ReturnValue inside ThenBlock: Fib(7) must be 13, Clamp of -5 must be 0.
Function.Fib {
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(n, 2) ThenBlock: {
            ReturnValue(n)
        }
        n1 = Subtract(n, 1)
        a = Fib(n1)
        n2 = Subtract(n, 2)
        b = Fib(n2)
        s = Add(a, b)
        ReturnValue(s)
    }
}

Function.ClampNeg {
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(n, 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(n)
    }
}

SubRoutine.Main {
    f = Fib(7)
    PrintMessage("fib7=")
    PrintNumber(f)
    PrintMessage("\n")
    c = ClampNeg(-5)
    PrintMessage("clamp=")
    PrintNumber(c)
    PrintMessage("\n")
    IfCondition NotEqual(f, 13) ThenBlock: {
        ProcessExit(1)
    }
    IfCondition NotEqual(c, 0) ThenBlock: {
        ProcessExit(2)
    }
    ProcessExit(0)
}

RunTask(Main)
