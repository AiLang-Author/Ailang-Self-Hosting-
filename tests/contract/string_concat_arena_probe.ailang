LibraryImport.Arena

SubRoutine.Main {
    Arena_Init()
    s = StringConcat("hello", "world")
    n = StringLength(s)
    PrintMessage(s)
    PrintMessage("\n")
    IfCondition NotEqual(n, 10) ThenBlock: {
        ProcessExit(1)
    }
    u = StringConcat("0123456789abcdef", "0123456789abcdef")
    nu = StringLength(u)
    IfCondition NotEqual(nu, 32) ThenBlock: {
        ProcessExit(2)
    }
    cmp = StringCompare(u, "0123456789abcdef0123456789abcdef")
    IfCondition NotEqual(cmp, 0) ThenBlock: {
        ProcessExit(3)
    }
    ProcessExit(0)
}

RunTask(Main)
