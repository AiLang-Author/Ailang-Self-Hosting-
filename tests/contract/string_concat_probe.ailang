SubRoutine.Main {
    s = StringConcat("hello", "world")
    n = StringLength(s)
    PrintMessage(s)
    PrintMessage("\n")
    PrintMessage("len=")
    PrintNumber(n)
    PrintMessage("\n")
    IfCondition NotEqual(n, 10) ThenBlock: {
        ProcessExit(1)
    }
    t = StringConcat(s, "!")
    n2 = StringLength(t)
    IfCondition NotEqual(n2, 11) ThenBlock: {
        ProcessExit(2)
    }
    ProcessExit(0)
}

RunTask(Main)
