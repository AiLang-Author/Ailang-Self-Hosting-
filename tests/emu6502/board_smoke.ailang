// JSON board loader smoke: plug ProbeASIC at $DE00 from smoke.board.json.
// ./ailang.x tests/emu6502/board_smoke.ailang /tmp/board_smoke.x && /tmp/board_smoke.x

Import.Librarys.Emulators.6502.Board
Import.Librarys.Emulators.6502.CPU

Function.Probe_Read {
    Input: chip: Address
    Input: addr: Integer
    Output: Integer
    Body: {
        st_off = PoolFieldOffset(LinkagePool.Chip, "state")
        st = Dereference(Add(chip, st_off))
        IfCondition EqualTo(st, 0) ThenBlock: {
            ReturnValue(0)
        }
        off = BitwiseAnd(addr, 15)
        v = GetByte(st, off)
        ReturnValue(v)
    }
}

Function.Probe_Write {
    Input: chip: Address
    Input: addr: Integer
    Input: value: Integer
    Body: {
        st_off = PoolFieldOffset(LinkagePool.Chip, "state")
        st = Dereference(Add(chip, st_off))
        IfCondition EqualTo(st, 0) ThenBlock: {
            st = Allocate(16)
            zi = 0
            WhileLoop LessThan(zi, 16) {
                SetByte(st, zi, 0)
                zi = Add(zi, 1)
            }
            StoreValue(Add(chip, st_off), st)
        }
        off = BitwiseAnd(addr, 15)
        b = BitwiseAnd(value, 255)
        SetByte(st, off, b)
    }
}

SubRoutine.Main {
    Arena_Init()
    Bus6502_Init()
    CPU_Init()

    pr = AddressOf(Probe_Read)
    pw = AddressOf(Probe_Write)
    Board_RegisterModel("ProbeASIC", pr, pw, 0)
    n = Board_LoadJSON("tests/emu6502/smoke.board.json")
    IfCondition EqualTo(n, 0) ThenBlock: {
        PrintMessage("FAIL no chips plugged\n")
    } ElseBlock: {
        Bus6502_Write(56832, 66)
        got = Bus6502_Read(56832)
        PrintMessage("probe bus write/read=")
        PrintNumber(got)
        PrintMessage("\n")

        Bus6502_Write(512, 173)
        Bus6502_Write(513, 0)
        Bus6502_Write(514, 222)
        Bus6502_Write(515, 141)
        Bus6502_Write(516, 0)
        Bus6502_Write(517, 16)
        CPU_SetPC(512)
        CPU_Step()
        CPU_Step()
        mem = Bus6502_Read(4096)
        PrintMessage("LDA STA $1000=")
        PrintNumber(mem)
        PrintMessage(" A=")
        PrintNumber(CPU.A)
        PrintMessage("\n")

        IfCondition And(EqualTo(got, 66), EqualTo(mem, 66)) ThenBlock: {
            PrintMessage("PASS board JSON loader\n")
        } ElseBlock: {
            PrintMessage("FAIL board JSON loader\n")
        }
    }
}

RunTask(Main)
