// C64 board JSON + KERNAL stubs. JSR $FFD2, VIC $D020, 6510 port.
// ./ailang.x tests/emu6502/c64_stub_smoke.ailang /tmp/c64_stub_smoke.x && /tmp/c64_stub_smoke.x

LibraryImport.C64Pack
LibraryImport.CPU6502

SubRoutine.Main {
    Arena_Init()
    Bus6502_Init()
    CPU_Init()

    n = C64Pack_BringUp("docs/emu/boards/c64.board.json")
    PrintMessage("c64 chips=")
    PrintNumber(n)
    PrintMessage("\n")

    fail = 0
    Bus6502_Write(53280, 14)
    vic = Bus6502_Read(53280)
    PrintMessage("D020=")
    PrintNumber(vic)
    PrintMessage("\n")
    IfCondition NotEqual(vic, 14) ThenBlock: { fail = Add(fail, 1) }

    p1 = Bus6502_Read(1)
    PrintMessage("port01=")
    PrintNumber(p1)
    PrintMessage("\n")
    IfCondition NotEqual(p1, 55) ThenBlock: { fail = Add(fail, 1) }

    Bus6502_Write(512, 169)
    Bus6502_Write(513, 65)
    Bus6502_Write(514, 32)
    Bus6502_Write(515, 210)
    Bus6502_Write(516, 255)
    Bus6502_Write(517, 76)
    Bus6502_Write(518, 5)
    Bus6502_Write(519, 2)
    CPU.SP = 253
    CPU_SetPC(512)
    steps = 0
    done = 0
    WhileLoop And(EqualTo(done, 0), LessThan(steps, 32)) {
        pc0 = CPU.PC
        CPU_Step()
        steps = Add(steps, 1)
        IfCondition EqualTo(CPU.PC, 517) ThenBlock: {
            IfCondition EqualTo(pc0, 517) ThenBlock: {
                done = 1
            }
        }
    }
    PrintMessage("CHROUT trap PC=")
    PrintHex(CPU.PC)
    PrintMessage(" steps=")
    PrintNumber(steps)
    PrintMessage("\n")
    IfCondition NotEqual(CPU.PC, 517) ThenBlock: { fail = Add(fail, 1) }

    IfCondition EqualTo(fail, 0) ThenBlock: {
        PrintMessage("PASS c64 board kernal stubs\n")
    } ElseBlock: {
        PrintMessage("FAIL c64 stubs count=")
        PrintNumber(fail)
        PrintMessage("\n")
    }
}

RunTask(Main)
