// Timer B start delay, TA→TB cascade, IMR does not drop IRQ.
// ./ailang.x tests/emu6502/cia_tb_smoke.ailang /tmp/cia_tb_smoke.x && /tmp/cia_tb_smoke.x

Import.Librarys.Emulators.6502.C64
Import.Librarys.Emulators.6502.CPU

SubRoutine.Main {
    Arena_Init()
    Bus6502_Init()
    CPU_Init()
    C64Pack_BringUp("docs/emu/boards/c64.board.json")
    fail = 0

    Bus6502_Write(1, 53)
    Bus6502_Write(56333, 127)
    dummy = Bus6502_Read(56333)

    Bus6502_Write(56326, 10)
    Bus6502_Write(56327, 0)
    Bus6502_Write(56335, 1)
    C64Pack_AfterStep(1)
    tb = Bus6502_Read(56326)
    PrintMessage("TB after 1=")
    PrintNumber(tb)
    PrintMessage("\n")
    IfCondition NotEqual(tb, 10) ThenBlock: {
        fail = Add(fail, 1)
    }
    C64Pack_AfterStep(1)
    tb = Bus6502_Read(56326)
    PrintMessage("TB after 2=")
    PrintNumber(tb)
    PrintMessage("\n")
    IfCondition NotEqual(tb, 10) ThenBlock: {
        fail = Add(fail, 1)
    }
    C64Pack_AfterStep(1)
    tb = Bus6502_Read(56326)
    PrintMessage("TB after 3=")
    PrintNumber(tb)
    PrintMessage("\n")
    IfCondition NotEqual(tb, 9) ThenBlock: {
        fail = Add(fail, 1)
    }
    Bus6502_Write(56335, 0)

    dummy = Bus6502_Read(56333)
    Bus6502_Write(56324, 4)
    Bus6502_Write(56325, 0)
    Bus6502_Write(56326, 2)
    Bus6502_Write(56327, 0)
    Bus6502_Write(56335, 65)
    Bus6502_Write(56334, 1)
    C64Pack_AfterStep(40)
    icr = Bus6502_Read(56333)
    PrintMessage("cascade ICR=")
    PrintNumber(icr)
    PrintMessage("\n")
    IfCondition EqualTo(BitwiseAnd(icr, 2), 0) ThenBlock: {
        fail = Add(fail, 1)
    }
    Bus6502_Write(56334, 0)
    Bus6502_Write(56335, 0)

    dummy = Bus6502_Read(56333)
    Bus6502_Write(56324, 3)
    Bus6502_Write(56325, 0)
    Bus6502_Write(56334, 1)
    C64Pack_AfterStep(20)
    Bus6502_Write(56333, 129)
    c1 = Board_ChipForDevid(3)
    irq = MOS6526_IRQLevel(c1)
    PrintMessage("IMR set irq=")
    PrintNumber(irq)
    PrintMessage("\n")
    IfCondition NotEqual(irq, 1) ThenBlock: {
        fail = Add(fail, 1)
    }
    Bus6502_Write(56333, 1)
    irq = MOS6526_IRQLevel(c1)
    PrintMessage("IMR clear irq=")
    PrintNumber(irq)
    PrintMessage("\n")
    IfCondition NotEqual(irq, 1) ThenBlock: {
        fail = Add(fail, 1)
    }
    dummy = Bus6502_Read(56333)
    irq = MOS6526_IRQLevel(c1)
    PrintMessage("ICR read irq=")
    PrintNumber(irq)
    PrintMessage("\n")
    IfCondition NotEqual(irq, 0) ThenBlock: {
        fail = Add(fail, 1)
    }

    IfCondition EqualTo(fail, 0) ThenBlock: {
        PrintMessage("PASS cia tb/cascade/imr\n")
    } ElseBlock: {
        PrintMessage("FAIL cia tb count=")
        PrintNumber(fail)
        PrintMessage("\n")
    }
}

RunTask(Main)
