// CIA timer underflow + VIC raster count.
// ./ailang.x tests/emu6502/cia_vic_smoke.ailang /tmp/cia_vic_smoke.x && /tmp/cia_vic_smoke.x

Import.Librarys.Emulators.6502.C64
Import.Librarys.Emulators.6502.CPU

SubRoutine.Main {
    Arena_Init()
    Bus6502_Init()
    CPU_Init()
    n = C64Pack_BringUp("docs/emu/boards/c64.board.json")
    PrintMessage("chips=")
    PrintNumber(n)
    PrintMessage("\n")
    fail = 0

    // CIA1 timer A: latch 20, start, tick 30 cycles, ICR bit 0
    Bus6502_Write(56324, 20)
    Bus6502_Write(56325, 0)
    Bus6502_Write(56334, 17)
    C64Pack_AfterStep(30)
    icr = Bus6502_Read(56333)
    PrintMessage("CIA ICR=")
    PrintNumber(icr)
    PrintMessage("\n")
    IfCondition EqualTo(BitwiseAnd(icr, 1), 0) ThenBlock: {
        fail = Add(fail, 1)
    }

    // VIC raster: 65 cycles/line, 10 lines -> D012 ~= 10
    C64Pack_AfterStep(650)
    d012 = Bus6502_Read(53266)
    PrintMessage("D012=")
    PrintNumber(d012)
    PrintMessage("\n")
    IfCondition LessThan(d012, 8) ThenBlock: {
        fail = Add(fail, 1)
    }
    IfCondition GreaterThan(d012, 12) ThenBlock: {
        fail = Add(fail, 1)
    }

    IfCondition EqualTo(fail, 0) ThenBlock: {
        PrintMessage("PASS cia timer + vic raster\n")
    } ElseBlock: {
        PrintMessage("FAIL cia/vic count=")
        PrintNumber(fail)
        PrintMessage("\n")
    }
}

RunTask(Main)
