// Klaus Dormann 6502 functional test on the bare 64K bus.
// Load 6502_functional_test.bin at $0000, start $0400, success trap $3469.
// ./ailang.x tests/emu6502/klaus.ailang /tmp/emu6502_klaus.x && /tmp/emu6502_klaus.x

Import.Librarys.Emulators.6502.CPU

FixedPool.Klaus {
    "success": Initialize=13417
    "start": Initialize=1024
    "max_steps": Initialize=80000000
    "report": Initialize=200000
}

Function.Klaus_Load {
    Output: Integer
    Body: {
        path = "tests/emu6502/6502_functional_test.bin"
        fd = SystemCall(2, path, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("cannot open 6502_functional_test.bin\n")
            ReturnValue(0)
        }
        n = SystemCall(0, fd, Bus6502.ram, 65536)
        SystemCall(3, fd)
        PrintMessage("loaded bytes=")
        PrintNumber(n)
        PrintMessage("\n")
        ReturnValue(n)
    }
}

SubRoutine.Main {
    Bus6502_Init()
    CPU_Init()
    n = Klaus_Load()
    IfCondition LessThan(n, 1024) ThenBlock: {
        PrintMessage("FAIL load\n")
    } ElseBlock: {
        CPU_SetPC(Klaus.start)
        steps = 0
        done = 0
        WhileLoop And(EqualTo(done, 0), EqualTo(CPU.halted, 0)) {
            IfCondition GreaterEqual(steps, Klaus.max_steps) ThenBlock: {
                PrintMessage("TIMEOUT steps=")
                PrintNumber(steps)
                PrintMessage(" PC=")
                PrintHex(CPU.PC)
                PrintMessage("\n")
                done = 1
            } ElseBlock: {
                pc0 = CPU.PC
                CPU_Step()
                steps = Add(steps, 1)
                pc1 = CPU.PC
                IfCondition EqualTo(pc1, pc0) ThenBlock: {
                    PrintMessage("TRAP PC=")
                    PrintHex(pc1)
                    PrintMessage(" steps=")
                    PrintNumber(steps)
                    PrintMessage("\n")
                    IfCondition EqualTo(pc1, Klaus.success) ThenBlock: {
                        PrintMessage("PASS Klaus Dormann\n")
                    } ElseBlock: {
                        PrintMessage("FAIL trap is not success $3469\n")
                    }
                    done = 1
                }
                rem = Modulo(steps, Klaus.report)
                IfCondition And(EqualTo(rem, 0), EqualTo(done, 0)) ThenBlock: {
                    PrintMessage("progress steps=")
                    PrintNumber(steps)
                    PrintMessage(" PC=")
                    PrintHex(CPU.PC)
                    PrintMessage("\n")
                }
            }
        }
        IfCondition EqualTo(CPU.halted, 1) ThenBlock: {
            PrintMessage("HALT PC=")
            PrintHex(CPU.PC)
            PrintMessage(" steps=")
            PrintNumber(steps)
            PrintMessage("\nFAIL\n")
        }
    }
}

RunTask(Main)
