// Wolfgang Lorenz suite on C64 stub board. Palm LOAD/CHROUT/GETIN traps.
// ./ailang.x tests/emu6502/lorenz.ailang /tmp/lorenz.x && /tmp/lorenz.x

Import.Librarys.Emulators.6502.C64

FixedPool.Lorenz {
    "dir": Initialize=0
    "loads": Initialize=0
    "max_steps": Initialize=2000000000
    "report": Initialize=500000
}

Function.Lorenz_PetsciiName {
    Input: dst: Address
    Output: Integer
    Body: {
        nlen = Bus6502_Read(183)
        lo = Bus6502_Read(187)
        hi = Bus6502_Read(188)
        ptr = BitwiseOr(lo, ShiftLeft(hi, 8))
        IfCondition GreaterThan(nlen, 16) ThenBlock: {
            nlen = 16
        }
        i = 0
        WhileLoop LessThan(i, nlen) {
            b = Bus6502_Read(Add(ptr, i))
            ch = C64Pack_PetsciiChar(b)
            IfCondition And(GreaterEqual(ch, 65), LessEqual(ch, 90)) ThenBlock: {
                ch = Add(ch, 32)
            }
            SetByte(dst, i, ch)
            i = Add(i, 1)
        }
        SetByte(dst, nlen, 0)
        ReturnValue(nlen)
    }
}

Function.Lorenz_LoadPRG {
    Input: path: Address
    Output: Integer
    Body: {
        fd = SystemCall(2, path, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("LOAD fail ")
            PrintMessage(path)
            PrintMessage("\n")
            ReturnValue(0)
        }
        buf = Allocate(65536)
        n = SystemCall(0, fd, buf, 65535)
        SystemCall(3, fd)
        IfCondition LessThan(n, 3) ThenBlock: {
            Deallocate(buf, 65536)
            ReturnValue(0)
        }
        lo = GetByte(buf, 0)
        hi = GetByte(buf, 1)
        addr = BitwiseOr(lo, ShiftLeft(hi, 8))
        i = 2
        WhileLoop LessThan(i, n) {
            b = GetByte(buf, i)
            Bus6502_Write(addr, b)
            addr = Add(addr, 1)
            i = Add(i, 1)
        }
        Deallocate(buf, 65536)
        Lorenz.loads = Add(Lorenz.loads, 1)
        ReturnValue(1)
    }
}

Function.Lorenz_LOAD {
    Output: Integer
    Body: {
        name = Allocate(24)
        nlen = Lorenz_PetsciiName(name)
        IfCondition EqualTo(nlen, 0) ThenBlock: {
            Deallocate(name, 24)
            ReturnValue(0)
        }
        trap = StringCompare(name, "trap17")
        IfCondition EqualTo(trap, 0) ThenBlock: {
            PrintMessage("\nLorenz CPU tests done at trap17\n")
            Deallocate(name, 24)
            ReturnValue(2)
        }
        dir = "tests/emu6502/lorenz/bin/"
        path = StringConcat(dir, name)
        PrintMessage("LOAD ")
        PrintMessage(name)
        PrintMessage("\n")
        ok = Lorenz_LoadPRG(path)
        Deallocate(name, 24)
        Deallocate(path, 0)
        IfCondition EqualTo(ok, 0) ThenBlock: {
            ReturnValue(4)
        }
        sp = CPU.SP
        sp = BitwiseAnd(Add(sp, 2), 255)
        CPU.SP = sp
        CPU.PC = 2070
        ReturnValue(1)
    }
}

Function.Lorenz_Trap {
    Output: Integer
    Body: {
        pc = CPU.PC
        IfCondition EqualTo(pc, 65490) ThenBlock: {
            C64Pack_CHROUT()
            ReturnValue(1)
        }
        IfCondition EqualTo(pc, 57711) ThenBlock: {
            r = Lorenz_LOAD()
            ReturnValue(r)
        }
        IfCondition EqualTo(pc, 65508) ThenBlock: {
            C64Pack_GETIN()
            ReturnValue(1)
        }
        IfCondition EqualTo(pc, 32768) ThenBlock: {
            PrintMessage("\ntrap $8000\n")
            ReturnValue(3)
        }
        IfCondition EqualTo(pc, 42100) ThenBlock: {
            PrintMessage("\nBASIC $A474 end\n")
            ReturnValue(2)
        }
        ReturnValue(0)
    }
}

SubRoutine.Main {
    Arena_Init()
    Bus6502_Init()
    CPU_Init()
    n = C64Pack_BringUp("docs/emu/boards/c64.board.json")
    PrintMessage("board=")
    PrintNumber(n)
    PrintMessage("\n")

    ok = Lorenz_LoadPRG("tests/emu6502/lorenz/bin/ start")
    IfCondition EqualTo(ok, 0) ThenBlock: {
        PrintMessage("FAIL load start\n")
    } ElseBlock: {
        CPU.SP = 253
        CPU.F_IRQ = 1
        CPU_SetPC(2049)
        steps = 0
        done = 0
        WhileLoop And(EqualTo(done, 0), EqualTo(CPU.halted, 0)) {
            IfCondition GreaterEqual(steps, Lorenz.max_steps) ThenBlock: {
                PrintMessage("TIMEOUT PC=")
                PrintHex(CPU.PC)
                PrintMessage(" loads=")
                PrintNumber(Lorenz.loads)
                PrintMessage("\n")
                done = 1
            } ElseBlock: {
                tr = Lorenz_Trap()
                IfCondition EqualTo(tr, 2) ThenBlock: {
                    PrintMessage("PASS Lorenz loads=")
                    PrintNumber(Lorenz.loads)
                    PrintMessage(" steps=")
                    PrintNumber(steps)
                    PrintMessage("\n")
                    done = 1
                }
                IfCondition EqualTo(tr, 3) ThenBlock: {
                    PrintMessage("FAIL trap8000 loads=")
                    PrintNumber(Lorenz.loads)
                    PrintMessage("\n")
                    done = 1
                }
                IfCondition EqualTo(tr, 0) ThenBlock: {
                    CPU_Step()
                    steps = Add(steps, 1)
                    rem = Modulo(steps, Lorenz.report)
                    IfCondition EqualTo(rem, 0) ThenBlock: {
                        PrintMessage("progress steps=")
                        PrintNumber(steps)
                        PrintMessage(" PC=")
                        PrintHex(CPU.PC)
                        PrintMessage(" loads=")
                        PrintNumber(Lorenz.loads)
                        PrintMessage("\n")
                    }
                }
                IfCondition EqualTo(tr, 4) ThenBlock: {
                    PrintMessage("FAIL LOAD\n")
                    done = 1
                }
            }
        }
        IfCondition EqualTo(CPU.halted, 1) ThenBlock: {
            PrintMessage("HALT PC=")
            PrintHex(CPU.PC)
            PrintMessage("\nFAIL\n")
        }
    }
}

RunTask(Main)
