// Isolated mmufetch after PLA banking.
Import.Librarys.Emulators.6502.C64
Import.Librarys.Emulators.6502.CPU

SubRoutine.Main {
    Arena_Init()
    Bus6502_Init()
    CPU_Init()
    n = C64Pack_BringUp("docs/emu/boards/c64.board.json")
    PrintMessage("board=")
    PrintNumber(n)
    PrintMessage("\n")
    fd = SystemCall(2, "tests/emu6502/lorenz/bin/mmufetch", 0, 0)
    IfCondition LessThan(fd, 0) ThenBlock: {
        PrintMessage("FAIL open mmufetch\n")
    } ElseBlock: {
        buf = Allocate(65536)
        nb = SystemCall(0, fd, buf, 65535)
        SystemCall(3, fd)
        lo = GetByte(buf, 0)
        hi = GetByte(buf, 1)
        addr = BitwiseOr(lo, ShiftLeft(hi, 8))
        i = 2
        WhileLoop LessThan(i, nb) {
            b = GetByte(buf, i)
            Bus6502_Write(addr, b)
            addr = Add(addr, 1)
            i = Add(i, 1)
        }
        Deallocate(buf, 65536)
        CPU.SP = 253
        CPU.F_IRQ = 1
        CPU_SetPC(2049)
        steps = 0
        done = 0
        WhileLoop And(EqualTo(done, 0), LessThan(steps, 20000000)) {
            pc = CPU.PC
            IfCondition EqualTo(pc, 65490) ThenBlock: {
                C64Pack_CHROUT()
            } ElseBlock: {
                IfCondition EqualTo(pc, 65508) ThenBlock: {
                    C64Pack_GETIN()
                } ElseBlock: {
                    IfCondition EqualTo(pc, 32768) ThenBlock: {
                        PrintMessage("FAIL $8000\n")
                        done = 1
                    } ElseBlock: {
                        IfCondition EqualTo(pc, 57711) ThenBlock: {
                            PrintMessage("PASS mmufetch reached LOAD mmu\n")
                            done = 2
                        } ElseBlock: {
                            cyc = CPU_Step()
                            C64Pack_AfterStep(0)
                            steps = Add(steps, 1)
                            IfCondition EqualTo(CPU.PC, 2411) ThenBlock: {
                                PrintMessage("at lda 33 $01=")
                                PrintNumber(Bus6502_Read(1))
                                PrintMessage("\n")
                            }
                            IfCondition EqualTo(CPU.PC, 2420) ThenBlock: {
                                PrintMessage("after sta d000 ram=")
                                PrintNumber(Board_RamRead(53248))
                                PrintMessage(" $01=")
                                PrintNumber(Bus6502_Read(1))
                                PrintMessage("\n")
                            }
                            IfCondition EqualTo(CPU.PC, 2444) ThenBlock: {
                                PrintMessage("pre-jsr d000 $01=")
                                PrintNumber(Bus6502_Read(1))
                                PrintMessage(" D000=")
                                PrintNumber(Bus6502_Read(53248))
                                PrintMessage(" D002=")
                                PrintNumber(Bus6502_Read(53250))
                                PrintMessage("\n")
                            }
                        }
                    }
                }
            }
        }
        IfCondition EqualTo(done, 0) ThenBlock: {
            PrintMessage("TIMEOUT mmufetch PC=")
            PrintHex(CPU.PC)
            PrintMessage(" steps=")
            PrintNumber(steps)
            PrintMessage("\n")
        }
    }
}

RunTask(Main)
