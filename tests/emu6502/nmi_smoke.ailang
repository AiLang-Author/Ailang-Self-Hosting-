Import.Librarys.Emulators.6502.C64
Import.Librarys.Emulators.6502.CPU

SubRoutine.Main {
    Arena_Init()
    Bus6502_Init()
    CPU_Init()
    C64Pack_BringUp("docs/emu/boards/c64.board.json")
    fail = 0
    Bus6502_Write(1, 53)
    Bus6502_Write(65530, 0)
    Bus6502_Write(65531, 16)
    Bus6502_Write(4096, 234)
    Bus6502_Write(4097, 76)
    Bus6502_Write(4098, 1)
    Bus6502_Write(4099, 16)
    CPU.F_IRQ = 0
    CPU_SetPC(4096)
    Bus6502_Write(56589, 129)
    Bus6502_Write(56580, 8)
    Bus6502_Write(56581, 0)
    Bus6502_Write(56590, 17)
    i = 0
    WhileLoop LessThan(i, 20) {
        cyc = CPU_Step()
        C64Pack_AfterStep(0)
        i = Add(i, 1)
    }
    PrintMessage("PC=")
    PrintHex(CPU.PC)
    PrintMessage(" nmi=")
    PrintNumber(CPU.nmi_pending)
    PrintMessage("\n")
    IfCondition LessThan(CPU.PC, 4096) ThenBlock: {
        fail = 1
    }
    icr = Bus6502_Read(56589)
    PrintMessage("DD0D=")
    PrintNumber(icr)
    PrintMessage("\n")
    IfCondition EqualTo(fail, 0) ThenBlock: {
        PrintMessage("PASS nmi smoke\n")
    } ElseBlock: {
        PrintMessage("FAIL nmi smoke\n")
    }
}

RunTask(Main)
