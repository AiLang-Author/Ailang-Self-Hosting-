// Lorenz oneshot PRG: CRA $08 at ICR=$01 (latch 2), $09 at ICR=$00 (latch 3).
// ./ailang.x tests/emu6502/oneshot_smoke.ailang /tmp/oneshot_smoke.x && /tmp/oneshot_smoke.x

Import.Librarys.Emulators.6502.C64
Import.Librarys.Emulators.6502.CPU

SubRoutine.Main {
    Arena_Init()
    Bus6502_Init()
    CPU_Init()
    C64Pack_BringUp("docs/emu/boards/c64.board.json")
    fd = SystemCall(2, "tests/emu6502/lorenz/bin/oneshot", 0, 0)
    IfCondition LessThan(fd, 0) ThenBlock: {
        PrintMessage("FAIL open oneshot\n")
    } ElseBlock: {
        buf = Allocate(65536)
        nb = SystemCall(0, fd, buf, 65535)
        SystemCall(3, fd)
        lo = GetByte(buf, 0)
        hi = GetByte(buf, 1)
        addr = BitwiseOr(lo, ShiftLeft(hi, 8))
        i = 2
        WhileLoop LessThan(i, nb) {
            b = GetByte(buf, i)
            Bus6502_Write(addr, b)
            addr = Add(addr, 1)
            i = Add(i, 1)
        }
        Deallocate(buf, 65536)
        CPU.SP = 253
        CPU.F_IRQ = 1
        CPU_SetPC(2049)
        steps = 0
        done = 0
        WhileLoop And(EqualTo(done, 0), LessThan(steps, 2000000)) {
            pc = CPU.PC
            IfCondition EqualTo(pc, 65490) ThenBlock: {
                C64Pack_CHROUT()
            } ElseBlock: {
                IfCondition EqualTo(pc, 65508) ThenBlock: {
                    C64Pack_GETIN()
                } ElseBlock: {
                    IfCondition EqualTo(pc, 32768) ThenBlock: {
                        PrintMessage("FAIL oneshot $8000\n")
                        done = 1
                    } ElseBlock: {
                        IfCondition EqualTo(pc, 57711) ThenBlock: {
                            PrintMessage("PASS oneshot next LOAD\n")
                            done = 2
                        } ElseBlock: {
                            IfCondition EqualTo(CPU.halted, 1) ThenBlock: {
                                PrintMessage("HALT oneshot PC=")
                                PrintHex(CPU.PC)
                                PrintMessage("\n")
                                done = 1
                            } ElseBlock: {
                                CPU_Step()
                                C64Pack_AfterStep(0)
                                steps = Add(steps, 1)
                            }
                        }
                    }
                }
            }
        }
        IfCondition EqualTo(done, 0) ThenBlock: {
            PrintMessage("TIMEOUT oneshot PC=")
            PrintHex(CPU.PC)
            PrintMessage("\n")
        }
    }
}

RunTask(Main)
