Import.Librarys.Emulators.6502.C64
Import.Librarys.Emulators.6502.CPU

SubRoutine.Main {
    Arena_Init()
    Bus6502_Init()
    CPU_Init()
    C64Pack_BringUp("docs/emu/boards/c64.board.json")
    p = Bus6502_Read(1)
    PrintMessage("$01=")
    PrintNumber(p)
    PrintMessage("\n")
    Bus6502_Write(1, 55)
    r37 = Bus6502_Read(42209)
    PrintMessage("A4E1 @37=")
    PrintNumber(r37)
    PrintMessage("\n")
    Bus6502_Write(1, 54)
    Bus6502_Write(42209, 0)
    r36 = Bus6502_Read(42209)
    PrintMessage("A4E1 @36=")
    PrintNumber(r36)
    PrintMessage("\n")
    Bus6502_Write(1, 55)
    r2 = Bus6502_Read(42209)
    PrintMessage("A4E1 @37 again=")
    PrintNumber(r2)
    PrintMessage("\n")
    Bus6502_Write(1, 53)
    ke = Bus6502_Read(60000)
    PrintMessage("EA60 @35=")
    PrintNumber(ke)
    PrintMessage("\n")
    Bus6502_Write(1, 55)
    k7 = Bus6502_Read(65490)
    PrintMessage("FFD2 @37=")
    PrintNumber(k7)
    PrintMessage("\n")
    Bus6502_Write(1, 54)
    Bus6502_Write(4096, 162)
    Bus6502_Write(4097, 55)
    Bus6502_Write(4098, 134)
    Bus6502_Write(4099, 1)
    Bus6502_Write(4100, 0)
    CPU.F_IRQ = 1
    CPU_SetPC(4096)
    CPU_Step()
    CPU_Step()
    p2 = Bus6502_Read(1)
    Bus6502_Write(1, 55)
    Bus6502_Write(53250, 133)
    vd = Bus6502_Read(53250)
    PrintMessage("D002 IO=")
    PrintNumber(vd)
    PrintMessage("\n")
    Bus6502_Write(1, 52)
    Bus6502_Write(53248, 86)
    rram = Bus6502_Read(53248)
    PrintMessage("D000 @34 after write=")
    PrintNumber(rram)
    PrintMessage("\n")
    Bus6502_Write(1, 51)
    Bus6502_Write(53248, 86)
    r33 = Bus6502_Read(53248)
    PrintMessage("D000 @33=")
    PrintNumber(r33)
    PrintMessage("\n")
    Bus6502_Write(1, 52)
    r34 = Bus6502_Read(53248)
    PrintMessage("D000 @34=")
    PrintNumber(r34)
    PrintMessage("\n")
    PrintMessage("after STX $01=")
    PrintNumber(p2)
    PrintMessage(" PC=")
    PrintHex(CPU.PC)
    PrintMessage("\n")
}

RunTask(Main)
