// Bare 6502 smoke: LDA #42 / STA $1000 on the 64K bus.
// ./ailang.x tests/emu6502/smoke.ailang /tmp/emu6502_smoke.x && /tmp/emu6502_smoke.x

LibraryImport.CPU6502

SubRoutine.Main {
    Bus6502_Init()
    CPU_Init()

    Bus6502_Write(512, 169)
    Bus6502_Write(513, 42)
    Bus6502_Write(514, 141)
    Bus6502_Write(515, 0)
    Bus6502_Write(516, 16)

    CPU_SetPC(512)
    CPU_Step()
    CPU_Step()

    got = Bus6502_Read(4096)
    acc = CPU.A
    PrintMessage("A=")
    PrintNumber(acc)
    PrintMessage(" $1000=")
    PrintNumber(got)
    PrintMessage("\n")
    IfCondition And(EqualTo(acc, 42), EqualTo(got, 42)) ThenBlock: {
        PrintMessage("PASS\n")
    } ElseBlock: {
        PrintMessage("FAIL\n")
    }
}

RunTask(Main)
