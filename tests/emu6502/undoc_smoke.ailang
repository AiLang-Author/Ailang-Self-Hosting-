// Unofficial NMOS opcode smoke on the bare bus.
// ./ailang.x tests/emu6502/undoc_smoke.ailang /tmp/emu6502_undoc.x && /tmp/emu6502_undoc.x

Import.Librarys.Emulators.6502.CPU

FixedPool.USmoke {
    "fail": Initialize=0
}

Function.USmoke_Check {
    Input: got: Integer
    Input: want: Integer
    Input: tag: Integer
    Body: {
        IfCondition NotEqual(got, want) ThenBlock: {
            PrintMessage("FAIL tag=")
            PrintNumber(tag)
            PrintMessage(" got=")
            PrintNumber(got)
            PrintMessage(" want=")
            PrintNumber(want)
            PrintMessage("\n")
            USmoke.fail = Add(USmoke.fail, 1)
        }
    }
}

SubRoutine.Main {
    Bus6502_Init()
    CPU_Init()

    // SLO zp $07: [$10]=$80, A=$01 -> mem=$00 C=1, A=$01
    Bus6502_Write(16, 128)
    CPU.A = 1
    CPU.F_CARRY = 0
    Bus6502_Write(512, 7)
    Bus6502_Write(513, 16)
    CPU_SetPC(512)
    CPU_Step()
    USmoke_Check(Bus6502_Read(16), 0, 1)
    USmoke_Check(CPU.A, 1, 2)
    USmoke_Check(CPU.F_CARRY, 1, 3)

    // LAX zp $A7: [$11]=$5A -> A=X=$5A
    Bus6502_Write(17, 90)
    Bus6502_Write(514, 167)
    Bus6502_Write(515, 17)
    CPU_SetPC(514)
    CPU_Step()
    USmoke_Check(CPU.A, 90, 4)
    USmoke_Check(CPU.X, 90, 5)

    // SAX zp $87: A=$0F X=$33 -> [$12]=$03
    CPU.A = 15
    CPU.X = 51
    Bus6502_Write(516, 135)
    Bus6502_Write(517, 18)
    CPU_SetPC(516)
    CPU_Step()
    USmoke_Check(Bus6502_Read(18), 3, 6)

    // DCP zp $C7: [$13]=$10, A=$10 -> mem=$0F, C=1 Z=0
    Bus6502_Write(19, 16)
    CPU.A = 16
    Bus6502_Write(518, 199)
    Bus6502_Write(519, 19)
    CPU_SetPC(518)
    CPU_Step()
    USmoke_Check(Bus6502_Read(19), 15, 7)
    USmoke_Check(CPU.F_CARRY, 1, 8)

    // ANC # $0B: A=$FF & $80 -> A=$80 C=1
    CPU.A = 255
    Bus6502_Write(520, 11)
    Bus6502_Write(521, 128)
    CPU_SetPC(520)
    CPU_Step()
    USmoke_Check(CPU.A, 128, 9)
    USmoke_Check(CPU.F_CARRY, 1, 10)

    // ALR # $4B: A=$FF & $03 then LSR -> A=$01 C=1
    CPU.A = 255
    Bus6502_Write(522, 75)
    Bus6502_Write(523, 3)
    CPU_SetPC(522)
    CPU_Step()
    USmoke_Check(CPU.A, 1, 11)
    USmoke_Check(CPU.F_CARRY, 1, 12)

    // SBX # $CB: A=$F0 X=$3C imm=$10 -> X=$20 C=1
    CPU.A = 240
    CPU.X = 60
    Bus6502_Write(524, 203)
    Bus6502_Write(525, 16)
    CPU_SetPC(524)
    CPU_Step()
    USmoke_Check(CPU.X, 32, 13)
    USmoke_Check(CPU.F_CARRY, 1, 14)

    IfCondition EqualTo(USmoke.fail, 0) ThenBlock: {
        PrintMessage("PASS unofficial smoke\n")
    } ElseBlock: {
        PrintMessage("FAIL count=")
        PrintNumber(USmoke.fail)
        PrintMessage("\n")
    }
}

RunTask(Main)
