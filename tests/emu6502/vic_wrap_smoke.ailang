Import.Librarys.Emulators.6502.C64

SubRoutine.Main {
    Arena_Init()
    Bus6502_Init()
    CPU_Init()
    C64Pack_BringUp("docs/emu/boards/c64.board.json")
    d0 = Bus6502_Read(53266)
    PrintMessage("D012 start=")
    PrintNumber(d0)
    PrintMessage("\n")
    C64Pack_AfterStep(2600)
    d1 = Bus6502_Read(53266)
    PrintMessage("D012 after 2600=")
    PrintNumber(d1)
    PrintMessage("\n")
    C64Pack_AfterStep(16250)
    d2 = Bus6502_Read(53266)
    PrintMessage("D012 after more=")
    PrintNumber(d2)
    PrintMessage("\n")
}

RunTask(Main)
