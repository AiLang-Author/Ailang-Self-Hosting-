// chdir, sched_yield, gettid, and rt_sigprocmask bit translation.
// Linux SIGPIPE is 13. Haiku SIGPIPE is 7, so the blocked bit must be
// 1<<(7-1) and must not be the Linux bit.
SubRoutine.Main {
    r = SystemCall(80, "/boot/home")
    IfCondition NotEqual(r, 0) ThenBlock: { ProcessExit(1) }
    buf = HaikuAnonMap(64, 3)
    IfCondition LessThan(buf, 1) ThenBlock: { ProcessExit(2) }
    n = SystemCall(79, buf, 40)
    IfCondition LessThan(n, 10) ThenBlock: { ProcessExit(3) }
    IfCondition NotEqual(GetByte(buf, 0), 47) ThenBlock: { ProcessExit(4) }
    IfCondition NotEqual(GetByte(buf, 1), 98) ThenBlock: { ProcessExit(5) }
    IfCondition NotEqual(GetByte(buf, 6), 104) ThenBlock: { ProcessExit(6) }
    r = SystemCall(80, "/no/such/haiku/dir")
    IfCondition NotEqual(r, -2) ThenBlock: { ProcessExit(7) }
    r = SystemCall(24)
    IfCondition NotEqual(r, 0) ThenBlock: { ProcessExit(8) }
    tid = SystemCall(186)
    IfCondition LessThan(tid, 1) ThenBlock: { ProcessExit(9) }
    mask = Add(buf, 16)
    StoreValue(mask, 0)
    r = SystemCall(14, 2, mask, 0, 8)
    IfCondition NotEqual(r, 0) ThenBlock: { ProcessExit(10) }
    StoreValue(mask, 4096)
    r = SystemCall(14, 0, mask, 0, 8)
    IfCondition NotEqual(r, 0) ThenBlock: { ProcessExit(11) }
    slot = Add(buf, 32)
    StoreValue(slot, 0)
    raw = HaikuSyscall(92, 1, 0, slot)
    raw = HaikuRT_R32(raw)
    IfCondition LessThan(raw, 0) ThenBlock: { ProcessExit(12) }
    bits = Dereference(slot)
    pipebit = BitwiseAnd(bits, 64)
    IfCondition EqualTo(pipebit, 0) ThenBlock: { ProcessExit(13) }
    wrong = BitwiseAnd(bits, 4096)
    IfCondition NotEqual(wrong, 0) ThenBlock: { ProcessExit(14) }
    r = SystemCall(14, 1, mask, 0, 8)
    IfCondition NotEqual(r, 0) ThenBlock: { ProcessExit(15) }
    r = SystemCall(80, "/boot/home")
    IfCondition NotEqual(r, 0) ThenBlock: { ProcessExit(16) }
    ProcessExit(0)
}

RunTask(Main)
