// getdents64 of a directory we just filled, old getdents too.
// "." is a directory and the file we created is a regular file.
SubRoutine.Main {
    dir = "/boot/home/haiku_dent_test"
    file = "/boot/home/haiku_dent_test/f"
    SystemCall(87, file)
    SystemCall(84, dir)
    r = SystemCall(83, dir, 493)
    IfCondition NotEqual(r, 0) ThenBlock: { ProcessExit(1) }
    fd = SystemCall(2, file, 577, 420)
    IfCondition LessThan(fd, 0) ThenBlock: { ProcessExit(2) }
    SystemCall(3, fd)
    dfd = SystemCall(2, dir, 65536, 0)
    IfCondition LessThan(dfd, 0) ThenBlock: { ProcessExit(3) }
    buf = HaikuAnonMap(4096, 3)
    IfCondition LessThan(buf, 1) ThenBlock: { ProcessExit(4) }
    n = SystemCall(217, dfd, buf, 4096)
    IfCondition LessThan(n, 24) ThenBlock: { ProcessExit(5) }
    pos = 0
    sawdot = 0
    sawfile = 0
    WhileLoop LessThan(pos, n) {
        rp = Add(buf, pos)
        rp = Add(rp, 16)
        reclen = HaikuRT_Ld16(rp)
        IfCondition LessThan(reclen, 24) ThenBlock: { ProcessExit(6) }
        tp = Add(buf, pos)
        typ = GetByte(tp, 18)
        np = Add(tp, 19)
        c0 = GetByte(np, 0)
        c1 = GetByte(np, 1)
        IfCondition EqualTo(c0, 46) ThenBlock: {
            IfCondition EqualTo(c1, 0) ThenBlock: {
                sawdot = 1
                IfCondition NotEqual(typ, 4) ThenBlock: { ProcessExit(7) }
            }
        }
        IfCondition EqualTo(c0, 102) ThenBlock: {
            IfCondition EqualTo(c1, 0) ThenBlock: {
                sawfile = 1
                IfCondition NotEqual(typ, 8) ThenBlock: { ProcessExit(8) }
            }
        }
        pos = Add(pos, reclen)
    }
    IfCondition EqualTo(sawdot, 0) ThenBlock: { ProcessExit(9) }
    IfCondition EqualTo(sawfile, 0) ThenBlock: { ProcessExit(10) }
    SystemCall(3, dfd)
    dfd = SystemCall(2, dir, 65536, 0)
    IfCondition LessThan(dfd, 0) ThenBlock: { ProcessExit(11) }
    n = SystemCall(78, dfd, buf, 4096)
    IfCondition LessThan(n, 24) ThenBlock: { ProcessExit(12) }
    pos = 0
    sawfile = 0
    WhileLoop LessThan(pos, n) {
        rp = Add(buf, pos)
        rp = Add(rp, 16)
        reclen = HaikuRT_Ld16(rp)
        IfCondition LessThan(reclen, 24) ThenBlock: { ProcessExit(13) }
        base = Add(buf, pos)
        np = Add(base, 18)
        c0 = GetByte(np, 0)
        c1 = GetByte(np, 1)
        IfCondition EqualTo(c0, 102) ThenBlock: {
            IfCondition EqualTo(c1, 0) ThenBlock: {
                last = Subtract(reclen, 1)
                typ = GetByte(base, last)
                IfCondition NotEqual(typ, 8) ThenBlock: { ProcessExit(14) }
                sawfile = 1
            }
        }
        pos = Add(pos, reclen)
    }
    IfCondition EqualTo(sawfile, 0) ThenBlock: { ProcessExit(15) }
    r = SystemCall(217, dfd, buf, 16)
    IfCondition NotEqual(r, -22) ThenBlock: { ProcessExit(16) }
    SystemCall(3, dfd)
    SystemCall(87, file)
    SystemCall(84, dir)
    ProcessExit(0)
}

RunTask(Main)
