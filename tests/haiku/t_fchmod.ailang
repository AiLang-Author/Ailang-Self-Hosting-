// fchmod a new file to 0600 and read the permission bits back through fstat.
SubRoutine.Main {
    path = "/boot/home/haiku_fchmod_test"
    SystemCall(87, path)
    fd = SystemCall(2, path, 577, 438)
    IfCondition LessThan(fd, 0) ThenBlock: { ProcessExit(1) }
    r = SystemCall(91, fd, 384)
    IfCondition NotEqual(r, 0) ThenBlock: { ProcessExit(2) }
    buf = HaikuAnonMap(256, 3)
    IfCondition LessThan(buf, 1) ThenBlock: { ProcessExit(3) }
    r = SystemCall(5, fd, buf)
    IfCondition NotEqual(r, 0) ThenBlock: { ProcessExit(4) }
    mp = Add(buf, 24)
    mode = HaikuRT_Ld32(mp)
    kind = BitwiseAnd(mode, 61440)
    IfCondition NotEqual(kind, 32768) ThenBlock: { ProcessExit(5) }
    perm = BitwiseAnd(mode, 511)
    IfCondition NotEqual(perm, 384) ThenBlock: { ProcessExit(6) }
    bad = SystemCall(91, 400, 384)
    IfCondition GreaterEqual(bad, 0) ThenBlock: { ProcessExit(7) }
    SystemCall(3, fd)
    SystemCall(87, path)
    ProcessExit(0)
}

RunTask(Main)
