// fcntl flag translation: access mode, O_APPEND, FD_CLOEXEC, F_DUPFD.
SubRoutine.Main {
    path = "/boot/home/haiku_fcntl_test"
    SystemCall(87, path)
    fd = SystemCall(2, path, 578, 420)
    IfCondition LessThan(fd, 0) ThenBlock: { ProcessExit(1) }
    fl = SystemCall(72, fd, 3, 0)
    IfCondition LessThan(fl, 0) ThenBlock: { ProcessExit(2) }
    acc = BitwiseAnd(fl, 3)
    IfCondition NotEqual(acc, 2) ThenBlock: { ProcessExit(3) }
    r = SystemCall(72, fd, 4, 1024)
    IfCondition NotEqual(r, 0) ThenBlock: { ProcessExit(4) }
    fl = SystemCall(72, fd, 3, 0)
    IfCondition LessThan(fl, 0) ThenBlock: { ProcessExit(5) }
    bit = BitwiseAnd(fl, 1024)
    IfCondition EqualTo(bit, 0) ThenBlock: { ProcessExit(6) }
    acc = BitwiseAnd(fl, 3)
    IfCondition NotEqual(acc, 2) ThenBlock: { ProcessExit(7) }
    r = SystemCall(72, fd, 2, 1)
    IfCondition NotEqual(r, 0) ThenBlock: { ProcessExit(8) }
    fdfl = SystemCall(72, fd, 1, 0)
    IfCondition NotEqual(fdfl, 1) ThenBlock: { ProcessExit(9) }
    dup = SystemCall(72, fd, 0, 0)
    IfCondition LessThan(dup, 0) ThenBlock: { ProcessExit(10) }
    IfCondition EqualTo(dup, fd) ThenBlock: { ProcessExit(10) }
    SystemCall(3, dup)
    dup = SystemCall(32, fd)
    IfCondition LessThan(dup, 0) ThenBlock: { ProcessExit(11) }
    SystemCall(3, dup)
    r = SystemCall(33, fd, 40)
    IfCondition NotEqual(r, 40) ThenBlock: { ProcessExit(12) }
    SystemCall(3, 40)
    r = SystemCall(72, fd, 99, 0)
    IfCondition NotEqual(r, -22) ThenBlock: { ProcessExit(13) }
    SystemCall(3, fd)
    SystemCall(87, path)
    ProcessExit(0)
}

RunTask(Main)
