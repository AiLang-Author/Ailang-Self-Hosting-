// load /bin/sleep, resume it, send SIGTERM, and wait4.
// Linux status for a SIGTERM death is 15. No child is ECHILD.
SubRoutine.Main {
    sc = HaikuAnonMap(256, 3)
    IfCondition LessThan(sc, 1) ThenBlock: { ProcessExit(1) }
    st = Add(sc, 128)
    HaikuRT_St32(st, 0)
    r = SystemCall(61, -1, st, 1, 0)
    IfCondition NotEqual(r, -10) ThenBlock: { ProcessExit(2) }
    s0 = Add(sc, 32)
    s1 = Add(sc, 48)
    src = "/bin/sleep"
    i = 0
    WhileLoop LessThan(i, 11) {
        b = GetByte(src, i)
        SetByte(s0, i, b)
        i = Add(i, 1)
    }
    SetByte(s1, 0, 51)
    SetByte(s1, 1, 48)
    SetByte(s1, 2, 0)
    StoreValue(sc, s0)
    p = Add(sc, 8)
    StoreValue(p, s1)
    p = Add(sc, 16)
    StoreValue(p, 0)
    p = Add(sc, 24)
    StoreValue(p, 0)
    tid = HaikuSyscall(40, sc, 51, 2, 0, 10, 1, -1, 0)
    tid = HaikuRT_R32(tid)
    IfCondition LessThan(tid, 1) ThenBlock: { ProcessExit(3) }
    rr = HaikuSyscall(55, tid)
    rr = HaikuRT_R32(rr)
    IfCondition LessThan(rr, 0) ThenBlock: { ProcessExit(4) }
    HaikuSyscall(197, 200000, 0, 8)
    r = SystemCall(62, tid, 15)
    IfCondition NotEqual(r, 0) ThenBlock: { ProcessExit(5) }
    r = SystemCall(61, tid, st, 0, 0)
    IfCondition LessThan(r, 1) ThenBlock: { ProcessExit(6) }
    wst = HaikuRT_Ld32(st)
    IfCondition NotEqual(wst, 15) ThenBlock: { ProcessExit(7) }
    ProcessExit(0)
}

RunTask(Main)
