// Eight-argument load_image of /bin/true, then resume and wait.
// Flat args: three pointer slots, then the string "/bin/true".
SubRoutine.Main {
    sc = HaikuAnonMap(256, 3)
    IfCondition LessThan(sc, 1) ThenBlock: { ProcessExit(1) }
    str = Add(sc, 24)
    src = "/bin/true"
    i = 0
    WhileLoop LessThan(i, 10) {
        b = GetByte(src, i)
        SetByte(str, i, b)
        i = Add(i, 1)
    }
    StoreValue(sc, str)
    z = Add(sc, 8)
    StoreValue(z, 0)
    z = Add(sc, 16)
    StoreValue(z, 0)
    tid = HaikuSyscall(40, sc, 34, 1, 0, 10, 1, -1, 0)
    tid = HaikuRT_R32(tid)
    IfCondition LessThan(tid, 1) ThenBlock: { ProcessExit(2) }
    rr = HaikuSyscall(55, tid)
    rr = HaikuRT_R32(rr)
    IfCondition LessThan(rr, 0) ThenBlock: { ProcessExit(3) }
    codep = Add(sc, 64)
    StoreValue(codep, 99)
    wr = HaikuSyscall(62, tid, 8, 5000000, codep)
    wr = HaikuRT_R32(wr)
    IfCondition LessThan(wr, 0) ThenBlock: { ProcessExit(4) }
    code = HaikuRT_Ld32(codep)
    IfCondition NotEqual(code, 0) ThenBlock: { ProcessExit(5) }
    ProcessExit(0)
}

RunTask(Main)
