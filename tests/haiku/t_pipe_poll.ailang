// pipe, a one-byte write, poll for POLLIN, then read the byte back.
// pipe2 rejects an unknown flag and honors O_NONBLOCK.
SubRoutine.Main {
    fds = HaikuAnonMap(16, 3)
    IfCondition LessThan(fds, 1) ThenBlock: { ProcessExit(1) }
    r = SystemCall(22, fds)
    IfCondition NotEqual(r, 0) ThenBlock: { ProcessExit(2) }
    rd = HaikuRT_Ld32(fds)
    wp = Add(fds, 4)
    wr = HaikuRT_Ld32(wp)
    IfCondition LessThan(rd, 0) ThenBlock: { ProcessExit(3) }
    IfCondition LessThan(wr, 0) ThenBlock: { ProcessExit(4) }
    buf = HaikuAnonMap(8, 3)
    IfCondition LessThan(buf, 1) ThenBlock: { ProcessExit(5) }
    SetByte(buf, 0, 90)
    n = SystemCall(1, wr, buf, 1)
    IfCondition NotEqual(n, 1) ThenBlock: { ProcessExit(6) }
    pfd = HaikuAnonMap(8, 3)
    IfCondition LessThan(pfd, 1) ThenBlock: { ProcessExit(7) }
    HaikuRT_St32(pfd, rd)
    ep = Add(pfd, 4)
    HaikuRT_St16(ep, 1)
    r = SystemCall(7, pfd, 1, 1000)
    IfCondition NotEqual(r, 1) ThenBlock: { ProcessExit(8) }
    rp = Add(pfd, 6)
    rev = HaikuRT_Ld16(rp)
    bit = BitwiseAnd(rev, 1)
    IfCondition EqualTo(bit, 0) ThenBlock: { ProcessExit(9) }
    SetByte(buf, 0, 0)
    n = SystemCall(0, rd, buf, 1)
    IfCondition NotEqual(n, 1) ThenBlock: { ProcessExit(10) }
    b = GetByte(buf, 0)
    IfCondition NotEqual(b, 90) ThenBlock: { ProcessExit(11) }
    SystemCall(3, rd)
    SystemCall(3, wr)
    r = SystemCall(293, fds, 1)
    IfCondition NotEqual(r, -22) ThenBlock: { ProcessExit(12) }
    r = SystemCall(293, fds, 2048)
    IfCondition NotEqual(r, 0) ThenBlock: { ProcessExit(13) }
    rd = HaikuRT_Ld32(fds)
    wr = HaikuRT_Ld32(wp)
    r = SystemCall(7, pfd, 1, 0)
    IfCondition NotEqual(r, 0) ThenBlock: { ProcessExit(14) }
    SystemCall(3, rd)
    SystemCall(3, wr)
    r = SystemCall(7, pfd, 65, 0)
    IfCondition NotEqual(r, -22) ThenBlock: { ProcessExit(15) }
    ProcessExit(0)
}

RunTask(Main)
