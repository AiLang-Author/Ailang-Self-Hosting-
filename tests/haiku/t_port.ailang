// create, write, read, find, delete. One write is one read.
// 256 KiB is the limit; one byte past it is EINVAL.
SubRoutine.Main {
    name = "hc.p1test"
    id = HaikuSyscall(222, 8, name)
    id = HaikuRT_R32(id)
    IfCondition LessThan(id, 1) ThenBlock: { ProcessExit(1) }
    msg = HaikuAnonMap(16, 3)
    IfCondition LessThan(msg, 1) ThenBlock: { ProcessExit(2) }
    SetByte(msg, 0, 65)
    SetByte(msg, 1, 66)
    r = HaikuSyscall(232, id, 7, msg, 2, 0, 0)
    r = HaikuRT_R32(r)
    IfCondition NotEqual(r, 0) ThenBlock: { ProcessExit(3) }
    codep = Add(msg, 8)
    StoreValue(codep, 0)
    SetByte(msg, 0, 0)
    n = HaikuSyscall(230, id, codep, msg, 8, 0, 0)
    n = HaikuRT_R32(n)
    IfCondition NotEqual(n, 2) ThenBlock: { ProcessExit(4) }
    code = HaikuRT_Ld32(codep)
    IfCondition NotEqual(code, 7) ThenBlock: { ProcessExit(5) }
    b = GetByte(msg, 0)
    IfCondition NotEqual(b, 65) ThenBlock: { ProcessExit(6) }
    found = HaikuSyscall(225, name)
    found = HaikuRT_R32(found)
    IfCondition NotEqual(found, id) ThenBlock: { ProcessExit(7) }
    r = HaikuSyscall(224, id)
    r = HaikuRT_R32(r)
    IfCondition NotEqual(r, 0) ThenBlock: { ProcessExit(8) }
    found = HaikuSyscall(225, name)
    found = HaikuRT_R32(found)
    IfCondition NotEqual(found, -2) ThenBlock: { ProcessExit(9) }
    big = HaikuAnonMap(262160, 3)
    IfCondition LessThan(big, 1) ThenBlock: { ProcessExit(10) }
    SetByte(big, 0, 90)
    id = HaikuSyscall(222, 4, "hc.p1big")
    id = HaikuRT_R32(id)
    IfCondition LessThan(id, 1) ThenBlock: { ProcessExit(11) }
    r = HaikuSyscall(232, id, 7, big, 262144, 0, 0)
    r = HaikuRT_R32(r)
    IfCondition NotEqual(r, 0) ThenBlock: { ProcessExit(12) }
    SetByte(big, 0, 0)
    n = HaikuSyscall(230, id, codep, big, 262144, 0, 0)
    n = HaikuRT_R32(n)
    IfCondition NotEqual(n, 262144) ThenBlock: { ProcessExit(13) }
    b = GetByte(big, 0)
    IfCondition NotEqual(b, 90) ThenBlock: { ProcessExit(14) }
    r = HaikuSyscall(232, id, 7, big, 262145, 0, 0)
    r = HaikuRT_R32(r)
    IfCondition NotEqual(r, -22) ThenBlock: { ProcessExit(15) }
    HaikuSyscall(224, id)
    ProcessExit(0)
}

RunTask(Main)
