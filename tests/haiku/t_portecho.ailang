// Two teams, one named port. The parent creates hc.echo1, loads this
// same binary with argv "child", and reads one message. The child
// finds the port and writes "pong".
SubRoutine.Main {
    IfCondition GreaterThan(HaikuRT.argc, 1) ThenBlock: {
        ap = Add(HaikuRT.argv, 8)
        s = Dereference(ap)
        b0 = GetByte(s, 0)
        IfCondition EqualTo(b0, 99) ThenBlock: {
            id = HaikuSyscall(225, "hc.echo1")
            id = HaikuRT_R32(id)
            IfCondition LessThan(id, 1) ThenBlock: { ProcessExit(20) }
            msg = HaikuAnonMap(8, 3)
            IfCondition LessThan(msg, 1) ThenBlock: { ProcessExit(21) }
            SetByte(msg, 0, 112)
            SetByte(msg, 1, 111)
            SetByte(msg, 2, 110)
            SetByte(msg, 3, 103)
            r = HaikuSyscall(232, id, 9, msg, 4, 0, 0)
            r = HaikuRT_R32(r)
            IfCondition NotEqual(r, 0) ThenBlock: { ProcessExit(22) }
            ProcessExit(0)
        }
    }
    id = HaikuSyscall(222, 4, "hc.echo1")
    id = HaikuRT_R32(id)
    IfCondition LessThan(id, 1) ThenBlock: { ProcessExit(1) }
    sc = HaikuAnonMap(128, 3)
    IfCondition LessThan(sc, 1) ThenBlock: { ProcessExit(2) }
    path = "/boot/home/t_portecho"
    i = 0
    WhileLoop LessThan(i, 21) {
        b = GetByte(path, i)
        dest = Add(sc, 32)
        SetByte(dest, i, b)
        i = Add(i, 1)
    }
    dest = Add(sc, 53)
    SetByte(dest, 0, 0)
    cstr = Add(sc, 54)
    SetByte(cstr, 0, 99)
    SetByte(cstr, 1, 104)
    SetByte(cstr, 2, 105)
    SetByte(cstr, 3, 108)
    SetByte(cstr, 4, 100)
    SetByte(cstr, 5, 0)
    p0 = Add(sc, 32)
    StoreValue(sc, p0)
    slot = Add(sc, 8)
    StoreValue(slot, cstr)
    slot = Add(sc, 16)
    StoreValue(slot, 0)
    slot = Add(sc, 24)
    StoreValue(slot, 0)
    tid = HaikuSyscall(40, sc, 60, 2, 0, 10, 1, -1, 0)
    tid = HaikuRT_R32(tid)
    IfCondition LessThan(tid, 1) ThenBlock: { ProcessExit(3) }
    rr = HaikuSyscall(55, tid)
    rr = HaikuRT_R32(rr)
    IfCondition LessThan(rr, 0) ThenBlock: { ProcessExit(4) }
    codep = Add(sc, 80)
    StoreValue(codep, 0)
    buf = Add(sc, 88)
    n = HaikuSyscall(230, id, codep, buf, 8, 8, 3000000)
    n = HaikuRT_R32(n)
    IfCondition NotEqual(n, 4) ThenBlock: { ProcessExit(5) }
    code = HaikuRT_Ld32(codep)
    IfCondition NotEqual(code, 9) ThenBlock: { ProcessExit(6) }
    b = GetByte(buf, 0)
    IfCondition NotEqual(b, 112) ThenBlock: { ProcessExit(7) }
    b = GetByte(buf, 3)
    IfCondition NotEqual(b, 103) ThenBlock: { ProcessExit(8) }
    wr = HaikuSyscall(62, tid, 8, 3000000, codep)
    wr = HaikuRT_R32(wr)
    IfCondition LessThan(wr, 0) ThenBlock: { ProcessExit(9) }
    code = HaikuRT_Ld32(codep)
    IfCondition NotEqual(code, 0) ThenBlock: { ProcessExit(10) }
    HaikuSyscall(224, id)
    ProcessExit(0)
}

RunTask(Main)
