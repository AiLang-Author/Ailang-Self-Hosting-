// SIGPIPE ignore and default, kill(pid, 0), missing team, and a real
// handler (which this port refuses).
SubRoutine.Main {
    act = HaikuAnonMap(64, 3)
    IfCondition LessThan(act, 1) ThenBlock: { ProcessExit(1) }
    old = Add(act, 32)
    StoreValue(act, 1)
    r = SystemCall(13, 13, act, old, 8)
    IfCondition NotEqual(r, 0) ThenBlock: { ProcessExit(2) }
    r = SystemCall(13, 13, 0, old, 8)
    IfCondition NotEqual(r, 0) ThenBlock: { ProcessExit(3) }
    h = Dereference(old)
    IfCondition NotEqual(h, 1) ThenBlock: { ProcessExit(4) }
    StoreValue(act, 0)
    r = SystemCall(13, 13, act, 0, 8)
    IfCondition NotEqual(r, 0) ThenBlock: { ProcessExit(5) }
    r = SystemCall(13, 13, 0, old, 8)
    IfCondition NotEqual(r, 0) ThenBlock: { ProcessExit(6) }
    h = Dereference(old)
    IfCondition NotEqual(h, 0) ThenBlock: { ProcessExit(7) }
    pid = SystemCall(39)
    IfCondition LessThan(pid, 1) ThenBlock: { ProcessExit(8) }
    r = SystemCall(62, pid, 0)
    IfCondition NotEqual(r, 0) ThenBlock: { ProcessExit(9) }
    r = SystemCall(62, 2147483646, 0)
    IfCondition NotEqual(r, -3) ThenBlock: { ProcessExit(10) }
    r = SystemCall(62, pid, 16)
    IfCondition NotEqual(r, -22) ThenBlock: { ProcessExit(11) }
    r = SystemCall(62, pid, 30)
    IfCondition NotEqual(r, -22) ThenBlock: { ProcessExit(12) }
    StoreValue(act, 4096)
    r = SystemCall(13, 13, act, 0, 8)
    IfCondition NotEqual(r, -38) ThenBlock: { ProcessExit(13) }
    r = SystemCall(13, 13, act, 0, 4)
    IfCondition NotEqual(r, -22) ThenBlock: { ProcessExit(14) }
    r = SystemCall(109, 0, 0)
    IfCondition LessThan(r, -1) ThenBlock: { ProcessExit(15) }
    IfCondition GreaterThan(r, 0) ThenBlock: { ProcessExit(16) }
    r = SystemCall(16, 0, 0, 0)
    IfCondition NotEqual(r, -38) ThenBlock: { ProcessExit(17) }
    r = SystemCall(57)
    IfCondition NotEqual(r, -38) ThenBlock: { ProcessExit(18) }
    r = SystemCall(59, 0, 0, 0)
    IfCondition NotEqual(r, -38) ThenBlock: { ProcessExit(19) }
    r = SystemCall(56, 0, 0, 0, 0, 0, 0)
    IfCondition NotEqual(r, -38) ThenBlock: { ProcessExit(20) }
    r = SystemCall(157, 1, 15)
    IfCondition NotEqual(r, -38) ThenBlock: { ProcessExit(21) }
    ProcessExit(0)
}

RunTask(Main)
