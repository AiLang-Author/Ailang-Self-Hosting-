// spawn_thread of a stub that stores 1 through its argument and exits.
// The kernel allocates the stack when both stack fields are 0.
SubRoutine.Main {
    code = HaikuAnonMap(4096, 7)
    IfCondition LessThan(code, 1) ThenBlock: { ProcessExit(1) }
    SetByte(code, 0, 72)
    SetByte(code, 1, 199)
    SetByte(code, 2, 7)
    SetByte(code, 3, 1)
    SetByte(code, 4, 0)
    SetByte(code, 5, 0)
    SetByte(code, 6, 0)
    SetByte(code, 7, 49)
    SetByte(code, 8, 255)
    SetByte(code, 9, 184)
    SetByte(code, 10, 59)
    SetByte(code, 11, 0)
    SetByte(code, 12, 0)
    SetByte(code, 13, 0)
    SetByte(code, 14, 15)
    SetByte(code, 15, 5)
    data = HaikuAnonMap(256, 3)
    IfCondition LessThan(data, 1) ThenBlock: { ProcessExit(2) }
    slot = data
    StoreValue(slot, 0)
    name = Add(data, 16)
    SetByte(name, 0, 116)
    SetByte(name, 1, 0)
    attrs = Add(data, 32)
    HaikuRT_Zero(attrs, 72)
    StoreValue(attrs, code)
    np = Add(attrs, 8)
    StoreValue(np, name)
    ap = Add(attrs, 16)
    StoreValue(ap, slot)
    pp = Add(attrs, 64)
    HaikuRT_St32(pp, 10)
    tid = HaikuSyscall(52, attrs)
    tid = HaikuRT_R32(tid)
    IfCondition LessThan(tid, 1) ThenBlock: { ProcessExit(3) }
    rr = HaikuSyscall(55, tid)
    rr = HaikuRT_R32(rr)
    IfCondition LessThan(rr, 0) ThenBlock: { ProcessExit(4) }
    codep = Add(data, 128)
    StoreValue(codep, 99)
    wr = HaikuSyscall(62, tid, 8, 5000000, codep)
    wr = HaikuRT_R32(wr)
    IfCondition LessThan(wr, 0) ThenBlock: { ProcessExit(5) }
    got = Dereference(slot)
    IfCondition NotEqual(got, 1) ThenBlock: { ProcessExit(6) }
    exc = HaikuRT_Ld32(codep)
    IfCondition NotEqual(exc, 0) ThenBlock: { ProcessExit(7) }
    ProcessExit(0)
}

RunTask(Main)
