// stat /bin/true is a regular file with a size, /boot/system is a directory.
// lstat and fstat must agree on the file's mode type and size.
SubRoutine.Main {
    buf = HaikuAnonMap(256, 3)
    IfCondition LessThan(buf, 1) ThenBlock: { ProcessExit(1) }
    r = SystemCall(4, "/bin/true", buf)
    IfCondition NotEqual(r, 0) ThenBlock: { ProcessExit(2) }
    mp = Add(buf, 24)
    mode = HaikuRT_Ld32(mp)
    kind = BitwiseAnd(mode, 61440)
    IfCondition NotEqual(kind, 32768) ThenBlock: { ProcessExit(3) }
    sp = Add(buf, 48)
    sz = Dereference(sp)
    IfCondition LessThan(sz, 1) ThenBlock: { ProcessExit(4) }
    r = SystemCall(6, "/bin/true", buf)
    IfCondition NotEqual(r, 0) ThenBlock: { ProcessExit(5) }
    mode = HaikuRT_Ld32(mp)
    kind = BitwiseAnd(mode, 61440)
    IfCondition NotEqual(kind, 32768) ThenBlock: { ProcessExit(6) }
    sz2 = Dereference(sp)
    IfCondition NotEqual(sz2, sz) ThenBlock: { ProcessExit(7) }
    fd = SystemCall(2, "/bin/true", 0, 0)
    IfCondition LessThan(fd, 0) ThenBlock: { ProcessExit(8) }
    r = SystemCall(5, fd, buf)
    IfCondition NotEqual(r, 0) ThenBlock: { ProcessExit(9) }
    mode = HaikuRT_Ld32(mp)
    kind = BitwiseAnd(mode, 61440)
    IfCondition NotEqual(kind, 32768) ThenBlock: { ProcessExit(10) }
    SystemCall(3, fd)
    r = SystemCall(4, "/boot/system", buf)
    IfCondition NotEqual(r, 0) ThenBlock: { ProcessExit(11) }
    mode = HaikuRT_Ld32(mp)
    kind = BitwiseAnd(mode, 61440)
    IfCondition NotEqual(kind, 16384) ThenBlock: { ProcessExit(12) }
    r = SystemCall(4, "/boot/no/such/haiku/path", buf)
    IfCondition NotEqual(r, -2) ThenBlock: { ProcessExit(13) }
    ProcessExit(0)
}

RunTask(Main)
