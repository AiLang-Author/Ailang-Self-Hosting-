// time() and clock_gettime(REALTIME) agree. MONOTONIC is boot-relative.
SubRoutine.Main {
    sec = SystemCall(201, 0)
    IfCondition LessThan(sec, 1700000000) ThenBlock: { ProcessExit(1) }
    IfCondition GreaterThan(sec, 2200000000) ThenBlock: { ProcessExit(2) }
    buf = HaikuAnonMap(32, 3)
    IfCondition LessThan(buf, 1) ThenBlock: { ProcessExit(3) }
    sec2 = SystemCall(201, buf)
    IfCondition NotEqual(sec2, sec) ThenBlock: { ProcessExit(4) }
    stored = Dereference(buf)
    IfCondition NotEqual(stored, sec) ThenBlock: { ProcessExit(5) }
    r = SystemCall(228, 0, buf)
    IfCondition NotEqual(r, 0) ThenBlock: { ProcessExit(6) }
    rt = Dereference(buf)
    IfCondition LessThan(rt, 1700000000) ThenBlock: { ProcessExit(7) }
    nsecp = Add(buf, 8)
    nsec = Dereference(nsecp)
    IfCondition LessThan(nsec, 0) ThenBlock: { ProcessExit(8) }
    IfCondition GreaterThan(nsec, 999999999) ThenBlock: { ProcessExit(9) }
    r = SystemCall(228, 1, buf)
    IfCondition NotEqual(r, 0) ThenBlock: { ProcessExit(10) }
    mono = Dereference(buf)
    IfCondition LessThan(mono, 0) ThenBlock: { ProcessExit(11) }
    IfCondition GreaterThan(mono, rt) ThenBlock: { ProcessExit(12) }
    r = SystemCall(228, 2, buf)
    IfCondition NotEqual(r, -22) ThenBlock: { ProcessExit(13) }
    ProcessExit(0)
}

RunTask(Main)
