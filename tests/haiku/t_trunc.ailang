// Create a file, ftruncate it, and check fstat's Linux-layout size.
SubRoutine.Main {
    path = "/boot/home/haiku_trunc_test"
    SystemCall(87, path)
    fd = SystemCall(2, path, 577, 420)
    IfCondition LessThan(fd, 0) ThenBlock: { ProcessExit(1) }
    r = SystemCall(77, fd, 100)
    IfCondition NotEqual(r, 0) ThenBlock: { ProcessExit(2) }
    buf = HaikuAnonMap(256, 3)
    IfCondition LessThan(buf, 1) ThenBlock: { ProcessExit(3) }
    r = SystemCall(5, fd, buf)
    IfCondition NotEqual(r, 0) ThenBlock: { ProcessExit(4) }
    sp = Add(buf, 48)
    sz = Dereference(sp)
    IfCondition NotEqual(sz, 100) ThenBlock: { ProcessExit(5) }
    r = SystemCall(77, fd, 0)
    IfCondition NotEqual(r, 0) ThenBlock: { ProcessExit(6) }
    r = SystemCall(5, fd, buf)
    IfCondition NotEqual(r, 0) ThenBlock: { ProcessExit(7) }
    sz = Dereference(sp)
    IfCondition NotEqual(sz, 0) ThenBlock: { ProcessExit(8) }
    SystemCall(3, fd)
    SystemCall(87, path)
    ProcessExit(0)
}

RunTask(Main)
