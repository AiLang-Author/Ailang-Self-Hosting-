{
	"If Condition": {
		"prefix": "If",
		"body": [
			"IfCondition ${1:Condition} ThenBlock: {",
			"\t$0",
			"}"
		],
		"description": "Basic If block"
	},
	"If Else": {
		"prefix": "IfElse",
		"body": [
			"IfCondition ${1:Condition} ThenBlock: {",
			"\t${2:Body}",
			"} ElseBlock: {",
			"\t$3",
			"}"
		],
		"description": "If-Else block"
	},
	"While Loop": {
		"prefix": "While",
		"body": [
			"WhileLoop ${1:Condition} {",
			"\t$0",
			"}"
		],
		"description": "While loop"
	},
	"Function Definition": {
		"prefix": "Func",
		"body": [
			"Function.${1:Name} {",
			"\tInput: ${2:arg}: ${3:Type}",
			"\tOutput: ${4:Type}",
			"\tBody: {",
			"\t\t$0",
			"\t}",
			"}"
		],
		"description": "Define a new Function"
	},
	"SubRoutine Definition": {
		"prefix": "Sub",
		"body": [
			"SubRoutine.${1:Name} {",
			"\t$0",
			"}"
		],
		"description": "Define a new SubRoutine"
	},
	"Fixed Pool": {
		"prefix": "Pool",
		"body": [
			"FixedPool.${1:Name} {",
			"\t\"${2:Field}\": Initialize=${3:0}",
			"}"
		],
		"description": "Define a FixedPool"
	},
	"Linkage Pool": {
		"prefix": "Link",
		"body": [
			"LinkagePool.${1:Name} {",
			"\t\"${2:Field}\": Initialize=${3:0}",
			"}"
		],
		"description": "Define a LinkagePool"
	},
	"Main Routine": {
		"prefix": "Main",
		"body": [
			"SubRoutine.Main {",
			"\t$0",
			"}",
			"RunTask(Main)"
		],
		"description": "Main entry point"
	}
}