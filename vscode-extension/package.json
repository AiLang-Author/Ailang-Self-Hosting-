{
  "name": "ailang-support",
  "displayName": "AILang Support",
  "description": "Full-featured language support for AILang — self-hosting compiler, contract-checking analyzer, LSP, Float_Sin/Cos. No npm runtime deps.",
  "version": "1.1.0",
  "publisher": "2Paws",
  "icon": "resources/ailang-icon-128.png",
  "license": "SEE LICENSE IN License.md",
  "homepage": "https://github.com/AiLang-Author/Ailang-Self-Hosting-",
  "bugs": {
    "url": "https://github.com/AiLang-Author/Ailang-Self-Hosting-/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AiLang-Author/Ailang-Self-Hosting-"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Debuggers",
    "Visualization"
  ],
  "keywords": [
    "ailang",
    "systems programming",
    "compiler",
    "static analysis",
    "self-hosting"
  ],
  "galleryBanner": {
    "color": "#111118",
    "theme": "dark"
  },
  "activationEvents": [
    "onLanguage:ailang"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "ailang",
        "aliases": [
          "AILang",
          "ailang"
        ],
        "extensions": [
          ".ailang"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ailang",
        "scopeName": "source.ailang",
        "path": "./syntaxes/ailang.tmLanguage.json"
      }
    ],
    "commands": [
      { "command": "ailang.compile", "title": "AILang: Compile", "category": "AILang" },
      { "command": "ailang.run", "title": "AILang: Run", "category": "AILang", "icon": "$(play)" },
      { "command": "ailang.analyze", "title": "AILang: Analyze", "category": "AILang" },
      { "command": "ailang.openDocs", "title": "AILang: Open Documentation", "category": "AILang" },
      { "command": "ailang.showFlow", "title": "AILang: Show Flow Graph", "category": "AILang" },
      { "command": "ailang.toggleShorthand", "title": "AILang: Toggle Shorthand Display", "category": "AILang" }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ailang-sidebar",
          "title": "AILang",
          "icon": "resources/ailang-icon-128.png"
        }
      ]
    },
    "views": {
      "ailang-sidebar": [
        { "id": "ailangManuals", "name": "Manuals" }
      ]
    },
    "configuration": {
      "title": "AILang",
      "properties": {
        "ailang.lspPath": {
          "type": "string",
          "default": null,
          "description": "Path to the AILang LSP executable (ailang_lsp.x). If not set, defaults to the extension folder."
        },
        "ailang.editor.shorthandDisplay": {
          "type": "boolean",
          "default": false,
          "description": "Display shorthand versions of common AILang keywords in the editor (does not change file content)."
        },
        "ailang.editor.shorthandCustomMap": {
          "type": "object",
          "default": {},
          "description": "User-defined overrides for the shorthand display map. E.g., {\"Function\": \"FUNC\"}",
          "scope": "resource"
        }
      }
    }
  }
}
