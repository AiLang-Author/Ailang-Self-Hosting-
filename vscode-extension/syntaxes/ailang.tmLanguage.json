{
	"scopeName": "source.ailang",
	"patterns": [
		{
			"comment": "Comments",
			"match": "//.*$",
			"name": "comment.line.double-slash.ailang"
		},
		{
			"comment": "Strings",
			"begin": "\"",
			"end": "\"",
			"name": "string.quoted.double.ailang"
		},
		{
			"comment": "Control Keywords",
			"match": "\\b(IfCondition|ThenBlock|ElseBlock|WhileLoop|ForEvery|in|BreakLoop|ContinueLoop|ReturnValue|ProcessExit|RunTask|HaltProgram|TryBlock|CatchError|FinallyBlock|Branch|Fork|TrueBlock|FalseBlock|ChoosePath|CaseOption|DefaultOption|Case|Default)\\b",
			"name": "keyword.control.ailang"
		},
		{
			"comment": "Loop and Actor Keywords",
			"match": "\\b(LoopMain|LoopActor|LoopStart|LoopShadow|LoopSend|LoopReceive|LoopReply|LoopYield|LoopContinue|LoopSpawn|LoopJoin|LoopInterrupt|LoopTransaction|LoopSequence|LoopSelect|LoopCatch|LoopTimeout|LoopBarrier|LoopFlow|OnFailure|OnTimeout|OnComplete|SendMessage|ReceiveMessage)\\b",
			"name": "keyword.control.concurrency.ailang"
		},
		{
			"comment": "Structure Keywords",
			"match": "\\b(LibraryImport|FixedPool|DynamicPool|TemporalPool|NeuralPool|KernelPool|ActorPool|SecurityPool|ConstrainedPool|FilePool|SubPool|LinkagePool|Function|SubRoutine|Combinator|MacroBlock|Macro|SecurityContext|Level|ConstrainedType|Constant|AcronymDefinitions|InterruptHandler|DeviceDriver|Bootloader|KernelEntry)\\b",
			"name": "storage.type.ailang"
		},
		{
			"comment": "Attributes",
			"match": "\\b(Initialize|CanChange|CanBeNull|Range|MaximumLength|MinimumLength|ElementType|Input|Output|Body|Where|Direction|PointerTo|Type|AllowedOperations|DeniedOperations|MemoryLimit|CPUQuota)\\b",
			"name": "support.type.property-name.ailang"
		},
		{
			"comment": "Types",
			"match": "\\b(Integer|FloatingPoint|Text|Boolean|Address|Void|Any|Byte|Word|DWord|QWord|UInt8|UInt16|UInt32|UInt64|Int8|Int16|Int32|Int64|Array|Map|Tuple|Record|Pointer|OptionalType)\\b",
			"name": "entity.name.type.ailang"
		},
		{
			"comment": "Constants",
			"match": "\\b(True|False|Null|PI|E|PHI)\\b",
			"name": "constant.language.ailang"
		},
		{
			"comment": "Operators and Math Functions",
			"match": "\\b(Add|Subtract|Multiply|Divide|Modulo|Power|Increment|Decrement|Negate|And|Or|Not|BitwiseAnd|BitwiseOr|BitwiseXor|BitwiseNot|LeftShift|RightShift|EqualTo|NotEqual|LessThan|GreaterThan|LessEqual|GreaterEqual|AbsoluteValue|SquareRoot|Floor|Ceil|Round|RoundEven|Trunc|Frac|Min|Max|Clamp|Saturate|Sign|FloorDivide|Remainder|DivMod|FusedMultiplyAdd|Hypotenuse|Lerp|DegToRad|RadToDeg|Sin|Cos|Tan|Asin|Acos|Atan|Atan2|Tanh|Exp|Expm1|Exp2|Log|Log1p|Log2|Log10|NextAfter|Frexp|Ldexp|NearlyEqual|PopCount|CountLeadingZeros|CountTrailingZeros|RotateLeft|RotateRight|ByteSwap|BitReverse|AlignUp|AlignDown|IsPowerOfTwo|NextPowerOfTwo|FloorLog2)\\b",
			"name": "support.function.math.ailang"
		},
		{
			"comment": "System, Memory, and IO Built-ins",
			"match": "\\b(Allocate|Deallocate|GetByte|SetByte|MemoryCopy|MemorySet|PrintMessage|PrintNumber|PrintString|PrintChar|SystemCall|StoreValue|Dereference|AddressOf|SizeOf|MemoryCompare|PortRead|PortWrite|HardwareRegister|MMIORead|MMIOWrite|AtomicRead|AtomicWrite|AtomicAdd|AtomicCompareSwap|AllocateLinkage|FreeLinkage|CopyLinkage|CopyLinkageInto|ResetLinkage|CompareLinkage|PoolSize|PoolFieldCount|PoolFieldOffset)\\b",
			"name": "support.function.system.ailang"
		},
		{
			"comment": "String Operations",
			"match": "\\b(StringLength|StringCompare|StringCopy|StringConcat|StringConcatPooled|ReadInput|ReadInputNumber|GetUserChoice|ReadKey|StringEquals|StringContains|StringStartsWith|StringEndsWith|StringSubstring|StringToUpper|StringToLower|StringTrim|StringReplace|StringToString|NumberToString|StringToNumber|StringFromChar|StringIndexOf|StringExtract|StringExtractUntil|StringSplit)\\b",
			"name": "support.function.string.ailang"
		},
		{
			"comment": "File I/O",
			"match": "\\b(ReadTextFile|WriteTextFile|AppendTextFile|FileExists|OpenFile|CloseFile|ReadFile|WriteFile|SeekPosition|FlushFile|CreateDirectory|DeleteDirectory|ListDirectory|DirectoryExists|GetFileSize|GetFileDate|GetFilePermissions)\\b",
			"name": "support.function.file.ailang"
		},
		{
			"comment": "VM, Security, and Other Built-ins",
			"match": "\\b(PageTable|VirtualMemory|Cache|TLB|MemoryBarrier|EveryInterval|WithSecurity|EnableInterrupts|DisableInterrupts|Halt|Wait|InlineAssembly|RunMacro|Lambda|Apply|DebugAssert|DebugTrace|DebugBreak|DebugMemory|DebugPerf|DebugInspect)\\b",
			"name": "support.function.builtin.ailang"
		},
		{
			"comment": "Numbers",
			"match": "\\b\\d+(\\.\\d+)?\\b",
			"name": "constant.numeric.ailang"
		},
		{
			"comment": "Hex Numbers",
			"match": "\\b0x[0-9a-fA-F]+\\b",
			"name": "constant.numeric.hex.ailang"
		},
		{
			"comment": "Function Names",
			"match": "(?<=Function\\.|SubRoutine\\.)[a-zA-Z0-9_]+",
			"name": "entity.name.function.ailang"
		},
		{
			"comment": "Pool Access",
			"match": "(?<=\\.)[a-zA-Z0-9_]+",
			"name": "variable.other.property.ailang"
		},
		{
			"comment": "Linkage Access (@ operator)",
			"match": "(?<=@)[a-zA-Z0-9_]+",
			"name": "variable.other.member.ailang"
		}
	]
}