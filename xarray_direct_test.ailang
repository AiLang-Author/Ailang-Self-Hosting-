// xarray_direct_test.ailang
LibraryImport.XArrays

SubRoutine.Main {
    PrintMessage("XArray Direct Test\n")
    
    i = 0
    WhileLoop LessThan(i, 1000000) {
        arr = XArray.XCreate(8)
        XArray.XPush(arr, 42)
        XArray.XPush(arr, 43)
        XArray.XDestroy(arr)
        
        i = Add(i, 1)
        
        IfCondition EqualTo(Modulo(i, 100000), 0) ThenBlock: {
            PrintNumber(i)
            PrintMessage(" cycles\n")
            PrintMessage("Slab24 allocs: ")
            PrintNumber(Slab24.alloc_count)
            PrintMessage(" frees: ")
            PrintNumber(Slab24.free_count)
            PrintMessage("\n")
        }
    }
    
    PrintMessage("Done\n")
}

RunTask(Main)