// xarray_leak_test.ailang
LibraryImport.Arena

SubRoutine.Main {
    PrintMessage("XArray Leak Test\n")
    
    i = 0
    WhileLoop LessThan(i, 1000000) {
        // Just arena operations
        ptr = Arena_Alloc24()
        Arena_Free24(ptr)
        
        i = Add(i, 1)
        
        IfCondition EqualTo(Modulo(i, 100000), 0) ThenBlock: {
            PrintNumber(i)
            PrintMessage(" cycles\n")
            PrintMessage("Slab24 allocs: ")
            PrintNumber(Slab24.alloc_count)
            PrintMessage(" frees: ")
            PrintNumber(Slab24.free_count)
            PrintMessage("\n")
        }
    }
    
    PrintMessage("Done\n")
}

RunTask(Main)