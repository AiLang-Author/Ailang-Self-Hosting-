// xarray_minimal.ailang
// Absolute minimum test - isolate crash point

LibraryImport.XArrays
LibraryImport.Arena

PrintMessage("Step 1: About to call Arena_Init\n")
Arena_Init()
PrintMessage("Step 2: Arena_Init complete\n")

PrintMessage("Step 3: About to call XArray.XCreate(8)\n")
arr = XArray.XCreate(8)
PrintMessage("Step 4: XCreate returned: ")
PrintNumber(arr)
PrintMessage("\n")

PrintMessage("Step 5: About to call XArray.XSize\n")
sz = XArray.XSize(arr)
PrintMessage("Step 6: Size = ")
PrintNumber(sz)
PrintMessage("\n")

PrintMessage("Step 7: About to call XArray.XPush\n")
XArray.XPush(arr, 42)
PrintMessage("Step 8: Push complete\n")

PrintMessage("Step 9: About to call XArray.XGet(0)\n")
val = XArray.XGet(arr, 0)
PrintMessage("Step 10: Got value = ")
PrintNumber(val)
PrintMessage("\n")

PrintMessage("Step 11: About to destroy\n")
XArray.XDestroy(arr)
PrintMessage("Step 12: Destroy complete\n")

PrintMessage("\n=== ALL STEPS PASSED ===\n")
Arena_Report()