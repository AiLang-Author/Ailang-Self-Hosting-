// xarray_simple_test.ailang
// Isolate which test combination causes crash

LibraryImport.XArrays
LibraryImport.Arena

FixedPool.Test {
    "passed": Initialize=0
    "failed": Initialize=0
    "total": Initialize=0
    "name": Initialize=0
    "actual": Initialize=0
    "expected": Initialize=0
}

FixedPool.Flow {
    "run_test1": Initialize=1
    "run_test2": Initialize=1
    "run_test3": Initialize=1
    "run_test4": Initialize=1
    "run_test5": Initialize=1
}

SubRoutine.Pass {
    Test.passed = Add(Test.passed, 1)
    Test.total = Add(Test.total, 1)
    PrintMessage("  [PASS] ")
    PrintMessage(Test.name)
    PrintMessage("\n")
}

SubRoutine.Fail {
    Test.failed = Add(Test.failed, 1)
    Test.total = Add(Test.total, 1)
    PrintMessage("  [FAIL] ")
    PrintMessage(Test.name)
    PrintMessage(" - expected ")
    PrintNumber(Test.expected)
    PrintMessage(" got ")
    PrintNumber(Test.actual)
    PrintMessage("\n")
}

SubRoutine.Check {
    IfCondition EqualTo(Test.actual, Test.expected) ThenBlock: {
        RunTask(Pass)
    } ElseBlock: {
        RunTask(Fail)
    }
}

SubRoutine.CheckNotZero {
    IfCondition NotEqual(Test.actual, 0) ThenBlock: {
        RunTask(Pass)
    } ElseBlock: {
        Test.expected = 1
        Test.actual = 0
        RunTask(Fail)
    }
}

// TEST 1
SubRoutine.Test_CreateDestroy {
    PrintMessage("\n=== TEST 1: Basic Create/Destroy ===\n")
    
    Test.name = "XCreate(8) returns non-null"
    arr = XArray.XCreate(8)
    Test.actual = arr
    RunTask(CheckNotZero)
    
    Test.name = "Initial size is 0"
    Test.actual = XArray.XSize(arr)
    Test.expected = 0
    RunTask(Check)
    
    Test.name = "Capacity is 8"
    Test.actual = XArray.XCapacity(arr)
    Test.expected = 8
    RunTask(Check)
    
    XArray.XDestroy(arr)
    
    Test.name = "XCreate(4) returns non-null"
    arr2 = XArray.XCreate(4)
    Test.actual = arr2
    RunTask(CheckNotZero)
    XArray.XDestroy(arr2)
    
    Test.name = "XCreate(64) returns non-null"
    arr3 = XArray.XCreate(64)
    Test.actual = arr3
    RunTask(CheckNotZero)
    XArray.XDestroy(arr3)
    
    Test.name = "XCreate(256) returns non-null"
    arr4 = XArray.XCreate(256)
    Test.actual = arr4
    RunTask(CheckNotZero)
    XArray.XDestroy(arr4)
    
    PrintMessage("  TEST 1 COMPLETE\n")
}

// TEST 2
SubRoutine.Test_PushSize {
    PrintMessage("\n=== TEST 2: Push and Size ===\n")
    
    arr = XArray.XCreate(8)
    
    XArray.XPush(arr, 42)
    Test.name = "After 1 push, size is 1"
    Test.actual = XArray.XSize(arr)
    Test.expected = 1
    RunTask(Check)
    
    XArray.XPush(arr, 100)
    XArray.XPush(arr, 200)
    XArray.XPush(arr, 300)
    
    Test.name = "After 4 pushes, size is 4"
    Test.actual = XArray.XSize(arr)
    Test.expected = 4
    RunTask(Check)
    
    XArray.XPush(arr, 400)
    XArray.XPush(arr, 500)
    XArray.XPush(arr, 600)
    XArray.XPush(arr, 700)
    
    Test.name = "After 8 pushes, size is 8"
    Test.actual = XArray.XSize(arr)
    Test.expected = 8
    RunTask(Check)
    
    Test.name = "Capacity still 8 (no resize yet)"
    Test.actual = XArray.XCapacity(arr)
    Test.expected = 8
    RunTask(Check)
    
    XArray.XDestroy(arr)
    PrintMessage("  TEST 2 COMPLETE\n")
}

// TEST 3
SubRoutine.Test_GetSet {
    PrintMessage("\n=== TEST 3: Get and Set ===\n")
    
    arr = XArray.XCreate(16)
    
    XArray.XPush(arr, 10)
    XArray.XPush(arr, 20)
    XArray.XPush(arr, 30)
    XArray.XPush(arr, 40)
    XArray.XPush(arr, 50)
    
    Test.name = "XGet(0) returns 10"
    Test.actual = XArray.XGet(arr, 0)
    Test.expected = 10
    RunTask(Check)
    
    Test.name = "XGet(2) returns 30"
    Test.actual = XArray.XGet(arr, 2)
    Test.expected = 30
    RunTask(Check)
    
    Test.name = "XGet(4) returns 50"
    Test.actual = XArray.XGet(arr, 4)
    Test.expected = 50
    RunTask(Check)
    
    XArray.XSet(arr, 2, 999)
    Test.name = "After XSet(2, 999), XGet(2) returns 999"
    Test.actual = XArray.XGet(arr, 2)
    Test.expected = 999
    RunTask(Check)
    
    Test.name = "XGet(1) still returns 20"
    Test.actual = XArray.XGet(arr, 1)
    Test.expected = 20
    RunTask(Check)
    
    Test.name = "XGet(3) still returns 40"
    Test.actual = XArray.XGet(arr, 3)
    Test.expected = 40
    RunTask(Check)
    
    Test.name = "XGet(-1) returns XERROR"
    Test.actual = XArray.XGet(arr, -1)
    Test.expected = -999999
    RunTask(Check)
    
    Test.name = "XGet(100) returns XERROR"
    Test.actual = XArray.XGet(arr, 100)
    Test.expected = -999999
    RunTask(Check)
    
    XArray.XDestroy(arr)
    PrintMessage("  TEST 3 COMPLETE\n")
}

// TEST 4
SubRoutine.Test_Pop {
    PrintMessage("\n=== TEST 4: Pop ===\n")
    
    arr = XArray.XCreate(8)
    XArray.XPush(arr, 100)
    XArray.XPush(arr, 200)
    XArray.XPush(arr, 300)
    
    Test.name = "First pop returns 300 (LIFO)"
    Test.actual = XArray.XPop(arr)
    Test.expected = 300
    RunTask(Check)
    
    Test.name = "Size is now 2"
    Test.actual = XArray.XSize(arr)
    Test.expected = 2
    RunTask(Check)
    
    Test.name = "Second pop returns 200"
    Test.actual = XArray.XPop(arr)
    Test.expected = 200
    RunTask(Check)
    
    Test.name = "Third pop returns 100"
    Test.actual = XArray.XPop(arr)
    Test.expected = 100
    RunTask(Check)
    
    Test.name = "Size is now 0"
    Test.actual = XArray.XSize(arr)
    Test.expected = 0
    RunTask(Check)
    
    Test.name = "Pop from empty returns XERROR"
    Test.actual = XArray.XPop(arr)
    Test.expected = -999999
    RunTask(Check)
    
    XArray.XDestroy(arr)
    PrintMessage("  TEST 4 COMPLETE\n")
}

// TEST 5
SubRoutine.Test_Resize {
    PrintMessage("\n=== TEST 5: Auto-Resize ===\n")
    
    arr5 = XArray.XCreate(4)
    
    Test.name = "Initial capacity is 4"
    Test.actual = XArray.XCapacity(arr5)
    Test.expected = 4
    RunTask(Check)
    
    XArray.XPush(arr5, 1)
    XArray.XPush(arr5, 2)
    XArray.XPush(arr5, 3)
    XArray.XPush(arr5, 4)
    
    Test.name = "After 4 pushes, size is 4"
    Test.actual = XArray.XSize(arr5)
    Test.expected = 4
    RunTask(Check)
    
    XArray.XPush(arr5, 5)
    
    Test.name = "After 5th push, size is 5"
    Test.actual = XArray.XSize(arr5)
    Test.expected = 5
    RunTask(Check)
    
    Test.name = "Capacity doubled to 8"
    Test.actual = XArray.XCapacity(arr5)
    Test.expected = 8
    RunTask(Check)
    
    Test.name = "Element 0 preserved after resize"
    Test.actual = XArray.XGet(arr5, 0)
    Test.expected = 1
    RunTask(Check)
    
    Test.name = "Element 3 preserved after resize"
    Test.actual = XArray.XGet(arr5, 3)
    Test.expected = 4
    RunTask(Check)
    
    Test.name = "New element 4 accessible"
    Test.actual = XArray.XGet(arr5, 4)
    Test.expected = 5
    RunTask(Check)
    
    PrintMessage("  About to enter loop...\n")
    
    PrintMessage("  Setting push_val = 6...\n")
    push_val5 = 6
    PrintMessage("  push_val5 set, value = ")
    PrintNumber(push_val5)
    PrintMessage("\n")
    
    PrintMessage("  Entering WhileLoop...\n")
    WhileLoop LessEqual(push_val5, 20) {
        PrintMessage("    iteration ")
        PrintNumber(push_val5)
        PrintMessage("\n")
        XArray.XPush(arr5, push_val5)
        push_val5 = Add(push_val5, 1)
    }
    
    PrintMessage("  Loop complete\n")
    
    Test.name = "After pushing 1-20, size is 20"
    Test.actual = XArray.XSize(arr5)
    Test.expected = 20
    RunTask(Check)
    
    Test.name = "Element 19 is 20"
    Test.actual = XArray.XGet(arr5, 19)
    Test.expected = 20
    RunTask(Check)
    
    XArray.XDestroy(arr5)
    PrintMessage("  TEST 5 COMPLETE\n")
}

PrintMessage("=== XArray Test Suite ===\n")
PrintMessage("Edit Flow.run_testN to enable/disable tests\n\n")
Arena_Init()

IfCondition EqualTo(Flow.run_test1, 1) ThenBlock: {
    RunTask(Test_CreateDestroy)
    PrintMessage(">>> After Test_CreateDestroy\n")
}

IfCondition EqualTo(Flow.run_test2, 1) ThenBlock: {
    RunTask(Test_PushSize)
    PrintMessage(">>> After Test_PushSize\n")
}

IfCondition EqualTo(Flow.run_test3, 1) ThenBlock: {
    RunTask(Test_GetSet)
    PrintMessage(">>> After Test_GetSet\n")
}

IfCondition EqualTo(Flow.run_test4, 1) ThenBlock: {
    RunTask(Test_Pop)
    PrintMessage(">>> After Test_Pop\n")
}

IfCondition EqualTo(Flow.run_test5, 1) ThenBlock: {
    RunTask(Test_Resize)
    PrintMessage(">>> After Test_Resize\n")
}

PrintMessage("\n=== RESULTS ===\n")
PrintMessage("Passed: ")
PrintNumber(Test.passed)
PrintMessage("\nFailed: ")
PrintNumber(Test.failed)
PrintMessage("\n")

Arena_Report()