// xarray_slow_test.ailang
LibraryImport.XArrays

SubRoutine.Main {
    PrintMessage("XArray Slow Test - 10 minutes\n")
    PrintMessage("Watch htop for memory growth\n\n")
    
    cycle = 0
    WhileLoop LessThan(cycle, 600) {
        // Do 10000 XArray ops per cycle
        i = 0
        WhileLoop LessThan(i, 10000) {
            arr = XArray.XCreate(8)
            XArray.XPush(arr, 42)
            XArray.XPush(arr, 43)
            XArray.XDestroy(arr)
            i = Add(i, 1)
        }
        
        // Busy wait ~1 second
        j = 0
        WhileLoop LessThan(j, 50000000) {
            j = Add(j, 1)
        }
        
        cycle = Add(cycle, 1)
        
        IfCondition EqualTo(Modulo(cycle, 60), 0) ThenBlock: {
            PrintNumber(Divide(cycle, 60))
            PrintMessage(" minutes\n")
        }
    }
    
    PrintMessage("Done - 10 minutes\n")
}

RunTask(Main)